// Every built-in type and object form the language declares.
import std.console;
import std.math as m;

let pi        = 3.14159;
let flag      = true;
let letter    = 'x';
let newline   = '\n';
let name      = "dawn";
let tag       = :ok;
let nums      = [1, 2, 3];
let arr       = #[1.0, 2.5];
let table     = %{ :a => 1, "b" => 2 };
let hexed     = 0xFF;
let nothing   = ();

let add x y = x + y;
let inc = add 1;

/* Higher-order: `compose` returns a lambda closing over both parameters. */
let compose f g = fn x -> f (g x);

let classify n =
    if n < 0 { :negative }
    else if n == 0 { :zero }
    else { :positive };

// `twice` captures `step`, which itself captures `start`: a transitive capture
// chain that has to be threaded through the intermediate closure.
let counter start = {
    let step  = fn n -> n + start
    let twice = fn n -> step (step n)
    twice
};

let rec sum_to n = if n <= 0 { 0 } else { n + sum_to (n - 1) };

let rec even n = if n == 0 { true } else { odd (n - 1) }
let rec odd n  = if n == 0 { false } else { even (n - 1) }

let report! label value = {
    console.print! (to_string label + to_string (value))
};

let main! = {
    let local_rec = {
        let rec down k = if k <= 0 { :bottom } else { down (k - 1) }
        down 3
    };

    report! "pi = "      pi
    report! "class = "   (classify (-5))
    report! "counted = " (counter 10 1)
    report! "sum = "     (sum_to 4)
    report! "even = "    (even 8)
    report! "local = "   local_rec
    report! "composed = " (compose inc inc 0)

    let worker = spawn! $( report! "from thread: " (m.sqrt 16.0) );
    join! worker
}
