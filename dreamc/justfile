default: build

build:
    cargo build

release:
    cargo build --release

test:
    cargo test

# Compile a source file and disassemble the result.
run FILE:
    cargo run --quiet -- {{FILE}} --dump

# Type-, scope- and purity-check without writing an image.
check FILE:
    cargo run --quiet -- {{FILE}} --no-emit

examples:
    cargo run --quiet -- examples/sample.axa --dump
    cargo run --quiet -- examples/features.axa --dump

clean:
    cargo clean
    rm -f examples/*.dream
