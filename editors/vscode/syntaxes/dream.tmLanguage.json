{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dream",
  "scopeName": "source.dream",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#atom"
    },
    {
      "include": "#number"
    },
    {
      "include": "#foreign"
    },
    {
      "include": "#binding"
    },
    {
      "include": "#c_type"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#impure"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.dream",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.dream",
          "match": "//.*$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.dream",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dream",
          "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.dream",
      "match": "'(\\\\(u\\{[0-9A-Fa-f]+\\}|.)|[^'\\\\])'"
    },
    "atom": {
      "comment": "An atom is a colon and a name: :ok, :error, :not_a_function.",
      "name": "constant.other.symbol.dream",
      "match": ":[A-Za-z_][A-Za-z0-9_]*!?"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dream",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.dream",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.dream",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][-+]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.dream",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "comment": "The parser's list, exactly. `try!`, `comp!` and the rest carry their bang.",
          "name": "keyword.control.dream",
          "match": "\\b(if|else|match|catch|when)\\b|\\b(try!|comp!)"
        },
        {
          "name": "keyword.declaration.dream",
          "match": "\\b(let|priv|rec|fn|import|as|mod|virtual|derive|comp|macro|expand|group|struct|mapping|type)\\b"
        },
        {
          "name": "constant.language.boolean.dream",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.operator.logical.dream",
          "match": "\\bnot\\b"
        },
        {
          "comment": "Refines a type. Contextual, so this is a reader's guess.",
          "name": "keyword.other.where.dream",
          "match": "\\bwhere\\b"
        }
      ]
    },
    "builtin": {
      "comment": "The names the language provides without a module: the VM's builtin table.",
      "name": "support.function.builtin.dream",
      "match": "\\b(spawn!|join!|send!|recv!|self!|raise!|strict!)|\\b(type_of|to_string|len)\\b"
    },
    "foreign": {
      "comment": "A C library's header: `foreign name from \"lib\" {`, `from embedded \"name\"`, `from (expr)`, or no `from` at all. Its own rule rather than a word in `declaration`, because `from` and `embedded` are keywords only here.",
      "match": "\\b(foreign)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(from)(?:\\s+(embedded)\\b)?)?",
      "captures": {
        "1": {
          "name": "keyword.declaration.dream"
        },
        "2": {
          "name": "entity.name.function.dream"
        },
        "3": {
          "name": "keyword.declaration.dream"
        },
        "4": {
          "name": "keyword.declaration.dream"
        }
      }
    },
    "binding": {
      "comment": "A line that begins `name : type` declares that name: a function in a `foreign` block, or an annotated field of a record or a C struct. A reader's guess, since a line is all a grammar sees, but nothing else begins a line that way -- a signature starts with `let`, and `::` is not Dream.",
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*!?)\\s*(?=:\\s)",
      "captures": {
        "1": {
          "name": "entity.name.function.dream"
        }
      }
    },
    "c_type": {
      "comment": "`out`, `borrow` and `taken` modify a C type: `out Db`, `borrow Db`, `taken free`. All three are ordinary names everywhere else, so they are keywords only after a signature's `:` or `->` and before the type they modify.",
      "match": "(?:(->)|(?<=:))\\s*\\b(out|borrow|taken)\\s+(?=[:A-Za-z_(])",
      "captures": {
        "1": {
          "name": "keyword.operator.arrow.dream"
        },
        "2": {
          "name": "storage.modifier.foreign.dream"
        }
      }
    },
    "declaration": {
      "comment": "The name a `let` introduces, so a definition stands out from a use. `resource` is contextual -- a C library's handle type, and a name anywhere else -- so it is a keyword only here, in front of the name it declares; `foreign` has a rule of its own.",
      "match": "\\b(let|macro|group|struct|mapping|type|union|resource)\\s+(rec\\s+)?([A-Za-z_][A-Za-z0-9_]*!?)",
      "captures": {
        "1": {
          "name": "keyword.declaration.dream"
        },
        "2": {
          "name": "keyword.declaration.dream"
        },
        "3": {
          "name": "entity.name.function.dream"
        }
      }
    },
    "impure": {
      "comment": "A trailing `!` means impure, which is a real distinction in this language and worth seeing.",
      "name": "entity.name.function.impure.dream",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*!"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.dream",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.dream",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.dream",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.dream",
          "match": "&&|\\|\\|"
        },
        {
          "comment": "A lone `|` is the union of a type. Tried after `|>` and `||`.",
          "name": "keyword.operator.union.dream",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.arithmetic.dream",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.dream",
          "match": "="
        },
        {
          "name": "keyword.operator.rest.dream",
          "match": "\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "A thunk: $( .. )",
          "name": "punctuation.definition.thunk.dream",
          "match": "\\$\\("
        },
        {
          "comment": "A map: %{ .. }",
          "name": "punctuation.definition.map.dream",
          "match": "%\\{"
        },
        {
          "comment": "An array: #[ .. ]",
          "name": "punctuation.definition.array.dream",
          "match": "#\\["
        }
      ]
    }
  }
}
