// The checks beyond the units: what the compiler refuses (no server needed),
// and the whole library against a throwaway cluster, which skips itself on a
// machine with no PostgreSQL. Both run from the root of the repository.
import std.build;
import std.build.command;
import std.file;
import std.map;

let plan : :map -> :map;
let plan ctx = {
    let repo = file.parent (build.Context.root ctx);
    let chain = command.toolchain ctx;
    let env = map.merge chain (%{ "dream" => chain.["DREAM"], "dreams" => chain.["DREAMS"] });
    build.empty
    |> build.check "contracts" (command.check_in repo "contracts" env "pg/tests/contracts.sh" [])
    |> build.check "live" (command.check_in repo "live" env "pg/tests/live.sh" [])
};
