// What goes into an archive: the one shape every writer here reads.
//
// A package is a list of these, and each format only renames them -- `./usr/`
// for a .deb, `usr/` for Arch, `dream-0.1.0/` at the top of a tarball -- before
// handing them to tar or cpio. A file is never read until the writer reaches
// it: an item names its source and its size, and the bytes are copied from
// disk to the archive a chunk at a time, because the largest thing Dream ships
// is a 100 MB shared library and the heap is the wrong place for it.
//
// `text` is the other kind of file: one `ship` writes itself (a control file,
// `.PKGINFO`), small, and held whole.

import std.list;
import std.str;

union Item {
    file(path : :string, mode : :integer, source : :string, size : :integer)
    text(path : :string, mode : :integer, data : :string)
    dir(path : :string, mode : :integer)
    link(path : :string, target : :string)
}

let path : Item -> :string;
let path i = match i {
    Item.file(p, _, _, _) => p,
    Item.text(p, _, _) => p,
    Item.dir(p, _) => p,
    Item.link(p, _) => p,
};

/// The permission bits. A link has none of its own: every system that reads
/// one reports 0777.
let mode : Item -> :integer;
let mode i = match i {
    Item.file(_, m, _, _) => m,
    Item.text(_, m, _) => m,
    Item.dir(_, m) => m,
    Item.link(_, _) => 0o777,
};

/// The bytes it holds once installed; a link holds its target's name.
let size : Item -> :integer;
let size i = match i {
    Item.file(_, _, _, n) => n,
    Item.text(_, _, d) => str.byte_length d,
    Item.dir(_, _) => 0,
    Item.link(_, t) => str.byte_length t,
};

/// The same item under another name.
let renamed : (:string -> :string) -> Item -> Item;
let renamed f i = match i {
    Item.file(p, m, s, n) => Item.file (f p) m s n,
    Item.text(p, m, d) => Item.text (f p) m d,
    Item.dir(p, m) => Item.dir (f p) m,
    Item.link(p, t) => Item.link (f p) t,
};

let is_dir : Item -> :bool;
let is_dir i = match i { Item.dir(_, _) => true, _ => false };

/// The permission bits most things are installed with: a program and a
/// directory, and everything else.
let executable : :integer = 0o755;
let regular : :integer = 0o644;

when test {
    import std.test;

    let tests = [
        test.case "every item has a path, a mode and a size"
            $( test.eq! [["a", 493, 7], ["b", 420, 2], ["c/", 493, 0], ["d", 511, 3]]
                        (list.map (fn i -> [path i, mode i, size i])
                                  [Item.file "a" 493 "src" 7, Item.text "b" 420 "hi", Item.dir "c/" 493,
                                   Item.link "d" "abc"]) ),
        test.case "renaming keeps the rest"
            $( test.eq! (Item.file "./a" 493 "src" 7) (renamed (fn p -> "./" + p) (Item.file "a" 493 "src" 7)) ),
    ];
}
