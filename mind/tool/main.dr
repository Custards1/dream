// mind -- the build tool for Dream.
//
//   mind new <name>     start a project
//   mind build          compile it
//   mind run [args]     compile and run it
//   mind test           compile with `--test` and run the result
//   mind check          compile without writing an image
//   mind add <source>   add a dependency to mind.toml
//   mind remove <name>  take one out again
//   mind fetch          get dependencies, without building
//   mind update [name]  fetch branch- and url-pinned dependencies again
//   mind deps           list every package the project resolves to
//   mind tree           the same, as the tree of who needs what
//   mind clean          remove `target/`
//
// `mind` is written in Dream and compiled by `dreams`, the same as any other
// program here. It has no compiler of its own: Dream compiles whole programs,
// so a build is "find the packages, hand them to the compiler, run it".
import std.cli;
import std.console;

import std.io;
import std.list;
import std.os;
import std.str;
import std.toml;

import build;
import config;
import fetch;
import manifest;
import util;

let version = "0.1.0";

/// The options, described once. `cli` parses from this list and prints the
/// help from the same list, so an option cannot be one without being the
/// other.
let opts = [
    cli.section "where to look",
    cli.value "C" "dir" "DIR" "the project to work on (default: here, or above)",
    cli.value "o" "output" "PATH" "write the image here",
    cli.list_of "L" "package-path" "DIR" "a package, or a directory holding packages",
    cli.list_of "I" "include" "DIR" "a directory to search for modules",
    cli.list_of "" "host-module" "PATH" "a module the host provides at run time",

    cli.section "what to compile it as",
    cli.list_of "D" "define" "NAME[=V]" "define a `when` flag or value; KEY:NAME[=V] sets KEY's option",
    cli.value "" "profile" "NAME" "build with [profile.NAME] (default: debug)",
    cli.flag "" "release" "the same as --profile release",
    cli.flag "" "debug" "define `debug`",
    cli.list_of "" "target" "PLATFORM" "where the image may run: linux, os=macos,arch=arm64, any",
    cli.list_of "f" "flag" "ARG" "pass this to the compiler as written",

    cli.section "adding a dependency",
    cli.value "" "name" "NAME" "import it as NAME (default: from its manifest or its source)",
    cli.value "" "tag" "TAG" "pin a git dependency to a tag",
    cli.value "" "branch" "BRANCH" "pin a git dependency to a branch",
    cli.value "" "rev" "REV" "pin a git dependency to a commit",
    cli.flag "" "dev" "a [dev-dependencies] entry: only `mind test` sees it",

    cli.section "how to build it",
    cli.value "" "compiler" "PATH" "the compiler to run; a `.dream` is run by the VM",
    cli.flag "v" "verbose" "print the compiler command before running it",
    cli.flag "h" "help" "this message",
    cli.flag "" "version" "print the version",
];

/// The subcommands, described once: `cli.commands` chooses one by that name and
/// the help prints from the same table. Commands that take arguments of their
/// own -- `new <name>`, `run [args]` -- read them from the parsed rest.
let command_spec = [
    cli.command "new"   "create a project in ./<name>" [],
    cli.command "build" "compile the project to target/<name>.dream" [],
    cli.command "run"   "compile, then run it with the arguments given" [],
    cli.command "test"  "compile with --test and run the result" [],
    cli.command "check" "compile without writing an image" [],
    cli.command "repl"  "an interactive session, with this project's packages" [],
    cli.command "add"   "add a dependency: a directory, a git URL, or a tarball" [],
    cli.command "remove" "remove a dependency by name" [],
    cli.command "fetch" "download dependencies without building" [],
    cli.command "update" "fetch branch- and url-pinned dependencies again" [],
    cli.command "deps"  "list every package this project resolves to" [],
    cli.command "tree"  "show the dependency tree" [],
    cli.command "info"  "show what this build would run, without running it" [],
    cli.command "options" "every package's options, and what this build sets them to" [],
    cli.command "clean" "remove target/" [],
    cli.command "help"  "this message" [],
];

let notes = "
A project is a directory with a `mind.toml`. Commands other than `new` look
for one here or above, so they work from anywhere inside a project.

Listing a dependency is all it takes to import it. The key is the name you
import it by, whatever the package calls itself:

  [dependencies]
  util = \"../util\"                                   # a directory
  json = \"https://github.com/u/dream-json#v1.0\"      # git, pinned after the #
  http = { git = \"https://github.com/u/http\", branch = \"main\" }
  pkg  = \"https://example.com/pkg-1.0.tar.gz\"        # a tarball

  [dev-dependencies]                                  # only `mind test` sees these
  bench = \"../bench\"

so `import util.strings` and `import json.parse` work with nothing else said.
A dependency does not need a `mind.toml` of its own -- a directory of `.dr`
files is a package named by its key -- and what one needs to compile (its
`[build] includes` and `host-modules`) comes with it. `mind add` writes these
lines for you:

  mind add ../util
  mind add https://github.com/u/dream-json --tag v1.0
  mind add --dev ../bench

A git dependency must be pinned with a tag, a branch or a commit. Fetched
packages are cached in $MIND_HOME/cache (default ~/.mind/cache) and never
fetched twice; `mind update` fetches the ones pinned to a branch or a URL again.

`[build]` is only for how *this* package is compiled, and every key has a
command-line spelling that wins over it:

  [build]
  compiler     = \"dreams.dream\"   # an image is run by the VM; a program is run
  defines      = [\"fast\"]         # `when` flags this package always compiles with
  package-paths = [\"vendor\"]      # more -L roots, relative to the manifest
  includes     = [\"shims\"]        # more -I directories
  host-modules = [\"host.gpu\"]     # modules the host registers at run time
  output       = \"build/app.dream\" # where the image goes
  flags        = [\"-q\"]           # passed to the compiler as written

The compiler is chosen in this order: --compiler, then [build] compiler, then
$DREAMS, then `dreams.dream` from the installation. A name ending
in `.dream` is an image and is run by the VM; anything else is executed.

A package declares what it can be built as, and a project configures the
packages it depends on, however deep:

  [options]                                           # this package's own
  vendored = { type = \"bool\", default = false, doc = \"build from source\" }
  threads  = { type = [\"off\", \"multi\"], default = \"multi\" }

  [config.sqlite]                                     # a dependency's
  threads = \"off\"

  [dependencies]
  sqlite_sys = { path = \"../sqlite-sys\", when = \"not vendored\" }

  [profile.release]                                   # mind build --release
  defines = [\"release\"]
  flags   = [\"--no-types\"]
  [profile.release.config.sqlite]
  threads = \"multi\"

`when vendored` in a package's code reads that package's option, and
`when sqlite.vendored` another's. `-D sqlite:threads=off` sets one from the
command line, and `mind options` shows them all.

`mind run -- ARGS` passes ARGS to the program rather than to mind.

`mind repl` starts the compiler's interactive session with this project's
packages on the search path. It works outside a project too, with just the
standard library.
"

let usage = "mind -- the build tool for Dream

usage: mind <command> [options] [arguments]

commands:
" + cli.commands_help command_spec + "\n\n" + cli.options_help opts + "\n" + notes;

let fail! message = {
    console.error! ("mind: " + to_string message)
    os.exit! 1
};

let getdir! ma = {
    match ma {
        ()=>os.cwd!(),
        _=> ma
    }

}
/// Load the project, or stop with the reason.
let project_in! in =
    match manifest.find! (getdir! in) {
        [:ok, m] => m,
        [:error, why] => fail! why,
    };

/// Load the project, or stop with the reason.
let project! () = project_in! ()

// --- commands ---------------------------------------------------------------

let cmd_new! name = {
    if str.is_empty name { fail! "new needs a project name" }
    if io.exists! name { fail! (name + " already exists") }
    util.mkdir_p! name
    util.write_file! (util.join name "mind.toml")
        ("[package]\nname = \"" + name + "\"\nversion = \"0.1.0\"\n\n"
         + "# Each dependency's key is the name it is imported by:\n"
         + "#   util = \"../util\"\n"
         + "#   json = \"https://github.com/u/dream-json#v1.0\"\n"
         + "# or run `mind add <directory or URL>`.\n"
         + "[dependencies]\n")
    util.write_file! (util.join name "main.dr")
        ("import std.console;\n\nlet main! = {\n    console.print! \"Hello from " + name + "\"\n};\n")
    util.write_file! (util.join name ".gitignore") "target/\n*.dream\n"
    console.print! ("created " + to_string name)
    console.print! ("  cd " + to_string name + " && mind run")
};

/// Build, and say so. `quiet` sends the line to stderr rather than stdout,
/// for the commands whose stdout is the program's: `mind run > out.txt` should
/// capture what the program printed and nothing of ours.
let report_build! m o label quiet = {
    match build.compile! m o {
        [:error, why] => {
            console.error! why
            os.exit! 1
        },
        [:ok, _] => {
            let line = to_string label + " " + to_string (manifest.name m) + " v"
                       + to_string (manifest.version m);
            if quiet { console.error! line } else { console.print! line }
            :ok
        },
    }
};

/// Hand the program's output on as our own, and its exit code with it. A build
/// tool that swallows the status of what it ran is no use in a script.
let relay! r =
    match r {
        [code, out, err] => {
            if not (str.is_empty out) { console.write! out }
            if not (str.is_empty err) { console.error! err }
            if code != 0 { os.exit! code }
            :ok
        },
    };

let cmd_build! m o = {
    report_build! m o "compiled" false
    console.print! ("  " + to_string (build.output_of m o))
};

let cmd_check! m o = {
    report_build! m (build.with_option :extra ["--no-emit"] o) "checked" false
};

let cmd_run! m o args = {
    report_build! m o "running" true
    relay! (build.run_image! m o args)
};

let cmd_test! m o args = {
    report_build! m (build.with_option :dev true (build.with_option :extra ["--test"] o)) "testing" true
    relay! (build.run_image! m o args)
};

/// An interactive session. It replaces `mind` with the compiler rather than
/// running it as a child, so the terminal is the session's -- which is why
/// nothing here relays anything, and why the only thing to report is failing
/// to start.
///
/// Outside a project it still starts: the standard library is enough to explore
/// the language with, and asking for a `mind.toml` first would make the
/// quickest thing here the most ceremonious.
let cmd_repl! here o =
    match manifest.find! (getdir! here) {
        [:ok, m] => match build.repl! m o { [:error, why] => fail! why },
        [:error, _] => match build.bare_repl! o { [:error, why] => fail! why },
    };

/// What this build would do, without doing it. The compiler is chosen from
/// four places, so "which one is it going to run" is a real question, and the
/// answer should not require reading the source of the build tool.
let cmd_info! m o = {
    console.print! (to_string (manifest.name m) + " v" + to_string (manifest.version m))
    console.print! ("  root     " + to_string (manifest.root m))
    console.print! ("  entry    " + to_string (manifest.entry! m))
    console.print! ("  output   " + to_string (build.output_of m o))
    console.print! ("  profile  " + to_string (build.profile_of o))
    console.print! ("  compiler " + to_string (build.choose_compiler! m (build.option o :compiler ())))
    match build.command_line! m o {
        [:ok, line] => console.print! ("  command  " + line),
        [:error, why] => console.error! ("  command  unavailable: " + to_string why),
    }
};

/// Every package's options: what each declares, and what this build sets it
/// to. A setting has five places it can come from, so "what is `threads`
/// going to be?" deserves an answer that does not need them all read.
let cmd_options! m o = {
    let g = graph_of! m o;
    let values = g.[:options else (%{})];
    let show! key dm = {
        let decls = build.declared dm;
        match map_pairs decls {
            [] => (),
            pairs => {
                console.print! (match key { "" => to_string (manifest.name m) + " (this project)", k => k })
                let lines = list.map (fn [n, d] ->
                    [n + " = " + toml.encode_value ((values.[key else (%{})]).[n else config.Decl.default d]),
                     config.summary d]) (list.sort_on (fn [n, _] -> n) pairs);
                let width = list.fold (fn w [l, _] -> if str.byte_length l > w { str.byte_length l } else { w }) 0 lines;
                list.map (fn [l, why] -> console.print! ("  " + l + str.repeat (width - str.byte_length l + 4) " " + why))
                         lines |> strict!
                ()
            },
        }
    };
    show! build.root_key m
    strict! (list.map (fn n -> match build.node_manifest n { () => (), dm => show! (build.node_key n) dm })
                      (build.nodes g))
    if map_pairs values == [] { console.print! "no package in this build declares an option" }
    :ok
};

/// Load the graph, or stop with the reason.
let graph_of! m o =
    match build.resolve! m (build.with_option :dev true o) false {
        [:error, why] => fail! why,
        [:ok, g] => g,
    };

/// One package, the way `deps` and `tree` show it: its key, what it calls
/// itself when that is something else, and where it came from.
let describe n = {
    let key = build.node_key n;
    let called = match build.node_manifest n {
        () => " (no manifest)",
        dm => if manifest.name dm == key { "" } else { " (package `" + manifest.name dm + "`)" },
    };
    let version = match build.node_manifest n {
        () => "",
        dm => " v" + to_string (manifest.version dm),
    };
    key + version + called + "  " + manifest.dep_source (build.node_dep n)
};

let cmd_deps! m o = {
    console.print! (to_string (manifest.name m) + " v" + to_string (manifest.version m))
    let g = graph_of! m o;
    let ns = build.nodes g;
    if list.is_empty ns { console.print! "  (no dependencies)" }
    let dev_keys = list.map manifest.dep_name (manifest.dev_dependencies m);
    let show! n = {
        let dev = if list.contains (build.node_key n) dev_keys { "  [dev]" } else { "" };
        console.print! ("  " + describe n + dev)
        console.print! ("      -> " + to_string (build.node_abs n))
    };
    strict! (list.map show! ns)
    // What each build script is compiled from, which is a program of its own
    // and so may hold a different package under a key the program also uses.
    let show_build! pair = {
        let [owner, sub] = pair;
        let whose = if owner == build.root_key { "this project" } else { "`" + owner + "`" };
        list.map (fn n -> {
            console.print! ("  " + describe n + "  [build: " + whose + "]")
            console.print! ("      -> " + to_string (build.node_abs n))
        }) (build.nodes sub) |> strict!
    };
    strict! (list.map show_build! (build.build_graphs g))
    :ok
};

/// Who needs what. A package reached a second time is shown once and marked,
/// so a diamond does not print its whole subtree twice and a cycle stops.
let cmd_tree! m o = {
    console.print! (to_string (manifest.name m) + " v" + to_string (manifest.version m))
    let g = graph_of! m o;
    // A package's build dependencies hang under it, marked, in the graph of
    // their own they were walked into; what they use is shown from there.
    let rec branch! g key indent shown = {
        let seen = list.fold (fn seen k -> {
            let n = build.node g k;
            if list.contains k seen {
                console.print! (indent + describe n + " (*)")
                seen
            } else {
                console.print! (indent + describe n)
                branch! g k (indent + "  ") (list.cons k seen)
            }
        }) shown (build.children g key);
        match build.build_graph g key {
            () => seen,
            sub => {
                console.print! (indent + "[build]")
                branch! sub key (indent + "  ") []
                seen
            },
        }
    };
    strict! (branch! g build.root_key "  " [])
    :ok
};

let cmd_fetch! m o = {
    let g = graph_of! m o;
    let fetched = list.filter (fn n -> manifest.dep_kind (build.node_dep n) != :path) (build.nodes g);
    console.print! ("resolved " + to_string (list.length (build.nodes g)) + " packages, "
                    + to_string (list.length fetched) + " of them fetched")
};

/// Throw away the fetched copy of every git or url dependency -- or of the ones
/// named -- and fetch them again. A tag or a commit comes back the same bytes,
/// so this is only ever interesting for a branch; it does them all because
/// "the cache is wrong" is the other reason to run it.
let cmd_update! m o names = {
    // Not through the lock: the lock disagreeing is often why this is being
    // run, and this walk only decides what to fetch again.
    let g = match build.graph! m (build.with_option :dev true o) { [:error, why] => fail! why, [:ok, g] => g };
    let wanted n =
        manifest.dep_kind (build.node_dep n) != :path
        && (list.is_empty names || list.contains (build.node_key n) names);
    // Every program's packages, build scripts' included: a tool pinned to a
    // branch moves the same way a library does.
    let every = list.concat (list.cons (build.nodes g)
                                       (list.map (fn pair -> build.nodes (list.nth 1 pair))
                                                 (build.build_graphs g)));
    let chosen = list.unique (list.filter wanted every);
    let unknown = list.filter (fn k -> not (list.any (fn n -> build.node_key n == k) every)) names;
    if not (list.is_empty unknown) { fail! ("no dependency is called " + str.join_str ", " unknown) }
    strict! (list.map (fn n -> match fetch.forget! (build.node_dep n) {
                          [:error, why] => fail! why,
                          _ => :ok,
                      }) chosen)
    match build.resolve! m (build.with_option :dev true o) true { [:error, why] => fail! why, _ => () }
    match chosen {
        [] => console.print! "nothing to update: every dependency is a directory",
        _ => strict! (list.map (fn n -> console.print! ("updated " + describe n)) chosen),
    }
    :ok
};

// --- adding and removing -------------------------------------------------------

/// The spec `mind add` writes, from what was typed: the source read the way
/// the manifest would read it, and then `--tag`, `--branch` or `--rev` in place
/// of whatever the source's `#` said.
let add_spec! source c = {
    let base = manifest.string_spec source;
    let pins = list.filter (fn p -> cli.get () c p != ()) ["tag", "branch", "rev"];
    match pins {
        [] => base,
        [p] => {
            let unpinned = list.fold (fn acc k -> map_remove acc k) base ["tag", "branch", "rev"];
            unpinned.[p => cli.get () c p]
        },
        _ => fail! "give one of --tag, --branch or --rev",
    }
};

/// What a dependency should be imported as when `--name` does not say: what a
/// manifest in it calls it, or the last part of where it is, without the
/// `.git` or the archive extension and without a `dream-` in front, which is
/// how a repository of a Dream package is usually named and never how it is
/// imported.
let strip_suffix suffix s =
    if str.ends_with suffix s { str.slice 0 (str.byte_length s - str.byte_length suffix) s } else { s };

let strip_prefix prefix s =
    if str.starts_with prefix s { str.slice (str.byte_length prefix) (str.byte_length s - str.byte_length prefix) s }
    else { s };

let guessed_name source =
    strip_prefix "dream-"
        (strip_suffix ".tgz" (strip_suffix ".tar.gz" (strip_suffix ".git"
            (util.basename (strip_suffix "/" (list.head (manifest.split_ref source)))))));

let add_name! source dir c =
    match cli.get () c "name" {
        () => match manifest.load_dependency! dir {
            [:ok, dm] => if str.is_empty (manifest.name dm) { guessed_name source } else { manifest.name dm },
            _ => guessed_name source,
        },
        n => n,
    };

let cmd_add! m c args = {
    let source = match args {
        [s] => s,
        [] => fail! "add needs a directory, a git URL or a tarball URL",
        _ => fail! "add takes one source; use --name to choose what it is imported as",
    };
    let raw = add_spec! source c;
    // A directory is typed relative to where you are and stored relative to
    // the manifest, which is where it will be read from.
    let spec = match raw.["path" else ()] {
        () => raw,
        p => raw.["path" => util.relative! (manifest.root m) p],
    };
    let section = if cli.flag_set c "dev" { "dev-dependencies" } else { "dependencies" };
    let probe = [guessed_name source, spec];
    match fetch.resolve! (manifest.root m) probe {
        [:error, why] => fail! why,
        [:ok, dir] => {
            let key = add_name! source dir c;
            let file = util.join (manifest.root m) "mind.toml";
            let text = match util.read_file! file { () => "", t => t };
            util.write_file! file (manifest.with_dependency section key spec text)
            console.print! ("added " + key + " = " + manifest.dep_source [key, spec]
                            + " to [" + section + "]")
            // Reading it back through the whole graph is the check that
            // matters: a new dependency can bring a conflict with it.
            match manifest.load! (manifest.root m) {
                [:ok, m2] => match build.graph! m2 (build.with_option :dev true (options_of! c)) {
                    [:error, why] => console.error! ("warning: " + why),
                    _ => :ok,
                },
                [:error, why] => console.error! ("warning: " + why),
            }
        },
    }
};

let cmd_remove! m names = {
    if list.is_empty names { fail! "remove needs the name of a dependency" }
    let file = util.join (manifest.root m) "mind.toml";
    let text = match util.read_file! file { () => fail! ("cannot read " + file), t => t };
    let step acc key = match acc {
        [t, missing] => match manifest.without_dependency "dependencies" key t {
            [t2, true] => [t2, missing],
            [_, false] => match manifest.without_dependency "dev-dependencies" key t {
                [t3, true] => [t3, missing],
                [_, false] => [t, list.append missing [key]],
            },
        },
    };
    match list.fold step [text, []] names {
        [_, [_, .._] as missing] => fail! ("no dependency is called " + str.join_str ", " missing),
        [after, []] => {
            util.write_file! file after
            strict! (list.map (fn k -> console.print! ("removed " + k)) names)
            :ok
        },
    }
};

let cmd_clean! m = {
    let dir = build.target_dir m;
    if io.exists! dir {
        os.exec! "rm" ["-rf", dir]
        console.print! ("removed " + to_string dir)
    } else {
        console.print! "nothing to clean"
    }
};

let filepatch! filein outfile using  = {
    let rec update_writer! out cont = {
         if cont && out{
            let data = recv!();
            if data {
                strict! {
                    data |> io.write! out
                }
                update_writer! out data 
            }
            
         } else {
            false
         }

    }
    let writer = spawn! $(update_writer! (io.open! outfile :write) true )
  
    let reader = io.open! filein :read
    let rec read_and_update! r w remaining = {
        match remaining {
            [] =>  () |> send! w,
            _=> {
                strict!{ send! w remaining }
                read_and_update! r w (io.read! r 4000)
            }
        }
    }
    strict! {read_and_update! reader writer using }
    send! writer ()
    join! writer
}
let patch! filein fileout = filepatch! filein fileout "#!/bin/env dream\n"

let cmd_patch! filein fileout = patch! filein $( if (fileout) {fileout} else {"./a.out"})

/// Split `mind`'s own arguments from the program's at the first `--`.
///
/// `mind run -- --help` has to run the program with `--help`, not print ours.
/// Doing this before the options are parsed is what keeps the two lines apart:
/// after it, nothing on the left can be meant for the program.
let rec split_at_dashes args =
    match args {
        [] => [[], []],
        ["--", ..theirs] => [[], theirs],
        [a, ..more] =>
            match split_at_dashes more {
                [mine, theirs] => [list.cons a mine, theirs],
            },
    };

/// The program's defines: every `-D` that is not scoped to a package, and
/// `--debug`, which is `-D debug` spelled the way people reach for it.
let defines_of c =
    list.append (list.filter (fn d -> config.split_scoped d == ()) (cli.all c "define"))
                (if cli.flag_set c "debug" { ["debug"] } else { [] });

/// Every `-D KEY:name=value`, as `[key, name, value]`.
let sets_of c = list.flat_map (fn d -> match config.split_scoped d { () => [], s => [s] }) (cli.all c "define");

/// `--profile NAME`, or `--release` for that one; `debug` when neither.
let profile_of! c =
    match [cli.get () c "profile", cli.flag_set c "release"] {
        [(), false] => "debug",
        [(), true] => "release",
        [p, false] => p,
        [p, true] => if p == "release" { p } else { fail! ("--release and --profile " + p + " say two different things") },
    };

let options_of! c =
    list.fold (fn o kv -> build.with_option (list.head kv) (list.nth 1 kv) o)
              build.options
              [[:compiler, cli.get () c "compiler"],
               [:output,   cli.get () c "output"],
               [:paths,    cli.all c "package-path"],
               [:includes, cli.all c "include"],
               [:hosts,    cli.all c "host-module"],
               [:flags,    cli.all c "flag"],
               [:defines,  defines_of c],
               [:sets,     sets_of c],
               [:profile,  profile_of! c],
               [:targets,  cli.all c "target"],
               [:verbose,  cli.flag_set c "verbose"]];

let run_command! c theirs = {
    let o = options_of! c;
    // The project is loaded inside the arm that needs one. `mind new` and
    // `mind help` are answers you can give outside a project, and asking for a
    // manifest before knowing the command made them fail where they should
    // not. The line never naming a command is the same answer: the usage.
    let here = cli.get () c "dir";
    match cli.chosen c {
        () => console.write! usage,
        cm => match cli.command_name cm {
                  "help"  => console.write! usage,
                  "new"   => match cli.rest c {
                                 [] => fail! "new needs a project name",
                                 [name, .._] => cmd_new! name,
                             },
                  "build" => cmd_build! (project_in! here) o,
                  "check" => cmd_check! (project_in! here) o,
                  "run"   => cmd_run! (project_in! here) o (list.append (cli.rest c) theirs),
                  "test"  => cmd_test! (project_in! here) o (list.append (cli.rest c) theirs),
                  "deps"  => cmd_deps! (project_in! here) o,
                  "tree"  => cmd_tree! (project_in! here) o,
                  "fetch" => cmd_fetch! (project_in! here) o,
                  "update" => cmd_update! (project_in! here) o (cli.rest c),
                  "add"   => cmd_add! (project_in! here) c (cli.rest c),
                  "remove" => cmd_remove! (project_in! here) (cli.rest c),
                  "clean" => cmd_clean! (project_in! here),
                  "info"  => cmd_info! (project_in! here) o,
                  "options" => cmd_options! (project_in! here) o,
                  "repl"  => cmd_repl! here o,
              },
    }
};

let main! =
    match split_at_dashes (os.args! ()) {
        [mine, theirs] =>
            match cli.commands opts command_spec mine {
                [:error, why] => {
                    console.error! ("mind: " + to_string why)
                    console.error! "try `mind help`"
                    os.exit! 2
                },
                [:ok, c] =>
                    if cli.flag_set c "help" { console.write! usage }
                    else if cli.flag_set c "version" { console.print! ("mind " + version) }
                    else { run_command! c theirs },
            },
    };
