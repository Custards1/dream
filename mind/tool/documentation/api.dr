// Source documentation without running the compiler or evaluating the package.
import std.list;
import std.str;
import documentation.markdown;
import documentation.examples;

// Lexical state: delimiter depth, quote, block-comment depth. It keeps example
// declarations inside strings, comments and function bodies out of the API.
let rec advance line i state = {
    if i >= len line { state }
    else {
        let depth = list.nth 0 state;
        let quote = list.nth 1 state;
        let block = list.nth 2 state;
        let c = str.slice i 1 line;
        let pair = str.slice i 2 line;
        if block > 0 {
            if pair == "/*" { advance line (i + 2) [depth, quote, block + 1] }
            else if pair == "*/" { advance line (i + 2) [depth, quote, block - 1] }
            else { advance line (i + 1) state }
        }
        else if quote != "" {
            if c == "\\" { advance line (i + 2) state }
            else if c == quote { advance line (i + 1) [depth, "", 0] }
            else {
                let end = str.upto (quote + "\\") (i + 1) line;
                advance line end state
            }
        }
        else if pair == "//" { state }
        else if pair == "/*" { advance line (i + 2) [depth, "", 1] }
        else if c == "\"" || c == "'" { advance line (i + 1) [depth, c, 0] }
        else if c == "{" || c == "[" || c == "(" { advance line (i + 1) [depth + 1, "", 0] }
        else if c == "}" || c == "]" || c == ")" { advance line (i + 1) [depth - 1, "", 0] }
        else {
            let end = str.upto "\"'{}[]()/" (i + 1) line;
            advance line end state
        }
    }
};
let declaration line = {
    let s = str.trim line;
    let prefix = if str.starts_with "let rec " s { 8 } else if str.starts_with "let " s { 4 }
                 else if str.starts_with "type " s { 5 } else { 0 };
    if prefix == 0 { () }
    else {
        let rest = markdown.tail prefix s;
        let n = str.span "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_!" 0 rest;
        if n == 0 { () } else {
            let end = str.find " =" s;
            [str.slice 0 n rest, if end >= 0 { str.slice 0 end s } else { s }]
        }
    }
};
// Each entry carries its name, written signature, prose and source line.
let rec scan lines number state comments entries = match lines {
    [] => list.reverse entries,
    [line, ..rest] => {
        let s = str.trim line;
        if state == [0, "", 0] && str.starts_with "///" s {
            scan rest (number + 1) state (list.append comments [comment_text s]) entries
        }
        else {
            let decl = if state == [0, "", 0] { declaration s } else { () };
            let next = advance line 0 state;
            let docs = str.join_str "\n" comments;
            let updated = match decl {
                [name, sig] if not (list.is_empty comments) =>
                    list.cons (%{ :name => name, :signature => sig, :doc => docs, :line => number }) entries,
                _ => entries,
            };
            scan rest (number + 1) next (if s == "" { comments } else { [] }) updated
        }
    },
};
let extract text = scan (str.split "\n" text) 1 [0, "", 0] [] [];
let render! ctx source entries = str.join_str "" (list.map (fn e ->
    "<section class=\"symbol\"><h2 id=\"" + markdown.escape e.[:name] + "\"><a class=\"anchor\" href=\"#" + markdown.escape e.[:name] + "\">" + markdown.escape e.[:name] + "</a></h2>"
    + "<pre><code>" + markdown.escape e.[:signature] + "</code></pre>"
    + examples.render! ctx e.[:doc] + "<a class=\"source\" href=\"" + markdown.escape source + "#L" + to_string e.[:line] + "\">View source · line " + to_string e.[:line] + "</a></section>") entries);
let source_html text = "<pre class=\"source-code\"><code>" + str.join_str "\n" (list.map (fn [i, line] ->
    "<span id=\"L" + to_string (i + 1) + "\"><a href=\"#L" + to_string (i + 1) + "\">" + to_string (i + 1) + "</a> " + markdown.escape line + "</span>") (list.enumerate (str.split "\n" text))) + "</code></pre>";

let comment_text line = {
    let text = markdown.tail 3 line;
    if str.starts_with " " text { markdown.tail 1 text } else { text }
};
