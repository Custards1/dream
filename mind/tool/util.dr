// Paths, files, and the small things every other module here needs.

import std.io;
import std.list;
import std.os;
import std.str;

// --- paths ------------------------------------------------------------------
//
// Textual, not resolved against the file system: `mind` passes paths to
// the compiler and to `git`, both of which do their own resolving, so normalising
// here would only lose information -- a relative dependency path is meaningful
// relative to the manifest that named it.

// Windows accepts both separators. Keep the platform query at runtime so
// this compiler image can be copied unchanged between operating systems.
let slashes p = match os.platform () {
    :windows => str.join_str "/" (str.split "\\" p),
    _ => p,
};

let root p = match os.platform () {
    :windows => match p {
        _ if str.byte_length p >= 3 && str.slice 1 2 p == ":/" => str.slice 0 3 p,
        _ if str.starts_with "//" p => {
            let parts = list.filter (fn s -> not (str.is_empty s)) (str.split "/" p);
            match parts {
                [server, share, .._] => "//" + server + "/" + share,
                _ => "/",
            }
        },
        _ if str.starts_with "/" p => "/",
        _ => "",
    },
    _ => if str.starts_with "/" p { "/" } else { "" },
};

let is_absolute p = not (str.is_empty (root (slashes p)));
let home! () = match os.env! "HOME" {
    () => os.env! "USERPROFILE",
    home => home,
};

/// A leading `~` means the home directory.
///
/// A shell expands a tilde it can see, and `export MINDV2_PATH="~/.mindv2"`
/// hides it inside quotes, so what arrives is a literal `~`. Nothing on disk is
/// called that, so a setting written that way silently finds nothing -- which
/// reads as a missing library rather than as a quoted tilde. Every path that
/// comes out of the environment goes through here. `~other`, which names
/// another user's home, is left alone: guessing where that is would be worse
/// than not answering.
let expand_home! p =
    if p == "~" || str.starts_with "~/" p {
        match home! () {
            () => p,
            home => home + str.slice 1 (str.byte_length p - 1) p,
        }
    }
    else { p };

/// The value of an environment variable, with a leading `~` expanded, or `()`.
let env_path! name =
    match os.env! name {
        () => (),
        v => expand_home! v,
    };

/// `.` is dropped rather than kept, so a project at `.` gets `main.dr` and not
/// `././main.dr` -- these paths end up in error messages and in the `-L` flags
/// handed to the compiler, and both are read by people.
let join original_a original_b = {
    let a = slashes original_a;
    let b = slashes original_b;
    match [a, b] {
        ["", _] => b,
        [".", _] => b,
        [_, ""] => a,
        [_, "."] => a,
        _ if is_absolute b => b,
        _ if str.ends_with "/" a => a + b,
        _ => a + "/" + b,
    }
};

/// Everything before the last `/`, or "." when there is none.
let dirname original = {
    let path = slashes original;
    let rec last_slash i best =
        if i >= str.byte_length path { best }
        else if str.slice i 1 path == "/" { last_slash (i + 1) i }
        else { last_slash (i + 1) best };
    let at = last_slash 0 (0 - 1);
    match at {
        _ if at < 0 => ".",
        _ if at < str.byte_length (root path) => root path,
        0 => "/",
        _ => str.slice 0 at path,
    }
};

/// `.` and `..` folded away, textually. Used only to ask whether two spellings
/// name one directory -- `app/../util` and `util` reached through two packages
/// -- and never to rewrite a path handed on to anything else.
let normalize original = {
    let path = slashes original;
    let anchor = root path;
    let absolute = not (str.is_empty anchor);
    let step acc seg =
        match [seg, acc] {
            ["", _] => acc,
            [".", _] => acc,
            ["..", []] => if absolute { [] } else { [".."] },
            ["..", ["..", .._]] => list.cons ".." acc,
            ["..", [_, ..up]] => up,
            [s, _] => list.cons s acc,
        };
    let segs = list.reverse (list.fold step [] (str.split "/" (str.slice (str.byte_length anchor) (str.byte_length path - str.byte_length anchor) path)));
    let joined = str.join_str "/" segs;
    match [absolute, joined] {
        [true, ""] => anchor,
        [true, _] => join anchor joined,
        [false, ""] => ".",
        _ => joined,
    }
};

/// `path` made absolute against the working directory, and normalized: the
/// spelling two dependencies on one directory agree on.
let absolute! path =
    normalize (if is_absolute path { path } else { join (os.cwd! ()) path });

/// `to` written relative to the directory `from`, both as the working
/// directory would read them: what `mind add ../util`, typed in one place,
/// has to become in a manifest that is read from another.
let relative! from to = {
    let a = str.split "/" (absolute! from);
    let b = str.split "/" (absolute! to);
    let rec common xs ys =
        match [xs, ys] {
            [[x, ..xr], [y, ..yr]] if x == y => common xr yr,
            _ => [xs, ys],
        };
    match common a b {
        [ups, downs] => match list.concat [list.map (fn _ -> "..") (list.filter (fn s -> s != "") ups),
                                           list.filter (fn s -> s != "") downs] {
            [] => ".",
            segs => str.join_str "/" segs,
        },
    }
};

let basename path = {
    let parts = str.split "/" path;
    if list.is_empty parts { path } else { list.last parts }
};

// --- files ------------------------------------------------------------------

let rec read_chunks! h acc = {
    let chunk = io.read! h 65536;
    if len chunk == 0 { acc } else { read_chunks! h (acc + chunk) }
};

/// The whole file, or `()` when it cannot be opened.
let read_file! path = {
    let opened = try! { io.open! path :read } catch e { () };
    match opened {
        () => (),
        h => {
            let text = read_chunks! h "";
            io.close! h
            text
        }
    }
};

let write_file! path text = {
    let h = io.open! path :write;
    let rec put! offset = {
        let left = str.byte_length text - offset;
        if left <= 0 { :done }
        else {
            // Two arguments, not one string built from both: `io.write!` is
            // curried, so passing one leaves a function behind rather than
            // failing here, and it fails as `offset + <function>` instead.
            let wrote = io.write! h (str.slice offset left text);
            put! (offset + wrote)
        }
    };
    put! 0
    io.close! h
};

/// Make `path` and every directory above it.
let rec mkdir_p! path =
    match path {
        "" => :done,
        "." => :done,
        "/" => :done,
        p => {
            let parent = dirname p;
            if parent != p { mkdir_p! parent } else { :done }
            io.mkdir! p
        }
    };

when test {
    import std.test;

    let tests = [
        // paths are textual: `mind` hands them to the compiler and to `git`, which
        // do their own resolving, so normalising here would lose meaning.
        test.case "join"              $( test.eq! "a/b" (join "a" "b") ),
        test.case "join keeps one slash" $( test.eq! "a/b" (join "a/" "b") ),
        test.case "join with empty left" $( test.eq! "b" (join "" "b") ),
        test.case "join with empty right" $( test.eq! "a" (join "a" "") ),
        test.case "join drops a dot on the left"  $( test.eq! "b" (join "." "b") ),
        test.case "join drops a dot on the right" $( test.eq! "a" (join "a" ".") ),
        test.case "join of two dots"              $( test.eq! "." (join "." ".") ),
        test.case "join relative"     $( test.eq! "a/../b" (join "a" "../b") ),

        test.case "dirname"           $( test.eq! "a/b" (dirname "a/b/c") ),
        test.case "dirname of a bare name" $( test.eq! "." (dirname "c") ),
        test.case "dirname at the root" $( test.eq! "/" (dirname "/c") ),
        test.case "dirname nested"    $( test.eq! "/a" (dirname "/a/b") ),

        test.case "basename"          $( test.eq! "c" (basename "a/b/c") ),
        test.case "relative walks up and down"
            $( test.eq! ["../util", "lib/x", ".", "../../c"]
                        [relative! "/w/app" "/w/util", relative! "/w" "/w/lib/x",
                         relative! "/w/a" "/w/a/", relative! "/w/a/b" "/w/c"] ),
        test.case "normalize folds .. and ."
            $( test.eq! ["/a/c", "c", "../x", "/", "."]
                        [normalize "/a/b/../c/.", normalize "a/../c", normalize "../x",
                         normalize "/..", normalize "a/.."] ),
        test.case "basename of a bare name" $( test.eq! "c" (basename "c") ),
    ];
}
