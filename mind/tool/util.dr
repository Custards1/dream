// Where `mind` keeps what it shares between projects.
//
// This file once held `mind`'s own paths and file helpers. They are
// `std.path` and `std.file` now, which is where the compiler gets them too:
// two copies had come to disagree about `basename "a/b/"`, and a third, in
// the packager, about where a drive letter ends.

import std.path;

/// `mind`'s own directory: `$MIND_HOME`, or `~/.mind`. What is kept there is
/// shared between projects, because it is keyed by what it is -- a repository
/// at a revision, a build step by its key -- and not by who asked.
let mind_home! : :unit -> :string;
let mind_home! () =
    match path.from_env! "MIND_HOME" {
        () => match path.home! () {
            () => ".mind",
            h => path.join h ".mind",
        },
        h => h,
    };
