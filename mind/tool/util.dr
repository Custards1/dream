// Paths, files, and the small things every other module here needs.
import std.core;
import std.io;
import std.list;
import std.os;
import std.str;

// --- paths ------------------------------------------------------------------
//
// Textual, not resolved against the file system: `mind` passes paths to
// `dreamc` and to `git`, both of which do their own resolving, so normalising
// here would only lose information -- a relative dependency path is meaningful
// relative to the manifest that named it.

/// `.` is dropped rather than kept, so a project at `.` gets `main.dr` and not
/// `././main.dr` -- these paths end up in error messages and in the `-L` flags
/// handed to the compiler, and both are read by people.
let join a b =
    if str.is_empty a || a == "." { b }
    else if str.is_empty b || b == "." { a }
    else if str.ends_with "/" a { a + b }
    else { a + "/" + b };

/// Everything before the last `/`, or "." when there is none.
let dirname path = {
    let rec last_slash i best =
        if i >= str.byte_length path { best }
        else if str.slice i 1 path == "/" { last_slash (i + 1) i }
        else { last_slash (i + 1) best };
    let at = last_slash 0 (0 - 1);
    if at < 0 { "." } else if at == 0 { "/" } else { str.slice 0 at path }
};

let basename path = {
    let parts = str.split "/" path;
    if list.is_empty parts { path } else { list.last parts }
};

// --- files ------------------------------------------------------------------

let rec read_chunks! h acc = {
    let chunk = io.read! h 65536;
    if len chunk == 0 { acc } else { read_chunks! h (acc + chunk) }
};

/// The whole file, or `()` when it cannot be opened.
let read_file! path = {
    let opened = try! { io.open! path :read } catch e { () };
    match opened {
        () => (),
        h => {
            let text = read_chunks! h "";
            io.close! h
            text
        }
    }
};

let write_file! path text = {
    let h = io.open! path :write;
    let rec put! offset = {
        let left = str.byte_length text - offset;
        if left <= 0 { :done }
        else {
            let wrote = io.write! (to_string h + to_string (str.slice offset left text));
            put! (offset + wrote)
        }
    };
    put! 0
    io.close! h
};

/// Make `path` and every directory above it.
let rec mkdir_p! path =
    match path {
        "" => :done,
        "." => :done,
        "/" => :done,
        p => {
            let parent = dirname p;
            if parent != p { mkdir_p! parent } else { :done }
            io.mkdir! p
        }
    };

when test {
    import std.test;

    let tests = [
        // paths are textual: `mind` hands them to `dreamc` and to `git`, which
        // do their own resolving, so normalising here would lose meaning.
        test.case "join"              $( test.eq! "a/b" (join "a" "b") ),
        test.case "join keeps one slash" $( test.eq! "a/b" (join "a/" "b") ),
        test.case "join with empty left" $( test.eq! "b" (join "" "b") ),
        test.case "join with empty right" $( test.eq! "a" (join "a" "") ),
        test.case "join drops a dot on the left"  $( test.eq! "b" (join "." "b") ),
        test.case "join drops a dot on the right" $( test.eq! "a" (join "a" ".") ),
        test.case "join of two dots"              $( test.eq! "." (join "." ".") ),
        test.case "join relative"     $( test.eq! "a/../b" (join "a" "../b") ),

        test.case "dirname"           $( test.eq! "a/b" (dirname "a/b/c") ),
        test.case "dirname of a bare name" $( test.eq! "." (dirname "c") ),
        test.case "dirname at the root" $( test.eq! "/" (dirname "/c") ),
        test.case "dirname nested"    $( test.eq! "/a" (dirname "/a/b") ),

        test.case "basename"          $( test.eq! "c" (basename "a/b/c") ),
        test.case "basename of a bare name" $( test.eq! "c" (basename "c") ),
    ];
}
