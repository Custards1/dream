// Building: working out the package graph, then calling the compiler.
//
// `mind` does not compile anything itself. Dream compiles whole programs, so
// the compiler wants every package at once rather than a series of object
// files -- which means a build is: find the packages, hand `dreamc` their
// directories, run it. There is nothing to cache and no link step.
import std.core;
import std.io;
import std.list;
import std.os;
import std.str;

import fetch;
import manifest;
import util;

/// Every package the root needs, transitively, as directories to search.
///
/// Depth-first with a seen-set: a diamond is normal (two dependencies sharing
/// a third) and must be visited once, and a cycle must not spin.
let rec collect! m seen acc = {
    let deps = manifest.dependencies m;
    let rec each! ds seen acc =
        match ds {
            [] => [:ok, seen, acc],
            [d, ..rest] => match fetch.resolve! (manifest.root m) d {
                [:error, why] => [:error, why, acc],
                [:ok, dir] =>
                    if list.contains dir seen { each! rest seen acc }
                    else {
                        match manifest.load! dir {
                            [:error, why] => [:error, why, acc],
                            [:ok, dep_m] => {
                                let deeper = collect! dep_m (list.cons dir seen) (list.cons dir acc);
                                match deeper {
                                    [:error, why, partial] => [:error, why, partial],
                                    [:ok, seen2, acc2] => each! rest seen2 acc2,
                                }
                            },
                        }
                    },
            },
        };
    each! deps seen acc
};

/// Where the standard library is.
///
/// Every program gets `std` without asking for it, so finding it is `mind`'s
/// job and not the user's. The candidates, in order:
///
///   1. `MIND_STDLIB`, for an installed `mind` to point at what shipped with
///      it, and for anyone who wants a different library entirely.
///   2. `$MIND_HOME/std` (default `~/.mind/std`), where an install puts it.
///   3. a `mind` directory at or above the working directory -- which is what
///      makes the library's own repository work with no configuration at all.
///
/// The last is a search rather than a fixed path because a build may be run
/// from anywhere inside a project, exactly as `git` may be.
let stdlib_root! () = {
    let named = os.env! "MIND_STDLIB";
    if named != () { named }
    else {
        let home = match os.env! "MIND_HOME" { () => util.join (home_dir! ()) ".mind", h => h };
        let installed = util.join home "std";
        if io.is_dir! installed { home }
        else {
            match find_upwards! (os.cwd! ()) "mind" {
                () => "mind",
                found => found,
            }
        }
    }
};

let home_dir! () = match os.env! "HOME" { () => ".", h => h };

/// The nearest `name` directory at or above `from`, or `()`. Holds a library
/// whose `std` is a package, so it is the *parent* that becomes a `-L` root.
let rec find_upwards! from name = {
    let candidate = util.join from name;
    if io.is_dir! (util.join candidate "std") { candidate }
    else {
        let up = util.dirname from;
        if up == from || up == "." { () } else { find_upwards! up name }
    }
};

/// `[:ok, [-L, dir, -L, dir, ..]]` -- the search paths for one build.
/// `[:ok, [-L, dir, -L, dir, ..]]` -- the search paths for one build.
let search_paths! m = {
    match collect! m [manifest.root m] [] {
        [:error, why, _] => [:error, why],
        [:ok, _, dirs] => {
            // The standard library, then every dependency.
            let all = list.cons (stdlib_root! ()) (list.reverse dirs);
            [:ok, list.flat_map (fn d -> ["-L", d]) all]
        },
    }
};

let target_dir m = util.join (manifest.root m) "target";
let image m = util.join (target_dir m) (manifest.name m + ".dream");

/// Compile the package. `extra` carries flags like `--test`.
let compile! m extra = {
    match search_paths! m {
        [:error, why] => [:error, why],
        [:ok, paths] => {
            util.mkdir_p! (target_dir m)
            let args = list.append [manifest.entry m]
                                   (list.append paths
                                                (list.append ["-o", image m] extra));
            let compiler = match os.env! "DREAMC" { () => "dreamc", c => c };
            let r = os.exec! compiler args;
            let code = core.map_get r :code (0 - 1);
            if code == 0 { [:ok, core.map_get r :out ""] }
            else {
                let err = core.map_get r :err "";
                let out = core.map_get r :out "";
                [:error, str.trim (err + out)]
            }
        },
    }
};

/// Run a built image, passing `args` to the program.
let run_image! m args = {
    let vm = match os.env! "DREAM" { () => "dream", v => v };
    let r = os.exec! vm (list.cons (image m) args);
    [core.map_get r :code (0 - 1), core.map_get r :out "", core.map_get r :err ""]
};
