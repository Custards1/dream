// `mind docs`: Markdown guides and documented Dream declarations, as an
// offline site. No network request or project build script is run; the
// compiler is run for the fenced examples, several at a time.
import std.cli;
import std.console;
import std.file;
import std.io;
import std.json;
import std.list;
import std.map;
import std.os;
import std.num;
import std.path;
import std.progress;
import std.proc;
import std.vm;
import documentation.examples;
import std.str;
import std.toml;
import documentation.api;
import documentation.markdown;
import documentation.theme;
import documentation.links;
import build;
import manifest;
import serve;

let opts = [
    cli.value "C" "dir" "DIR" "the project (default: here, or above)",
    cli.value "o" "output" "DIR" "output directory (default: target/docs, relative to project)",
    cli.value "" "guides" "DIR" "Markdown directory (default: docs, relative to project)",
    cli.value "" "compiler" "PATH" "compiler for documentation examples",
    cli.value "" "example-timeout" "MS" "compile and run deadline per example (default: 5000 ms)",
    cli.value "j" "jobs" "N" "examples to run at once (default: one per core)",
    cli.flag "" "no-api" "compile only Markdown guides",
    cli.flag "" "strict-examples" "fail when an example's outcome is not the one its fence promises",
    cli.flag "h" "help" "show documentation options",
];
let usage = "mind docs -- compile guides and source API documentation\n\nusage: mind docs [options]\n\n"
    + cli.options_help opts + "\n\nConfigure title, guides, output and api in [docs] in mind.toml.\n"
    + "Write guides in Markdown and document public declarations with /// comments.\n"
    + "Open target/docs/index.html in a browser, or host the directory anywhere.\n"
    + "\n`mind docs serve` builds them and serves them on this machine:\n\n"
    + cli.options_help serve_opts + "\n";

/// What `mind docs serve` adds to `mind docs`: `serve`'s own options, and
/// `--watch`.
let serve_opts = list.append serve.opts [
    cli.flag "w" "watch" "build again whenever a guide, a module or mind.toml changes",
    cli.flag "" "no-build" "serve what was built last, without building",
];
let fail! why = {
    console.error! ("mind docs: " + why)
    os.exit! 1
};
let read! path = match file.read! path { () => fail! ("cannot read " + path), text => text };
let page url title body text = %{ :url => url, :title => title, :body => body, :text => text };
let html_path path = str.slice 0 (len path - 3) path + ".html";
let ignored path = list.any (fn p -> list.contains p ["target", "build", ".git", ".hg", ".svn", "node_modules", "tests", "examples"]) (str.split "/" path);
let files! : :string -> [:string];
let files! dir = if io.is_dir! dir { list.sort (filter (fn p -> not (ignored p)) (file.walk! dir)) } else { [] };
/// A guide, read: its page and its Markdown.
let guide! dir rel = %{ :url => "guides/" + html_path rel, :rel => rel, :text => read! (path.join dir rel) };
let guide_page ctx g = page g.[:url] (markdown.title g.[:rel] g.[:text])
                            (examples.render ctx.[:page => g.[:url]] g.[:text]) g.[:text];
/// A module, read: where its page goes, its source and its documented entries.
let module! m label dir rel = {
    let text = read! (path.join dir rel);
    %{ :manifest => m, :label => label, :rel => rel, :text => text, :entries => api.extract text,
       :url => "api/" + label + "/" + html_path rel }
};
/// A module's name as it is imported: `std.http.server`, `demo.lib`.
let module_name info = {
    let rel = info.[:rel];
    let module = str.slice 0 (len rel - 3) rel;
    let stem = if module == "mod" { "" } else if str.ends_with "/mod" module { str.slice 0 (len module - 4) module } else { module };
    info.[:label] + (if stem == "" { "" } else { "." + str.replace "/" "." stem })
};
/// How much of a module is documented, as its card and its page say it.
let documented entries = match list.length entries { 1 => "1 documented name", n => to_string n + " documented names" };
let module_pages ctx info = {
    let label = info.[:label];
    let rel = info.[:rel];
    let entries = info.[:entries];
    let url = info.[:url];
    let source = "source/" + label + "/" + html_path rel;
    let name = module_name info;
    let back = theme.relative_root url + source;
    if list.is_empty entries { [] } else {
        [page url name ("<h1>" + markdown.escape name + "</h1><p class=\"module-lede\">" + documented entries
                        + " · <a href=\"" + markdown.escape back + "\">source</a></p>" + api.render ctx.[:page => url] back entries)
             (str.join_str "\n" (map (fn e -> e.[:name] + " " + e.[:signature] + " " + e.[:doc]) entries)),
         page source (name + " source") ("<h1>" + markdown.escape name + " source</h1>" + api.source_html info.[:text]) ""]
    }
};
let package_modules! m = {
    let label = manifest.name m;
    if label == "" || markdown.slug label != label { fail! "package names used in docs must contain only lowercase letters, digits, hyphens and underscores" }
    let dir = manifest.src! m;
    map (fn rel -> module! m label dir rel) (filter (str.ends_with ".dr") (files! dir)) |> strict!
};
let api_modules! m = {
    let own = if manifest.is_package m { package_modules! m } else { [] };
    let children = flat_map (fn member -> match manifest.find! (path.join (manifest.root m) member) {
        Result.ok(child) => package_modules! child,
        Result.error(why) => fail! why,
    }) (manifest.members m) |> strict!;
    list.append own children
};
/// The standard library's modules, for the reference every site carries
/// beside its own, so a guide or a doc comment can link `list.map` as surely
/// as its own names. They are read from the library `mind` builds against
/// (`build.stdlib_root!`), so the pages describe the `std` the project's
/// programs get, and their examples are not run again: they are the
/// library's, and its own site shows them run. None for the library itself,
/// or for a project that says `[docs] std = false`.
let std_modules! m own = {
    let wanted = toml.get true (manifest.doc m) "docs" "std" != false && not (list.any (fn i -> i.[:label] == "std") own);
    if not wanted { [] }
    else {
        match manifest.find! (path.join (build.stdlib_root! ()) "std") {
            Result.ok(lib) => package_modules! lib,
            Result.error(_) => [],
        }
    }
};
/// The page that opens the standard library's reference: a card a module.
let library_page infos = {
    let url = "api/std/index.html";
    let site = theme.Site.make "Standard library" "" "The modules every Dream program can import. Names in code anywhere in these docs link here.";
    page url "Standard library"
         (theme.overview_html site [] (flat_map (fn i -> if list.is_empty i.[:entries] { [] }
                                                         else { [[theme.relative_root url + i.[:url], module_name i, documented i.[:entries]]] }) infos))
         "standard library std"
};
let write! out rel text = {
    let path = path.join out rel;
    file.mkdir_all! (file.parent path)
    file.write! path text
};
/// Where the guides are read from and the site is written, as `c` and the
/// manifest say: `[guides, output]`, both absolute.
let places! c m = {
    let cfg = manifest.doc m;
    let root = manifest.root m;
    [path.absolute! (path.join root (cli.get (toml.get "docs" cfg "docs" "guides") c "guides")),
     path.absolute! (path.join root (cli.get (toml.get "target/docs" cfg "docs" "output") c "output"))]
};
let build! c m = {
    let cfg = manifest.doc m;
    let root = manifest.root m;
    let title = toml.get (manifest.name m + " documentation") cfg "docs" "title";
    let [guide_dir, out] = places! c m;
    let src = path.absolute! (manifest.src! m);
    if out == path.absolute! root || out == guide_dir || out == src || str.starts_with (out + "/") guide_dir || str.starts_with (guide_dir + "/") out {
        fail! "output must be separate from the project root and guide directory"
    }
    let guide_files = files! guide_dir;
    let timeout = num.parse_int (cli.get (to_string (toml.get 5000 cfg "docs" "example-timeout")) c "example-timeout");
    if timeout == () || timeout <= 0 { fail! "example-timeout must be a positive number of milliseconds" }
    let scratch = path.join root ("target/docs-examples/" + file.scratch_suffix! () + "-" + to_string (vm.wall_ms! ()));
    let jobs = match cli.get () c "jobs" {
        () => (vm.scheduler! ()).[:workers else 1],
        n => match num.parse_int n { j if j != () && j > 0 => j, _ => fail! ("-j wants a number of jobs, not `" + n + "`") },
    };
    let read_guides = map (guide! guide_dir) (filter (str.ends_with ".md") guide_files) |> strict!;
    let no_api = cli.flag_set c "no-api" || toml.get true cfg "docs" "api" == false;
    let modules = if no_api { [] } else { api_modules! m };
    let library = if cli.flag_set c "no-api" { [] } else { std_modules! m modules };
    // Every example, from every page, run before any page is drawn.
    let sources = list.append (map (fn g -> [g.[:url], g.[:text], m]) read_guides)
                              (map (fn i -> [i.[:url], str.join_str "\n" (map (fn e -> e.[:doc]) i.[:entries]), i.[:manifest]]) modules);
    let [results, unexpected] = examples.run_all! (examples.context m (cli.get () c "compiler") timeout scratch) jobs sources;
    let ctx = (examples.context m (cli.get () c "compiler") timeout scratch).[:results => results];
    let guides = map (guide_page ctx) read_guides;
    let library_pages = if list.is_empty library { [] } else { list.cons (library_page library) (flat_map (module_pages ctx) library) };
    let apis = list.append (flat_map (module_pages ctx) modules) library_pages;
    let listed = list.append guides (filter (fn p -> str.starts_with "api/" p.[:url]) apis);
    // What code on any page may link to, and each module page's own names,
    // which its prose may name bare.
    let infos = list.append (list.map (fn i -> [i, true]) modules) (list.map (fn i -> [i, false]) library);
    let names = links.index (list.map (fn [i, own] -> [module_name i, i.[:url], list.map (fn e -> e.[:name]) i.[:entries], own]) infos);
    let local = map.from_pairs (list.map (fn [i, _] -> [i.[:url], list.map (fn e -> e.[:name]) i.[:entries]]) infos);
    let site = theme.Site.make title (manifest.version m) (toml.get "" cfg "package" "description");
    let overview = theme.overview_html site
        (map (fn g -> [g.[:url], g.[:title], theme.blurb g.[:text]]) guides)
        (list.append (flat_map (fn i -> if list.is_empty i.[:entries] { [] } else { [[i.[:url], module_name i, documented i.[:entries]]] }) modules)
                     (if list.is_empty library { [] } else { [["api/std/index.html", "std", "The standard library: " + to_string (list.length library) + " modules"]] }));
    let index = page "index.html" "Overview" overview title;
    let navigation = list.cons index listed;
    let pages = list.cons index (list.append guides apis);
    // On a terminal, a bar naming the page being written; anywhere else, a
    // line per page, which is what says where a build stopped.
    let bar = progress.start! "pages" (list.length pages);
    list.each! (fn [i, p] -> {
        if progress.Bar.on bar { progress.show! bar i p.[:url] } else { console.error! ("writing " + p.[:url]) }
        let body = if str.starts_with "source/" p.[:url] { p.[:body] } else { links.linked names (local.[p.[:url] else []]) p.[:url] p.[:body] };
        write! out p.[:url] (theme.page_html site navigation p.[:body => body])
    }) (list.enumerate pages)
    progress.finish! bar
    // Copy local images and downloadable guide assets alongside their pages.
    list.each! (fn rel -> {
        let to = path.join out ("guides/" + rel);
        file.mkdir_all! (file.parent to)
        file.copy! (path.join guide_dir rel) to
    }) (filter (fn rel -> not (str.ends_with ".md" rel)) guide_files)
    write! out "assets/docs.css" theme.css
    write! out "assets/docs.js" theme.javascript
    let search = map (fn p -> %{ "title" => p.[:title], "url" => p.[:url], "text" => p.[:text] }) listed;
    write! out "assets/search.js" ("window.mindDocs=" + json.write search + ";\n")
    write! out "search-index.json" (json.write search)
    file.remove_all! scratch
    console.print! ("made " + path.join out "index.html" + " (" + to_string (list.length guides) + " guides, " + to_string (list.length listed - list.length guides) + " API modules)")
    if not (list.is_empty unexpected) {
        let strict = cli.flag_set c "strict-examples" || toml.get false cfg "docs" "strict-examples" == true;
        console.error! ((if strict { "mind docs: " } else { "mind docs: warning: " }) + to_string (list.length unexpected)
            + " example(s) did not do what their fence says (mark one written to fail with ```dream fails):")
        list.each! (fn u -> console.error! ("  " + u)) unexpected
        if strict { os.exit! 1 }
    }
};
/// What the build reads, stamped: each guide, module and manifest with its
/// size and modification time. Two stamps that differ mean a build is due.
let stamp! : :any -> :any -> [[:any]];
let stamp! c m = {
    let [guide_dir, _] = places! c m;
    let src = manifest.src! m;
    let under! dir = map (fn rel -> path.join dir rel) (files! dir);
    let paths = list.cons (path.join (manifest.root m) "mind.toml") (list.append (under! guide_dir) (under! src));
    map (fn p -> [p, io.stat! p]) paths |> strict!
};

/// Build again each time `stamp!` changes, looking once a second, for as long
/// as the server runs.
let watch! c m before = {
    proc.sleep! 1000
    let now = stamp! c m;
    if now != before {
        console.error! "mind docs: a source changed; building again"
        build! c m
    }
    watch! c m now
};

/// `mind docs serve`: build, then serve the output, and with `--watch` keep it
/// current.
let serve! c m = {
    if not (cli.flag_set c "no-build") { build! c m }
    let [_, out] = places! c m;
    if cli.flag_set c "watch" {
        let first = stamp! c m;
        spawn! $( watch! c m first )
    }
    serve.serve! c out "the documentation"
};

let run! args = match args {
    ["serve", ..rest] => match cli.parse (list.append opts serve_opts) rest {
        Result.error(why) => fail! (why + "\n" + usage),
        Result.ok(c) => if cli.flag_set c "help" { console.print! usage }
            else if cli.rest c != [] { fail! "unexpected arguments; try `mind docs --help`" }
            else { match manifest.find! (path.absolute! (cli.get (os.cwd! ()) c "dir")) {
                Result.error(why) => fail! why,
                Result.ok(m) => serve! c m,
            } },
    },
    _ => build_command! args,
};
let build_command! args = match cli.parse opts args {
    Result.error(why) => fail! (why + "\n" + usage),
    Result.ok(c) => if cli.flag_set c "help" { console.print! usage }
        else if cli.rest c != [] { fail! "unexpected arguments; try `mind docs --help`" }
        else { match manifest.find! (path.absolute! (cli.get (os.cwd! ()) c "dir")) {
            Result.error(why) => fail! why,
            Result.ok(m) => build! c m,
        } },
};
