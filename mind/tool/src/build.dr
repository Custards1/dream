// Building: working out the package graph, then calling the compiler.
//
// `mind` does not compile anything itself. Dream compiles whole programs, so
// the compiler wants every package at once rather than a series of object
// files -- which means a build is: find the packages, hand `dreams` their
// directories, run it. There is nothing to cache and no link step.
import std.console;

import std.file;
import std.install;
import std.io;
import std.list;
import std.num;
import std.os;
import std.path;
import std.progress;
import std.str;
import std.toml;
import std.vm;
import std.version;
import std.build.Outcome;
import std.build.Target;

import config;
import fetch;
import lock;
import manifest;
import script;
import util;
import std.map;

// --- the dependency graph ------------------------------------------------------
//
// Every package the root needs, transitively, each under the key it was listed
// as. A key is the name a package is imported by (the compiler records it as an
// alias of whatever the package calls itself), so the graph is keyed by it:
// the whole program shares one namespace of package names, and two different
// directories under one key is the one thing that cannot be built. That is
// reported with both places and who asked for each, because in a project with
// many dependencies "which one wanted which?" is the question.
//
// The same directory reached twice -- a diamond, two packages sharing a third
// -- is one node. Directories are compared by their normalized absolute path,
// so `../greet/../util` and `../util` agree.
//
// An edge has a kind, and all three mean "must be ready first":
//
//   :uses     [dependencies]         compiled into the program
//   :dev      [dev-dependencies]     the root's only, compiled into its tests
//   :builds   [build-dependencies]   compiled into the package's build script
//
// A build script is a separate program, so its packages are a separate
// namespace: each package's build dependencies are walked into a graph of
// their own, kept under the package's key in `:builds`, and a tool may use a
// `json` the program does not. The *path* the walk is on runs through all of
// them, though, because "must be ready first" does: a package whose build
// script needs a tool that uses the package can never be built, and that is a
// cycle across two namespaces. So the path is kept by directory, not by key.
//
// A key already in the graph is one of two things. Finished earlier, it is a
// diamond and gets another edge. On the path the walk is still descending,
// it is a cycle, and nothing in it can be built first -- which is reported
// with the whole loop, since "a cycle somewhere" is not something a person can
// fix and the loop is.

/// The key the root package's own dependencies are recorded under.
let root_key = "";

let empty_graph = %{ :order => [], :nodes => %{}, :edges => %{}, :builds => %{} };

let order : :map -> [:string];
let order g = list.reverse (g.[:order else []]);
let node g key = (g.[:nodes else (%{})]).[key else ()];
let nodes : :map -> [:map];
let nodes g = map (fn k -> node g k) (order g);
/// `[[to, kind], ..]`, in the order they were listed.
let edges_of g key = list.reverse ((g.[:edges else (%{})]).[key else []]);
let children : :map -> :string -> [:string];
let children g key = map (fn e -> list.head e) (edges_of g key);
/// The graph a package's build script is compiled from, or `()` when it has
/// no build dependencies.
let build_graph g key = (g.[:builds else (%{})]).[key else ()];

let with_edge from to kind g = {
    let es = g.[:edges else (%{})];
    let now = es.[from else []];
    if list.contains [to, kind] now { g } else { g.[:edges => es.[from => list.cons [to, kind] now]] }
};

let with_node key n g = {
    let ordered = g.[:order => list.cons key (g.[:order else []])];
    ordered.[:nodes => (g.[:nodes else (%{})]).[key => n]]
};

/// Every build script's graph, however deep, as `[owner, graph]`: a package's
/// build dependencies may have build dependencies of their own.
let rec build_graphs g =
    list.concat (map (fn pair -> {
        let [owner, sub] = pair;
        list.cons [owner, sub] (build_graphs sub)
    }) (map.pairs (g.[:builds else (%{})])));

let with_build_graph key sub g = g.[:builds => (g.[:builds else (%{})]).[key => sub]];

/// An empty graph that reads options as `g` does: a build script's packages
/// are a program of their own, but one package has one set of options per
/// build, whichever program it is compiled into.
let inherit g = empty_graph.[:assumed => g.[:assumed else (%{})]].[:settings => g.[:settings else (%{})]];

/// A node: the key, where it is, its manifest (`()` for a bare directory),
/// the dependency as written, who asked for it first, and every version
/// requirement put on it, as `[requirement, asker, manifest path]`.
let make_node key dir m d by =
    %{ :key => key, :dir => dir, :abs => (), :manifest => m, :dep => d, :by => by, :at => (),
       :wants => [] };

let node_key n = n.[:key else ""];
let node_dir n = n.[:dir else "."];
let node_abs n = n.[:abs else node_dir n];
let node_manifest n = n.[:manifest else ()];
let node_dep n = n.[:dep else ()];
let node_by n = n.[:by else root_key];
let node_wants : :map -> [[:any]];
let node_wants n = n.[:wants else []];
/// The manifest that first asked for it, as `shown!` writes it.
let node_at n = n.[:at else "mind.toml"];
/// The version the package says it is, or `()` for a directory with no
/// manifest, which says nothing.
let node_version n = match node_manifest n { () => (), m => manifest.version m };

/// Record one more requirement on a node already in the graph.
let with_want key want g = match [want, node g key] {
    [(), _] => g,
    [_, ()] => g,
    [w, n] => with_node_in_place key (n.[:wants => list.append (node_wants n) [w]]) g,
};
let with_node_in_place key n g = g.[:nodes => (g.[:nodes else (%{})]).[key => n]];

/// Who asked, as a person reads it.
let asker by = match by { "" => "this project", k => "`" + k + "`" };

/// How an edge reads in a sentence.
let edge_words kind = match kind { :uses => "uses", :dev => "tests with", :builds => "builds with", _ => "needs" };

// --- the walk ------------------------------------------------------------------
//
// The walk carries where it is: the manifest whose dependencies it is reading,
// the key that manifest is known by, and the path -- `[abs, name, manifest
// path, kind]` for every package it is inside, innermost first, `kind` being
// the edge it was entered by.

let step_of abs name where kind = [abs, name, where, kind];

/// The loop, when `abs` is already on the path: from where it was entered to
/// here, then the edge that closes it.
let cycle_message path abs name kind = {
    let inside = list.reverse path;
    let from = list.drop_while (fn st -> list.head st != abs) inside;
    let lines = map (fn pair -> {
        let [a, b] = pair;
        [list.nth 1 a, edge_words (list.nth 3 b), list.nth 1 b, list.nth 2 a]
    }) (list.zip from (list.append (list.tail from) [step_of abs name "" kind]));
    let width f = fold (fn w l -> num.max w (str.byte_length (f l))) 0 lines;
    let pad n t = str.pad_end n " " t;
    let w1 = width (fn l -> list.nth 0 l);
    let w2 = width (fn l -> list.nth 1 l);
    let w3 = width (fn l -> list.nth 2 l);
    "these packages need each other, so none of them can be built first:\n"
    + str.join_str "\n" (map (fn l -> "  " + pad w1 (list.nth 0 l) + "  " + pad w2 (list.nth 1 l)
                                            + "  " + pad w3 (list.nth 2 l) + "  (" + list.nth 3 l + ")")
                                   lines)
};

/// What to say about two packages under one key. Two revisions of one
/// repository is its own message, because it is the common case and the one
/// with an obvious fix; anything else is two different packages.
let conflict_message key seen d owner_key owner_at abs = {
    let git_of x = manifest.spec_get x "git";
    let same_repo = manifest.dep_kind (node_dep seen) == :git && manifest.dep_kind d == :git
                    && git_of (node_dep seen) == git_of d;
    let line n src by = "  " + n + " (" + src + ", required by " + asker by + ")\n";
    let rev x = to_string (list.nth 1 (manifest.dep_rev x));
    if same_repo {
        let w = num.max (str.byte_length (rev (node_dep seen))) (str.byte_length (rev d));
        let at r by where = "  " + r + str.repeat (w - str.byte_length r) " "
                            + "  required by " + asker by + " (" + where + ")\n";
        "two revisions of `" + key + "` (" + to_string (git_of d) + ") are required:\n"
        + at (rev (node_dep seen)) (node_by seen) (node_at seen)
        + at (rev d) owner_key owner_at
        + "a program has one `" + key + "`: pin both to the same revision"
    } else {
        "two different packages are both called `" + key + "`:\n"
        + line (node_abs seen) (manifest.dep_source (node_dep seen)) (node_by seen)
        + line abs (manifest.dep_source d) owner_key
        + "a program has one namespace of packages: point both at the same "
        + "place, or list one of them under another name"
    }
};

/// A requirement as it is kept on the node: what was written, who wrote it,
/// and where.
let want_of d owner_key where =
    match manifest.dep_requirement d {
        () => (),
        r => [r, owner_key, where],
    };

/// A file as a person at this prompt would type it: relative to the working
/// directory, and without the `../a/..` a walk accumulates.
let shown! p = path.relative! (os.cwd! ()) p;

/// `[:ok, graph]` or `[:error, why]`.
///
/// `owner` is the manifest whose `deps` these are, known as `owner_key` in
/// this graph; `kind` is the edge every one of them is; `path` is where the
/// walk is (above). Build dependencies go into a graph of their own, walked
/// with the same path.
let rec walk! owner owner_key deps kind path g =
    match deps {
        [] => ok g,
        [d, ..rest] => match edge_on! owner owner_key d g {
            Result.error(why) => Result.error why,
            [:off, g2] => walk! owner owner_key rest kind path g2,
            [:on, g2] => follow! owner owner_key d rest kind path g2,
        },
    };

/// Add one dependency that is in the graph, and everything below it, then go
/// on with the rest.
let follow! owner owner_key d rest kind trail g = {
    let key = manifest.dep_name d;
    match fetch.resolve! (manifest.root owner) d {
        Result.error(why) => Result.error (why + " (required by " + asker owner_key + ")"),
        Result.ok(dir) => {
            let abs = path.absolute! dir;
            let name = if str.is_empty key { "this project" } else { key };
            let on_path = list.any (fn st -> list.head st == abs) trail;
            let owner_at = shown! (manifest.path owner);
            if on_path { Result.error (cycle_message trail abs name kind) }
            else {
                match node g key {
                    () => match manifest.load_dependency! dir {
                        Result.error(why) => Result.error why,
                        loaded => {
                            let dm = match loaded { Result.ok(m) => m, _ => () };
                            let n = (make_node key dir dm d owner_key).[:abs => abs].[:at => owner_at]
                                        .[:wants => match want_of d owner_key owner_at { () => [], w => [w] }];
                            let g2 = with_edge owner_key key kind (with_node key n g);
                            let inner = list.cons (step_of abs key (shown! (path.join abs "mind.toml")) kind)
                                                  trail;
                            match below! dm key inner g2 {
                                Result.error(why) => Result.error why,
                                Result.ok(g3) => walk! owner owner_key rest kind trail g3,
                            }
                        },
                    },
                    seen => match node_abs seen == abs {
                        true => walk! owner owner_key rest kind trail
                                      (with_want key (want_of d owner_key owner_at)
                                                 (with_edge owner_key key kind g)),
                        false => Result.error (conflict_message key seen d owner_key owner_at abs),
                    },
                }
            }
        },
    }
};

// --- conditional edges ------------------------------------------------------------
//
// `sqlite_sys = { path = "..", when = "not vendored" }` is in the graph only
// when the condition holds against the options of the package that lists it.
// Those options are not known until the graph is -- a package is configured by
// the packages that depend on it -- so the walk reads what `graph!` assumed
// they are (`:assumed`, by directory), and keeps every value it read. When
// settling the options gives a different value for any of them, the walk is
// run again with the settled ones; see `graph!`.

/// `[:on, g]`, `[:off, g]`, or `[:error, why]` for a condition that does not
/// parse. An edge that is off is remembered, so that `[config.KEY]` for a
/// package that is only sometimes there is not called a typo.
let edge_on! owner owner_key d g =
    match manifest.dep_condition d {
        () => [:on, g],
        text => match config.parse_condition text {
            Result.error(why) => Result.error (shown! (manifest.path owner) + ": `when = \"" + text + "\"` on `"
                                      + manifest.dep_name d + "`: " + why),
            Result.ok(cond) => {
                let reads = fold (fn m n -> m.[n => option_read! owner g n]) (%{}) (config.names cond);
                let option n = match reads.[n else ()] { () => (), r => Result.ok (list.nth 2 r) };
                let kept = g.[:reads => list.append (g.[:reads else []])
                                                    (list.compact (map.values reads))];
                if config.holds option (g.[:settings else (%{})]) cond { [:on, kept] }
                else { [:off, kept.[:off => list.cons [owner_key, manifest.dep_name d] (kept.[:off else []])]] }
            },
        },
    };

/// What a condition in `owner` reads for `name`: `[dir, option, value,
/// default]` for an option -- its own, or another package's when the name is
/// dotted -- and `()` for a name that is the program's.
let option_read! owner g name = {
    let dot = str.find "." name;
    if dot >= 0 {
        let key = str.slice 0 dot name;
        let opt = str.slice (dot + 1) (str.byte_length name - dot - 1) name;
        match node g key {
            () => [(), opt, (), ()],
            n => match node_manifest n {
                () => [node_abs n, opt, (), ()],
                dm => read_of (node_abs n) dm opt g,
            },
        }
    } else {
        match (declared owner).[name else ()] {
            () => (),
            _ => read_of (path.absolute! (manifest.root owner)) owner name g,
        }
    }
};

/// A package's declarations, errors aside: they are reported by `settle!`.
let declared dm = list.head (config.declarations (manifest.options dm));

let read_of abs dm name g = {
    let default = (list.head (config.initial (declared dm) (manifest.defines dm))).[name else ()];
    [abs, name, ((g.[:assumed else (%{})]).[abs else (%{})]).[name else default], default]
};

/// Did settling leave every value a condition read as it was read?
let steady assumed reads =
    list.all (fn [abs, name, seen, default] ->
        abs == () || (assumed.[abs else (%{})]).[name else default] == seen) reads;

/// Everything below a package just added: its own dependencies in this graph,
/// and its build dependencies in a graph of their own. A directory with no
/// manifest has neither.
let below! dm key path g =
    match dm {
        () => ok g,
        _ => match walk! dm key (manifest.dependencies dm) :uses path g {
            Result.error(why) => Result.error why,
            Result.ok(g2) => builds! dm key path g2,
        },
    };

/// A package's build dependencies, walked into their own namespace and kept
/// under its key. Nothing is kept for a package with none, so a graph with no
/// build scripts anywhere is exactly the graph it was before they existed.
let builds! m key path g =
    match manifest.build_dependencies m {
        [] => ok g,
        bdeps => match walk! m key bdeps :builds path (inherit g) {
            Result.error(why) => Result.error why,
            Result.ok(sub) => match check_versions sub {
                Result.error(why) => Result.error why,
                _ => Result.ok (with_build_graph key sub
                                (g.[:reads => list.append (g.[:reads else []]) (sub.[:reads else []])])),
            },
        },
    };

// --- versions ------------------------------------------------------------------
//
// There is no registry, so there is nothing to choose between: a key is one
// package, and resolving is *checking* that what was fetched is a version
// everyone who asked for it accepts. Every requirement is kept on the node
// with who wrote it, so a miss can be reported with all of them -- the fix is
// usually to bring two of them together, and that needs both in view.

/// `[:ok, ()]`, or `[:error, why]` for the first package some requirement on
/// it does not accept.
let check_versions g =
    fold (fn acc n -> match acc {
        Result.error(why) => acc,
        _ => check_node n,
    }) (Result.ok ()) (nodes g);

let check_node n =
    match node_wants n {
        [] => Result.ok (),
        wants => {
            let key = node_key n;
            let found = node_version n;
            let parsed = map (fn w -> [w, version.parse_requirement (list.head w)]) wants;
            match filter (fn p -> match list.nth 1 p { Result.error(_) => true, _ => false }) parsed {
                [[w, Result.error(why)], ..more] =>
                    Result.error (list.nth 2 w + ": the version required of `" + key + "` is not one: " + why),
                _ => match found {
                    () => Result.error ("`" + key + "` has no manifest, so it has no version, but "
                                   + asker (list.nth 1 (list.head wants)) + " requires "
                                   + list.head (list.head wants)
                                   + ": give it a mind.toml, or drop the requirement"),
                    text => match version.parse text {
                        Result.error(_) => Result.error ("`" + key + "` says its version is `" + text
                                                + "`, which is not a version ("
                                                + manifest.path (node_manifest n) + ")"),
                        Result.ok(v) => {
                            let misses = filter (fn p -> not (version.matches (requirement p) v))
                                                     parsed;
                            if list.is_empty misses { Result.ok () }
                            else { Result.error (version_message key text v n parsed) }
                        },
                    },
                },
            }
        },
    };

/// The requirement a `[want, parsed]` pair parsed, once it is known to have.
priv let requirement pair = match list.nth 1 pair { Result.ok(r) => r, Result.error(_) => () };

/// Every requirement on the package, the ones it misses marked, and whether
/// any single version could have met them all -- which decides the advice.
let version_message : :string -> :string -> :any -> :map -> [[:any]] -> :string;
let version_message key text v n parsed = {
    let width = fold (fn w p -> num.max w (str.byte_length (asker (list.nth 1 (list.head p))))) 0 parsed;
    let reqs = map requirement parsed;
    let req_width = fold (fn w p -> num.max w (str.byte_length (list.head (list.head p)))) 0 parsed;
    let together = list.all (fn a -> list.all (fn b -> version.compatible a b) reqs) reqs;
    "`" + key + "` is " + text + " (" + manifest.dep_source (node_dep n) + "), but\n"
    + str.join_str "\n" (map (fn p -> {
          let w = list.head p;
          let req = requirement p;
          let who = asker (list.nth 1 w);
          "  " + who + str.repeat (width - str.byte_length who) " " + " requires "
          + list.head w + str.repeat (req_width - str.byte_length (list.head w)) " "
          + "  (" + list.nth 2 w + ")"
          + (if version.matches req v { "" } else { "  <- not " + text })
      }) parsed)
    + (if together { "\npoint `" + key + "` at a version they all accept" }
       else { "\nno version meets all of these: bring the requirements together, "
              + "or list one of them under another name" })
};

/// The root's dependencies, and with `dev` its `[dev-dependencies]` as well,
/// as `[deps, kind]` walks.
let root_deps m dev =
    if dev { [[manifest.dependencies m, :uses], [manifest.dev_dependencies m, :dev]] }
    else { [[manifest.dependencies m, :uses]] };

/// One walk of the whole graph, reading options as `assumed` says.
let walk_graph! m o assumed = {
    let root_abs = path.absolute! (manifest.root m);
    let name = match manifest.name m { "" => "this project", n => n };
    let path = [step_of root_abs name (shown! (manifest.path m)) :uses];
    let start = empty_graph.[:assumed => assumed].[:settings => settings! m o];
    let walked = fold (fn acc wk -> match acc {
        Result.error(why) => acc,
        Result.ok(g) => walk! m root_key (list.head wk) (list.nth 1 wk) path g,
    }) (ok start) (root_deps m (option o :dev false));
    match walked {
        Result.error(why) => Result.error why,
        Result.ok(g) => builds! m root_key path g,
    }
};

/// How many times the walk may be run before the options are declared not to
/// settle. Each run can only follow a change of value a condition read, so a
/// real graph settles in two; more than a few is a loop -- an edge that, once
/// in, configures its own condition off.
let max_rounds = 8;

/// Every package this build needs, transitively, with every package's
/// options settled (`:options`), or the first reason it cannot be built: a
/// cycle, a conflict, a version nobody accepts, or an option set wrongly.
///
/// The options and the graph decide each other: a conditional edge reads the
/// options of the package listing it, and those options are set by the
/// packages that depend on it, which are only known once the graph is. So
/// this walks with what it assumes the options are -- the defaults, at first
/// -- settles them over the graph that came out, and walks again if a
/// condition read a value that settling changed.
let graph! m o =
    match has_profile m o {
        false => Result.error ("no profile is called `" + profile_of o + "`; this project has "
                          + str.join_str ", " (list.unique (list.append ["debug", "release"] (manifest.profiles m)))),
        true => settle_graph! m o (%{}) 1,
    };

let rec settle_graph! m o assumed round =
    match walk_graph! m o assumed {
        Result.error(why) => Result.error why,
        Result.ok(g) => {
            let [values, errors] = settle! m o g;
            let next = by_dir! m g values;
            match [steady next (g.[:reads else []]), round >= max_rounds] {
                [true, _] => match [errors, check_versions g] {
                    [[_, .._], _] => Result.error (str.join_str "\n" errors),
                    [_, Result.error(why)] => Result.error why,
                    _ => Result.ok (g.[:options => values]),
                },
                [false, true] => Result.error ("the options and the dependencies that hang on them do not settle: "
                                          + "each way of building includes a package that configures it the other way"),
                [false, false] => settle_graph! m o next (round + 1),
            }
        },
    };

/// Settled values by package directory, which is how a walk reads them.
let by_dir! m g values =
    fold (fn acc [key, vs] -> {
        let abs = if key == root_key { path.absolute! (manifest.root m) }
                  else { node_abs (node g key) };
        acc.[abs => vs]
    }) (%{}) (map.pairs values);

// --- settling the options -------------------------------------------------------
//
// Every package's options, each set in turn by, a later one winning:
//
//   1. its default in `[options]`;
//   2. its own `[build] defines`, for a flag it always wants;
//   3. `[config.KEY]` in any manifest in the graph -- a table rather than a
//      field of `[dependencies]`, so that a dependency of a dependency, which
//      the root never lists, can still be configured. The root's wins; two
//      others that disagree are a conflict, unless the root settles it;
//   4. the profile's `[profile.NAME.config.KEY]`;
//   5. `-D KEY:name=value`.
//
// The root is set the same way, its `-D name=value` and its profile's
// defines standing at 2 for the options it declares. Every value is checked
// against the declaration, and so is every name: a setting nobody declared is
// an error that lists what the package does declare.

let profile_of o = option o :profile "debug";
let has_profile m o = manifest.has_profile m (profile_of o);

/// The program's defines: the root's own, the profile's, and the command
/// line's, in the order that lets the command line win.
let all_defines m o =
    list.concat [manifest.defines m, manifest.profile_defines m (profile_of o), option o :defines []];

/// Of those, the ones that are the program's rather than the root's options:
/// a root that declares `fast` is configured by `-D fast`, and the program
/// does not also get a `fast` of its own to leak into every package.
let program_defines m o = {
    let own = declared m;
    filter (fn d -> own.[list.head (config.split_define d) else ()] == ()) (all_defines m o)
};

/// What a condition in a manifest reads besides options: the platform, `test`
/// for a test build, and the program's defines -- the settings the compiler
/// gives every module.
let settings! m o = {
    let p = to_string (os.platform ());
    let os_name = str.slice 1 (str.byte_length p - 1) p;
    let base = %{ "os" => os_name, "family" => if os_name == "windows" { "windows" } else { "unix" } };
    let tested = if option o :dev false { base.["test" => true] } else { base };
    fold (fn acc d -> match config.split_define d {
        [n, v] => acc.[n => if str.contains_str "=" d { v } else { true }],
    }) tested (program_defines m o)
};

/// The packages that have a manifest, root first, as `[key, manifest]`.
let manifests m g =
    list.cons [root_key, m]
              (flat_map (fn n -> match node_manifest n { () => [], dm => [[node_key n, dm]] }) (nodes g));

/// Who a setting came from, for a message.
let setter_words key = match key { "" => "this project", k => "`" + k + "`" };

/// `[values, errors]`: `values` a map of key to that package's settled
/// options, for every package that declares any.
let settle! m o g = {
    let packages = manifests m g;
    // Where each manifest is, as a message shows it.
    let places = fold (fn acc [k, at] -> acc.[k => at]) (%{})
                           (list.zip (map list.head packages)
                                     (map shown! (map (fn p -> manifest.path (list.nth 1 p)) packages)));
    let at k = places.[k else "mind.toml"];
    let profile = profile_of o;
    // The names a package answers to in a `[config.X]` or a `-D X:..`: the
    // key it is listed under, and what it calls itself.
    let names_of key pm = list.unique [if key == root_key { manifest.name pm } else { key }, manifest.name pm];
    let addressed key pm = { let ns = names_of key pm; fn x -> list.contains x ns };
    let every_name = flat_map (fn [k, pm] -> names_of k pm) packages;
    let off : [[:any]] = g.[:off else []];
    let off_keys = map (fn e -> list.nth 1 e) off;
    let known x = list.contains x every_name || list.contains x off_keys;
    // A key nobody answers to is a typo, wherever it was written.
    let stray = list.concat [
        flat_map (fn [sk, sm] -> flat_map (fn [ck, _] ->
            if known ck { [] }
            else { ["[config." + ck + "] in " + at sk + ": no package here is called `" + ck + "`"] })
            (manifest.configs sm)) packages,
        flat_map (fn [ck, _] ->
            if known ck { [] }
            else { ["[profile." + profile + ".config." + ck + "] in " + at root_key
                    + ": no package here is called `" + ck + "`"] })
            (manifest.profile_configs m profile),
        flat_map (fn [k, n, _] ->
            if known k { [] } else { ["-D " + k + ":" + n + ": no package here is called `" + k + "`"] })
            (option o :sets []),
    ];
    let settled = map (fn [key, pm] -> settle_one m o packages at key pm (addressed key pm)) packages;
    [fold (fn acc [key, vs, _] -> if map_is_empty vs { acc } else { acc.[key => vs] }) (%{}) settled,
     list.concat (list.cons stray (map (fn s -> list.nth 2 s) settled))]
};

let map_is_empty m = list.is_empty (map.pairs m);

/// One package: `[key, values, errors]`. `at` says where a package's
/// manifest is.
let settle_one m o packages at key pm addressed = {
    let [decls, derrs] = config.declarations (manifest.options pm);
    let where = at key;
    let who = if key == root_key { "this project" } else { "`" + key + "`" };
    let own_defines = if key == root_key { all_defines m o } else { manifest.defines pm };
    let [start, ierrs] = config.initial decls own_defines;
    // One setting: `[values, errors]` with it applied, or its error added.
    let apply [vs, errs] [name, raw, from] =
        match decls.[name else ()] {
            () => [vs, list.append errs [who + " has no option `" + name + "` (" + from + ")\n"
                                         + config.listing decls]],
            d => match config.check d raw {
                Result.ok(v) => [vs.[name => v], errs],
                Result.error(why) => [vs, list.append errs [why + " (" + from + ")"]],
            },
        };
    let entries table from = map (fn [n, v] -> [n, v, from]) (map.pairs table);
    let configured_by sk sm =
        flat_map (fn [ck, table] -> if addressed ck { entries table ("[config." + ck + "] in " + at sk) } else { [] })
                      (manifest.configs sm);
    let from_root = configured_by root_key m;
    let from_profile =
        flat_map (fn [ck, table] ->
            if addressed ck { entries table ("[profile." + profile_of o + ".config." + ck + "] in " + at root_key) }
            else { [] })
            (manifest.profile_configs m (profile_of o));
    let from_cli = flat_map (fn [k, n, v] -> if addressed k { [[n, v, "-D " + k + ":" + n]] } else { [] })
                                 (option o :sets []);
    // The other packages' settings, which have to agree with each other on
    // anything the root leaves unsaid.
    let said = map (fn e -> list.head e) (list.concat [from_root, from_profile, from_cli]);
    let others = flat_map (fn [sk, sm] ->
        if sk == root_key || sk == key { [] }
        else { map (fn e -> list.append e [sk]) (configured_by sk sm) }) packages;
    let unsettled = filter (fn e -> not (list.contains (list.head e) said)) others;
    let conflicts = flat_map (fn name -> {
        let votes = filter (fn e -> list.head e == name) unsettled;
        match list.unique (map (fn e -> config.shown (list.nth 1 e)) votes) {
            [_, _, .._] => {
                let said_as e = list.head e + " = " + toml.encode_value (list.nth 1 e);
                let width = fold (fn w e -> num.max w (str.byte_length (said_as e))) 0 votes;
                [who + " is configured two ways, and this project does not say which:\n"
                            + str.join_str "\n" (map (fn [n, v, from, sk] -> {
                                  let l = said_as [n, v];
                                  "  " + l + str.repeat (width - str.byte_length l) " " + "  by " + setter_words sk + " (" + from + ")"
                              }) votes)
                            + "\nsettle it in this project's [config." + key + "]"]
            },
            _ => [],
        }
    }) (list.unique (map (fn e -> list.head e) unsettled));
    let layered = fold apply [start, []]
                            (list.concat [map (fn e -> list.take 3 e) others, from_root, from_profile, from_cli]);
    let [values, errs] = layered;
    [key, values, list.concat [map (fn e -> where + ": " + e) derrs, ierrs, conflicts, errs]]
};

// --- the lock ------------------------------------------------------------------
//
// What the graph resolved to is checked against `mind.lock` and written back.
// See lock.dr for why and for the format; what is here is only what the graph
// knows -- which packages, and which section of the lock each belongs in.

/// The lock section a build script's packages go in. Named for the chain of
/// packages whose script it is, the root by its own name, so each program in
/// the build has a section of its own however deep the scripts go.
let script_section parent owner name =
    match [parent, owner] {
        ["program", ""] => "build." + name,
        ["program", k] => "build." + k,
        [s, k] => s + "." + k,
    };

/// Every package the build resolved to, as lock entries.
let rec lock_entries! g section name =
    list.concat [
        map (fn n -> lock.entry section (node_key n) (manifest.dep_source (node_dep n))
                                     (fetch.commit! (node_dep n) (node_dir n)) (node_version n))
                 (nodes g),
        list.concat (map (fn pair -> {
            let [owner, sub] = pair;
            lock_entries! sub (script_section section owner name) name
        }) (map.pairs (g.[:builds else (%{})]))),
    ];

/// What to say about packages that moved under the lock.
let drift_message old moved =
    "these dependencies resolved to a different commit than mind.lock records:\n"
    + str.join_str "\n" (map (fn e -> {
          let o = lock.locked old e;
          "  " + lock.key_of e + " (" + lock.source_of e + ") is now " + short (lock.commit_of e)
          + ", but the lock says " + short (lock.commit_of o)
          + (if lock.section_of e == "program" { "" } else { "  [" + lock.section_of e + "]" })
      }) moved)
    + "\na tag was moved, or the cache was changed by hand. `mind update` accepts what is there now";

let short c = if str.byte_length c > 10 { str.slice 0 10 c } else { c };

/// The graph, checked against the lock and the lock brought up to date:
/// what every command resolves through. `accept` is `mind update`'s: the
/// commits have moved because it moved them, and the lock follows.
let resolve! m o accept =
    match graph! m o {
        Result.error(why) => Result.error why,
        Result.ok(g) => {
            let name = match manifest.name m { "" => "root", n => n };
            let now = lock_entries! g "program" name;
            let root = manifest.root m;
            let before = lock.load! root;
            match [accept, lock.drift before now] {
                [false, [e, ..more]] => Result.error (drift_message before (list.cons e more)),
                _ => {
                    // A walk that left something out -- the dev dependencies,
                    // or an edge whose condition is off in this build -- keeps
                    // what the lock says about it.
                    let complete = option o :dev false && list.is_empty (g.[:off else []]);
                    lock.save! root (lock.merge before now complete)
                    ok g
                },
            }
        },
    };

/// How the compiler is told about one package. `-L DIR` when the package
/// already calls itself by the key, which every compiler understands;
/// `-L KEY=DIR` otherwise, which names it.
let package_arg n =
    match node_manifest n {
        () => node_key n + "=" + node_dir n,
        dm => if manifest.name dm == node_key n { node_dir n }
              else { node_key n + "=" + node_dir n },
    };

/// What each dependency needs to be compiled, which is its business and not
/// the business of every project that uses it: the directories of loose modules
/// it searches (`-I`), and the host modules it imports. Its `defines` are not
/// carried, because a `when` flag is a decision about the whole program and
/// that belongs to the program.
let dep_includes g =
    list.concat (map (fn n -> match node_manifest n { () => [], dm => manifest.includes dm })
                          (nodes g));
let dep_hosts g =
    list.concat (map (fn n -> match node_manifest n { () => [], dm => manifest.host_modules dm })
                          (nodes g));

/// Every payload the program carries: the package's own and every
/// dependency's, as `[:ok, ["--payload", "NAME=FILE", ..]]`, or `[:error, why]`
/// for a `[payload]` that is wrong or a name two packages give two files.
let payload_args m g = {
    let manifests = list.cons m (flat_map (fn n -> match node_manifest n { () => [], dm => [dm] }) (nodes g));
    match list.first_or () (flat_map (fn mm -> match manifest.payload_problem mm { () => [], why => [why] }) manifests) {
        () => {
            let all = list.unique (flat_map manifest.payloads manifests);
            let clash = list.find (fn [n, p] -> list.any (fn [n2, p2] -> n2 == n && p2 != p) all) all;
            match clash {
                () => Result.ok (repeated "--payload" (map (fn [n, p] -> n + "=" + p) all)),
                [n, _] => Result.error ("two packages carry a payload named `" + n + "`: "
                                   + str.join_str " and " (map (fn e -> list.nth 1 e) (filter (fn e -> list.head e == n) all))),
            }
        },
        why => Result.error why,
    }
};

/// Where the standard library is.
///
/// Every program gets `std` without asking for it, so finding it is `mind`'s
/// job and not the user's. The candidates, in order:
///
///   1. `MIND_STDLIB`, for an installed `mind` to point at what shipped with
///      it, and for anyone who wants a different library entirely.
///   2. `$MIND_HOME/std` (default `~/.mind/std`), where an install puts it.
///   3. a `mind` directory at or above the working directory -- which is what
///      makes the library's own repository work with no configuration at all.
///   4. the installation: the first directory of `$MINDV2_PATH` (or
///      `~/.mindv2`) holding `std` (`std.install`), which is where `just
///      install` puts the library beside the compiler it was built with.
///
/// The third is a search rather than a fixed path because a build may be run
/// from anywhere inside a project, exactly as `git` may be. It comes before
/// the installation so that an installed library never shadows the checkout
/// being worked on -- an installed `std` older than the checkout's `dreams` is
/// a compiler that cannot build itself.
let stdlib_root! () = {
    let named = path.from_env! "MIND_STDLIB";
    if named != () { named }
    else {
        let home = util.mind_home! ();
        let installed = path.join home "std";
        if io.is_dir! installed { home }
        else {
            match find_upwards! (os.cwd! ()) "mind" {
                () => match install.holding! "std" {
                    () => "mind",
                    found => found,
                },
                found => found,
            }
        }
    }
};

/// The nearest `name` directory at or above `from`, or `()`. Holds a library
/// whose `std` is a package, so it is the *parent* that becomes a `-L` root.
let rec find_upwards! from name = {
    let candidate = path.join from name;
    if io.is_dir! (path.join candidate "std") { candidate }
    else {
        let up = path.dirname from;
        if up == from || up == "." { () } else { find_upwards! up name }
    }
};

/// `[:ok, graph, [-L, dir, -L, dir, ..]]` -- the packages for one build: the
/// standard library, then every dependency in the order it was found.
let search_paths! m o =
    match resolve! m o false {
        Result.error(why) => Result.error why,
        Result.ok(g) => [:ok, g, repeated "-L" (list.cons (stdlib_root! ())
                                                      (map package_arg (nodes g)))],
    };

let target_dir m = path.join (manifest.root m) "target";

// --- what one build is --------------------------------------------------------
//
// A build is the manifest plus whatever this invocation added. Keeping that in
// one value rather than in a widening list of parameters is what lets a new
// option reach the compiler without every caller between here and the command
// line learning its name.

let options = %{ :compiler => (), :defines => [], :includes => [], :hosts => [],
                 :paths => [], :flags => [], :output => (), :extra => [],
                 :verbose => false, :dev => false,
                 // `-D KEY:name=value`, as `[key, name, value]`; `--profile`;
                 // and `--target`, as many as were given.
                 :sets => [], :profile => "debug", :targets => [] };

let with_option k v o = o.[k => v];
let option o k default = o.[k else default];

/// Where this build writes its image: `target/[<platforms>/]<profile>/`, as
/// Cargo lays out its own. Two builds share a file only when they would write
/// the same image. A target is in the path because an image carries where it
/// may run in its header, so a Linux build and a macOS build are two files --
/// sharing one meant each overwrote the other, and `mind run` after a
/// cross-build ran an image the VM would refuse. A profile is in it because
/// it changes the defines, flags and configuration the program is compiled
/// with, and `mind build --release` should not cost the next debug build its
/// image. A build that states no target leaves that level out. A path
/// somebody wrote down, `--output` or `[build] output`, is used as written.
let output_of m o =
    match option o :output () {
        () => match manifest.output m {
            () => {
                let under = match target_subdir (targets m o) {
                    () => target_dir m,
                    dir => path.join (target_dir m) dir,
                };
                path.join (path.join under (profile_of o)) (manifest.name m + ".dream")
            },
            p  => path.join (manifest.root m) p,
        },
        p => p,
    };

// --- naming a target ------------------------------------------------------------
//
// The directory is named for what the compiler will record, not for how it
// was asked: `linux` and `os=linux` are one target, `arm64` is `aarch64`, and
// several `--target`s are joined as `dreams/src/target.dr` joins them -- each side
// the union of what was said, or "any" where some target left it open. So one
// image is one directory however it was spelled, and two builds share a file
// only when they would have written the same header.

let os_names : [:string];
let os_names = ["linux", "macos", "windows", "android"];

let arch_names : [:string];
let arch_names = ["x86_64", "aarch64"];

/// The spelling `target.dr` settles on for another tool's name.
let platform_spelled : :string -> :string;
let platform_spelled s = match s {
    "darwin" => "macos", "osx" => "macos", "win32" => "windows",
    "amd64" => "x86_64", "x64" => "x86_64", "arm64" => "aarch64",
    _ => s,
};

/// One `--target` as `[systems, architectures]`. A name that is neither goes
/// with the systems; the compiler refuses it before anything is written.
let target_sides : :string -> [[:string]];
let target_sides spec = {
    let value part = {
        let at = str.find "=" part;
        if at < 0 { part } else { str.slice (at + 1) (str.byte_length part - at - 1) part }
    };
    let names = map (fn p -> platform_spelled (value p))
                         (filter (fn p -> not (str.is_empty p)) (str.split "," spec));
    [filter (fn n -> not (list.contains n arch_names)) names,
     filter (fn n -> list.contains n arch_names) names]
};

/// The directory an image for these `--target`s goes in, or `()` when none
/// was stated and the program decides where it runs.
let target_subdir : [:string] -> :string | :unit;
let target_subdir specs = {
    let sides = map target_sides specs;
    let side pick known =
        if list.any (fn s -> list.is_empty (pick s)) sides { [] }
        else {
            let named = list.concat (map pick sides);
            list.append (filter (fn n -> list.contains n named) known)
                        (list.unique (filter (fn n -> not (list.contains n known)) named))
        };
    match [specs, list.contains "any" specs] {
        [[], _] => (),
        [_, true] => "any",
        _ => match list.append (side list.head os_names) (side (list.nth 1) arch_names) {
            [] => "any",
            names => str.join_str "-" names,
        },
    }
};

let vm_command! () = match path.from_env! "DREAM" { () => "dream", v => v };

/// Which compiler to run, in the order a person would expect to be obeyed:
/// what this build asked for, then what the package asks for, then the
/// environment, then the installed one.
///
/// The default is `dreams.dream` rather than a program on the path, because the
/// compiler is an image now: the VM resolves a bare name against `$MINDV2_PATH`,
/// so this finds whatever the installation put there. A native compiler is
/// still perfectly usable -- name it, and it is executed directly.
let default_compiler = "dreams.dream";

let choose_compiler! m explicit =
    match explicit {
        () => match manifest.compiler m {
            () => match path.from_env! "DREAMS" { () => default_compiler, d => d },
            c => c,
        },
        c => c,
    };

/// How to run it: `[program, arguments that come first]`.
///
/// `dreams` is the compiler written in Dream, so it is an image and not a
/// native program: running it means handing it to the VM, which is also what
/// runs `mind`. That is the whole difference between the two compilers from
/// here, and it is a prefix rather than a mode -- anything named `.dream` is
/// run this way, and everything else is executed directly.
let compiler_command! chosen =
    if str.ends_with ".dream" chosen { [vm_command! (), [chosen]] }
    else { [chosen, []] };

/// `[flag, a, flag, b, ..]` -- how a repeated option is written out.
let repeated flag xs = flat_map (fn x -> [flag, x]) xs;

// --- build scripts ----------------------------------------------------------------
//
// script.dr runs them; what is here is what it is told about this build. A
// project where no package has a `build.dr` never gets past `scripted!`.

/// Every package in the build with a script: the root under its own name,
/// then each dependency under its key, with the `-L` roots its script is
/// compiled with -- the standard library and its build dependencies.
let scripted! m o g = {
    let one! key dm root = match manifest.script! dm {
        () => [],
        file => [script.Scripted.make key (manifest.version dm) (path.absolute! root) (path.absolute! file)
                                      (manifest.script_env dm)
                                      ((g.[:options else (%{})]).[(if key == manifest.name m { root_key } else { key }) else (%{})])
                                      (list.cons (stdlib_root! ())
                                                 (match build_graph g (if key == manifest.name m { root_key } else { key }) {
                                                      () => [],
                                                      sub => map package_arg (nodes sub),
                                                  }))],
    };
    list.concat (list.cons (one! (manifest.name m) m (manifest.root m))
                           (map (fn n -> match node_manifest n {
                                () => one! (node_key n) (manifest.make (node_dir n) (%{})) (node_dir n),
                                dm => one! (node_key n) dm (node_dir n),
                            }) (nodes g)))
};

/// The `Target` field a name spells. Every value is written out, which is what
/// the field's type asks for -- and a name that is not one of them is refused
/// by the compiler before a script could act on it, so `:unknown` is never
/// what a build goes on to use.
let os_atom : :string -> (:linux | :macos | :windows | :android | :unknown);
let os_atom name = match name { "linux" => :linux, "macos" => :macos, "windows" => :windows, "android" => :android, _ => :unknown };

let arch_atom : :string -> (:x86_64 | :aarch64 | :unknown);
let arch_atom name = match name { "x86_64" => :x86_64, "aarch64" => :aarch64, _ => :unknown };

/// A single `--target` naming one system and one architecture, as the target
/// a script is told it is building for; `()` otherwise, and the script is
/// told the host.
let script_target o m = match targets m o {
    [one] => match target_sides one {
        [[os_name], [arch_name]] => Target.make (os_atom os_name) (arch_atom arch_name),
        _ => (),
    },
    _ => (),
};

/// What every script in this build shares.
let script_setting! m o g = {
    // Absolute, since a check runs them from a directory of its own.
    let placed! p = if str.contains_str "/" p { path.absolute! p } else { p };
    script.Setting.make (target_dir m)
        (match compiler_command! (choose_compiler! m (option o :compiler ())) {
             [program, lead] => map placed! (list.cons program lead),
         })
        (placed! (vm_command! ())) (profile_of o) (script_target o m) (option o :jobs 1)
        (fold (fn acc n -> match node_version n { () => acc, v => acc.[node_key n => v] }) (%{}) (nodes g))
        (option o :verbose false) (option o :testing false) (option o :only []) (option o :goals [])
};

/// The package's own checks, run as `mind test` runs them -- `[:ok, [[name,
/// [passed, ms, output]]]]`, `[:ok, []]` for a package without a script -- or
/// why they could not be run. `:only` narrows them to the names given.
let checks! m o =
    match resolve! m o false {
        Result.error(why) => Result.error why,
        Result.ok(g) => match filter (fn s -> script.Scripted.key s == manifest.name m) (scripted! m o g) {
            [] => ok [],
            own => match script.run_all! (script_setting! m (with_option :testing true o) g) own {
                Result.error(why) => Result.error why,
                Result.ok([[_, outcome], .._]) => Result.ok (list.sort_on list.head (map.pairs (Outcome.checks outcome))),
                Result.ok([]) => ok [],
            },
        },
    };

/// The goals named, made by the package's own script -- `[:ok, [[name,
/// path]]]`, each where its result is -- or why they could not be.
let goals! : :map -> :map -> [:string] -> Result [[:string, :string]] :string;
let goals! m o names =
    match resolve! m o false {
        Result.error(why) => Result.error why,
        Result.ok(g) => match filter (fn s -> script.Scripted.key s == manifest.name m) (scripted! m o g) {
            [] => Result.error ("`" + manifest.name m + "` has no build script, so it has no goals"),
            own => match script.run_all! (script_setting! m (with_option :goals names o) g) own {
                Result.error(why) => Result.error why,
                Result.ok([[_, outcome], .._]) => Result.ok (list.sort_on list.head (map.pairs (Outcome.goals outcome))),
                Result.ok([]) => ok [],
            },
        },
    };

/// The compiler arguments this build's scripts add: none, and nothing run,
/// when no package has a script.
let script_args! m o g =
    match scripted! m o g {
        [] => ok [],
        found => match script.run_all! (script_setting! m o g) found {
            Result.error(why) => Result.error why,
            Result.ok(outcomes) => script.compile_args outcomes,
        },
    };

/// Where the compiler keeps each module's walk and lowering between builds
/// (`dreams --units`), so a build after an edit to one module walks and lowers
/// that module and reads the rest back. One cache for every project and every
/// compiler, since a unit's key holds the compiler's digest and everything the
/// unit was computed from: `$MIND_UNITS`, or `units` in `mind`'s own
/// directory, and `MIND_UNITS=off` for none.
let units_args! () = match path.from_env! "MIND_UNITS" {
    () => kept_units! (path.join (util.mind_home! ()) "units"),
    "off" => [],
    dir => kept_units! dir,
};

let kept_units! dir = {
    forget_units! dir
    ["--units", dir]
};

// --- a cache that forgets ------------------------------------------------------
//
// Every edit makes new units and nothing makes one stale -- a unit is keyed on
// what it was made from, so an old one is never wrong, only never asked for
// again -- and so a unit cache left alone only grows. A unit that is read back
// is written again when it is more than a day old (`unit.recall!` in
// `dreams`), so a unit's modification time is within a day of the last build
// that used it, and here the ones no build has used in `unit_days` are removed.
// Once a day at most, by the modification time of a stamp in the cache: a
// scan of the whole directory at every build would cost what the cache saves.
// Two builds that forget at once remove the same files, and a unit removed
// while a build reads it is a unit that build computes again.

let unit_days = 30;
let day_ms = 86400000;

let forget_units! : :string -> :unit;
let forget_units! dir = {
    let now = vm.wall_ms! ();
    let stamp = path.join dir "forgotten";
    match io.stat! stamp {
        [_, at, _] if now - at / 1000000 < day_ms => (),
        _ => {
            file.mkdir_all! dir
            file.write! stamp ""
            strict! (map (fn name -> forget_unit! (path.join dir name) now) (file.list! dir))
            ()
        },
    }
};

let forget_unit! path now = match io.stat! path {
    [_, at, :file] if now - at / 1000000 > unit_days * day_ms =>
        try! { io.remove! path } catch _ { () },
    _ => (),
};

/// The whole command line for one build.
///
/// The package's settings come before this invocation's, because the compiler
/// takes the last of a repeated option: putting the command line last is what
/// makes it win.
let compile_args! m o =
    match search_paths! m o {
        Result.error(why) => Result.error why,
        [:ok, g, paths] => match [script_args! m o g, payload_args m g] {
            [Result.error(why), _] => Result.error why,
            [_, Result.error(why)] => Result.error why,
            [Result.ok(from_scripts), Result.ok(carried)] => Result.ok (list.concat [
              [match option o :entry () { () => manifest.entry! m, e => e }],
              paths,
              repeated "-L" (list.append (manifest.package_paths m) (option o :paths [])),
              repeated "-I" (list.unique (list.concat [manifest.includes m, dep_includes g,
                                                       option o :includes []])),
              repeated "--host-module"
                       (list.unique (list.concat [manifest.host_modules m, dep_hosts g,
                                                  option o :hosts []])),
              setting_args m o g,
              units_args! (),
              from_scripts,
              carried,
              ["-o", output_of m o],
              manifest.compiler_flags m,
              manifest.profile_flags m (profile_of o),
              option o :extra [],
              option o :flags [],
            ]),
        },
    };

/// What the program is compiled as: its defines, every package's options
/// scoped to it, and where it may run. Every declared option is passed,
/// defaults included, because that is what makes it scoped -- a package's
/// `vendored = false` shadows a program-wide `vendored` -- and the root's are
/// scoped too, under its own name.
let setting_args m o g =
    list.concat [
        repeated "-D" (program_defines m o),
        repeated "-D" (flat_map (fn [key, vs] -> {
            let scope = if key == root_key { manifest.name m } else { key };
            map (fn [n, v] -> scope + ":" + n + "=" + config.shown v) (map.pairs vs)
        }) (map.pairs (g.[:options else (%{})]))),
        repeated "--target" (targets m o),
    ];

/// Where the image may run: `--target`, then the profile's, then `[build]`'s.
let targets m o =
    match option o :targets [] {
        [] => match manifest.profile_target m (profile_of o) {
            [] => manifest.target m,
            t => t,
        },
        t => t,
    };

/// The command as it would be typed, for `--verbose` and for a bug report.
let command_line! m o =
    match compile_args! m o {
        Result.error(why) => Result.error why,
        Result.ok(args) =>
            match compiler_command! (choose_compiler! m (option o :compiler ())) {
                [program, lead] => Result.ok (str.join_str " " (list.cons program (list.append lead args))),
            },
    };

/// Compile the package. `:extra` carries the flags a command adds itself, such
/// as `--test`.
let compile! m o = {
    match compile_args! m o {
        Result.error(why) => Result.error why,
        Result.ok(args) => {
            file.mkdir_all! (path.dirname (output_of m o))
            match compiler_command! (choose_compiler! m (option o :compiler ())) {
                [program, lead] => {
                    if option o :verbose false {
                        console.error! (str.join_str " " (list.cons program (list.append lead args)))
                    }
                    // The compiler's output is read here, so its standard error is
                    // a pipe and would draw no progress. Told to draw on the
                    // terminal instead -- when there is one this run is drawing on
                    // -- its bars reach the person watching (see std.progress).
                    let r = os.exec_with! (os.cwd! ()) (progress.child_env! ()) program (list.append lead args) 0;
                    let code = r.[:code else (0 - 1)];
                    if code == 0 { Result.ok (r.[:out else ""]) }
                    else {
                        let err = r.[:err else ""];
                        let out = r.[:out else ""];
                        Result.error (str.trim (err + out))
                    }
                },
            }
        },
    }
};

// --- the interactive session ---------------------------------------------------
//
// `mind repl` is the compiler's own REPL, started with what this project sees:
// the standard library, every dependency, and the `when` flags the manifest
// sets. That is the whole reason for it being a `mind` command -- the flags a
// session wants are the flags a build wants, and working them out by hand for a
// project with dependencies is a chore nobody should have to repeat.
//
// It hands the terminal over with `os.replace!` rather than running a child:
// `exec!` gives the child pipes and reads them to the end, which is fine for a
// compiler and useless for something that prompts.

/// The directory that holds the project's package -- its manifest's own
/// directory, which is what `-L` wants: a package, or a directory of them.
let root_of m = manifest.root m;

/// The arguments a session is started with, without the compiler's own name.
/// `settings` is what the program is compiled as (`setting_args`), which
/// needs the graph when there is a project.
let repl_args m o settings =
    list.concat [
        ["--repl"],
        repeated "-L" (list.append (manifest.package_paths m) (option o :paths [])),
        repeated "-I" (list.append (manifest.includes m) (option o :includes [])),
        repeated "--host-module"
                 (list.append (manifest.host_modules m) (option o :hosts [])),
        settings,
        manifest.compiler_flags m,
        manifest.profile_flags m (profile_of o),
        option o :flags [],
    ];

/// Become the compiler, in interactive mode. Answers only `[:error, why]`, and
/// only when it could not: on success there is nothing left of `mind` to return
/// to.
let become_repl! m o args = {
    if option o :verbose false {
        console.error! (str.join_str " " (list.cons (choose_compiler! m (option o :compiler ()))
                                                    args))
    }
    match compiler_command! (choose_compiler! m (option o :compiler ())) {
        [program, lead] => {
            match try! { os.replace! program (list.append lead args) }
                  catch e { Result.error ("cannot start " + to_string program + ": " + to_string e) } {
                Result.error(why) => Result.error why,
                _ => Result.error "the session did not start",
            }
        },
    }
};

/// A session inside a project: every package it can see is on the search path,
/// the project's own included.
///
/// The project has to be named explicitly. A build finds it by walking up from
/// the entry file, and a session has no entry file to walk up from -- what it
/// compiles is a scratch file somewhere else entirely -- so a `-L` on the root
/// is what makes `import <this project>` work from the prompt.
let repl! m o = {
    let dev = with_option :dev true o;
    match search_paths! m dev {
        Result.error(why) => Result.error why,
        [:ok, g, paths] =>
            become_repl! m o (list.concat [repl_args m o (setting_args m dev g), paths, ["-L", root_of m]]),
    }
};

/// A session outside one. The standard library is enough to explore the
/// language with, and demanding a `mind.toml` before answering would make the
/// quickest thing here the most ceremonious.
let bare_repl! o =
    become_repl! manifest.empty o
                 (list.append (repl_args manifest.empty o (repeated "-D" (option o :defines [])))
                              ["-L", stdlib_root! ()]);

/// Run a built image, passing `args` to the program.
let run_image! m o args = {
    let r = os.exec! (vm_command! ()) (list.cons (output_of m o) args);
    [r.[:code else (0 - 1)], r.[:out else ""], r.[:err else ""]]
};
