// Code that names something documented is a link to it. A guide that says
// `list.map`, a doc comment that says `http.server.static!`, and a module page
// that says `first_or` of its neighbour each lead to the entry they name, in
// the project's own reference or the standard library's, with nothing written
// but the name -- which is how people already write them.
//
// A name is linked in the spellings code uses for it after an import: whole
// (`std.http.server.static!`), without its package (`http.server.static!`),
// and by the last part of its module (`server.static!`), each a little less
// sure than the one before. Where two places answer to one spelling at the
// same certainty, neither is linked: a link to the wrong thing is worse than
// none. The project's own modules are surer than the library's, so its
// `config.load` is the link even if `std` has a `config` too.
//
// It is a pass over a finished page. A Markdown code span renders as a bare
// `<code>`, and a block's code always carries a class, so the two are told
// apart by the tag alone; code already inside a link (a heading's anchor, a
// label in `[..](..)`) stays as it is, since a link may not hold another.
import std.list;
import std.map;
import std.str;
import documentation.markdown;
import documentation.theme;

/// The ways code spells module `name`, with how sure each is: `std.list` is
/// `std.list` and `list`; `std.http.server` is also `http.server` and `server`.
let spellings : :string -> [[:any]];
let spellings name = {
    let parts = str.split "." name;
    let n = list.length parts;
    list.append [[name, 3]] (list.append (if n > 1 { [[str.join_str "." (list.drop 1 parts), 2]] } else { [] })
                                         (if n > 2 { [[list.last parts, 1]] } else { [] }))
};

/// `index` with `key` leading to `url` at `sure`: a surer answer replaces a
/// less sure one, and a tie between two places is no answer at all.
let add : :string -> :integer -> :string -> :map -> :map;
let add key sure url index = match index.[key else ()] {
    () => index.[key => [sure, url]],
    [had, there] if had > sure => index,
    [had, there] if had < sure || there == url => index.[key => [sure, url]],
    _ => index.[key => [sure, ()]],
};

/// Every linkable spelling of the modules given as `[name, url, entry names,
/// own]`, and where each leads.
let index : [[:any]] -> :map;
let index modules = list.fold_strict (fn idx [name, url, names, own] ->
    list.fold_strict (fn i [spelling, sure] -> {
        let s = if own { sure + 10 } else { sure };
        list.fold_strict (fn j e -> add (spelling + "." + e) s (url + "#" + e) j) (add spelling s url i) names
    }) idx (spellings name)) (%{}) modules;

/// Text as it was before `markdown.escape`.
let unescape : :string -> :string;
let unescape t = t |> str.replace "&lt;" "<" |> str.replace "&gt;" ">" |> str.replace "&quot;" "\"" |> str.replace "&#39;" "'" |> str.replace "&amp;" "&";

/// Whether, after `text`, a link is open: the last `<a ` in it is later than
/// the last `</a>`, or neither is there and one was open before it.
let in_link : :bool -> :string -> :bool;
let in_link before text = {
    let opened = str.find_last "<a " text;
    let closed = str.find_last "</a>" text;
    if opened < 0 && closed < 0 { before } else { opened > closed }
};

/// Where the code `text` leads from page `page`: an entry of the page's own
/// module (`local`, by bare name), or anything `idx` knows; `()` for nowhere.
let target : :map -> [:string] -> :string -> :string -> (:string | :unit);
let target idx local page text = {
    let name = str.trim text;
    if list.contains name local { "#" + name }
    else {
        match idx.[name else ()] {
            [_, url] if url != () => theme.relative_root page + url,
            _ => (),
        }
    }
};

/// `html`, the body of page `page`, with each inline code span that names
/// something made a link to it.
let linked : :map -> [:string] -> :string -> :string -> :string;
let linked idx local page html = match str.split "<code>" html {
    [] => html,
    [first, ..rest] => {
        let rec go open chunks acc = match chunks {
            [] => str.concat_all (list.reverse acc),
            [chunk, ..more] => {
                let close = str.find "</code>" chunk;
                if close < 0 { go (in_link open chunk) more (list.cons ("<code>" + chunk) acc) }
                else {
                    let inner = str.slice 0 close chunk;
                    let after = str.slice close (len chunk - close) chunk;
                    let to = if open { () } else { target idx local page (unescape inner) };
                    let code = match to {
                        () => "<code>" + inner,
                        url => "<a class=\"ref\" href=\"" + markdown.escape url + "\"><code>" + inner + "</code></a>" + str.slice 7 (len after - 7) after,
                    };
                    let rendered = if to == () { code + after } else { code };
                    go (in_link open after) more (list.cons rendered acc)
                }
            },
        };
        go (in_link false first) rest [first]
    },
};
