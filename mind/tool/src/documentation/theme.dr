// The look of `mind docs`: the frame every guide and module is drawn in, the
// overview, and the stylesheet and script they share.
//
// A site made by `mind docs` has to work from a directory opened in a browser
// as well as from `mind docs serve`, with nothing fetched from anywhere: the
// fonts are the system's, the icons are drawn inline, and every page names
// its assets relative to itself (`relative_root`). The page reads without the
// script too. Search, highlighting, copy buttons, the "On this page" list and
// the drawer on a phone are what the script adds, and it adds them with the
// DOM rather than markup built from strings, so nothing a page or a doc
// comment says can become markup in the search results.
//
// The colours are custom properties on `:root`, set once for light, again for
// a dark system, and again for a reader's own choice (`data-theme`), which
// the script remembers and a line at the head of each page applies before
// anything is drawn, so a dark page does not flash light first.
import std.list;
import std.str;
import documentation.markdown;

/// What every page of one site shares.
mapping Site {
    title : :string = ""
    version : :string = ""
    description : :string = ""
}

/// The way from a page back to the top of the site: `../` for each directory
/// the page is in.
let relative_root : :string -> :string;
let relative_root url = str.repeat (list.length (str.split "/" url) - 1) "../";

/// Which part of the navigation a page belongs to: `""` for the overview,
/// `"guides"`, or the package an API page documents.
let section : :string -> :string;
let section url = match str.split "/" url {
    ["guides", .._] => "guides",
    ["api", label, .._] => label,
    _ => "",
};

/// The first sentence or so of a guide, for its card: the first line that is
/// prose rather than a heading, a list, a table or code, without its marks.
let blurb : :string -> :string;
let blurb text = {
    let lines = map str.trim (str.split "\n" text);
    let marks = ["#", "```", "~~~", "|", "<", "- ", "* ", ">", "![", "["];
    let prose = filter (fn l -> l != "" && not (list.any (fn m -> str.starts_with m l) marks)) lines;
    let first = list.first_or "" prose |> str.replace "`" "" |> str.replace "**" "";
    if len first > 160 { str.truncate 157 first + "…" } else { first }
};

let icon_search = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>";
let icon_menu = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>";
let icon_sun = "<svg class=\"theme-light\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>";
let icon_moon = "<svg class=\"theme-dark\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"/></svg>";

/// The navigation: the overview, the guides, and each package's modules, a
/// group each, the page being read marked. A group of more than a dozen --
/// the standard library's, most often -- folds away unless the page being read
/// is in it, so a project's own few modules are not lost below it.
let nav_html : :string -> [:map] -> :map -> :string;
let nav_html root pages p = {
    let link q = "<li><a " + (if q.[:url] == p.[:url] { "aria-current=\"page\" " } else { "" })
        + "href=\"" + markdown.escape (root + q.[:url]) + "\">" + markdown.escape q.[:title] + "</a></li>";
    let sections = list.unique (map (fn q -> section q.[:url]) pages);
    str.concat_all (map (fn s -> {
        let members = filter (fn q -> section q.[:url] == s) pages;
        let heading = match s { "" => "Start", "guides" => "Guides", "std" => "Standard library", label => "API · " + label };
        let kind = if s == "" || s == "guides" { "group" } else { "group api" };
        let items = "<ul>" + str.concat_all (map link members) + "</ul>";
        if list.length members > 12 {
            let here = list.any (fn q -> q.[:url] == p.[:url]) members;
            "<details class=\"" + kind + "\"" + (if here { " open" } else { "" }) + "><summary><h2>" + markdown.escape heading + "</h2></summary>" + items + "</details>"
        } else {
            "<div class=\"" + kind + "\"><h2>" + markdown.escape heading + "</h2>" + items + "</div>"
        }
    }) sections)
};

/// Links to the pages before and after this one in the navigation's order.
let pager_html : :string -> [:map] -> :map -> :string;
let pager_html root pages p = {
    let at = list.first_or (0 - 1) (flat_map (fn [i, q] -> if q.[:url] == p.[:url] { [i] } else { [] }) (list.enumerate pages));
    let card kind word q = "<a class=\"" + kind + "\" href=\"" + markdown.escape (root + q.[:url]) + "\"><small>" + word + "</small>"
        + markdown.escape q.[:title] + "</a>";
    let before = if at > 0 { card "prev" "Previous" (list.nth (at - 1) pages) } else { "" };
    let after = if at >= 0 && at + 1 < list.length pages { card "next" "Next" (list.nth (at + 1) pages) } else { "" };
    if before == "" && after == "" { "" } else { "<nav class=\"pager\" aria-label=\"Pages\">" + before + after + "</nav>" }
};

/// A whole page: `p`'s body in the site's frame, `pages` being the navigation.
let page_html : Site -> [:map] -> :map -> :string;
let page_html site pages p = {
    let root = relative_root p.[:url];
    let title = Site.title site;
    let version = if Site.version site == "" { "" } else { "<span class=\"version\">v" + markdown.escape (Site.version site) + "</span>" };
    "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        + "<meta name=\"generator\" content=\"mind docs\">"
        + (if Site.description site == "" { "" } else { "<meta name=\"description\" content=\"" + markdown.escape (Site.description site) + "\">" })
        + "<title>" + markdown.escape (if p.[:url] == "index.html" { title } else { p.[:title] + " · " + title }) + "</title>"
        + "<script>try{var t=localStorage.getItem('mind-docs-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>"
        + "<link rel=\"stylesheet\" href=\"" + root + "assets/docs.css\"></head>"
        + "<body data-root=\"" + root + "\"><a class=\"skip\" href=\"#main\">Skip to content</a>"
        + "<header class=\"topbar\"><button class=\"icon menu\" id=\"menu\" type=\"button\" aria-label=\"Navigation\" aria-expanded=\"false\" aria-controls=\"sidebar\">" + icon_menu + "</button>"
        + "<a class=\"brand\" href=\"" + root + "index.html\"><span class=\"mark\" aria-hidden=\"true\"></span><span>" + markdown.escape title + "</span></a>" + version
        + "<span class=\"spacer\"></span><div class=\"search\" role=\"search\">" + icon_search
        + "<input id=\"search\" type=\"search\" placeholder=\"Search\" aria-label=\"Search the documentation\" autocomplete=\"off\" spellcheck=\"false\">"
        + "<kbd>/</kbd><div class=\"results\" id=\"results\" role=\"listbox\" hidden></div></div>"
        + "<button class=\"icon\" id=\"theme\" type=\"button\" aria-label=\"Switch between light and dark\">" + icon_sun + icon_moon + "</button></header>"
        + "<div class=\"scrim\" id=\"scrim\"></div><div class=\"layout\">"
        + "<nav class=\"sidebar\" id=\"sidebar\" aria-label=\"Documentation\">" + nav_html root pages p + "</nav>"
        + "<main id=\"main\"><article class=\"prose\" id=\"article\">" + p.[:body] + "</article>" + pager_html root pages p
        + "<footer class=\"site\">Built with <code>mind docs</code> · works offline</footer></main>"
        + "<aside class=\"toc\" id=\"toc\" aria-label=\"On this page\"></aside></div>"
        + "<script src=\"" + root + "assets/search.js\"></script><script src=\"" + root + "assets/docs.js\"></script></body></html>"
};

/// The overview: what the site documents, then a card for each guide (its
/// first line) and each module (how much of it is documented).
/// `guides` and `modules` are `[url, title, line]`.
let overview_html : Site -> [[:string]] -> [[:string]] -> :string;
let overview_html site guides modules = {
    let cards kind entries = "<ul class=\"cards\">" + str.concat_all (map (fn [url, title, line] ->
        "<li><a class=\"card" + kind + "\" href=\"" + markdown.escape url + "\"><strong>" + markdown.escape title + "</strong>"
            + (if line == "" { "" } else { "<span>" + markdown.escape line + "</span>" }) + "</a></li>") entries) + "</ul>";
    let lede = if Site.description site == "" { "Guides and the API reference, searchable from every page." } else { Site.description site };
    "<section class=\"hero\">" + (if Site.version site == "" { "" } else { "<span class=\"eyebrow\">v" + markdown.escape (Site.version site) + "</span>" })
        + "<h1>" + markdown.escape (Site.title site) + "</h1><p>" + markdown.escape lede + "</p></section>"
        + (if list.is_empty guides { "" } else { "<h2 class=\"section-title\" id=\"guides\">Guides</h2>" + cards "" guides })
        + (if list.is_empty modules { "" } else { "<h2 class=\"section-title\" id=\"api\">API reference</h2>" + cards " mono" modules })
};

/// The stylesheet every page links, as `assets/docs.css`.
let css : :string;
let css = "
:root {
  color-scheme: light;
  --bg: #fbfbfd; --bg-soft: #f4f4f8; --panel: #ffffff; --code: #f5f4fb;
  --ink: #1a1b26; --ink-soft: #3d4052; --muted: #6b6f85; --line: #e4e4ee; --line-strong: #d2d2e0;
  --accent: #5b47e0; --accent-soft: #ece9ff; --accent-ink: #4330c4;
  --ok: #1d8a5b; --ok-soft: #e3f5ec; --bad: #c2364b; --bad-soft: #fbe7ea;
  --shadow: 0 1px 2px rgba(26, 27, 38, .04), 0 8px 24px rgba(26, 27, 38, .06);
  --t-kw: #7c3aed; --t-str: #0f7b5f; --t-num: #b45309; --t-atom: #0369a1; --t-com: #8a8ca3;
  --t-ty: #be185d; --t-eff: #c2410c; --t-def: #1d4ed8; --t-op: #6b6f85;
  --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;
  --mono: ui-monospace, \"JetBrains Mono\", \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace;
  --top: 60px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme=\"light\"]) {
    color-scheme: dark;
    --bg: #0e1016; --bg-soft: #141720; --panel: #161a24; --code: #12151e;
    --ink: #e7e8f0; --ink-soft: #c3c6d6; --muted: #8d91a8; --line: #252a38; --line-strong: #323849;
    --accent: #a594ff; --accent-soft: #221d3f; --accent-ink: #c4b8ff;
    --ok: #4ccf93; --ok-soft: #0f2a1f; --bad: #ff7b8e; --bad-soft: #33161c;
    --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 28px rgba(0, 0, 0, .35);
    --t-kw: #c4a7ff; --t-str: #7ee2b8; --t-num: #f8b26a; --t-atom: #7cc7f5; --t-com: #6b7089;
    --t-ty: #f59ac4; --t-eff: #ff9d6e; --t-def: #8fb4ff; --t-op: #8d91a8;
  }
}
:root[data-theme=\"dark\"] {
  color-scheme: dark;
  --bg: #0e1016; --bg-soft: #141720; --panel: #161a24; --code: #12151e;
  --ink: #e7e8f0; --ink-soft: #c3c6d6; --muted: #8d91a8; --line: #252a38; --line-strong: #323849;
  --accent: #a594ff; --accent-soft: #221d3f; --accent-ink: #c4b8ff;
  --ok: #4ccf93; --ok-soft: #0f2a1f; --bad: #ff7b8e; --bad-soft: #33161c;
  --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 28px rgba(0, 0, 0, .35);
  --t-kw: #c4a7ff; --t-str: #7ee2b8; --t-num: #f8b26a; --t-atom: #7cc7f5; --t-com: #6b7089;
  --t-ty: #f59ac4; --t-eff: #ff9d6e; --t-def: #8fb4ff; --t-op: #8d91a8;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--top) + 16px); }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.7 var(--sans); -webkit-font-smoothing: antialiased; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: .2em; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
[hidden] { display: none !important; }
.skip { position: absolute; left: 12px; top: 12px; z-index: 50; background: var(--panel); padding: 8px 14px; border-radius: 8px; box-shadow: var(--shadow); transform: translateY(-200%); }
.skip:focus { transform: none; }

/* --- top bar ------------------------------------------------------------ */
.topbar {
  position: sticky; top: 0; z-index: 30; height: var(--top);
  display: flex; align-items: center; gap: 14px; padding: 0 20px;
  background: color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px);
  border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; letter-spacing: -.01em; white-space: nowrap; min-width: 0; }
.brand:hover { text-decoration: none; }
.brand span:last-child { overflow: hidden; text-overflow: ellipsis; }
.mark { width: 26px; height: 26px; border-radius: 8px; flex: none; background: linear-gradient(135deg, var(--accent), #e057c8); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .25); }
.version { font: 600 12px/1 var(--mono); color: var(--muted); background: var(--bg-soft); border: 1px solid var(--line); padding: 5px 8px; border-radius: 999px; }
.spacer { flex: 1; }
.search { position: relative; width: min(420px, 100%); }
.search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--muted); pointer-events: none; }
.search input {
  width: 100%; height: 38px; padding: 0 44px 0 36px; font: inherit; font-size: 14px; color: var(--ink);
  background: var(--bg-soft); border: 1px solid var(--line); border-radius: 10px; transition: border-color .15s, background .15s;
}
.search input::placeholder { color: var(--muted); }
.search input:focus { outline: none; border-color: var(--accent); background: var(--panel); box-shadow: 0 0 0 4px var(--accent-soft); }
.search kbd { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font: 600 11px/1 var(--mono); color: var(--muted); border: 1px solid var(--line-strong); border-bottom-width: 2px; padding: 3px 6px; border-radius: 6px; background: var(--panel); }
.icon {
  width: 38px; height: 38px; flex: none; display: grid; place-items: center; cursor: pointer;
  color: var(--ink-soft); background: transparent; border: 1px solid transparent; border-radius: 10px;
}
.icon:hover { background: var(--bg-soft); border-color: var(--line); }
.icon svg { width: 18px; height: 18px; }
.menu { display: none; }
.theme-dark { display: none; }
:root[data-theme=\"dark\"] .theme-dark { display: block; }
:root[data-theme=\"dark\"] .theme-light { display: none; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme=\"light\"]) .theme-dark { display: block; }
  :root:not([data-theme=\"light\"]) .theme-light { display: none; }
}

/* --- search results ----------------------------------------------------- */
.results {
  position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 40; max-height: min(70vh, 560px); overflow: auto;
  background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 6px;
}
.results a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--ink); }
.results a:hover, .results a[aria-selected=\"true\"] { background: var(--accent-soft); text-decoration: none; }
.results strong { display: block; font-size: 14px; }
.results small { display: block; color: var(--muted); font-size: 13px; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.results mark { background: transparent; color: var(--accent-ink); font-weight: 700; }
.results .empty { padding: 14px 12px; color: var(--muted); font-size: 14px; }
.results .kind { float: right; font: 600 11px/1.8 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }

/* --- layout ------------------------------------------------------------- */
.layout { display: grid; grid-template-columns: 272px minmax(0, 1fr) 224px; max-width: 1480px; margin: 0 auto; }
.sidebar {
  position: sticky; top: var(--top); height: calc(100vh - var(--top)); overflow-y: auto; overscroll-behavior: contain;
  padding: 24px 14px 48px 20px; border-right: 1px solid var(--line); font-size: 14px;
}
.sidebar h2 { margin: 22px 10px 6px; font: 700 11px/1.4 var(--sans); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.sidebar .group:first-child h2 { margin-top: 0; }
.sidebar ul { list-style: none; margin: 0; padding: 0; }
.sidebar a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--ink-soft); line-height: 1.45; overflow-wrap: anywhere; }
.sidebar a:hover { background: var(--bg-soft); color: var(--ink); text-decoration: none; }
.sidebar a[aria-current=\"page\"] { background: var(--accent-soft); color: var(--accent-ink); font-weight: 600; }
.sidebar .api a { font-family: var(--mono); font-size: 13px; }
.sidebar details > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; border-radius: 8px; }
.sidebar details > summary::-webkit-details-marker { display: none; }
.sidebar details > summary::after { content: \"\"; width: 7px; height: 7px; margin: 16px 12px 0 0; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(-45deg); transition: transform .15s; }
.sidebar details[open] > summary::after { transform: rotate(45deg); margin-top: 12px; }
.sidebar details > summary:hover h2 { color: var(--ink); }
.sidebar details > summary h2 { display: inline-block; }
a.ref:hover { text-decoration: none; }
a.ref code { color: var(--accent-ink); border-color: color-mix(in srgb, var(--accent) 30%, var(--line)); }
a.ref:hover code { background: var(--accent-soft); }
main { min-width: 0; padding: 40px 56px 64px; }
.prose { max-width: 780px; }
.toc { position: sticky; top: var(--top); height: calc(100vh - var(--top)); overflow-y: auto; padding: 40px 20px 40px 8px; font-size: 13px; }
.toc strong { display: block; margin-bottom: 10px; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.toc a { display: block; padding: 4px 0 4px 12px; color: var(--muted); border-left: 2px solid var(--line); line-height: 1.45; }
.toc a.sub { padding-left: 24px; }
.toc a:hover { color: var(--ink); text-decoration: none; }
.toc a.active { color: var(--accent-ink); border-left-color: var(--accent); font-weight: 600; }

/* --- prose -------------------------------------------------------------- */
.prose h1 { font-size: clamp(2rem, 1.5rem + 1.6vw, 2.6rem); line-height: 1.15; letter-spacing: -.025em; margin: 0 0 .6em; }
.prose h2 { font-size: 1.5rem; line-height: 1.3; letter-spacing: -.015em; margin: 2.4em 0 .7em; padding-top: .3em; }
.prose h3 { font-size: 1.18rem; margin: 2em 0 .6em; }
.prose h4, .prose h5, .prose h6 { font-size: 1rem; margin: 1.6em 0 .5em; }
.prose h1 + p { font-size: 1.12rem; color: var(--ink-soft); }
.prose p, .prose ul, .prose ol { margin: 0 0 1.1em; }
.prose li { margin: .3em 0; }
.prose li::marker { color: var(--muted); }
.prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }
.prose img { max-width: 100%; border-radius: 10px; }
.anchor { color: inherit; position: relative; }
.anchor:hover { text-decoration: none; }
.anchor:hover::after { content: \"#\"; position: absolute; right: -1.1em; color: var(--muted); font-weight: 400; }
.prose :not(pre) > code { font: .86em/1.5 var(--mono); background: var(--code); border: 1px solid var(--line); padding: .12em .38em; border-radius: 6px; overflow-wrap: anywhere; }
.prose blockquote { margin: 1.4em 0; padding: 14px 18px; background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 10px 10px 0; color: var(--ink-soft); }
.prose blockquote > :last-child { margin-bottom: 0; }
.table { overflow-x: auto; margin: 1.4em 0; border: 1px solid var(--line); border-radius: 10px; }
.prose table { width: 100%; border-collapse: collapse; font-size: 14px; }
.prose th { text-align: left; font-weight: 600; background: var(--bg-soft); }
.prose th, .prose td { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
.prose tr:last-child td { border-bottom: 0; }

/* --- code --------------------------------------------------------------- */
.code { position: relative; margin: 1.4em 0; }
.prose pre {
  margin: 0; padding: 16px 18px; overflow-x: auto; background: var(--code); border: 1px solid var(--line); border-radius: 12px;
  font: 13.5px/1.65 var(--mono); tab-size: 4;
}
.prose pre code { font: inherit; background: none; border: 0; padding: 0; }
.copy {
  position: absolute; top: 8px; right: 8px; padding: 4px 10px; cursor: pointer; opacity: 0; transition: opacity .15s;
  font: 600 12px/1.6 var(--sans); color: var(--muted); background: var(--panel); border: 1px solid var(--line); border-radius: 7px;
}
.code:hover .copy, .copy:focus-visible { opacity: 1; }
.copy.done { color: var(--ok); opacity: 1; }
.code .lang { position: absolute; top: 9px; right: 14px; font: 600 11px/1.6 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .05em; pointer-events: none; transition: opacity .15s; }
.code:hover .lang { opacity: 0; }
.t-kw { color: var(--t-kw); font-weight: 600; }
.t-str { color: var(--t-str); }
.t-num { color: var(--t-num); }
.t-atom { color: var(--t-atom); }
.t-com { color: var(--t-com); font-style: italic; }
.t-ty { color: var(--t-ty); }
.t-eff { color: var(--t-eff); }
.t-def { color: var(--t-def); font-weight: 600; }
.t-op { color: var(--t-op); }

/* --- examples ----------------------------------------------------------- */
.code + .example-result, .example-result + .example-result { margin-top: -1.1em; }
.example-result { margin: 0 0 1.4em; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 12px 12px; overflow: hidden; }
.code:has(+ .example-result) pre { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.example-label { display: flex; align-items: center; gap: 8px; padding: 7px 14px; font: 600 12px/1.6 var(--sans); color: var(--ok); background: var(--ok-soft); }
.example-label::before { content: \"\"; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.example-result.fail .example-label { color: var(--bad); background: var(--bad-soft); }
.example-result pre { border: 0; border-radius: 0; background: var(--panel); margin: 0; padding: 12px 16px; font: 13px/1.6 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }

/* --- API ---------------------------------------------------------------- */
.module-lede { color: var(--muted); margin-top: -.6em; }
.symbol { margin: 22px 0; padding: 20px 22px 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; scroll-margin-top: calc(var(--top) + 16px); }
.symbol:target { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
.symbol-head { display: flex; align-items: baseline; gap: 12px; }
.symbol h2 { margin: 0; padding: 0; font: 700 1.08rem/1.4 var(--mono); letter-spacing: 0; overflow-wrap: anywhere; }
.symbol .source { margin-left: auto; flex: none; font-size: 12px; color: var(--muted); }
.symbol .signature { margin: 12px 0 14px; padding: 10px 14px; font-size: 13px; background: var(--code); white-space: pre-wrap; overflow-wrap: anywhere; }
.symbol-doc > :first-child { margin-top: 0; }

/* --- source pages ------------------------------------------------------- */
.prose pre.source-code { padding: 12px 0; font-size: 13px; line-height: 1.6; }
.source-code .line { display: block; padding: 0 18px 0 0; }
.source-code .line:target { background: var(--accent-soft); }
.source-code .ln { display: inline-block; width: 4.2em; padding-right: 1.2em; text-align: right; color: var(--muted); opacity: .7; user-select: none; }
.source-code .ln:hover { opacity: 1; text-decoration: none; }

/* --- overview ----------------------------------------------------------- */
.hero { padding: 16px 0 0; }
.hero .eyebrow { display: inline-block; font: 600 12px/1 var(--mono); color: var(--accent-ink); background: var(--accent-soft); padding: 6px 10px; border-radius: 999px; margin-bottom: 18px; }
.hero h1 { font-size: clamp(2.3rem, 1.6rem + 2.4vw, 3.3rem); margin-bottom: .35em; }
.hero p { font-size: 1.18rem; color: var(--ink-soft); max-width: 60ch; }
.section-title { margin-top: 1.6em !important; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; margin: 1em 0 0; padding: 0; list-style: none; }
.cards li { margin: 0; }
.card {
  display: block; height: 100%; padding: 16px 18px; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
  transition: border-color .15s, transform .15s, box-shadow .15s;
}
.card:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
.card strong { display: block; font-size: 15px; margin-bottom: 4px; }
.card.mono strong { font-family: var(--mono); font-size: 14px; }
.card span { display: block; font-size: 13.5px; line-height: 1.55; color: var(--muted); }

/* --- pager and footer --------------------------------------------------- */
.pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 780px; margin-top: 56px; }
.pager a { display: block; padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px; color: var(--ink); }
.pager a:hover { border-color: var(--accent); text-decoration: none; }
.pager small { display: block; font-size: 12px; color: var(--muted); }
.pager .next { text-align: right; grid-column: 2; }
footer.site { max-width: 780px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }

/* --- narrower screens --------------------------------------------------- */
.scrim { display: none; }
@media (max-width: 1200px) {
  .layout { grid-template-columns: 260px minmax(0, 1fr); }
  .toc { display: none; }
}
@media (max-width: 860px) {
  .layout { display: block; }
  .menu { display: grid; }
  .version, .search kbd { display: none; }
  .topbar { gap: 8px; padding: 0 12px; }
  .brand span:last-child { max-width: 34vw; }
  .sidebar {
    position: fixed; z-index: 35; top: var(--top); left: 0; bottom: 0; height: auto; width: min(300px, 86vw);
    background: var(--bg); transform: translateX(-100%); transition: transform .2s ease; box-shadow: var(--shadow);
  }
  body.nav-open .sidebar { transform: none; }
  body.nav-open .scrim { display: block; position: fixed; inset: var(--top) 0 0; z-index: 34; background: rgba(10, 10, 20, .35); }
  main { padding: 28px 16px 48px; }
  .symbol { padding: 16px 16px 4px; }
  .symbol-head { flex-wrap: wrap; }
  .anchor:hover::after { content: none; }
  .copy { opacity: 1; }
  .code .lang { display: none; }
}
@media print {
  .topbar, .sidebar, .toc, .pager, .copy, .skip { display: none !important; }
  .layout { display: block; }
  main { padding: 0; }
  .prose pre { white-space: pre-wrap; }
  .symbol { break-inside: avoid; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
";

/// The script every page runs, as `assets/docs.js`.
let javascript : :string;
let javascript = "
(function () {
  'use strict';
  var doc = document, body = doc.body, html = doc.documentElement, root = body.dataset.root || '';

  // Theme: light, dark, or the system's, remembered where storage allows.
  var themeKey = 'mind-docs-theme';
  var themeButton = doc.getElementById('theme');
  if (themeButton) themeButton.addEventListener('click', function () {
    var current = html.dataset.theme;
    var dark = current ? current === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    var next = dark ? 'light' : 'dark';
    html.dataset.theme = next;
    try { localStorage.setItem(themeKey, next); } catch (e) {}
  });

  // The navigation drawer on narrow screens.
  var menu = doc.getElementById('menu'), scrim = doc.getElementById('scrim');
  function setNav(open) {
    body.classList.toggle('nav-open', open);
    if (menu) menu.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  if (menu) menu.addEventListener('click', function () { setNav(!body.classList.contains('nav-open')); });
  if (scrim) scrim.addEventListener('click', function () { setNav(false); });
  var current = doc.querySelector('.sidebar a[aria-current]');
  if (current && current.scrollIntoView) current.scrollIntoView({ block: 'center' });

  // Dream, highlighted. A tokenizer rather than a grammar: comments, strings,
  // characters, atoms, numbers, names and the operators that shape code.
  var KEYWORDS = ' let rec fn match if else import mod when macro expand type union struct group mapping priv virtual dyn derive foreign image from installed embedded system catch after as in and or not true false comp test resource out ';
  var EFFECTS = ' try! raise! defer! strict! spawn! receive! send! join! self! comp! ';
  var DEFINERS = ' let rec macro type union struct group mapping mod fn ';
  var TOKEN = /(\\/\\/[^\\n]*)|(\\/\\*[\\s\\S]*?(?:\\*\\/|$))|(\\$?\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"?)|('(?:\\\\u\\{[0-9a-fA-F]+\\}|\\\\.|[^'\\\\\\n])')|(:[A-Za-z_][A-Za-z0-9_]*[!?]?)|(\\b0[xob][0-9a-fA-F_]+\\b|\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?\\b)|([A-Za-z_][A-Za-z0-9_]*!?)|(->|=>|\\|>|::|\\.\\.|\\$\\(|[=+\\-*\\/%<>|&@]+)/g;
  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function span(cls, s) { return '<span class=\"t-' + cls + '\">' + esc(s) + '</span>'; }
  function highlight(text) {
    var out = '', last = 0, previous = '', m;
    TOKEN.lastIndex = 0;
    while ((m = TOKEN.exec(text))) {
      out += esc(text.slice(last, m.index));
      var t = m[0];
      if (m[1] || m[2]) out += span('com', t);
      else if (m[3] || m[4]) out += span('str', t);
      else if (m[5]) out += span('atom', t);
      else if (m[6]) out += span('num', t);
      else if (m[7]) {
        if (EFFECTS.indexOf(' ' + t + ' ') >= 0 || KEYWORDS.indexOf(' ' + t + ' ') >= 0) out += span('kw', t);
        else if (DEFINERS.indexOf(' ' + previous + ' ') >= 0 && previous !== 'fn') out += span('def', t);
        else if (t.charAt(t.length - 1) === '!') out += span('eff', t);
        else if (/^[A-Z]/.test(t)) out += span('ty', t);
        else out += esc(t);
      }
      else out += span('op', t);
      if (!m[1] && !m[2]) previous = t;
      last = TOKEN.lastIndex;
      if (t.length === 0) TOKEN.lastIndex++;
    }
    return out + esc(text.slice(last));
  }
  var dream = 'code.language-dream, code.language-dr, .signature code, .source-code .lc';
  doc.querySelectorAll(dream).forEach(function (el) { el.innerHTML = highlight(el.textContent); });

  // A copy button on every block of code.
  doc.querySelectorAll('.prose .code').forEach(function (block) {
    var code = block.querySelector('code');
    if (!code) return;
    var button = doc.createElement('button');
    button.type = 'button'; button.className = 'copy'; button.textContent = 'Copy';
    button.addEventListener('click', function () {
      var text = code.textContent;
      function done() { button.textContent = 'Copied'; button.classList.add('done'); setTimeout(function () { button.textContent = 'Copy'; button.classList.remove('done'); }, 1400); }
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
      function fallback() {
        var area = doc.createElement('textarea');
        area.value = text; area.setAttribute('readonly', ''); area.style.position = 'fixed'; area.style.opacity = '0';
        body.appendChild(area); area.select();
        try { doc.execCommand('copy'); done(); } catch (e) {}
        body.removeChild(area);
      }
    });
    block.appendChild(button);
  });

  // On this page: the article's sections, and the one being read.
  var article = doc.getElementById('article'), toc = doc.getElementById('toc');
  var headings = article ? article.querySelectorAll('h2[id], h3[id]') : [];
  if (toc && headings.length > 1) {
    var label = doc.createElement('strong');
    label.textContent = 'On this page';
    toc.appendChild(label);
    var links = {};
    headings.forEach(function (h) {
      var a = doc.createElement('a');
      a.href = '#' + h.id; a.textContent = h.textContent;
      if (h.tagName === 'H3') a.className = 'sub';
      links[h.id] = a;
      toc.appendChild(a);
    });
    if ('IntersectionObserver' in window) {
      var visible = {};
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { visible[e.target.id] = e.isIntersecting; });
        var first = null;
        headings.forEach(function (h) { if (!first && visible[h.id]) first = h.id; });
        if (!first) return;
        Object.keys(links).forEach(function (id) { links[id].classList.toggle('active', id === first); });
      }, { rootMargin: '-60px 0px -55% 0px' });
      headings.forEach(function (h) { observer.observe(h); });
    }
  } else if (toc) toc.hidden = true;

  // Search, over every page's title and text, as you type.
  var input = doc.getElementById('search'), results = doc.getElementById('results');
  var pages = window.mindDocs || [];
  var selected = -1;
  function words(q) { return q.toLowerCase().split(/\\s+/).filter(Boolean); }
  function score(page, terms) {
    var title = page.title.toLowerCase(), text = page.text.toLowerCase(), total = 0;
    for (var i = 0; i < terms.length; i++) {
      var t = terms[i], inTitle = title.indexOf(t), inText = text.indexOf(t);
      if (inTitle < 0 && inText < 0) return 0;
      total += inTitle === 0 ? 30 : inTitle > 0 ? 18 : 0;
      total += inText >= 0 ? 4 : 0;
    }
    return total + (page.url.indexOf('guides/') === 0 ? 2 : 0);
  }
  function marked(parent, text, terms) {
    var lower = text.toLowerCase(), at = 0;
    while (at < text.length) {
      var next = -1, len = 0;
      terms.forEach(function (t) { var i = lower.indexOf(t, at); if (i >= 0 && (next < 0 || i < next)) { next = i; len = t.length; } });
      if (next < 0) { parent.appendChild(doc.createTextNode(text.slice(at))); break; }
      parent.appendChild(doc.createTextNode(text.slice(at, next)));
      var m = doc.createElement('mark'); m.textContent = text.slice(next, next + len); parent.appendChild(m);
      at = next + len;
    }
  }
  function snippet(text, terms) {
    var lower = text.toLowerCase(), at = -1;
    terms.forEach(function (t) { var i = lower.indexOf(t); if (i >= 0 && (at < 0 || i < at)) at = i; });
    var start = Math.max(0, at - 40), piece = text.slice(start, start + 160).replace(/\\s+/g, ' ');
    return (start > 0 ? '… ' : '') + piece;
  }
  function choose(i) {
    var items = results.querySelectorAll('a');
    if (!items.length) return;
    selected = (i + items.length) % items.length;
    items.forEach(function (a, k) { a.setAttribute('aria-selected', k === selected ? 'true' : 'false'); });
    items[selected].scrollIntoView({ block: 'nearest' });
  }
  function render() {
    var terms = words(input.value);
    results.replaceChildren();
    selected = -1;
    if (!terms.length) { results.hidden = true; return; }
    var hits = pages.map(function (p) { return [score(p, terms), p]; })
      .filter(function (h) { return h[0] > 0; })
      .sort(function (a, b) { return b[0] - a[0]; }).slice(0, 12);
    if (!hits.length) {
      var none = doc.createElement('div'); none.className = 'empty'; none.textContent = 'Nothing matches “' + input.value.trim() + '”';
      results.appendChild(none);
    }
    hits.forEach(function (h) {
      var p = h[1], a = doc.createElement('a');
      a.href = root + p.url; a.setAttribute('role', 'option');
      var kind = doc.createElement('span'); kind.className = 'kind'; kind.textContent = p.url.indexOf('api/') === 0 ? 'API' : 'Guide';
      var title = doc.createElement('strong'); marked(title, p.title, terms);
      var small = doc.createElement('small'); marked(small, snippet(p.text, terms), terms);
      a.append(kind, title, small);
      results.appendChild(a);
    });
    results.hidden = false;
  }
  if (input && results) {
    input.addEventListener('input', render);
    input.addEventListener('focus', function () { if (input.value.trim()) render(); });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); choose(selected + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); choose(selected - 1); }
      else if (e.key === 'Enter') {
        var items = results.querySelectorAll('a');
        var target = items[selected >= 0 ? selected : 0];
        if (target) { e.preventDefault(); location.href = target.href; }
      }
      else if (e.key === 'Escape') { input.value = ''; results.hidden = true; input.blur(); }
    });
    doc.addEventListener('click', function (e) { if (!e.target.closest('.search')) results.hidden = true; });
    doc.addEventListener('keydown', function (e) {
      var typing = /^(INPUT|TEXTAREA|SELECT)$/.test(doc.activeElement.tagName);
      if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault(); setNav(false); input.focus(); input.select();
      }
    });
  }
})();
";
