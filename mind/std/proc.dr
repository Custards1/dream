// Processes: the shapes the builtins leave to the caller.
//
// `spawn!`, `join!`, `send!`, `recv!` and `self!` are the whole of the
// runtime's story about concurrency, and they are deliberately few. What is
// missing from them is not power but shape: every program that uses them ends
// up writing the same handful of things -- start these and collect the answers,
// ask a question and wait for the reply, serve requests in a loop, find out
// that a process died without dying with it.
//
// Three things about the runtime decide what can be written here.
//
// **A thunk runs once.** `$( work )` is a suspension that remembers its result,
// so spawning the same thunk twice does not run it twice: the second spawn
// finds a value. Anything that has to start the same work again -- a retry, a
// supervisor's restart -- takes a *function* of unit and builds a fresh thunk
// each time. That is why `restart!` and friends ask for `start!` rather than
// for a thunk.
//
// **Spawning is lazy too.** `list.map (fn x -> spawn! $( f x )) xs` builds a
// list of thunks and starts nothing; the processes begin one at a time as each
// element is forced, which is the opposite of what the code looks like. Every
// function here that starts more than one process forces the list first, and
// that `strict!` is the difference between running in parallel and running in
// sequence.
//
// **`recv!` takes the next message, whatever it is.** Everything subtler is
// built here on four natives of `std.vm`: look at the message at a position,
// take the message at a position, wait for the mailbox to grow past a length
// (with a deadline), and sleep. `recv_where!` scans for the first message a
// predicate accepts and leaves the rest where they were, so a process waiting
// for a reply no longer has to take, and then re-send, whatever else arrived
// first. The scan is Dream, not a native, because the predicate is the
// caller's and running it underneath a native is the one thing a native here
// must not do.
//
// **A process can be watched and stopped from outside.** `monitor!` asks to be
// sent `[:down, p, outcome]` when `p` ends, which is what `join!` tells a
// joiner but without blocking anyone; `kill! p reason` ends `p` as a failure
// of kind `:killed`, and nothing it does can prevent that. A server is still
// written around a handler that reads its mailbox and stops when asked: a kill
// is for the one that will not.

import std.error;
import std.list;
import std.vm;

// --- starting ---------------------------------------------------------------

/// Start every thunk now, and answer the processes in order.
///
/// The `strict!` is the whole function: without it the spawns are thunks and
/// the work is serialized behind whoever forces them.
let start_all! : [:any] -> [Process];
let start_all! thunks = strict! (list.map (fn t -> spawn! t) thunks);

/// Start `start! x` for each `x`, in parallel.
///
/// `start!` is a function rather than a thunk because a thunk is per-element
/// here: `$( start! x )` inside the lambda is built fresh for every `x`, which
/// is exactly what is wanted, and what makes this safe to call twice.
let start_each! : (a -> :any) -> [a] -> [Process];
let start_each! start! xs = start_all! (list.map (fn x -> $( start! x )) xs);

// --- waiting ----------------------------------------------------------------

/// Wait for every process, in order, and answer their values.
///
/// Order is the order of the list, not the order they finish: a caller that
/// wants results as they arrive wants a mailbox, not this.
let wait_all! : [Process] -> [:any];
let wait_all! ps = list.map (fn p -> join! p) ps |> strict!;

/// What a process came to, as a value: `[:ok, v]` or `[:error, e]`, where `e`
/// is the error itself -- ask `std.error` for its kind or payload.
///
/// `join!` re-raises what the process raised, which takes the joiner down with
/// it. That is right for a caller that cannot continue without the answer, and
/// wrong for anything supervising, so this is the other half.
let outcome! : Process -> Outcome :any;
let outcome! p = try! {
    // The join has to happen *inside* the `try!`, and a lazy position puts it
    // outside: `[:ok, join! p]` builds a list holding an unforced join, the
    // `try!` sees a perfectly good list, and the failure arrives at whoever
    // forces the element -- long past the `catch`. Binding it is what forces
    // it here, because a statement of an impure block is sequenced.
    let value = join! p;
    [:ok, value]
} catch e { [:error, e] };

let outcomes! : [Process] -> [Outcome :any];
let outcomes! ps = list.map (fn p -> outcome! p) ps |> strict!;

/// Run these in parallel and answer their values, in order.
let parallel! : [:any] -> [:any];
let parallel! thunks = wait_all! (start_all! thunks);

/// `list.map`, one process per element.
///
/// Worth it when `f` is slow and worth nothing when it is not: a process is
/// cheap but not free, and a list of a million integers should be mapped in
/// the ordinary way.
let map! : (a -> b) -> [a] -> [b];
let map! f xs = wait_all! (start_each! (fn x -> f x) xs);

/// The same, keeping failures as values rather than raising them.
let try_map! : (a -> b) -> [a] -> [Outcome b];
let try_map! f xs = outcomes! (start_each! (fn x -> f x) xs);

// --- talking ----------------------------------------------------------------
//
// A request carries the process to answer, because the runtime has no notion of
// a sender: `recv!` hands over a message and nothing else. `[:call, from, body,
// ref]` is that convention written down, and `serve!` below understands it. The
// reference (`vm.unique!`) is what the reply carries back, so the caller picks
// out *its* answer: one that arrives after a `call_within!` gave up waiting
// for it cannot be taken for the answer to the next call.

let call_message : Process -> b -> :integer -> Call b;
let call_message from body ref = [:call, from, body, ref];

let is_call : :any -> :bool;
let is_call m = _list_is_empty m == false && list.nth 0 m == :call;
let call_from : :list -> Process;
let call_from m = list.nth 1 m;
let call_body : :list -> :any;
let call_body m = list.nth 2 m;
let call_ref : :list -> :integer;
let call_ref m = list.nth 3 m;

let is_reply_of : :integer -> :any -> :bool;
let is_reply_of ref m = match m {
    [:reply, r, _] => r == ref,
    _ => false,
};

/// Send `body` to `target` and wait for the reply, leaving every other
/// message where it was.
///
/// The target is monitored for the length of the call, so a target that dies
/// before it answers -- or was never alive -- raises an error of kind `:down`
/// whose payload is its outcome, rather than leaving the caller parked on a
/// reply that cannot come.
let call! : Process -> :any -> :any;
let call! target body = match await_reply! target body forever {
    [:ok, value] => value,
    // Unreachable: there is no deadline to reach. Said, so the match is whole.
    other => raise! (error.new :timeout other),
};

/// `call!` that gives up after `ms` milliseconds: `[:ok, reply]`, or
/// `:timeout`. A reply that comes later is left in the mailbox, where
/// nothing that waits for a reference will take it -- but a plain `recv!`
/// will, so a process that times out calls should not also read its mailbox
/// blind.
let call_within! : Process -> :any -> :integer -> ([:ok, :any] | :timeout);
let call_within! target body ms = await_reply! target body (deadline_in! ms);

priv let await_reply! : Process -> :any -> :integer -> ([:ok, :any] | :timeout);
priv let await_reply! target body deadline = {
    let me = self! ();
    let ref = vm.unique! ();
    monitor! target
    send! target (call_message me body ref)
    let answer = recv_until! (fn m -> is_reply_of ref m || is_down_of target m) deadline;
    demonitor! target
    match answer {
        [:ok, [:reply, _, value]] => [:ok, value],
        [:ok, [:down, _, outcome]] => raise! (error.new :down outcome),
        _ => :timeout,
    }
};

/// Answer a request. The other half of `call!`.
let reply! : :list -> :any -> :any;
let reply! m value = send! (call_from m) [:reply, call_ref m, value];

// --- receiving ----------------------------------------------------------------

/// A deadline that never comes, for the waits below.
let forever : :integer;
let forever = 0 - 1;

/// The monotonic clock `ms` milliseconds from now: a deadline for the waits
/// below. Deadlines rather than durations, because a wait that is woken and
/// waits again must not start counting again.
let deadline_in! : :integer -> :integer;
let deadline_in! ms = vm.now_ns! () + ms * 1000000;

/// The first message `wanted` accepts, taken out of the mailbox as
/// `[:ok, message]`, or `:timeout` once the clock reaches `deadline` (see
/// `deadline_in!`; `forever` waits for ever, and `0` only looks). Messages it
/// does not accept stay where they were, in order.
///
/// A position, once looked at, keeps meaning the same message: only this
/// process ever removes one, and senders only append. So the scan resumes
/// where it stopped after each wait, and looks at each message once.
let recv_until! : (:any -> :bool) -> :integer -> ([:ok, :any] | :timeout);
let recv_until! wanted deadline = scan! wanted deadline 0;

priv let scan! : (:any -> :bool) -> :integer -> :integer -> ([:ok, :any] | :timeout);
priv let rec scan! wanted deadline !at = match vm.mailbox_peek! at {
    [:ok, m] =>
        if wanted m {
            vm.mailbox_take! at
            [:ok, m]
        }
        else { scan! wanted deadline (at + 1) },
    _ => match vm.await_message! at deadline {
        :ok => scan! wanted deadline at,
        _ => :timeout,
    },
};

/// The first message `wanted` accepts, waiting as long as it takes.
let recv_where! : (:any -> :bool) -> :any;
let recv_where! wanted = match recv_until! wanted forever {
    [:ok, m] => m,
    // Unreachable: there is no deadline to reach. Said, so the match is whole.
    other => raise! (error.new :timeout other),
};

/// The next message as `[:ok, message]`, or `:timeout` after `ms`
/// milliseconds without one.
let recv_within! : :integer -> ([:ok, :any] | :timeout);
let recv_within! ms = recv_until! (fn m -> true) (deadline_in! ms);

/// `recv_where!` with a limit of `ms` milliseconds.
let recv_where_within! : (:any -> :bool) -> :integer -> ([:ok, :any] | :timeout);
let recv_where_within! wanted ms = recv_until! wanted (deadline_in! ms);

/// Do nothing for `ms` milliseconds. Messages that arrive meanwhile wait.
let sleep! : :integer -> :atom;
let sleep! ms = vm.sleep_until! (deadline_in! ms);

// --- watching and stopping -------------------------------------------------------

/// Be sent `[:down, p, outcome]` when `p` ends -- at once, if it already has.
/// `outcome` is what `outcome!` answers. A failure reported this way counts as
/// handled, as one delivered to a joiner does.
let monitor! : Process -> :atom;
let monitor! p = vm.monitor! p;

/// Stop monitoring `p`, and take back the `[:down ..]` for it if it already
/// came, so a monitor that was only wanted for a while leaves nothing behind.
let demonitor! : Process -> :atom;
let demonitor! p = {
    vm.demonitor! p
    recv_until! (fn m -> is_down_of p m) 0
    :ok
};

let is_down_of : Process -> :any -> :bool;
let is_down_of p m = match m {
    [:down, q, _] => q == p,
    _ => false,
};

/// End `p` now, as a failure of kind `:killed` with `reason` as its payload:
/// that is what its joiners and monitors are told. It cannot be caught, and a
/// process can kill itself. Prefer asking (`shutdown`) for anything that holds
/// something it should let go of; this is for the process that will not stop.
let kill! : Process -> :any -> :atom;
let kill! p reason = vm.kill! p reason;

// --- serving ----------------------------------------------------------------

/// A message loop. `handle!` sees the state and one message and answers
/// `[:go, state]` to continue or `[:stop, value]` to finish with that value.
///
/// This is what a supervised worker looks like: it is the only shape that can
/// be asked to stop, because a process that is not reading its mailbox cannot
/// be told anything at all.
let serve! : s -> (s -> :any -> :any) -> :any;
let rec serve! state handle! =
    match handle! state (recv! ()) {
        [:stop, value] => value,
        [:go, next] => serve! next handle!,
        // A handler that answers something else has a bug, and stopping with
        // it is more useful than looping on it for ever.
        other => other,
    };

/// The conventional stop message, so that a worker and whatever supervises it
/// do not have to agree on a spelling.
///
/// Sending it matters more than it looks: a process parked on `recv!` is a
/// process the runtime is still waiting for, and a program that ends with one
/// of those ends with "every process is waiting for a message that cannot
/// arrive" rather than with its answer. Whoever starts a server owns stopping
/// it.
let shutdown : :atom;
let shutdown = :shutdown;

let is_shutdown : :any -> :bool;
let is_shutdown m = m == shutdown;

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let double x = x * 2;

    /// Never answers and never reads its mailbox: what `kill!` is for.
    let rec spin !n = spin (n + 1);

    /// A worker that adds up what it is sent and answers its total when asked
    /// to stop. Every test below drives one of these, because a process that
    /// only ever answers is the only kind a test can wait for.
    let adder! () =
        serve! 0 (fn total m ->
            if is_shutdown m { [:stop, total] }
            else if is_call m {
                reply! m (total + call_body m)
                [:go, total + call_body m]
            }
            else { [:go, total + m] });

    let tests = [
        test.case "parallel! answers in order"
            $( test.eq! [1, 2, 3] (parallel! [$( 1 ), $( 2 ), $( 3 )]) ),
        test.case "map! is a map"
            $( test.eq! [2, 4, 6] (map! double [1, 2, 3]) ),
        test.case "outcome! of a value"
            $( test.eq! [:ok, 7] (outcome! (spawn! $( 7 ))) ),
        // `catch` binds the error itself, not what was raised: `raise! :boom`
        // wraps `:boom` in a box whose kind is the catch-all `:error` and whose
        // payload is the atom. That is why the payload is what is compared
        // here, and it is the reason `std.error` exists.
        test.case "outcome! of a failure is a value, not a raise"
            $( test.eq! :boom (error.payload (list.nth 1 (outcome! (spawn! $( raise! :boom ))))) ),
        test.case "try_map! keeps going past a failure"
            $( {
                let got = try_map! (fn x -> if x == 1 { 1 } else { raise! :bad }) [1, 2];
                test.eq! [[:ok, 1], [:error, :bad]]
                         [list.nth 0 got,
                          [:error, error.payload (list.nth 1 (list.nth 1 got))]]
            } ),

        test.case "call! gets an answer back"
            $( {
                let p = spawn! $( adder! () );
                let answer = call! p 5;
                send! p shutdown
                join! p
                test.eq! 5 answer
            } ),
        test.case "a server stops when it is told to"
            $( {
                let p = spawn! $( adder! () );
                call! p 2
                send! p shutdown
                test.eq! 2 (join! p)
            } ),
        test.case "recv_where! leaves what it skips, in order"
            $( {
                let me = self! ();
                send! me :a
                send! me [:b, 1]
                send! me :c
                let got = recv_where! (fn m -> m != :a && m != :c);
                test.eq! [[:b, 1], :a, :c] [got, recv! (), recv! ()]
            } ),
        test.case "recv_within! times out"
            $( test.eq! :timeout (recv_within! 20) ),
        test.case "recv_within! answers a message that is there"
            $( {
                send! (self! ()) :here
                test.eq! [:ok, :here] (recv_within! 1000)
            } ),
        test.case "recv_where_within! waits for a late message"
            $( {
                let me = self! ();
                spawn! $( { sleep! 20; send! me :late } )
                test.eq! [:ok, :late] (recv_where_within! (fn m -> m == :late) 5000)
            } ),
        test.case "kill! stops a loop that reads nothing"
            $( {
                let p = spawn! $( spin 0 );
                kill! p :enough
                let [tag, e] = outcome! p;
                test.eq! [:error, :killed, :enough] [tag, error.kind e, error.payload e]
            } ),
        test.case "monitor! reports how a process ended"
            $( {
                let p = spawn! $( 6 * 7 );
                monitor! p
                test.eq! [:ok, 42] (list.nth 2 (recv_where! (fn m -> is_down_of p m)))
            } ),
        test.case "demonitor! takes back a report already sent"
            $( {
                let p = spawn! $( 1 );
                join! p
                monitor! p
                demonitor! p
                test.eq! :timeout (recv_within! 0)
            } ),
        test.case "call! raises when the target dies first"
            $( {
                let p = spawn! $( raise! :gone );
                let e = try! { call! p 1 } catch e { e };
                test.eq! :down (error.kind e)
            } ),
        test.case "call_within! times out on a target that never answers"
            $( {
                // Takes the request and then waits for something that never
                // comes; one that just took it would end, and be `:down`.
                let p = spawn! $( { recv! (); recv! () } );
                let got = call_within! p 1 30;
                kill! p :done
                // Taken, so its end is handled rather than reported at exit.
                outcome! p
                test.eq! :timeout got
            } ),
        test.case "a reply after a timeout is not the next call's answer"
            $( {
                // Answers its first request late, and its second at once.
                let slow! () = {
                    let first = recv! ();
                    sleep! 60
                    reply! first :late
                    let second = recv! ();
                    reply! second :prompt
                };
                let p = spawn! $( slow! () );
                let missed = call_within! p 1 10;
                sleep! 80
                let next = call! p 2;
                test.eq! [:timeout, :prompt] [missed, next]
            } ),
        test.case "kill! reaches a force that never ends, through a try!"
            $( {
                let rec from !n = list.cons n (from (n + 1));
                let p = spawn! $( try! { strict! (list.length (from 0)) } catch e { :caught } );
                sleep! 20
                kill! p :stop
                test.eq! :killed (error.kind (list.nth 1 (outcome! p)))
            } ),
        test.case "call! keeps messages that are not the reply"
            $( {
                let p = spawn! $( adder! () );
                send! (self! ()) :unrelated
                let answer = call! p 4;
                send! p shutdown
                join! p
                test.eq! [4, :unrelated] [answer, recv! ()]
            } ),
        test.case "a server keeps its state between messages"
            $( {
                let p = spawn! $( adder! () );
                call! p 1
                let total = call! p 2;
                // Stopped before the case ends: a server left parked on `recv!`
                // outlives the test and the runtime reports the whole program
                // as deadlocked.
                send! p shutdown
                join! p
                test.eq! 3 total
            } ),
    ];
}

// --- optional types ---------------------------------------------------------

type Process = :process;
type Call body = [:call, Process, body, :integer];
type Reply value = [:reply, :integer, value];
type Outcome value = [:ok, value] | [:error, :any];
