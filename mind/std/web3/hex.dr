// Ethereum QUANTITY and DATA encodings. Numbers stay exact, including uint256.
import std.crypto;
import std.error;
import std.list;
import std.result;
import std.str;

priv let bad message = result.error (error.new :web3_argument message);
priv let digits = "0123456789abcdef";
priv let nibble c =
    if c >= 48 && c <= 57 { c - 48 }
    else if c >= 65 && c <= 70 { c - 55 }
    else if c >= 97 && c <= 102 { c - 87 }
    else { -1 };

priv let rec valid_from s i =
    if i == len s { true }
    else { nibble (str.byte i s) >= 0 && valid_from s (i + 1) };

priv let prefixed s = type_of s == :string && len s >= 2 && str.slice 0 2 s == "0x";

/// True for 0x-prefixed, whole bytes; "0x" is empty data.
let is_data s = prefixed s && (len s % 2 == 0) && valid_from s 2;

/// Validate byte data, preserving its spelling.
let data s = if is_data s { result.ok s } else { bad "expected 0x-prefixed hex data with two digits per byte" };

/// Raw Dream bytes to Ethereum DATA.
let encode_data : :string -> :string;
let encode_data bytes = "0x" + crypto.hex bytes;

/// Ethereum DATA to raw Dream bytes, including NUL and non-UTF-8 bytes.
let decode_data s = {
    let? checked = data s;
    result.ok (str.of_bytes (list.map (fn i -> nibble (str.byte i checked) * 16 + nibble (str.byte (i + 1) checked))
        (list.map (fn i -> 2 + i * 2) (list.range 0 ((len checked - 2) / 2)))))
};

priv let rec spell n acc =
    if n == 0 { acc }
    else { spell (n / 16) (str.slice (n % 16) 1 digits + acc) };

/// Nonnegative integer to canonical QUANTITY. No floats or leading zeroes.
let quantity n =
    if type_of n != :integer || n < 0 { bad "expected a nonnegative integer quantity" }
    else { result.ok (if n == 0 { "0x0" } else { "0x" + spell n "" }) };

priv let rec read_quantity s i !acc =
    if i == len s { acc }
    else { read_quantity s (i + 1) (acc * 16 + nibble (str.byte i s)) };

let parse_quantity s =
    if not (prefixed s) || len s < 3 || (len s > 3 && str.byte 2 s == 48) || not (valid_from s 2) {
        bad "expected a canonical hex quantity (zero is 0x0; no leading zeroes)"
    } else { result.ok (read_quantity s 2 0) };

/// Address syntax only: exactly 20 bytes. Does not verify an EIP-55 checksum.
let address s =
    if is_data s && len s == 42 { result.ok s }
    else { bad "expected a 20-byte 0x-prefixed address" };

let hash s =
    if is_data s && len s == 66 { result.ok s }
    else { bad "expected a 32-byte 0x-prefixed hash" };

/// A block number (integer or canonical quantity), or a standard block tag.
let block value =
    if type_of value == :integer { quantity value }
    else if list.contains value ["latest", "earliest", "pending", "safe", "finalized"] { result.ok value }
    else { result.map (fn _ -> value) (parse_quantity value) };

when test {
    import std.test;
    let tests = [
        test.case "quantity boundaries" $( test.eq! [[:ok, "0x0"], [:ok, "0xf"], [:ok, "0x10"]]
            (list.map quantity [0, 15, 16]) ),
        test.case "uint256 stays exact" $( {
            let n = 115792089237316195423570985008687907853269984665640564039457584007913129639935;
            test.eq! (result.ok n) (result.and_then parse_quantity (quantity n))
        } ),
        test.case "quantity rejects invalid forms" $( test.true! (list.all result.is_error
            (list.map parse_quantity ["0x", "0x00", "0x01", "12", "0X1", "0xg", "0x-1", "0x1 ", (), 3])) ),
        test.case "quantity rejects floats and negatives" $( test.true! (list.all result.is_error
            (list.map quantity [-1, 1.5, "1"])) ),
        test.case "hex digits can be uppercase" $( test.eq! [:ok, 255] (parse_quantity "0xFF") ),
        test.case "all bytes roundtrip" $( {
            let bytes = str.of_bytes (list.range 0 256);
            test.eq! (result.ok bytes) (decode_data (encode_data bytes))
        } ),
        test.case "empty data is valid" $( test.eq! [:ok, ""] (decode_data "0x") ),
        test.case "data rejects partial bytes" $( test.true! (list.all result.is_error
            (list.map data ["0x0", "00", "0xgg", "0xé", (), 0])) ),
        test.case "address length" $( test.true! (result.is_ok (address "0x0000000000000000000000000000000000000000")) ),
        test.case "short address" $( test.true! (result.is_error (address "0x00")) ),
        test.case "block number and tags" $( test.eq! [[:ok, "0x10"], [:ok, "safe"], [:ok, "0x0"]]
            (list.map block [16, "safe", "0x0"]) ),
        test.case "invalid block" $( test.true! (result.is_error (block "newest")) ),
    ];
}
