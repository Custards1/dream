// Errors: the kind, the payload, and how to make one of your own.
//
// The language has said since the beginning that an error is a **kind** (an
// atom) and a **payload**, and `try! .. catch e` hands one over -- but until
// the `_error_kind` and `_error_payload` primitives there was no way in. A
// caught error could be printed and nothing else, so every program that wanted
// to tell one failure from another either matched on the text of a message or
// gave up and treated all failures alike.
//
// That is what this module is for. With the kind readable, a failure is an
// ordinary value to `match` on:
//
//     match error.kind e {
//         :divide_by_zero => ..,
//         :not_found      => ..,
//         _               => raise! e,          // not ours; pass it on
//     }
//
// and a program can raise failures of its own that are just as distinguishable
// as the runtime's, rather than raising a string and hoping the reader parses
// it back.
//
// Nothing here is impure except the two that raise. Reading an error is not an
// effect; only causing one is.

import std.str;

// --- reading ----------------------------------------------------------------

/// The kind, or `()` for a value that is not an error -- so a `match` on the
/// kind needs no type test in front of it.
let kind : :any -> :atom;
let kind e = _error_kind e;

/// The payload, or `()`. Whatever the raiser passed: `raise! "text"` makes the
/// payload that text, and the runtime's own failures carry a message.
let payload : :any -> :any;
let payload e = _error_payload e;

let is_error : :any -> :bool;
let is_error e = type_of e == :error;

/// Is this that kind of failure? The question most `catch` blocks are really
/// asking, and it is total: a non-error is not of any kind.
let is_kind : :atom -> :any -> :bool;
let is_kind k e = _error_kind e == k;

/// Is it one of these kinds?
let is_any : [:atom] -> :any -> :bool;
let rec is_any kinds e =
    if _list_is_empty kinds { false }
    else if is_kind (kinds.[0]) e { true }
    else { is_any (_list_tail kinds) e };

/// The payload as text, for a message a person will read. A payload that is
/// already a string is used as it is, so a message does not gain quotes on its
/// way to a log.
let message : :any -> :string;
let message e =
    match payload e {
        () => "",
        p => if type_of p == :string { p } else { to_string p },
    };

/// `kind: message`, which is the line to print when there is nothing more
/// useful to say.
let describe : :any -> :string;
let describe e =
    if not (is_error e) { to_string e }
    else {
        let m = message e;
        if str.is_empty m { to_string (kind e) } else { to_string (kind e) + ": " + m }
    };

// --- making -----------------------------------------------------------------

/// An error as a value. Making one is not raising one: this is how a failure is
/// *returned* -- `[:error, error.new :not_found path]` -- from a pure function,
/// which cannot raise at all.
let new : :atom -> :any -> :error;
let new k p = _error_new k p;

/// Raise a failure of a named kind. The typed form of `raise!`, which wraps
/// whatever it is given in the catch-all kind `:error`.
let raise_as! : :atom -> :any -> :never;
let raise_as! k p = raise! (_error_new k p);

/// Re-raise something caught. Worth a name because a `catch` that handles some
/// kinds has to pass the others on, and passing them on unchanged -- rather
/// than wrapping them again -- is what keeps the original kind readable.
let rethrow! : :any -> :never;
let rethrow! e = raise! e;

// --- where it was raised ----------------------------------------------------
//
// An error remembers where it was first raised: the functions that were
// running, innermost first, and -- because a lazy program fails where a value
// is *needed*, which is seldom where it was written -- the functions that made
// each value being forced at the time. The machine fills that in as it starts
// to unwind (`locate_error` in dream/src/interp.cpp), from the place each
// function was written, which the image keeps. It is what an uncaught error is
// reported with, and these are the same answer for a program that catches one.
//
// The places are functions', not lines within them: the optimizer shares
// identical nodes across the whole program, so a node has no one place.

/// Where `e` was raised, innermost first: `[:in, name, path, line, col]` for
/// a function that was running, and `[:made, name, path, line, col]` for one
/// that made a value being forced. `[]` for an error never raised, and for one
/// raised by another image. Impure because raising is what fills it in, so
/// the same value answers differently before and after.
let trace! : :any -> [[:any]];
let trace! e = _error_trace! e;

/// One place of a trace, as a line reads: ``in `f` (path:3:1)``.
let place_line : [:any] -> :string;
let place_line at = {
    let [how, name, path, line, col] = at;
    let lead = if how == :made { "forcing a value made in `" } else { "in `" };
    let where = if line == 0 { "" }
                else { " (" + path + ":" + to_string line + ":" + to_string col + ")" };
    lead + name + "`" + where
};

/// The trace as lines, the way the VM reports an uncaught error.
let trace_lines! : :any -> [:string];
let trace_lines! e = {
    let rec lines places = if _list_is_empty places { [] }
                           else { _list_cons (place_line (places.[0])) (lines (_list_tail places)) };
    lines (trace! e)
};

// --- tests -------------------------------------------------------------------

when test {
    import std.test;
    import std.list;

    /// The divisor of the runtime's own error, which several cases read. A name
    /// rather than `0`: a division by a literal zero is a compiler warning,
    /// right everywhere but here, where the error is the point.
    let zero = 0;

    /// Run a thunk in its own process and answer whatever it raised. In a
    /// process, because a case that raises should not take the runner with it,
    /// and `join!` is what turns the failure back into a value here.
    let caught! body = try! { join! (spawn! body); () } catch e { e };

    let tests = [
        test.case "the runtime's own kind is readable"
            $( test.eq! :divide_by_zero (kind (caught! $( 1 / zero ))) ),
        test.case "a raised value is wrapped in the catch-all kind"
            $( test.eq! :error (kind (caught! $( raise! "boom" ))) ),
        test.case "the payload comes back"
            $( test.eq! "boom" (payload (caught! $( raise! "boom" ))) ),
        test.case "a kind can be matched on"
            $( test.eq! "divided"
                        (match kind (caught! $( 1 / zero )) {
                             :divide_by_zero => "divided",
                             _ => "something else",
                         }) ),

        test.case "is_kind"      $( test.true! (is_kind :divide_by_zero (caught! $( 1 / zero ))) ),
        test.case "is_kind of something that is not an error"
            $( test.false! (is_kind :divide_by_zero 42) ),
        test.case "is_any"
            $( test.true! (is_any [:type_error, :divide_by_zero] (caught! $( 1 / zero ))) ),
        test.case "is_error"     $( test.true! (is_error (caught! $( 1 / zero ))) ),
        test.case "a value is not an error"  $( test.false! (is_error 42) ),

        test.case "kind of a non-error is unit"  $( test.eq! () (kind 42) ),
        test.case "payload of a non-error is unit" $( test.eq! () (payload 42) ),

        test.case "a typed failure keeps its kind"
            $( test.eq! :not_found (kind (caught! $( raise_as! :not_found "/tmp/x" ))) ),
        test.case "and its payload"
            $( test.eq! "/tmp/x" (payload (caught! $( raise_as! :not_found "/tmp/x" ))) ),
        test.case "new makes one without raising it"
            $( test.eq! :not_found (kind (new :not_found "x")) ),

        test.case "message of a string payload has no quotes"
            $( test.eq! "boom" (message (new :error "boom")) ),
        test.case "message of another payload is rendered"
            $( test.eq! ":nope" (message (new :error :nope)) ),
        test.case "describe"     $( test.eq! ":not_found: /tmp/x" (describe (new :not_found "/tmp/x")) ),
        test.case "describe of an empty payload is just the kind"
            $( test.eq! ":stopped" (describe (new :stopped "")) ),

        test.case "an error never raised has no trace"
            $( test.eq! [] (trace! (new :x 1)) ),
        test.case "a raised one names the function it was raised in"
            $( test.true! (list.any (fn at -> at.[1] == "divide" && str.ends_with "error.dr" (at.[2]))
                                    (trace! (caught! $( divide 1 0 )))) ),
        test.case "and the one that made the value being forced"
            $( test.true! (list.any (fn at -> at.[0] == :made)
                                    (trace! (caught! $( divide 1 0 )))) ),
        test.case "a place reads as a line"
            $( test.eq! "in `f` (a.dr:3:1)" (place_line [:in, "f", "a.dr", 3, 1]) ),
        test.case "a place the image does not know reads without one"
            $( test.eq! "forcing a value made in `<thunk>`" (place_line [:made, "<thunk>", "", 0, 0]) ),
    ];
    // Not a wrapper, which a call would be replaced by (see "wrappers" in
    // dreams/scope.dr), so that it has a frame of its own to be named by.
    let divide a b = { let q = a / b; q + 1 };
}

// --- optional types ---------------------------------------------------------

type Error = :error;
type Kind = :atom;
type OfKind expected = :error where fn e -> kind e == expected;
