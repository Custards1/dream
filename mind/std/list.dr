// Lists.
//
// A list is a chain of cells whose head and tail are both lazy, so most of
// what follows works on lists that are never fully built -- `take 5 (from 1)`
// asks for five cells of an infinite list and no more. Functions that must see
// the whole list to answer (`length`, `reverse`, `sort`) say so.

import std.core;

let empty = [];

// --- looking at a list ------------------------------------------------------

let is_empty xs = core.is_empty xs;

/// The first element. Raises on an empty list; `first_or` is the total form.
let head xs = core.head xs;

/// Everything after the first element.
let tail xs = core.tail xs;

/// A new list with `x` on the front. Lazy in both, which is what lets a list
/// be defined in terms of itself.
let cons x xs = core.cons x xs;

let first_or default xs = if core.is_empty xs { default } else { core.head xs };

let rec length_from acc xs =
    if core.is_empty xs { acc } else { length_from (acc + 1) (core.tail xs) };

/// Forces the whole spine, so it does not terminate on an infinite list.
let length xs = length_from 0 xs;

let rec nth n xs =
    if core.is_empty xs { () }
    else if n <= 0 { core.head xs }
    else { nth (n - 1) (core.tail xs) };

let last xs = {
    let rec go xs =
        if core.is_empty (core.tail xs) { core.head xs } else { go (core.tail xs) };
    if core.is_empty xs { () } else { go xs }
};

// --- building ---------------------------------------------------------------

let rec append xs ys =
    if core.is_empty xs { ys } else { core.cons (core.head xs) (append (core.tail xs) ys) };

let rec reverse_from acc xs =
    if core.is_empty xs { acc } else { reverse_from (core.cons (core.head xs) acc) (core.tail xs) };

let reverse xs = reverse_from [] xs;

/// `range 1 4` is `[1, 2, 3]`: the end is not included, so `range 0 (length xs)`
/// indexes a list exactly.
let rec range from until =
    if from >= until { [] } else { core.cons from (range (from + 1) until) };

/// The infinite list `n, n+1, n+2, ...`. Only ever as long as it is used.
let rec from n = core.cons n (from (n + 1));

/// An infinite list of one value.
let rec repeat x = core.cons x (repeat x);

/// `x` repeated `n` times.
let rec replicate n x = if n <= 0 { [] } else { core.cons x (replicate (n - 1) x) };

// --- transforming -----------------------------------------------------------

/// Lazy: the result's tail is not built until it is asked for.
let rec map f xs =
    if core.is_empty xs { [] } else { core.cons (f (core.head xs)) (map f (core.tail xs)) };

let rec filter keep xs =
    if core.is_empty xs { [] }
    else {
        let x = core.head xs;
        let rest = filter keep (core.tail xs);
        if keep x { core.cons x rest } else { rest }
    };

let rec fold f acc xs =
    if core.is_empty xs { acc } else { fold f (f acc (core.head xs)) (core.tail xs) };

let rec fold_right f acc xs =
    if core.is_empty xs { acc } else { f (core.head xs) (fold_right f acc (core.tail xs)) };

let rec take n xs =
    if n <= 0 { [] }
    else if core.is_empty xs { [] }
    else { core.cons (core.head xs) (take (n - 1) (core.tail xs)) };

let rec drop n xs =
    if n <= 0 { xs } else if core.is_empty xs { [] } else { drop (n - 1) (core.tail xs) };

let rec take_while keep xs =
    if core.is_empty xs { [] }
    else if keep (core.head xs) { core.cons (core.head xs) (take_while keep (core.tail xs)) }
    else { [] };

let rec drop_while skip xs =
    if core.is_empty xs { [] }
    else if skip (core.head xs) { drop_while skip (core.tail xs) }
    else { xs };

let rec zip xs ys =
    if core.is_empty xs { [] }
    else if core.is_empty ys { [] }
    else {
        core.cons [core.head xs, core.head ys] (zip (core.tail xs) (core.tail ys))
    };

let rec concat xss =
    if core.is_empty xss { [] } else { append (core.head xss) (concat (core.tail xss)) };

let flat_map f xs = concat (map f xs);

/// Every element with its index, as `[index, element]`.
let enumerate xs = zip (from 0) xs;

// --- asking -----------------------------------------------------------------

let rec any pred xs =
    if core.is_empty xs { false }
    else if pred (core.head xs) { true }
    else { any pred (core.tail xs) };

let rec all pred xs =
    if core.is_empty xs { true }
    else if pred (core.head xs) { all pred (core.tail xs) }
    else { false };

let contains x xs = any (fn y -> y == x) xs;

let count pred xs = fold (fn acc x -> if pred x { acc + 1 } else { acc }) 0 xs;

let rec index_of_from i x xs =
    if core.is_empty xs { 0 - 1 }
    else if core.head xs == x { i }
    else { index_of_from (i + 1) x (core.tail xs) };

/// The index of the first `x`, or -1.
let index_of x xs = index_of_from 0 x xs;

let sum xs = fold (fn a b -> a + b) 0 xs;
let product xs = fold (fn a b -> a * b) 1 xs;

let rec min_by_from best less xs =
    if core.is_empty xs { best }
    else {
        let x = core.head xs;
        let next = if less x best { x } else { best };
        min_by_from next less (core.tail xs)
    };

let minimum xs =
    if core.is_empty xs { () }
    else { min_by_from (core.head xs) (fn a b -> core.compare a b < 0) (core.tail xs) };

let maximum xs =
    if core.is_empty xs { () }
    else { min_by_from (core.head xs) (fn a b -> core.compare a b > 0) (core.tail xs) };

/// The elements that satisfy `pred`, then those that do not.
let partition pred xs = [filter pred xs, filter (fn x -> not (pred x)) xs];

let rec unique_from seen xs =
    if core.is_empty xs { [] }
    else {
        let x = core.head xs;
        let rest = core.tail xs;
        if contains x seen { unique_from seen rest }
        else { core.cons x (unique_from (core.cons x seen) rest) }
    };

/// Keeps the first occurrence of each element.
let unique xs = unique_from [] xs;

// --- ordering ---------------------------------------------------------------

let rec merge_by before xs ys =
    if core.is_empty xs { ys }
    else if core.is_empty ys { xs }
    else {
        let x = core.head xs;
        let y = core.head ys;
        // `before y x` rather than `before x y` keeps the sort stable: equal
        // elements take the one from `xs` first.
        if before y x { core.cons y (merge_by before xs (core.tail ys)) }
        else { core.cons x (merge_by before (core.tail xs) ys) }
    };

let rec sort_by before xs = {
    let n = length xs;
    if n <= 1 { xs }
    else {
        let half = n / 2;
        merge_by before (sort_by before (take half xs)) (sort_by before (drop half xs))
    }
};

/// Ascending, by the runtime's total order over the flat types.
let sort xs = sort_by (fn a b -> core.compare a b < 0) xs;

/// Ascending by a key extracted from each element.
let sort_on key xs = sort_by (fn a b -> core.compare (key a) (key b) < 0) xs;

// --- conversion -------------------------------------------------------------

let to_array xs = core.array_of_list xs;
let of_array a = core.array_to_list a;

/// Force every element. Lists are lazy, so this is the only way to be sure the
/// work has happened -- before a `send!`, say.
let rec force xs =
    if core.is_empty xs { [] }
    else {
        let x = core.head xs;
        // `to_string` forces the element without needing to know its type.
        let _ = to_string x;
        core.cons x (force (core.tail xs))
    };

// --- tests ------------------------------------------------------------------
//
// Compiled only by `dawnc --test`, which builds an entry point that runs the
// `tests` every loaded module exports.

when test {
    import std.test;

    let tests = [
        test.case "length of empty"     $( test.eq! 0 (length []) ),
        test.case "length"              $( test.eq! 3 (length [1, 2, 3]) ),
        test.case "head"                $( test.eq! 1 (head [1, 2, 3]) ),
        test.case "head of empty raises" $( test.raises! $( head [] ) ),
        test.case "tail"                $( test.eq! [2, 3] (tail [1, 2, 3]) ),
        test.case "first_or on empty"   $( test.eq! :none (first_or :none []) ),
        test.case "first_or"            $( test.eq! 1 (first_or :none [1]) ),
        test.case "nth"                 $( test.eq! 3 (nth 2 [1, 2, 3]) ),
        test.case "nth past the end"    $( test.eq! () (nth 9 [1, 2, 3]) ),
        test.case "last"                $( test.eq! 3 (last [1, 2, 3]) ),

        test.case "append"              $( test.eq! [1, 2, 3] (append [1] [2, 3]) ),
        test.case "append to empty"     $( test.eq! [1] (append [] [1]) ),
        test.case "reverse"             $( test.eq! [3, 2, 1] (reverse [1, 2, 3]) ),
        test.case "reverse of empty"    $( test.empty! (reverse []) ),
        test.case "range"               $( test.eq! [1, 2, 3] (range 1 4) ),
        test.case "empty range"         $( test.empty! (range 3 3) ),
        test.case "replicate"           $( test.eq! [:x, :x] (replicate 2 :x) ),

        test.case "map"                 $( test.eq! [2, 4] (map (fn x -> x * 2) [1, 2]) ),
        test.case "map over empty"      $( test.empty! (map (fn x -> x) []) ),
        test.case "filter"              $( test.eq! [2, 4] (filter (fn x -> x % 2 == 0) [1,2,3,4]) ),
        test.case "fold"                $( test.eq! 10 (fold (fn a b -> a + b) 0 [1,2,3,4]) ),
        test.case "fold is left to right"
            $( test.eq! "abc" (fold (fn a b -> a + b) "" ["a", "b", "c"]) ),
        test.case "fold_right"
            $( test.eq! "abc" (fold_right (fn x acc -> x + acc) "" ["a", "b", "c"]) ),
        test.case "take"                $( test.eq! [1, 2] (take 2 [1, 2, 3]) ),
        test.case "take more than there is" $( test.eq! [1] (take 5 [1]) ),
        test.case "drop"                $( test.eq! [3] (drop 2 [1, 2, 3]) ),
        test.case "drop more than there is" $( test.empty! (drop 5 [1]) ),
        test.case "take_while"          $( test.eq! [1, 2] (take_while (fn x -> x < 3) [1,2,3,1]) ),
        test.case "drop_while"          $( test.eq! [3, 1] (drop_while (fn x -> x < 3) [1,2,3,1]) ),
        test.case "zip"                 $( test.eq! [[1, :a], [2, :b]] (zip [1,2,3] [:a,:b]) ),
        test.case "concat"              $( test.eq! [1, 2, 3] (concat [[1], [], [2, 3]]) ),
        test.case "flat_map"            $( test.eq! [1, 1, 2, 2] (flat_map (fn x -> [x, x]) [1, 2]) ),
        test.case "enumerate"           $( test.eq! [[0, :a], [1, :b]] (enumerate [:a, :b]) ),

        test.case "any"                 $( test.true! (any (fn x -> x > 2) [1, 3]) ),
        test.case "any on empty"        $( test.false! (any (fn x -> true) []) ),
        test.case "all"                 $( test.true! (all (fn x -> x > 0) [1, 2]) ),
        test.case "all on empty"        $( test.true! (all (fn x -> false) []) ),
        test.case "contains"            $( test.true! (contains 2 [1, 2]) ),
        test.case "count"               $( test.eq! 2 (count (fn x -> x > 1) [1, 2, 3]) ),
        test.case "index_of"            $( test.eq! 1 (index_of :b [:a, :b]) ),
        test.case "index_of missing"    $( test.eq! (0 - 1) (index_of :z [:a]) ),
        test.case "sum"                 $( test.eq! 6 (sum [1, 2, 3]) ),
        test.case "sum of empty"        $( test.eq! 0 (sum []) ),
        test.case "product"             $( test.eq! 24 (product [1, 2, 3, 4]) ),
        test.case "minimum"             $( test.eq! 1 (minimum [3, 1, 2]) ),
        test.case "maximum"             $( test.eq! 3 (maximum [3, 1, 2]) ),
        test.case "partition"           $( test.eq! [[2], [1, 3]] (partition (fn x -> x % 2 == 0) [1,2,3]) ),
        test.case "unique"              $( test.eq! [1, 2, 3] (unique [1, 2, 1, 3, 2]) ),

        test.case "sort"                $( test.eq! [1, 2, 3] (sort [3, 1, 2]) ),
        test.case "sort is stable"
            $( test.eq! [[1, :a], [1, :b]] (sort_on (fn p -> head p) [[1, :a], [1, :b]]) ),
        test.case "sort strings"        $( test.eq! ["a", "b"] (sort ["b", "a"]) ),
        test.case "sort of empty"       $( test.empty! (sort []) ),
        test.case "sort_by descending"
            $( test.eq! [3, 2, 1] (sort_by (fn a b -> a > b) [1, 3, 2]) ),

        test.case "to_array and back"   $( test.eq! [1, 2] (of_array (to_array [1, 2])) ),

        // Laziness is a property worth testing directly: each of these would
        // not terminate if the list were built eagerly.
        test.case "take from an infinite list"  $( test.eq! [0, 1, 2] (take 3 (from 0)) ),
        test.case "map over an infinite list"   $( test.eq! [0, 2, 4] (take 3 (map (fn x -> x * 2) (from 0))) ),
        test.case "filter an infinite list"     $( test.eq! [0, 2, 4] (take 3 (filter (fn x -> x % 2 == 0) (from 0))) ),
        test.case "take_while on an infinite list" $( test.eq! [0, 1] (take_while (fn x -> x < 2) (from 0)) ),
        test.case "repeat is infinite"          $( test.eq! [:x, :x] (take 2 (repeat :x)) ),
        test.case "zip stops at the shorter"    $( test.eq! [[1, 0]] (zip [1] (from 0)) ),
    ];
}
