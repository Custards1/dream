// Machine learning: models built from layers, trained by gradient descent,
// on the GPU when there is one and it is worth it.
//
//     import std.ml;
//     import std.ml.data;
//     import std.ml.nn;
//     import std.ml.optim;
//
//     let ds = data.spirals 1 200 3;                       // 600 points, 3 classes
//     let [train, test] = data.split 0.8 7 ds;
//     let model = nn.sequential [nn.dense 64, nn.relu, nn.dense 64, nn.relu, nn.dense 3];
//     let fitted = ml.fit! model train %{
//         :loss => :cross_entropy, :optimizer => optim.adam 0.01,
//         :epochs => 50, :batch => 32, :metrics => [:accuracy], :validation => test,
//     };
//     ml.evaluate fitted test                  // %{"loss" => 0.08, "accuracy" => 0.97}
//     ml.classify fitted (data.x test)         // the predicted class of each row
//     ml.save! "spirals.model" (ml.params fitted)
//
// prints, an epoch a line:
//
//     epoch  1/50  loss 1.0712  accuracy 0.4167  val_loss 1.0244  val_accuracy 0.5250  0.04s
//     ...
//
// **The pieces are separate modules**, each usable alone: `std.ml.ad`
// (gradients of any function of tensors), `std.ml.nn` (layers and models),
// `std.ml.loss`, `std.ml.optim` (optimizers and learning-rate schedules),
// `std.ml.metrics`, `std.ml.data` (datasets, scaling, CSV) and
// `std.ml.init`. This module is the loop that joins them, and the
// conveniences that need all of them: `fit!`, `predict`, `evaluate`,
// `save!`, `load!`. A training loop of your own is `step` in a recursion.
//
// **Where it runs.** `fit!` takes `:device` -- `:gpu`, `:host`, or `:auto`,
// the default, which trains on the GPU when one is available and a step is
// large enough to repay it: when the parameters times the batch size come to
// four million or more (a 64 x 256 x 256 network at a batch of 64 is about
// that). Below it, launching kernels costs more than the arithmetic, and the
// host's vectorized kernels win. On the GPU, the parameters, the optimizer's
// state and the dataset (if it is under a gigabyte) are moved there once,
// and every step -- forward, backward, update, shuffle -- runs there;
// what comes back each step is the loss, one number. The trained parameters
// stay where they were trained, and `predict` moves its input to them.
//
// **Each step is forced** (`strict!`) once its parameters and state are
// made, so that the deferred tensors `std.tensor` builds are computed once,
// fused, and the next step starts from numbers rather than from a program
// that still refers to the step before.

import std.console;
import std.error;
import std.file;
import std.list;
import std.map;
import std.math;
import std.atom;
import std.ml.ad;
import std.ml.data;
import std.ml.init;
import std.ml.loss;
import std.ml.metrics;
import std.ml.nn;
import std.ml.ops;
import std.ml.optim;
import std.ml.tree;
import std.num;
import std.str;
import std.tensor;
import std.time;

/// A trained model: the model, its parameters (on the device it was trained
/// on), the loss it was trained with, the metrics it reports, and a map per
/// epoch of what was measured.
mapping Fitted {
    model : :any
    params : :any
    loss : :any
    metrics : [:any] = []
    history : [:any] = []
    device : :atom = :host
}

/// The trained parameters, on the host.
let params : Fitted -> :any;
let params f = tree.host (Fitted.params f);

/// What was measured each epoch: a map per epoch with `"epoch"`, `"loss"`,
/// `"seconds"`, each metric by name (`"accuracy"`), and `"val_loss"` and the
/// `"val_"` metrics when there was a validation set.
let history : Fitted -> [:any];
let history f = Fitted.history f;

// --- training ------------------------------------------------------------------------------

/// One step of training: the loss, the model's output on the batch, and the
/// parameters and optimizer state after the step. `ctx` is the training
/// context (`nn.training seed step`). Pure; a loop forces what it keeps.
let step : nn.Layer -> (:any -> :any -> :any) -> optim.Optimizer -> :any -> :any -> :any -> :any -> nn.Ctx -> [:any, :any, :any, :any];
let step model loss_fn opt params state x y ctx = {
    let [l, grads, out] = ad.value_grad_aux (fn q -> {
        let out = nn.forward model q x ctx;
        [loss_fn out y, out]
    }) params;
    let [p2, s2] = optim.step opt grads state params;
    [l, out, p2, s2]
};

/// The device `:auto` chooses for training `params` in batches of `batch`.
let auto_device : :any -> :integer -> :atom;
let auto_device params batch =
    if tensor.gpu_available () && tree.size params * batch >= 4194304 { :gpu } else { :host };

/// The metric function for `name` when the model is trained with `loss_name`:
/// accuracy of a binary cross-entropy model reads its logits at 0.
/// A metric is a name `metrics.of` knows, a function, or `[name, function]`
/// for a function of your own that should be reported by name.
priv let metric_fn : :any -> :any -> (:tensor -> :any -> :float);
priv let metric_fn loss_name m = match m {
    :accuracy => if loss_name == :binary_cross_entropy { metrics.binary_accuracy 0.0 } else { metrics.accuracy },
    [_, f] => f,
    _ => metrics.of m,
};

priv let metric_name : :any -> :string;
priv let metric_name m = match type_of m {
    :atom => atom_text m,
    :list => m.[0],
    _ => "metric",
};

priv let atom_text : :atom -> :string;
priv let atom_text a = str.slice 1 (str.length (to_string a) - 1) (to_string a);

/// Train `model` on `ds`. Options, all optional:
///
/// | key | default | |
/// |---|---|---|
/// | `:loss` | `:mse` | a name `loss.of` knows, or a function |
/// | `:optimizer` | `optim.adam 0.001` | |
/// | `:epochs` | 10 | passes over the data |
/// | `:batch` | 32 | examples per step |
/// | `:metrics` | `[]` | names `metrics.of` knows, functions, or `[name, function]` |
/// | `:validation` | none | a dataset scored after each epoch |
/// | `:patience` | none | stop after this many epochs without a better validation loss (or training loss, with no validation set), and keep the best parameters |
/// | `:seed` | 0 | initial weights, shuffling and dropout |
/// | `:shuffle` | `true` | a new order each epoch |
/// | `:params` | fresh | parameters to start from, to resume or fine-tune |
/// | `:device` | `:auto` | `:gpu`, `:host`, or `:auto` (see the head of this file) |
/// | `:verbose` | `true` | print a line per epoch |
let fit! : nn.Layer -> data.Dataset -> %{:atom => :any} -> Fitted;
let fit! model ds opts = join! (spawn! (training! model ds opts));

/// Training, as the thunk of a process of its own.
///
/// **Why a process.** A collection can only run where every C++ frame above
/// the running code has vouched for its locals ("The GC vouching rule"), and a
/// value forced from inside a native -- `console.print! [name, ml.fit! ..]`,
/// where the printer forces the list -- runs with no such vouch: nothing it
/// allocates can be collected until it returns. Training allocates a
/// gigabyte a second on the GPU, and under such a caller an 8 GB card was
/// full within a few hundred steps with no collection having run. A new
/// process starts from the scheduler with nothing above it, so it collects
/// wherever it was called from; what crosses is the dataset (a `memcpy` per
/// tensor, a shared buffer for a GPU one) and, on the way back, the result.
/// `join!` re-raises a failure, so the caller sees what it would have seen.
///
/// Made in a function of its own so the suspension carries only these
/// three values, not the caller's frame.
priv let training! : nn.Layer -> data.Dataset -> %{:atom => :any} -> :any;
priv let training! model ds opts = $( guarded_train! model ds opts );

priv let guarded_train! : nn.Layer -> data.Dataset -> %{:atom => :any} -> Fitted;
priv let guarded_train! model ds opts = try! { train! model ds opts } catch e {
    // A model too large for the process's heap fails deep inside a step,
    // where the error says nothing about why. It is said here, with what to
    // do about it.
    if error.kind e == :out_of_memory {
        error.raise_as! :out_of_memory ("this model needs more than one process's heap allows ("
            + to_string (error.payload e) + "): training holds the parameters, the gradient and the "
            + "optimizer's state, twice over while a step replaces them, as doubles on the host. Raise the "
            + "limit with DREAM_MAX_HEAP, or train on the GPU (`:device => :gpu`), whose memory it does not count")
    } else { error.rethrow! e }
};

priv let train! : nn.Layer -> data.Dataset -> %{:atom => :any} -> Fitted;
priv let train! model ds opts = {
    let n = data.size ds;
    if n != ops.rows (data.y ds) {
        raise! ("fit! needs a target per example, but there are " + to_string n + " rows of x and "
                + to_string (ops.rows (data.y ds)) + " of y")
    }
    let loss_name = opts.[:loss else :mse];
    let loss_fn = loss.of loss_name;
    let opt = opts.[:optimizer else optim.adam 0.001];
    let epochs = opts.[:epochs else 10];
    let batch = if opts.[:batch else 32] > n { n } else { opts.[:batch else 32] };
    let seed = opts.[:seed else 0];
    let wanted = opts.[:metrics else []];
    let measures = list.map (fn m -> [metric_name m, metric_fn loss_name m]) wanted;
    let verbose = opts.[:verbose else true];
    let shuffle = opts.[:shuffle else true];
    let patience = opts.[:patience else ()];
    let start_params = opts.[:params else nn.init model seed (data.example_shape ds)];
    let device = match opts.[:device else :auto] {
        :auto => auto_device start_params batch,
        :gpu => if tensor.gpu_available () { :gpu } else { raise! "fit! was asked for the GPU, but none is available" },
        d => d,
    };
    let on_gpu = device == :gpu;
    // The dataset goes to the GPU whole when it is small enough to; a larger
    // one is batched on the host and each batch moved.
    let whole = on_gpu && (tensor.size (data.x ds) + tensor.size (data.y ds)) * 4 < 1073741824;
    let train = if whole { data.to_gpu ds } else { ds };
    let place t = if on_gpu && not whole { tensor.gpu t } else { t };
    let validation = match opts.[:validation else ()] { () => (), v => if on_gpu { data.to_gpu v } else { v } };
    let params0 = if on_gpu { tree.gpu start_params } else { start_params };
    let state0 = optim.start opt params0;
    strict! params0
    strict! state0

    // One epoch: every batch once, in `order`. Answers the parameters, the
    // state, the step count after it, and the sums of the loss and of each
    // metric, weighted by batch size.
    let run_epoch! e p s t0 = {
        let order = if shuffle { ops.permutation (init.seed_for seed e) n } else { list.range 0 n };
        let rec go! idx p s !t !loss_sum sums = match idx {
            [] => [p, s, t, loss_sum, sums],
            _ => {
                let chunk = list.take batch idx;
                let k = len chunk;
                let xb = place (if shuffle { tensor.take chunk (data.x train) } else { tensor.slice (list.head chunk) k (data.x train) });
                let yb = place (if shuffle { tensor.take chunk (data.y train) } else { tensor.slice (list.head chunk) k (data.y train) });
                let [l, out, p2, s2] = step model loss_fn opt p s xb yb (nn.training seed t);
                strict! p2
                strict! s2
                let scored = list.map (fn [[_, f], acc] -> acc + k * f out yb) (list.zip measures sums);
                strict! scored
                go! (list.drop batch idx) p2 s2 (t + 1) (loss_sum + k * l) scored
            },
        };
        go! order p s t0 0.0 (list.map (fn _ -> 0.0) measures)
    };

    let rec epochs! e p s t best stale log = {
        if e == epochs { [p, log, best] }
        else {
            let began = time.monotonic! ();
            let [p2, s2, t2, loss_sum, sums] = run_epoch! e p s t;
            let seconds = (time.monotonic! () - began) / 1.0e9;
            let row0 = %{"epoch" => e + 1, "loss" => loss_sum / n, "seconds" => seconds};
            let row1 = list.fold (fn r [[name, _], total] -> r.[name => total / n]) row0 (list.zip measures sums);
            let row = match validation {
                () => row1,
                v => {
                    let scores = evaluate_with model p2 loss_fn measures batch v;
                    list.fold (fn r [k, x] -> r.["val_" + k => x]) row1 (map.pairs scores)
                },
            };
            if verbose { console.print! (describe_epoch (e + 1) epochs row (list.map (fn [name, _] -> name) measures)) }
            let watched = row.["val_loss" else row.["loss"]];
            let improved = best == () || watched < best.[0];
            let best2 = if improved { [watched, p2] } else { best };
            let stale2 = if improved { 0 } else { stale + 1 };
            if patience != () && stale2 >= patience {
                if verbose { console.print! ("stopping: no improvement in " + to_string patience + " epochs") }
                [p2, row :: log, best2]
            } else { epochs! (e + 1) p2 s2 t2 best2 stale2 (row :: log) }
        }
    };

    let [last, log, best] = epochs! 0 params0 state0 0 () 0 [];
    let kept = if patience != () && best != () { best.[1] } else { last };
    Fitted.make model kept loss_name wanted (list.reverse log) device
};

/// The line `fit!` prints for an epoch.
priv let describe_epoch : :integer -> :integer -> %{:string => :any} -> [:string] -> :string;
priv let describe_epoch e epochs row names = {
    let width = str.length (to_string epochs);
    let num_text x = fixed 4 x;
    let shown = ["loss"] + names + (if row.["val_loss" else ()] == () { [] } else { ["val_loss"] + list.map (fn name -> "val_" + name) names });
    let pairs = list.map (fn k -> [k, row.[k]]) shown;
    "epoch " + str.repeat (width - str.length (to_string e)) " " + to_string e + "/" + to_string epochs
        + str.concat_all (list.map (fn [k, v] -> "  " + k + " " + num_text v) pairs)
        + "  " + fixed 2 row.["seconds"] + "s"
};

/// A number with `digits` digits after the point: `fixed 2 3.14159` is
/// `"3.14"`. Not a number, an infinity, or a magnitude past 1e15 prints as
/// `to_string` prints it.
let fixed : :integer -> :any -> :string;
let fixed digits x = {
    let f = 1.0 * x;
    if f != f || math.abs f > 1.0e15 { to_string f }
    else {
        let scale = list.fold_strict (fn !acc _ -> acc * 10) 1 (list.range 0 digits);
        let whole = math.floor (math.abs f * scale + 0.5);
        let int_part = whole / scale;
        let frac = to_string (whole % scale);
        let sign = if f < 0.0 && whole > 0 { "-" } else { "" };
        if digits == 0 { sign + to_string int_part }
        else { sign + to_string int_part + "." + str.repeat (digits - str.length frac) "0" + frac }
    }
};

// --- using a model -----------------------------------------------------------------------------

/// The model's output for inputs `x`, as a host tensor. `x` may be a tensor
/// or nested lists; it is moved to where the parameters are.
let predict : Fitted -> :any -> :tensor;
let predict f x = predict_with (Fitted.model f) (Fitted.params f) x;

/// `predict` for a model and parameters given separately.
let predict_with : nn.Layer -> :any -> :any -> :tensor;
let predict_with model p x = {
    let t = if type_of x == :tensor { x } else { tensor.of_list x };
    let first = list.head (tree.leaves p);
    let placed = if type_of first == :tensor { ops.like first t } else { t };
    tensor.host (nn.apply model p placed)
};

/// The predicted class of each row of `x`: the column with the largest
/// output, or, for a model with one output, 1 where it is positive.
let classify : Fitted -> :any -> [:integer];
let classify f x = {
    let out = predict f x;
    let classes = if (tensor.shape out).[tensor.rank out - 1] == 1 || tensor.rank out == 1 {
        let cut = if Fitted.loss f == :binary_cross_entropy { 0.0 } else { 0.5 };
        tensor.gt (tensor.reshape [tensor.size out] out) cut
    } else { metrics.classes_of out };
    list.map num.to_int (tensor.to_list classes)
};

/// Each row's output as probabilities: the softmax of a classifier's logits,
/// or the sigmoid of a binary one's.
let probabilities : Fitted -> :any -> :tensor;
let probabilities f x = {
    let out = predict f x;
    if (tensor.shape out).[tensor.rank out - 1] == 1 || tensor.rank out == 1 { tensor.sigmoid out } else { ops.softmax out }
};

/// The loss and every metric the model was trained with, on `ds`, as a map
/// keyed by name (`"loss"`, `"accuracy"`, ..).
let evaluate : Fitted -> data.Dataset -> %{:string => :float};
let evaluate f ds = {
    let loss_name = Fitted.loss f;
    let measures = list.map (fn m -> [metric_name m, metric_fn loss_name m]) (Fitted.metrics f);
    let first = list.head (tree.leaves (Fitted.params f));
    let placed = if type_of first == :tensor && tensor.device first == :gpu { data.to_gpu ds } else { ds };
    evaluate_with (Fitted.model f) (Fitted.params f) (loss.of loss_name) measures 256 placed
};

/// The loss and metrics of `model` with `p` over `ds`, a batch of `batch` at
/// a time, each weighted by its size.
priv let evaluate_with : nn.Layer -> :any -> :any -> [:any] -> :integer -> data.Dataset -> %{:string => :float};
priv let evaluate_with model p loss_fn measures batch ds = {
    let n = data.size ds;
    let totals = list.fold (fn acc b -> {
        let k = data.size b;
        let out = nn.apply model p (data.x b);
        let l = loss_fn out (data.y b);
        list.map (fn [a, v] -> a + k * v) (list.zip acc (l :: list.map (fn [_, f] -> f out (data.y b)) measures))
    }) (list.map (fn _ -> 0.0) (0 :: measures)) (data.batches batch ds);
    let names = "loss" :: list.map (fn [name, _] -> name) measures;
    map.from_pairs (list.map (fn [k, v] -> [k, v / n]) (list.zip names totals))
};

/// `model`'s parameters, as a table to print: each layer, what it outputs
/// and how many numbers it learns.
let summary : nn.Layer -> [:integer] -> :string;
let summary model shape = nn.summary model shape;

// --- saving -------------------------------------------------------------------------------------

/// Write a tree of parameters -- a model's, an optimizer's state, a scaler --
/// to `path`. Each tensor is written exactly (`tensor.to_bytes`), from
/// wherever it is; `load!` reads it back onto the host.
///
/// The format is a line `dream-ml 1`, then for each tensor or number a line
/// naming where it is in the tree and its shape, followed by its bytes.
let save! : :string -> :any -> :unit;
let save! path t = {
    let piece [p, x] = {
        let v = if type_of x == :tensor { tensor.host x } else { tensor.of_list [1.0 * x] };
        let kind = if type_of x == :tensor { "t" } else { "n" };
        kind + " " + str.join_str "\u{1f}" (list.map key_text p) + "\t"
            + str.join_str "," (list.map to_string (tensor.shape v)) + "\n" + tensor.to_bytes v
    };
    file.write! path ("dream-ml 1\n" + str.concat_all (list.map piece (tree.paths t)))
};

priv let key_text : :any -> :string;
priv let key_text k = match type_of k {
    :integer => "#" + to_string k,
    :atom => ":" + atom_text k,
    _ => "=" + k,
};

priv let key_of : :string -> :any;
priv let key_of text = {
    let body = str.slice 1 (str.length text - 1) text;
    match str.slice 0 1 text {
        "#" => int_of body,
        ":" => match atom.existing body { () => body, a => a },
        _ => body,
    }
};

/// A whole number written in `text`, or 0 when it is not one.
priv let int_of : :string -> :integer;
priv let int_of text = match num.parse_int text { () => 0, n => n };

/// The tree `save!` wrote to `path`, its tensors on the host. Lists come back
/// as lists and maps as maps; an array written comes back a list.
let load! : :string -> :any;
let load! path = match file.read! path {
    () => raise! ("cannot read " + path),
    text => match parse_saved text {
        [:ok, t] => t,
        [:error, why] => raise! (path + ": " + why),
    },
};

/// The tree in text `save!` wrote: `[:ok, tree]` or `[:error, why]`.
let parse_saved : :string -> [:ok, :any] | [:error, :string];
let parse_saved text =
    if not (str.starts_with "dream-ml 1\n" text) { [:error, "not a file save! wrote"] }
    else {
        let total = str.byte_length text;
        let rec read at acc = if at >= total { [:ok, build (list.reverse acc)] } else {
            let eol = str.find_from at "\n" text;
            let header = str.slice at (eol - at) text;
            let tab = str.find "\t" header;
            let kind = str.slice 0 1 header;
            let keys = str.slice 2 (tab - 2) header;
            let shape = list.map int_of (str.split "," (str.slice (tab + 1) (str.length header - tab - 1) header));
            let count = list.fold_strict (fn !a b -> a * b) 1 shape;
            let bytes = str.slice (eol + 1) (count * 8) text;
            let t = tensor.of_bytes shape bytes;
            let leaf = if kind == "n" { tensor.sum t } else { t };
            let path = if str.is_empty keys { [] } else { list.map key_of (str.split "\u{1f}" keys) };
            read (eol + 1 + count * 8) ([path, leaf] :: acc)
        };
        read 11 []
    };

/// A tree from its leaves and their paths: a branch whose keys are integers
/// is a list, in order; any other a map.
priv let build : [[[:any], :any]] -> :any;
priv let build pairs = match pairs {
    [[[], leaf]] => leaf,
    _ => {
        let firsts = list.unique (list.map (fn [p, _] -> list.head p) pairs);
        let child k = build (list.map (fn [p, x] -> [list.tail p, x]) (list.filter (fn [p, _] -> list.head p == k) pairs));
        if list.all (fn k -> type_of k == :integer) firsts {
            list.map child (list.sort firsts)
        } else {
            map.from_pairs (list.map (fn k -> [k, child k]) firsts)
        }
    },
};

when test {
    import std.test;

    let tests = [
        test.case "fixed" $( test.eq! ["3.14", "-0.50", "2", "0.0010", "10.00"] [fixed 2 3.14159, fixed 2 (-0.5), fixed 0 1.6, fixed 4 0.001, fixed 2 9.999] ),
        test.case "a saved tree reads back"
            $( test.true! ({
                let t = [%{"w" => tensor.random 1 [3, 2], "b" => tensor.of_list [0.1, 0.2]}, %{:shift => tensor.of_list [1, 2]}, 2.5];
                let back = parse_saved ("dream-ml 1\n" + str.concat_all (list.map (fn [p, x] -> {
                    let v = if type_of x == :tensor { x } else { tensor.of_list [1.0 * x] };
                    (if type_of x == :tensor { "t " } else { "n " }) + str.join_str "\u{1f}" (list.map key_text p) + "\t"
                        + str.join_str "," (list.map to_string (tensor.shape v)) + "\n" + tensor.to_bytes v
                }) (tree.paths t)));
                back == [:ok, t]
            }) ),
        test.case "auto picks the host for a small model" $( test.eq! :host (auto_device [tensor.zeros [10]] 32) ),
    ];
}
