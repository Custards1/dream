// HTTP: requests and responses, the HTTP/1.1 wire format, and a client.
//
//     import std.http;
//
//     http.get_text! "https://example.com/"                  // [:ok, "<!doctype html>.."]
//     http.get_json! "https://api.example.com/users/1"       // [:ok, %{ "name" => "Ada", .. }]
//
//     let? resp = http.request "POST" "https://api.example.com/users"
//         |> http.with_json %{ "name" => "Ada" }
//         |> http.with_bearer token
//         |> http.with_timeout (time.seconds 5)
//         |> http.send!;
//     http.status resp                                        // 201
//     http.header "location" resp                             // "/users/7"
//
// and a server is `std.http.server`, which answers the same `Request` with
// the same `Response`:
//
//     server.serve! 8080 (fn req -> http.text ("hello, " + http.query_value "name" req))
//
// **A message is a record.** `Request` and `Response` are `mapping`s, so a
// handler is an ordinary function from one map to another, a test builds a
// request with `http.request` and calls the handler with no socket in sight,
// and middleware is a function from handler to handler. Headers are a list
// of `[name, value]` pairs with the names in lower case, kept in order and
// with repeats -- `Set-Cookie` is the header that is legitimately repeated --
// and every function that reads one is case-insensitive, as HTTP is.
//
// **Bodies are strings**, which in Dream are bytes, so a body is whatever was
// sent, text or not. `json`, `with_json` and `body_json` are the conversions
// most programs want.
//
// **Every way a request can fail is a value.** `send!` and the helpers answer
// `[:ok, response]` or `[:error, e]`, where `e` is an error value whose
// `error.kind` says what kind of failure it was -- `:timeout`,
// `:connection_refused`, `:certificate_untrusted`, `:bad_response`,
// `:too_many_redirects`, `:bad_url`, `:status` (from `expect_ok`) -- so a
// program can retry one and report another, and `let?` chains them. A 404 is
// a response, not an error: the server answered. `get_text!` and `get_json!`
// are the exceptions, for the common case where anything but a 2xx is a
// failure.
//
// **The client speaks HTTP/1.1 and HTTP/2** over `std.net`, and `https`
// through `std.tls` with the system's roots and the host name checked; a
// server that agrees to `h2` in the handshake gets HTTP/2 (`std.http.h2`).
// `send!` makes one connection per request; a `Client` (`client_with!`)
// keeps them, lending each HTTP/1.1 connection to one request at a time and
// sharing one HTTP/2 connection among every request to its host at once.
// Each exchange runs in a process of its own so a timeout covers everything
// -- the DNS lookup, the handshake, a server that sends one byte a minute --
// and a stuck exchange costs the caller only the timeout. Redirects are
// followed (up to 10 by default) the way browsers follow them, and the
// response says the URL it finally came from. `stream!` and `download!`
// take a body a piece at a time, and `with_stream` sends one that way.

import std.crypto;
import std.error;
import std.io;
import std.json;
import std.list;
import std.map;
import std.net;
import std.num;
import std.result;
import std.str;
import std.streams;
import std.time;
import std.tls;
import std.http.url;
import std.http.reader as rd;
import std.http.stream as st;
import std.http.pool as connections;
import std.http.h2;

// --- messages ---------------------------------------------------------------------

/// A request. `stream`, when it is not `()`, is a body that arrives in pieces
/// rather than as `body` (see "Streams" below). On the client, `url` is the
/// absolute URL to send it to, and
/// `options` holds how (`:timeout`, `:redirects`, `:tls`). On a server, `url`
/// is the target as the client wrote it (`/a/b?c=d`), `path` and `query` are
/// it taken apart, `peer` is who sent it, and `params` are what a router
/// read out of the path. `context` is for middleware to hand things on to
/// the handler.
mapping Request {
    method : :string = "GET"
    url : :string = "/"
    path : :string = "/"
    query : :map = %{}
    headers : [[:string]] = []
    body : :string = ""
    version : :string = "HTTP/1.1"
    params : :map = %{}
    peer : :string = ""
    options : :map = %{}
    context : :map = %{}
    stream : :any = ()
}

/// A response. On the client, `url` is where it came from after redirects;
/// `stream` is a body sent in pieces as they are made, rather than `body`.
/// `upgrade`, on a server's 101, is what takes the connection over once the
/// response is sent: a function of the socket and the reader holding what
/// has been read past the request (see `std.http.websocket`).
mapping Response {
    status : :integer = 200
    headers : [[:string]] = []
    body : :string = ""
    url : :string = ""
    stream : :any = ()
    upgrade : :any = ()
}

/// Every reason phrase RFC 9110 registers, and a few that are in common use.
let reason : :integer -> :string;
let reason status = match status {
    100 => "Continue", 101 => "Switching Protocols", 103 => "Early Hints",
    200 => "OK", 201 => "Created", 202 => "Accepted", 203 => "Non-Authoritative Information", 204 => "No Content",
    205 => "Reset Content", 206 => "Partial Content",
    300 => "Multiple Choices", 301 => "Moved Permanently", 302 => "Found", 303 => "See Other", 304 => "Not Modified",
    307 => "Temporary Redirect", 308 => "Permanent Redirect",
    400 => "Bad Request", 401 => "Unauthorized", 402 => "Payment Required", 403 => "Forbidden", 404 => "Not Found",
    405 => "Method Not Allowed", 406 => "Not Acceptable", 407 => "Proxy Authentication Required", 408 => "Request Timeout",
    409 => "Conflict", 410 => "Gone", 411 => "Length Required", 412 => "Precondition Failed", 413 => "Content Too Large",
    414 => "URI Too Long", 415 => "Unsupported Media Type", 416 => "Range Not Satisfiable", 417 => "Expectation Failed",
    418 => "I'm a teapot", 421 => "Misdirected Request", 422 => "Unprocessable Content", 425 => "Too Early",
    426 => "Upgrade Required", 428 => "Precondition Required", 429 => "Too Many Requests",
    431 => "Request Header Fields Too Large", 451 => "Unavailable For Legal Reasons",
    500 => "Internal Server Error", 501 => "Not Implemented", 502 => "Bad Gateway", 503 => "Service Unavailable",
    504 => "Gateway Timeout", 505 => "HTTP Version Not Supported",
    _ => if status < 200 { "Informational" } else if status < 300 { "Success" } else if status < 400 { "Redirection" }
         else if status < 500 { "Client Error" } else { "Server Error" },
};

// --- headers ------------------------------------------------------------------------
//
// These work on a request and a response alike: both keep their headers
// under `:headers`.

/// The first value of a header, or `()`.
let header : :string -> :map -> (:string | :unit);
let header name msg = {
    let key = str.lower name;
    match list.filter (fn [k, _] -> k == key) (msg.[:headers else []]) { [] => (), [[_, v], .._] => v }
};

/// Every value of a header, in order.
let header_all : :string -> :map -> [:string];
let header_all name msg = { let key = str.lower name; list.map (fn [_, v] -> v) (list.filter (fn [k, _] -> k == key) (msg.[:headers else []])) };

/// The message with this header set, replacing any it had.
let with_header : :string -> :any -> :map -> :map;
let with_header name value msg = {
    let key = str.lower name;
    msg.[:headers => list.filter (fn [k, _] -> k != key) (msg.[:headers else []]) + [[key, header_value value]]]
};

/// The message with this header added after any it had.
let add_header : :string -> :any -> :map -> :map;
let add_header name value msg = msg.[:headers => msg.[:headers else []] + [[str.lower name, header_value value]]];

/// The message without this header.
let without_header : :string -> :map -> :map;
let without_header name msg = { let key = str.lower name; msg.[:headers => list.filter (fn [k, _] -> k != key) (msg.[:headers else []])] };

/// Several headers set at once, from pairs or a map.
let with_headers : :any -> :map -> :map;
let with_headers pairs msg = {
    let ps = if type_of pairs == :map { map.pairs pairs } else { pairs };
    list.fold (fn m [k, v] -> with_header (text_of k) v m) msg ps
};

/// A header's value as text, with any line break taken out: a value with
/// `\r\n` in it would let whoever chose it write headers of their own.
priv let header_value : :any -> :string;
priv let header_value v = str.filter (fn c -> c != '\r' && c != '\n') (text_of v);

priv let text_of : :any -> :string;
priv let text_of v = match type_of v { :string => v, :atom => str.slice 1 (len (to_string v)) (to_string v), _ => to_string v };

/// The media type, without its parameters and in lower case:
/// `application/json` for `Application/JSON; charset=utf-8`.
let content_type : :map -> (:string | :unit);
let content_type msg = match header "content-type" msg {
    () => (),
    v => str.lower (str.trim (str.slice 0 (str.upto ";" 0 v) v)),
};

// --- reading messages ---------------------------------------------------------------

let status : :map -> :integer;
let status resp = Response.status resp;

let body : :map -> :string;
let body msg = msg.[:body else ""];

/// Whether the status is 2xx.
let is_success : :map -> :bool;
let is_success resp = Response.status resp >= 200 && Response.status resp < 300;

/// The body decoded as JSON.
let body_json : :map -> result.Of :any :string;
let body_json msg = json.decode (body msg);

/// The body decoded as a form (`a=1&b=2`), the first value of each name.
let body_form : :map -> :map;
let body_form msg = list.fold (fn m [k, v] -> if map.has k m { m } else { m.[k => v] }) %{} (url.decode_query (body msg));

/// A query parameter of a request, or `()`.
let query_value : :string -> :map -> (:string | :unit);
let query_value name req = (Request.query req).[name else ()];

/// A path parameter a router read (`:id` in `/users/:id`), or `()`.
let param : :string -> :map -> (:string | :unit);
let param name req = (Request.params req).[name else ()];

/// The cookies a request carries, by name.
let cookies : :map -> :map;
let cookies req = list.fold (fn m pair -> {
    let eq = str.find "=" pair;
    if eq <= 0 { m } else { m.[str.trim (str.slice 0 eq pair) => str.trim (str.slice (eq + 1) (len pair) pair)] }
}) %{} (list.flat_map (fn v -> str.split ";" v) (header_all "cookie" req));

/// The response itself when it is 2xx, otherwise `[:error, e]` of kind
/// `:status` carrying the response: for a pipeline that treats any other
/// answer as a failure.
let expect_ok : :map -> result.Of :map :error;
let expect_ok resp = if is_success resp { result.ok resp }
                     else { result.error (error.new :status (to_string (Response.status resp) + " " + reason (Response.status resp) + " from " + Response.url resp)) };

// --- building responses ---------------------------------------------------------------

/// A response with a status and a body, and nothing else.
let respond : :integer -> :string -> :map;
let respond code text = Response.new () |> Response.set_status code |> Response.set_body text;

/// Plain text, 200.
let text : :string -> :map;
let text body_text = respond 200 body_text |> with_header "content-type" "text/plain; charset=utf-8";

/// HTML, 200.
let html : :string -> :map;
let html body_text = respond 200 body_text |> with_header "content-type" "text/html; charset=utf-8";

/// A value as JSON, 200.
let json : :any -> :map;
let json value = respond 200 (json.write value) |> with_header "content-type" "application/json";

/// A bare status, its reason phrase as the body.
let status_only : :integer -> :map;
let status_only code = respond code (if code == 204 || code == 304 { "" } else { reason code })
                       |> with_header "content-type" "text/plain; charset=utf-8";

let not_found : :map;
let not_found = status_only 404;

let no_content : :map;
let no_content = respond 204 "";

let bad_request : :string -> :map;
let bad_request why = text why |> Response.set_status 400;

/// A redirect, 302 by default: see `redirect_with` for the others.
let redirect : :string -> :map;
let redirect location = redirect_with 302 location;

/// A redirect with a particular status: 301 and 308 are permanent, 303 says
/// "now GET this", 307 and 308 keep the method.
let redirect_with : :integer -> :string -> :map;
let redirect_with code location = respond code "" |> with_header "location" location;

/// The response with a different status.
let with_status : :integer -> :map -> :map;
let with_status code resp = Response.set_status code resp;

/// A `Set-Cookie` on the response. `attributes` is a map such as
/// `%{ "Path" => "/", "Max-Age" => 3600, "HttpOnly" => true, "SameSite" => "Lax" }`;
/// `true` writes the bare attribute.
let with_cookie : :string -> :string -> :map -> :map -> :map;
let with_cookie name value attributes resp = {
    let attrs = list.map (fn [k, v] -> if v == true { text_of k } else { text_of k + "=" + text_of v })
                         (list.filter (fn [_, v] -> v != false && v != ())
                                      (list.map (fn k -> [k, attributes.[k]]) (map.sorted_keys attributes)));
    add_header "set-cookie" (str.join_str "; " ((name + "=" + value) :: attrs)) resp
};

// --- building requests ------------------------------------------------------------------

/// A request to send: a method and an absolute URL.
let request : :string -> :string -> :map;
let request method address = Request.new () |> Request.set_method (str.upper method) |> Request.set_url address;

/// The request with a body.
let with_body : :string -> :map -> :map;
let with_body text_body msg = msg.[:body => text_body];

/// The request with a JSON body and its content type.
let with_json : :any -> :map -> :map;
let with_json value msg = with_header "content-type" "application/json" (with_body (json.write value) msg);

/// The request with a form body (`a=1&b=2`) from pairs or a map.
let with_form : :any -> :map -> :map;
let with_form pairs msg = with_header "content-type" "application/x-www-form-urlencoded" (with_body (url.encode_query pairs) msg);

/// The request with pairs added to its URL's query.
let with_query : :any -> :map -> :map;
let with_query pairs req = match url.parse (Request.url req) {
    [:ok, u] => Request.set_url (url.to_text (url.add_query pairs u)) req,
    _ => req,
};

/// `Authorization: Bearer token`.
let with_bearer : :string -> :map -> :map;
let with_bearer token req = with_header "authorization" ("Bearer " + token) req;

/// `Authorization: Basic ..`, from a user and password.
let with_basic_auth : :string -> :string -> :map -> :map;
let with_basic_auth user password req = with_header "authorization" ("Basic " + crypto.base64 (user + ":" + password)) req;

/// How long the whole exchange may take, redirects included. 30 seconds
/// unless this says otherwise.
let with_timeout : :integer -> :map -> :map;
let with_timeout d req = Request.set_options ((Request.options req).[:timeout => d]) req;

/// How many redirects to follow; 0 to follow none and answer the redirect.
let with_redirects : :integer -> :map -> :map;
let with_redirects n req = Request.set_options ((Request.options req).[:redirects => n]) req;

/// Options for `std.tls` when the URL is `https`, laid over the defaults:
/// `%{ :ca => pem }` to trust a private root, `%{ :verify => false }` for a
/// test server you have no other way to trust.
let with_tls : :map -> :map -> :map;
let with_tls options req = Request.set_options ((Request.options req).[:tls => options]) req;

// --- the wire: reading -------------------------------------------------------------------
//
// A `Reader` is a socket and the bytes read from it that have not been used
// yet. Reading answers the value and the reader after it, so the bytes of the
// next message on a kept-alive connection -- or the body after a head -- are
// never lost between calls. A malformed message raises an error of kind
// `:bad_message`, one that is too big `:too_large`; the client and the server
// each catch those at the edge and answer in their own terms.

type Reader = rd.Reader.type;

let reader : :any -> Reader;
let reader socket = rd.reader socket;

/// A line, without its `\r\n`, or `()` at the end of the stream; longer
/// than `limit` raises `:too_large`.
let read_line! : Reader -> :integer -> [:any, Reader];
let read_line! r limit = rd.read_line! r limit;

/// Exactly `n` bytes; fewer raises `:bad_message`, as a body cut short is.
let read_exact! : Reader -> :integer -> [:string, Reader];
let read_exact! r n = rd.read_exact! r n;

/// Everything until the other side closes, up to `limit`.
let read_to_end! : Reader -> :integer -> [:string, Reader];
let read_to_end! r limit = read_body! r [] true limit;

priv let valid_header_name name = name != "" && str.span "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" 0 name == len name;
priv let valid_header_value value = str.all (fn c -> { let n = _char_code c; n == 9 || (n >= 32 && n != 127) }) value;

/// The start line and the headers up to the blank line: `[start, headers,
/// reader]`, or `()` when the stream ended before anything arrived -- a
/// kept-alive connection closing between messages, which is not an error.
let read_head! : Reader -> :integer -> :any;
let read_head! r limit = match read_line! r 8192 {
    [(), _] => (),
    // A blank line before the start line is allowed and skipped (RFC 9112 2.2).
    ["", r2] => {
        if limit < 2 { raise! (error.new :too_large "too many leading blank lines") }
        read_head! r2 (limit - 2)
    },
    [start, r2] => {
        let rec headers! rr acc !size = match read_line! rr 8192 {
            [(), _] => raise! (error.new :bad_message "the stream ended inside the headers"),
            ["", r3] => [list.reverse acc, r3],
            [line, r3] => {
                if size + len line + 2 > limit { raise! (error.new :too_large "headers larger than the limit") }
                let colon = str.find ":" line;
                if colon <= 0 { raise! (error.new :bad_message ("not a header: " + line)) }
                let name = str.lower (str.slice 0 colon line);
                let value = str.slice (colon + 1) (len line) line;
                if not (valid_header_name name) || not (valid_header_value value) { raise! (error.new :bad_message "invalid header") }
                headers! r3 ([name, str.trim value] :: acc) (size + len line + 2)
            },
        };
        let [hs, r4] = headers! r2 [] 0;
        [start, hs, r4]
    },
};

// --- bodies, a piece at a time ---------------------------------------------------------
//
// A body is read by one function, `next_piece!`, which answers the next piece
// of it and where it has got to: by a length, by chunks, or until the
// connection closes. Everything else is a loop over that -- `read_body!`
// collects the pieces, the client's `stream!` hands each to a callback, and
// a server streaming a request body hands them to the handler when it asks
// -- so a body is never held whole unless something asks for it whole, and
// there is one body reader to get right rather than three.

/// Where a body has got to: `[:exact, left]`, `[:chunked, left_in_chunk]`,
/// `[:chunk_end]` (the line break after a chunk's data), `[:to_end]` or
/// `[:done]`.
type BodyState = [:exact, :integer] | [:chunked, :integer] | [:chunk_end] | [:to_end] | [:done];

/// How a body is framed, from its headers: chunked, a length, or (for a
/// response that says neither) everything until the connection closes.
let body_state! : [[:string]] -> :bool -> BodyState;
let body_state! headers until_close = {
    let msg = %{ :headers => headers };
    let encodings = header_all "transfer-encoding" msg;
    let lengths = header_all "content-length" msg;
    // Reject ambiguous framing even when duplicate lengths happen to agree.
    // A proxy must never choose a different boundary from this reader.
    if len encodings > 1 || len lengths > 1 || (encodings != [] && lengths != []) {
        raise! (error.new :bad_message "ambiguous body framing")
    }
    match encodings {
        [v] => if str.lower (str.trim v) == "chunked" { [:chunked, 0] }
               else { raise! (error.new :bad_message "unsupported transfer encoding") },
        _ => match lengths {
            [] => if until_close { [:to_end] } else { [:exact, 0] },
            [v] => {
                let digits = str.trim v;
                if digits == "" || str.span "0123456789" 0 digits != len digits {
                    raise! (error.new :bad_message "invalid content length")
                }
                match num.parse_int digits {
                    n if n != () && n >= 0 => [:exact, n],
                    _ => raise! (error.new :bad_message "invalid content length"),
                }
            },
        },
    }
};

/// The next piece of a body -- what has arrived of it, up to 64 KiB -- or
/// `()` when it is over: `[piece, state, reader]`.
let next_piece! : Reader -> BodyState -> [:any, BodyState, Reader];
let rec next_piece! r state = match state {
    [:done] => [(), state, r],
    [:exact, 0] => [(), [:done], r],
    [:exact, n] => {
        let [piece, r2] = rd.available! r n;
        if piece == "" { raise! (error.new :bad_message ("the stream ended " + to_string n + " bytes short of the body")) }
        [piece, [:exact, n - len piece], r2]
    },
    [:to_end] => {
        let [piece, r2] = rd.available! r 65536;
        if piece == "" { [(), [:done], r2] } else { [piece, state, r2] }
    },
    [:chunk_end] => {
        let [ending, r2] = read_exact! r 2;
        if ending != "\r\n" { raise! (error.new :bad_message "invalid chunk terminator") }
        next_piece! r2 [:chunked, 0]
    },
    [:chunked, 0] => match read_line! r 8192 {
        [(), _] => raise! (error.new :bad_message "the stream ended inside a chunked body"),
        [line, r2] => {
            let size = hex_number (str.slice 0 (str.upto ";" 0 line) line);
            if size < 0 { raise! (error.new :bad_message ("not a chunk size: " + line)) }
            if size == 0 {
                // Trailers, which nothing here uses, up to the blank line.
                let rec trailers! rr !remaining = match read_line! rr 8192 {
                    ["", r3] => r3,
                    [(), _] => raise! (error.new :bad_message "the stream ended inside trailers"),
                    [line, r3] => {
                        if len line + 2 > remaining { raise! (error.new :too_large "trailers larger than the limit") }
                        let colon = str.find ":" line;
                        if colon <= 0 || not (valid_header_name (str.slice 0 colon line)) || not (valid_header_value (str.slice (colon + 1) (len line) line)) { raise! (error.new :bad_message "invalid trailer") }
                        let name = str.lower (str.slice 0 colon line);
                        if name == "content-length" || name == "transfer-encoding" { raise! (error.new :bad_message "framing header in trailers") }
                        trailers! r3 (remaining - len line - 2)
                    },
                };
                [(), [:done], trailers! r2 65536]
            } else { next_piece! r2 [:chunked, size] }
        },
    },
    [:chunked, n] => {
        let [piece, r2] = rd.available! r n;
        if piece == "" { raise! (error.new :bad_message "the stream ended inside a chunk") }
        [piece, if n - len piece == 0 { [:chunk_end] } else { [:chunked, n - len piece] }, r2]
    },
};

/// Fold `step!` over the pieces of a body: `[acc, reader]`. More than `limit`
/// bytes raises `:too_large`.
let fold_body! : Reader -> BodyState -> :integer -> a -> (a -> :string -> a) -> [a, Reader];
let rec fold_body! r state limit acc step! = match next_piece! r state {
    [(), _, r2] => [acc, r2],
    [piece, state2, r2] => {
        if len piece > limit { raise! (error.new :too_large "a body larger than the limit") }
        let acc2 = step! acc piece;
        strict! acc2
        fold_body! r2 state2 (limit - len piece) acc2 step!
    },
};

/// A body as the headers describe it, whole.
let read_body! : Reader -> [[:string]] -> :bool -> :integer -> [:string, Reader];
let read_body! r headers until_close limit = {
    let state = body_state! headers until_close;
    // A length past the limit is refused before a byte of it is read.
    match state { [:exact, n] if n > limit => raise! (error.new :too_large "a body larger than the limit"), _ => () }
    let [pieces, r2] = fold_body! r state limit [] (fn acc piece -> piece :: acc);
    [str.concat_all (list.reverse pieces), r2]
};

priv let hex_number : :string -> :integer;
priv let hex_number t =
    if t == "" || str.span "0123456789abcdefABCDEF" 0 t != len t || len t > 15 { 0 - 1 }
    else { list.fold (fn acc c -> acc * 16 + hex_digit c) 0 (str.chars t) };

priv let hex_digit : :char -> :integer;
priv let hex_digit c = { let k = _char_code c; if k <= 57 { k - 48 } else if k <= 70 { k - 55 } else { k - 87 } };

// --- streams ------------------------------------------------------------------------
//
// A body that is made, or arrives, in pieces. A stream is either a list of
// strings -- lazy, so each piece is computed when it is about to be sent, and
// a list as long as you like costs only the piece in hand -- or a function of
// unit that answers the next piece, or `()` when there are no more, which is
// the form for pieces that need effects: a file read a block at a time, a
// message waited for. Server-sent events are a stream with a format.

/// A 200 response whose body is sent in pieces as `chunks` makes them: a
/// list of strings, or a function answering the next one or `()`.
let stream : :any -> :map;
let stream chunks = Response.new () |> Response.set_stream chunks;

/// The request with a body sent in pieces, chunked.
let with_stream : :any -> :map -> :map;
let with_stream chunks req = req.[:stream => chunks];

/// The next piece of a stream and the rest of it: `[piece, rest]`, the piece
/// `()` at the end.
let pull! : :any -> [:any, :any];
let pull! s = st.pull! s;

/// Every piece of a stream, concatenated.
let stream_text! : :any -> :string;
let stream_text! s = st.stream_text! s;

/// Write a stream to a socket, chunked or as it is, calling `progress!`
/// after each piece.
let write_stream! : :any -> :any -> :bool -> (:unit -> :any) -> :unit;
let write_stream! sock s chunked progress! = st.write_stream! sock s chunked progress!;

/// A stream whose pieces are `f` of another's, as they are pulled.
let map_stream : (:any -> :string) -> :any -> :any;
let map_stream f s = st.map_stream f s;

/// The body of a request or response, whether it came whole or as a stream.
let body_text! : :map -> :string;
let body_text! msg = match msg.[:stream else ()] { () => body msg, s => stream_text! s };

/// One server-sent event, as `text/event-stream` spells it. A string is its
/// data; a map may give `"data"`, `"event"`, `"id"` and `"retry"`. Data with
/// line breaks becomes several `data:` lines, as the format requires.
let sse_event : :any -> :string;
let sse_event e = {
    let fields = if type_of e == :map { e } else { %{ "data" => e } };
    let line k = match fields.[k else ()] { () => [], v => [k + ": " + text_of v + "\n"] };
    let data = match fields.["data" else ()] { () => [], d => list.map (fn l -> "data: " + l + "\n") (str.split "\n" (text_of d)) };
    str.concat_all (line "event" + line "id" + line "retry" + data + ["\n"])
};

/// A response that sends server-sent events: `events` is a stream (a list,
/// or a function answering the next event or `()`) of what `sse_event` takes.
let event_stream : :any -> :map;
let event_stream events = {
    stream (map_stream sse_event events) |> with_header "content-type" "text/event-stream" |> with_header "cache-control" "no-cache"
};

// --- the wire: writing -----------------------------------------------------------------------

/// A request as bytes: the request line with `target`, a `Host` header, the
/// request's own headers, a `Content-Length` when there is a body to send.
///
/// A request with a `stream` gets `Transfer-Encoding: chunked` and no body
/// here: the pieces follow, through `write_stream!`.
let encode_request : :map -> :string -> :string -> :string;
let encode_request req target host = {
    let streaming = req.[:stream else ()] != ();
    let body_text = if streaming { "" } else { body req };
    let method = Request.method req;
    let needs_length = not streaming && (len body_text > 0 || method == "POST" || method == "PUT" || method == "PATCH");
    let base = req |> with_header "host" host
                   |> (fn r -> if needs_length { with_header "content-length" (len body_text) r } else { r })
                   |> (fn r -> if streaming { with_header "transfer-encoding" "chunked" (without_header "content-length" r) } else { r });
    str.concat_all ([method, " ", target, " HTTP/1.1\r\n"]
                    + list.flat_map (fn [k, v] -> [canonical k, ": ", v, "\r\n"]) (Request.headers base)
                    + ["\r\n", body_text])
};

/// A response as bytes. A `Content-Length` is always written, except where
/// HTTP forbids a body; `head` leaves the body off while keeping its length.
let encode_response : :map -> :bool -> :string;
let encode_response resp head = {
    let code = Response.status resp;
    let bodiless = code < 200 || code == 204 || code == 304;
    let with_len = if bodiless { without_header "content-length" resp } else { with_header "content-length" (len (body resp)) resp };
    str.concat_all (["HTTP/1.1 ", to_string code, " ", reason code, "\r\n"]
                    + list.flat_map (fn [k, v] -> [canonical k, ": ", v, "\r\n"]) (Response.headers with_len)
                    + ["\r\n", if head || bodiless { "" } else { body resp }])
};

/// The head of a response whose body is a stream: chunked for HTTP/1.1, and
/// for an HTTP/1.0 client neither chunked nor with a length, the end of the
/// body being the end of the connection.
let encode_stream_head : :map -> :bool -> :string;
let encode_stream_head resp chunked = {
    let code = Response.status resp;
    let framed = without_header "content-length" resp
                 |> (fn r -> if chunked { with_header "transfer-encoding" "chunked" r } else { with_header "connection" "close" r });
    str.concat_all (["HTTP/1.1 ", to_string code, " ", reason code, "\r\n"]
                    + list.flat_map (fn [k, v] -> [canonical k, ": ", v, "\r\n"]) (Response.headers framed)
                    + ["\r\n"])
};

/// `content-type` as `Content-Type`: how a header name is usually written,
/// for peers that are fussier than the RFC lets them be.
let canonical : :string -> :string;
let canonical name = str.join_str "-" (list.map (fn part -> match str.chars part {
    [] => "",
    [c, ..rest] => str.of_chars (str.upper_char c :: rest),
}) (str.split "-" name));

// --- the client --------------------------------------------------------------------------------
//
// `send!` and its relatives open a connection for each request and close it
// after. A `Client` keeps them: it is a pool -- a process holding idle
// connections by scheme, host and port -- with a base URL, headers and
// options that every request through it gets, so a program talking to one
// API makes one connection and reuses it:
//
//     let api = http.client_with! %{ :base => "https://api.example.com/v1",
//                                    :headers => [["authorization", "Bearer " + token]],
//                                    :timeout => time.seconds 10 };
//     let? user = http.call! api (http.request "GET" "/users/7");
//     http.close_client! api
//
// A connection goes back to the pool only when the response said it could
// and was read to its end, and one that sat idle for `idle` is closed. A
// pooled connection the server has since closed is found out when the
// request fails before any answer, and the request is sent again once on a
// new connection -- unless its body was a stream of pieces that cannot be
// made again.

/// The default for `with_timeout`.
let default_timeout : :integer;
let default_timeout = 30000000000;

/// The largest response body the client reads whole, 256 MiB. `stream!`
/// reads any size.
let max_response : :integer;
let max_response = 268435456;

/// A client: its pool (a process, or `()` for one connection per request), the
/// URL relative request URLs are read against, headers every request gets
/// unless it sets them, and options (`:timeout`, `:redirects`, `:tls`) every
/// request gets unless it sets them.
mapping Client {
    pool : :any = ()
    base : :string = ""
    headers : [[:string]] = []
    options : :map = %{}
}

/// A client with a pool and nothing else.
let client! : :unit -> :map;
let client! () = client_with! %{};

/// A client from `%{ :base, :headers, :timeout, :redirects, :tls, :idle }`,
/// each optional. `:idle` is how long an unused connection is kept (30 s).
let client_with! : :map -> :map;
let client_with! config = {
    let idle = config.[:idle else 30000000000];
    let pool = connections.start! (time.to_milliseconds idle);
    let opts = list.fold (fn m k -> match config.[k else ()] { () => m, v => m.[k => v] }) %{} [:timeout, :redirects, :tls, :http2];
    Client.make pool (config.[:base else ""]) (list.map (fn [k, v] -> [str.lower k, v]) (config.[:headers else []])) opts
};

/// Close a client's idle connections and stop its pool.
let close_client! : :map -> :unit;
let close_client! c = match Client.pool c { () => (), pid => connections.close! pid };

/// Send a request through a client: `[:ok, response]` or `[:error, e]`.
let call! : :map -> :map -> result.Of :map :error;
let call! c req = run! c req ();

/// Send a request and read the response: `[:ok, response]` or `[:error, e]`.
/// One connection, closed after; see `call!` for keeping them.
let send! : :map -> result.Of :map :error;
let send! req = run! (Client.new ()) req ();

/// Send a request and hand the body to `on_piece!` as it arrives, a piece at
/// a time, instead of collecting it: for a body too large to hold, or one to
/// act on as it comes (a log being followed, events from a server). Answers
/// the response with an empty body. `on_piece!` runs in the process doing
/// the request, so what it does must not depend on being in the caller's.
let stream! : :map -> (:string -> :any) -> result.Of :map :error;
let stream! req on_piece! = run! (Client.new ()) req (sink_step! on_piece!);

/// `stream!` through a client.
let stream_with! : :map -> :map -> (:string -> :any) -> result.Of :map :error;
let stream_with! c req on_piece! = run! c req (sink_step! on_piece!);

priv let sink_step! : (:string -> :any) -> :unit -> :string -> :unit;
priv let sink_step! on_piece! acc piece = { on_piece! piece; () };

priv let run! : :map -> :map -> :any -> result.Of :map :error;
priv let run! c req0 sink = {
    let req = with_client_defaults c req0;
    let opts = Request.options req;
    let timeout = opts.[:timeout else default_timeout];
    match time.within! timeout (follow! c req (opts.[:redirects else 10]) sink) {
        [:ok, resp] => result.ok resp,
        [:error, e] => result.error (if error.is_error e { e } else { error.new :error e }),
        :timeout => result.error (error.new :timeout ("no response from " + Request.url req + " within " + time.format_duration timeout)),
    }
};

/// The request with the client's base URL, headers and options under its own.
priv let with_client_defaults : :map -> :map -> :map;
priv let with_client_defaults c req = {
    let address = match Client.base c {
        "" => Request.url req,
        base => match url.parse base {
            [:ok, b] => {
                let rel = Request.url req;
                // A path under the base, as "/users" under ".../v1" is meant.
                let joined = if str.starts_with "/" rel && not (str.starts_with "//" rel) {
                    let bp = url.Url.path b;
                    url.to_text (b |> url.Url.set_path ((if str.ends_with "/" bp { str.slice 0 (len bp - 1) bp } else { bp }) + url.Url.path (url.parse_or_raise rel))
                                   |> url.Url.set_query (url.Url.query (url.parse_or_raise rel))
                                   |> url.Url.set_has_query (url.Url.has_query (url.parse_or_raise rel)))
                } else { url.to_text (url.resolve b rel) };
                joined
            },
            _ => Request.url req,
        },
    };
    let with_headers_set = list.fold (fn r [k, v] -> if header k r == () { add_header k v r } else { r }) req (Client.headers c);
    with_headers_set |> Request.set_url address |> Request.set_options (map.merge (Client.options c) (Request.options req))
};

let get! : :string -> result.Of :map :error;
let get! address = send! (request "GET" address);

let head! : :string -> result.Of :map :error;
let head! address = send! (request "HEAD" address);

let delete! : :string -> result.Of :map :error;
let delete! address = send! (request "DELETE" address);

/// POST a body as it is; set a content type with `request` and `with_header`
/// when it matters.
let post! : :string -> :string -> result.Of :map :error;
let post! address text_body = send! (request "POST" address |> with_body text_body);

let post_json! : :string -> :any -> result.Of :map :error;
let post_json! address value = send! (request "POST" address |> with_json value);

let post_form! : :string -> :any -> result.Of :map :error;
let post_form! address pairs = send! (request "POST" address |> with_form pairs);

let put_json! : :string -> :any -> result.Of :map :error;
let put_json! address value = send! (request "PUT" address |> with_json value);

/// The body of a 2xx response, or an error -- including for any other status.
let get_text! : :string -> result.Of :string :error;
let get_text! address = {
    let? resp = get! address;
    let? good = expect_ok resp;
    result.ok (body good)
};

/// The body of a 2xx response decoded as JSON, or an error.
let get_json! : :string -> result.Of :any :error;
let get_json! address = {
    let? text_body = get_text! address;
    result.map_error (fn why -> error.new :bad_json why) (json.decode text_body)
};

/// Save the body of a 2xx response to a file, a piece at a time, so a file of
/// any size costs no more memory than one piece: `[:ok, bytes written]`. A
/// response that is not 2xx is an error of kind `:status`, and the file is
/// left as it was.
let download! : :string -> :string -> result.Of :integer :error;
let download! address path = {
    let partial = path + ".part";
    let h = io.open! partial :write;
    let outcome = stream! (request "GET" address) (write_piece! h);
    io.close! h
    match outcome {
        [:ok, resp] => if is_success resp {
            io.rename! partial path
            let size = match io.stat! path { () => 0, [n, _, _] => n };
            strict! size
            result.ok size
        } else { io.remove! partial; expect_ok resp |> result.map (fn _ -> 0) },
        [:error, e] => { try! { io.remove! partial } catch ignored { () }; result.error e },
    }
};

priv let write_piece! : :any -> :string -> :unit;
priv let write_piece! h piece = { streams.write_all! h piece; () };

/// One exchange, then the redirects, as browsers follow them: 303, and 301
/// or 302 after anything but GET or HEAD, become a GET without a body;
/// 307 and 308 repeat the request as it was. Credentials are not carried to
/// another host.
priv let follow! : :map -> :map -> :integer -> :any -> :map;
priv let rec follow! c req left sink = {
    let resp = exchange! c req sink (left > 0);
    let code = Response.status resp;
    let location = header "location" resp;
    if location == () || not (is_redirect code) { resp }
    else if left <= 0 { raise! (error.new :too_many_redirects ("still redirected after the last allowed, to " + location)) }
    else {
        let here = url.parse_or_raise (Request.url req);
        let there = url.resolve here location;
        let to_get = code == 303 || ((code == 301 || code == 302) && Request.method req != "GET" && Request.method req != "HEAD");
        let moved = req |> Request.set_url (url.to_text (there |> url.Url.set_fragment ""))
                        |> (fn r -> if to_get { r |> Request.set_method "GET" |> with_body "" |> Request.set_stream ()
                                                  |> without_header "content-type" |> without_header "content-length" } else { r })
                        |> (fn r -> if url.Url.host there != url.Url.host here { without_header "authorization" (without_header "cookie" r) } else { r });
        follow! c moved (left - 1) sink
    }
};

priv let is_redirect : :integer -> :bool;
priv let is_redirect code = code == 301 || code == 302 || code == 303 || code == 307 || code == 308;

/// The URL of a request, checked: one that is not http or https, or has no
/// host, raises `:bad_url`.
priv let target_url! : :map -> :map;
priv let target_url! req = {
    let u = match url.parse (Request.url req) {
        [:ok, parsed] => parsed,
        [:error, why] => raise! (error.new :bad_url why),
    };
    let scheme = url.Url.scheme u;
    if scheme != "http" && scheme != "https" { raise! (error.new :bad_url ("not an http or https URL: " + Request.url req)) }
    if url.Url.host u == "" { raise! (error.new :bad_url ("no host in " + Request.url req)) }
    u
};

/// A new connection to the URL's host: `[:h1, socket]`, or `[:h2,
/// coordinator]` when the server agreed to HTTP/2 -- offered by ALPN on
/// https unless the request's options say `:http2 => false`, and assumed on
/// plain http when they say `:http2 => :prior_knowledge`.
priv let connect! : :map -> :map -> :any;
priv let connect! u req = {
    let wants = (Request.options req).[:http2 else true];
    let sock = net.connect! (url.bare_host u) (url.port_of u);
    if url.Url.scheme u == "https" {
        let protocols = if wants == false { ["http/1.1"] } else { ["h2", "http/1.1"] };
        let opts = map.merge %{ :host => url.bare_host u, :alpn => protocols } ((Request.options req).[:tls else %{}]);
        try! { tls.connect! sock opts } catch e { try! { io.close! sock } catch ignored { () }; raise! e }
        let agreed = match try! { tls.info! sock } catch e { () } { () => (), info => info.[:alpn else ()] };
        if agreed == "h2" { [:h2, h2.open! sock] } else { [:h1, sock] }
    } else if wants == :prior_knowledge { [:h2, h2.open! sock] }
    else { [:h1, sock] }
};

priv let pool_key : :map -> :string;
priv let pool_key u = url.Url.scheme u + "://" + url.Url.host u + ":" + to_string (url.port_of u);

/// One request, on a pooled connection if the client has one and a new one
/// otherwise, which goes back to the pool afterwards if it can. An HTTP/2
/// connection is not lent but shared: the pool keeps it, and every request
/// to that host goes over it at once.
priv let exchange! : :map -> :map -> :any -> :bool -> :map;
priv let exchange! c req sink following = {
    let u = target_url! req;
    let key = pool_key u;
    let pool = Client.pool c;
    let pooled = match pool { () => (), pid => connections.checkout! pid key };
    let conn = match pooled { () => connect! u req, found => found };
    match try! { let got = over! c key conn (pooled == ()) req u sink following; strict! got; [:ok, got] } catch e { [:error, e] } {
        [:ok, resp] => resp,
        [:error, e] => {
            // A pooled connection the server closed while it sat idle fails
            // before any answer; that is not this request's failure, so it
            // goes again, once, on a connection of its own.
            let replayable = type_of (req.[:stream else ()]) != :pure_fn && type_of (req.[:stream else ()]) != :impure_fn;
            if pooled != () && replayable && retryable e { over! c key (connect! u req) true req u sink following }
            else { raise! e }
        },
    }
};

/// The request over one connection, which is then pooled, shared or closed.
priv let over! : :map -> :string -> :any -> :bool -> :map -> :map -> :any -> :bool -> :map;
priv let over! c key conn is_new req u sink following = {
    let pool = Client.pool c;
    match conn {
        [:h2, coordinator] => {
            let kept = pool != () && (not is_new || connections.share! pool key coordinator);
            let outcome = try! { let resp = h2.request! coordinator req (if sink == () { () } else { sink }); strict! resp; [:ok, resp] }
                          catch e { [:error, e] };
            if not kept { h2.shutdown! coordinator }
            match outcome { [:ok, resp] => Response.set_url (Request.url req) resp, [:error, e] => raise! e }
        },
        [:h1, sock] => {
            let keep = pool != ();
            match try! { let got = exchange_on! sock u req sink keep following; strict! got; [:ok, got] } catch e { [:error, e] } {
                [:ok, [resp, reusable]] => {
                    if keep && reusable { connections.checkin! pool key sock } else { close_quietly! sock }
                    resp
                },
                [:error, e] => { close_quietly! sock; raise! e },
            }
        },
    }
};

priv let retryable : :any -> :bool;
priv let retryable e = list.contains (error.kind e) [:bad_response, :connection_lost, :connection_reset, :io_closed, :io_error, :broken_pipe, :stream_reset];

priv let close_quietly! : :any -> :unit;
priv let close_quietly! sock = connections.close_quietly! sock;

/// Write a request on an open connection and read its response:
/// `[response, reusable]`, where `reusable` says the connection can carry
/// another request. With a `sink`, the body's pieces go to it rather than
/// into the response -- except a redirect's when it will be followed.
priv let exchange_on! : :any -> :map -> :map -> :any -> :bool -> :bool -> [:map, :bool];
priv let exchange_on! sock u req sink keep following = {
    let defaults = [["user-agent", "dream-http/1.0"], ["accept", "*/*"], ["connection", if keep { "keep-alive" } else { "close" }]];
    let prepared = list.fold (fn r [k, v] -> if header k r == () { add_header k v r } else { r }) req defaults;
    streams.write_all! sock (encode_request prepared (url.target u) (url.host_header u))
    match req.[:stream else ()] { () => (), s => write_stream! sock s true nothing }
    let [resp, reusable] = read_response_with! (reader sock) (Request.method req == "HEAD") sink following;
    [Response.set_url (Request.url req) resp, reusable && keep]
};

priv let nothing : :unit -> :unit;
priv let nothing u = ();

/// A response from the reader, skipping any 1xx before it.
let read_response! : Reader -> :bool -> :map;
let read_response! r head = (read_response_with! r head () false).[0];

/// The same, with a sink for the body: `[response, reusable]`.
priv let read_response_with! : Reader -> :bool -> :any -> :bool -> [:map, :bool];
priv let rec read_response_with! r head sink following = match read_head! r 65536 {
    () => raise! (error.new :bad_response "the server closed the connection without answering"),
    [start, headers, r2] => {
        let parts = str.split " " start;
        let parsed = match parts { [_, c, .._] => num.parse_int c, _ => () };
        match (if str.starts_with "HTTP/" start { parsed } else { () }) {
            () => raise! (error.new :bad_response ("not a status line: " + start)),
            code if code >= 100 && code < 200 => read_response_with! r2 head sink following,
            code => {
                let base = Response.new () |> Response.set_status code |> Response.set_headers headers;
                let says_close = str.contains_str "close" (str.lower (match header "connection" base { () => "", v => v }));
                let http11 = str.starts_with "HTTP/1.1" start;
                if head || code == 204 || code == 304 { [base, http11 && not says_close] }
                else {
                    let state = body_state! headers true;
                    let to_end = state == [:to_end];
                    let collect = sink == () || (following && is_redirect code && header "location" base != ());
                    if collect {
                        let [pieces, _] = fold_body! r2 state max_response [] (fn acc piece -> piece :: acc);
                        [Response.set_body (str.concat_all (list.reverse pieces)) base, http11 && not says_close && not to_end]
                    } else {
                        fold_body! r2 state 9223372036854775807 () sink
                        [base, http11 && not says_close && not to_end]
                    }
                }
            },
        }
    },
};

when test {
    import std.test;

    let tests = [
        test.case "headers are case-insensitive" $( test.eq! ["a", ["a", "b"], ()]
            { let m = Response.new () |> with_header "X-Thing" "a" |> add_header "x-thing" "b";
              [header "x-THING" m, header_all "X-Thing" m, header "nope" m] } ),
        test.case "with_header replaces" $( test.eq! [["x", "2"]] (Response.headers (Response.new () |> with_header "X" 1 |> with_header "x" 2)) ),
        test.case "line breaks are taken out of values" $( test.eq! "aSet-Cookie: x" (header "x" (with_header "x" "a\r\nSet-Cookie: x" (Response.new ()))) ),
        test.case "content type without parameters" $( test.eq! "application/json"
            (content_type (with_header "Content-Type" "Application/JSON; charset=utf-8" (Response.new ()))) ),
        test.case "a JSON response" $( test.eq! [200, "{\"a\":1}", "application/json"]
            { let r = json %{ "a" => 1 }; [status r, body r, header "content-type" r] } ),
        test.case "a redirect" $( test.eq! [303, "/x"] { let r = redirect_with 303 "/x"; [status r, header "location" r] } ),
        test.case "a cookie" $( test.eq! "sid=abc; HttpOnly; Path=/"
            (header "set-cookie" (with_cookie "sid" "abc" %{ "Path" => "/", "HttpOnly" => true, "Secure" => false } (text ""))) ),
        test.case "reading cookies" $( test.eq! %{ "a" => "1", "b" => "two" }
            (cookies (with_header "cookie" "a=1; b=two" (Request.new ()))) ),
        test.case "a request with JSON and a query" $( test.eq! ["POST", "http://x/p?a=1&b=two+words", "{\"k\":true}"]
            { let r = request "post" "http://x/p?a=1" |> with_query [["b", "two words"]] |> with_json %{ "k" => true };
              [Request.method r, Request.url r, body r] } ),
        test.case "basic auth" $( test.eq! "Basic YWRhOnB3" (header "authorization" (with_basic_auth "ada" "pw" (request "GET" "http://x"))) ),
        test.case "a form body" $( test.eq! %{ "a" => "1", "b" => "x y" } (body_form (with_form [["a", 1], ["b", "x y"]] (request "POST" "http://x"))) ),
        test.case "encode a request" $( test.eq! "POST /p HTTP/1.1\r\nContent-Type: text/plain\r\nHost: x\r\nContent-Length: 2\r\n\r\nhi"
            (encode_request (request "POST" "http://x/p" |> with_header "content-type" "text/plain" |> with_body "hi") "/p" "x") ),
        test.case "encode a response" $( test.eq! "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
            (encode_response (respond 404 "") false) ),
        test.case "a HEAD response keeps its length but not its body" $( test.eq! "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n"
            (encode_response (respond 200 "hi") true) ),
        test.case "no length where there can be no body" $( test.eq! "HTTP/1.1 204 No Content\r\n\r\n" (encode_response no_content false) ),
        test.case "canonical names" $( test.eq! ["Content-Type", "X-Request-Id", "Etag"] [canonical "content-type", canonical "x-request-id", canonical "etag"] ),
        test.case "expect_ok" $( test.eq! [true, :status] [result.is_ok (expect_ok (text "")),
                                                        error.kind (result.reason () (expect_ok (status_only 500)))] ),
        test.case "reasons" $( test.eq! ["Not Found", "I'm a teapot", "Client Error"] [reason 404, reason 418, reason 499] ),
        test.case "a bad URL is an error" $( test.eq! :bad_url (error.kind (result.reason () (get! "not a url"))) ),
        test.case "a refused connection is an error" $( {
            // A port that was just free: listen, note it, close.
            let l = net.listen! 0;
            let port = net.port! l;
            io.close! l
            test.eq! :connection_refused (error.kind (result.reason () (get! ("http://127.0.0.1:" + to_string port + "/"))))
        } ),
    ];
}
