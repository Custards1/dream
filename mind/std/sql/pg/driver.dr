// PostgreSQL as a std.sql.Connection. A wrapped connection has the same owner
// and lifetime as the original std.sql.pg.db connection; use it serially.
import std.error;
import std.list;
import std.map;
import std.sql;
import std.str;
import std.sql.pg.db;
import std.sql.pg.errors;
import std.sql.pg.value;
import std.sql.pg.wire;

/// Connect using std.sql.pg.config's map, URL or keyword string.
let open! : :any -> sql.Connection;
let open! target = try! {
    let conn = db.connect! target;
    strict! conn
    wrap! conn
} catch e { fail! "" e };

/// Adapt an existing connection, including one borrowed inside pool.with!.
/// Closing the adapter closes that connection too.
let wrap! : db.Conn -> sql.Connection;
let wrap! conn = sql.connection sql.postgres conn %{
    :run => run!, :run_many => many!, :script => script!, :fold => fold!, :close => close!,
    :prepare_statement => prepare_statement!, :execute_statement => execute_statement!,
    :deallocate_statement => deallocate_statement!, :script_results => script_results!,
    :copy_in => copy_in!, :cancel => cancel!, :info => info!, :reset => reset!,
    :listen => listen!, :unlisten => unlisten!, :notify => notify!, :next_notification => next_notification!,
};

priv let parameter : :any -> :any;
priv let parameter v = match v {
    [:blob, bytes] => value.bytea bytes,
    [:json, text] => value.typed value.oid.json text,
    [:native_value, :postgres, v] => v,
    _ => v,
};

// Keep std.sql.pg.db's decoding contract intact. Only this adapter tags bytea, using
// the column OID, including bytea nested in arrays. NULL stays NULL.
priv let cell : :integer -> :any -> :any;
priv let cell oid v = match v {
    () => (),
    _ => if oid == value.oid.bytea { sql.blob v }
         else if map.has oid value.element_of && type_of v == :list {
             list.map (cell value.element_of.[oid]) v
         } else { v },
};

priv let tuples : [:any] -> [[:any]] -> [[:any]];
priv let tuples columns rows = list.map
    (fn row -> list.map (fn [col, v] -> cell (wire.Column.oid col) v) (list.zip columns row)) rows;

priv let changed : :map -> :integer;
priv let changed result = {
    let command = db.Result.command result;
    if list.any (fn prefix -> str.starts_with prefix command) ["INSERT ", "UPDATE ", "DELETE ", "MERGE ", "COPY "] {
        match db.Result.count result { () => 0, n => n }
    } else { 0 }
};

priv let outcome : :map -> sql.Outcome;
priv let outcome result = %{
    :columns => list.map wire.Column.name (db.Result.columns result),
    :rows => tuples (db.Result.columns result) (db.Result.tuples result),
    :changes => changed result,
    :last_id => (),
    :metadata => list.map (fn col -> %{ :name => wire.Column.name col, :native_type => wire.Column.oid col,
        :table => wire.Column.table col, :attribute => wire.Column.attribute col }) (db.Result.columns result),
    :command => db.Result.command result, :status => db.Result.status result,
    :notices => db.Result.notices result, :notifications => db.Result.notifications result,
};

priv let run! : db.Conn -> :string -> [:any] -> sql.Outcome;
priv let run! conn text params = try! {
    let result = db.query_text! conn text (list.map parameter params);
    strict! result
    outcome result
} catch e { fail! text e };

// The unnamed prepared statement avoids colliding with application names.
// No other statement is sent until all parameter sets have been executed.
priv let many! : db.Conn -> :string -> [[:any]] -> :integer;
priv let many! conn text rows = match rows {
    [] => 0,
    [first, .._] => try! {
        let params = list.map parameter first;
        let prepared = db.prepare_types! conn "" text (list.map value.oid_of params);
        let count = try! { execute_rows! conn prepared rows 0 } catch e {
            try! { db.deallocate! conn prepared } catch ignored { () }
            raise! e
        };
        db.deallocate! conn prepared
        count
    } catch e { fail! text e },
};

priv let execute_rows! : db.Conn -> db.Prepared -> [[:any]] -> :integer -> :integer;
priv let rec execute_rows! conn prepared rows !count = match rows {
    [] => count,
    [params, ..rest] => {
        let result = db.execute! conn prepared (list.map parameter params);
        execute_rows! conn prepared rest (count + changed result)
    },
};

priv let script! : db.Conn -> :string -> :unit;
priv let script! conn text = try! { db.script! conn text; () } catch e { fail! text e };

priv let fold! : db.Conn -> :string -> [:any] -> :integer -> (a -> [:string] -> [[:any]] -> a) -> a -> a;
priv let fold! conn text params batch step! init = try! {
    db.fold_text! conn text (list.map parameter params) batch
        (fn acc cols rows -> step! acc (list.map wire.Column.name cols) (tuples cols rows)) init
} catch e { fail! text e };

priv let close! : db.Conn -> :unit;
priv let close! conn = try! { db.close! conn } catch e { fail! "" e };

// Named prepared handles coexist on one connection. A fresh process identity
// supplies a unique protocol name; no mutable counter or user-name collision.
priv let prepare_statement! : db.Conn -> :string -> [:any] -> db.Prepared;
priv let prepare_statement! conn text params = try! {
    let token = spawn! $( () );
    join! token
    db.prepare_types! conn ("dream_sql_" + to_string token) text (list.map (fn v -> value.oid_of (parameter v)) params)
} catch e { fail! text e };

priv let execute_statement! : db.Conn -> db.Prepared -> [:any] -> sql.Outcome;
priv let execute_statement! conn prepared params = try! {
    let result = db.execute! conn prepared (list.map parameter params);
    strict! result
    outcome result
} catch e { fail! (db.Prepared.text prepared) e };

priv let deallocate_statement! : db.Conn -> db.Prepared -> :unit;
priv let deallocate_statement! conn prepared = try! { db.deallocate! conn prepared } catch e { fail! (db.Prepared.text prepared) e };

priv let script_results! : db.Conn -> :string -> [sql.Outcome];
priv let script_results! conn text = try! {
    let results = db.script! conn text;
    strict! results
    list.map outcome results
} catch e { fail! text e };

priv let copy_in! : db.Conn -> :string -> [:string] -> [[:any]] -> :integer;
priv let copy_in! conn table columns rows = try! {
    db.copy_in! conn table columns (list.map (list.map parameter) rows)
} catch e { fail! "COPY FROM STDIN" e };

priv let cancel! : db.Conn -> :bool;
priv let cancel! conn = db.cancel! conn;

priv let info! : db.Conn -> :map;
priv let info! conn = %{ :server_version => db.server_version conn, :parameters => db.Conn.parameters conn,
                        :tls => db.tls_info! conn };

priv let reset! : db.Conn -> :unit;
priv let reset! conn = try! { db.script! conn "ROLLBACK; UNLISTEN *"; () } catch e { fail! "ROLLBACK; UNLISTEN *" e };

priv let listen! : db.Conn -> :string -> :unit;
priv let listen! conn channel = try! { db.listen! conn channel } catch e { fail! "LISTEN" e };
priv let unlisten! : db.Conn -> :string -> :unit;
priv let unlisten! conn channel = try! { db.unlisten! conn channel } catch e { fail! "UNLISTEN" e };
priv let notify! : db.Conn -> :string -> :string -> :unit;
priv let notify! conn channel payload = try! { db.notify! conn channel payload } catch e { fail! "NOTIFY" e };
priv let next_notification! : db.Conn -> :map;
priv let next_notification! conn = try! { db.next_notification! conn } catch e { fail! "notification" e };

/// A PostgreSQL refusal in std.sql's vocabulary, retaining all server fields.
/// Exceptions from application callbacks pass through unchanged.
priv let fail! : :string -> :any -> :never;
priv let fail! text e = if errors.is_postgres e {
    sql.fail_with! (map.merge (error.payload e) %{
        :code => code_of e, :state => errors.code e, :sql => text, :cause => e,
    })
} else { raise! e };

priv let code_of : :any -> :any;
priv let code_of e = if errors.is_connection_lost e || (type_of (errors.code e) == :string && str.starts_with "08" (errors.code e)) {
    :connection_lost
} else { match errors.condition e {
    :unique_violation => :unique,
    :foreign_key_violation => :foreign_key,
    :not_null_violation => :not_null,
    :check_violation => :check,
    :integrity_constraint_violation => :constraint,
    :exclusion_violation => :constraint,
    :serialization_failure => :serialization,
    :deadlock_detected => :deadlock,
    :lock_not_available => :locked,
    :read_only_sql_transaction => :readonly,
    :insufficient_privilege => :permission,
    :syntax_error => :syntax,
    :query_canceled => :canceled,
    :feature_not_supported => :unsupported,
    condition => condition,
} };

when test {
    import std.test;
    let tests = [
        test.case "PostgreSQL errors use shared codes and retain SQLSTATE and fields" $( {
            let original = errors.server %{ :code => "23505", :message => "duplicate", :constraint => "users_pkey" };
            let e = try! { fail! "INSERT" original } catch e { e };
            test.eq! [:unique, "23505", "users_pkey", "INSERT", true]
                [sql.error_code e, sql.error_field :state e, sql.error_field :constraint e,
                 sql.error_field :sql e, errors.is_postgres (sql.error_field :cause e)]
        } ),
        test.case "retry and connection conditions" $(
            test.eq! [:serialization, :deadlock, :locked, :connection_lost, :connection_lost, :constraint]
                (list.map (fn state -> code_of (errors.server %{ :code => state }))
                    ["40001", "40P01", "55P03", "08006", "08001", "23999"])
        ),
        test.case "bytea, its arrays and NULL" $(
            test.eq! [sql.blob "a", [sql.blob "b", ()], ()]
                [cell 17 "a", cell 1001 ["b", ()], cell 17 ()]
        ),
    ];
}
