// SQLite, as a `std.sql` connection.
//
//     import std.sql;
//     import std.sql.sqlite;
//
//     let db = sqlite.open! "notes.db";
//     sql.exec! db (sql.insert_into "notes" |> sql.values %{ "body" => "hi" })
//     sql.query! db (sql.select [] |> sql.from "notes")
//     sql.close! db
//
// The library is the system's: ABI version 0, under whatever name and in
// whichever directory this platform keeps it (`foreign.system_version`). On a
// system that keeps it somewhere no search would think of,
// `DREAM_LIB_SQLITE3=/path/to/libsqlite3.so` says which file, and
// `DREAM_LIBRARY_PATH` adds a directory to look in.
//
// A database handle is owned by the process that opened it, as every
// `std.foreign` resource is, and a statement is owned by its database: closing
// the database finalizes whatever was still open on it. A connection opened
// with `:place` set to a `foreign.start!` server lives in that server instead,
// and every call on it is a message there -- which is how a database is shared
// between processes, one statement at a time, with no lock.
//
// What SQLite stores and what comes back: an integer, a float, text, a blob
// (`[:blob, bytes]`), or NULL. A bool is stored as 1 or 0 and read back as
// that integer, because SQLite has no booleans to give back. Text and blobs preserve embedded NUL bytes.

import std.foreign;
import std.list;
import std.sql;
import std.sql.lint;
import std.str;

foreign sqlite3 from system "sqlite3" "0" {
    resource Db = sqlite3_close_v2
    resource Stmt = sqlite3_finalize

    open! : :cstr -> out (Db | ()) -> :int -> :ptr -> :int = sqlite3_open_v2
    errmsg! : Db -> :cstr = sqlite3_errmsg
    extended_errcode! : Db -> :int = sqlite3_extended_errcode
    busy_timeout! : Db -> :int -> :int = sqlite3_busy_timeout
    exec! : Db -> :cstr -> :ptr -> :ptr -> :ptr -> :int = sqlite3_exec
    autocommit! : Db -> :int = sqlite3_get_autocommit
    complete! : :cstr -> :int = sqlite3_complete
    total_changes! : Db -> :int = sqlite3_total_changes
    changes! : Db -> :int = sqlite3_changes
    last_insert_rowid! : Db -> :i64 = sqlite3_last_insert_rowid

    prepare! : Db -> :bytes -> :int -> out (Stmt | ()) -> :ptr -> :int = sqlite3_prepare_v2
    step! : Stmt -> :int = sqlite3_step
    reset! : Stmt -> :int = sqlite3_reset
    clear_bindings! : Stmt -> :int = sqlite3_clear_bindings
    readonly! : Stmt -> :int = sqlite3_stmt_readonly

    bind_null! : Stmt -> :int -> :int = sqlite3_bind_null
    bind_int64! : Stmt -> :int -> :i64 -> :int = sqlite3_bind_int64
    bind_double! : Stmt -> :int -> :double -> :int = sqlite3_bind_double
    bind_text! : Stmt -> :int -> :bytes -> :int -> :ptr -> :int = sqlite3_bind_text
    bind_blob! : Stmt -> :int -> :bytes -> :int -> :ptr -> :int = sqlite3_bind_blob

    column_count! : Stmt -> :int = sqlite3_column_count
    column_name! : Stmt -> :int -> :cstr = sqlite3_column_name
    column_decltype! : Stmt -> :int -> :cstr | () = sqlite3_column_decltype
    column_text_bytes! : Stmt -> :int -> :ptr = sqlite3_column_text
    column_type! : Stmt -> :int -> :int = sqlite3_column_type
    column_int64! : Stmt -> :int -> :i64 = sqlite3_column_int64
    column_double! : Stmt -> :int -> :double = sqlite3_column_double
    column_text! : Stmt -> :int -> :cstr | () = sqlite3_column_text
    column_blob! : Stmt -> :int -> :ptr = sqlite3_column_blob
    column_bytes! : Stmt -> :int -> :int = sqlite3_column_bytes

    libversion : :void -> :cstr = sqlite3_libversion
}

/// A blob comes back as a bare pointer and a length, and Dream reads no memory
/// it was not told the size of. So the bytes are copied into a buffer of that
/// length first, which it was.
foreign libc {
    copy! : :buffer -> :ptr -> :size -> :ptr = memcpy
}

// --- opening ------------------------------------------------------------------

/// How a database is opened. Every key may be left out:
///
///   :readonly       open it for reading only (false)
///   :busy_timeout   how long to wait on a lock held elsewhere, in ms (5000)
///   :foreign_keys   enforce `REFERENCES` -- SQLite does not unless asked (true)
///   :place          `foreign.here`, or a `foreign.start!` server to own it
type Options = %{ :atom => :any };

/// The database at `path`, made if there is none. A `file:` URI is taken too.
let open! : :string -> sql.Connection;
let open! path = open_with! path %{};

/// A database in memory, gone when it is closed.
let memory! : :unit -> sql.Connection;
let memory! u = open_with! ":memory:" %{};

let open_with! : :string -> Options -> sql.Connection;
let open_with! path options = {
    let place = options.[:place else foreign.here];
    let flags = (if options.[:readonly else false] { open_readonly } else { open_readwrite + open_create }) + open_uri;
    let db = foreign.run! place (fn () -> open_here! path flags options);
    let effects = %{ :run => run!, :run_many => run_many!, :script => script!, :close => close!,
        :prepare_statement => prepare_statement!, :execute_statement => execute_statement!,
        :deallocate_statement => deallocate_statement!, :script_results => script_results!,
        :reset => reset!, :info => info! };
    // Rows are streamed only where the database is: a fold handed to a server
    // would run its handler in the server, which is not where a program
    // expects its own code to run. Elsewhere `sql.fold!` reads the whole
    // result, which is the same answer.
    sql.connection sql.sqlite %{ :db => db, :place => place }
                   (if place == foreign.here { effects.[:fold => fold_rows!] } else { effects })
};

priv let open_readonly : :integer;
priv let open_readonly = 1;
priv let open_readwrite : :integer;
priv let open_readwrite = 2;
priv let open_create : :integer;
priv let open_create = 4;
priv let open_uri : :integer;
priv let open_uri = 64;

priv let open_here! : :string -> :integer -> Options -> sqlite3.Db;
priv let open_here! path flags options = {
    let [rc, opened] = sqlite3.open! path flags ();
    match opened {
        () => sql.fail! "out of memory" (code_of rc) path,
        db => {
            if rc != 0 {
                // SQLite hands back a handle even when it could not open the
                // file, so that the reason can be read from it; it still has
                // to be closed.
                let message = sqlite3.errmsg! db;
                strict! message
                foreign.release! db
                sql.fail! message (code_of rc) path
            } else { () }
            sqlite3.busy_timeout! db options.[:busy_timeout else 5000]
            if options.[:foreign_keys else true] { exec_here! db "PRAGMA foreign_keys = ON" } else { () }
            db
        },
    }
};

/// The version of the library, as it says it: `"3.45.1"`.
let version : :unit -> :string;
let version u = sqlite3.libversion ();

/// Whether the library can be loaded here at all.
let available! : :unit -> :bool;
let available! u = try! {
    let v = sqlite3.libversion ();
    strict! v
    true
} catch e { false };

// --- the driver ---------------------------------------------------------------
//
// Each effect is a function of the connection's state, run where the database
// lives. What is read from a statement is forced as it is read: a value left
// suspended would be read later, after the statement had stepped on or been
// finalized.

priv let run! : :map -> :string -> [sql.Value] -> sql.Outcome;
priv let run! state text params = {
    let db = state.[:db];
    foreign.run! state.[:place] (fn () -> run_here! db text params)
};

priv let run_here! : sqlite3.Db -> :string -> [sql.Value] -> sql.Outcome;
priv let run_here! db text params = {
    let [rc, st] = sqlite3.prepare! db text (len text) ();
    if rc != 0 { fail_db! db text } else { () }
    match st {
        // Text with no statement in it -- a comment, or nothing -- prepares to
        // NULL, and there is nothing to run.
        () => sql.no_rows 0 (),
        _ => foreign.using! st (fn st -> execute! db st text params),
    }
};

priv let execute! : sqlite3.Db -> sqlite3.Stmt -> :string -> [sql.Value] -> sql.Outcome;
priv let execute! db st text params = {
    bind_all! db st text 1 params
    let n = sqlite3.column_count! st;
    let names = column_names! st 0 n [];
    let metadata = metadata! st 0 n [];
    let before = sqlite3.total_changes! db;
    let rows = step_rows! db st text n [];
    // `changes` and the last row's id belong to the last statement that
    // wrote, which is not this one if this one only read.
    let wrote = sqlite3.readonly! st == 0;
    let changes = if wrote && sqlite3.total_changes! db != before { sqlite3.changes! db } else { 0 };
    let last_id = if wrote { sqlite3.last_insert_rowid! db } else { () };
    strict! changes
    strict! last_id
    %{ :columns => names, :rows => rows, :changes => changes, :last_id => last_id,
       :metadata => metadata, :command => (), :status => if sqlite3.autocommit! db == 1 { :idle } else { :transaction },
       :notices => [], :notifications => [] }
};

/// Cons, forcing the head.
priv let keep : a -> [a] -> [a];
priv let keep !x xs = list.cons x xs;

priv let column_names! : sqlite3.Stmt -> :integer -> :integer -> [:string] -> [:string];
priv let rec column_names! st !i n !acc =
    if i >= n { list.reverse acc }
    else {
        let name = sqlite3.column_name! st i;
        column_names! st (i + 1) n (keep name acc)
    };

priv let step_rows! : sqlite3.Db -> sqlite3.Stmt -> :string -> :integer -> [[sql.Value]] -> [[sql.Value]];
priv let rec step_rows! db st text n !acc = {
    let rc = sqlite3.step! st;
    match rc {
        100 => {
            let row = read_row! st 0 n [];
            step_rows! db st text n (keep row acc)
        },
        101 => list.reverse acc,
        _ => fail_db! db text,
    }
};

priv let read_row! : sqlite3.Stmt -> :integer -> :integer -> [sql.Value] -> [sql.Value];
priv let rec read_row! st !i n !acc =
    if i >= n { list.reverse acc }
    else {
        let v = column_value! st i;
        read_row! st (i + 1) n (keep v acc)
    };

priv let column_value! : sqlite3.Stmt -> :integer -> sql.Value;
priv let column_value! st i = {
    let kind = sqlite3.column_type! st i;
    let v = match kind {
        1 => sqlite3.column_int64! st i,
        2 => sqlite3.column_double! st i,
        3 => text_bytes! st i,
        4 => blob_bytes! st i,
        _ => (),
    };
    strict! v
    v
};

priv let blob_bytes! : sqlite3.Stmt -> :integer -> sql.Value;
priv let blob_bytes! st i = {
    // The pointer first and then the length, the order SQLite asks for: the
    // length is only settled once the value is in the form being read.
    let p = sqlite3.column_blob! st i;
    let n = sqlite3.column_bytes! st i;
    strict! p
    strict! n
    if n == 0 { sql.blob "" }
    else {
        let b = foreign.buffer! n;
        libc.copy! b p n
        let bytes = foreign.read! b 0 n;
        strict! bytes
        foreign.release! b
        sql.blob bytes
    }
};

/// `SQLITE_TRANSIENT`: SQLite copies what it is given before the call returns,
/// so a Dream string may move afterwards.
priv let transient : :integer;
priv let transient = 0 - 1;

priv let bind_all! : sqlite3.Db -> sqlite3.Stmt -> :string -> :integer -> [sql.Value] -> :unit;
priv let rec bind_all! db st text !i params = match params {
    [] => (),
    [v, ..rest] => {
        let rc = bind_one! st i v;
        if rc != 0 { fail_db! db text } else { () }
        bind_all! db st text (i + 1) rest
    },
};

priv let bind_one! : sqlite3.Stmt -> :integer -> sql.Value -> :integer;
priv let rec bind_one! st i v = match v {
    [:json, text] => sqlite3.bind_text! st i text (len text) transient,
    [:native_value, :sqlite, raw] => bind_one! st i raw,
    () => sqlite3.bind_null! st i,
    true => sqlite3.bind_int64! st i 1,
    false => sqlite3.bind_int64! st i 0,
    [:blob, bytes] => sqlite3.bind_blob! st i bytes (len bytes) transient,
    _ => match type_of v {
        :integer => sqlite3.bind_int64! st i v,
        :float => sqlite3.bind_double! st i v,
        _ => sqlite3.bind_text! st i v (len v) transient,
    },
};

/// The rows `batch` at a time, each batch handed to `step!` as it is read,
/// so a result of any size is held a batch at a time.
priv let fold_rows! : :map -> :string -> [sql.Value] -> :integer -> (a -> [:string] -> [[sql.Value]] -> a) -> a -> a;
priv let fold_rows! state text params batch step! init = {
    let db = state.[:db];
    let [rc, st] = sqlite3.prepare! db text (len text) ();
    if rc != 0 { fail_db! db text } else { () }
    match st {
        () => init,
        _ => foreign.using! st (fn st -> {
            bind_all! db st text 1 params
            let n = sqlite3.column_count! st;
            let names = column_names! st 0 n [];
            fold_steps! db st text n names batch step! init [] 0
        }),
    }
};

priv let fold_steps! : sqlite3.Db -> sqlite3.Stmt -> :string -> :integer -> [:string] -> :integer
                       -> (a -> [:string] -> [[sql.Value]] -> a) -> a -> [[sql.Value]] -> :integer -> a;
priv let rec fold_steps! db st text n names batch step! !acc !pending !count = {
    let rc = sqlite3.step! st;
    match rc {
        100 => {
            let row = read_row! st 0 n [];
            if count + 1 >= batch {
                let next = step! acc names (list.reverse (keep row pending));
                strict! next
                fold_steps! db st text n names batch step! next [] 0
            } else { fold_steps! db st text n names batch step! acc (keep row pending) (count + 1) }
        },
        101 => if list.is_empty pending { acc } else { step! acc names (list.reverse pending) },
        _ => fail_db! db text,
    }
};

priv let run_many! : :map -> :string -> [[sql.Value]] -> :integer;
priv let run_many! state text param_lists = {
    let db = state.[:db];
    foreign.run! state.[:place] (fn () -> many_here! db text param_lists)
};

/// One statement prepared once, and reset and bound again for each row.
priv let many_here! : sqlite3.Db -> :string -> [[sql.Value]] -> :integer;
priv let many_here! db text param_lists = {
    let [rc, st] = sqlite3.prepare! db text (len text) ();
    if rc != 0 { fail_db! db text } else { () }
    match st {
        () => 0,
        _ => foreign.using! st (fn st -> each_row! db st text (sqlite3.readonly! st == 0) param_lists 0),
    }
};

priv let each_row! : sqlite3.Db -> sqlite3.Stmt -> :string -> :bool -> [[sql.Value]] -> :integer -> :integer;
priv let rec each_row! db st text wrote params !total = match params {
    [] => total,
    [ps, ..rest] => {
        sqlite3.reset! st
        sqlite3.clear_bindings! st
        bind_all! db st text 1 ps
        drain! db st text
        let changed = if wrote { sqlite3.changes! db } else { 0 };
        each_row! db st text wrote rest (total + changed)
    },
};

priv let drain! : sqlite3.Db -> sqlite3.Stmt -> :string -> :unit;
priv let rec drain! db st text = {
    let rc = sqlite3.step! st;
    match rc {
        100 => drain! db st text,
        101 => (),
        _ => fail_db! db text,
    }
};

priv let script! : :map -> :string -> :unit;
priv let script! state text = {
    let db = state.[:db];
    foreign.run! state.[:place] (fn () -> exec_here! db text)
};

priv let exec_here! : sqlite3.Db -> :string -> :unit;
priv let exec_here! db text = {
    let rc = sqlite3.exec! db text () () ();
    if rc != 0 { fail_db! db text } else { () }
};

priv let close! : :map -> :unit;
priv let close! state = {
    let db = state.[:db];
    foreign.run! state.[:place] (fn () -> foreign.release! db)
};

// --- reusable statements, scripts and session state ----------------------------

priv let prepare_statement! : :map -> :string -> [:any] -> :map;
priv let prepare_statement! state text params = foreign.run! state.[:place] (fn () -> {
    let [rc, st] = sqlite3.prepare! state.[:db] text (len text) ();
    if rc != 0 { fail_db! state.[:db] text } else { () }
    if st == () { sql.fail! "cannot prepare an empty statement" :parameters text } else { () }
    %{ :stmt => st, :text => text }
});

priv let execute_statement! : :map -> :map -> [:any] -> sql.Outcome;
priv let execute_statement! state prepared params = foreign.run! state.[:place] (fn () -> {
    let st = prepared.[:stmt];
    sqlite3.reset! st
    sqlite3.clear_bindings! st
    execute! state.[:db] st prepared.[:text] params
});

priv let deallocate_statement! : :map -> :map -> :unit;
priv let deallocate_statement! state prepared = foreign.run! state.[:place] (fn () -> foreign.release! prepared.[:stmt]);

priv let script_results! : :map -> :string -> [sql.Outcome];
priv let script_results! state text = foreign.run! state.[:place]
    (fn () -> script_parts! state.[:db] (lint.scan text false) "" []);

// sqlite3_complete understands CREATE TRIGGER bodies; lexical semicolons
// alone do not. No splitting inside quotes, comments or trigger BEGIN/END.
priv let script_parts! : sqlite3.Db -> [:any] -> :string -> [sql.Outcome] -> [sql.Outcome];
priv let rec script_parts! db tokens pending !results = match tokens {
    [] => if str.trim pending == "" || lint.problem pending == "the statement is empty" { list.reverse results }
          else { let result = run_here! db pending []; strict! result; list.reverse (list.cons result results) },
    [token, ..rest] => {
        let text = pending + lint.token_text token;
        if token == [:semicolon] && sqlite3.complete! text == 1 {
            let result = run_here! db text [];
            strict! result
            script_parts! db rest "" (list.cons result results)
        } else { script_parts! db rest text results }
    },
};

priv let reset! : :map -> :unit;
priv let reset! state = foreign.run! state.[:place] (fn () -> {
    if sqlite3.autocommit! state.[:db] == 0 { exec_here! state.[:db] "ROLLBACK" } else { () }
});

priv let info! : :map -> :map;
priv let info! state = %{ :server_version => version () };

priv let metadata! : sqlite3.Stmt -> :integer -> :integer -> [:map] -> [:map];
priv let rec metadata! st i n !acc = if i >= n { list.reverse acc } else {
    let name = sqlite3.column_name! st i;
    let declared = sqlite3.column_decltype! st i;
    let column = %{ :name => name, :native_type => declared };
    strict! column
    metadata! st (i + 1) n (list.cons column acc)
};

priv let text_bytes! : sqlite3.Stmt -> :integer -> :string;
priv let text_bytes! st i = {
    let pointer = sqlite3.column_text_bytes! st i;
    let n = sqlite3.column_bytes! st i;
    strict! pointer
    if n == 0 { "" } else {
        let buffer = foreign.buffer! n;
        foreign.using! buffer (fn buffer -> {
            libc.copy! buffer pointer n
            let bytes = foreign.read! buffer 0 n;
            strict! bytes
            bytes
        })
    }
};

// --- errors -------------------------------------------------------------------

priv let fail_db! : sqlite3.Db -> :string -> :never;
priv let fail_db! db text = {
    let message = sqlite3.errmsg! db;
    let code = sqlite3.extended_errcode! db;
    strict! message
    strict! code
    sql.fail_with! %{ :message => message, :code => code_named code message, :sql => text, :sqlite_code => code }
};

/// SQLite says what kind of mistake a statement is in its message rather than
/// its code, which is `SQLITE_ERROR` for all of them; the messages are stable,
/// and these three are the ones a program asks about.
priv let code_named : :integer -> :string -> :any;
priv let code_named code message =
    if code != 1 { code_of code }
    else if str.contains_str "syntax error" message { :syntax }
    else if str.starts_with "no such table" message { :undefined_table }
    else if str.starts_with "no such column" message { :undefined_column }
    else { code };

/// SQLite's extended result codes, in the words `std.sql.fail!` lists, so that
/// a program can catch a duplicate key without knowing it was SQLite that
/// refused it. A code with no word stays the number.
priv let code_of : :integer -> :any;
priv let code_of code = match code {
    2067 => :unique,
    1555 => :unique,
    787 => :foreign_key,
    1299 => :not_null,
    275 => :check,
    _ => match code % 256 {
        19 => :constraint,
        5 => :busy,
        6 => :locked,
        8 => :readonly,
        3 => :permission,
        23 => :permission,
        9 => :canceled,
        14 => :cantopen,
        _ => code,
    },
};

when test {
    import std.console;
    import std.error;
    import std.test;

    let age_of : :any -> :integer;
    let age_of row = match row.[:age] { () => 0, n => n };

    /// A record whose fields are the columns, which is therefore a row.
    mapping Person {
        id = ()
        name
        age = ()
    }

    /// `f` against a fresh database in memory, or nothing where the library
    /// cannot be loaded -- `test-std` runs on machines that have no SQLite,
    /// and says so rather than failing.
    let with_db! : (sql.Connection -> :any) -> :any;
    let with_db! f = if available! () { sql.using! (memory! ()) f } else { :ok };

    let kind_of! : (:unit -> :any) -> :any;
    let kind_of! work = try! {
        let v = work ();
        strict! v
        :no_error
    } catch e { if sql.is_sql_error e { sql.error_code e } else { error.kind e } };

    let schema = sql.create_table "people" [
        sql.column "id" :integer |> sql.auto_increment,
        sql.column "name" :text |> sql.not_null |> sql.unique,
        sql.column "age" :integer,
        sql.column "photo" :blob,
        sql.column "score" :float |> sql.default 1.5,
    ];

    let people = [
        %{ :name => "ada", :age => 36, :photo => sql.blob (str.of_bytes [0, 1, 255]) },
        %{ :name => "bob", :age => 17 },
        %{ :name => "cy", :age => sql.null, :photo => sql.blob "" },
    ];

    let seeded! db = {
        sql.exec! db schema
        sql.exec_many! db (list.map (fn p -> sql.insert_into "people" |> sql.values p) people)
        db
    };

    let tests = [
        test.case "the library" $( {
            if available! () { () }
            else { console.print! "  (no libsqlite3 here: the std.sql.sqlite tests are skipped)" }
            :ok
        } ),
        test.case "values come back as they went in" $( with_db! (fn db -> test.eq!
            [[1, "x", 2.5, (), [:blob, "a\0b"]]]
            (sql.run! db (sql.q "select ?, ?, ?, ?, ?" [1, "x", 2.5, (), sql.blob "a\0b"])).[:rows]) ),
        test.case "a row is keyed by atom where the program has the atom" $( with_db! (fn db -> test.eq!
            [%{ :a => 1, :b => "two", "zz_no_atom_has_this_name" => 3 }]
            (sql.query! db "select 1 as a, 'two' as b, 3 as zz_no_atom_has_this_name")) ),
        test.case "a template's names are its parameters" $( with_db! (fn db -> {
            seeded! db
            let min_age = 18;
            let starts = sql.like "name" "a%";
            test.eq! ["ada"] (sql.column! db (expand sql.query "SELECT name FROM people WHERE age >= {min_age} AND {..starts}"))
        }) ),
        test.case "a template's list form" $( with_db! (fn db -> {
            seeded! db
            test.eq! [17] (sql.column! db (expand sql.query ["SELECT age FROM people WHERE age < ", 20 - 1]))
        }) ),
        test.case "a record goes in as it is, and comes out as one" $( with_db! (fn db -> {
            seeded! db
            sql.exec! db (sql.insert_into "people" |> sql.values (Person.new "dee"))
            let dee = sql.one! db (sql.select ["id", "name", "age"] |> sql.from "people" |> sql.where (sql.eq "name" "dee"));
            test.eq! [4, "dee", ()] [Person.id dee, Person.name dee, Person.age dee]
        }) ),
        test.case "fold reads in batches" $( with_db! (fn db -> {
            seeded! db
            test.eq! [53, 3] [sql.fold! db (sql.select ["age"] |> sql.from "people") 2
                                        (fn total row -> total + age_of row) 0,
                              sql.each! db (sql.select [] |> sql.from "people") 1 (fn row -> row)]
        }) ),
        test.case "a transaction that takes the lock first" $( with_db! (fn db -> {
            seeded! db
            test.eq! 3 (sql.transaction_with! db %{ :lock => :immediate }
                (fn tx -> sql.scalar! tx (sql.select [sql.count_all] |> sql.from "people")))
        }) ),
        test.case "a serializable transaction answers" $( with_db! (fn db ->
            test.eq! 1 (sql.serializable! db 3 (fn tx -> sql.scalar! tx "select 1"))) ),
        test.case "a missing table is :undefined_table" $( with_db! (fn db ->
            test.eq! :undefined_table (kind_of! (fn () -> sql.query! db "select * from nowhere"))) ),
        test.case "inserts in one prepared statement" $( with_db! (fn db -> {
            seeded! db
            test.eq! 3 (sql.scalar! db (sql.select [sql.count_all] |> sql.from "people"))
        }) ),
        test.case "a default is filled" $( with_db! (fn db -> {
            seeded! db
            test.eq! [1.5, 1.5, 1.5] (sql.column! db (sql.select ["score"] |> sql.from "people"))
        }) ),
        test.case "blobs, empty and not" $( with_db! (fn db -> {
            seeded! db
            test.eq! [[:blob, (str.of_bytes [0, 1, 255])], (), [:blob, ""]]
                     (sql.column! db (sql.select ["photo"] |> sql.from "people" |> sql.order_by ["id"]))
        }) ),
        test.case "a query with every clause" $( with_db! (fn db -> {
            seeded! db
            test.eq! [%{ :name => "ada" }]
                     (sql.query! db (sql.select ["name"] |> sql.from "people"
                                     |> sql.where (sql.ge "age" 18) |> sql.where (sql.like "name" "a%")
                                     |> sql.order_by [sql.desc "age"] |> sql.limit 5))
        }) ),
        test.case "returning" $( with_db! (fn db -> {
            seeded! db
            test.eq! [%{ :id => 4, :name => "dee" }]
                     (sql.query! db (sql.insert_into "people" |> sql.values %{ "name" => "dee" }
                                     |> sql.returning ["id", "name"]))
        }) ),
        test.case "an update counts what it changed" $( with_db! (fn db -> {
            seeded! db
            test.eq! 2 (sql.exec! db (sql.update "people" |> sql.set %{ "age" => sql.q "age + 1" [] }
                                      |> sql.where (sql.is_not_null "age"))).[:changes]
        }) ),
        test.case "an upsert" $( with_db! (fn db -> {
            seeded! db
            sql.exec! db (sql.insert_into "people" |> sql.values %{ "name" => "bob", "age" => 50 }
                          |> sql.on_conflict_update ["name"] ["age"])
            test.eq! 50 (sql.scalar! db (sql.select ["age"] |> sql.from "people" |> sql.where (sql.eq "name" "bob")))
        }) ),
        test.case "a duplicate is a :unique error" $( with_db! (fn db -> {
            seeded! db
            test.eq! :unique (kind_of! (fn () -> sql.exec! db (sql.insert_into "people" |> sql.values %{ "name" => "ada" })))
        }) ),
        test.case "bad SQL the compiler did not see is a :syntax error" $( with_db! (fn db ->
            test.eq! :syntax (kind_of! (fn () -> sql.query! db (sql.raw "selec 1")))) ),
        test.case "a transaction that raises leaves nothing" $( with_db! (fn db -> {
            seeded! db
            kind_of! (fn () -> sql.transaction! db (fn tx -> {
                sql.exec! tx (sql.delete_from "people")
                raise! :changed_my_mind
            }))
            test.eq! 3 (sql.scalar! db (sql.select [sql.count_all] |> sql.from "people"))
        }) ),
        test.case "a nested transaction is a savepoint" $( with_db! (fn db -> {
            seeded! db
            sql.transaction! db (fn tx -> {
                sql.exec! tx (sql.delete_from "people" |> sql.where (sql.eq "name" "ada"))
                kind_of! (fn () -> sql.transaction! tx (fn inner -> {
                    sql.exec! inner (sql.delete_from "people")
                    raise! :no
                }))
            })
            test.eq! ["bob", "cy"] (sql.column! db (sql.select ["name"] |> sql.from "people" |> sql.order_by ["name"]))
        }) ),
        test.case "one! wants one" $( with_db! (fn db -> {
            seeded! db
            test.eq! :not_one (kind_of! (fn () -> sql.one! db (sql.select [] |> sql.from "people")))
        }) ),
        test.case "migrations run once" $( with_db! (fn db -> {
            let ms = [
                [2, "add", sql.insert_into "t" |> sql.values %{ "x" => 1 }],
                [1, "make", [sql.create_table "t" [sql.column "x" :integer]]],
            ];
            let first = sql.migrate! db ms;
            let again = sql.migrate! db ms;
            test.eq! [[1, 2], [], 1] [first, again, sql.scalar! db (sql.select [sql.count_all] |> sql.from "t")]
        }) ),
        test.case "a script runs every statement" $( with_db! (fn db -> {
            sql.script! db "create table a (x); insert into a values (1); insert into a values (2);"
            test.eq! 3 (sql.scalar! db (sql.select [sql.sum "x"] |> sql.from "a"))
        }) ),
        test.case "an empty statement is nothing" $( with_db! (fn db ->
            test.eq! [] (sql.query! db (sql.raw "-- nothing"))) ),
        test.case "a database in a server" $( {
            if available! () {
                let server = foreign.start! ();
                let db = open_with! ":memory:" %{ :place => server };
                sql.script! db "create table s (x); insert into s values (7);"
                let seven = sql.scalar! db (sql.raw "select x from s");
                sql.close! db
                foreign.stop! server
                test.eq! 7 seven
            } else { :ok }
        } ),
    ];
}
