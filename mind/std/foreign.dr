// Wrapping a C library.
//
// `std.ffi` is the VM's half: it binds a symbol to a signature, owns what C
// hands back, and checks every pointer that crosses. This is the half a person
// writes against -- though most of it is written for them, by a declaration:
//
//     foreign sqlite from embedded "sqlite" {
//         resource Db = sqlite3_close
//         resource Stmt = sqlite3_finalize
//
//         open! : :cstr -> out Db -> :int = sqlite3_open
//         prepare! : Db -> :cstr -> :int -> out Stmt -> :ptr -> :int = sqlite3_prepare_v2
//         libversion : :void -> :cstr = sqlite3_libversion
//     }
//
// which the compiler makes a module (`syntax.foreign_decl` in dreams): each
// function bound with the `ffi.function` its C signature describes, and signed
// with the Dream type that signature means on this side. The vocabulary it is
// written in is `Arg` and `Result` below; docs/ffi.md is the whole of it.
//
// What is left here is what a declaration cannot say.
//
// **A pointer is owned.** What `[:own, tag, destructor]` answers is a handle,
// and the process that made the call owns the pointer behind it until it says
// `release!` or ends. Releasing a handle releases what was made from it first,
// so closing a database cannot leave a statement pointing into it. `using!`
// is the scoped form. The rules are at the head of dream/src/ffi.cpp.
//
// **Memory is a buffer.** `buffer!`, and the struct layouts a declaration's
// `struct` is made of: sized, owned, and bounds-checked on every access.
//
// **A library can be a process.** Most C libraries were not written for a
// program with many threads in it, and most own things that must be let go.
// Both are what a process is for here. `start!` makes a server that owns every
// resource made through it: work reaches the library one piece at a time, a
// piece that raises is answered as an error rather than stopping the server,
// and when the server stops -- asked, or crashed, or by its supervisor -- every
// destructor runs, newest first. Its clients hold handles that name its
// resources and mean nothing anywhere else.
//
//     let db_server = foreign.start! ();
//     let [status, db] = foreign.run! db_server (fn () -> sqlite.open! "notes.db");
//
// `run!` takes either a server or `foreign.here`, so a wrapper written once
// over a place serves both.
//
// **Signatures built at run time.** `function` and `pure_function` are what a
// declaration compiles to, for a program whose signature is data it computed.

import std.ffi;
import std.list;
import std.os;

// --- the vocabulary ------------------------------------------------------------

/// A number, in C's width. The first row is exact; the second is C's own
/// names, whose widths are the platform's (`:long` is 32 bits on Windows) and
/// are settled by the VM, so a binding written from a header is right wherever
/// it runs. There is no `:float`: in Dream that is a double, and a signature is
/// exactly where the two readings would be confused -- say `:f32`.
type Scalar = :bool | :i8 | :i16 | :i32 | :i64 | :u8 | :u16 | :u32 | :u64 | :f32 | :f64
            | :char | :uchar | :short | :ushort | :int | :uint | :long | :ulong
            | :longlong | :ulonglong | :size | :ssize | :intptr | :uintptr | :double;

/// What C hands back, by return or through an `out`.
///
/// `:cstr` copies the string and leaves the pointer alone; `[:cstr, "free"]`
/// copies it and then frees it with the named destructor. `:ptr` is a raw
/// address, as an integer or `()` for null -- the escape hatch, and the one
/// type here that checks nothing.
type Result = :void | Scalar | :ptr | :cstr
            | [:own, :string, :string]
            | [:borrow, :string]
            | [:cstr, :string];

/// What a callback may take and answer. Numbers and addresses only: a callback
/// runs while C is on the stack, and nothing that needs managing may cross.
type CallbackArg = Scalar | :ptr | :cstr;
type CallbackResult = Scalar | :void | :ptr;

/// What C takes.
///
/// `:cstr` is a string passed as a NUL-terminated pointer, and `:bytes` the
/// same without the promise of a terminator, which is also how a payload view
/// is passed. `[:handle, tag]` is a live handle of that tag and nothing else;
/// `:buffer` is `[:handle, "buffer"]`. `[:out, t]` is not passed at all: C is
/// given somewhere to write, and the call answers `[result, out, ..]`.
type Arg = Scalar | :ptr | :cstr | :bytes | :buffer
         | [:handle, :string]
         | [:out, Result]
         | [:callback, [CallbackArg], CallbackResult];

/// Where a library is: a path the platform's loader understands, `()` for the
/// program itself (which is the C library, on any normal system), a file
/// carried in the image's payload, a library installed on the system and
/// searched for (`system`), or the first of several that opens (`any_of`).
type Library = :unit | :string | [:payload, :string | :integer]
             | [:search, :string, [:string], [:string]]
             | [:any, [:any]];

/// A pointer this process owns, by its tag: `type Db = foreign.Handle "sqlite3"`.
/// Two tags are two types, so a statement where a database is wanted is a
/// compile error wherever the checker can see both.
type Handle tag = [:foreign, tag, :integer];

type Buffer = Handle "buffer";

// Spelled as functions too, for a signature built rather than written.

let own : :string -> :string -> Result;
let own tag destructor = [:own, tag, destructor];

let borrow : :string -> Result;
let borrow tag = [:borrow, tag];

let handle : :string -> Arg;
let handle tag = [:handle, tag];

let out : Result -> Arg;
let out t = [:out, t];

let callback : [CallbackArg] -> CallbackResult -> Arg;
let callback args result = [:callback, args, result];

/// A string C allocated and the caller must free.
let taken : :string -> Result;
let taken destructor = [:cstr, destructor];

// --- libraries and functions -------------------------------------------------------

let library : :string -> Library;
let library path = path;

// --- finding a library on the system -----------------------------------------
//
// A library installed on the system has a different file name on every
// platform and a different home on every distribution: `libsqlite3.so.0` in
// the loader's path on Debian, Homebrew's prefix on macOS (which the loader
// never searches), a store path on NixOS. Naming one file and handing it to
// the loader is right on one machine. So `system` describes a *search* --
// the names the file goes by here, best first, and the directories a package
// manager puts libraries in -- and the VM does the looking when the library is
// first used: `$DREAM_LIB_<NAME>`, then `$DREAM_LIBRARY_PATH` and the
// installation's `lib`, then the platform's loader, then these directories.
// What it tried is the error when nothing is found. "Finding a library" in
// dream/src/ffi.cpp is that half.
//
// The descriptor is computed here rather than in the VM because it is
// knowledge, not mechanism, and it wants to be read and tested.
//
// This lives here rather than with the library that wants it because a
// `foreign` declaration's `from (..)` is compiled inside the module the
// declaration makes, which sees `std.ffi` and `std.foreign` and nothing else.

/// A library installed on the system, by its name without `lib` or an
/// extension: `system "sqlite3"` is whichever `libsqlite3.so`,
/// `libsqlite3.dylib` or `sqlite3.dll` this machine has, newest first.
/// `foreign sqlite from system "sqlite3" { .. }` says the same.
let system : :string -> Library;
let system name = search_on (os.platform ()) (os.arch ()) name "";

/// The same, held to one ABI version -- the number in the library's soname:
/// `system_version "sqlite3" "0"` is `libsqlite3.so.0` on Linux and
/// `libsqlite3.0.dylib` on macOS, and never a `libsqlite3.so.1` that happens
/// to be beside it, which would load and then fail to mean the same thing.
let system_version : :string -> :string -> Library;
let system_version name version = search_on (os.platform ()) (os.arch ()) name version;

/// The first of `libs` that opens: `any_of [embedded "sqlite", system "sqlite3"]`
/// carries a copy for the machines that lack one, and prefers what is there.
let any_of : [Library] -> Library;
let any_of libs = [:any, libs];

/// Where a library is found -- `[:ok, file]` -- or `[:error, why]`, the same
/// account of what was looked for and where that using it would raise. It
/// opens the library to find out, since a file that is there but built for
/// another machine is not one this program can use.
let locate! : Library -> [:ok, :string] | [:error, :string];
let locate! lib = ffi.locate! lib;

/// The search `system` makes, for a given platform and architecture.
let search_on : :atom -> :atom -> :string -> :string -> Library;
let search_on platform arch name version =
    [:search, name, library_files platform name version, library_dirs platform arch];

/// What the file is called, best first. A `*` is a version, and in a
/// directory means the newest one there.
let library_files : :atom -> :string -> :string -> [:string];
let library_files platform name version = match [platform, version] {
    [:windows, ""] => [name + ".dll", "lib" + name + ".dll", "lib" + name + "-*.dll"],
    [:windows, v] => [name + ".dll", "lib" + name + "-" + v + ".dll", "lib" + name + ".dll"],
    [:macos, ""] => ["lib" + name + ".dylib", "lib" + name + ".*.dylib"],
    [:macos, v] => ["lib" + name + "." + v + ".dylib", "lib" + name + "." + v + ".*.dylib"],
    [_, ""] => ["lib" + name + ".so", "lib" + name + ".so.*"],
    [_, v] => ["lib" + name + ".so." + v, "lib" + name + ".so." + v + ".*"],
};

/// Where package managers put libraries the platform's loader may not know
/// about, most deliberate first. A `~` is the home directory. Windows has no
/// such convention: its loader's search, `PATH` included, is all there is.
let library_dirs : :atom -> :atom -> [:string];
let library_dirs platform arch = match platform {
    :windows => [],
    :macos => ["/opt/homebrew/lib", "/usr/local/lib", "/opt/local/lib"] + nix_dirs,
    _ => {
        let multiarch = match multiarch_triplet arch {
            () => [],
            t => ["/usr/lib/" + t, "/lib/" + t],
        };
        ["/usr/local/lib"] + multiarch
        + ["/usr/lib64", "/usr/lib", "/lib64", "/lib", "/home/linuxbrew/.linuxbrew/lib"] + nix_dirs
    },
};

/// Debian's name for an architecture's library directory, `/usr/lib/TRIPLET`.
priv let multiarch_triplet : :atom -> :string | :unit;
priv let multiarch_triplet arch = match arch {
    :x86_64 => "x86_64-linux-gnu",
    :aarch64 => "aarch64-linux-gnu",
    _ => (),
};

/// Nix keeps nothing where a loader looks; a profile is where what a person
/// installed is gathered.
priv let nix_dirs : [:string];
priv let nix_dirs = ["~/.nix-profile/lib", "/run/current-system/sw/lib",
                     "/nix/var/nix/profiles/default/lib"];

/// The running program, and everything linked into it.
let this_program : Library = ();

/// A library the image carries: `dreams --payload NAME=FILE`.
let embedded : :string -> Library;
let embedded name = [:payload, name];

/// A C function, as a Dream function of its arguments -- every one that is not
/// an `out`. Calling it is an effect, so bind it to a name that says so:
/// `let puts! = foreign.function ..`. Nothing is loaded until the name is
/// first used, and then once per VM.
let function : Library -> :string -> [Arg] -> Result -> :any;
let function lib symbol args result = ffi.function lib symbol args result;

/// The same, for a C function with no effects -- `sqrt`, `strlen` -- which a
/// pure function may call. Only the program can know that it is pure, and a
/// function that is not will be run lazily, perhaps twice, perhaps never.
let pure_function : Library -> :string -> [Arg] -> Result -> :any;
let pure_function lib symbol args result = ffi.pure_function lib symbol args result;

// --- owning -------------------------------------------------------------------------

/// Let go of a handle now, and of everything made from it first.
let release! : Handle :string -> :unit;
let release! h = ffi.release! h;

/// Whether this process still owns `h`.
let alive! : Handle :string -> :bool;
let alive! h = ffi.alive! h;

/// Every handle this process owns, oldest first.
let owned! : :unit -> [Handle :string];
let owned! u = ffi.owned! u;

/// `f h`, and then `h` released, whether `f` answered or raised.
///
/// The answer is forced all the way down before the release: a lazy answer
/// that read through `h` would otherwise be forced later, against a handle
/// that is gone. So `f` should answer data, not an infinite structure.
let using! : Handle t -> (Handle t -> a) -> a;
let using! h f = {
    let answer = try! { strict! (f h) } catch e {
        release_if_alive! h
        raise! e
    };
    release_if_alive! h
    answer
};

/// `f` may have released `h` itself, or released its parent.
priv let release_if_alive! : Handle t -> :unit;
priv let release_if_alive! h = if ffi.alive! h { ffi.release! h } else { () };

// --- memory -------------------------------------------------------------------------
//
// A buffer is memory this process allocated and owns, of a known size, so
// every read and write of it is checked against that size. It is the only
// foreign memory Dream reads directly: a pointer C hands back has no size, and
// reading one would be trusting C about where it ends.

/// `n` bytes, zeroed.
let buffer! : :integer -> Buffer;
let buffer! n = ffi.buffer! n;

/// The bytes of a string, and a terminator, in a buffer C may write to.
let buffer_of! : :string -> Buffer;
let buffer_of! s = {
    let b = ffi.buffer! (len s + 1);
    ffi.write! b 0 s
    b
};

let peek! : Buffer -> :integer -> Scalar | :ptr -> :any;
let peek! b at t = ffi.peek! b at t;

let poke! : Buffer -> :integer -> Scalar | :ptr -> :any -> :unit;
let poke! b at t v = ffi.poke! b at t v;

/// `n` bytes at `at`, as a string.
let read! : Buffer -> :integer -> :integer -> :string;
let read! b at n = ffi.read! b at n;

/// The NUL-terminated string at `at`, stopping at the end of the buffer if C
/// did not terminate it.
let read_string! : Buffer -> :integer -> :string;
let read_string! b at = ffi.read_string! b at;

let write! : Buffer -> :integer -> :string -> :unit;
let write! b at s = ffi.write! b at s;

let sizeof : Scalar | :ptr -> :integer;
let sizeof t = ffi.sizeof t;

let alignof : Scalar | :ptr -> :integer;
let alignof t = ffi.alignof t;

/// A C array of `t`, filled from `xs`.
let array_of! : Scalar | :ptr -> [:any] -> Buffer;
let array_of! t xs = {
    let b = ffi.buffer! (len xs * ffi.sizeof t);
    write_array! b 0 t xs
    b
};

let write_array! : Buffer -> :integer -> Scalar | :ptr -> [:any] -> :unit;
let rec write_array! b at t xs = match xs {
    [] => (),
    [x, ..rest] => {
        ffi.poke! b at t x
        write_array! b (at + ffi.sizeof t) t rest
    },
};

let read_array! : Buffer -> :integer -> Scalar | :ptr -> :integer -> [:any];
let read_array! b at t n = read_array_into! b at t n [];

priv let read_array_into! : Buffer -> :integer -> Scalar | :ptr -> :integer -> [:any] -> [:any];
priv let rec read_array_into! b at t n acc =
    // Read from the end, so consing puts the elements in order.
    if n <= 0 { acc }
    else {
        let x = ffi.peek! b (at + (n - 1) * ffi.sizeof t) t;
        read_array_into! b at t (n - 1) (_list_cons (strict! x) acc)
    };

// --- structs -------------------------------------------------------------------------
//
// A struct is laid out the way C lays it out: each field at the next offset
// its alignment allows, and the whole padded to the widest alignment in it.
// `layout` is pure, so `comp foreign.layout [..]` settles the offsets while
// compiling and the program carries the answer rather than the arithmetic.
//
//     let point = comp foreign.layout [[:x, :i32], [:y, :double], [:tag, :u8]];
//     let b = foreign.struct_buffer! point;
//     fill! b 3 1.5
//     foreign.read_struct! b 0 point          // %{ :x => 3, :y => 1.5, :tag => 7 }

type Layout = %{ :size => :integer, :align => :integer, :fields => :map, :order => [:atom] };

let layout : [[:atom, Scalar | :ptr]] -> Layout;
let layout fields = {
    let raw = list.fold place_field %{ :size => 0, :align => 1, :fields => %{}, :order => [] } fields;
    raw.[:size => round_up raw.[:size] raw.[:align]]
};

priv let place_field : Layout -> [:atom, Scalar | :ptr] -> Layout;
priv let place_field acc [name, t] = {
    let a = ffi.alignof t;
    let at = round_up acc.[:size] a;
    %{
        :size => at + ffi.sizeof t,
        :align => if a > acc.[:align] { a } else { acc.[:align] },
        :fields => acc.[:fields].[name => [at, t]],
        :order => acc.[:order] + [name],
    }
};

priv let round_up : :integer -> :integer -> :integer;
priv let round_up n a = (n + a - 1) / a * a;

/// The offset of a field, for a program that wants to `peek!` one alone.
let offset_of : Layout -> :atom -> :integer;
let offset_of shape name = shape.[:fields].[name].[0];

/// A zeroed buffer the size of one struct.
let struct_buffer! : Layout -> Buffer;
let struct_buffer! shape = ffi.buffer! shape.[:size];

/// Every field of the struct at `at`, as a map.
let read_struct! : Buffer -> :integer -> Layout -> :map;
let read_struct! b at shape = read_fields! b at shape shape.[:order] %{};

priv let read_fields! : Buffer -> :integer -> Layout -> [:atom] -> :map -> :map;
priv let rec read_fields! b at shape names acc = match names {
    [] => acc,
    [name, ..rest] => {
        let [offset, t] = shape.[:fields].[name];
        let v = ffi.peek! b (at + offset) t;
        read_fields! b at shape rest acc.[name => strict! v]
    },
};

/// Write the fields `values` has into the struct at `at`, leaving the rest.
let write_struct! : Buffer -> :integer -> Layout -> :map -> :unit;
let write_struct! b at shape values = write_fields! b at shape shape.[:order] values;

priv let write_fields! : Buffer -> :integer -> Layout -> [:atom] -> :map -> :unit;
priv let rec write_fields! b at shape names values = match names {
    [] => (),
    [name, ..rest] => {
        let [offset, t] = shape.[:fields].[name];
        let v = values.[name else ()];
        if v == () { () } else { ffi.poke! b (at + offset) t v }
        write_fields! b at shape rest values
    },
};

// --- a library as a process ------------------------------------------------------------

/// Where a call runs: `here`, in the calling process, or a library server.
type Place = :here | :process;

let here : Place = :here;

/// `work ()`, where `place` says, and its answer, forced. In a server, the
/// handles it answers are the server's, and are only good for handing back to
/// it -- inside another `run!`.
///
/// The work is a function rather than a thunk because a message is evaluated
/// before it leaves: a `$( .. )` would run in the process that sent it. A
/// function is sent as it stands, with what it captured, and called at the
/// other end. So everything a program wants done with a library's resources can
/// go to the server as one message, and come back as one answer:
///
///     foreign.run! db_server (fn () -> {
///         let [status, db] = sqlite.open! "notes.db";
///         sqlite.exec! db "create table t (x)"
///     })
let run! : Place -> (:unit -> a) -> a;
let run! place work =
    if place == :here { strict! (work ()) }
    else { answer_of! (server.call! place work) };

/// Start a library server. What it owns, it owns until it stops.
let start! : :unit -> :process;
let start! u = server.start! u;

/// Stop one, which releases everything it owns.
let stop! : :process -> :any;
let stop! pid = server.stop! pid;

/// A library server as a `std.supervisor` child. A restart is a fresh server
/// that owns nothing, which is the honest answer: every handle the last one
/// gave out died with it, and using one now raises rather than reaching memory
/// that has been freed.
let child! : :string -> :any;
let child! name = server.child! name ();

/// A server answers `[:ok, value]` or `[:error, e]`, so that a call which
/// raised can be raised again in the process that asked -- where it is that
/// process's error, and not the reason the server stopped.
priv let answer_of! : :any -> :any;
priv let answer_of! outcome = match outcome {
    [:ok, value] => value,
    [:error, e] => raise! e,
    other => raise! other,
};

mod server {
    derive std.server;

    let server_name : :any -> :string;
    let server_name u = "foreign library";

    let init! : :any -> :any;
    let init! u = :serving;

    /// Every request is run inside `try!`, and the answer is forced before it
    /// is sent. That is the whole of this server's correctness rather than
    /// tidiness: a reply is copied to the client *as it stands*, so an
    /// unforced answer arrives as the suspended call itself -- and runs in the
    /// client, against the client's resources, where it raises the error this
    /// server was supposed to catch.
    let handle_call! : :any -> :any -> :any -> Action :any :any;
    let handle_call! work from state = {
        let answer = strict! (answer_here! work);
        reply answer state
    };

    let answer_here! : (:unit -> :any) -> :any;
    let answer_here! work = try! {
        // A statement, not an element: `[:ok, strict! x]` suspends the
        // element like any other, and it would raise after `try!` returned.
        let value = strict! (work ());
        [:ok, value]
    } catch e { [:error, e] };

    // `terminate!` is left as the default. The resources go with the process,
    // released by the VM as it finishes -- which also covers a server that
    // crashed, where no handler would have run.
}

when test {
    import std.test;

    // What can be checked without a C library: the layout arithmetic, which is
    // also what a `comp` bakes into a program. The sizes are the ones every
    // 64-bit ABI this VM is built for agrees on; dream/tests/ffi checks the
    // same layout against the C compiler's own `sizeof`.
    let tests = [
        test.case "a field waits for its alignment, and the whole is padded to the widest"
            $( test.eq! [0, 8, 16, 24, 8]
                        (with_shape (layout [[:x, :i32], [:y, :f64], [:tag, :u8]])) ),
        test.case "fields keep the order they were written in"
            $( test.eq! [:b, :a] (layout [[:b, :u8], [:a, :u16]]).[:order] ),
        test.case "small fields pack together"
            $( test.eq! [0, 1, 2, 4, 2]
                        (with_shape (layout [[:a, :u8], [:b, :u8], [:c, :u16]])) ),
        test.case "an empty struct is empty"
            $( test.eq! 0 (layout []).[:size] ),
        test.case "a library is searched for under every name its platform gives it"
            $( test.eq! [["libsqlite3.so.0", "libsqlite3.so.0.*"],
                         ["libsqlite3.dylib", "libsqlite3.*.dylib"],
                         ["sqlite3.dll", "libsqlite3.dll", "libsqlite3-*.dll"]]
                        [library_files :linux "sqlite3" "0", library_files :macos "sqlite3" "",
                         library_files :windows "sqlite3" ""] ),
        test.case "and in the directories its package managers use"
            $( test.eq! [true, true, true, []]
                        [list.contains "/usr/lib/aarch64-linux-gnu" (library_dirs :linux :aarch64),
                         list.contains "/opt/homebrew/lib" (library_dirs :macos :aarch64),
                         list.contains "/run/current-system/sw/lib" (library_dirs :linux :x86_64),
                         library_dirs :windows :x86_64] ),
        test.case "C's own names are the platform's widths"
            $( test.eq! [sizeof :i32, sizeof :size] [sizeof :int, sizeof :uintptr] ),
    ];

    priv let with_shape shape =
        list.map (fn name -> offset_of shape name) shape.[:order] + [shape.[:size], shape.[:align]];
}
