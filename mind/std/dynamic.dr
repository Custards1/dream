derive std.seq;

mod get {
    import std.list
    import std.str
    import std.array
    import std.error;

    /// The left fold for collections of runtime type `kind`.
    let fold_from kind = match kind {
        :list => list.fold,
        :array => array.fold,
        :string => str.fold,
        _=> error.new :type_error ("std.dymanic needs a collection type, got: " + to_string kind)
    }

    /// The map for collections of runtime type `kind`.
    let map_from kind = match kind {
        :list => list.map,
        :array => array.map,
        :string => str.map,
        _=> error.new :type_error ("std.dymanic needs a collection type, got: " + to_string kind)
    }

    /// Positional lookup for collections of runtime type `kind`: a string
    /// answers its byte.
    let nth_from kind = match kind {
        :list => list.nth,
        :array => array.get,
        :string => str.byte,
        _=> error.new :type_error ("std.dymanic needs a collection type, got: " + to_string kind)
    }
    /// Reversal for collections of runtime type `kind`.
    let reverse_from kind = match kind {
        :list => list.reverse,
        :array => array.reverse,
        :string => str.reverse,
        _=> error.new :type_error ("std.dymanic needs a collection type, got: " + to_string kind)
    }
    /// Apply `f`, one of the `_from` choosers, to the runtime type of `i`.
    let reflect f i = f (type_of i)
    /// The chooser for the operation named `fa` -- `:fold`, `:map`, `:nth` or
    /// `:reverse`.
    let from_dy fa = match fa {
        :fold => fold_from,
        :map => map_from,
        :nth => nth_from,
        :reverse => reverse_from,
        _=> error.new :value_error ("std.dymanic needs a real from request. got : " + to_string fa)
    }
}

/// Dispatch a left fold to the implementation registered for the value's runtime type.
let fold : (b -> :any -> b) -> b -> Collection -> b;
let fold f init xa = (get.fold_from (type_of xa)) f init xa;

/// Dispatch mapping to the runtime type's implementation, passing `f` and `init` through.
let map : :any -> :any -> Collection -> :any;
let map f init xa = (get.map_from (type_of xa)) f init xa;

/// Dispatch indexed lookup to the value's runtime type.
let nth : :integer -> Collection -> :any;
let nth i l = (get.nth_from (type_of l)) i l;

/// Dispatch reversal to the value's runtime type.
let reverse : Collection -> Collection;
let reverse c = (get.reverse_from (type_of c) c);

/// Return the protocol name, `dynamic`.
let name : :any -> :string;
let name x = "dynamic"

