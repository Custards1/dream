import std.io;
import std.str;
/// A short write is not an error, so writing means looping until it is all out.
let rec write_all! handle text = {
    let n = str.byte_length text;
    if n == 0 { :done }
    else {
        let wrote = io.write! handle text;
        if wrote >= n { :done } else { write_all! handle (str.slice wrote (n - wrote) text) }
    }
};


// --- optional types ---------------------------------------------------------

import std.types;
type Text = :string;
// Preserve the existing write loop; callers opt into validation at entry.
let write_as! description handle text = write_all! handle (types.check description text);
