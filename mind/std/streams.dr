import std.io;
import std.str;
/// Write all bytes, including when the writer accepts only a prefix. A
/// writer reporting zero or an impossible count is an error, not an infinite
/// retry. Taking the writer explicitly also lets adapters exercise short writes.
let write_all_with! : (:string -> :integer) -> :string -> :atom;
let write_all_with! writer! text = {
    let size = str.byte_length text;
    let rec put! !offset = {
        if offset >= size { :done }
        else {
            let remaining = size - offset;
            let wrote = writer! (str.slice offset remaining text);
            if type_of wrote != :integer || wrote <= 0 || wrote > remaining {
                raise! (_error_new :io_error "write made no progress or returned an invalid byte count")
            }
            put! (offset + wrote)
        }
    };
    put! 0
};

let write_all! : :any -> :string -> :atom;
let write_all! handle text = write_all_with! (io.write! handle) text;

// --- optional types ---------------------------------------------------------

import std.types;
type Text = :string;
// Preserve the existing write loop; callers opt into validation at entry.
let write_as! : :any -> :any -> :string -> :atom;
let write_as! description handle text = write_all! handle (types.check description text);
