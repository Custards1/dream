// The cryptography a PostgreSQL login needs, and nothing more.
//
// A server asks for one of three proofs that the client knows a password:
// the password itself (only sensible on a trusted network), an MD5 digest of
// it, or a SCRAM-SHA-256 exchange. The last is what every PostgreSQL since 14
// asks for by default and the only one that does not let the server, or anyone
// listening, learn something that can log in as you.
//
// **Every primitive is the VM's** (`std.crypto`). This module used to write
// MD5 over nibble tables and PBKDF2 as four thousand rounds of Dream around
// two native digests; both are now one call each, and what is left here is
// the part that is PostgreSQL's: which digest of what, and the SCRAM messages.
//
// What is not here is `SASLprep`, the Unicode normalisation SCRAM asks a
// password to go through first. PostgreSQL itself skips it for any password
// that is not valid UTF-8 and the normalisation changes only passwords with
// unusual code points, so an ASCII password -- or any that normalises to
// itself -- is exactly right, and a server built with the same assumption
// (libpq's) agrees.

import std.crypto;
import std.list;
import std.str;
import std.num;

/// The SHA-256 of `s`, as 32 raw bytes.
let sha256 : :string -> :string;
let sha256 s = crypto.sha256 s;

/// HMAC-SHA-256 (RFC 2104) of `message` under `key`, as raw bytes.
let hmac_sha256 : :string -> :string -> :string;
let hmac_sha256 key message = crypto.hmac :sha256 key message;

/// PBKDF2 with HMAC-SHA-256 (RFC 8018), one block: the 32 bytes SCRAM calls
/// `SaltedPassword`.
let pbkdf2_sha256 : :string -> :string -> :integer -> :string;
let pbkdf2_sha256 password salt iterations = crypto.pbkdf2 :sha256 password salt iterations 32;

/// The MD5 of `s`, as 32 lowercase hex digits -- the spelling PostgreSQL's
/// `md5` authentication exchanges.
let md5_hex : :string -> :string;
let md5_hex s = crypto.hex (crypto.md5 s);

// --- SCRAM-SHA-256 ----------------------------------------------------------------
//
// RFC 5802, with SHA-256 as RFC 7677 has it, as PostgreSQL speaks it: no
// channel binding (`n,,`, which `c=biws` repeats), and an empty user name in
// the client's first message, because the server takes the user from the
// startup message and ignores this one. The two halves are pure, so the whole
// exchange is tested against the RFC's own transcript.

/// Eighteen random bytes as base64, which has no comma in its alphabet and so
/// can stand in a SCRAM attribute as it is.
let scram_nonce! : :unit -> :string;
let scram_nonce! u = crypto.base64 (crypto.random_bytes! 18);

/// The client's first message for `nonce`: `[bare, whole]`. The bare part is
/// signed later, so it is kept.
let scram_first : :string -> [:string, :string];
let scram_first nonce = {
    let bare = "n=,r=" + nonce;
    [bare, "n,," + bare]
};

/// The attributes of a SCRAM message, `r=..,s=..,i=..`, by their letter.
let scram_attributes : :string -> %{:string => :string};
let scram_attributes message = list.fold (fn m part ->
    if len part < 2 { m } else { m.[str.slice 0 1 part => str.slice 2 (len part - 2) part] }
) %{} (str.split "," message);

/// The client's final message, and the signature the server must answer with:
/// `[:ok, [final, server_signature]]`, or `[:error, why]` when the server's
/// first message is not one this client can accept -- a nonce that does not
/// extend ours is a server that is not talking to us.
let scram_final : :string -> :string -> :string -> :string -> [:ok, [:string, :string]] | [:error, :string];
let scram_final password client_nonce client_bare server_first = {
    let attrs = scram_attributes server_first;
    let nonce = attrs.["r" else ""];
    let salt = crypto.unbase64 attrs.["s" else ""];
    let rounds = num.parse_int attrs.["i" else ""];
    if not (str.starts_with client_nonce nonce) || len nonce <= len client_nonce {
        [:error, "the server's nonce does not extend the client's"]
    } else {
        match salt {
            () => [:error, "the server's salt is not base64"],
            s => match rounds {
                i if type_of i == :integer && i > 0 => {
                    let salted = pbkdf2_sha256 password s i;
                    let client_key = hmac_sha256 salted "Client Key";
                    let without_proof = "c=biws,r=" + nonce;
                    let auth = client_bare + "," + server_first + "," + without_proof;
                    let proof = crypto.xor client_key (hmac_sha256 (sha256 client_key) auth);
                    let server_signature = hmac_sha256 (hmac_sha256 salted "Server Key") auth;
                    [:ok, [without_proof + ",p=" + crypto.base64 proof,
                           crypto.base64 server_signature]]
                },
                _ => [:error, "the server's iteration count is not a positive integer"],
            },
        }
    }
};

/// Whether the server's final message proves it knew the password too.
let scram_verified : :string -> :string -> :bool;
let scram_verified server_signature server_final =
    (scram_attributes server_final).["v" else ()] == server_signature;

when test {
    import std.test;

    let tests = [
        test.case "SHA-256 is the VM's, as bytes"
            $( test.eq! "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
                        (crypto.hex (sha256 "abc")) ),
        test.case "HMAC-SHA-256 against RFC 4231's second case"
            $( test.eq! "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
                        (crypto.hex (hmac_sha256 "Jefe" "what do ya want for nothing?")) ),
        test.case "HMAC with a key longer than a block hashes it first"
            $( test.eq! "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
                        (crypto.hex (hmac_sha256 (str.repeat 131 (str.of_bytes [0xaa]))
                                     "Test Using Larger Than Block-Size Key - Hash Key First")) ),
        test.case "PBKDF2-HMAC-SHA-256, one round and many"
            $( test.eq! ["120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
                         "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a"]
                        [crypto.hex (pbkdf2_sha256 "password" "salt" 1),
                         crypto.hex (pbkdf2_sha256 "password" "salt" 4096)] ),
        test.case "MD5 against RFC 1321's suite"
            $( test.eq! ["d41d8cd98f00b204e9800998ecf8427e", "0cc175b9c0f1b6a831c399e269772661",
                         "900150983cd24fb0d6963f7d28e17f72", "f96b697d7cb7938d525a2f31aaf161d0",
                         "c3fcd3d76192e4007dfb496cca67e13b",
                         "57edf4a22be3c955ac49da2e2107b67a"]
                        (list.map md5_hex ["", "a", "abc", "message digest",
                                           "abcdefghijklmnopqrstuvwxyz",
                                           str.repeat 8 "1234567890"]) ),
        test.case "SCRAM-SHA-256 against RFC 7677's exchange"
            $( test.eq! [[:ok, ["c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
                                "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="]], true, false]
                        [scram_final "pencil" "rOprNGfwEbeRWgbNEkqO" "n=user,r=rOprNGfwEbeRWgbNEkqO"
                                     "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096",
                         scram_verified "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=" "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=",
                         scram_verified "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=" "v=AAAA"] ),
        test.case "a SCRAM server whose nonce is not ours is refused"
            $( test.eq! :error (list.head (scram_final "pw" "abc" "n=,r=abc" "r=xyz123,s=QUJD,i=4096")) ),
    ];
}
