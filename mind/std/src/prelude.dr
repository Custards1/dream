// The names every module has without importing them.
//
// A program reaches everything else in the library by importing it, and that
// stays the rule: an import says where a name comes from, and a reader who
// sees `json.parse` knows to look in `std.json`. What is here is the
// exception, and it has to earn it -- a name the *language* answers in, which
// a module cannot opt out of hearing. `let?` is the first: it is written in
// modules that import nothing, it means "carry on when this is `Result.ok` or
// `Option.some`", and it is unfolded by the parser before any name is
// resolved, so the variants it tests have to exist in every module or in
// none. `ok value` and `err reason` are the short constructors for Result;
// they are ordinary functions and may be shadowed like the union names.
//
// The loader loads this module ahead of every other (`modules.load_items!`)
// and `scope` lends its names to each module that does not bind them itself
// (`scope.lend_prelude`), the way a `mod` is lent the names of the file it is
// written in. A module's own `Result`, or an imported one, wins: the prelude
// is consulted last. It imports nothing, so anything may depend on it --
// `std.list` included -- without a cycle.
//
// What to do with a result or an option is written here too, as members, so
// that `Result.map f r` and `Option.unwrap_or 0 o` need no import either. Each
// takes the value it works on *last*, so a chain reads in order through `|>`:
//
//     read path |> Result.and_then parse |> Result.map_error describe
//
// A member that passes a failure on rebuilds it -- `error(why) => error why`
// -- rather than answering the value it was given, because the two have
// different types to the checker (`Result a e` in, `Result b e` out). The
// compiler knows these members (`dreams/src/fuse.dr`, "Results"), and a call
// of one it can see is lowered in place, where a failure is passed on as the
// same value and no record is made for it.

/// The answer of something that can fail: `Result.ok value`, or
/// `Result.error reason`. A pure function cannot raise, so this is how it
/// reports a failure; `let?` chains steps that answer one.
union Result a e {
    ok(value : a)
    error(reason : e)

    /// Which one it is: `:ok` or `:error`.
    tag : Result a e -> :atom
    tag self = match self { Result.ok(_) => :ok, Result.error(_) => :error }

    /// Whether it holds a value.
    is_ok : Result a e -> :bool
    is_ok self = match self { Result.ok(_) => true, Result.error(_) => false }
    /// Whether it holds a reason.
    is_error : Result a e -> :bool
    is_error self = match self { Result.error(_) => true, Result.ok(_) => false }

    /// Change the value, and pass an error on.
    map : (a -> b) -> Result a e -> Result b e
    map f self = match self { Result.ok(v) => ok (f v), Result.error(why) => error why }
    /// Change the reason, and pass a value on: a failure said in the
    /// caller's terms rather than the callee's.
    map_error : (e -> f) -> Result a e -> Result a f
    map_error f self = match self { Result.error(why) => error (f why), Result.ok(v) => ok v }
    /// The next step, which may itself fail. This is the one that makes a
    /// pipeline, and what `let?` writes out.
    and_then : (a -> Result b e) -> Result a e -> Result b e
    and_then f self = match self { Result.ok(v) => f v, Result.error(why) => error why }
    /// Continue with `other` on success; keep this error otherwise. `other`
    /// stays lazy when this result failed.
    and : Result b e -> Result a e -> Result b e
    and other self = match self { Result.ok(_) => other, Result.error(why) => error why }
    /// Recover from an error with another step, which may fail in its turn.
    or_else : (e -> Result a f) -> Result a e -> Result a f
    or_else f self = match self { Result.error(why) => f why, Result.ok(v) => ok v }
    /// This result if it is ok, otherwise `other`. Lazy in `other`, so the
    /// fallback is only computed when it is needed.
    otherwise : Result a e -> Result a e -> Result a e
    otherwise other self = match self { Result.ok(_) => self, Result.error(_) => other }
    /// Keep this success, or use `other`, whose error type may differ.
    or : Result a f -> Result a e -> Result a f
    or other self = match self { Result.ok(v) => ok v, Result.error(_) => other }

    /// The value, or `default` for an error. The usual way out.
    unwrap_or : a -> Result a e -> a
    unwrap_or default self = match self { Result.ok(v) => v, Result.error(_) => default }
    /// The value, or what `f` makes of the reason.
    unwrap_or_else : (e -> a) -> Result a e -> a
    unwrap_or_else f self = match self { Result.ok(v) => v, Result.error(why) => f why }
    /// The value, raising the reason when there is none. Impure, because
    /// raising is an effect.
    unwrap! : Result a e -> a
    unwrap! self = match self { Result.ok(v) => v, Result.error(why) => raise! why }
    /// The value, raising `message` when there is none.
    expect! : :string -> Result a e -> a
    expect! message self = match self { Result.ok(v) => v, Result.error(_) => raise! message }

    /// The value as an option, forgetting the reason.
    to_option : Result a e -> Option a
    to_option self = match self { Result.ok(v) => Option.some v, Result.error(_) => Option.none }
    /// The reason as an option.
    reason : Result a e -> Option e
    reason self = match self { Result.error(why) => Option.some why, Result.ok(_) => Option.none }

    /// A result of a result, as one: the inner one when the outer is ok.
    flatten : Result (Result a e) e -> Result a e
    flatten self = match self { Result.ok(inner) => inner, Result.error(why) => error why }
    /// Both values as a pair, or the first error.
    both : Result b e -> Result a e -> Result [a, b] e
    both other self = match self {
        Result.error(why) => error why,
        Result.ok(a) => match other { Result.ok(b) => ok [a, b], Result.error(why) => error why },
    }

    /// `ok values` when every one is ok, or the first error. Stops there, so
    /// for a lazy list the ones after it are never computed.
    all : [Result a e] -> Result [a] e
    all rs = match rs {
        [] => ok [],
        [r, ..rest] => match r {
            Result.error(why) => error why,
            Result.ok(v) => match all rest { Result.ok(vs) => ok (v :: vs), Result.error(why) => error why },
        },
    }
    /// The values of every ok, dropping the errors.
    oks : [Result a e] -> [a]
    oks rs = match rs {
        [] => [],
        [r, ..rest] => match r { Result.ok(v) => v :: oks rest, Result.error(_) => oks rest },
    }
    /// The reasons of every error, dropping the values.
    errors : [Result a e] -> [e]
    errors rs = match rs {
        [] => [],
        [r, ..rest] => match r { Result.error(why) => why :: errors rest, Result.ok(_) => errors rest },
    }
}

/// Construct a successful result without qualifying the union name.
let ok : a -> Result a e;
let ok value = Result.ok value;

/// Construct a failed result without qualifying the union name.
let err : e -> Result a e;
let err reason = Result.error reason;

/// A value that may not be there: `Option.some value`, or `Option.none`.
/// What a lookup answers when finding nothing is not a failure -- the reason
/// would always be "it was not there" -- and what `let?` chains as readily as
/// a result.
union Option a {
    some(value : a)
    none

    /// Whether there is a value.
    is_some : Option a -> :bool
    is_some self = match self { Option.some(_) => true, Option.none => false }
    /// Whether there is not.
    is_none : Option a -> :bool
    is_none self = match self { Option.none => true, Option.some(_) => false }

    /// The option for a value that may be `()`: `none` for `()`, and `some`
    /// of anything else. The bridge from a lookup that answers `()` for
    /// nothing.
    of : a -> Option a
    of v = match v { () => none, found => some found }
    /// The value, or `()`. And back again.
    or_unit : Option a -> a
    or_unit self = match self { Option.some(v) => v, Option.none => () }

    /// Change the value, if there is one.
    map : (a -> b) -> Option a -> Option b
    map f self = match self { Option.some(v) => some (f v), Option.none => none }
    /// The next lookup, which may find nothing in its turn.
    and_then : (a -> Option b) -> Option a -> Option b
    and_then f self = match self { Option.some(v) => f v, Option.none => none }
    /// Continue with `other` when present, or keep none. `other` stays lazy
    /// when this option is missing.
    and : Option b -> Option a -> Option b
    and other self = match self { Option.some(_) => other, Option.none => none }
    /// The value if `keep` says so, and nothing otherwise.
    filter : (a -> :bool) -> Option a -> Option a
    filter keep self = match self { Option.some(v) => if keep v { self } else { none }, Option.none => none }
    /// This option if it holds a value, otherwise `other`. Lazy in `other`.
    otherwise : Option a -> Option a -> Option a
    otherwise other self = match self { Option.some(_) => self, Option.none => other }
    /// Keep this value, or use `other` when missing.
    or : Option a -> Option a -> Option a
    or other self = otherwise other self
    /// Compute a fallback only when missing. The callback receives `()`.
    or_else : (:unit -> Option a) -> Option a -> Option a
    or_else missing self = match self { Option.some(_) => self, Option.none => missing () }
    /// Keep the value when exactly one option is present; otherwise none.
    xor : Option a -> Option a -> Option a
    xor other self = match self {
        Option.some(_) => match other { Option.some(_) => none, Option.none => self },
        Option.none => other,
    }

    /// The value, or `default`.
    unwrap_or : a -> Option a -> a
    unwrap_or default self = match self { Option.some(v) => v, Option.none => default }
    /// The value, or `missing` computed when it is needed.
    unwrap_or_else : (:unit -> a) -> Option a -> a
    unwrap_or_else missing self = match self { Option.some(v) => v, Option.none => missing () }
    /// The value, raising `:none` when there is none.
    unwrap! : Option a -> a
    unwrap! self = match self { Option.some(v) => v, Option.none => raise! :none }
    /// The value, raising `message` when there is none.
    expect! : :string -> Option a -> a
    expect! message self = match self { Option.some(v) => v, Option.none => raise! message }

    /// A result: the value, or `reason` as the error. How a missing value
    /// becomes a failure worth reporting.
    ok_or : e -> Option a -> Result a e
    ok_or reason self = match self { Option.some(v) => Result.ok v, Option.none => Result.error reason }

    /// An option of an option, as one.
    flatten : Option (Option a) -> Option a
    flatten self = match self { Option.some(inner) => inner, Option.none => none }
    /// Both values as a pair, or nothing.
    both : Option b -> Option a -> Option [a, b]
    both other self = match self {
        Option.none => none,
        Option.some(a) => match other { Option.some(b) => some [a, b], Option.none => none },
    }
    /// Whether it holds a value equal to `v`.
    contains : a -> Option a -> :bool
    contains v self = match self { Option.some(x) => x == v, Option.none => false }

    /// `some values` when every one holds a value, or `none`.
    all : [Option a] -> Option [a]
    all os = match os {
        [] => some [],
        [o, ..rest] => match o {
            Option.none => none,
            Option.some(v) => match all rest { Option.some(vs) => some (v :: vs), Option.none => none },
        },
    }
    /// The values that are there, dropping the rest.
    values : [Option a] -> [a]
    values os = match os {
        [] => [],
        [o, ..rest] => match o { Option.some(v) => v :: values rest, Option.none => values rest },
    }
}
