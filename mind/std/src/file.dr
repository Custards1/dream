// Whole files, and the directories they go in.
//
// `std.io` is handles and bytes, which is what the VM provides; this is what
// nearly every program that touches a file actually wants from it -- all of
// it in, all of it out, and the directories above made first. It began as
// `mind`'s own helpers and moved here when `std.build` needed the same ones,
// since a second copy is how two of them come to disagree.

import std.io;
import std.list;
import std.os;
import std.path as paths;
import std.str;

/// Read a handle in 64 KiB chunks, joining the accumulated chunks at end of file.
let read_chunks! : :any -> [:string] -> :string;
let rec read_chunks! h !acc = {
    let chunk = io.read! h 65536;
    if len chunk == 0 { str.join_str "" (list.reverse acc) } else { read_chunks! h (list.cons chunk acc) }
};

/// The whole file, or `()` when it cannot be opened.
let read! : :string -> :string | :unit;
let read! path = {
    let opened = try! { io.open! path :read } catch e { () };
    match opened {
        () => (),
        h => {
            let text = read_chunks! h [];
            io.close! h
            text
        },
    }
};

/// Replace the file with `text`, making it if it is not there.
///
/// ```dream
/// import std.file;
/// import std.console;
///
/// let main! = {
///     file.write! "greeting.txt" "hello from a file"
///     console.print! (file.read! "greeting.txt")
/// };
/// ```
let write! : :string -> :string -> :unit;
let write! path text = {
    let h = io.open! path :write;
    let rec put! offset = {
        let left = str.byte_length text - offset;
        // Two arguments, not one string built from both: `io.write!` is
        // curried, so passing one leaves a function behind rather than
        // failing here, and it fails as `offset + <function>` instead.
        if left > 0 { put! (offset + io.write! h (str.slice offset left text)) }
    };
    put! 0
    io.close! h
};

/// The directory `path` is in, or `""` for a bare name: where `mkdir_all!`
/// has to start before a file can be written. It is `std.path.dirname` --
/// trailing slashes, drives and shares included -- except that a name with
/// no directory in it answers `""` rather than `.`, which is what a
/// directory to create wants.
let parent : :string -> :string;
let parent path = match paths.dirname path {
    "." if str.find "/" (paths.slashes path) < 0 => "",
    d => d,
};

/// Whether `path` is there and is not a directory.
let is_file! : :string -> :bool;
let is_file! path = match io.stat! path {
    [_, _, :dir] => false,
    () => false,
    _ => true,
};

/// Whether `path` is there and is a directory.
let is_dir! : :string -> :bool;
let is_dir! path = match io.stat! path {
    [_, _, :dir] => true,
    _ => false,
};

/// A directory's entries as paths under it (`dir/name`, and just `name` for
/// `.`, as `std.path.join` writes it), or `[]` when it cannot be read. A
/// missing directory is an ordinary answer: a search path that does not exist
/// simply holds nothing.
let list! : :string -> [:string];
let list! dir = {
    let names = try! { os.list_dir! dir } catch e { [] };
    let prefix = match dir {
        "" => "",
        "." => "",
        _ if str.ends_with "/" dir => dir,
        _ => dir + "/",
    };
    map (fn n -> prefix + n) names
};

// The three walks below are natives (`std.io`): each is one call where the
// same walk in Dream is a recursion over `list_dir!` or a read and a write per
// chunk, and a build does all three for every step it runs.

/// Make `path` and every directory above it.
let mkdir_all! : :string -> :unit;
let mkdir_all! path = match path {
    "" => (),
    p => io.mkdir_all! p,
};

/// Copy a file, replacing `to` if it is there. The copy is a file of its own,
/// with `from`'s permissions: changing one never changes the other.
let copy! : :string -> :string -> :unit;
let copy! from to = io.copy! from to;

/// A name for a scratch file no other writer is using: this OS process's id
/// and this green process's. The first alone is not enough, since one VM runs
/// many processes, and two of them replacing the same file at once each
/// renamed the other's scratch file away.
let scratch_suffix! : :unit -> :string;
let scratch_suffix! () = {
    to_string (os.pid! ()) + "-" + str.slice 0 12 (io.digest (to_string (self! ())))
};

/// Write `text` to `path` whole or not at all: beside it, then renamed into
/// place, so a reader sees the old file or the new one and never half of one.
let replace! : :string -> :string -> :unit;
let replace! path text = {
    let scratch = path + ".tmp-" + scratch_suffix! ();
    write! scratch text
    io.rename! scratch path
};

/// Remove `path` and, when it is a directory, everything under it. Nothing
/// there is not an error: what was asked for is that it be gone.
let remove_all! : :string -> :unit;
let remove_all! path = {
    io.remove_all! path
    ()
};

/// Every file under `dir`, relative to it, sorted; `[]` when it is not there.
let walk! : :string -> [:string];
let walk! dir = match io.stat! dir {
    [_, _, :dir] => io.walk! dir,
    _ => [],
};

when test {
    import std.test;

    let scratch! () = "dream-file-test-" + to_string (os.pid! ());

    let tests = [
        test.case "the parent of a path"
            $( test.eq! ["a/b", "", "/", "/a", "a", "."]
                        [parent "a/b/c", parent "c", parent "/c", parent "/a/b", parent "a/b/", parent "./x"] ),
        test.case "a directory's entries are paths under it"
            $( {
                let d = scratch! () + "-list";
                mkdir_all! (d + "/sub")
                write! (d + "/f") ""
                let got = [list.sort (list! d), is_file! (d + "/f"), is_file! (d + "/sub"),
                           is_dir! (d + "/sub"), is_file! (d + "/none"), list! (d + "/none")];
                strict! got
                remove_all! d
                test.eq! [[d + "/f", d + "/sub"], true, false, true, false, []] got
            } ),
        test.case "a file written is the file read"
            $( {
                let d = scratch! ();
                mkdir_all! (d + "/x/y")
                write! (d + "/x/y/f") "hello"
                copy! (d + "/x/y/f") (d + "/g")
                let got = [read! (d + "/x/y/f"), read! (d + "/g"), read! (d + "/none")];
                strict! got
                remove_all! d
                test.eq! [["hello", "hello", ()], ()] [got, io.stat! d]
            } ),
    ];
}
