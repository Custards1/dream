// Atoms: finding one by its name.
//
// An atom is interned the first time a program mentions it and never freed,
// so a program that turned every string it read into an atom would leak one
// per distinct input. `existing` is the safe direction: it finds an atom that
// already exists and makes none, which is what a decoder wants -- an atom the
// program was written with is one it can match on, and any other name is not
// one it could have been expecting.

/// An atom's name, without the colon it is written with: `name :ok` is `"ok"`.
///
/// `to_string` writes an atom as its name after a `:`, so this is that
/// rendering less its first byte -- one place for what a dozen modules had
/// each spelled out again, some slicing one byte too many and leaning on the
/// slice's clamp to come out right.
let name : :atom -> :string;
let name a = { let shown = to_string a; _str_slice shown 1 (len shown - 1) };

/// The atom with this name, or `()` if nothing has ever interned it.
let existing : (:string | :bigstr) -> (:atom | :unit);
let existing name = _to_existing_atom name;

when test {
    import std.test;

    let tests = [
        test.case "an atom the program names" $( test.eq! :ok (existing "ok") ),
        test.case "one it never names"
            $( test.eq! () (existing "no atom anywhere is spelled like this") ),
        test.case "a name is the atom without its colon" $( test.eq! "ok" (name :ok) ),
        test.case "underscores and digits are part of the name"
            $( test.eq! "out_of_memory2" (name :out_of_memory2) ),
        test.case "a name finds its atom again" $( test.eq! :ready (existing (name :ready)) ),
    ];
}
