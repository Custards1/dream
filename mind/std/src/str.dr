// Strings: UTF-8 text.
//
// A string is a sequence of characters, so this module derives `std.seq` and
// gets `count`, `any`, `all`, `contains`, `minimum`, `join` and the rest for
// free over its characters. Only what is genuinely about text is written here.
//
// **Characters and bytes are not the same thing here.** The runtime stores a
// string as UTF-8 bytes, and its primitives are byte-indexed because that is
// what makes them constant time. This module keeps the two apart by name:
// `length` and everything inherited from `std.seq` count *characters*, while
// `byte_length`, `slice` and `find` work in *bytes*. Mixing them silently is
// the one thing a text library must not do, so nothing here does it implicitly.

derive std.seq;

// What std.seq gives, said of strings: its own signatures say `:any` for the
// sequence, and a member that takes a list as readily as a string can never be
// told from `std.list`'s by its argument (see the same in `std.array`).
/// How many elements satisfy `keep`.
let count : (:char -> :bool) -> :string -> :integer;
/// Does any element satisfy `keep`? `keep` is asked of nothing after the first that does.
let any : (:char -> :bool) -> :string -> :bool;
/// Does every element satisfy `keep`? `keep` is asked of nothing after the first that does not.
let all : (:char -> :bool) -> :string -> :bool;
/// Is an element equal to `wanted`?
let contains : :any -> :string -> :bool;
/// The least element, or `()` for an empty one.
let minimum : :string -> :any;
/// The greatest element, or `()` for an empty one.
let maximum : :string -> :any;
/// The element `key` makes least, or `()` for an empty one.
let minimum_by : (:char -> :any) -> :string -> :any;
/// The element `key` makes greatest, or `()` for an empty one.
let maximum_by : (:char -> :any) -> :string -> :any;
/// Every element's text, `sep` between them.
let join : :string -> :string -> :string;
import std.list;
import std.char;

// --- the hole std.seq declares ----------------------------------------------

/// Left to right over the characters, not the bytes.
/// Strict in each step, for the reason `array.fold` gives.
///
/// The element is a `:char`, but the signature says `:any`: `std.seq` is
/// checked against this `fold`, and it offers `sum` and `product` to every
/// container, a string included. Those are wrong on a string and nobody calls
/// them on one, and a checker that reports code nobody runs is one people turn
/// off.
let fold : (a -> :any -> a) -> a -> :string -> a;
let fold f init s = list.fold f init (_str_chars s);

/// Return the sequence type name, `string`.
let name : :any -> :string;
let name s = "string";

// --- size -------------------------------------------------------------------

/// The number of characters. Decodes the whole string, because UTF-8 does not
/// know its own character count without looking -- but in the machine, and
/// without building the list of characters `chars` would (`_str_char_count`).
let length : :string -> :integer;
let length s = _str_char_count s;

/// The number of bytes, which the runtime knows without decoding anything.
/// For text that is all ASCII the two agree; for anything else they do not.
let byte_length : (:string | :bigstr) -> :integer;
let byte_length s = len s;

/// Test whether the string contains no bytes.
let is_empty : (:string | :bigstr) -> :bool;
let is_empty s = len s == 0;

// --- characters -------------------------------------------------------------

/// Decode the string into a list of Unicode characters.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.chars "café")
/// };
/// ```
let chars : :string -> [:char];
let chars s = _str_chars s;

/// Encode a list of Unicode characters as a string.
let of_chars : [:char] -> :string;
let of_chars cs = _str_of_chars cs;

/// Return the first Unicode character, or `default` for an empty string.
let first_or : a -> :string -> (a | :char);
let first_or default s = list.first_or default (_str_chars s);

// --- bytes ------------------------------------------------------------------

/// The string these bytes spell, each an integer from 0 to 255. Not checked
/// for UTF-8: this is how a binary format is written, and its output was
/// never meant to be text.
let of_bytes : [:integer] -> :string;
let of_bytes bs = _str_of_bytes bs;

/// `n` as `width` bytes, least significant first, two's complement for a
/// negative number -- a field of a binary format in one step, where the same
/// thing written in Dream would build a list of bytes to throw away.
let of_int_le : :integer -> :integer -> :string;
let of_int_le width n = _str_le n width;

/// `n` as `width` bytes, most significant first: network order, and what
/// RPM, PNG and most other formats written for people store.
let of_int_be : :integer -> :integer -> :string;
let of_int_be width n = {
    let le = _str_le n width;
    _str_of_bytes (list.map (fn i -> _str_byte le (width - 1 - i)) (list.range 0 width))
};

/// `count` bytes from byte offset `from`. Clamped rather than raising: running
/// off the end is how a loop over a string finishes, and an error there would
/// be noise. Slicing through the middle of a multi-byte character will split
/// it, which is why the offsets to pass are the ones `find` returns.
///
/// A slice of a `:string` is a `:string` and of a `:bigstr` a `:bigstr`, which
/// is what the variable says: an answer of `:string | :bigstr` would refuse
/// `"--" + slice ..` on every caller holding an ordinary string.
let slice : :integer -> :integer -> s -> s;
let slice from count s = _str_slice s from count;

/// The byte at offset `i`, as an integer, or `-1` when there is none.
///
/// Clamped the same way `slice` is, and for the same reason. This is the way
/// into a big string (`_data_at`), which has no `chars` and no `find`:
/// indexing it is pointer arithmetic and costs nothing, while anything that
/// would build a string out of it is refused.
let byte : :integer -> (:string | :bigstr) -> :integer;
let byte i s = _str_byte s i;

/// Past the run of bytes from `set` that starts at byte offset `from`: the
/// offset of the first byte that is not one of them, or `byte_length s`.
///
/// `set` is a string read as the set of its bytes, so `span " \t" i s` skips
/// indentation and `span "0123456789" i s` skips a run of digits. The scan
/// happens in the runtime, which is the point: doing it a byte at a time in
/// Dream costs a call and a comparison chain per byte.
let span : :string -> :integer -> (:string | :bigstr) -> :integer;
let span set from s = _str_span s from set;

/// The offset of the first byte from `set` at or after `from`, or
/// `byte_length s` when there is none -- so `upto "\n" i s` is the end of the
/// line whether or not the text ends with one.
let upto : :string -> :integer -> (:string | :bigstr) -> :integer;
let upto set from s = _str_upto s from set;

/// Where the run of bytes from `set` that ends at byte offset `until` starts:
/// `span` run backwards. `span_back " " (byte_length s) s` is where the
/// trailing spaces begin, or the length when there are none.
let span_back : :string -> :integer -> (:string | :bigstr) -> :integer;
let span_back set until s = _str_span_back s until set;

/// The byte offset of `needle` at or after byte offset `from`, or `-1`.
let find_from : :integer -> :string -> :string -> :integer;
let find_from from needle s = _str_find s needle from;

/// Return the byte offset of the first occurrence of `needle`, or -1 if absent.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.find "world" "hello world")
/// };
/// ```
let find : :string -> :string -> :integer;
let find needle s = _str_find s needle 0;

/// The greatest byte offset at or before `from` where `needle` starts, or `-1`.
let find_last_from : :integer -> :string -> :string -> :integer;
let find_last_from from needle s = _str_rfind s needle from;

/// The byte offset of the last occurrence of `needle`, or `-1`: the dot
/// before a file's extension, the slash before a path's last component.
let find_last : :string -> :string -> :integer;
let find_last needle s = _str_rfind s needle (len s);

/// Test whether `needle` occurs anywhere in the string.
let contains_str : :string -> :string -> :bool;
let contains_str needle s = _str_find s needle 0 >= 0;

/// Test whether the string begins with the given prefix.
let starts_with : :string -> (:string | :bigstr) -> :bool;
let starts_with prefix s = _str_slice s 0 (len prefix) == prefix;

/// Test whether the string ends with the given suffix.
let ends_with : :string -> (:string | :bigstr) -> :bool;
let ends_with suffix s =
    _str_slice s (len s - len suffix) (len suffix) == suffix;

/// What comes before and after the first `sep`, as `[before, after]`, or `()`
/// when `sep` does not occur: `split_once "=" "k=v=w"` is `["k", "v=w"]`. The
/// shape of every `key=value`, `name: value` and `host:port` a program reads.
let split_once : :string -> :string -> ([:string, :string] | :unit);
let split_once sep s = {
    let at = _str_find s sep 0;
    if at < 0 { () }
    else { [_str_slice s 0 at, _str_slice s (at + len sep) (len s - at - len sep)] }
};

/// What comes before and after the *last* `sep`, or `()`:
/// `split_last "." "a.tar.gz"` is `["a.tar", "gz"]`.
let split_last : :string -> :string -> ([:string, :string] | :unit);
let split_last sep s = {
    let at = _str_rfind s sep (len s);
    if at < 0 { () }
    else { [_str_slice s 0 at, _str_slice s (at + len sep) (len s - at - len sep)] }
};

/// How many times `needle` occurs, not overlapping; `0` for an empty needle.
let occurrences : :string -> :string -> :integer;
let occurrences needle s = {
    let step = len needle;
    let rec go from !n = {
        let at = _str_find s needle from;
        if at < 0 { n } else { go (at + step) (n + 1) }
    };
    if step == 0 { 0 } else { go 0 0 }
};

/// `s` without `prefix` when it starts with one, and as it was otherwise.
let trim_prefix : :string -> :string -> :string;
let trim_prefix prefix s =
    if starts_with prefix s { _str_slice s (len prefix) (len s - len prefix) } else { s };

/// `s` without `suffix` when it ends with one, and as it was otherwise.
let trim_suffix : :string -> :string -> :string;
let trim_suffix suffix s =
    if ends_with suffix s { _str_slice s 0 (len s - len suffix) } else { s };

// --- building ---------------------------------------------------------------

/// Join two strings in order.
let concat : :string -> :string -> :string;
let concat a b = a + b;

/// One string from many, with nothing between them.
///
/// This is the linear way to build a string out of pieces, and the reason to
/// reach for it: `a + b + c + ..` copies everything written so far on every
/// step, so assembling n pieces costs n^2 bytes of copying. Anything that
/// builds a large output a piece at a time -- an image, a rendered diagnostic,
/// a dump of a program -- should collect the pieces and come here once.
let concat_all : [:string] -> :string;
let concat_all parts = _str_concat parts;

/// The strings in `parts` with `sep` between them. `std.seq` supplies `join`,
/// which renders each element with `to_string`; this one is for strings that
/// are already strings and should not gain quotes.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.join_str ", " ["red", "green", "blue"])
/// };
/// ```
let join_str : :string -> [:string] -> :string;
let join_str sep parts =
    match parts {
        [] => "",
        [first, ..rest] =>
            _str_concat (_list_cons first (flat_map (fn s -> [sep, s]) rest)),
    };

/// `s` repeated `n` times.
let repeat : :integer -> :string -> :string;
let repeat n s = if n <= 0 { "" } else { _str_concat (list.replicate n s) };

/// The parts of `s` between each occurrence of `sep`, as a list of strings.
/// An empty separator would not make progress, so it yields the whole string.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.split "," "red,green,blue")
/// };
/// ```
let split : :string -> :string -> [:string];
let split sep s = {
    let seplen = len sep;
    let rec go from =
        if from > len s { [] }
        else {
            let at = _str_find s sep from;
            if at < 0 { [_str_slice s from (len s - from)] }
            else { _list_cons (_str_slice s from (at - from)) (go (at + seplen)) }
        };
    if seplen == 0 { [s] } else { go 0 }
};

/// `split` that stops after `n` parts, the last holding the rest of the text
/// separators and all: `split_n 2 "=" "k=v=w"` is `["k", "v=w"]`. For a
/// line whose last field may contain the separator -- a log line, a header,
/// a `key=value` whose value has an `=`. `n` below one is taken as one.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.split_n 3 " " "GET /a b c HTTP/1.1")
/// };
/// ```
let split_n : :integer -> :string -> :string -> [:string];
let split_n n sep s = {
    let seplen = len sep;
    let rec go !left from = {
        let at = if left <= 1 { 0 - 1 } else { _str_find s sep from };
        if at < 0 { [_str_slice s from (len s - from)] }
        else { _list_cons (_str_slice s from (at - from)) (go (left - 1) (at + seplen)) }
    };
    if seplen == 0 { [s] } else { go n 0 }
};

/// The lines of the text, without their endings. A `\r` before a `\n` goes
/// with the ending, and a final line ending ends the last line rather than
/// starting an empty one -- so a file read whole and split here gives the
/// lines an editor shows, whichever system wrote it.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.lines "one\r\ntwo\n")
/// };
/// ```
let lines : :string -> [:string];
let lines s = {
    let n = len s;
    let rec go i =
        if i >= n { [] }
        else {
            let stop = _str_upto s i "\n";
            let end = if stop > i && _str_byte s (stop - 1) == 13 { stop - 1 } else { stop };
            _list_cons (_str_slice s i (end - i)) (go (stop + 1))
        };
    go 0
};

/// The runs of text between whitespace -- spaces, tabs and line endings --
/// with none of it kept, and no empty words however the runs fall.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.words "  the quick\tbrown  ")
/// };
/// ```
let words : :string -> [:string];
let words s = {
    let n = len s;
    let rec go i = {
        let start = _str_span s i whitespace;
        if start >= n { [] }
        else {
            let stop = _str_upto s start whitespace;
            _list_cons (_str_slice s start (stop - start)) (go stop)
        }
    };
    go 0
};

/// Every occurrence of `old` replaced by `new`, left to right and not
/// overlapping: `replace "ab" "x" "abab"` is `"xx"`. An empty `old` matches
/// nowhere, so the string comes back as it was.
///
/// The pieces are collected and joined once (`concat_all`), so a replacement
/// in a large text is linear rather than a copy of the text per match.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.replace "cat" "dog" "cat and cat")
/// };
/// ```
let replace : :string -> :string -> :string -> :string;
let replace old new s = {
    let step = len old;
    let rec go from !acc = {
        let at = _str_find s old from;
        if at < 0 { list.reverse (_list_cons (_str_slice s from (len s - from)) acc) }
        else { go (at + step) (_list_cons new (_list_cons (_str_slice s from (at - from)) acc)) }
    };
    if step == 0 || _str_find s old 0 < 0 { s } else { _str_concat (go 0 []) }
};

/// `s` with each byte from `set` replaced by `f` of it: how a format escapes
/// its specials. The runs between them are found by the runtime (`upto`) and
/// copied whole, so a string with nothing to escape is one scan and answered
/// as it is. Bytes, not characters: every escape a format asks for is ASCII,
/// and no byte of a multi-byte UTF-8 character is, so the rest passes through
/// untouched.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.escape_bytes "\"\\" (fn b -> "\\" + str.of_bytes [b]) "say \"hi\"")
/// };
/// ```
let escape_bytes : :string -> (:integer -> :string) -> :string -> :string;
let escape_bytes set f s = {
    let n = len s;
    let rec go !from !acc = {
        let at = _str_upto s from set;
        let kept = if at > from { _list_cons (_str_slice s from (at - from)) acc } else { acc };
        if at >= n { list.reverse kept }
        else { go (at + 1) (_list_cons (f (_str_byte s at)) kept) }
    };
    if _str_upto s 0 set >= n { s } else { _str_concat (go 0 []) }
};

/// Every line of `s` with `prefix` in front, joined by `\n` -- how a block of
/// output is set under a heading. Lines as `lines` finds them, so a final line
/// ending is not kept and does not make an indented empty line.
let indent : :string -> :string -> :string;
let indent prefix s = join_str "\n" (list.map (fn l -> prefix + l) (lines s));

/// `s` with `fill` repeated in front until it is `width` characters long; a
/// string already that long comes back as it was. `pad_start 3 "0" "7"` is
/// `"007"`. `fill` is meant to be one character, and is counted as one.
let pad_start : :integer -> :string -> :string -> :string;
let pad_start width fill s = {
    let short = width - length s;
    if short <= 0 { s } else { repeat short fill + s }
};

/// `s` with `fill` repeated after it until it is `width` characters long: how
/// a column of a table is lined up.
let pad_end : :integer -> :string -> :string -> :string;
let pad_end width fill s = {
    let short = width - length s;
    if short <= 0 { s } else { s + repeat short fill }
};

/// `s` with `fill` on both sides until it is `width` characters long, the odd
/// one after: `center 7 "*" "abc"` is `"**abc**"`, and `center 6 "*" "abc"`
/// is `"*abc**"`.
let center : :integer -> :string -> :string -> :string;
let center width fill s = {
    let short = width - length s;
    if short <= 0 { s }
    else {
        let before = short / 2;
        repeat before fill + s + repeat (short - before) fill
    }
};

/// `s` cut to at most `width` characters, the last of them `…` when anything
/// was cut: `truncate 5 "hello world"` is `"hell…"`. Characters, never bytes,
/// so a cut never splits one. A width below one answers `""`.
let truncate : :integer -> :string -> :string;
let truncate width s =
    if length s <= width { s }
    else if width < 1 { "" }
    else { _str_slice s 0 (char_offset s (width - 1)) + "\u{2026}" };

/// The bytes that continue a UTF-8 character rather than start one, as a set
/// for `_str_span`.
priv let continuation_bytes : :string;
priv let continuation_bytes = _str_of_bytes (list.range 128 192);

/// The byte offset of character `k` of `s`, or its length when there are
/// fewer: a lead byte and the run of continuations after it, per character.
priv let char_offset : :string -> :integer -> :integer;
priv let char_offset s k = {
    let n = len s;
    let rec go !i !k = if k <= 0 || i >= n { i } else { go (_str_span s (i + 1) continuation_bytes) (k - 1) };
    go 0 k
};

/// The longest start `a` and `b` share, ending on a character boundary:
/// `common_prefix "interview" "internet"` is `"inter"`. Compared a byte at a
/// time, then stepped back off any character the two only began alike.
let common_prefix : :string -> :string -> :string;
let common_prefix a b = {
    let n = if len a < len b { len a } else { len b };
    let i = same_bytes a b n 0;
    let start = if i < len a && _str_byte a i >= 128 && _str_byte a i < 192 {
        _str_span_back a i continuation_bytes - 1
    } else { i };
    _str_slice a 0 start
};

/// The first offset from `i`, below `n`, where `a` and `b` differ, or `n`.
priv let same_bytes : :string -> :string -> :integer -> :integer -> :integer;
priv let rec same_bytes a b n !i =
    if i < n && _str_byte a i == _str_byte b i { same_bytes a b n (i + 1) } else { i };

/// The edit distance between `a` and `b` (Levenshtein's): how many characters
/// must be inserted, deleted or replaced to turn one into the other.
/// `distance "kitten" "sitting"` is `3`. Time is the product of the two
/// lengths and memory one row of the shorter, each row built strictly so that
/// nothing is left suspended between rows.
let distance : :string -> :string -> :integer;
let distance a b =
    if a == b { 0 }
    else {
        let [long, short] = if len a >= len b { [_str_chars a, _str_chars b] } else { [_str_chars b, _str_chars a] };
        lev_rows short 1 (list.range 0 (len short + 1)) long
    };

/// One row per character of `long`, each from the row before; the answer is
/// the last entry of the last row.
priv let lev_rows : [:char] -> :integer -> [:integer] -> [:char] -> :integer;
priv let rec lev_rows short !i !prev long =
    if _list_is_empty long { list.last prev }
    else { lev_rows short (i + 1) (lev_row (long.[0]) i (prev.[0]) (_list_tail prev) short [i]) (_list_tail long) };

/// Row `i` for character `c`: `left` is the entry just made, `diag` and the
/// head of `ups` the previous row's entries above-left and above.
priv let lev_row : :char -> :integer -> :integer -> [:integer] -> [:char] -> [:integer] -> [:integer];
priv let rec lev_row c !left !diag ups cbs !acc =
    if _list_is_empty cbs { list.reverse acc }
    else {
        let up = ups.[0];
        let replaced = if c == cbs.[0] { diag } else { diag + 1 };
        let shifted = (if left < up { left } else { up }) + 1;
        let here = if replaced < shifted { replaced } else { shifted };
        lev_row c here up (_list_tail ups) (_list_tail cbs) (_list_cons here acc)
    };

/// The words of `s` laid out in lines of at most `width` characters, as many
/// to a line as fit, joined by `\n`. A word longer than `width` has a line to
/// itself rather than being broken. Whitespace in `s`, line endings included,
/// only separates words: wrap a paragraph at a time to keep paragraphs.
let wrap : :integer -> :string -> :string;
let wrap width s = join_str "\n" (filled width (words s));

/// The lines `wrap` lays `ws` out in, each as full as `width` allows.
priv let filled : :integer -> [:string] -> [:string];
priv let rec filled width ws =
    if _list_is_empty ws { [] }
    else {
        let w = ws.[0];
        let [line, rest] = fill_line width (length w) [w] (_list_tail ws);
        _list_cons line (filled width rest)
    };

/// The line being filled, its pieces reversed in `acc`, and the words left.
priv let fill_line : :integer -> :integer -> [:string] -> [:string] -> [:string, [:string]];
priv let rec fill_line width !used !acc ws =
    if _list_is_empty ws { [_str_concat (list.reverse acc), []] }
    else {
        let n = used + 1 + length (ws.[0]);
        if n > width { [_str_concat (list.reverse acc), ws] }
        else { fill_line width n (_list_cons (ws.[0]) (_list_cons " " acc)) (_list_tail ws) }
    };

/// `s` with the indentation its non-blank lines share taken off every line,
/// and blank lines left empty -- how a block written indented in source is
/// brought back to the margin. The margin is counted in bytes of spaces and
/// tabs, so lines that mix the two must mix them alike.
let dedent : :string -> :string;
let dedent s = {
    let ls = lines s;
    let margin = list.minimum (filter_map (fn l -> if is_blank l { () } else { _str_span l 0 " \t" }) ls);
    let cut = if margin == () { 0 } else { margin };
    join_str "\n" (list.map (fn l -> if is_blank l { "" } else { _str_slice l cut (len l - cut) }) ls)
};

// --- transforming -----------------------------------------------------------

/// Apply `f` to each Unicode character and join the resulting characters.
let map : (:char -> :char) -> :string -> :string;
let map f s = _str_of_chars (list.map f (_str_chars s));

/// Keep the Unicode characters for which `keep` returns true.
let filter : (:char -> :bool) -> :string -> :string;
let filter keep s = _str_of_chars (list.filter keep (_str_chars s));

/// Reverse the order of Unicode characters, preserving their UTF-8 encoding.
let reverse : :string -> :string;
let reverse s = _str_of_chars (list.reverse (_str_chars s));

// --- case, for ASCII --------------------------------------------------------
//
// Only the ASCII range. Real Unicode case folding is a table this library does
// not carry, and pretending otherwise would be worse than saying so.

/// Convert an ASCII lowercase character to uppercase; leave other characters
/// unchanged. `char.upper`, under the name this module has always had for it.
let upper_char : :char -> :char;
let upper_char c = char.upper c;

/// Convert an ASCII uppercase character to lowercase; leave other characters unchanged.
let lower_char : :char -> :char;
let lower_char c = char.lower c;

/// Convert ASCII lowercase letters to uppercase throughout the string.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.upper "hello")
/// };
/// ```
let upper : :string -> :string;
let upper s = _str_ascii_case s true;

/// Convert ASCII uppercase letters to lowercase throughout the string.
let lower : :string -> :string;
let lower s = _str_ascii_case s false;

// --- trimming ---------------------------------------------------------------

// The trims are byte scans (`span`, `span_back`) and one slice. They were a
// decode into a list of characters, a `drop_while`, and for `trim_end` two
// reversals, before the string was encoded again: a cons per character to
// remove two spaces. Every byte of the whitespace set is ASCII, so a scan
// over bytes cannot stop inside a multi-byte character.

/// Test for a space, tab, newline or carriage return.
let is_space : :char -> :bool;
let is_space c = char.is_space c;

/// The bytes `is_space` answers true for, as a set for `span` and `upto`.
let whitespace : :string;
let whitespace = " \t\n\r";

/// Test whether the string is empty or holds nothing but whitespace.
let is_blank : :string -> :bool;
let is_blank s = _str_span s 0 whitespace >= len s;

/// The string with its first character upper-cased, ASCII only.
let capitalize : :string -> :string;
let capitalize s =
    if _str_span s 0 "abcdefghijklmnopqrstuvwxyz" == 0 { s }
    else { _str_ascii_case (_str_slice s 0 1) true + _str_slice s 1 (len s - 1) };

/// Remove spaces, tabs and line endings from the start of the string.
let trim_start : :string -> :string;
let trim_start s = {
    let start = _str_span s 0 whitespace;
    _str_slice s start (len s - start)
};

/// Remove spaces, tabs and line endings from the end of the string.
let trim_end : :string -> :string;
let trim_end s = _str_slice s 0 (_str_span_back s (len s) whitespace);

/// Remove spaces, tabs and line endings from both ends of the string.
///
/// ```dream
/// import std.str;
/// import std.console;
///
/// let main! = {
///     console.print! (str.trim "  hello  ")
/// };
/// ```
let trim : :string -> :string;
let trim s = {
    let start = _str_span s 0 whitespace;
    _str_slice s start (_str_span_back s (len s) whitespace - start)
};

// --- tests ------------------------------------------------------------------

when test {
    import std.test;

    let tests = [
        // --- from std.seq, over characters ---
        test.case "seq count"        $( test.eq! 3 (count (fn c -> c == 'l') "Hello, World") ),
        test.case "seq any"          $( test.true! (any (fn c -> c == 'W') "Hello, World") ),
        test.case "seq all"          $( test.true! (all (fn c -> c != 'z') "abc") ),
        test.case "seq contains"     $( test.true! (contains 'e' "hello") ),
        test.case "seq minimum"      $( test.eq! 'a' (minimum "cab") ),
        test.case "seq maximum"      $( test.eq! 'c' (maximum "cab") ),
        test.case "seq describe"     $( test.eq! "string of 3" (describe "abc") ),

        // --- binary fields ---
        test.case "bytes spell a string" $( test.eq! "AB" (of_bytes [65, 66]) ),
        test.case "little-endian"        $( test.eq! [1, 2, 0] (list.map (fn i -> byte i (of_int_le 3 513)) [0, 1, 2]) ),
        test.case "two's complement"     $( test.eq! [255, 255] [byte 0 (of_int_le 2 (0 - 1)), byte 1 (of_int_le 2 (0 - 1))] ),
        test.case "escape_bytes copies the runs between specials"
            $( test.eq! ["a\\\"b\\\\", "plain", "", "é\\\"é"]
                        (list.map (escape_bytes "\"\\" (fn b -> "\\" + of_bytes [b])) ["a\"b\\", "plain", "", "é\"é"]) ),
        test.case "big-endian"           $( test.eq! [[0, 0, 1, 2], [255, 255]]
                                                     [list.map (fn i -> byte i (of_int_be 4 258)) [0, 1, 2, 3],
                                                      list.map (fn i -> byte i (of_int_be 2 (0 - 1))) [0, 1]] ),

        // --- size, and the character/byte distinction ---
        test.case "length"           $( test.eq! 5 (length "hello") ),
        test.case "length of empty"  $( test.eq! 0 (length "") ),
        test.case "byte_length"      $( test.eq! 5 (byte_length "hello") ),
        test.case "span skips the class"      $( test.eq! 3 (span " \t" 0 "  \tx") ),
        test.case "span of nothing stays put" $( test.eq! 2 (span " " 2 "  x ") ),
        test.case "span off the end"          $( test.eq! 3 (span " " 0 "   ") ),
        test.case "span past the end"         $( test.eq! 9 (span " " 9 "abc") ),
        test.case "upto finds the delimiter"  $( test.eq! 3 (upto "\n" 0 "abc\ndef") ),
        test.case "upto with no delimiter"    $( test.eq! 3 (upto "\n" 0 "abc") ),
        test.case "upto takes any of the set" $( test.eq! 1 (upto "xy" 0 "ay") ),
        test.case "length counts characters" $( test.eq! 5 (length "h\u{e9}llo") ),
        test.case "byte_length counts bytes" $( test.eq! 6 (byte_length "h\u{e9}llo") ),
        test.case "is_empty"         $( test.true! (is_empty "") ),

        // --- characters ---
        test.case "chars"            $( test.eq! ['a', 'b'] (chars "ab") ),
        test.case "of_chars"         $( test.eq! "ab" (of_chars ['a', 'b']) ),
        test.case "of_chars round trip" $( test.eq! "h\u{e9}llo" (of_chars (chars "h\u{e9}llo")) ),
        test.case "first_or"         $( test.eq! 'a' (first_or 'z' "abc") ),
        test.case "first_or of empty" $( test.eq! 'z' (first_or 'z' "") ),

        // --- searching, in bytes ---
        test.case "find"             $( test.eq! 7 (find "World" "Hello, World") ),
        test.case "find missing"     $( test.eq! (0 - 1) (find "zzz" "Hello") ),
        test.case "find_from"        $( test.eq! 1 (find_from 1 "a" "aabaa") ),
        test.case "find_from skips a match" $( test.eq! 3 (find_from 2 "a" "aabaa") ),
        test.case "contains_str"     $( test.true! (contains_str "lo, " "Hello, World") ),
        test.case "starts_with"      $( test.true! (starts_with "Hell" "Hello") ),
        test.case "starts_with fails" $( test.false! (starts_with "ello" "Hello") ),
        test.case "ends_with"        $( test.true! (ends_with "llo" "Hello") ),
        test.case "ends_with fails"  $( test.false! (ends_with "Hell" "Hello") ),

        // --- slicing ---
        test.case "slice"            $( test.eq! "ell" (slice 1 3 "Hello") ),
        test.case "slice clamps"     $( test.eq! "lo" (slice 3 99 "Hello") ),

        // --- building ---
        test.case "concat"           $( test.eq! "ab" (concat "a" "b") ),
        test.case "repeat"           $( test.eq! "ababab" (repeat 3 "ab") ),
        test.case "repeat none"      $( test.eq! "" (repeat 0 "ab") ),
        test.case "join_str"         $( test.eq! "a-b-c" (join_str "-" ["a", "b", "c"]) ),
        test.case "join_str of empty" $( test.eq! "" (join_str "-" []) ),
        test.case "split"            $( test.eq! ["a", "b", "c"] (split "," "a,b,c") ),
        test.case "split_n keeps the rest whole" $( test.eq! [["k", "v=w"], ["a", "b", "c"], ["a,b"], ["x"]]
                                                       [split_n 2 "=" "k=v=w", split_n 5 "," "a,b,c",
                                                        split_n 0 "," "a,b", split_n 2 "" "x"] ),
        test.case "split without separator" $( test.eq! ["abc"] (split "," "abc") ),
        test.case "split on empty separator" $( test.eq! ["abc"] (split "" "abc") ),
        test.case "split round trip" $( test.eq! "a,b,c" (join_str "," (split "," "a,b,c")) ),

        // --- transforming ---
        test.case "map"              $( test.eq! "AB" (map upper_char "ab") ),
        test.case "filter"           $( test.eq! "ac" (filter (fn c -> c != 'b') "abc") ),
        test.case "reverse"          $( test.eq! "cba" (reverse "abc") ),

        // --- case, ASCII only ---
        test.case "upper"            $( test.eq! "ABC" (upper "abc") ),
        test.case "lower"            $( test.eq! "abc" (lower "ABC") ),
        test.case "case leaves non-ASCII alone" $( test.eq! "H\u{e9}LLO" (upper "h\u{e9}llo") ),

        // --- trimming ---
        test.case "trim"             $( test.eq! "a b" (trim "  a b \n") ),
        test.case "trim_start"       $( test.eq! "a  " (trim_start "  a  ") ),
        test.case "trim_end"         $( test.eq! "  a" (trim_end "  a  ") ),
        test.case "trim of blank"    $( test.eq! "" (trim "   ") ),
        test.case "trim of empty"    $( test.eq! ["", "", ""] [trim "", trim_start "", trim_end ""] ),
        test.case "trim keeps inner multibyte text" $( test.eq! "h\u{e9} \u{e9}" (trim "\t h\u{e9} \u{e9}\r\n") ),
        test.case "trim_prefix"      $( test.eq! ["bar", "foobar"] [trim_prefix "foo" "foobar", trim_prefix "x" "foobar"] ),
        test.case "trim_suffix"      $( test.eq! ["main", "main.dr"] [trim_suffix ".dr" "main.dr", trim_suffix ".x" "main.dr"] ),

        // --- the byte scans backwards ---
        test.case "span_back"        $( test.eq! [1, 4, 0] [span_back " " 4 "a   ", span_back " " 4 "abcd", span_back " " 9 "  "] ),
        test.case "find_last"        $( test.eq! [3, 0 - 1, 0] [find_last "." "a.b.c", find_last "z" "abc", find_last "ab" "abc"] ),
        test.case "find_last_from"   $( test.eq! [3, 1, 0 - 1] [find_last_from 3 "." "a.b.c", find_last_from 2 "." "a.b.c", find_last_from 0 "." "a.b.c"] ),

        // --- lines, words, pieces ---
        test.case "lines"            $( test.eq! ["a", "", "b"] (lines "a\n\nb") ),
        test.case "lines drops a final ending" $( test.eq! ["a", "b"] (lines "a\r\nb\n") ),
        test.case "lines of nothing" $( test.empty! (lines "") ),
        test.case "lines of one ending" $( test.eq! [""] (lines "\n") ),
        test.case "words"            $( test.eq! ["a", "bc", "d"] (words "  a bc\t\nd ") ),
        test.case "words of blank"   $( test.empty! (words " \t ") ),
        test.case "split_once"       $( test.eq! [["k", "v=w"], ()] [split_once "=" "k=v=w", split_once ":" "kv"] ),
        test.case "split_once at the ends" $( test.eq! [["", "v"], ["k", ""]] [split_once "=" "=v", split_once "=" "k="] ),
        test.case "replace"          $( test.eq! "dog and dog" (replace "cat" "dog" "cat and cat") ),
        test.case "replace does not overlap" $( test.eq! "xa" (replace "aa" "x" "aaa") ),
        test.case "replace nothing"  $( test.eq! ["abc", "abc"] [replace "z" "y" "abc", replace "" "y" "abc"] ),
        test.case "replace with a longer text" $( test.eq! "<<a>><<a>>" (replace "a" "<<a>>" "aa") ),
        test.case "split_last"       $( test.eq! [["a.tar", "gz"], ()] [split_last "." "a.tar.gz", split_last "." "abc"] ),
        test.case "occurrences"      $( test.eq! [2, 1, 0, 0] [occurrences "ab" "abcab", occurrences "aa" "aaa",
                                                              occurrences "x" "abc", occurrences "" "abc"] ),
        test.case "indent"           $( test.eq! "  a\n  b" (indent "  " "a\nb\n") ),
        test.case "is_blank"         $( test.eq! [true, true, false] [is_blank "", is_blank " \t\n", is_blank " x "] ),
        test.case "capitalize"       $( test.eq! ["Hello", "Hello", "", "1a"] [capitalize "hello", capitalize "Hello",
                                                                          capitalize "", capitalize "1a"] ),
        test.case "pad_start"        $( test.eq! ["007", "1234"] [pad_start 3 "0" "7", pad_start 3 "0" "1234"] ),
        test.case "pad_end counts characters" $( test.eq! "\u{e9}.." (pad_end 3 "." "\u{e9}") ),
        test.case "center"           $( test.eq! ["**abc**", "*abc**", "abcd"] [center 7 "*" "abc", center 6 "*" "abc", center 2 "*" "abcd"] ),
        test.case "truncate"         $( test.eq! ["hell\u{2026}", "hello", "", "\u{2026}"]
                                                 [truncate 5 "hello world", truncate 5 "hello", truncate 0 "hello", truncate 1 "hello"] ),
        test.case "truncate counts characters"
            $( test.eq! "\u{e9}\u{e9}\u{2026}" (truncate 3 "\u{e9}\u{e9}\u{e9}\u{e9}") ),
        test.case "common_prefix"    $( test.eq! ["inter", "", "abc", ""] [common_prefix "interview" "internet", common_prefix "a" "b",
                                                                          common_prefix "abc" "abcdef", common_prefix "" "x"] ),
        // U+00E9 and U+00E8 share their lead byte; the prefix must not keep it.
        test.case "common_prefix keeps whole characters"
            $( test.eq! "x" (common_prefix "x\u{e9}" "x\u{e8}") ),
        test.case "distance"         $( test.eq! [3, 0, 3, 3, 1, 2] [distance "kitten" "sitting", distance "same" "same",
                                                                    distance "" "abc", distance "abc" "", distance "flaw" "flaws",
                                                                    distance "\u{e9}t\u{e9}" "ete"] ),
        test.case "distance is symmetric"
            $( test.eq! (distance "saturday" "sunday") (distance "sunday" "saturday") ),
        test.case "distance on long strings"
            $( test.eq! 500 (distance (repeat 1000 "a") (repeat 500 "a" + repeat 500 "b")) ),
        test.case "wrap"             $( test.eq! "the quick\nbrown fox\njumps" (wrap 10 "the quick brown fox jumps") ),
        test.case "wrap keeps a long word whole"
            $( test.eq! "a\nextraordinarily\nb" (wrap 5 "a extraordinarily b") ),
        test.case "wrap of nothing"  $( test.eq! "" (wrap 10 "  ") ),
        test.case "dedent"           $( test.eq! "a\n  b\n\nc" (dedent "    a\n      b\n  \n    c") ),
        test.case "dedent of flush text" $( test.eq! "a\nb" (dedent "a\nb") ),
    ];
}

// --- optional types ---------------------------------------------------------

type Text = :string;
type Characters = [:char];
// Byte offsets are distinct from character positions in this library.
type Byte = :integer where fn n -> n >= 0 && n <= 255;
