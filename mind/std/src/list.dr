// Lists.
//
// A list is a chain of cells whose head and tail are both lazy, so most of
// what follows works on lists that are never fully built -- `take 5 (from 1)`
// asks for five cells of an infinite list and no more. Functions that must see
// the whole list to answer (`length`, `reverse`, `sort`) say so.
//
// Two rules decide the signatures below, and both are about the checker never
// reporting a program that works (see the head of `dreams/src/typecheck.dr`):
//
// - **A read by position answers `:any`.** A list in this library and in the
//   compiler is as often a record -- `[name, index]`, a span, a token -- as it
//   is a sequence, and the element type of a fixed-length list is the union of
//   its fields. `head [0, []]` answering `:integer | [:never]` is true and
//   useless: no one position holds that, and every `+` on it would be
//   reported. So `head`, `nth` and `last` say what they take and not what they
//   answer. Everything that treats the list as a sequence -- `map`, `fold`,
//   `filter` -- is generic in the element, because there the union is right.
// - **`()` is "nothing there", and the checker knows it.** `minimum` answers
//   `()` for an empty list, and the default handed to `first_or`, `map.get`
//   or `Result.unwrap_or` is `()` as often as not. So `()` fits any type
//   variable and never decides one (`solve` and `sub` in
//   `dreams/src/typecheck.dr`): `minimum` is `[a] -> a` although its body can
//   answer `()`, and `map.get () name ages` answers the map's value type
//   rather than that type or unit -- which a caller that guards with a `()`
//   arm, exactly as it should, could not otherwise use.

let empty : [a];
let empty = [];

// --- looking at a list ------------------------------------------------------

/// Test whether the list has no elements, without traversing it.
let is_empty : [a] -> :bool;
let is_empty xs = _list_is_empty xs;

/// The first element. Raises on an empty list; `first_or` is the total form.
let head : [a] -> :any;
let head xs = xs.[0];

/// Everything after the first element.
let tail : [a] -> [a];
let tail xs = _list_tail xs;

/// A new list with `x` on the front. Lazy in both, which is what lets a list
/// be defined in terms of itself.
let cons : a -> [a] -> [a];
let cons x xs = _list_cons x xs;

/// Return the first element, or `default` for an empty list.
let first_or : a -> [a] -> a;
let first_or default xs = if _list_is_empty xs { default } else { xs.[0] };

/// `acc` plus the length of `xs`. The accumulating form `length` was written
/// in terms of; both walk the spine in the machine now.
let length_from : :integer -> [a] -> :integer;
let length_from acc xs = acc + len xs;

/// Forces the whole spine, so it does not terminate on an infinite list.
///
/// `len` is the builtin, which walks the spine in the machine. Counting the
/// cells in Dream instead was a call, an `is_empty` and a `tail` each -- and
/// `sort` asks for a length at every level of its recursion, so the corpus
/// paid for it in the thousands.
let length : [a] -> :integer;
let length xs = len xs;

/// The element at `n`, counting from zero, or `()` when there is none.
///
/// `xs.[n else ()]` is the `get` opcode, so the walk down the spine happens in
/// the machine: one operation for the whole of it. Said the obvious way -- a
/// recursion over `is_empty`, `head` and `tail` -- it was six machine steps per
/// cell, and since a record in this compiler is a short list read by position
/// (`span_start s` is `nth 0 s`), that recursion was a sixth of everything a
/// compile did.
///
/// The body is one `get` of the parameters, which makes it a wrapper: a
/// saturated call of it is emitted as the opcode, with no call at all.
///
/// An index below zero is out of range and answers `()`, as an index past the
/// end does. The recursion this replaces treated any `n <= 0` as the head,
/// which was an accident of how it counted down rather than anything anyone
/// asked for -- and the opposite of what a caller guarding on `()` expects.
let nth : :integer -> [a] -> :any;
let nth n xs = xs.[n else ()];

/// The list, with every element computed now, first to last.
///
/// An element is suspended until something reads it, which is what laziness
/// means and is nearly always right. It is wrong when the elements are things
/// that must *happen* -- processes started, messages sent -- and the list is
/// only the way they are collected: `strict!` on the list computes its spine,
/// and `[spawn! $( a ), spawn! $( b )]` starts each process only when a reader
/// comes to it, so a join over them runs them one at a time. `forced` is the
/// fix, said once:
///
/// ```dream
/// import std.console;
/// import std.list;
/// import std.proc;
///
/// let square n = n * n;
///
/// let main! = {
///     // A process for each even number, every one started before any is joined.
///     let running = list.forced (list.flat_map (fn n -> if n % 2 == 0 { [spawn! $( square n )] } else { [] })
///                                              [1, 2, 3, 4]);
///     console.print! (proc.wait_all! running)
/// };
/// ```
///
/// It forces each element, not what each element holds; `lazy.settled` is
/// the deep form.
let forced : [a] -> [a];
let forced xs = after (force_each xs) xs;

/// `xs`, once `done` has been computed: a strict parameter is how a pure
/// function orders one computation before another.
priv let after : :unit -> [a] -> [a];
priv let after !done xs = xs;

/// `forced`'s loop: the strict parameter is where each element is computed.
priv let force_each : [a] -> :unit;
priv let rec force_each xs = if _list_is_empty xs { () } else { force_one (xs.[0]) (_list_tail xs) };
/// One element computed -- on entry, by the strict parameter -- and then the rest.
priv let force_one : a -> [a] -> :unit;
priv let force_one !x rest = force_each rest;

/// Return the last element, or `()` for an empty list. Traverses the entire list.
let last : [a] -> :any;
let last xs = {
    let rec go xs =
        if _list_is_empty (_list_tail xs) { xs.[0] } else { go (_list_tail xs) };
    if _list_is_empty xs { () } else { go xs }
};

/// The last element, or `default` for an empty list. Traverses the entire list.
let last_or : a -> [a] -> a;
let last_or default xs = if _list_is_empty xs { default } else { last xs };

// --- building ---------------------------------------------------------------

/// `xs` followed by `ys`.
///
/// This is what `+` on two lists means, so it is written as `+`: the spine of
/// `xs` is copied by the machine in one operation and its end pointed at `ys`,
/// with `ys` and every element left untouched. Spelling it out instead --
/// `_list_cons (head xs) (append (_list_tail xs) ys)` -- built a cons and a
/// suspended call per cell, and was a fifth of the work in a self-compile,
/// most of it reached through `concat`.
///
/// The one thing the recursion could do that this cannot is append to an
/// infinite list: `+` walks the whole of `xs` when it is forced, where the
/// recursion produced a cell at a time. Nothing lazy is lost on the right --
/// `ys` is never looked at -- so `concat` over an endless list of lists still
/// works, and only an endless list on the *left* is now a hang rather than an
/// answer. Nothing in this repository appends to one, and an infinite left
/// operand makes `ys` unreachable by definition.
let append : [a] -> [a] -> [a];
let append xs ys = xs + ys;

/// Prepend the elements of `xs` to `acc` in reverse order.
let reverse_from : [a] -> [a] -> [a];
let rec reverse_from acc xs =
    if _list_is_empty xs { acc } else { reverse_from (_list_cons (xs.[0]) acc) (_list_tail xs) };

/// Return the elements in reverse order. Traverses the entire list.
let reverse : [a] -> [a];
let reverse xs = reverse_from [] xs;

/// `range 1 4` is `[1, 2, 3]`: the end is not included, so `range 0 (length xs)`
/// indexes a list exactly.
let range : :integer -> :integer -> [:integer];
let rec range from until =
    if from >= until { [] } else { _list_cons from (range (from + 1) until) };

/// `range` counting by `step`: `range_step 0 10 3` is `[0, 3, 6, 9]`, and a
/// negative step counts down, `range_step 5 0 (0 - 2)` being `[5, 3, 1]`. The
/// end is never included. A step of zero would never reach it, so it answers
/// `[]` rather than an endless list of `from`.
let range_step : :integer -> :integer -> :integer -> [:integer];
let rec range_step from until step =
    if step > 0 && from < until { _list_cons from (range_step (from + step) until step) }
    else if step < 0 && from > until { _list_cons from (range_step (from + step) until step) }
    else { [] };

/// The infinite list `n, n+1, n+2, ...`. Only ever as long as it is used.
let from : :integer -> [:integer];
let rec from n = _list_cons n (from (n + 1));

/// An infinite list of one value.
let repeat : a -> [a];
let rec repeat x = _list_cons x (repeat x);

/// `x` repeated `n` times.
let replicate : :integer -> a -> [a];
let rec replicate n x = if n <= 0 { [] } else { _list_cons x (replicate (n - 1) x) };

// --- transforming -----------------------------------------------------------

/// Lazy: the result's tail is not built until it is asked for.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.map (fn x -> x * 2) [1, 2, 3])
/// };
/// ```
let map : (a -> b) -> [a] -> [b];
let rec map f xs =
    if _list_is_empty xs { [] } else { _list_cons (f (xs.[0])) (map f (_list_tail xs)) };

/// Keep elements satisfying `keep`, preserving their original order.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.filter (fn x -> x > 2) [1, 2, 3, 4])
/// };
/// ```
let filter : (a -> :bool) -> [a] -> [a];
let rec filter keep xs =
    if _list_is_empty xs { [] }
    else {
        let x = xs.[0];
        let rest = filter keep (_list_tail xs);
        if keep x { _list_cons x rest } else { rest }
    };

/// Accumulate from left to right with `f accumulator element`, starting at `acc`.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.fold (fn total x -> total + x) 0 [1, 2, 3])
/// };
/// ```
/// Each accumulator is forced to its outer value before the next element is
/// taken, the seed included; contents and elements stay lazy. A seed that
/// must stay unforced -- one the function may drop -- wants `fold_lazy`.
/// This is the order a fused loop keeps (`dreams/src/fuse.dr`), so a fold
/// means the same whether or not the compiler wrote it as one.
let fold : (b -> a -> b) -> b -> [a] -> b;
let fold f acc xs =
    if _list_is_empty xs { acc } else { strict_steps f acc xs };

/// A left fold with suspended accumulator steps. Use when a later step must
/// be able to discard an earlier step without evaluating it. Long numeric
/// folds should use `fold`, which avoids retaining a chain of suspensions.
let fold_lazy : (b -> a -> b) -> b -> [a] -> b;
let rec fold_lazy f acc xs =
    if _list_is_empty xs { acc } else { fold_lazy f (f acc (xs.[0])) (_list_tail xs) };

/// Compatibility spelling for `fold`. Each intermediate accumulator is
/// forced to its outer value; its contents and list elements stay lazy.
/// The seed is passed to the first callback unforced.
let fold_strict : (b -> a -> b) -> b -> [a] -> b;
let fold_strict f acc xs = fold f acc xs;

/// Accumulate from left to right, forcing each intermediate accumulator.
priv let strict_steps : (b -> a -> b) -> b -> [a] -> b;
priv let rec strict_steps f !acc xs =
    if _list_is_empty xs { acc } else { strict_steps f (f acc (xs.[0])) (_list_tail xs) };

/// Accumulate from right to left with `f element accumulator`, starting at `acc`.
let fold_right : (a -> b -> b) -> b -> [a] -> b;
let rec fold_right f acc xs =
    if _list_is_empty xs { acc } else { f (xs.[0]) (fold_right f acc (_list_tail xs)) };

/// Return at most the first `n` elements; nonpositive `n` returns an empty list.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.take 2 [10, 20, 30])
/// };
/// ```
let take : :integer -> [a] -> [a];
let rec take n xs =
    if n <= 0 { [] }
    else if _list_is_empty xs { [] }
    else { _list_cons (xs.[0]) (take (n - 1) (_list_tail xs)) };

/// Skip the first `n` elements; nonpositive `n` leaves the list unchanged.
let drop : :integer -> [a] -> [a];
let rec drop n xs =
    if n <= 0 { xs } else if _list_is_empty xs { [] } else { drop (n - 1) (_list_tail xs) };

/// Return the longest initial run of elements satisfying `keep`.
let take_while : (a -> :bool) -> [a] -> [a];
let rec take_while keep xs =
    if _list_is_empty xs { [] }
    else if keep (xs.[0]) { _list_cons (xs.[0]) (take_while keep (_list_tail xs)) }
    else { [] };

/// Skip the initial run of elements satisfying `skip`.
let drop_while : (a -> :bool) -> [a] -> [a];
let rec drop_while skip xs =
    if _list_is_empty xs { [] }
    else if skip (xs.[0]) { drop_while skip (_list_tail xs) }
    else { xs };

/// Pair corresponding elements, stopping when either list ends.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.zip [1, 2] ["a", "b"])
/// };
/// ```
let zip : [a] -> [b] -> [[a, b]];
let rec zip xs ys =
    if _list_is_empty xs { [] }
    else if _list_is_empty ys { [] }
    else {
        _list_cons [xs.[0], ys.[0]] (zip (_list_tail xs) (_list_tail ys))
    };

/// Flatten a list of lists by joining them in order.
let concat : [[a]] -> [a];
let rec concat xss =
    if _list_is_empty xss { [] } else { append (xss.[0]) (concat (_list_tail xss)) };

/// Apply `f` to each element and concatenate the lists it returns.
let flat_map : (a -> [b]) -> [a] -> [b];
let flat_map f xs = concat (map f xs);

/// Every element with its index, as `[index, element]`.
let enumerate : [a] -> [[:integer, a]];
let enumerate xs = zip (from 0) xs;

/// `f` applied to corresponding elements, stopping when either list ends:
/// `zip_with (fn a b -> a + b) xs ys` without the pairs `zip` would build.
let zip_with : (a -> b -> c) -> [a] -> [b] -> [c];
let rec zip_with f xs ys =
    if _list_is_empty xs { [] }
    else if _list_is_empty ys { [] }
    else { _list_cons (f (xs.[0]) (ys.[0])) (zip_with f (_list_tail xs) (_list_tail ys)) };

/// The firsts and the seconds of a list of pairs: `zip` undone.
let unzip : [[a, b]] -> [[a], [b]];
let unzip ps = [map (fn p -> p.[0]) ps, map (fn p -> p.[1]) ps];

/// The running fold: `init`, then each accumulator `fold` would pass through,
/// so `scan (fn a b -> a + b) 0 [1, 2, 3]` is `[0, 1, 3, 6]` and its last is
/// what `fold` answers. Lazy in the spine, so it runs over an endless list;
/// each accumulator is forced as the cell after it is asked for, which is
/// what keeps a long scan from becoming a chain of suspended additions.
let scan : (b -> a -> b) -> b -> [a] -> [b];
let rec scan f !acc xs =
    _list_cons acc (if _list_is_empty xs { [] } else { scan f (f acc (xs.[0])) (_list_tail xs) });

/// The endless list `x, f x, f (f x), ..`. Each value is forced before the
/// next is made, for the reason `scan` gives.
let iterate : (a -> a) -> a -> [a];
let rec iterate f !x = _list_cons x (iterate f (f x));

/// The list's elements over and over, without end; the empty list for an empty
/// one, which has nothing to repeat.
///
/// Not `xs + cycle xs`: `+` forces both sides before it looks at either, so
/// that recursion never answers a first cell.
let cycle : [a] -> [a];
let cycle xs = if _list_is_empty xs { [] } else { cycle_through xs xs };

/// The rest of `xs`, then `whole` again from its start, without end.
priv let cycle_through : [a] -> [a] -> [a];
priv let rec cycle_through whole xs =
    if _list_is_empty xs { cycle_through whole whole }
    else { _list_cons (xs.[0]) (cycle_through whole (_list_tail xs)) };

/// `sep` between each pair of elements: `intersperse 0 [1, 2, 3]` is
/// `[1, 0, 2, 0, 3]`.
let intersperse : a -> [a] -> [a];
let intersperse sep xs =
    if _list_is_empty xs { [] } else { _list_cons (xs.[0]) (before_each sep (_list_tail xs)) };

/// Each element of `xs` with `sep` in front of it.
priv let before_each : a -> [a] -> [a];
priv let rec before_each sep xs =
    if _list_is_empty xs { [] }
    else { _list_cons sep (_list_cons (xs.[0]) (before_each sep (_list_tail xs))) };

/// The list cut into runs of `n`, the last one shorter when `n` does not
/// divide the length: `chunks 2 [1, 2, 3]` is `[[1, 2], [3]]`. An `n` below
/// one is taken as one, since a chunk of nothing would never get anywhere.
/// Lazy, so a stream can be read in batches.
let chunks : :integer -> [a] -> [[a]];
let rec chunks n xs =
    if _list_is_empty xs { [] }
    else {
        let k = if n < 1 { 1 } else { n };
        _list_cons (take k xs) (chunks k (drop k xs))
    };

/// Every run of `n` consecutive elements, overlapping, in order:
/// `windows 2 [1, 2, 3]` is `[[1, 2], [2, 3]]` -- the shape of a difference
/// between neighbours or a moving average. Empty for an `n` below one or a
/// list shorter than `n`.
let windows : :integer -> [a] -> [[a]];
let rec windows n xs = {
    let w = take n xs;
    if n < 1 || len w < n { [] } else { _list_cons w (windows n (_list_tail xs)) }
};

/// `[take n xs, drop n xs]`.
let split_at : :integer -> [a] -> [[a], [a]];
let split_at n xs = [take n xs, drop n xs];

/// `[take_while keep xs, drop_while keep xs]`: the leading run that satisfies
/// `keep`, and everything from the first element that does not.
let split_while : (a -> :bool) -> [a] -> [[a], [a]];
let split_while keep xs = [take_while keep xs, drop_while keep xs];

/// `f` of each element, keeping only what is not `()` -- a `map` and a
/// `filter` in one walk, for the many functions in this library and outside it
/// that answer `()` for "nothing here".
let filter_map : (a -> b) -> [a] -> [b];
let rec filter_map f xs =
    if _list_is_empty xs { [] }
    else {
        let y = f (xs.[0]);
        let rest = filter_map f (_list_tail xs);
        if y == () { rest } else { _list_cons y rest }
    };

/// The list without its `()` elements: what a list literal of optional parts
/// -- `[a, if b { c } else { () }, d]` -- or a `map` of a function that may
/// find nothing wants before it is used.
let compact : [a] -> [a];
let compact xs = filter (fn x -> x != ()) xs;

/// The first element for each `key`, in order. The keys are kept in a map, so
/// this is linear where `unique` is quadratic -- and a key is compared as a
/// map compares it: by value for numbers, strings, atoms and the other flat
/// types, by identity for anything else. Key on something flat.
let unique_on : (a -> k) -> [a] -> [a];
let unique_on key xs = unique_on_from %{} key xs;

/// `unique_on`, with the keys already seen.
priv let unique_on_from : %{ k => :bool } -> (a -> k) -> [a] -> [a];
priv let rec unique_on_from seen key xs =
    if _list_is_empty xs { [] }
    else {
        let x = xs.[0];
        let k = key x;
        if _map_has seen k { unique_on_from seen key (_list_tail xs) }
        else { _list_cons x (unique_on_from (seen.[k => true]) key (_list_tail xs)) }
    };

/// Rows made columns: `transpose [[1, 2], [3, 4]]` is `[[1, 3], [2, 4]]`. A
/// short row ends the result where it ends, as `zip` does.
let transpose : [[a]] -> [[a]];
let rec transpose rows =
    if _list_is_empty rows || any (fn r -> _list_is_empty r) rows { [] }
    else { _list_cons (map (fn r -> r.[0]) rows) (transpose (map (fn r -> _list_tail r) rows)) };

/// The last `n` elements, or all of them when there are fewer. Walks the
/// spine to find its length.
let take_last : :integer -> [a] -> [a];
let take_last n xs = drop (len xs - n) xs;

/// All but the last `n` elements. Walks the spine to find its length.
let drop_last : :integer -> [a] -> [a];
let drop_last n xs = take (len xs - n) xs;

/// The list without the element at `i`; as it was when there is none there.
let remove_at : :integer -> [a] -> [a];
let rec remove_at i xs =
    if i < 0 || _list_is_empty xs { xs }
    else if i == 0 { _list_tail xs }
    else { _list_cons (xs.[0]) (remove_at (i - 1) (_list_tail xs)) };

/// The list with `x` placed at index `i`, the elements from there on moved
/// one along. An `i` past the end puts `x` at the end; one below zero, at the
/// front.
let insert_at : :integer -> a -> [a] -> [a];
let rec insert_at i x xs =
    if i <= 0 || _list_is_empty xs { _list_cons x xs }
    else { _list_cons (xs.[0]) (insert_at (i - 1) x (_list_tail xs)) };

/// The list with the element at `i` replaced by `f` of it. An index out of
/// range changes nothing. Lazy, like `remove_at`: the cells after `i` are the
/// original's, shared rather than copied.
let update_at : :integer -> (a -> a) -> [a] -> [a];
let rec update_at i f xs =
    if i < 0 || _list_is_empty xs { xs }
    else if i == 0 { _list_cons (f (xs.[0])) (_list_tail xs) }
    else { _list_cons (xs.[0]) (update_at (i - 1) f (_list_tail xs)) };

/// The list turned left by `n`: `rotate 1 [1, 2, 3]` is `[2, 3, 1]`. A
/// negative `n` turns it right, and any `n` is taken modulo the length, so
/// the list is walked once to count it and the answer shares its tail.
let rotate : :integer -> [a] -> [a];
let rotate n xs = {
    let size = len xs;
    if size == 0 { xs }
    else {
        let r = n % size;
        let k = if r < 0 { r + size } else { r };
        if k == 0 { xs } else { drop k xs + take k xs }
    }
};

/// Elements of `xs` and `ys` taken in turn, starting with `xs`; whatever is
/// left of the longer one follows. Lazy in both, so either may be endless.
let interleave : [a] -> [a] -> [a];
let rec interleave xs ys =
    if _list_is_empty xs { ys }
    else { _list_cons (xs.[0]) (interleave ys (_list_tail xs)) };

/// The list with each run of equal neighbours kept once: `dedup [1, 1, 2, 1]`
/// is `[1, 2, 1]`. Only neighbours, so it is lazy and linear -- `unique` is
/// the one that drops every repeat, and has to remember what it has seen.
let dedup : [a] -> [a];
let dedup xs = if _list_is_empty xs { [] } else { _list_cons (xs.[0]) (dedup_after (xs.[0]) (_list_tail xs)) };

/// What follows `prev` in a deduplicated list: its neighbours equal to it dropped.
priv let dedup_after : a -> [a] -> [a];
priv let rec dedup_after prev xs =
    if _list_is_empty xs { [] }
    else {
        let x = xs.[0];
        if x == prev { dedup_after prev (_list_tail xs) }
        else { _list_cons x (dedup_after x (_list_tail xs)) }
    };

/// The list cut into runs of neighbours that agree on `key`:
/// `chunk_by (fn n -> n % 2) [1, 3, 2, 4, 5]` is `[[1, 3], [2, 4], [5]]`.
/// Each run is gathered in one pass that asks `key` once per element; the
/// list of runs is lazy, so the next run is not looked for until it is wanted.
let chunk_by : (a -> k) -> [a] -> [[a]];
let rec chunk_by key xs =
    if _list_is_empty xs { [] }
    else {
        let x = xs.[0];
        let [run, rest] = run_of key (key x) [x] (_list_tail xs);
        _list_cons run (chunk_by key rest)
    };

/// The run `chunk_by` is gathering, reversed in `acc`, and what follows it.
priv let run_of : (a -> k) -> k -> [a] -> [a] -> [[a], [a]];
priv let rec run_of key k !acc xs =
    if _list_is_empty xs { [reverse acc, []] }
    else if key (xs.[0]) == k { run_of key k (_list_cons (xs.[0]) acc) (_list_tail xs) }
    else { [reverse acc, xs] };

/// Three lists zipped into triples, as long as the shortest.
let zip3 : [a] -> [b] -> [c] -> [[a, b, c]];
let rec zip3 xs ys zs =
    if _list_is_empty xs || _list_is_empty ys || _list_is_empty zs { [] }
    else { _list_cons [xs.[0], ys.[0], zs.[0]] (zip3 (_list_tail xs) (_list_tail ys) (_list_tail zs)) };

// --- asking -----------------------------------------------------------------

/// Test whether any element satisfies `pred`; stop at the first match.
let any : (a -> :bool) -> [a] -> :bool;
let rec any pred xs =
    if _list_is_empty xs { false }
    else if pred (xs.[0]) { true }
    else { any pred (_list_tail xs) };

/// Test whether every element satisfies `pred`; an empty list returns true.
let all : (a -> :bool) -> [a] -> :bool;
let rec all pred xs =
    if _list_is_empty xs { true }
    else if pred (xs.[0]) { all pred (_list_tail xs) }
    else { false };

/// Test whether no element satisfies `pred`. Stops at the first that does.
let none : (a -> :bool) -> [a] -> :bool;
let none pred xs = not (any pred xs);

/// Test whether any element equals `x`.
let contains : a -> [a] -> :bool;
let contains x xs = any (fn y -> y == x) xs;

/// Count elements satisfying `pred`.
let count : (a -> :bool) -> [a] -> :integer;
let count pred xs = fold (fn acc x -> if pred x { acc + 1 } else { acc }) 0 xs;

/// The first element satisfying `pred`, or `()` when none does. Stops at the
/// first match, so it finds one in an endless list.
let find : (a -> :bool) -> [a] -> a;
let rec find pred xs =
    if _list_is_empty xs { () }
    else if pred (xs.[0]) { xs.[0] }
    else { find pred (_list_tail xs) };

/// The first answer of `f` that is not `()`, or `()` when there is none --
/// `find` and `map` in one walk that stops as soon as it has something.
let find_map : (a -> b) -> [a] -> b;
let rec find_map f xs =
    if _list_is_empty xs { () }
    else {
        let y = f (xs.[0]);
        if y == () { find_map f (_list_tail xs) } else { y }
    };

/// The index of the first element satisfying `pred`, or -1.
let find_index : (a -> :bool) -> [a] -> :integer;
let find_index pred xs = find_index_from 0 pred xs;

/// `find_index`, counting positions from `i`.
priv let find_index_from : :integer -> (a -> :bool) -> [a] -> :integer;
priv let rec find_index_from !i pred xs =
    if _list_is_empty xs { 0 - 1 }
    else if pred (xs.[0]) { i }
    else { find_index_from (i + 1) pred (_list_tail xs) };

/// Test whether `xs` begins with the elements of `prefix`, in order.
let starts_with : [a] -> [a] -> :bool;
let rec starts_with prefix xs =
    if _list_is_empty prefix { true }
    else if _list_is_empty xs { false }
    else if prefix.[0] == xs.[0] { starts_with (_list_tail prefix) (_list_tail xs) }
    else { false };

/// Search for `x`, counting positions from `i`; return -1 when absent.
let index_of_from : :integer -> a -> [a] -> :integer;
let rec index_of_from !i x xs =
    if _list_is_empty xs { 0 - 1 }
    else if xs.[0] == x { i }
    else { index_of_from (i + 1) x (_list_tail xs) };

/// The index of the first `x`, or -1.
let index_of : a -> [a] -> :integer;
let index_of x xs = index_of_from 0 x xs;

// Strict, because a sum is a number and a lazy one is a million suspended
// additions waiting to overflow the machine. A `sum` over a `range` is fused
// and runs none of this.
/// Add all elements, returning 0 for an empty list.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.sum [1, 2, 3])
/// };
/// ```
let sum : [(:integer | :float)] -> (:integer | :float);
let sum xs = fold (fn a b -> a + b) 0 xs;
/// Multiply all elements, returning 1 for an empty list.
let product : [(:integer | :float)] -> (:integer | :float);
let product xs = fold (fn a b -> a * b) 1 xs;

// `best` is strict because `next` below is a suspended `if` that names the
// last one, so a lazy `best` is a chain as long as the list. Both callers
// compare it on every step anyway, so this forces nothing they did not.
/// Keep the best element seen so far according to the comparison `less`.
let min_by_from : a -> (a -> a -> :bool) -> [a] -> a;
let rec min_by_from !best less xs =
    if _list_is_empty xs { best }
    else {
        let x = xs.[0];
        let next = if less x best { x } else { best };
        min_by_from next less (_list_tail xs)
    };

/// Return the smallest element, or `()` for an empty list.
let minimum : [a] -> a;
let minimum xs =
    if _list_is_empty xs { () }
    else { min_by_from (xs.[0]) (fn a b -> compare a b < 0) (_list_tail xs) };

/// Return the largest element, or `()` for an empty list.
let maximum : [a] -> a;
let maximum xs =
    if _list_is_empty xs { () }
    else { min_by_from (xs.[0]) (fn a b -> compare a b > 0) (_list_tail xs) };

/// The element whose `key` is smallest, the first of any that tie, or `()` for
/// an empty list. `key` is asked once per element.
let minimum_on : (a -> b) -> [a] -> a;
let minimum_on key xs =
    if _list_is_empty xs { () }
    else { best_on (fn a b -> compare a b < 0) key (xs.[0]) (key (xs.[0])) (_list_tail xs) };

/// The element whose `key` is largest, the first of any that tie, or `()`.
let maximum_on : (a -> b) -> [a] -> a;
let maximum_on key xs =
    if _list_is_empty xs { () }
    else { best_on (fn a b -> compare a b > 0) key (xs.[0]) (key (xs.[0])) (_list_tail xs) };

/// The element `better` ranks first by key, given the best so far and its key.
priv let best_on : (b -> b -> :bool) -> (a -> b) -> a -> b -> [a] -> a;
priv let rec best_on better key best !best_key xs =
    if _list_is_empty xs { best }
    else {
        let x = xs.[0];
        let k = key x;
        if better k best_key { best_on better key x k (_list_tail xs) }
        else { best_on better key best best_key (_list_tail xs) }
    };

/// The elements that satisfy `pred`, then those that do not.
let partition : (a -> :bool) -> [a] -> [[a], [a]];
let partition pred xs = [filter pred xs, filter (fn x -> not (pred x)) xs];

/// Remove values already in `seen` and subsequent duplicates, preserving first occurrences.
let unique_from : [a] -> [a] -> [a];
let rec unique_from seen xs =
    if _list_is_empty xs { [] }
    else {
        let x = xs.[0];
        let rest = _list_tail xs;
        if contains x seen { unique_from seen rest }
        else { _list_cons x (unique_from (_list_cons x seen) rest) }
    };

/// Keeps the first occurrence of each element.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.unique [1, 2, 1, 3])
/// };
/// ```
let unique : [a] -> [a];
let unique xs = unique_from [] xs;

// --- ordering ---------------------------------------------------------------

/// Merge two lists already sorted by `before`, preserving equal-element order.
let merge_by : (a -> a -> :bool) -> [a] -> [a] -> [a];
let rec merge_by before xs ys =
    if _list_is_empty xs { ys }
    else if _list_is_empty ys { xs }
    else {
        let x = xs.[0];
        let y = ys.[0];
        // `before y x` rather than `before x y` keeps the sort stable: equal
        // elements take the one from `xs` first.
        if before y x { _list_cons y (merge_by before xs (_list_tail ys)) }
        else { _list_cons x (merge_by before (_list_tail xs) ys) }
    };

/// Stable-sort the list using `before a b` as the ordering predicate.
let sort_by : (a -> a -> :bool) -> [a] -> [a];
let rec sort_by before xs = {
    let n = length xs;
    if n <= 1 { xs }
    else {
        let half = n / 2;
        merge_by before (sort_by before (take half xs)) (sort_by before (drop half xs))
    }
};

/// Ascending, by the runtime's total order over the flat types. Stable.
///
/// The machine sorts (`_sort_keyed`): this and `sort_on` were `sort_by`'s merge
/// sort, which takes its list apart and builds it again at every level, and
/// `sort_on` asked for each key at every comparison. A key is forced whole
/// before the sort starts, where a comparison forces a key only as far as it
/// needs to; that is the one difference, and it is one only for a key with a
/// part that cannot be forced.
///
/// ```dream
/// import std.list;
/// import std.console;
///
/// let main! = {
///     console.print! (list.sort [3, 1, 2])
/// };
/// ```
let sort : [a] -> [a];
let sort xs = {
    let items = _array_of_list xs;
    _sort_keyed (_array_to_list items) items
};

/// Ascending by a key extracted from each element, which is asked for once
/// per element. Stable.
let sort_on : (a -> b) -> [a] -> [a];
let sort_on key xs = {
    let items = _array_of_list xs;
    _sort_keyed (map key (_array_to_list items)) items
};

/// Test whether each element is no greater than the next, by `compare`.
/// Stops at the first pair out of order.
let is_sorted : [a] -> :bool;
let is_sorted xs = _list_is_empty xs || sorted_after (xs.[0]) (_list_tail xs);

/// Whether `xs` is in order and starts no lower than `prev`.
priv let sorted_after : a -> [a] -> :bool;
priv let rec sorted_after prev xs =
    if _list_is_empty xs { true }
    else if compare prev (xs.[0]) > 0 { false }
    else { sorted_after (xs.[0]) (_list_tail xs) };

// --- effects ----------------------------------------------------------------

/// Run `f!` on each element in order, for what it does. The list is walked one
/// cell at a time as it goes, so an endless list runs for ever rather than
/// being built first. The answers are dropped; `map` keeps them.
let each! : (a -> :any) -> [a] -> :unit;
let rec each! f! xs =
    if _list_is_empty xs { () }
    else {
        f! (xs.[0])
        each! f! (_list_tail xs)
    };

/// `each!` with each element's position, counting from `0`: `f! i x`. What a
/// numbered listing wants, without zipping the list to a range first.
let each_index! : (:integer -> a -> :any) -> [a] -> :unit;
let each_index! f! xs = each_from! f! 0 xs;

/// `each_index!`'s loop, from position `i`; the position is strict so that a
/// long list does not leave a chain of `+ 1`s behind it.
priv let each_from! : (:integer -> a -> :any) -> :integer -> [a] -> :unit;
priv let rec each_from! f! !i xs =
    if _list_is_empty xs { () }
    else {
        f! i (xs.[0])
        each_from! f! (i + 1) (_list_tail xs)
    };

// --- conversion -------------------------------------------------------------

/// Materialize the list as an array in the same order.
let to_array : [a] -> #[a];
let to_array xs = _array_of_list xs;
/// Return an array's elements as a list in index order.
let of_array : #[a] -> [a];
let of_array a = _array_to_list a;

// --- tests ------------------------------------------------------------------
//
// Compiled with --test`, which builds an entry point that runs the
// `tests` every loaded module exports.

when test {
    import std.test;

    let tests = [
        test.case "length of empty"     $( test.eq! 0 (length []) ),
        test.case "length"              $( test.eq! 3 (length [1, 2, 3]) ),
        test.case "head"                $( test.eq! 1 (head [1, 2, 3]) ),
        test.case "head of empty raises" $( test.raises! $( head [] ) ),
        test.case "tail"                $( test.eq! [2, 3] (tail [1, 2, 3]) ),
        test.case "first_or on empty"   $( test.eq! :none (first_or :none []) ),
        test.case "first_or"            $( test.eq! 1 (first_or :none [1]) ),
        test.case "nth"                 $( test.eq! 3 (nth 2 [1, 2, 3]) ),
        test.case "nth past the end"    $( test.eq! () (nth 9 [1, 2, 3]) ),
        test.case "forced computes every element before answering"
            $( test.eq! [1, 2] (forced [1, 2]) ),
        test.case "forced reaches an element nothing else reads"
            $( test.eq! :error (type_of (try! { forced [1, 1 / len []]; () } catch e { e })) ),
        test.case "nth of empty"        $( test.eq! () (nth 0 []) ),
        test.case "nth below zero"      $( test.eq! () (nth (0 - 1) [1, 2, 3]) ),
        test.case "last"                $( test.eq! 3 (last [1, 2, 3]) ),

        test.case "append"              $( test.eq! [1, 2, 3] (append [1] [2, 3]) ),
        test.case "append to empty"     $( test.eq! [1] (append [] [1]) ),
        test.case "append nothing"      $( test.eq! [1] (append [1] []) ),
        // The right side is never walked, which is what lets `concat` run
        // down a list of lists that has no end.
        test.case "append keeps the right lazy"
            $( test.eq! 1 (head (append [1] (map (fn _ -> test.boom) (range 0 3)))) ),
        test.case "reverse"             $( test.eq! [3, 2, 1] (reverse [1, 2, 3]) ),
        test.case "reverse of empty"    $( test.empty! (reverse []) ),
        test.case "range"               $( test.eq! [1, 2, 3] (range 1 4) ),
        test.case "empty range"         $( test.empty! (range 3 3) ),
        test.case "replicate"           $( test.eq! [:x, :x] (replicate 2 :x) ),

        test.case "map"                 $( test.eq! [2, 4] (map (fn x -> x * 2) [1, 2]) ),
        test.case "map over empty"      $( test.empty! (map (fn x -> x) []) ),
        test.case "filter"              $( test.eq! [2, 4] (filter (fn x -> x % 2 == 0) [1, 2, 3, 4]) ),
        test.case "fold"                $( test.eq! 10 (fold (fn a b -> a + b) 0 [1, 2, 3, 4]) ),
        test.case "fold is left to right"
            $( test.eq! "abc" (fold (fn a b -> a + b) "" ["a", "b", "c"]) ),
        test.case "fold_right"
            $( test.eq! "abc" (fold_right (fn x acc -> x + acc) "" ["a", "b", "c"]) ),
        test.case "fold_strict agrees with fold"
            $( test.eq! (fold (fn a b -> a + b) 0 (range 0 100))
                        (fold_strict (fn a b -> a + b) 0 (range 0 100)) ),
        test.case "fold_strict is left to right"
            $( test.eq! "abc" (fold_strict (fn a b -> a + b) "" ["a", "b", "c"]) ),
        test.case "fold_strict over empty is the seed"
            $( test.eq! 7 (fold_strict (fn a b -> a + b) 7 []) ),
        // The reason it exists: a lazy fold over a list this long is a chain of
        // suspensions deep enough to exhaust the stack when it is finally
        // forced. This one keeps a value between steps, so it does not.
        test.case "fold_strict survives a list a lazy fold would not"
            $( test.eq! 19999900000 (fold_strict (fn a b -> a + b) 0 (range 0 200000)) ),
        // The force must not double as the fold's stopping condition. Testing
        // for `:unit` instead of an impossible atom would end the fold early
        // the moment a step answered `()`.
        test.case "fold_strict does not stop at a unit accumulator"
            $( test.eq! 3 (fold_strict (fn a b -> if b == 1 { () } else { 3 }) 0 [1, 2]) ),
        test.case "take"                $( test.eq! [1, 2] (take 2 [1, 2, 3]) ),
        test.case "take more than there is" $( test.eq! [1] (take 5 [1]) ),
        test.case "drop"                $( test.eq! [3] (drop 2 [1, 2, 3]) ),
        test.case "drop more than there is" $( test.empty! (drop 5 [1]) ),
        test.case "take_while"          $( test.eq! [1, 2] (take_while (fn x -> x < 3) [1, 2, 3, 1]) ),
        test.case "drop_while"          $( test.eq! [3, 1] (drop_while (fn x -> x < 3) [1, 2, 3, 1]) ),
        test.case "zip"                 $( test.eq! [[1, :a], [2, :b]] (zip [1, 2, 3] [:a, :b]) ),
        test.case "concat"              $( test.eq! [1, 2, 3] (concat [[1], [], [2, 3]]) ),
        test.case "flat_map"            $( test.eq! [1, 1, 2, 2] (flat_map (fn x -> [x, x]) [1, 2]) ),
        test.case "enumerate"           $( test.eq! [[0, :a], [1, :b]] (enumerate [:a, :b]) ),
        test.case "zip_with"            $( test.eq! [11, 22] (zip_with (fn a b -> a + b) [1, 2, 3] [10, 20]) ),
        test.case "unzip"               $( test.eq! [[1, 2], [:a, :b]] (unzip [[1, :a], [2, :b]]) ),
        test.case "scan"                $( test.eq! [0, 1, 3, 6] (scan (fn a b -> a + b) 0 [1, 2, 3]) ),
        test.case "scan of empty"       $( test.eq! [7] (scan (fn a b -> a + b) 7 []) ),
        test.case "scan's last is fold's answer"
            $( test.eq! (fold_strict (fn a b -> a + b) 0 (range 0 200000))
                        (last (scan (fn a b -> a + b) 0 (range 0 200000))) ),
        test.case "scan over an infinite list" $( test.eq! [0, 0, 1, 3] (take 4 (scan (fn a b -> a + b) 0 (from 0))) ),
        test.case "iterate"             $( test.eq! [1, 2, 4, 8] (take 4 (iterate (fn x -> x * 2) 1)) ),
        test.case "cycle"               $( test.eq! [1, 2, 1, 2, 1] (take 5 (cycle [1, 2])) ),
        test.case "cycle of empty"      $( test.empty! (cycle []) ),
        test.case "intersperse"         $( test.eq! [1, 0, 2, 0, 3] (intersperse 0 [1, 2, 3]) ),
        test.case "intersperse short"   $( test.eq! [[], [1]] [intersperse 0 [], intersperse 0 [1]] ),
        test.case "chunks"              $( test.eq! [[1, 2], [3, 4], [5]] (chunks 2 [1, 2, 3, 4, 5]) ),
        test.case "chunks of nothing"   $( test.empty! (chunks 3 []) ),
        test.case "chunks below one"    $( test.eq! [[1], [2]] (chunks 0 [1, 2]) ),
        test.case "chunks of an infinite list" $( test.eq! [[0, 1], [2, 3]] (take 2 (chunks 2 (from 0))) ),
        test.case "windows"             $( test.eq! [[1, 2], [2, 3]] (windows 2 [1, 2, 3]) ),
        test.case "windows too wide"    $( test.eq! [[], []] [windows 4 [1, 2, 3], windows 0 [1]] ),
        test.case "split_at"            $( test.eq! [[1], [2, 3]] (split_at 1 [1, 2, 3]) ),
        test.case "split_while"         $( test.eq! [[1, 2], [3, 1]] (split_while (fn x -> x < 3) [1, 2, 3, 1]) ),
        test.case "filter_map"          $( test.eq! [20, 40] (filter_map (fn x -> if x % 2 == 0 { x * 10 } else { () }) [1, 2, 3, 4]) ),
        test.case "compact"             $( test.eq! [1, 2] (compact [(), 1, (), 2]) ),
        test.case "unique_on"           $( test.eq! [[1, :a], [2, :b]] (unique_on (fn p -> head p) [[1, :a], [2, :b], [1, :c]]) ),
        test.case "transpose"           $( test.eq! [[1, 3], [2, 4]] (transpose [[1, 2], [3, 4]]) ),
        test.case "transpose of ragged rows" $( test.eq! [[1, 3]] (transpose [[1, 2], [3]]) ),
        test.case "transpose of nothing" $( test.empty! (transpose []) ),
        test.case "take_last"           $( test.eq! [[2, 3], [1, 2, 3]] [take_last 2 [1, 2, 3], take_last 9 [1, 2, 3]] ),
        test.case "drop_last"           $( test.eq! [[1], []] [drop_last 2 [1, 2, 3], drop_last 9 [1, 2, 3]] ),
        test.case "remove_at"           $( test.eq! [[1, 3], [1, 2, 3], [1, 2, 3]]
                                                    [remove_at 1 [1, 2, 3], remove_at 5 [1, 2, 3], remove_at (0 - 1) [1, 2, 3]] ),
        test.case "insert_at"           $( test.eq! [[1, 9, 2], [9, 1, 2], [1, 2, 9]]
                                                    [insert_at 1 9 [1, 2], insert_at 0 9 [1, 2], insert_at 7 9 [1, 2]] ),

        test.case "any"                 $( test.true! (any (fn x -> x > 2) [1, 3]) ),
        test.case "any on empty"        $( test.false! (any (fn x -> true) []) ),
        test.case "all"                 $( test.true! (all (fn x -> x > 0) [1, 2]) ),
        test.case "all on empty"        $( test.true! (all (fn x -> false) []) ),
        test.case "contains"            $( test.true! (contains 2 [1, 2]) ),
        test.case "count"               $( test.eq! 2 (count (fn x -> x > 1) [1, 2, 3]) ),
        test.case "index_of"            $( test.eq! 1 (index_of :b [:a, :b]) ),
        test.case "index_of missing"    $( test.eq! (0 - 1) (index_of :z [:a]) ),
        test.case "find"                $( test.eq! [3, ()] [find (fn x -> x > 2) [1, 3, 4], find (fn x -> x > 9) [1]] ),
        test.case "find in an infinite list" $( test.eq! 10 (find (fn x -> x * x > 90) (from 0)) ),
        test.case "find_index"          $( test.eq! [1, 0 - 1] [find_index (fn x -> x > 2) [1, 3], find_index (fn x -> x > 9) [1]] ),
        test.case "starts_with"         $( test.eq! [true, true, false, false]
                                                    [starts_with [1, 2] [1, 2, 3], starts_with [] [1],
                                                     starts_with [1, 3] [1, 2, 3], starts_with [1, 2] [1]] ),
        test.case "minimum_on"          $( test.eq! "a" (minimum_on (fn s -> len s) ["abc", "a", "b"]) ),
        test.case "maximum_on"          $( test.eq! "abc" (maximum_on (fn s -> len s) ["a", "abc", "xyz"]) ),
        test.case "minimum_on of empty" $( test.eq! () (minimum_on (fn x -> x) []) ),
        test.case "sum"                 $( test.eq! 6 (sum [1, 2, 3]) ),
        test.case "sum of empty"        $( test.eq! 0 (sum []) ),
        test.case "product"             $( test.eq! 24 (product [1, 2, 3, 4]) ),
        test.case "minimum"             $( test.eq! 1 (minimum [3, 1, 2]) ),
        test.case "maximum"             $( test.eq! 3 (maximum [3, 1, 2]) ),
        test.case "partition"           $( test.eq! [[2], [1, 3]] (partition (fn x -> x % 2 == 0) [1, 2, 3]) ),
        test.case "unique"              $( test.eq! [1, 2, 3] (unique [1, 2, 1, 3, 2]) ),

        test.case "sort"                $( test.eq! [1, 2, 3] (sort [3, 1, 2]) ),
        test.case "sort is stable"
            $( test.eq! [[1, :a], [1, :b]] (sort_on (fn p -> head p) [[1, :a], [1, :b]]) ),
        test.case "sort strings"        $( test.eq! ["a", "b"] (sort ["b", "a"]) ),
        test.case "sort of empty"       $( test.empty! (sort []) ),
        test.case "sort on a list key"
            $( test.eq! [[1, 2], [1, 3], [2, 0]] (sort [[2, 0], [1, 3], [1, 2]]) ),
        test.case "a prefix sorts first" $( test.eq! [[], [1], [1, 1]] (sort [[1, 1], [], [1]]) ),
        test.case "sort_by descending"
            $( test.eq! [3, 2, 1] (sort_by (fn a b -> a > b) [1, 3, 2]) ),

        test.case "to_array and back"   $( test.eq! [1, 2] (of_array (to_array [1, 2])) ),

        // Laziness is a property worth testing directly: each of these would
        // not terminate if the list were built eagerly.
        test.case "take from an infinite list"  $( test.eq! [0, 1, 2] (take 3 (from 0)) ),
        test.case "map over an infinite list"   $( test.eq! [0, 2, 4] (take 3 (map (fn x -> x * 2) (from 0))) ),
        test.case "filter an infinite list"     $( test.eq! [0, 2, 4] (take 3 (filter (fn x -> x % 2 == 0) (from 0))) ),
        test.case "take_while on an infinite list" $( test.eq! [0, 1] (take_while (fn x -> x < 2) (from 0)) ),
        test.case "repeat is infinite"          $( test.eq! [:x, :x] (take 2 (repeat :x)) ),
        test.case "zip stops at the shorter"    $( test.eq! [[1, 0]] (zip [1] (from 0)) ),

        test.case "last_or"             $( test.eq! [3, :none] [last_or :none [1, 2, 3], last_or :none []] ),
        test.case "range_step up"       $( test.eq! [0, 3, 6, 9] (range_step 0 10 3) ),
        test.case "range_step down"     $( test.eq! [5, 3, 1] (range_step 5 0 (0 - 2)) ),
        test.case "range_step of zero"  $( test.empty! (range_step 0 5 0) ),
        test.case "range_step past the end" $( test.empty! (range_step 5 0 1) ),
        test.case "update_at"           $( test.eq! [1, 20, 3] (update_at 1 (fn x -> x * 10) [1, 2, 3]) ),
        test.case "update_at out of range" $( test.eq! [[1, 2], [1, 2]] [update_at 5 (fn x -> 0) [1, 2], update_at (0 - 1) (fn x -> 0) [1, 2]] ),
        test.case "update_at on an infinite list" $( test.eq! [0, 9, 2] (take 3 (update_at 1 (fn _ -> 9) (from 0))) ),
        test.case "rotate"              $( test.eq! [[2, 3, 1], [3, 1, 2], [1, 2, 3], [2, 3, 1]]
                                                    [rotate 1 [1, 2, 3], rotate (0 - 1) [1, 2, 3],
                                                     rotate 3 [1, 2, 3], rotate 7 [1, 2, 3]] ),
        test.case "rotate of empty"     $( test.empty! (rotate 2 []) ),
        test.case "interleave"          $( test.eq! [1, :a, 2, :b, 3, 4] (interleave [1, 2, 3, 4] [:a, :b]) ),
        test.case "interleave the shorter first" $( test.eq! [1, :a, :b, :c] (interleave [1] [:a, :b, :c]) ),
        test.case "interleave infinite lists" $( test.eq! [0, 0, 1, 1] (take 4 (interleave (from 0) (from 0))) ),
        test.case "dedup"               $( test.eq! [1, 2, 1, 3] (dedup [1, 1, 2, 2, 2, 1, 3, 3]) ),
        test.case "dedup of empty"      $( test.empty! (dedup []) ),
        test.case "dedup an infinite list" $( test.eq! [:x] (take 1 (dedup (repeat :x))) ),
        test.case "chunk_by"            $( test.eq! [[1, 3], [2, 4], [5]] (chunk_by (fn n -> n % 2) [1, 3, 2, 4, 5]) ),
        test.case "chunk_by of empty"   $( test.empty! (chunk_by (fn n -> n) []) ),
        test.case "chunk_by is lazy in its runs"
            $( test.eq! [[0, 1], [2, 3]] (take 2 (chunk_by (fn n -> n / 2) (from 0))) ),
        test.case "zip3"                $( test.eq! [[1, :a, "x"], [2, :b, "y"]] (zip3 [1, 2, 3] [:a, :b] ["x", "y", "z"]) ),
        test.case "none"                $( test.eq! [true, false, true] [none (fn x -> x > 3) [1, 2], none (fn x -> x > 1) [1, 2], none (fn x -> true) []] ),
        test.case "find_map"            $( test.eq! [20, ()] [find_map (fn x -> if x > 1 { x * 10 } else { () }) [1, 2, 3],
                                                             find_map (fn x -> ()) [1, 2]] ),
        test.case "find_map stops early" $( test.eq! 3 (find_map (fn x -> if x == 3 { x } else { () }) (from 0)) ),
        test.case "is_sorted"           $( test.eq! [true, true, true, false] [is_sorted [], is_sorted [1], is_sorted [1, 1, 2], is_sorted [2, 1]] ),
        test.case "each! runs in order" $( {
            let me = self! ();
            each! (fn x -> send! me (x * 10)) [1, 2, 3]
            let a = recv! ();
            let b = recv! ();
            let c = recv! ();
            test.eq! [10, 20, 30] [a, b, c]
        } ),
        test.case "each_index! counts from zero" $( {
            let me = self! ();
            each_index! (fn i x -> send! me [i, x]) [:a, :b]
            let a = recv! ();
            let b = recv! ();
            test.eq! [[0, :a], [1, :b]] [a, b]
        } ),
        test.case "is_sorted stops at the first descent" $( test.false! (is_sorted (_list_cons 1 (_list_cons 0 (from 0)))) ),
    ];
}

// --- optional types ---------------------------------------------------------

// Of checks a finite list in full. Use types.check_each for lazy streams.
type Of element = [element];
type NonEmpty element = [element] where fn xs -> not (_list_is_empty xs);
