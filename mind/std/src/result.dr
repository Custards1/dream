// Results checked against descriptions, and the tests of the prelude's
// `Result` and `Option`.
//
// `Result` and `Option` are the prelude's (`std.prelude`): every module has
// them, and what to do with one -- `map`, `and_then`, `unwrap_or`, `flatten`,
// `all` -- is a member of it, `Result.map f r`, so none of that needs an
// import either. They are how this library reports a failure, and for one
// reason: raising is an effect. A pure function cannot raise, so a pure parser
// cannot report a failure by raising; it has to *answer* one. That is what
// makes this a value rather than an exception, and `raise!`/`try!` are kept for
// what is not an answer -- a broken invariant, a resource gone, a process
// killed.
//
// This module is the short spelling of the same things -- `result.ok x`,
// `result.err why`, `result.map f r` -- for a module that would rather import
// a name than write the union's. Each is a wrapper: one call of the member it
// names, which the compiler replaces with that call (see "wrappers" in
// `dreams/src/scope.dr`), so the two spellings compile to the same code and
// the prelude's are still the ones fusion sees. The rest is what needs
// `std.types`, which the prelude cannot import: a result's payloads checked
// against a description at run time.

import std.types;

// --- the short spellings --------------------------------------------------------

/// `Result.ok value`.
let ok : a -> Result a e;
let ok value = Result.ok value;
/// `Result.error reason`.
let err : e -> Result a e;
let err reason = Result.error reason;
/// `Result.error reason`, under the variant's own name.
let error : e -> Result a e;
let error reason = Result.error reason;

/// `Result.is_ok`.
let is_ok : Result a e -> :bool;
let is_ok r = Result.is_ok r;
/// `Result.is_error`.
let is_err : Result a e -> :bool;
let is_err r = Result.is_error r;

/// `Result.map`.
let map : (a -> b) -> Result a e -> Result b e;
let map f r = Result.map f r;
/// `Result.map_error`.
let map_err : (e -> f) -> Result a e -> Result a f;
let map_err f r = Result.map_error f r;
/// `Result.and_then`.
let and_then : (a -> Result b e) -> Result a e -> Result b e;
let and_then f r = Result.and_then f r;
/// `Result.and`.
let and : Result b e -> Result a e -> Result b e;
let and other r = Result.and other r;
/// `Result.or`.
let or : Result a f -> Result a e -> Result a f;
let or other r = Result.or other r;
/// `Result.or_else`.
let or_else : (e -> Result a f) -> Result a e -> Result a f;
let or_else f r = Result.or_else f r;
/// `Result.otherwise`.
let otherwise : Result a e -> Result a e -> Result a e;
let otherwise other r = Result.otherwise other r;
/// `Result.flatten`.
let flatten : Result (Result a e) e -> Result a e;
let flatten r = Result.flatten r;

/// `Result.unwrap_or`.
let unwrap_or : a -> Result a e -> a;
let unwrap_or default r = Result.unwrap_or default r;
/// `Result.unwrap_or_else`.
let unwrap_or_else : (e -> a) -> Result a e -> a;
let unwrap_or_else f r = Result.unwrap_or_else f r;
/// `Result.unwrap!`.
let unwrap! : Result a e -> a;
let unwrap! r = Result.unwrap! r;
/// `Result.to_option`.
let to_option : Result a e -> Option a;
let to_option r = Result.to_option r;

/// `Result.all`.
let all : [Result a e] -> Result [a] e;
let all rs = Result.all rs;
/// `Result.oks`.
let oks : [Result a e] -> [a];
let oks rs = Result.oks rs;
/// `Result.errors`.
let errors : [Result a e] -> [e];
let errors rs = Result.errors rs;

// --- checked against a description ----------------------------------------------

/// Validate both possible payload types of a result, raising on a mismatch.
let check : :any -> :any -> Result a e -> Result a e;
let check value reason outcome = types.check (Result value reason) outcome;
/// Validate a successful payload against `description`, retaining failures unchanged.
let validate_ok : :any -> Result a e -> Result a (e | :error);
let validate_ok description outcome = match outcome {
    Result.ok(value) => types.validate description value,
    other => other,
};

/// Check a value against `description`, then wrap it as a successful result.
let ok_as : :any -> a -> Result a e;
let ok_as description value = Result.ok (types.check description value);
/// Check a reason against `description`, then wrap it as an error result.
let error_as : :any -> e -> Result a e;
let error_as description reason = Result.error (types.check description reason);

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let double x = Result.ok (x * 2);
    let fail _ = Result.error :nope;
    let half n = if n % 2 == 0 { Option.some (n / 2) } else { Option.none };

    let quarter n = {
        let? h = half n;
        let? q = half h;
        Option.some q
    };
    let need n = {
        let? q = quarter n else Result.error :odd;
        let? d = double q;
        Result.ok (d + 1)
    };
    let pair n = {
        let? [a, b] = Result.ok [n, n + 1];
        Result.ok (a * b)
    };

    let tests = [
        test.case "is_ok"                   $( test.true! (Result.is_ok (Result.ok 1)) ),
        test.case "is_error"                $( test.true! (Result.is_error (Result.error :e)) ),
        test.case "tag"                     $( test.eq! [:ok, :error] [Result.tag (Result.ok 1), Result.tag (Result.error 2)] ),
        test.case "unwrap_or takes the value"   $( test.eq! 1 (Result.unwrap_or 0 (Result.ok 1)) ),
        test.case "unwrap_or takes the default" $( test.eq! 0 (Result.unwrap_or 0 (Result.error :e)) ),
        test.case "unwrap_or_else"          $( test.eq! ":e" (Result.unwrap_or_else to_string (Result.error :e)) ),
        test.case "reason"                  $( test.eq! (Option.some :e) (Result.reason (Result.error :e)) ),
        test.case "to_option"               $( test.eq! [Option.some 5, Option.none]
                                                        [Result.to_option (Result.ok 5), Result.to_option (Result.error :e)] ),

        test.case "map"                     $( test.eq! (Result.ok 2) (Result.map (fn x -> x * 2) (Result.ok 1)) ),
        test.case "map leaves an error"     $( test.eq! (Result.error :e) (Result.map (fn x -> x * 2) (Result.error :e)) ),
        test.case "map_error"               $( test.eq! (Result.error ":e") (Result.map_error to_string (Result.error :e)) ),
        test.case "and_then chains"         $( test.eq! (Result.ok 4) (Result.and_then double (double 1)) ),
        test.case "and_then stops at the first error"
            $( test.eq! (Result.error :nope) (Result.and_then double (Result.and_then fail (Result.ok 1))) ),
        test.case "or_else recovers"        $( test.eq! (Result.ok 0) (Result.or_else (fn _ -> Result.ok 0) (Result.error :e)) ),
        test.case "otherwise"               $( test.eq! (Result.ok 2) (Result.otherwise (Result.ok 2) (Result.error :e)) ),
        test.case "a chain through |>"
            $( test.eq! (Result.error ":nope")
                        (Result.ok 1 |> Result.and_then fail |> Result.map (fn x -> x + 1) |> Result.map_error to_string) ),
        test.case "flatten"                 $( test.eq! (Result.error :in) (Result.flatten (Result.ok (Result.error :in))) ),
        test.case "both"                    $( test.eq! (Result.ok [1, 2]) (Result.both (Result.ok 2) (Result.ok 1)) ),

        test.case "all, every one ok"       $( test.eq! (Result.ok [1, 2]) (Result.all [Result.ok 1, Result.ok 2]) ),
        test.case "all, the first error wins"
            $( test.eq! (Result.error :a) (Result.all [Result.ok 1, Result.error :a, Result.error :b]) ),
        test.case "all of nothing"          $( test.eq! (Result.ok []) (Result.all []) ),
        test.case "oks"                     $( test.eq! [1, 2] (Result.oks [Result.ok 1, Result.error :e, Result.ok 2]) ),
        test.case "errors"                  $( test.eq! [:e] (Result.errors [Result.ok 1, Result.error :e]) ),

        test.case "unwrap! raises the reason" $( test.raises! $( Result.unwrap! (Result.error :e) ) ),
        test.case "unwrap! answers the value" $( test.eq! 5 (Result.unwrap! (Result.ok 5)) ),

        test.case "Option.of"               $( test.eq! [Option.some 5, Option.none] [Option.of 5, Option.of ()] ),
        test.case "Option.or_unit"          $( test.eq! [5, ()] [Option.or_unit (Option.some 5), Option.or_unit Option.none] ),
        test.case "Option.map"              $( test.eq! (Option.some 6) (Option.map (fn x -> x * 2) (Option.some 3)) ),
        test.case "Option.and_then"         $( test.eq! [Option.some 2, Option.none] [Option.and_then half (Option.some 4), Option.and_then half (Option.some 3)] ),
        test.case "Option.filter"           $( test.eq! Option.none (Option.filter (fn x -> x > 5) (Option.some 3)) ),
        test.case "Option.unwrap_or"        $( test.eq! 0 (Option.unwrap_or 0 Option.none) ),
        test.case "Option.ok_or"            $( test.eq! (Result.error :missing) (Option.ok_or :missing Option.none) ),
        test.case "Option.flatten"          $( test.eq! (Option.some 1) (Option.flatten (Option.some (Option.some 1))) ),
        test.case "Option.all"              $( test.eq! Option.none (Option.all [Option.some 1, Option.none]) ),
        test.case "Option.values"           $( test.eq! [1, 3] (Option.values [Option.some 1, Option.none, Option.some 3]) ),
        test.case "Option.contains"         $( test.true! (Option.contains 3 (Option.some 3)) ),
        test.case "Option.unwrap! raises"   $( test.raises! $( Option.unwrap! Option.none ) ),

        test.case "let? chains options"     $( test.eq! [Option.some 3, Option.none] [quarter 12, quarter 6] ),
        test.case "let? .. else answers the alternative"
            $( test.eq! [Result.ok 7, Result.error :odd] [need 12, need 6] ),
        test.case "let? takes a pattern"    $( test.eq! (Result.ok 12) (pair 3) ),

        test.case "validate_ok keeps an error" $( test.eq! (Result.error :e) (validate_ok :integer (Result.error :e)) ),
        test.case "ok_as"                   $( test.eq! (Result.ok 1) (ok_as :integer 1) ),
        test.case "the short spellings"
            $( test.eq! [Result.ok 2, Result.error :e, Result.error ":e"]
                        [map (fn x -> x + 1) (ok 1), and_then double (err :e), map_err to_string (err :e)] ),
    ];
}
