// Results: `Result.ok value` and `Result.error reason`, and what to do with
// them.
//
// `Result` itself is the prelude's (`std.prelude`), so every module has it and
// `let?` can chain it without an import; this module is the rest -- the
// matches every caller would otherwise rewrite, named. It is how this library
// reports a failure, and for one reason: raising is an effect. A pure function
// cannot raise, so a pure parser cannot report a failure by raising; it has to
// *answer* one. That is what makes this a value rather than an exception, and
// `raise!`/`try!` are kept for what is not an answer -- a broken invariant, a
// resource gone, a process killed.
//
// Nothing here is clever -- the point is that `and_then` reads as "and then",
// so a pipeline of steps that can each fail is written once and reads as the
// sequence it is.

import std.list;

// --- making one ---------------------------------------------------------------

/// Wrap a successful value: `Result.ok value`.
///
/// ```dream
/// import std.result;
/// import std.console;
///
/// let main! = {
///     console.print! (result.ok "ready")
/// };
/// ```
let ok : a -> Of a e;
let ok value = Result.ok value;
/// Wrap a failure reason: `Result.error reason`.
///
/// ```dream
/// import std.result;
/// import std.console;
///
/// let main! = {
///     console.print! (result.error "not found")
/// };
/// ```
let error : e -> Of a e;
let error reason = Result.error reason;

/// Test whether a result is an ok.
let is_ok : Of a e -> :bool;
let is_ok r = match r { Result.ok(_) => true, Result.error(_) => false };
/// Test whether a result is an error.
let is_error : Of a e -> :bool;
let is_error r = match r { Result.error(_) => true, Result.ok(_) => false };

/// The value, or `default` for an error. The usual way out of a result.
let or_else : a -> Of a e -> a;
let or_else default r = match r { Result.ok(v) => v, Result.error(_) => default };

/// The reason, or `default` when there is none.
let reason : e -> Of a e -> e;
let reason default r = match r { Result.error(why) => why, Result.ok(_) => default };

/// The value, raising the reason if there is not one. Impure by name, because
/// raising is an effect -- which is the whole reason this module exists.
let unwrap! : Of a e -> a;
let unwrap! r = match r { Result.ok(v) => v, Result.error(why) => raise! why };

// --- carrying on ----------------------------------------------------------------

/// Change the value, leave an error alone.
///
/// ```dream
/// import std.result;
/// import std.console;
///
/// let main! = {
///     console.print! (result.map (fn x -> x + 1) (result.ok 41))
/// };
/// ```
let map : (a -> b) -> Of a e -> Of b e;
let map f r = match r { Result.ok(v) => Result.ok (f v), Result.error(why) => Result.error why };

/// Change the reason, leave a value alone. What to use when a failure needs to
/// be reported in the caller's terms rather than the callee's.
let map_error : (e -> f) -> Of a e -> Of a f;
let map_error f r = match r { Result.error(why) => Result.error (f why), Result.ok(v) => Result.ok v };

/// The next step, which may itself fail. This is the one that makes a pipeline:
///
///     read path |> and_then parse |> and_then validate
let and_then : (a -> Of b e) -> Of a e -> Of b e;
let and_then f r = match r { Result.ok(v) => f v, Result.error(why) => Result.error why };

/// The first result if it is ok, otherwise the second. `r` is not forced when
/// it does not have to be, so the fallback can be expensive.
let or_try : Of a e -> Of a e -> Of a e;
let or_try other r = if is_ok r { r } else { other };

// --- several at once ------------------------------------------------------------

/// `Result.ok values` when every one is ok, or the first error.
///
/// Stops at the first failure, which for a lazy list means the ones after it
/// are never computed -- validating a thousand things costs one when the first
/// is wrong.
let all : [Of a e] -> Of [a] e;
let rec all rs =
    if list.is_empty rs { Result.ok [] }
    else {
        match list.head rs {
            Result.error(why) => Result.error why,
            Result.ok(v) => match all (list.tail rs) {
                Result.error(why) => Result.error why,
                Result.ok(vs) => Result.ok (list.cons v vs),
            },
        }
    };

/// The values of every ok, dropping the errors. For when a failure is worth
/// skipping rather than stopping for.
let oks : [Of a e] -> [a];
let oks rs = list.concat (list.map (fn r -> match r { Result.ok(v) => [v], Result.error(_) => [] }) rs);

/// The reasons of every error.
let errors : [Of a e] -> [e];
let errors rs = list.concat (list.map (fn r -> match r { Result.error(why) => [why], Result.ok(_) => [] }) rs);

/// `Result.ok v` when `v` is not `()`, and `Result.error reason` when it is.
/// The bridge from the other convention this library uses -- a lookup that
/// answers `()` for "nothing there".
let of_option : e -> a -> Of a e;
let of_option reason v = match v { () => Result.error reason, found => Result.ok found };

/// And back: the value, or `()`.
let to_option : Of a e -> a;
let to_option r = match r { Result.ok(v) => v, Result.error(_) => () };

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let double x = ok (x * 2);
    let fail _ = error :nope;

    let tests = [
        test.case "ok"                  $( test.true! (is_ok (ok 1)) ),
        test.case "error"               $( test.true! (is_error (error :e)) ),
        test.case "or_else takes the value"   $( test.eq! 1 (or_else 0 (ok 1)) ),
        test.case "or_else takes the default" $( test.eq! 0 (or_else 0 (error :e)) ),
        test.case "reason"              $( test.eq! :e (reason () (error :e)) ),

        test.case "map"                 $( test.eq! (ok 2) (map (fn x -> x * 2) (ok 1)) ),
        test.case "map leaves an error" $( test.eq! (error :e) (map (fn x -> x * 2) (error :e)) ),
        test.case "map_error"           $( test.eq! (error ":e") (map_error to_string (error :e)) ),
        test.case "and_then chains"     $( test.eq! (ok 4) (and_then double (double 1)) ),
        test.case "and_then stops at the first error"
            $( test.eq! (error :nope) (and_then double (and_then fail (ok 1))) ),
        test.case "or_try"              $( test.eq! (ok 2) (or_try (ok 2) (error :e)) ),

        test.case "all, every one ok"   $( test.eq! (ok [1, 2]) (all [ok 1, ok 2]) ),
        test.case "all, the first error wins"
            $( test.eq! (error :a) (all [ok 1, error :a, error :b]) ),
        test.case "all of nothing"      $( test.eq! (ok []) (all []) ),
        test.case "oks"                 $( test.eq! [1, 2] (oks [ok 1, error :e, ok 2]) ),
        test.case "errors"              $( test.eq! [:e] (errors [ok 1, error :e]) ),

        test.case "of_option, present"  $( test.eq! (ok 5) (of_option :missing 5) ),
        test.case "of_option, absent"   $( test.eq! (error :missing) (of_option :missing ()) ),
        test.case "to_option"           $( test.eq! 5 (to_option (ok 5)) ),
        test.case "to_option of an error" $( test.eq! () (to_option (error :e)) ),

        test.case "unwrap! raises the reason" $( test.raises! $( unwrap! (error :e) ) ),
        test.case "unwrap! answers the value" $( test.eq! 5 (unwrap! (ok 5)) ),
    ];
}

// --- optional types ---------------------------------------------------------

import std.types;
/// A result: the prelude's `Result`, under the name this module has always
/// given it.
type Of value reason = Result value reason;
/// Validate both possible payload types of a result, raising on a mismatch.
let check : :any -> :any -> Of a e -> Of a e;
let check value reason outcome = types.check (Of value reason) outcome;
/// Validate a successful payload against `description`, retaining failures unchanged.
let validate_ok : :any -> Of a e -> Of a (e | :error);
let validate_ok description outcome = match outcome {
    Result.ok(value) => types.validate description value,
    other => other,
};

/// Check a value against `description`, then wrap it as a successful result.
let ok_as : :any -> a -> Of a e;
let ok_as description value = ok (types.check description value);
/// Check a reason against `description`, then wrap it as an error result.
let error_as : :any -> e -> Of a e;
let error_as description reason = error (types.check description reason);
