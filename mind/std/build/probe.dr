// std.build.probe: asking the machine, as steps whose answer is data.
//
//     let plan ctx =
//         build.given (probe.library ctx "sqlite3") (fn found -> match found {
//             "yes" => build.empty |> build.define "system_sqlite",
//             _ => build.empty |> build.payload "sqlite" (vendored ctx),
//         });
//
// A probe is a step like any other, so its answer is cached by its key and
// asked again only when something it depends on moves. What it answers is a
// small file, read by `build.given`, and a probe never fails: "not here" is
// an answer, and the plan decides what it means.
//
// A probe's key is its question and the target, not the state of the machine,
// so an answer is kept until the question changes. That is the trade every
// configure step makes; `mind clean` asks again. `llvm` is the exception: an
// answer that is a library's whole configuration is asked every build, since
// installing another LLVM changes no file of the project's, and a build made
// against the one that is gone does not link.

import std.build;
import std.build.cc;
import std.build.cc.steps;
import std.list;
import std.str;
import std.wire;

/// Where `program` is on `PATH`, or `""`.
let program : :map -> :string -> :any;
let program ctx p =
    build.artifact (build.step "probe" ("program " + p) [] [build.Context.target ctx, p] ["answer"]
                               (fn job -> [build.Op.find p "answer"]))
                   "answer";

/// What `pkg-config` says -- `what` is `--cflags`, `--libs` or
/// `--modversion` -- or `""` when it has nothing to say or is not installed.
let pkg_config : :map -> :string -> :string -> :any;
let pkg_config ctx what package =
    build.artifact (build.step "probe" ("pkg-config " + what + " " + package) []
                               [build.Context.target ctx, what, package] ["answer"]
                               (fn job -> [build.Op.capture "pkg-config" [what, package] "answer"]))
                   "answer";

/// `"yes"` when a C program linking against `-l<name>` builds, `"no"`
/// otherwise: the question a configure script asks of a library, asked of the
/// same compiler `std.build.cc` would use.
let library : :map -> :string -> :any;
let library ctx name = {
    let compiler = list.head (steps.compilers ctx);
    build.artifact (build.step "probe" ("library " + name) [] [build.Context.target ctx, compiler, name] ["answer"]
                               (fn job -> [build.Op.write "probe.c" "int main(void) { return 0; }\n",
                                           build.Op.attempt compiler ["-o", "probe", "probe.c", "-l" + name] "answer"]))
                   "answer"
};

/// What a probe answered as a value rather than text, for one whose answer is
/// a record (`llvm`); `()` for no answer.
let answer : :string -> :any;
let answer text = match wire.decode text { [:ok, v] => v, _ => () };

/// `llvm-config`'s answers, as one record.
let llvm_answer : [:string] -> :string;
let llvm_answer said = match list.map str.trim said {
    ["", .._] => wire.encode (),
    [includes, version, libdir, libs, system, rtti] if not (str.is_empty libs) => wire.encode (%{
        :version => version,
        :includes => includes,
        :libdir => libdir,
        :libraries => list.filter (fn w -> not (str.is_empty w)) (list.append (str.split " " libs) (str.split " " system)),
        :rtti => rtti == "YES",
    }),
    _ => wire.encode (),
};

/// LLVM discovery with an explicit linkage request. `--libfiles` preserves
/// archive paths, including on installations outside the compiler's search path.
/// Keep `llvm`'s shared-library behavior for existing callers.
let llvm_link : :string -> :string -> [:string] -> :any;
let llvm_link program linkage components = {
    let asks = [["--includedir"], ["--version"], ["--libdir"],
                list.concat [[linkage, "--libfiles"], components], [linkage, "--system-libs"], ["--has-rtti"]];
    let names = list.map (fn i -> "said" + to_string i) (list.range 0 (list.length asks));
    build.artifact (build.uncached (build.step "probe" "llvm" [] [:llvm, program, linkage, components] ["answer"] (fn job ->
        list.concat [list.map (fn [n, args] -> build.Op.capture program args n) (list.zip names asks),
                     [build.Op.attempt program [linkage, "--system-libs"] "system_ok",
                      build.Op.transform (list.append names ["system_ok"]) "answer" (fn said ->
                        if list.last said != "yes" { wire.encode () } else { llvm_answer (list.take 6 said) })]])))
                   "answer"
};

let llvm : [:string] -> :any;
let llvm components = llvm_link "llvm-config" "--link-shared" components;

/// Prove a dependency can participate in a shared-library link with the
/// selected compiler. References in `source` force archive members to be
/// extracted; linking an empty program would not test PIC or the ABI.
let shared_link : cc.Toolchain -> :string -> [:string] -> [:string] -> :any;
let shared_link tc source cflags libs = {
    let windows = cc.Toolchain.os tc == :windows;
    let args = match cc.Toolchain.family tc {
        :msvc => list.concat [["/nologo", "/LD", "probe.cpp"], cflags, ["/link"], libs, ["/OUT:probe.dll"]],
        _ => list.concat [(if windows { [] } else { ["-fPIC"] }), cflags,
                           ["probe.cpp", (if cc.Toolchain.os tc == :macos { "-dynamiclib" } else { "-shared" })],
                           (if cc.Toolchain.os tc == :linux { ["-Wl,-z,defs"] } else { [] }),
                           libs, ["-o", "probe.so"]],
    };
    build.artifact (build.uncached (build.step "probe" "shared dependency" [] [tc, source, cflags, libs] ["answer"]
        (fn job -> [build.Op.write "probe.cpp" source,
                    build.Op.attempt (cc.Toolchain.cxx tc) args "answer"]))) "answer"
};

when test {
    import std.test;

    let here = build.Target.make :linux :x86_64;
    let ctx = build.Context.new "p" "1" "/p" here here;
    let step_of a = list.nth 1 a;

    let tests = [
        test.case "a probe asks one question and never fails"
            $( test.eq! [[:find, "git", "answer"]]
                        (build.Step.action (step_of (program ctx "git")) (build.Job.make "/d" ctx (%{}))) ),
        test.case "llvm's answers are one record, or none"
            $( test.eq! [(), %{ :version => "21.1.8", :includes => "/i", :libdir => "/l",
                                :libraries => ["-lLLVM-21", "-lz"], :rtti => false }]
                        [answer (llvm_answer ["", "", "", "", "", ""]),
                         answer (llvm_answer ["/i\n", "21.1.8", "/l", "-lLLVM-21", "-lz", "NO"])] ),
        test.case "LLVM headers without linkable libraries are not an LLVM answer"
            $( test.eq! () (answer (llvm_answer ["/i", "21.1.8", "/l", "", "-lz", "YES"])) ),
        test.case "static and shared LLVM questions have different keys"
            $( test.ne! (build.Step.shape (step_of (llvm_link "llvm-config" "--link-static" ["core"])))
                        (build.Step.shape (step_of (llvm_link "llvm-config" "--link-shared" ["core"]))) ),
        test.case "two questions are two steps"
            $( test.ne! (build.Step.shape (step_of (library ctx "z"))) (build.Step.shape (step_of (library ctx "m"))) ),
    ];
}
