// Builds: steps that make files, run only when what they were made from has
// changed.
//
// A step is a value: a tool's name, a configuration, the inputs it reads and
// the outputs it will write, and an action that writes them. Its **identity**
// is a digest of all of that but the inputs' contents, and its **key** adds
// the contents: the digest of every file it reads and the key of every step it
// reads from. A step runs in a scratch directory that is renamed to one named
// by its key, so a step whose key has a directory has already been made, and
// two steps cannot collide. docs/build.md is the design; this is its core,
// "Inputs and artifacts" through "Running a plan".
//
// What makes a build that has nothing to do cheap is the **stamp**: a file's
// size and modified time, kept beside its digest, so that a file is read only
// when its stamp has moved. A build that changed nothing costs a `stat!` per
// file, and runs nothing.
//
// Some steps cannot say what they read until they have: a C file's headers,
// a Dream program's modules. Such a step `discovers` its inputs, writing a
// make rule to `deps.d` in its directory (`gcc -MD` writes exactly that,
// and `dreams --depfile` does too). The runner keeps what was read, with each
// file's digest, and a step whose key matches is still run again if one of
// those files has changed.
//
// Independent steps run at once, up to the context's job count, each action
// in a process of its own. A step that fails raises `[:step_failed, name,
// log]`, after what was running has finished. Plans, goals and checks are
// what comes next.

import std.console;
import std.error;
import std.io;
import std.list;
import std.map;
import std.os;
import std.str;
import std.wire;

// --- where a build runs ----------------------------------------------------------

mapping Platform {
    os : :atom          // :linux | :macos | :windows
    arch = :x86_64      // :x86_64 | :aarch64
}

/// What a build is told about the world: the package it builds, where, for
/// what, and nothing else. `root` and `out` are absolute.
mapping Context {
    root : :string          // the package's directory; inputs are relative to it
    out : :string           // where steps are made: <root>/target/build
    target : :any           // Platform, where the result will run
    host : :any             // Platform, where this build is running
    profile = "debug"
    options = %{}
    env = %{}
    jobs = 1
}

/// A context for building the package in `root` on this machine, for this
/// machine.
let context! : :string -> Context;
let context! root = {
    let here = os.cwd! ();
    let absolute = if str.starts_with "/" root || (str.byte_length root > 1 && str.slice 1 1 root == ":") { root }
                   else if root == "." { here } else { here + "/" + root };
    let me = Platform.make (os.platform ()) :x86_64;
    Context.make absolute (absolute + "/target/build") me me "debug" %{} %{} 1
};

let root ctx = Context.root ctx;
let profile ctx = Context.profile ctx;
let option ctx name = (Context.options ctx).[name else ()];
let with_option name value ctx = Context.set_options ctx ((Context.options ctx).[name => value]);
let target_os ctx = Platform.os (Context.target ctx);

// --- inputs ----------------------------------------------------------------------

/// What a step reads. A file is relative to the package's root. A tree is every
/// file under a directory whose name ends with `suffix` (`""` for every one).
/// An artifact is a file a step makes, and holds the step, so the graph is
/// whatever is reachable from what was asked for.
union Input {
    file(path : :string)
    tree(dir : :string, suffix : :string)
    artifact(step : :any, name : :string)
}

let file p = Input.file p;
let tree dir suffix = Input.tree dir suffix;

// --- steps ------------------------------------------------------------------------

mapping Step {
    tool : :string
    name : :string              // for people and logs; not part of the key
    inputs = []                 // [Input]
    config = ()                 // data: everything else that changes the output
    outputs = []                // [:string], files it makes in its own directory
    action = ()                 // [f, data]: see "jobs" below
    discovers = false           // it writes `deps.d`: the files it read
    cache = :shared             // :shared | :never
    version = "1"               // change it to make every earlier step stale
    id = ""                     // its identity: see `step`
}

/// What an input is, for an identity: a file by its path, an artifact by its
/// step's identity. Never by contents, which is what a key adds.
let describe input = match input {
    [:artifact, s, n] => [:artifact, Step.id s, n],
    other => other,
};

/// A step. Its identity is worked out once, when it is first asked for, and
/// kept in the step: an artifact asks for the identity of the step it holds,
/// and a graph where many steps read one would otherwise work it out again for
/// every reader.
let step : :string -> :string -> [Input] -> :any -> [:string] -> :any -> Step;
let step tool name inputs config outputs action = {
    let s = Step.make tool name inputs config outputs action false :shared "1" "";
    Step.set_id s (io.digest (wire.encode [tool, Step.version s, config, outputs,
                                           list.map describe inputs]))
};

let discovering s = Step.set_discovers s true;
let uncached s = Step.set_cache s :never;

/// One of a step's outputs, as an input to another.
let artifact s n = Input.artifact s n;
/// A step's first output: what most callers want.
let output s = Input.artifact s (list.head (Step.outputs s));

// --- jobs --------------------------------------------------------------------------
//
// What an action is handed: where to write, the context, and every input
// already made and resolved to a path.
//
// An action is **data**: `[f, data]`, where `f` is a top-level function and
// `f job data` answers a thunk, `$( exec! job [..] )`, which the runner runs
// in a process of its own. Three things decide that shape.
//
// - There is no impure lambda, and a pure function may not name an impure
//   one, but it may suspend a call to one. So describing a step stays pure,
//   and a whole plan is a pure function of its context; the effect happens
//   when the runner says.
// - An action is copied into the process it runs in, and a closure carries
//   its frame, lazy arguments and all. A closure made where a step's inputs
//   were in scope would carry them, and an input holds its step, which holds
//   its action -- the whole graph upstream, copied once for every way of
//   reaching each part of it. The first real build ran out of memory that
//   way. A top-level `f` captures nothing, and the runner forces `data` all
//   the way down before it is copied, so what crosses is exactly the data.
// - For the same reason `data` names inputs by their slot (`slotted`,
//   `path_of`), never by the inputs themselves.
//
// A process of its own also means an action that raises is reported as the
// step failing rather than taking the build with it.

mapping Job {
    dir : :string
    ctx : :any
    paths = %{}
}

/// The name an input is filed under in a job's `paths`. A string rather than
/// the input itself, because a map compares a compound key by identity, and
/// a job is copied into the process its action runs in: the copy's inputs
/// are not the map's.
let slot : Input -> :string;
let slot input = match input {
    [:file, p] => "file:" + p,
    [:tree, d, suffix] => "tree:" + d + ":" + suffix,
    [:artifact, s, n] => "artifact:" + Step.id s + ":" + n,
};

/// Where an input is on disk, absolute.
let path : Job -> Input -> :string;
let path job input = (Job.paths job).[slot input else ""];
/// The same, by the input's slot, for an action that holds only slots.
let path_of : Job -> :string -> :string;
let path_of job k = (Job.paths job).[k else ""];
/// Where an output of this step goes.
let out : Job -> :string -> :string;
let out job name = Job.dir job + "/" + name;
/// Where a discovering step writes what it read.
let depfile : Job -> :string;
let depfile job = out job "deps.d";

/// Run one command from the package's root. `[:ok, output]` or
/// `[:error, output]`, the output being the command line and all it printed.
let exec! : Job -> [:string] -> [:atom, :string];
let exec! job argv = {
    let said = str.join_str " " argv + "\n";
    match try! { os.run! (list.head argv) (list.tail argv)
                         %{ :cwd => Context.root (Job.ctx job), :timeout => 3600000 } } catch e { e } {
        r if type_of r == :map => {
            let text = said + r.[:out] + r.[:err];
            if r.[:code] == 0 { [:ok, text] }
            else if r.[:timed_out] { [:error, text + "(timed out)\n"] }
            else { [:error, text + "(exit " + to_string r.[:code] + ")\n"] }
        },
        e => [:error, said + to_string e + "\n"],
    }
};

/// Commands in order, stopping at the first that fails. The log is all of
/// their output.
let exec_all! : Job -> [[:string]] -> [:atom, :string];
let exec_all! job commands =
    list.fold (fn [status, log] argv -> match status {
        :ok => { let [s, text] = exec! job argv; strict! s; [s, log + text] },
        _ => [status, log],
    }) [:ok, ""] commands;

// --- files -------------------------------------------------------------------------

let read_file! path = match try! { io.open! path :read } catch e { () } {
    () => (),
    h => {
        let rec more! acc = { let chunk = io.read! h 65536; if str.byte_length chunk == 0 { acc } else { more! (acc + chunk) } };
        let text = more! "";
        io.close! h
        text
    },
};

let write_file! path text = {
    let h = io.open! path :write;
    io.write! h text
    io.close! h
};

/// A make rule's prerequisites, as `gcc -MD` and `dreams --depfile` write it:
/// a target, a colon, and names separated by spaces, a line continued by a
/// backslash at its end, a space inside a name escaped by one before it.
let depfile_reads : :string -> [:string];
let depfile_reads text = {
    let joined = str_concat (str.split "\\\n" (str_concat (str.split "\r" text)));
    let body = match str.find ": " joined {
        i if i >= 0 => str.slice (i + 2) (str.byte_length joined - i - 2) joined,
        _ => "",
    };
    let [names, current, escaped] = list.fold (fn [acc, cur, esc] c ->
        if esc { [acc, list.cons c cur, false] }
        else {
            match c {
                '\\' => [acc, cur, true],
                ' ' => [(if list.is_empty cur { acc } else { list.cons (str_of_chars (list.reverse cur)) acc }), [], false],
                '\n' => [(if list.is_empty cur { acc } else { list.cons (str_of_chars (list.reverse cur)) acc }), [], false],
                '\t' => [(if list.is_empty cur { acc } else { list.cons (str_of_chars (list.reverse cur)) acc }), [], false],
                _ => [acc, list.cons c cur, false],
            }
        }) [[], [], false] (str.chars body);
    let all = if list.is_empty current { names } else { list.cons (str_of_chars (list.reverse current)) names };
    list.map (fn n -> str.join_str "$" (str.split "$$" n)) (list.reverse all)
};

// --- the runner ---------------------------------------------------------------------

/// What the runner carries from step to step. `stamps` is path => `[size,
/// modified, digest]`; `done` is identity => `[result, dir]` for the steps
/// this build has settled.
mapping State {
    stamps = %{}
    done = %{}
    ran = []            // the names of the steps that ran, latest first
    reused = 0
}

let stamps_path ctx = Context.out ctx + "/stamps";

/// The runner's state, with the stamps an earlier build left.
let start! : Context -> State;
let start! ctx = {
    io.mkdir_all! (Context.out ctx + "/steps")
    io.mkdir_all! (Context.out ctx + "/scratch")
    let stamps = match read_file! (stamps_path ctx) {
        () => %{},
        bytes => match wire.decode bytes { [:ok, m] => m, _ => %{} },
    };
    State.make stamps %{} [] 0
};

/// Keep the stamps for the next build. Written beside and renamed over, so a
/// build stopped halfway through leaves the last whole table.
let finish! : Context -> State -> State;
let finish! ctx state = {
    let temp = stamps_path ctx + "." + to_string (os.pid! ());
    write_file! temp (wire.encode (State.stamps state))
    io.rename! temp (stamps_path ctx)
    state
};

/// A file's digest, read only when its stamp has moved. `()` for a file that
/// is not there.
let digest_of! : State -> :string -> [State, :any];
let digest_of! state p = match io.stat! p {
    () => [state, ()],
    st => {
        let stamp = [st.[:size], st.[:modified]];
        match (State.stamps state).[p else ()] {
            [size, modified, d] if [size, modified] == stamp => [state, d],
            _ => {
                let d = io.digest! p;
                [State.set_stamps state ((State.stamps state).[p => [st.[:size], st.[:modified], d]]), d]
            },
        }
    },
};

/// Every file a tree input names, sorted, relative to the root.
let tree_files! ctx dir suffix =
    list.map (fn f -> dir + "/" + f)
             (list.filter (fn f -> str.ends_with suffix f)
                          (try! { io.walk! (Context.root ctx + "/" + dir) } catch e { [] }));

let absolute ctx p = if str.starts_with "/" p || (str.byte_length p > 1 && str.slice 1 1 p == ":") { p }
                     else { Context.root ctx + "/" + p };

/// Do the files a step read last time still have the digests they had?
let reads_hold! state reads =
    list.fold (fn [st, ok] [p, d] -> if not ok { [st, false] } else {
        let [st2, now] = digest_of! st p;
        [st2, now == d]
    }) [state, true] reads;

let record_of! dir = match read_file! (dir + "/.record") {
    () => (),
    bytes => match wire.decode bytes { [:ok, r] => r, _ => () },
};

/// What a step that reads this one is keyed on: its key and what it read.
/// The key alone would not do for a step that discovers its inputs, since
/// the key comes from the inputs it declared: a header changed would
/// recompile an object and leave the program linked from it stale.
let result_of key reads = if list.is_empty reads { key } else { io.digest (wire.encode [key, reads]) };

// --- the graph -------------------------------------------------------------------------

/// Every step reachable from `inputs`, by identity, and the identities each
/// one reads from: `[steps, deps]`.
let collect : [Input] -> [:any, :any];
let collect inputs = {
    let rec visit acc input = match input {
        [:artifact, s, _] => {
            let [steps, deps] = acc;
            if steps.[Step.id s else ()] != () { acc }
            else {
                let mine = list.flat_map (fn i -> match i { [:artifact, d, _] => [Step.id d], _ => [] }) (Step.inputs s);
                list.fold visit [steps.[Step.id s => s], deps.[Step.id s => list.unique mine]] (Step.inputs s)
            }
        },
        _ => acc,
    };
    list.fold visit [%{}, %{}] inputs
};

// --- one step, in three parts ----------------------------------------------------------
//
// The runner keeps every piece of bookkeeping -- stamps, keys, records -- in
// the one process that owns the state, and hands out only the part that
// takes time: running an action. So `prepare!` and `commit!` run in the
// runner, and `perform!` in a process of its own.

/// A step whose inputs are all made: its key, its directory, its inputs'
/// paths, and whether that directory already holds it.
let prepare! ctx state s = {
    let [after_inputs, contributions, paths] = list.fold (fn [st, cs, ps] input -> match input {
        [:file, p] => {
            let [st2, d] = digest_of! st (absolute ctx p);
            [st2, list.cons [p, d] cs, ps.[slot input => absolute ctx p]]
        },
        [:tree, dir, suffix] => {
            let [st2, ds] = list.fold (fn [stx, acc] f -> {
                let [sty, d] = digest_of! stx (absolute ctx f);
                [sty, list.cons [f, d] acc]
            }) [st, []] (tree_files! ctx dir suffix);
            [st2, list.cons ds cs, ps.[slot input => absolute ctx dir]]
        },
        [:artifact, dep, n] => {
            let [result, dir] = (State.done st).[Step.id dep];
            [st, list.cons result cs, ps.[slot input => dir + "/" + n]]
        },
    }) [state, [], %{}] (Step.inputs s);
    let key = io.digest (wire.encode [Step.id s, list.reverse contributions]);
    let dir = Context.out ctx + "/steps/" + key;
    let [checked, current] = match [Step.cache s, record_of! dir] {
        [:never, _] => [after_inputs, false],
        [_, ()] => [after_inputs, false],
        [_, r] => reads_hold! after_inputs (r.[:reads else []]),
    };
    [checked, key, dir, paths, current]
};

/// A step's action, run in a process of its own. A raise inside it is the
/// step failing, with the error as its log.
let act! [f, data] job = {
    let answer = try! { join! (spawn! (f job data)) } catch e { [:error, to_string e + "\n"] };
    strict! answer
    answer
};

/// Run a step's action in its scratch directory and check that it made what
/// it said it would. `[:ok, log]` or `[:error, log]`.
let perform! ctx action outputs paths scratch = {
    io.remove_all! scratch
    io.mkdir_all! scratch
    let [status, log] = act! action (Job.make scratch ctx paths);
    strict! status
    write_file! (scratch + "/log") log
    let missing = list.filter (fn o -> io.stat! (scratch + "/" + o) == ()) outputs;
    match [status, missing] {
        [:ok, []] => [:ok, log],
        [:ok, _] => [:error, log + "did not make: " + str.join_str ", " missing + "\n"],
        _ => [:error, log],
    }
};

/// What a worker is handed: a thunk that performs one step and tells the
/// runner how it went. Made here, in a function of its own, because a thunk
/// carries its frame into the process it is spawned as, and the runner's
/// frame holds the whole state. It is handed the step's action and outputs,
/// not the step, since a step holds its inputs and an artifact holds the step
/// that makes it: the step would bring the graph upstream of it along.
let task parent id ctx action outputs paths scratch =
    $( send! parent [:build_step, id,
                     try! { perform! ctx action outputs paths scratch } catch e { [:error, to_string e + "\n"] }] );

/// A performed step, put in place: what it read recorded, its scratch
/// directory renamed to the one its key names.
let commit! ctx state s key dir scratch = {
    let read = if Step.discovers s {
        match read_file! (scratch + "/deps.d") { () => [], text => depfile_reads text }
    } else { [] };
    let [after, reads] = list.fold (fn [st, acc] p -> {
        let full = absolute ctx p;
        let [st2, d] = digest_of! st full;
        [st2, list.cons [full, d] acc]
    }) [state, []] read;
    let kept = list.reverse reads;
    write_file! (scratch + "/.record") (wire.encode %{ :key => key, :reads => kept })
    io.remove_all! dir
    try! { io.rename! scratch dir } catch e {
        raise! [:step_failed, Step.name s, "could not put it in place: " + to_string e + "\nsteps: "
                                           + to_string (io.stat! (parent_of dir)) + "\n"]
    }
    let ran = State.set_ran after (list.cons (Step.name s) (State.ran after));
    State.set_done ran ((State.done ran).[Step.id s => [result_of key kept, dir]])
};

// --- the schedule --------------------------------------------------------------------------

/// The runner between one event and the next: the state, the steps not yet
/// started, the steps running (identity => `[key, dir, scratch]`), and the
/// steps that failed (identity => `[name, log]`). A build that is not told to
/// keep going starts nothing after its first failure; one that is starts
/// everything that does not depend on one, which is what a run of checks
/// wants.
mapping Run {
    state : :any
    steps : :any            // identity => Step
    deps : :any             // identity => [identity]
    waiting : :any          // [identity]
    running = %{}
    failures = %{}
    keep_going = false
}

let ready run id = list.all (fn d -> (State.done (Run.state run)).[d else ()] != ()) ((Run.deps run).[id else []]);

let stopped run = not (Run.keep_going run) && not (list.is_empty (map.keys (Run.failures run)));

/// Start what can be started: every step whose inputs are made, up to the
/// job count. A step found already made is settled here and starts nothing.
let rec launch! ctx run = {
    let capacity = Context.jobs ctx - list.length (map.keys (Run.running run));
    let candidates = if stopped run { [] } else { list.filter (fn id -> ready run id) (Run.waiting run) };
    match candidates {
        [] => run,
        [id, .._] if capacity <= 0 => run,
        [id, .._] => {
            let s = (Run.steps run).[id];
            let rest = list.filter (fn w -> w != id) (Run.waiting run);
            let [state, key, dir, paths, current] = prepare! ctx (Run.state run) s;
            if current {
                let r = record_of! dir;
                let reused = State.set_reused state (State.reused state + 1);
                let settled = State.set_done reused ((State.done reused).[id => [result_of key (r.[:reads else []]), dir]]);
                launch! ctx (Run.set_waiting (Run.set_state run settled) rest)
            } else {
                let scratch = Context.out ctx + "/scratch/" + key + "." + to_string (os.pid! ());
                // Forced here: an argument is lazy, and `self! ()` asked inside
                // the worker would be the worker, which would then report to
                // itself.
                let me = self! ();
                strict! me
                // All of it forced before it crosses: see "jobs".
                let action = Step.action s;
                strict! action
                let outputs = Step.outputs s;
                strict! outputs
                strict! paths
                spawn! (task me id ctx action outputs paths scratch)
                launch! ctx (Run.set_running (Run.set_waiting (Run.set_state run state) rest)
                                             ((Run.running run).[id => [key, dir, scratch]]))
            }
        },
    }
};

/// Run the graph to the end: start what can start, take whichever step
/// finishes next, and go again. What is left waiting at the end depends on a
/// step that failed, or, with no failure to blame, is a cycle.
let rec drive! ctx run = {
    let started = launch! ctx run;
    if list.is_empty (map.keys (Run.running started)) {
        if list.is_empty (Run.waiting started) || not (list.is_empty (map.keys (Run.failures started))) { started }
        else {
            raise! [:step_failed, "the build", "these steps wait on each other: "
                                               + str.join_str ", " (list.map (fn id -> Step.name ((Run.steps started).[id]))
                                                                             (Run.waiting started)) + "\n"]
        }
    } else {
        let [tag, id, outcome] = recv! ();
        strict! outcome
        let [key, dir, scratch] = (Run.running started).[id];
        let running = Run.set_running started (map_remove (Run.running started) id);
        let s = (Run.steps started).[id];
        match outcome {
            [:ok, _] => {
                // Put in place now, not whenever the state is next read.
                let committed = commit! ctx (Run.state running) s key dir scratch;
                strict! committed
                drive! ctx (Run.set_state running committed)
            },
            [_, log] => {
                io.remove_all! scratch
                drive! ctx (Run.set_failures running ((Run.failures running).[id => [Step.name s, log]]))
            },
        }
    }
};

/// Where an input is, once built, or `()` when its step did not finish.
let located ctx state input = match input {
    [:artifact, s, n] => match (State.done state).[Step.id s else ()] {
        () => (),
        [_, dir] => if n == "" { dir } else { dir + "/" + n },
    },
    [:file, p] => absolute ctx p,
    [:tree, d, _] => absolute ctx d,
};

/// Make every input it can, going on past a step that fails: `[state,
/// [path | ()], failures]`, `failures` being identity => `[name, log]`. A
/// path is `()` for an input whose step failed or waited on one that did.
let build_all! : Context -> [Input] -> [State, [:any], :any];
let build_all! ctx inputs = {
    let [steps, deps] = collect inputs;
    // Forced here, as a statement: an argument is lazy, and a `start!` left to
    // be forced when something first reads the state had not made the steps'
    // directory by the time the first step with no inputs finished.
    let started = start! ctx;
    strict! started
    let finished = drive! ctx (Run.make started steps deps (map.keys steps) %{} %{} true);
    let state = finish! ctx (Run.state finished);
    [state, list.map (fn i -> located ctx state i) inputs, Run.failures finished]
};

/// Make several inputs in one build, from the stamps the last one left, and
/// keep the stamps for the next: `[state, [path]]`. Up to `ctx.jobs` steps run
/// at once. The first step that fails stops anything new from starting, and
/// is raised as `[:step_failed, name, log]` once what was running is done.
let build! : Context -> [Input] -> [State, [:string]];
let build! ctx inputs = {
    let [steps, deps] = collect inputs;
    let started = start! ctx;
    strict! started
    let finished = drive! ctx (Run.make started steps deps (map.keys steps) %{} %{} false);
    let state = finish! ctx (Run.state finished);
    match map_pairs (Run.failures finished) {
        [] => [state, list.map (fn i -> located ctx state i) inputs],
        [[_, [name, log]], .._] => raise! [:step_failed, name, log],
    }
};

// --- tools every build needs -----------------------------------------------------------

/// A file whose contents are `text`. Keyed on the text, so it is rewritten only
/// when the text changes: generating a module is ordinary Dream code.
let write : :string -> :string -> Step;
let write name text =
    step "write" name [] text [name] [write_run, [name, text]];

let write_run job [name, text] = $( { write_file! (out job name) text; [:ok, ""] } );

/// Any program, whose arguments are strings, inputs (`Input.file`,
/// `artifact`, ...) and outputs (`[:out, "name"]`). The step's inputs, outputs
/// and key all come from the one list the program is run with.
let command : :string -> [:any] -> Step;
let command name argv = {
    let inputs = list.filter (fn a -> type_of a != :string && list.head a != :out) argv;
    let outputs = list.flat_map (fn a -> match a { [:out, n] => [n], _ => [] }) argv;
    let described = list.map (fn a -> if type_of a == :string { a } else { describe a }) argv;
    step "command" name inputs described outputs [command_run, slotted argv]
};

/// Arguments with every input replaced by its slot: `[:in, slot]`. What an
/// action holds has to be this and not the inputs, because an action is
/// copied into the process it runs in, and an input holds its step, its step
/// holds its action, and so on up the graph: see "jobs".
let slotted : [:any] -> [:any];
let slotted argv = list.map (fn a -> match a {
    s if type_of s == :string => s,
    [:out, n] => [:out, n],
    i => [:in, slot i],
}) argv;

/// Slotted arguments made real, for this job.
let arguments : Job -> [:any] -> [:string];
let arguments job argv = list.map (fn a -> match a {
    s if type_of s == :string => s,
    [:out, n] => out job n,
    [:in, k] => (Job.paths job).[k else ""],
}) argv;

let command_run job argv = $( exec! job (arguments job argv) );

let out_arg n = [:out, n];

/// Every file under `dir` whose name ends with `suffix`, one to a line,
/// relative to the root. Never kept, since a file can be added under a
/// directory without anything this build knows of changing: it is how a plan
/// asks what is there (`given_files`).
let glob : :string -> :string -> Step;
let glob dir suffix =
    uncached (step "glob" (dir + "/*" + suffix) [] [dir, suffix] ["files"] [glob_run, [dir, suffix]]);

let glob_run job [dir, suffix] = $( {
    write_file! (out job "files") (str.join_str "\n" (tree_files! (Job.ctx job) dir suffix))
    [:ok, ""]
} );

// --- plans -------------------------------------------------------------------------------
//
// What a script answers: the things there are to ask for by name (goals),
// the tests there are to run (checks), and what cannot be said until
// something has been asked of the machine (`given`). Every contribution takes
// the plan last, so they chain with `|>`.

/// Something to ask for by name. `make` builds an input and says where it is;
/// `place` puts it somewhere of the project's choosing as well; `each` is
/// several goals under one name; `effect` runs a step every time it is asked
/// for, for installing and anything else whose point is outside `target/`.
union Goal {
    make(input : :any)
    place(path : :string, input : :any)
    each(names : [:string])
    effect(step : :any)
}

mapping Plan {
    goals = %{}         // name => Goal
    checks = %{}        // name => Input
    notes = %{}         // name => a line saying what it is for
    later = []          // [[Input, fn]]: `given`
    clashes = []        // names two parts of a plan both claimed
}

let empty : Plan;
let empty = Plan.make %{} %{} %{} [] [];

/// Set `name` in one of a plan's tables, noting a clash rather than letting
/// one quietly win.
let claim table name value plan = {
    let current = table plan;
    let noted = if current.[name else ()] == () { plan }
                else { Plan.set_clashes plan (list.cons name (Plan.clashes plan)) };
    [noted, current.[name => value]]
};

let goal : :string -> Goal -> Plan -> Plan;
let goal name g plan = { let [p, goals] = claim Plan.goals name g plan; Plan.set_goals p goals };
let check : :string -> Step -> Plan -> Plan;
let check name s plan = { let [p, checks] = claim Plan.checks name (output s) plan; Plan.set_checks p checks };
/// A line of explanation for a goal or a check, which `goals` prints.
let note : :string -> :string -> Plan -> Plan;
let note name text plan = Plan.set_notes plan ((Plan.notes plan).[name => text]);

let make input = Goal.make input;
let place p input = Goal.place p input;
let each names = Goal.each names;
let effect s = Goal.effect (uncached s);

/// A plan that depends on something only the machine can say: `input` is
/// built, its contents read, and `f` of them is merged in.
let given : Input -> (:string -> Plan) -> Plan -> Plan;
let given input f plan = Plan.set_later plan (list.append (Plan.later plan) [[input, f]]);

/// A plan that depends on which files are under a directory: `f` is handed
/// their paths, relative to the root.
let given_files : :string -> :string -> ([:string] -> Plan) -> Plan -> Plan;
let given_files dir suffix f plan =
    given (output (glob dir suffix))
          (fn text -> f (list.filter (fn l -> l != "") (str.split "\n" text))) plan;

/// Two plans as one. A name both of them claim is a clash, reported when the
/// plan is run.
let merge : Plan -> Plan -> Plan;
let merge a b = {
    let with_goals = list.fold (fn p [n, g] -> goal n g p) a (map_pairs (Plan.goals b));
    let with_checks = list.fold (fn p [n, i] -> {
        let [q, checks] = claim Plan.checks n i p;
        Plan.set_checks q checks
    }) with_goals (map_pairs (Plan.checks b));
    let with_notes = list.fold (fn p [n, t] -> note n t p) with_checks (map_pairs (Plan.notes b));
    Plan.set_clashes (Plan.set_later with_notes (list.append (Plan.later with_notes) (Plan.later b)))
                     (list.append (Plan.clashes with_notes) (Plan.clashes b))
};

let all : [Plan] -> Plan;
let all plans = list.fold merge empty plans;

// --- running a plan --------------------------------------------------------------------------

/// Resolve a plan's `given`s: build what they wait on, hand each its answer,
/// and go again with whatever that adds, until nothing is waiting.
let settle! : Context -> Plan -> Plan;
let rec settle! ctx plan = match Plan.later plan {
    [] => plan,
    later => {
        let [_, paths] = build! ctx (list.map list.head later);
        let answers = list.map (fn [[_, f], p] -> f (match read_file! p { () => "", text => text }))
                               (list.zip later paths);
        settle! ctx (list.fold merge (Plan.set_later plan []) answers)
    },
};

/// Where the files of a built input go when it is placed at `dest`: one file
/// for a named output, or every output of the step, beneath `dest`, for a
/// whole step (`artifact s ""`).
let placements ctx state input dest = match input {
    [:artifact, s, ""] => list.map (fn o -> [located ctx state (artifact s o), dest + "/" + o]) (Step.outputs s),
    _ => [[located ctx state input, dest]],
};

let parent_of p = {
    let parts = str.split "/" p;
    str.join_str "/" (list.take (list.length parts - 1) parts)
};

/// Put a built file at `dest` without ever writing to `dest`: a copy beside
/// it, renamed over it. A program that has the old file mapped -- a VM running
/// the old image -- keeps the pages it had. A copy rather than a link, because
/// what is placed is the project's to change, and a link would share every
/// change with the cache.
let place_file! from dest = {
    io.mkdir_all! (parent_of dest)
    let temp = dest + ".placing." + to_string (os.pid! ());
    io.remove_all! temp
    io.copy! from temp
    io.rename! temp dest
};

/// The goals a name stands for, `each` followed through.
let rec goals_named plan name = match (Plan.goals plan).[name else ()] {
    () => [[name, ()]],
    [:each, names] => list.flat_map (fn n -> goals_named plan n) names,
    g => [[name, g]],
};

let goal_input g = match g {
    [:make, i] => i,
    [:place, _, i] => i,
    [:effect, s] => artifact s "",
};

/// What a script's driver is told: `[mode, names, flags]`.
let rec parse_args args acc = match args {
    [] => acc,
    ["-j", n, ..rest] => parse_args rest (acc.[:jobs => parse_int n]),
    ["--profile", p, ..rest] => parse_args rest (acc.[:profile => p]),
    ["--release", ..rest] => parse_args rest (acc.[:profile => "release"]),
    ["-D", d, ..rest] => parse_args rest (acc.[:defines => list.append acc.[:defines] [d]]),
    ["--test", ..rest] => parse_args rest (acc.[:mode => :test]),
    ["--all", ..rest] => parse_args rest (acc.[:slow => true]),
    ["--bless", ..rest] => parse_args rest (acc.[:bless => true]),
    ["--goals", ..rest] => parse_args rest (acc.[:mode => :goals]),
    [name, ..rest] => parse_args rest (acc.[:names => list.append acc.[:names] [name]]),
};

/// `name=value` or `name`, as an option.
let define_pair d = match str.find "=" d {
    i if i > 0 => [str.slice 0 i d, str.slice (i + 1) (str.byte_length d - i - 1) d],
    _ => [d, true],
};

let show_names! plan = {
    let line! kind name = console.print! ("  " + kind + " " + name
                                           + (match (Plan.notes plan).[name else ()] { () => "", t => "  -- " + t }));
    list.map (fn n -> line! "goal " n) (list.sort (map.keys (Plan.goals plan))) |> strict!
    list.map (fn n -> line! "check" n) (list.sort (map.keys (Plan.checks plan))) |> strict!
    0
};

let log_tail log = {
    let lines = str.split "\n" (str.trim log);
    str.join_str "\n" (list.map (fn l -> "      " + l) (list.drop (list.length lines - 25) lines))
};

/// Run every check whose name begins with one of `prefixes`, all of them when
/// there are none, each one that does not depend on a failure.
let test! ctx plan prefixes = {
    let chosen = list.filter (fn [n, _] -> list.is_empty prefixes || list.any (fn p -> str.starts_with p n) prefixes)
                             (list.sort_on list.head (map_pairs (Plan.checks plan)));
    let [state, paths, failures] = build_all! ctx (list.map (fn c -> list.nth 1 c) chosen);
    let outcomes = list.map (fn [[name, input], p] -> {
        let failed = match input { [:artifact, s, _] => failures.[Step.id s else ()], _ => () };
        match [p, failed] {
            [(), ()] => { console.print! ("  skip  " + name + "  (something it needs failed)"); 1 },
            [(), [_, log]] => { console.print! ("  FAIL  " + name + "\n" + log_tail log); 1 },
            _ => { console.print! ("  ok    " + name); 0 },
        }
    }) (list.zip chosen paths);
    strict! outcomes
    let bad = list.sum outcomes;
    console.print! ("\n" + to_string (list.length chosen - bad) + " passed, " + to_string bad + " failed"
                    + ", " + to_string (list.length (State.ran state)) + " steps ran")
    if bad == 0 { 0 } else { 1 }
};

/// Build the goals named, and place what is to be placed.
let make_goals! ctx plan names = {
    let wanted = match names {
        [] => if (Plan.goals plan).[:default else ()] != () || (Plan.goals plan).["default" else ()] != () { ["default"] }
              else { [] },
        ns => ns,
    };
    let chosen = list.flat_map (fn n -> goals_named plan n) wanted;
    let unknown = list.filter (fn [n, g] -> g == ()) chosen;
    match [wanted, unknown] {
        [[], _] => {
            console.error! "build: say which goal to build; these are the ones there are:"
            show_names! plan
            2
        },
        [_, [[n, _], .._]] => {
            console.error! ("build: there is no goal `" + n + "`; these are the ones there are:")
            show_names! plan
            2
        },
        _ => {
            let [state, paths] = build! ctx (list.map (fn [_, g] -> goal_input g) chosen);
            let placed = list.map (fn [[name, g], p] -> match g {
                [:place, dest, input] => {
                    list.map (fn [from, to] -> place_file! from to)
                             (placements ctx state input (absolute ctx dest)) |> strict!
                    console.print! (name + ": " + dest)
                },
                _ => console.print! (name + ": " + p),
            }) (list.zip chosen paths);
            strict! placed
            console.error! (to_string (list.length (State.ran state)) + " steps ran, "
                            + to_string (State.reused state) + " were already made")
            0
        },
    }
};

/// A build script's `main!`: `mind` compiles a script with
/// `let main! = build.main! plan;` added, and runs it in the project's root
/// with the command line it was given:
///
///     GOAL..              build these goals (`default` when none is named)
///     --test [PREFIX..]   run the checks whose names begin so, or all of them
///     --bless             with --test, record what a check printed as expected
///     --goals             say what goals and checks there are
///     -j N, --profile P, --release, -D NAME[=VALUE]
let main! plan_of = {
    let o = parse_args (os.args! ()) %{ :mode => :build, :names => [], :defines => [], :jobs => 8,
                                         :profile => "debug", :bless => false, :slow => false };
    let options = list.fold (fn m d -> { let [k, v] = define_pair d; m.[k => v] })
                            (%{ "bless" => o.[:bless] }) o.[:defines];
    let ctx = Context.set_options (Context.set_profile (Context.set_jobs (context! ".") o.[:jobs]) o.[:profile])
                                  options;
    let code = try! {
        let plan = settle! ctx (plan_of ctx);
        match Plan.clashes plan {
            [] => match o.[:mode] {
                :goals => show_names! plan,
                :test => test! ctx plan o.[:names],
                _ => make_goals! ctx plan o.[:names],
            },
            names => {
                console.error! ("build: the plan names these twice: " + str.join_str ", " (list.unique names))
                2
            },
        }
    } catch e {
        match error.payload e {
            [:step_failed, name, log] => {
                console.error! ("build: " + name + " failed\n" + log_tail log)
                1
            },
            other => { console.error! ("build: " + to_string other); 1 },
        }
    };
    os.exit! code
};

when test {
    import std.test;

    let a = write "a.txt" "hello";
    let b = command "copy" ["cp", output a, out_arg "b.txt"];

    let tests = [
        test.case "a make rule's prerequisites, continued and escaped"
            $( test.eq! ["src/a.cpp", "include/a b.h", "/usr/include/stdio.h", "x$y"]
                        (depfile_reads "obj/a.o: src/a.cpp include/a\\ b.h \\\n  /usr/include/stdio.h x$$y\n") ),
        test.case "an identity is its tool, configuration, outputs and inputs, not its name"
            $( test.eq! [true, false]
                        [Step.id (write "a.txt" "hello") == Step.id (Step.set_name a "another name"),
                         Step.id a == Step.id (write "a.txt" "bye")] ),
        test.case "an artifact is described by the identity of the step that makes it"
            $( test.eq! [:artifact, Step.id a, "a.txt"] (describe (output a)) ),
        test.case "a command's inputs and outputs come from its arguments"
            $( test.eq! [[output a], ["b.txt"]] [Step.inputs b, Step.outputs b] ),
    ];
}
