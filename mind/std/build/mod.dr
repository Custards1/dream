// std.build: what a package's `build.dr` is written in.
//
// A script is a pure function from a `Context` to a `Plan`: what the package
// needs made before it can be compiled -- a C library to embed, a generated
// module, a switch that depends on the machine -- said as data. `mind` works
// out how, when and whether to make it. docs/build.md is the design; this
// module is its vocabulary, and `std.build.run` is the runner that carries a
// plan out.
//
// Everything here is pure, a step's action included: an action answers what
// is to be done as data -- write this text there, run this program with these
// arguments -- and the runner is the only thing that does it. A pure function
// cannot so much as name an impure one, so an action that did its own work
// could not be made by a pure script at all; and one that says what it wants
// can only touch what it names, inside its own directory. That, and plans
// being values, is what lets a plan be compared (a step whose key has not
// moved is not run), scheduled (the graph is known before anything runs) and
// left lazy (a payload nothing uses is never made).

import std.io;
import std.list;
import std.map;
import std.str;
import std.types;

// --- where a build runs ------------------------------------------------------------

/// Where an image runs, in the names the image header's target bits use.
///
/// The atoms are written out here, and not only for the checker: a context
/// reaches a script as `std.wire` bytes, and `wire` answers a name only with an
/// atom the program already has -- it never interns what it is sent. Naming
/// every value a field can take is what makes each one decodable.
mapping Target {
    os : :linux | :macos | :windows | :android | :unknown
    arch : :x86_64 | :aarch64 | :unknown
}

/// What a script is told, and all it may know about the world outside its own
/// files.
///
/// `env` holds only the variables the manifest lists in `[build] env`: an
/// environment variable the script cannot see cannot change its plan, which
/// is what lets the runner reuse an answer. `jobs` and `cache` are the
/// runner's rather than the script's -- how many steps may run at once, and
/// the directory every step's own directory lives under -- and are here so
/// that one file carries a run's whole configuration.
mapping Context {
    package : :string
    version : :string
    root : :string
    target : :map
    host : :map
    // A string, because a project may name its own (`[profile.bench]`), and a
    // name no program mentions would not come back through `std.wire` as an atom.
    profile : :string = "debug"
    env : %{:string => :string} = %{}
    options = %{}
    dependencies : %{:string => :string} = %{}
    jobs : :integer = 1
    cache : :string = "target/build/steps"
    // Whether this run is `mind test`'s, which runs the plan's checks, and the
    // VM and compiler command the build uses, for a check that runs either.
    testing : :bool = false
    vm : :string = "dream"
    compiler : [:string] = []
    // The checks a test run is asked for, by name; every one when empty.
    only : [:string] = []
    // The goals a run is asked to make, by name (`mind build GOAL..`). A run
    // asked for none makes what the compile needs and nothing else.
    goals : [:string] = []
}

/// Whether `v` is a whole context, its targets included -- what the runner
/// asks of one it has read, before a script sees it.
let is_context : :any -> :bool;
let is_context v =
    types.accepts Context.type v
    && types.accepts Target.type (Context.target v) && types.accepts Target.type (Context.host v);

let version : :map -> :string;
let version ctx = Context.version ctx;

let root : :map -> :string;
let root ctx = Context.root ctx;

let profile : :map -> :string;
let profile ctx = Context.profile ctx;

/// One of the package's options (`-D name=value`, `[options]`), or `()`.
let option : :map -> :string -> :any;
let option ctx name = (Context.options ctx).[name else ()];

let target_os : :map -> :atom;
let target_os ctx = Target.os (Context.target ctx);

/// `libsqlite3.so`, `libsqlite3.dylib` or `sqlite3.dll`, for the target.
/// Every tool needs these, so they are written once.
let shared_name : :map -> :string -> :string;
let shared_name ctx name = match Target.os (Context.target ctx) {
    :windows => name + ".dll",
    :macos => "lib" + name + ".dylib",
    _ => "lib" + name + ".so",
};

let exe_name : :map -> :string -> :string;
let exe_name ctx name = match Target.os (Context.target ctx) { :windows => name + ".exe", _ => name };

let object_name : :map -> :string -> :string;
let object_name ctx name = match Target.os (Context.target ctx) { :windows => name + ".obj", _ => name + ".o" };

// --- inputs and steps ----------------------------------------------------------------

/// A file in the package, relative to its root; every file under a directory
/// whose name ends with `suffix` (`""` for all of them); or something a step
/// makes.
///
/// An artifact holds the step that makes it, and that one decision is the
/// graph: a step's inputs name the steps they come from, so the whole graph is
/// whatever is reachable from the plan. There is no registry and no global
/// state, and an artifact nothing reaches is never built. A bare string is
/// accepted wherever an input is, and means a file.
union Input {
    file(path : :string)
    tree(dir : :string, suffix : :string)
    artifact(step : :map, name : :string)
}

let file : :string -> :any;
let file p = Input.file p;

/// Every file under `dir` ending in `suffix`, as one input: what a step reads
/// that it walks for itself, such as a directory of tests a script runs. A
/// file added there changes the key as surely as one edited.
let tree : :string -> :string -> :any;
let tree dir suffix = Input.tree dir suffix;

/// A bare string made into the input it means.
let input : :any -> :any;
let input i = match type_of i { :string => Input.file i, _ => i };

/// One piece of work.
///
/// `config` is data -- everything that changes what the step makes, other
/// than its inputs' contents -- and `action` is what makes it: a pure function
/// from a `Job` to the operations the runner is to carry out (`Op`). `shape` is the digest of everything about the step a
/// pure function can see: the tool, the config, the outputs, and the shapes of
/// the steps its artifacts come from. It is computed once, when the step is
/// made, and read lazily, so a graph where many steps share one input costs
/// one digest per step and not one per path to it. The runner's key is the
/// shape with the contents of the files folded in, which only an effect can
/// read. The name is in neither: two packages asking for the same thing by
/// different names share the work.
///
/// The last three say how it is run rather than what it makes, and are in
/// neither. `discovers` is a step that writes a make rule to `deps.d` naming
/// what it read -- `gcc -MD` and `dreams --depfile` both do -- so that a header
/// or a module it never declared still makes it run again when it changes
/// (docs/build.md, "Discovered inputs"). `cache` is `:never` for one that runs
/// every time it is asked for: a question whose answer is not in its inputs,
/// such as what a directory holds now. `timeout` is in milliseconds, 0 for
/// none: a step is a program, and a program may diverge.
mapping Step {
    tool
    name
    inputs = []
    config = ()
    outputs = []
    action
    shape
    discovers : :bool = false
    cache : :atom = :shared
    timeout : :integer = 0
}

/// What an action receives. `paths` maps each input (by `input_id`) to where
/// it is on disk -- `build.path` is how an action asks -- and `dir` is the
/// step's own directory, the only place it may write.
mapping Job { dir, ctx, paths = %{} }

/// The shape of an input, as a step's shape includes it.
priv let input_shape : :any -> :any;
priv let input_shape i = match i {
    Input.file(p) => [:file, p],
    Input.tree(d, suffix) => [:tree, d, suffix],
    Input.artifact(s, n) => [:artifact, Step.shape s, n],
};

/// A step. The constructor every tool ends in, because it is the one that
/// works out the shape.
let step : :string -> :string -> [:any] -> :any -> [:string] -> :any -> :map;
let step tool name inputs config outputs action = {
    let ins = list.map input inputs;
    Step.make tool name ins config outputs action
        (io.digest (encode [tool, config, outputs, list.map input_shape ins])) false :shared 0
};

/// A step that names what it read in `deps.d`.
let discovering : :map -> :map;
let discovering s = Step.set_discovers true s;

/// A step run every time it is asked for.
let uncached : :map -> :map;
let uncached s = Step.set_cache :never s;

/// A step killed, and failed, after `ms` milliseconds.
let within : :integer -> :map -> :map;
let within ms s = Step.set_timeout ms s;

/// What an action asks for, carried out in order by the runner, in the step's
/// directory, stopping at the first that fails. A name is relative to that
/// directory; `copy`'s source is a path from `Job.paths`. A program is looked
/// up on `PATH` as a shell would, and runs with the step's directory as its
/// working directory.
///
/// `run` is `exec` somewhere else, with variables of its own: for a check,
/// which asks a question of the package where it is rather than making
/// something in a directory of its own. It is the only operation that reaches
/// outside the step's directory, and a step that makes something has no use
/// for it.
///
/// `run_to` is `run` with everything the program printed, its errors written
/// in among its output as a terminal shows them, kept in `name` whether or not
/// it succeeds; an empty `dir` is the step's own. A compile whose output is
/// itself something to read (MSVC's `/showIncludes`) and a check that compares
/// what a program printed are both this.
///
/// `find`, `capture`, `attempt` and `list` ask the machine a question rather
/// than make something, and never fail -- the answer is the point, and "no"
/// is one: `find` writes where a program is on `PATH` (or nothing), `capture`
/// what a program printed when it succeeded (or nothing), `attempt` `yes` or
/// `no` for whether it succeeded, and `list` every file under `dir` ending in
/// `suffix`, one to a line, relative to `dir`. `verify` fails unless the file
/// has the SHA-256 given, which is what pins something fetched.
///
/// `transform` writes `f` of some files' texts as another: a pure function, so
/// a tool can turn what programs printed into what it needs -- a depfile, an
/// export list, one answer made of several -- without an effect of its own. `link` is `copy` sharing the
/// bytes, for a file nothing will write to again: another step's output. The
/// last two are a check's: `expect` fails, saying where, unless `name` holds
/// what the file at `path` does, line endings at the end aside -- or, when
/// `bless`, makes the file hold it -- and `same` unless two files are byte for
/// byte one. `observe` is `run_to` that keeps what the program printed however
/// it exits, failing only when it could not be run or ran out of time: what a
/// check of a program's output runs it with, since the output is the answer,
/// and `empty` fails, showing what it holds, unless a file is empty.
union Op {
    write(name : :string, text : :string)
    copy(from : :string, name : :string)
    link(from : :string, name : :string)
    exec(program : :string, args : [:string])
    run(dir : :string, env : %{:string => :string}, program : :string, args : [:string])
    run_to(dir : :string, env : %{:string => :string}, program : :string, args : [:string], name : :string)
    observe(dir : :string, env : %{:string => :string}, program : :string, args : [:string], name : :string)
    find(program : :string, name : :string)
    capture(program : :string, args : [:string], name : :string)
    attempt(program : :string, args : [:string], name : :string)
    list(dir : :string, suffix : :string, name : :string)
    verify(name : :string, digest : :string)
    transform(from : [:string], name : :string, f : [:string] -> :string)
    expect(name : :string, path : :string, bless : :bool)
    same(a : :string, b : :string)
    empty(name : :string, why : :string)
}

/// An output of a step, as an input to another.
let artifact : :map -> :string -> :any;
let artifact s name = Input.artifact s name;

/// The name an input goes by in `Job.paths`. A string, because a map compares
/// a list key by identity rather than by contents, and the same input is
/// rebuilt as a new list wherever a bare string is turned into one.
let input_id : :any -> :string;
let input_id i = encode (input_shape (input i));

/// Where an input is, from inside an action.
let path : :map -> :any -> :string;
let path job i = (Job.paths job).[input_id i else ()];

/// Where an output goes, from inside an action.
let out : :map -> :string -> :string;
let out job name = Job.dir job + "/" + name;

// --- plans ------------------------------------------------------------------------------

/// What a package contributes to its own compile, and what there is to ask
/// of it by name.
///
/// Every contribution takes the plan last, so they chain with `|>`. `later` is
/// `given`'s: `[input, f]` pairs the runner resolves once the input is built.
/// `conflicts` is what merging found -- two payloads or two modules under one
/// name -- kept rather than raised, because building a plan is pure; the
/// runner reports them before it runs anything. `goals` and `checks` are what
/// a person asks for (`mind build GOAL`, `mind test NAME`), and `notes` a line
/// about either, for the list a wrong name is answered with.
mapping Plan {
    payloads = %{}
    modules = %{}
    defines = %{}
    hosts = []
    target = ()
    steps = []
    later = []
    conflicts = []
    checks = %{}
    goals = %{}
    notes = %{}
}

let empty : :map;
let empty = Plan.make (%{}) (%{}) (%{}) [] () [] [] [] (%{}) (%{}) (%{});

/// Embed a file in the image: `--payload NAME=PATH`.
let payload : :string -> :any -> :map -> :map;
let payload name i p = Plan.set_payloads (claim "payload" name (input i) (Plan.payloads p)) p;

/// A generated module, imported as `<package>.<name>`.
let module : :string -> :any -> :map -> :map;
let module name i p = Plan.set_modules (claim "module" name (input i) (Plan.modules p)) p;

/// A `when` flag, scoped to the package.
let define : :string -> :map -> :map;
let define name p = Plan.set_defines ((Plan.defines p).[name => true]) p;

/// A `when` setting with a value.
let set : :string -> :any -> :map -> :map;
let set name value p = Plan.set_defines ((Plan.defines p).[name => value]) p;

/// A host module the package needs at run time.
let host_module : :string -> :map -> :map;
let host_module name p = Plan.set_hosts (list.unique (list.append (Plan.hosts p) [name])) p;

/// Where the result can run: a list of targets, or `()` to let the compiler
/// decide. Two plans' targets meet rather than add.
let target : :any -> :map -> :map;
let target ts p = Plan.set_target (meet (Plan.target p) ts) p;

/// A check `mind test` runs: it passes when the step's operations all
/// succeed. Only `mind test` runs checks, and it runs them every time -- a
/// check is a question, not something made -- after building whatever they
/// read.
let check : :string -> :map -> :map -> :map;
let check name s p = Plan.set_checks (claim "check" name s (Plan.checks p)) p;

/// Something to ask for by name. `make` builds an input and says where it is;
/// `place` puts it somewhere of the project's choosing as well, which is the
/// one way a build writes outside its cache; `each` is several goals under one
/// name; `effect` runs a step every time it is asked for, for installing and
/// anything else whose point is outside the build.
union Goal {
    make(input : :any)
    place(path : :string, input : :any)
    each(names : [:string])
    effect(step : :map)
}

let make : :any -> :any;
let make i = Goal.make (input i);

/// `path` is relative to the package. An input that is a whole step
/// (`artifact s ""`) places every output of the step beneath `path`.
let place : :string -> :any -> :any;
let place path i = Goal.place path (input i);

let each : [:string] -> :any;
let each names = Goal.each names;

let effect : :map -> :any;
let effect s = Goal.effect (uncached s);

let goal : :string -> :any -> :map -> :map;
let goal name g p = Plan.set_goals (claim "goal" name g (Plan.goals p)) p;

/// A line saying what a goal or a check is for.
let note : :string -> :string -> :map -> :map;
let note name text p = Plan.set_notes ((Plan.notes p).[name => text]) p;

/// Make a step whether or not anything uses it.
let also : :map -> :map -> :map;
let also s p = Plan.set_steps (list.append (Plan.steps p) [s]) p;

/// Once `i` is built, read it as a string and merge in `f` of it. `f` is pure,
/// so the effect is still only in the step that made `i`.
let given : :any -> (:string -> :map) -> :map;
let given i f = Plan.set_later [[input i, f]] empty;

/// Every file under `dir` ending in `suffix`, one to a line, relative to the
/// package. Never kept, since a file can be added under a directory without
/// anything this build knows of changing: it is how a plan asks what is there.
let listing : :string -> :string -> :any;
let listing dir suffix =
    artifact (uncached (step "list" (dir + "/*" + suffix) [] [dir, suffix] ["files"]
                             (fn job -> [Op.list (Context.root (Job.ctx job) + "/" + dir) suffix "files"])))
             "files";

/// A plan that depends on which files are under a directory: `f` is handed
/// their paths, relative to the package.
let given_files : :string -> :string -> ([:string] -> :map) -> :map;
let given_files dir suffix f =
    given (listing dir suffix)
          (fn text -> f (list.map (fn l -> dir + "/" + l) (list.filter (fn l -> not (str.is_empty l)) (str.split "\n" text))));

/// The table with `name => value` in it. A name already given to something
/// else is marked as a conflict in the table itself, which is where
/// `conflicts` finds it: the plan stays a value, and nothing raises.
priv let claim : :string -> :string -> :any -> :map -> :map;
priv let claim kind name value table = match table.[name else ()] {
    () => table.[name => value],
    old if old == value => table,
    _ => table.[name => [:conflict, kind, name]],
};

priv let meet : :any -> :any -> :any;
priv let meet a b = match [a, b] {
    [(), _] => b,
    [_, ()] => a,
    _ => list.filter (fn t -> list.contains t b) a,
};

/// Two tables merged, a name in both recorded as a conflict unless both say
/// the same thing.
priv let merge_table : :string -> :map -> :map -> :map;
priv let merge_table kind a b =
    map.fold (fn acc k v -> match acc.[k else ()] {
        () => acc.[k => v],
        old if old == v => acc,
        _ => acc.[k => [:conflict, kind, k]],
    }) a b;

/// The conflicts a table holds, as messages.
priv let table_conflicts : :map -> [:string];
priv let table_conflicts t =
    list.flat_map (fn pair -> match list.nth 1 pair {
        [:conflict, kind, name] => ["two " + kind + "s are called `" + name + "`"],
        _ => [],
    }) (_map_pairs t);

/// Several plans as one. Merging is a union, and a name two of them give
/// different things to is a conflict rather than one silently winning.
let all : [:map] -> :map;
let all plans = list.fold (fn a b ->
    Plan.make (merge_table "payload" (Plan.payloads a) (Plan.payloads b))
              (merge_table "module" (Plan.modules a) (Plan.modules b))
              (map.merge (Plan.defines a) (Plan.defines b))
              (list.unique (list.append (Plan.hosts a) (Plan.hosts b)))
              (meet (Plan.target a) (Plan.target b))
              (list.append (Plan.steps a) (Plan.steps b))
              (list.append (Plan.later a) (Plan.later b))
              (list.append (Plan.conflicts a) (Plan.conflicts b))
              (merge_table "check" (Plan.checks a) (Plan.checks b))
              (merge_table "goal" (Plan.goals a) (Plan.goals b))
              (map.merge (Plan.notes a) (Plan.notes b))) empty plans;

/// Everything wrong with a plan, before anything is run.
let conflicts : :map -> [:string];
let conflicts p = list.concat [Plan.conflicts p, table_conflicts (Plan.payloads p),
                               table_conflicts (Plan.modules p), table_conflicts (Plan.checks p),
                               table_conflicts (Plan.goals p)];

/// What a run hands the compile, with every input resolved to a path: the
/// payloads by name, the directory of generated modules (or `()`), the
/// defines, host modules and targets, the stamp of every file the plan read
/// (by which `mind` tells whether it has to run the script again), and how
/// many steps were built and reused. Declared here, and not only built by the
/// runner, because it crosses from one program to another as `std.wire`, and
/// a reader has to name every key it accepts.
mapping Outcome {
    payloads : %{:string => :string} = %{}
    modules = ()
    defines = %{}
    hosts : [:string] = []
    target = ()
    reads = %{}
    built : :integer = 0
    reused : :integer = 0
    // A test run's checks, by name: whether each passed, how long it took in
    // milliseconds, and what it printed when it failed.
    checks : %{:string => [:bool, :integer, :string]} = %{}
    // The goals a run was asked for, by name: where each one's result is.
    goals : %{:string => :string} = %{}
}

let is_outcome : :any -> :bool;
let is_outcome v = types.accepts Outcome.type v;

// --- steps every build has ---------------------------------------------------------

/// A step that writes `text` to `name`, keyed on the text itself. Generating a
/// module is ordinary Dream code handed to this: the text is pure and lazy,
/// and the step is only run when the text has changed.
let write : :string -> :string -> :any;
let write name text =
    artifact (step "write" name [] [name, text] [name] (fn job -> [Op.write name text])) name;

// --- keys --------------------------------------------------------------------------

/// `v` with every artifact in it replaced by its step's shape: a tool's
/// configuration as a key can read it. An artifact holds its step, and a step
/// holds its action, which no key can say; the shape says everything about
/// the step that could change what it makes.
let keyed : :any -> :any;
let rec keyed v = match v {
    Input.artifact(s, n) if type_of s == :map && _map_has s :shape => [:artifact, Step.shape s, n],
    _ => match type_of v {
        :list => list.map keyed v,
        :map => map.map_values keyed v,
        // A record, keyed as what it is and its fields: a key is read, never
        // used, so it need not be the record again.
        _ => if _record_id v == () { v }
             else { %{ "<record>" => _record_id v, "<fields>" => list.map keyed (_array_to_list (_record_fields v)) } },
    },
};

/// Whether `v` is data -- something `encode` can say exactly. A function in a
/// step's config would be keyed as nothing at all, and a change to it would
/// never rebuild anything, so the runner refuses one instead.
let is_data : :any -> :bool;
let rec is_data v = match type_of v {
    :pure_fn => false,
    :impure_fn => false,
    :process => false,
    :module => false,
    :error => false,
    :list => list.all is_data v,
    :array => list.all is_data (_array_to_list v),
    :map => list.all (fn pair -> is_data (list.head pair) && is_data (list.nth 1 pair)) (_map_pairs v),
    _ => _record_id v == () || list.all is_data (_array_to_list (_record_fields v)),
};

/// A canonical spelling of a piece of data: two values encode alike exactly
/// when they are equal, whatever order a map was built in. Every piece says
/// what kind it is and how long it is, so no two values can run into each
/// other's text. What a key is a digest of.
let encode : :any -> :string;
let rec encode v = match type_of v {
    :string => "s" + to_string (str.byte_length v) + ":" + v,
    :bigstr => "s" + to_string (str.byte_length v) + ":" + v,
    :integer => "i" + to_string v + ";",
    :float => "f" + to_string v + ";",
    :char => "c" + to_string (_char_code v) + ";",
    :atom => "a" + to_string v + ";",
    :bool => if v { "T" } else { "F" },
    :unit => "U",
    :list => "[" + str.join_str "" (list.map encode v) + "]",
    :array => "#[" + str.join_str "" (list.map encode (_array_to_list v)) + "]",
    :map => "{" + str.join_str "" (list.map (fn pair -> encode (list.head pair) + encode (list.nth 1 pair))
                                            (list.sort_on list.head (_map_pairs v))) + "}",
    // A record says which one it is, then its fields, as an array does.
    other => if _record_id v == () { "?" + to_string other + ";" }
             else { "r" + encode (_record_id v) + encode (_record_fields v) },
};

when test {
    import std.test;

    let ctx os = Context.new "p" "1.0" "/p" (Target.make os :x86_64) (Target.make :linux :x86_64);
    let noop job = [];
    let leaf = step "t" "leaf" ["a.c"] [1] ["a.o"] noop;

    let tests = [
        test.case "a name for the target's shared library"
            $( test.eq! ["libz.so", "libz.dylib", "z.dll"]
                        (list.map (fn os -> shared_name (ctx os) "z") [:linux, :macos, :windows]) ),
        test.case "a bare string is a file"
            $( test.eq! [Input.file "a.c", Input.artifact leaf "a.o"]
                        [input "a.c", input (artifact leaf "a.o")] ),
        test.case "encoding does not depend on the order a map was built in"
            $( test.eq! (encode (%{ :a => 1, "b" => [2, 3] })) (encode ((%{ "b" => [2, 3] }).[:a => 1])) ),
        test.case "encoding tells a string from the text of another value"
            $( test.eq! 4 (list.length (list.unique (list.map encode ["1", 1, '1', ["1"]]))) ),
        test.case "a function is not data"
            $( test.eq! [true, false, false] [is_data [1, %{ :a => "b" }], is_data noop, is_data [noop]] ),
        test.case "the shape ignores the name and follows the config"
            $( test.eq! [true, false]
                        [Step.shape (step "t" "x" ["a.c"] [1] ["a.o"] noop) == Step.shape leaf,
                         Step.shape (step "t" "x" ["a.c"] [2] ["a.o"] noop) == Step.shape leaf] ),
        test.case "the shape follows the step an artifact comes from"
            $( test.ne! (Step.shape (step "u" "y" [artifact leaf "a.o"] () [] noop))
                        (Step.shape (step "u" "y" [artifact (step "t" "leaf" ["b.c"] [1] ["a.o"] noop) "a.o"] () [] noop)) ),
        test.case "contributions chain"
            $( test.eq! [["x"], %{ "f" => true, "n" => 3 }, ["h"]]
                        {
                            let p = empty |> payload "x" "x.bin" |> define "f" |> set "n" 3 |> host_module "h";
                            [map.keys (Plan.payloads p), Plan.defines p, Plan.hosts p]
                        } ),
        test.case "two payloads under one name are a conflict"
            $( test.eq! ["two payloads are called `x`"]
                        (conflicts (all [empty |> payload "x" "a", empty |> payload "x" "b"])) ),
        test.case "the same payload twice is not"
            $( test.eq! [] (conflicts (all [empty |> payload "x" "a", empty |> payload "x" "a"])) ),
        test.case "targets meet"
            $( test.eq! [[:linux], ()]
                        [Plan.target (all [empty |> target [:linux, :macos], empty |> target [:linux]]),
                         Plan.target empty] ),
        test.case "writing is keyed on the text"
            $( test.ne! (Step.shape (write "v.dr" "a").[0]) (Step.shape (write "v.dr" "b").[0]) ),
    ];
}
