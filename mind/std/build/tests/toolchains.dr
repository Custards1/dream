// One description of a C++ library and a program that uses it, built by every
// toolchain this machine has: GCC and Clang through `std.build.cc.gnu`, and
// CMake through the file `std.build.cc.cmake` writes for the same targets.
// Each result is run, and has to answer 42.
//
// This is the claim docs/build.md makes in "One script, every compiler", put
// to the compilers themselves rather than to a comparison of flags. A
// toolchain that is not installed is skipped and says so; one that is
// installed and fails, fails the run. MSVC is covered by its translation's
// tests until a Windows machine runs this.

import std.build.cc;
import std.build.cc.cmake;
import std.build.cc.gnu;
import std.console;
import std.io;
import std.list;
import std.os;
import std.str;

let write_file! path text = {
    let h = io.open! path :write;
    io.write! h text
    io.close! h
};

/// The fixture: a header, a library with one exported function whose answer
/// depends on a define, and a program that prints it.
let sources! root = {
    io.mkdir_all! (root + "/include")
    io.mkdir_all! (root + "/src")
    write_file! (root + "/include/demo.h")
        "#pragma once\n#ifdef _WIN32\n#define DEMO_API __declspec(dllexport)\n#else\n#define DEMO_API\n#endif\nDEMO_API int answer(int);\n"
    write_file! (root + "/src/demo.cpp")
        "#include \"demo.h\"\n#include <string>\n#ifndef DEMO_TWICE\n#error \"the define did not reach the library\"\n#endif\nint answer(int x) { return int(std::to_string(x * DEMO_TWICE).size()) * 0 + x * DEMO_TWICE; }\n"
    write_file! (root + "/src/main.cpp")
        "#include \"demo.h\"\n#include <cstdio>\nint main() { std::printf(\"%d\\n\", answer(21)); return 0; }\n"
};

let library =
    cc.shared "demo" ["src/demo.cpp"]
    |> cc.standard :cxx20
    |> cc.optimize 2
    |> cc.warnings :extra
    |> cc.warnings_as_errors true
    |> cc.define_value "DEMO_TWICE" 2
    |> cc.public_include "include"
    |> cc.threads
    |> cc.flags_for :msvc ["/permissive-"];

let program =
    cc.executable "demo" ["src/main.cpp"]
    |> cc.standard :cxx20
    |> cc.use library
    |> cc.runtime_path "../lib";

/// Run a command in `root`, answering its output, or raising with all of it.
let run! root argv = {
    let r = os.run! (list.head argv) (list.tail argv) %{ :cwd => root, :timeout => 120000 };
    if r.[:code] != 0 {
        raise! [:failed, str.join_str " " argv, r.[:out] + r.[:err]]
    } else { r.[:out] }
};

let installed! program = (try! { os.run! program ["--version"] %{ :timeout => 20000 } } catch e { %{ :code => 1 } }).[:code] == 0;

/// Build both targets with one GNU-family toolchain, then run the program.
let build_gnu! root tc = {
    let out = "out/" + cc.Toolchain.cxx tc;
    io.mkdir_all! (root + "/" + out + "/obj")
    io.mkdir_all! (root + "/" + out + "/lib")
    io.mkdir_all! (root + "/" + out + "/bin")
    let objects! t = list.map (fn src -> {
        let obj = out + "/obj/" + cc.object_name tc (list.head src);
        run! root (gnu.compile tc t src obj (obj + ".d"))
        obj
    }) (cc.sources t) |> strict!;
    let lib = out + "/lib/" + cc.file_name tc :shared "demo";
    list.map (fn c -> run! root c) (gnu.link tc library (objects! library) [] lib) |> strict!
    let exe = out + "/bin/" + cc.file_name tc :executable "demo";
    list.map (fn c -> run! root c) (gnu.link tc program (objects! program) [lib] exe) |> strict!
    // A program named by a relative path is found from where this VM stands,
    // not from `:cwd`, so the one just built is named in full.
    str.trim (run! root [root + "/" + exe])
};

/// Build both targets through CMake, from the file `export` writes.
let build_cmake! root = {
    io.mkdir_all! (root + "/cmake")
    write_file! (root + "/cmake/CMakeLists.txt")
        (cmake.export "Generated by toolchains.dr." "demo" "${CMAKE_CURRENT_SOURCE_DIR}/.." [library, program])
    run! root ["cmake", "-S", "cmake", "-B", "out/cmake", "-DCMAKE_BUILD_TYPE=Release"]
    run! root ["cmake", "--build", "out/cmake"]
    str.trim (run! root [root + "/out/cmake/demo"])
};

let attempt! name available build = {
    let outcome = if not available { "skipped, not installed" }
                  else {
                      match try! { build () } catch e { e } {
                          "42" => "42",
                          other => "FAILED: " + to_string other,
                      }
                  };
    console.print! (name + ": " + outcome)
    str.starts_with "FAILED" outcome
};

let main! = {
    let root = "/tmp/dream-toolchains-" + to_string (os.pid! ());
    io.remove_all! root
    sources! root
    // One statement each: an effect in a list literal is suspended until the
    // list is looked at, and then in whatever order it is looked at.
    let gcc_failed = attempt! "gcc" (installed! "g++") (fn () -> build_gnu! root (cc.gcc (os.platform ())));
    strict! gcc_failed
    let clang_failed = attempt! "clang" (installed! "clang++") (fn () -> build_gnu! root (cc.clang (os.platform ())));
    strict! clang_failed
    let cmake_failed = attempt! "cmake" (installed! "cmake") (fn () -> build_cmake! root);
    strict! cmake_failed
    io.remove_all! root
    os.exit! (if gcc_failed || clang_failed || cmake_failed { 1 } else { 0 })
};
