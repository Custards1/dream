// std.build.command: run any program as a step.
//
//     let parser = command.make "peg" "peg-gen" [command.file "grammar.peg", "-o", command.out "parser.dr"];
//     build.module "parser" parser
//
// The arguments are one list, and what in it is an input or an output is
// marked there: a bare string is passed as written, `command.file` and an
// artifact are inputs (passed as their paths), and `command.out` is an output
// (passed as its name, which is relative to the step's directory, where the
// program runs). So a step's inputs, its outputs and its key all come from the
// one list the program is run with, and cannot drift from it.

import std.build;
import std.list;

/// An output of the command, passed to it by name.
let out : :string -> :any;
let out name = [:out, name];

/// A file of the package, passed to the command as its path.
let file : :string -> :any;
let file path = build.Input.file path;

let is_input : :any -> :bool;
let is_input a = match a { [:file, _] => true, [:artifact, _, _] => true, _ => false };

/// The arguments as a key reads them: where each input goes rather than what
/// it is. The inputs are in the key already, by content, and a path would
/// make the same command in two checkouts two different steps.
let placed : [:any] -> [:any];
let placed args = {
    let inputs = list.filter is_input args;
    list.map (fn a -> match a {
        [:out, n] => [:out, n],
        _ if is_input a => [:in, list.index_of a inputs],
        s => s,
    }) args
};

/// The step, for a caller that wants more than its first output.
let step : :string -> :string -> [:any] -> :map;
let step name program args = {
    let inputs = list.filter is_input args;
    let outputs = list.flat_map (fn a -> match a { [:out, n] => [n], _ => [] }) args;
    build.step "command" name inputs [program, placed args] outputs
        (fn job -> [build.Op.exec program (list.map (fn a -> match a {
            [:out, n] => n,
            _ if is_input a => build.path job a,
            s => s,
        }) args)])
};

/// The VM and the compiler this build uses, as the environment of a program
/// that runs either: `DREAM` and `DREAMS`, which is what `mind` itself reads.
/// The compiler is the last word of how it is run -- its image, when it is
/// an image the VM runs.
let toolchain : :map -> %{:string => :string};
let toolchain ctx = %{ "DREAM" => build.Context.vm ctx, "DREAMS" => list.last (build.Context.compiler ctx) };

/// A check that runs `program` in the package's directory, with `env` laid over
/// the environment: what a test suite written as a script is run as. It passes
/// when the program does. Its inputs are marked in `args` as a step's are, so
/// what it reads is built first; and it runs every time whatever its key,
/// since a script reads what it likes and its key cannot say what that was.
/// `std.build.check` is for a check that declares everything it reads, and is
/// kept like any step.
let check : :map -> :string -> %{:string => :string} -> :string -> [:any] -> :map;
let check ctx name env program args = check_in (build.Context.root ctx) name env program args;

/// The same, run in `dir`: for a suite written to be run from somewhere other
/// than the package, such as the root of the repository it belongs to.
let check_in : :string -> :string -> %{:string => :string} -> :string -> [:any] -> :map;
let check_in dir name env program args =
    build.uncached (build.step "check" name (list.filter is_input args) [dir, program, env, placed args]
               (list.flat_map (fn a -> match a { [:out, n] => [n], _ => [] }) args)
               (fn job -> [build.Op.run dir env program (list.map (fn a -> match a {
                   [:out, n] => build.out job n,
                   _ if is_input a => build.path job a,
                   s => s,
               }) args)]));

/// Its first output, as an input to something else: what most callers want.
let make : :string -> :string -> [:any] -> :any;
let make name program args = {
    let s = step name program args;
    build.artifact s (list.head (build.Step.outputs s))
};

when test {
    import std.test;

    let tests = [
        test.case "inputs and outputs come from the argument list"
            $( {
                let s = step "t" "cc" [file "a.c", "-o", out "a.o"];
                test.eq! [[[:file, "a.c"]], ["a.o"]] [build.Step.inputs s, build.Step.outputs s]
            } ),
        test.case "an artifact is an input"
            $( {
                let made = make "g" "gen" [out "g.c"];
                test.eq! [made] (build.Step.inputs (step "c" "cc" [made, out "g.o"]))
            } ),
        test.case "the key follows the program and the arguments"
            $( test.ne! (build.Step.shape (step "t" "cc" [file "a.c", "-O2"]))
                        (build.Step.shape (step "t" "cc" [file "a.c", "-O0"])) ),
    ];
}
