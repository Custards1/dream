// std.build.fetch: a file from a URL, pinned by its digest.
//
//     let source = fetch.url "sqlite.tar.gz" "https://www.sqlite.org/2024/sqlite-autoconf-3450000.tar.gz"
//                            "72887d57a1d8f89f52be38ef84a6353ce8c3ed55ada7864eb944abd9a495e436";
//
// For a source too large to check in. The digest is the SHA-256 its publisher
// prints, and it is the key: a fetch is done once, anywhere the cache is
// shared, and never again until the pin changes. What arrives is checked
// against it, so a URL that starts answering something else fails the build
// rather than changing it.
//
// It runs `curl`, which every system this builds on has -- Windows since 10.

import std.build;

let url : :string -> :string -> :string -> :any;
let url name address digest =
    // The key is the digest and the name, and not the address: a mirror that
    // serves the same bytes is the same step.
    build.artifact (build.step "fetch" name [] [name, digest] [name]
                               (fn job -> [build.Op.exec "curl" ["-fsSL", "--retry", "2", "-o", name, address],
                                           build.Op.verify name digest]))
                   name;

when test {
    import std.list;
    import std.test;

    let tests = [
        test.case "a fetch is keyed by its pin, not its URL"
            $( {
                let shape a = build.Step.shape a.[0];
                test.eq! [true, false] [shape (url "a" "https://x/a" "00") == shape (url "a" "https://y/a" "00"),
                                        shape (url "a" "https://x/a" "00") == shape (url "a" "https://x/a" "11")]
            } ),
    ];
}
