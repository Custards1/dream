// An Arch Linux package: what `pacman -U` installs, on Arch, Manjaro,
// EndeavourOS and the rest.
//
// A package is a compressed tar (zstd since pacman 5.2, and xz or gzip for
// an older one) of the files laid out from the root without a leading `./`,
// with three files of pacman's own in front of them:
//
// - `.PKGINFO`, `key = value` lines saying what the package is and needs;
// - `.INSTALL`, when there are scripts: shell functions named for the
//   moment each runs (`post_install`), which pacman sources and calls;
// - `.MTREE`, a gzipped mtree(5) of every file with its digest, which is
//   what `pacman -Qkk` checks an installed package against.
//
// The maintainer scripts are Debian's four hooks, and each becomes the
// functions that run at the same point: `postinst` is `post_install` and
// `post_upgrade`, as Debian runs it after an upgrade too.
//
// `pkgbuild` writes the other thing Arch users install from: a PKGBUILD for
// the AUR that downloads a release tarball and lays it out, for a package
// that is published that way instead (`ship pkgbuild`).

import std.crypto;
import std.file;
import std.io;
import std.list;
import std.map;
import std.result;
import std.str;

import bytes;
import compress;
import deps;
import item;
import item.{Item};
import layout;
import layout.Layout;
import out;
import platform;
import scratch;
import spec;
import spec.Spec;
import tar;

let file_name : Spec -> compress.Compression -> :string;
let file_name sp c = Spec.name sp + "-" + spec.full_version sp + "-" + platform.pacman (Spec.arch sp) + ".pkg.tar"
                     + compress.extension c;

/// One line of `.PKGINFO`, or none for an empty value.
let line : :string -> :string -> :string;
let line key value = if str.is_empty value { "" } else { key + " = " + value + "\n" };

let relation : Spec -> :string -> :string -> [:ok, :string] | [:error, :string];
let relation sp key label = result.map (fn ds -> str.concat_all (list.map (fn d -> line label (deps.pacman d)) ds))
                                       (deps.parse_all (spec.strings sp "arch" key));

let pkginfo : Spec -> Layout -> [:ok, :string] | [:error, :string];
let pkginfo sp lay = {
    let? needs = relation sp "depends" "depend";
    let? optional = relation sp "recommends" "optdepend";
    let? conflicts = relation sp "conflicts" "conflict";
    let? provides = relation sp "provides" "provides";
    let? replaces = relation sp "replaces" "replaces";
    [:ok, "# Generated by ship\n"
          + line "pkgname" (Spec.name sp) + line "pkgbase" (Spec.name sp)
          + line "pkgver" (spec.full_version sp) + line "pkgdesc" (Spec.summary sp)
          + line "url" (Spec.homepage sp) + line "builddate" (to_string (Layout.epoch lay))
          + line "packager" (match Spec.maintainer sp { "" => "Unknown Packager", m => m })
          + line "size" (to_string (layout.installed_size (Layout.items lay)))
          + line "arch" (platform.pacman (Spec.arch sp))
          + line "license" (match Spec.license sp { "" => "unknown", l => l })
          + str.concat_all (list.map (fn p -> line "backup" p) (Layout.config lay))
          + needs + optional + conflicts + provides + replaces]
};

/// A script without the `#!` line it began with, which inside a function
/// would be a comment anyway, and a `:` so that an empty one is still a body.
let body : :string -> :string;
let body script = {
    let lines = str.split "\n" script;
    let kept = match lines { [first, ..rest] if str.starts_with "#!" first => rest, all => all };
    str.join_str "\n" kept + "\n:\n"
};

/// Which function each hook becomes.
let functions : [[:string, [:string]]] = [
    ["preinst", ["pre_install", "pre_upgrade"]], ["postinst", ["post_install", "post_upgrade"]],
    ["prerm", ["pre_remove"]], ["postrm", ["post_remove"]],
];

/// `.INSTALL`, or `()` when there are no scripts.
let install_script : Spec -> :string | :unit;
let install_script sp = match list.flat_map (fn [hook, names] -> match (Spec.scripts sp).[hook else ()] {
    () => [],
    script => list.map (fn n -> n + "() {\n" + body script + "}\n") names,
}) functions {
    [] => (),
    fs => "# Generated by ship from its maintainer scripts.\n\n" + str.join_str "\n" fs,
};

/// A path as mtree(5) writes it: anything but a printable character, and the
/// space, `#` and `\` that would be read as syntax, as a backslash and three
/// octal digits.
let mtree_escape : :string -> :string;
let mtree_escape path = str.concat_all (list.map (fn i -> {
    let b = str.byte i path;
    if b <= 32 || b >= 127 || b == 35 || b == 92 { "\\" + bytes.octal 3 b } else { str.slice i 1 path }
}) (list.range 0 (str.byte_length path)));

/// One mtree line for an item, by its path in the package.
let mtree_line! : :integer -> Item -> :string;
let mtree_line! epoch i = {
    let t = " time=" + to_string epoch + ".0";
    "./" + mtree_escape (match i { item.Item.dir(p, _) => str.slice 0 (str.byte_length p - 1) p, _ => item.path i }) + t
    + (match i {
        item.Item.dir(_, m) => " mode=" + bytes.octal 3 m + " type=dir",
        item.Item.link(_, target) => " mode=777 type=link link=" + mtree_escape target,
        item.Item.file(_, m, source, n) => " mode=" + bytes.octal 3 m + " size=" + to_string n + " sha256digest=" + io.digest! source,
        item.Item.text(_, m, data) => " mode=" + bytes.octal 3 m + " size=" + to_string (str.byte_length data)
                               + " sha256digest=" + io.digest data,
    })
    + "\n"
};

let mtree! : :integer -> [Item] -> :string;
let mtree! epoch items = {
    let lines = list.map (fn i -> mtree_line! epoch i) items;
    strict! lines
    "#mtree\n/set type=file uid=0 gid=0 mode=644\n" + str.concat_all lines
};

/// The files, from the root: every directory above them, and each in order.
let data_items : Layout -> [Item];
let data_items lay = {
    let items = Layout.items lay;
    let dirs = list.map (fn d -> item.Item.dir (d + "/") item.executable) (layout.dirs items);
    list.sort_on item.path (dirs + items)
};

let build! : Spec -> Layout -> compress.Compression -> :string -> :string -> :string -> [:ok, :string] | [:error, :string];
let build! sp lay c info dir dest = {
    let epoch = Layout.epoch lay;
    let data = data_items lay;
    let meta = [item.Item.text ".PKGINFO" item.regular info]
               + (match install_script sp { () => [], s => [item.Item.text ".INSTALL" item.regular s] });
    // `.MTREE` is gzip whatever the package is, because that is what pacman
    // reads it as; it is left out, not faked, where there is no gzip.
    let mtree = if compress.available! :gzip {
        let path = dir + "/.MTREE";
        file.write! path (mtree! epoch (meta + data))
        let packed = compress.file! :gzip path;
        match packed {
            [:ok, gz] => {
                io.rename! gz path
                [item.Item.file ".MTREE" item.regular path (out.size_of! path)]
            },
            _ => [],
        }
    } else { [] };
    let made = dir + "/" + file_name sp c;
    let tar_path = dir + "/pkg.tar";
    tar.file! tar_path :pax epoch (meta + mtree + data)
    let? packed = compress.file! c tar_path;
    io.rename! packed made
    let target = dest + "/" + file_name sp c;
    scratch.place! made target
    [:ok, target]
};

/// Make the package in `dest`, answering its path.
let make! : Spec -> Layout -> :string -> :any -> [:ok, :string] | [:error, :string];
let make! sp lay dest wanted = {
    let? c = compress.pick! wanted [:zstd, :xz, :gzip, :none];
    let? info = pkginfo sp lay;
    scratch.within! dest "arch" (fn dir -> build! sp lay c info dir dest)
};

when test {
    import std.test;
    import std.toml;

    let sp! () = match toml.parse ("[package]\nname = \"demo\"\nversion = \"1.0\"\n[ship]\nsummary = \"a demo\"\n"
                                   + "arch = \"x86_64\"\nlicense = \"MIT\"\n[ship.arch]\ndepends = [\"glibc\", \"libffi >= 3.4\"]\n") {
        [:ok, doc] => match spec.of_doc "." doc (%{}) (%{ "postinst" => "#!/bin/sh\necho hi\n" }) {
            [:ok, s] => s,
            other => raise! other,
        },
        other => raise! other,
    };

    let lay = Layout.make [item.Item.text "etc/demo.conf" 420 "x", item.Item.link "usr/bin/d" "demo"] ["etc/demo.conf"] 7;

    let tests = [
        test.case "the file is named as pacman names it"
            $( test.eq! "demo-1.0-1-x86_64.pkg.tar.zst" (file_name (sp! ()) :zstd) ),
        test.case ".PKGINFO"
            $( test.eq! [:ok, "# Generated by ship\npkgname = demo\npkgbase = demo\npkgver = 1.0-1\npkgdesc = a demo\n"
                              + "builddate = 7\npackager = Unknown Packager\nsize = 5\narch = x86_64\nlicense = MIT\n"
                              + "backup = etc/demo.conf\ndepend = glibc\ndepend = libffi>=3.4\n"]
                        (pkginfo (sp! ()) lay) ),
        test.case "a script becomes the functions that run at its point"
            $( test.eq! "# Generated by ship from its maintainer scripts.\n\npost_install() {\necho hi\n\n:\n}\n\npost_upgrade() {\necho hi\n\n:\n}\n"
                        (install_script (sp! ())) ),
        test.case "mtree escapes"
            $( test.eq! "a\\040b\\043c" (mtree_escape "a b#c") ),
    ];
}
