// A PKGBUILD for the AUR, the other way Arch users install things.
//
// `ship arch` makes a package pacman installs directly; this is for
// publishing one, where what is published is a recipe. Like the formula, it
// downloads a release tarball and lays it out, so it is made from the
// tarballs (`release.dr`). It is named `<name>-bin`, the AUR's convention for
// a package of prebuilt files, and provides and conflicts with `<name>`.
//
// Three files, in `aur/` under the output directory, which is what an AUR
// repository holds:
//
// - `PKGBUILD`, the recipe;
// - `.SRCINFO`, the same facts in the form the AUR reads without running
//   bash -- `makepkg --printsrcinfo` would write it, and it is written here
//   so that publishing needs no Arch machine;
// - `<name>-bin.install`, when there are maintainer scripts (`arch.dr`).

import std.file;
import std.list;
import std.result;
import std.str;

import arch;
import deps;
import item;
import layout;
import layout.Layout;
import release;
import release.Asset;
import spec;
import spec.Spec;

let package_name : Spec -> :string;
let package_name sp = Spec.name sp + "-bin";

/// A bash single-quoted word: everything as written, a `'` closed and reopened.
let quote : :string -> :string;
let quote s = "'" + str.join_str "'\\''" (str.split "'" s) + "'";

let array : [:string] -> :string;
let array xs = "(" + str.join_str " " (list.map quote xs) + ")";

/// The machines there are tarballs for, as pacman names them.
let arches : [Asset] -> [:string];
let arches assets = list.map (fn a -> if Asset.machine a == "any" { "any" } else { Asset.machine a }) assets;

/// What `package()` does: copy the tarball's contents under the prefix, and
/// move back out what was installed outside it (`/etc`), since the tarball
/// keeps that from the root.
let package_body : Spec -> Layout -> :string;
let package_body sp lay = {
    let pre = spec.prefix_path sp;
    let outside = list.unique (list.filter (fn d -> d != "") (list.map (fn i -> {
        let p = item.path i;
        if pre != "" && not (str.starts_with (pre + "/") p) { list.head (str.split "/" p) } else { "" }
    }) (Layout.items lay)));
    let into = if pre == "" { "\"$pkgdir\"" } else { "\"$pkgdir/" + pre + "\"" };
    "package() {\n  cd \"$srcdir/" + Spec.name sp + "-" + Spec.version sp + "\"\n"
    + "  install -d " + into + "\n  cp -a . " + into + "/\n"
    + str.concat_all (list.map (fn d -> "  mv \"$pkgdir/" + pre + "/" + d + "\" \"$pkgdir/" + d + "\"\n") outside)
    + "}\n"
};

let names : Spec -> :string -> [:ok, [:string]] | [:error, :string];
let names sp key = result.map (fn ds -> list.map deps.pacman ds) (deps.parse_all (spec.strings sp "arch" key));

let pkgbuild : Spec -> Layout -> [Asset] -> [:string] -> [:string] -> :bool -> :string;
let pkgbuild sp lay assets depends conflicts installs =
    "# Generated by ship. Make the tarballs again and run `ship pkgbuild` rather than editing this.\n"
    + (match Spec.maintainer sp { "" => "", m => "# Maintainer: " + m + "\n" })
    + "pkgname=" + package_name sp + "\npkgver=" + Spec.version sp + "\npkgrel=" + to_string (Spec.release sp) + "\n"
    + "pkgdesc=" + quote (Spec.summary sp) + "\narch=" + array (arches assets) + "\n"
    + (match Spec.homepage sp { "" => "", h => "url=" + quote h + "\n" })
    + "license=" + array [match Spec.license sp { "" => "unknown", l => l }] + "\n"
    + (if list.is_empty depends { "" } else { "depends=" + array depends + "\n" })
    + "provides=" + array [Spec.name sp] + "\nconflicts=" + array (Spec.name sp :: conflicts) + "\n"
    + (if list.is_empty (Layout.config lay) { "" } else { "backup=" + array (Layout.config lay) + "\n" })
    + (if installs { "install=" + package_name sp + ".install\n" } else { "" })
    + str.concat_all (list.map (fn a -> {
        let suffix = if Asset.machine a == "any" { "" } else { "_" + Asset.machine a };
        "source" + suffix + "=(" + quote (Asset.file a + "::" + Asset.url a) + ")\n"
        + "sha256sums" + suffix + "=(" + quote (Asset.sha256 a) + ")\n"
    }) assets)
    + "\n" + package_body sp lay;

let srcinfo : Spec -> Layout -> [Asset] -> [:string] -> [:string] -> :bool -> :string;
let srcinfo sp lay assets depends conflicts installs = {
    let kv = fn k v -> "\t" + k + " = " + v + "\n";
    "pkgbase = " + package_name sp + "\n"
    + kv "pkgdesc" (Spec.summary sp) + kv "pkgver" (Spec.version sp) + kv "pkgrel" (to_string (Spec.release sp))
    + (match Spec.homepage sp { "" => "", h => kv "url" h })
    + (if installs { kv "install" (package_name sp + ".install") } else { "" })
    + str.concat_all (list.map (fn a -> kv "arch" a) (arches assets))
    + kv "license" (match Spec.license sp { "" => "unknown", l => l })
    + str.concat_all (list.map (fn d -> kv "depends" d) depends)
    + kv "provides" (Spec.name sp)
    + str.concat_all (list.map (fn d -> kv "conflicts" d) (Spec.name sp :: conflicts))
    + str.concat_all (list.map (fn p -> kv "backup" p) (Layout.config lay))
    + str.concat_all (list.map (fn a -> {
        let suffix = if Asset.machine a == "any" { "" } else { "_" + Asset.machine a };
        kv ("source" + suffix) (Asset.file a + "::" + Asset.url a) + kv ("sha256sums" + suffix) (Asset.sha256 a)
    }) assets)
    + "\npkgname = " + package_name sp + "\n"
};

/// Write the AUR files into `dest/aur`, answering the PKGBUILD's path.
let make! : Spec -> Layout -> :string -> [:ok, :string] | [:error, :string];
let make! sp lay dest = {
    let? assets = release.find! sp "aur" dest;
    let linux = release.on "linux" assets;
    let? depends = names sp "depends";
    let? conflicts = names sp "conflicts";
    match linux {
        [] => [:error, "pkgbuild: no Linux tarballs of " + Spec.name sp + " in " + dest],
        _ => {
            let dir = dest + "/aur";
            file.mkdir_all! dir
            let installs = match arch.install_script sp {
                () => false,
                s => {
                    file.write! (dir + "/" + package_name sp + ".install") s
                    true
                },
            };
            file.write! (dir + "/PKGBUILD") (pkgbuild sp lay linux depends conflicts installs)
            file.write! (dir + "/.SRCINFO") (srcinfo sp lay linux depends conflicts installs)
            [:ok, dir + "/PKGBUILD"]
        },
    }
};

when test {
    import std.test;

    let tests = [
        test.case "bash quoting"
            $( test.eq! ["'a b'", "'it'\\''s'"] [quote "a b", quote "it's"] ),
        test.case "an array"
            $( test.eq! "('x86_64' 'aarch64')" (array ["x86_64", "aarch64"]) ),
    ];
}
