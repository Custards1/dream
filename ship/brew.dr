// A Homebrew formula: `brew install` on macOS, and on Linux.
//
// A formula is Ruby, and this one installs a release tarball as it is: it
// names the tarball for each system and machine there is one for, with its
// checksum, and its `install` moves the tarball's contents into the keg,
// which is laid out from a prefix just as the tarball is. Homebrew steps into
// the one directory on top by itself.
//
//     class Hello < Formula
//       desc "a greeting, packaged every way there is"
//       homepage "https://example.org/hello"
//       version "1.2.0"
//       license "MIT"
//
//       on_macos do
//         on_arm do
//           url "https://example.org/releases/v1.2.0/hello-1.2.0-macos-aarch64.tar.gz"
//           sha256 "..."
//         end
//       end
//
//       def install
//         prefix.install Dir["*"]
//       end
//
//       test do
//         assert_predicate bin/"hello", :executable?
//       end
//     end
//
// Put it in a tap -- a repository named `homebrew-<something>` with the file
// in `Formula/` -- and `brew install <user>/<something>/hello` works.
// `[ship.brew]` may say `depends` (formula names, which carry no version),
// `test` (Ruby, the body of the test block) and `caveats`.

import std.file;
import std.list;
import std.str;

import item;
import layout;
import layout.Layout;
import release;
import release.Asset;
import spec;
import spec.Spec;

/// The class a formula's file name implies: `hello-world` is `HelloWorld`,
/// and `@` is spelled `AT`, as Homebrew spells `python@3.12`'s.
let class_name : :string -> :string;
let class_name name = {
    let spelled = str.join_str "AT" (str.split "@" name);
    let words = list.filter (fn w -> w != "") (str.split "-" (str.join_str "-" (str.split "_" (str.join_str "-" (str.split "." spelled)))));
    str.concat_all (list.map (fn w -> str.upper (str.slice 0 1 w) + str.slice 1 (str.byte_length w - 1) w) words)
};

/// A Ruby string literal, with what Ruby would read inside one escaped.
let quote : :string -> :string;
let quote s = "\"" + str.join_str "\\#{" (str.split "#{" (str.join_str "\\\"" (str.split "\"" (str.join_str "\\\\" (str.split "\\" s))))) + "\"";

let fetch : :string -> Asset -> :string;
let fetch indent a = indent + "url " + quote (Asset.url a) + "\n" + indent + "sha256 " + quote (Asset.sha256 a) + "\n";

/// The tarballs, in `on_macos`/`on_linux` and `on_arm`/`on_intel` blocks; one
/// that runs anywhere is named once, outside them.
let sources : [Asset] -> :string;
let sources assets = match assets {
    [one] if Asset.machine one == "any" => fetch "  " one,
    _ => str.concat_all (list.map (fn os -> match list.filter (fn a -> Asset.os a == os) assets {
        [] => "",
        here => "  on_" + os + " do\n"
                + str.concat_all (list.map (fn a -> "    on_" + (if Asset.machine a == "aarch64" { "arm" } else { "intel" })
                                                    + " do\n" + fetch "      " a + "    end\n") here)
                + "  end\n",
    }) ["macos", "linux"]),
};

/// What `brew test` runs: the manifest's, or that each program is there and
/// can be run.
let test_body : Spec -> Layout -> :string;
let test_body sp lay = match spec.text sp "brew" "test" "" {
    "" => match list.filter (fn i -> match i { [:file, p, m, _, _] => str.starts_with "bin/" (layout.relative sp p) && m % 2 == 1, _ => false })
                             (Layout.items lay) {
        [] => "    assert_predicate prefix, :exist?\n",
        programs => str.concat_all (list.map (fn i -> "    assert_predicate bin/" + quote (list.last (str.split "/" (item.path i)))
                                                     + ", :executable?\n") programs),
    },
    body => str.concat_all (list.map (fn l -> "    " + l + "\n") (str.split "\n" (str.trim_end body))),
};

let formula : Spec -> Layout -> [Asset] -> :string;
let formula sp lay assets = {
    let depends = str.concat_all (list.map (fn d -> "  depends_on " + quote d + "\n") (spec.strings sp "brew" "depends"));
    let caveats = match spec.text sp "brew" "caveats" "" {
        "" => "",
        c => "\n  def caveats\n    <<~EOS\n" + str.concat_all (list.map (fn l -> "      " + l + "\n") (str.split "\n" (str.trim_end c)))
             + "    EOS\n  end\n",
    };
    "# Generated by ship. Make the tarballs again and run `ship brew` rather than editing this.\n"
    + "class " + class_name (Spec.name sp) + " < Formula\n"
    + "  desc " + quote (Spec.summary sp) + "\n"
    + (match Spec.homepage sp { "" => "", h => "  homepage " + quote h + "\n" })
    + "  version " + quote (Spec.version sp) + "\n"
    + (match Spec.license sp { "" => "", l => "  license " + quote l + "\n" })
    + "\n" + sources assets
    + (if str.is_empty depends { "" } else { "\n" + depends })
    + "\n  def install\n    prefix.install Dir[\"*\"]\n  end\n"
    + caveats
    + "\n  test do\n" + test_body sp lay + "  end\nend\n"
};

/// Write the formula into `dest`, answering its path.
let make! : Spec -> Layout -> :string -> [:ok, :string] | [:error, :string];
let make! sp lay dest = {
    let? assets = release.find! sp "brew" dest;
    let path = dest + "/" + Spec.name sp + ".rb";
    file.write! path (formula sp lay assets)
    [:ok, path]
};

when test {
    import std.test;

    let tests = [
        test.case "class names"
            $( test.eq! ["Hello", "HelloWorld", "PythonAT312", "LibfooBar"]
                        (list.map class_name ["hello", "hello-world", "python@3.12", "libfoo_bar"]) ),
        test.case "Ruby strings"
            $( test.eq! "\"a \\\"b\\\" \\\\ \\#{c}\"" (quote "a \"b\" \\ #{c}") ),
        test.case "one source for a package that runs anywhere"
            $( test.eq! "  url \"u\"\n  sha256 \"s\"\n" (sources [Asset.make "any" "any" "f" "u" "s"]) ),
        test.case "a block for each system and machine"
            $( test.eq! "  on_macos do\n    on_arm do\n      url \"m\"\n      sha256 \"1\"\n    end\n  end\n  on_linux do\n    on_intel do\n      url \"l\"\n      sha256 \"2\"\n    end\n  end\n"
                        (sources [Asset.make "macos" "aarch64" "f" "m" "1", Asset.make "linux" "x86_64" "f" "l" "2"]) ),
    ];
}
