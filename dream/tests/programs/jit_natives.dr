// Compiled code calling a host native.
//
// The tier used to refuse any function containing a call it could not write out
// itself, which was every call to `std.native` but five numeric ones -- so a
// loop that reads a byte, walks a list or asks two values which is larger was
// not compiled at all, however hot it got. Such a call is now made the way the
// interpreter makes one: same callee, same arguments on the same stack, same
// native. `native_site` in dream/src/jit.cpp is the rule and `run_native` in
// dream/src/jit_rt.cpp is the call.
//
// `std.native` rather than `std.core` throughout, because they are not the same
// question. `std.core` is Dream, and five of its members -- `head`, `map_get`,
// `map_put`, `array_get`, `array_set` -- are written as the language's own
// `c.[k]`, which is an opcode and not a call at all. The rest of it is wrappers
// the compiler rewrites into exactly the `native.` calls below, so this is the
// spelling that says what is being tested.
//
// Everything here runs under both tiers and the two must agree, which is the
// only check that matters. What is being asserted, case by case:
//
//   * a loop whose body is a native call gets the answer it always got;
//   * a *carried* parameter -- one every self call hands straight back -- is
//     moved and not forced, so a loop may carry something whose evaluation
//     would raise and never raise, exactly as the interpreter leaves it;
//   * an argument in a position the native does not force is not evaluated;
//   * a native that hands back what it found unforced, and one that raises,
//     both answer what they answer under the interpreter;
//   * and the three things the tier has to decline -- an impure native, a lazy
//     argument that is not safe to evaluate, and a parameter nothing forces --
//     still run, and still say what they always said.
//
// The loops are all long enough to get past the JIT's threshold, because a case
// that is never compiled tests nothing here.

import std.console;
import std.math;
import std.native;

// --- a loop whose body is one native call ----------------------------------
//
// `s` is the shape the whole thing is for: a parameter the loop carries and
// reads only on the path that keeps going. Nothing forces it in the base case,
// so the strictness rule the tier rests on cannot prove it strict -- and does
// not have to, because every self call hands it straight back.
let rec sum_bytes s i n acc =
    if i >= n { acc } else { sum_bytes s (i + 1) n (acc + native.str_byte s i) };

// A list walked through the two natives that walk one. Both parameters are
// forced on every path here, so this is the shape the tier always could have
// taken and never did, for want of being allowed to make the call.
let rec spine xs acc = if native.is_empty xs { acc } else { spine (native.tail xs) (acc + 1) };

// --- a carried parameter is moved, not forced ------------------------------
//
// `x` is never looked at. Under the interpreter its argument is suspended and
// stays that way, so the division never happens; compiled code must do the same
// rather than evaluate it on the way into the loop.
let rec ignoring x i n acc = if i >= n { acc } else { ignoring x (i + 1) n (acc + 1) };

// Carried *and* read, but only on the path that iterates. Called with a count
// of zero once the function is hot: the loop stops before it looks at `s`, so a
// tier that forced its parameters on entry would raise where nothing should.
let rec first_byte s i n acc =
    if i >= n { acc } else { first_byte s (i + 1) n (acc + native.str_byte s i) };

// --- the containers --------------------------------------------------------
//
// `map_get` is the native that hands back what it found without forcing it,
// which the machine forces as the continuation of the call. Its third argument
// is the default and the mask leaves it lazy, so what goes there is read rather
// than evaluated -- here a literal, and below a carried parameter.
let rec map_sum m i n acc =
    if i >= n { acc } else { map_sum m (i + 1) n (acc + native.map_get m i 0) };

let rec map_or m d i n acc =
    if i >= n { acc } else { map_or m d (i + 1) n (acc + native.map_get m i d) };

let rec array_sum a i n acc =
    if i >= n { acc } else { array_sum a (i + 1) n (acc + native.array_get a i) };

// --- the builtins, which are natives of the other shape --------------------
//
// `len` and `to_string` are immediates carrying an index into a static table
// rather than members of a module, and `to_string` is the one here that runs
// Dream work underneath itself.
let rec lens xs i n acc = if i >= n { acc } else { lens xs (i + 1) n (acc + len xs) };
let rec shown v i n acc =
    if i >= n { acc } else { shown v (i + 1) n (acc + len (to_string v)) };

// --- ordering, which is a native over anything -----------------------------
let rec ranks xs i n acc =
    if i >= n { acc } else { ranks xs (i + 1) n (acc + native.compare i n) };

// --- the numeric natives the tier writes out rather than calling -----------
let rec roots i n acc =
    if i >= n { acc } else { roots (i + 1) n (acc + math.sqrt (native.to_float i)) };

// --- what must be declined -------------------------------------------------
//
// An impure native is refused outright: a compiled body is entered and left in
// one piece, and nothing here orders an effect against anything. The loop still
// runs, and writes exactly one dot per iteration.
let rec dots! i n = if i >= n { () } else { console.write! "."; dots! (i + 1) n };

// A lazy argument that is not safe to evaluate refuses the function. The key is
// there, so the interpreter never looks at the default; if the tier took this
// call and evaluated it, the loop would raise instead of answering.
let rec defaults m i n acc =
    if i >= n { acc } else { defaults m (i + 1) n (acc + native.map_get m 3 (1 / 0)) };

// A parameter nothing forces and no call carries: `i` is looked at only where
// the list runs out, and every self call *computes* a new one, so evaluating it
// eagerly is work the interpreter might never do. Declined, and the answer is
// the one it always gave.
let rec index_from i x xs =
    if native.is_empty xs { 0 - 1 }
    else if native.head xs == x { i }
    else { index_from (i + 1) x (native.tail xs) };

// A list builder, whose accumulator is neither forced nor carried -- `cons`
// leaves both its arguments alone. Declined, and still a list.
let rec upto i n acc = if i > n { acc } else { upto (i + 1) n (native.cons i acc) };

let show! name v = console.print! (name + " = " + to_string (try! { strict! v } catch e { e }));

let main! = {
    let text = "the quick brown fox jumps over the lazy dog";
    let m = native.map_put (native.map_put (native.map_new ()) 3 70) 7 900;
    let a = native.array_new 64 5;
    let long = upto 1 20000 [];

    show! "sum_bytes"  (sum_bytes text 0 (len text) 0);
    show! "spine"      (spine long 0);
    show! "ignoring"   (ignoring (1 / 0) 0 20000 0);
    // Hot first, then the call that must not force what it carries.
    show! "warm"       (first_byte text 0 (len text) 0);
    show! "cold"       (first_byte (1 / 0) 0 0 77);
    show! "map_sum"    (map_sum m 0 20000 0);
    show! "map_or"     (map_or m 1 0 20000 0);
    show! "array_sum"  (array_sum a 0 64 0);
    // Past the end, so the native raises -- with everything before it done.
    show! "past_end"   (array_sum a 0 200 0);
    show! "lens"       (lens text 0 20000 0);
    show! "shown"      (shown 12345 0 20000 0);
    show! "ranks"      (ranks text 0 20000 0);
    show! "roots"      (roots 1 20000 0.0);
    show! "defaults"   (defaults m 0 20000 0);
    show! "index_from" (index_from 0 0 long);
    show! "upto"       (len long);
    dots! 0 40;
    console.print! "";
};
