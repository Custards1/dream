// Laziness is observable: each of these would raise if the VM evaluated more
// than it had to.
import std.console;
let boom n = 1 / 0;

let main! = {
    // An unused binding is never forced.
    let unused = boom 1;
    console.print! "unused binding: " :never_forced

    // `if` enters one branch only.
    let picked = if true { :taken } else { boom 2 };
    console.print! "if branch:     " picked

    // `&&` and `||` short-circuit.
    console.print! "short circuit: " (false && (boom 3) == 1)
    console.print! "short circuit: " (true || (boom 4) == 1)

    // List elements stay unevaluated: `len` walks the spine, not the values.
    console.print! "lazy elements: " (len [boom 5, boom 6, boom 7])

    // A map's values are lazy too, though its keys are forced to be hashed.
    console.print! "lazy map:      " (len %{ :a => boom 8, :b => boom 9 })
}
