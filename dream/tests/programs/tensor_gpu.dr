// Tensors on the GPU agree with the host.
//
// Every line prints `true` whether or not this machine has a GPU: with one,
// each operation runs there and is compared with the same operation on the
// host; without one, there is nothing to compare and the check passes. A GPU
// holds float32, so agreement is to a relative tolerance, not to the bit.
// The CI machine runs these through POCL, OpenCL on the CPU.
import std.console;
import std.tensor;

let have = tensor.gpu_available ();

/// The host answer `h` and the GPU answer `g`, within float32's precision.
let close : :tensor -> :tensor -> :bool;
let close h g = {
    let diff = tensor.maximum (tensor.abs (h - tensor.host g));
    let scale = tensor.maximum (tensor.abs h) + 1.0;
    tensor.shape h == tensor.shape g && diff <= 1.0e-5 * scale
};

/// `f` on the host and on the GPU, compared.
let agree : (:tensor -> :tensor) -> :tensor -> :bool;
let agree f x = not have || close (f x) (f (tensor.gpu x));

let agree2 : (:tensor -> :tensor -> :tensor) -> :tensor -> :tensor -> :bool;
let agree2 f x y = not have || close (f x y) (f (tensor.gpu x) (tensor.gpu y));

let near : :float -> :float -> :bool;
let near a b = a - b <= 1.0e-4 * (a + 1.0) && b - a <= 1.0e-4 * (a + 1.0);

let main! = {
    let a = tensor.random 1 [37, 53] - 0.5;
    let b = tensor.random 2 [53, 29] - 0.5;
    let c = tensor.random 3 [37, 53];
    let v = tensor.random 4 [53];
    let w = tensor.random 5 [37];

    console.print! (agree2 (fn x y -> x @ y) a b)
    console.print! (agree2 (fn x y -> x @ y) a v)
    console.print! (agree2 (fn x y -> x @ y) w a)
    console.print! (agree2 (fn x y -> x + y) a c)
    console.print! (agree2 (fn x y -> x - y) a c)
    console.print! (agree2 (fn x y -> x * y) a c)
    console.print! (agree2 (fn x y -> x / (y + 1.0)) a c)
    console.print! (agree2 (fn x y -> x + y) a v)
    console.print! (agree (fn x -> 3.0 * x - 1.0) a)
    console.print! (agree (fn x -> 1.0 / (x + 2.0)) a)
    console.print! (agree (fn x -> -x) a)
    console.print! (agree (fn x -> tensor.transpose x) a)
    console.print! (agree (fn x -> tensor.relu x) a)
    console.print! (agree (fn x -> tensor.sigmoid x) a)
    console.print! (agree (fn x -> tensor.tanh x) a)
    console.print! (agree (fn x -> tensor.exp x) a)
    console.print! (agree (fn x -> tensor.reshape [53, 37] x) a)
    console.print! (agree (fn x -> tensor.sum_axis 0 x) a)
    console.print! (agree (fn x -> x.[3]) a)
    console.print! (agree2 (fn x y -> tensor.outer x y) v w)
    console.print! (agree2 (fn x y -> tensor.relu (x @ y + 1.0)) a b)
    console.print! (agree2 (fn x y -> tensor.sigmoid (x @ y) * 2.0 - x @ y) a v)
    console.print! (agree2 (fn x y -> tensor.reshape [29, 37] (tensor.transpose (x @ y) * 3.0)) a b)
    console.print! (agree2 (fn x y -> tensor.transpose x + y) a (tensor.transpose c))
    console.print! (agree2 (fn x y -> x @ tensor.transpose y) a c)
    console.print! (agree2 (fn x y -> tensor.relu (tensor.transpose x @ y + 0.5)) c a)
    console.print! (agree2 (fn x y -> tensor.transpose y @ x) w a)
    console.print! (not have || near (tensor.sum c) (tensor.sum (tensor.gpu c)))
    console.print! (not have || near (tensor.maximum c) (tensor.maximum (tensor.gpu c)))
    console.print! (not have || near (tensor.minimum c) (tensor.minimum (tensor.gpu c)))
    console.print! (not have || near (v @ v) (tensor.gpu v @ tensor.gpu v))
    console.print! (not have || tensor.device (tensor.gpu a @ tensor.gpu b) == :gpu)
    console.print! (not have || tensor.to_list (tensor.gpu [[1, 2], [3, 4]]) == [[1.0, 2.0], [3.0, 4.0]])
};
