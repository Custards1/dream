// dre's machine: an image's functions compiled into closures of the language dre itself is
// written in, and run.
//
// The program's values are this program's values. An integer, a string, a list, a map, a
// record, an error and a process are each the thing itself, so a builtin or a native given one
// is the builtin or native the VM running dre has, and `spawn!`, `send!`, `try!` and the
// collector come with them. A function of the image is a function here too: an arity's worth of
// parameters around its compiled body, so a native that takes a function -- `spawn!` above all,
// whose argument is a thunk, which is a function of no arguments -- is given something it can
// call. What dre adds is only what an image says and a value does not: frames, captures,
// globals, and which statements must run, and in what order.
//
// A node becomes a `Code`, a function from the frame it runs in to its value. Nothing is
// interpreted at run time but those closures: the tree is walked once, here, and each node's
// operands are found then rather than every time it runs.
//
// What must happen in order is written as a statement of an impure block, here as in the
// image: a statement is forced where it stands, and that is what the image's STRICT flag asks.
// A value that is only computed is left to the language's own laziness, which is the image's.
//
// What is shared, and what is not. The compiled program -- every function's closures, the
// image, the tables -- is made once and never changes, and a process started by `spawn!`
// copies what its work can reach, which through any closure of it was all of it. So the whole
// program is compiled when it is loaded and moved where every process reads it and none copies
// it (`vm.share!`). What changes is each process's own: a frame, a function value made while
// running, and the program's top-level values, which are made when first read and live in a
// table of them per process, its `world`. A process finds its own with `vm.per_process`, as the
// VM finds a process's globals, rather than by the frame it is running in: carried in frames,
// the table went wherever a suspension did, so a process `spawn!` started was handed a copy of
// every top-level value its parent had worked out (`census` copied the 1000-element `table`
// into each of 80,000 processes), and a value one of them answered was worked out again by
// whoever forced it, in the world it was made in (`caf_race`, once for each of 64 answers).
//
// For that to be possible nothing the compiled program holds may be a suspension: a shared
// value is one every process reads and none may update. So every closure made here is made by a
// builder whose parameters are strict, `!x`, and a list a closure keeps is settled before it is
// kept. Something left suspended would be refused, loudly, when the program is shared.

import std.array;
import std.builtins;
import std.char;
import std.error;
import std.lazy;
import std.list;
import std.map;
import std.num;
import std.str;
import std.vm;

import dreams.aot.image;
import dreams.builtins as compiler_builtins;

/// What a node computes, given the frame it runs in.
type Code = Frame -> :any;

/// A running function's slots -- its parameters first, then what its blocks bind -- and the
/// values it captured where it was made.
group Frame { slots : :array, caps : :array }

/// A node's flags (dream/docs/bytecode-format.md).
let flag_strict : :integer;
let flag_strict = 1;
let flag_impure : :integer;
let flag_impure = 2;

/// A function's flags.
let fn_impure : :integer;
let fn_impure = 1;
let fn_global_value : :integer;
let fn_global_value = 8;

/// A global's kinds.
let global_function : :integer;
let global_function = 0;

/// A capture descriptor whose top bit is set names a capture of the parent, not a slot.
let capture_of_parent : :integer;
let capture_of_parent = 2147483648;

/// The atom index in `record_make`'s `c`, whose top bit says the record is a variant.
let variant_bit : :integer;
let variant_bit = 2147483648;

/// One function of the image, as it runs here: what it is, and its body compiled. `pad` is the
/// slots after the parameters, empty, made once: a frame is the arguments in front of it.
group Compiled {
    arity : :integer,
    impure : :bool,
    slots : :integer,
    captures : [:integer],
    pad : [:any],
    body : Code,
}

/// A loaded image and everything dre made of it, all of it shared.
group Program {
    img : image.Image,
    atoms : :array,
    funcs : :array,
    builtins : :array,
    natives : :map,
    /// For each node, whether it may perform an effect (`effects_of`).
    effects : :array,
    /// The path of each module `natives` holds, by how the module is written (`<module math>`):
    /// what a `field` of a module that is a value -- `let m = math; m.abs 1` -- looks its members
    /// up under. By the text and not the module, because a module is a key by its identity, and
    /// the shared copy of the table is not the table the program was handed its modules from.
    module_paths : :map,
    /// The globals that are values -- a pure binding of no parameters -- as the functions that
    /// compute them, in the order of their places in a world (`world_of`).
    values : [:integer],
    /// Each of those globals' place in a world, by the global's index.
    places : :map,
    /// What `vm.per_process` knows this program's worlds by: a key no other program loaded
    /// in this VM has.
    serial : :integer,
    /// For each node, the function of the image it is written in (`owners_of`).
    owners : :array,
}

/// `x` forced all the way down, and answered: what a closure keeps of a list or a table.
let settled : :any -> :any;
let settled x = if lazy.settled x { x } else { () };

/// `x`, evaluated as far as its outermost constructor, by a strict parameter.
let whnf : :any -> :any;
let whnf !x = x;

/// The image's atom `i` as an atom of this program.
let atom_of : Program -> :integer -> :atom;
let atom_of prog i = (Program.atoms prog).[i];

/// An image read to be run, compiled whole and shared. `builtins` and `natives` are what its
/// `builtin` nodes and its host modules' members are: the VM's own, with whatever the caller
/// replaced (dre's arguments, the image's payload).
let load! : image.Image -> :array -> :map -> Program;
let load! img table natives = {
    // Every name the image writes as an atom, made an atom here: what the VM does when it
    // loads one, and the only thing a program cannot do for itself.
    let atoms = array.of_list (list.forced (list.map (fn! i -> vm.intern_atom! (image.atom img i)) (list.range 0 (image.count img "KATM"))));
    let rec prog = Program.make img atoms
        (array.of_list (list.map (fn i -> compile_function prog i) (list.range 0 (image.count img "FUNC"))))
        table natives (effects_of img)
        (list.fold (fn m [path, v] -> if type_of v == :module { m.[to_string v => path] } else { m }) %{} (map.pairs natives))
        (list.map (fn i -> image.Global.target (image.global img i)) (value_globals img))
        (world_places img) (vm.unique! ()) (owners_of img);
    // Sharing forces it all the way down, which is every function compiled.
    vm.share! prog
};

// --- where an error was raised ---------------------------------------------------------
//
// The machine running dre writes on an error where it was raised, from the functions it is
// running, and those are dre's: every error an image raised was "in `main!` (run.dr)". So
// an image's `raise!` is written here (`raise_at_code`), with the image function it is
// written in, and the machine, finding the place already on the error, keeps it. Only that
// function: dre keeps no stack of the image's calls, which would be something made on every
// call to be read on the rare one that fails. And only `raise!`: an error a builtin raises --
// a failed `match`, a division by zero -- still says it was in dre.

/// For each node of the image, the function whose body it is in, or -1. A closure's body is
/// a function of its own, and is not walked into from the one that makes it.
let owners_of : image.Image -> :array;
let owners_of img = {
    let owned = list.fold (fn m f -> owned_from img f [image.Func.body (image.func img f)] m) %{}
        (list.range 0 (image.count img "FUNC"));
    array.of_list (list.map (fn i -> owned.[i else -1]) (list.range 0 (image.count img "NODE")))
};

let owned_from : image.Image -> :integer -> [:integer] -> :map -> :map;
let owned_from img f work !m = match work {
    [] => m,
    [i, ..rest] => if i == image.no_node || map.has i m { owned_from img f rest m }
        else { owned_from img f (list.append (node_children img (image.node img i)) rest) m.[i => f] },
};

/// Where node `i` is, as `error.trace!` says a place: ``[:in, name, path, line, col]``.
let place_of : Program -> :integer -> [:any];
let place_of prog i = {
    let img = Program.img prog;
    let f = (Program.owners prog).[i];
    if f < 0 { [:in, "?", "", 0, 0] }
    else { [:in, image.string img (image.Func.name (image.func img f)), image.func_source img f, image.func_line img f, image.func_col img f] }
};

/// `raise! x`, written where it is: `x` made an error as `raise!` makes one, and placed at
/// `place` unless it already says where it was raised, as one raised again does.
let raise_at_code : Code -> [:any] -> Code;
let raise_at_code !x !place = fn! fr -> raise! (placed! (x fr) place);

let placed! : :any -> [:any] -> :error;
let placed! v place = {
    let e = if error.is_error v { v } else { error.new :error v };
    if list.is_empty (error.trace! e) { vm.raised_at e [place] } else { e }
};

// --- functions ---------------------------------------------------------------------------

let compile_function : Program -> :integer -> Compiled;
let compile_function prog i = {
    let img = Program.img prog;
    let f = image.func img i;
    let arity = image.Func.arity f;
    let slots = image.Func.slots f;
    // Impure as the VM decides a callee is: by its name's `!`, or by a body that performs an
    // effect -- a lambda has no name, and one written before `fn!` existed was marked so.
    let body = image.Func.body f;
    Compiled.make arity (image.Func.flags f & fn_impure != 0 || image.Node.flags (image.node img body) & flag_impure != 0) slots
        (image.kids img (image.func_captures_at img i) (image.Func.captures f))
        (list.replicate (if slots > arity { slots - arity } else { 0 }) ())
        (compile prog (image.Func.body f))
};

let function_of : Program -> :integer -> Compiled;
let function_of prog f = (Program.funcs prog).[f];

/// `c` run with `args`, its parameters with its other slots after them.
let invoke : Compiled -> [:any] -> :array -> :any;
let invoke c args caps = (Compiled.body c) (Frame.make (array.of_list args) caps);

/// Function `c` as a value: a function of this language of the same arity, which runs the
/// compiled body. A thunk is the arity-0 case. Past seven parameters it is curried, which is
/// the same function to anyone who applies it. An impure function is an impure one here,
/// because `type_of` says which, and a program may ask.
let function_value : Compiled -> :array -> :any;
let function_value c caps = {
    let pad = Compiled.pad c;
    if Compiled.impure c { impure_value c caps } else { match Compiled.arity c {
        0 => $( invoke c pad caps ),
        1 => fn a -> invoke c (a :: pad) caps,
        2 => fn a b -> invoke c (a :: b :: pad) caps,
        3 => fn a b d -> invoke c (a :: b :: d :: pad) caps,
        4 => fn a b d e -> invoke c (a :: b :: d :: e :: pad) caps,
        5 => fn a b d e g -> invoke c (a :: b :: d :: e :: g :: pad) caps,
        6 => fn a b d e g h -> invoke c (a :: b :: d :: e :: g :: h :: pad) caps,
        7 => fn a b d e g h k -> invoke c (a :: b :: d :: e :: g :: h :: k :: pad) caps,
        n => curried c caps n [],
    } }
};

let impure_value : Compiled -> :array -> :any;
let impure_value c caps = {
    let pad = Compiled.pad c;
    match Compiled.arity c {
        // A thunk is a thunk, impure body or not, as the VM makes one.
        0 => $( invoke c pad caps ),
        1 => fn! a -> invoke c (a :: pad) caps,
        2 => fn! a b -> invoke c (a :: b :: pad) caps,
        3 => fn! a b d -> invoke c (a :: b :: d :: pad) caps,
        4 => fn! a b d e -> invoke c (a :: b :: d :: e :: pad) caps,
        5 => fn! a b d e g -> invoke c (a :: b :: d :: e :: g :: pad) caps,
        6 => fn! a b d e g h -> invoke c (a :: b :: d :: e :: g :: h :: pad) caps,
        7 => fn! a b d e g h k -> invoke c (a :: b :: d :: e :: g :: h :: k :: pad) caps,
        n => curried c caps n [],
    }
};

let curried : Compiled -> :array -> :integer -> [:any] -> :any;
let curried c caps left got = if left == 0 { invoke c (list.append (list.reverse got) (Compiled.pad c)) caps }
    else { fn a -> curried c caps (left - 1) (list.cons a got) };

/// This process's top-level values: for each global that is a value -- a pure binding of no
/// parameters -- its body's value, made the first time it is read. Every other global is
/// nothing here: a function is made where it is named, and an impure binding of no parameters is
/// an action, run each time it is named. Made the first time the process reads a value, so a
/// process that reads none -- most that `spawn!` starts -- makes none.
let world : Program -> :array;
let world prog = vm.per_process (Program.serial prog) (world_of prog);

let world_of : Program -> :array;
let world_of prog = array.of_list (list.map (fn f ->
    invoke (function_of prog f) (Compiled.pad (function_of prog f)) #[]) (Program.values prog));

/// The globals of `img` that are values, in the order of their places in a world.
let value_globals : image.Image -> [:integer];
let value_globals img = list.filter (fn i -> {
    let g = image.global img i;
    image.Global.kind g == global_function && is_value (image.func img (image.Global.target g))
}) (list.range 0 (image.count img "GLBL"));

/// Each value global's place in a world, by its index.
let world_places : image.Image -> :map;
let world_places img = list.fold (fn m [place, i] -> m.[i => place]) %{} (list.enumerate (value_globals img));

let is_value : image.Func -> :bool;
let is_value f = image.Func.arity f == 0 && (image.Func.flags f & fn_impure == 0 || image.Func.flags f & fn_global_value != 0);

let is_action : image.Func -> :bool;
let is_action f = image.Func.arity f == 0 && image.Func.flags f & fn_impure != 0 && image.Func.flags f & fn_global_value == 0;

/// A module as a value: one the VM provides is the VM's own, which `natives` holds by its
/// path. Another is a module of the image, which nothing but `field` asks for, and that is
/// resolved where it is written.
let module_value : Program -> :string -> :any;
let module_value prog path = (Program.natives prog).[path else [:module, path]];

// --- builders ----------------------------------------------------------------------------
//
// Each closure the compiler makes, made by a function whose parameters are strict, so that
// what it captures is a value and the program can be shared.

let constant : :any -> Code;
let constant !v = fn fr -> v;

let local_code : :integer -> Code;
let local_code !i = fn fr -> (Frame.slots fr).[i];

let capture_code : :integer -> Code;
let capture_code !i = fn fr -> (Frame.caps fr).[i];

let world_code : Program -> :integer -> Code;
let world_code !prog !i = fn fr -> (world prog).[i];

let if_code : :bool -> Code -> Code -> Code -> Code;
let if_code !eff !c !y !n = if eff { fn! fr -> if c fr { y fr } else { n fr } } else { fn fr -> if c fr { y fr } else { n fr } };

let force_code : :bool -> Code -> Code;
let force_code !eff !e = if eff { fn! fr -> whnf (e fr) } else { fn fr -> whnf (e fr) };

// Each operator written into its own closure rather than passed to one: a chain of suspended
// sums is forced a level at a time, and a call eff in between was a frame more on every level.
let add_code : :bool -> Code -> Code -> Code;
let add_code !eff !x !y = if eff { fn! fr -> x fr + y fr } else { fn fr -> x fr + y fr };
let sub_code : :bool -> Code -> Code -> Code;
let sub_code !eff !x !y = if eff { fn! fr -> x fr - y fr } else { fn fr -> x fr - y fr };
let mul_code : :bool -> Code -> Code -> Code;
let mul_code !eff !x !y = if eff { fn! fr -> x fr * y fr } else { fn fr -> x fr * y fr };
let div_code : :bool -> Code -> Code -> Code;
let div_code !eff !x !y = if eff { fn! fr -> x fr / y fr } else { fn fr -> x fr / y fr };
let mod_code : :bool -> Code -> Code -> Code;
let mod_code !eff !x !y = if eff { fn! fr -> x fr % y fr } else { fn fr -> x fr % y fr };
let eq_code : :bool -> Code -> Code -> Code;
let eq_code !eff !x !y = if eff { fn! fr -> x fr == y fr } else { fn fr -> x fr == y fr };
let ne_code : :bool -> Code -> Code -> Code;
let ne_code !eff !x !y = if eff { fn! fr -> x fr != y fr } else { fn fr -> x fr != y fr };
let lt_code : :bool -> Code -> Code -> Code;
let lt_code !eff !x !y = if eff { fn! fr -> x fr < y fr } else { fn fr -> x fr < y fr };
let le_code : :bool -> Code -> Code -> Code;
let le_code !eff !x !y = if eff { fn! fr -> x fr <= y fr } else { fn fr -> x fr <= y fr };
let gt_code : :bool -> Code -> Code -> Code;
let gt_code !eff !x !y = if eff { fn! fr -> x fr > y fr } else { fn fr -> x fr > y fr };
let ge_code : :bool -> Code -> Code -> Code;
let ge_code !eff !x !y = if eff { fn! fr -> x fr >= y fr } else { fn fr -> x fr >= y fr };
let and_code : :bool -> Code -> Code -> Code;
let and_code !eff !x !y = if eff { fn! fr -> x fr && y fr } else { fn fr -> x fr && y fr };
let or_code : :bool -> Code -> Code -> Code;
let or_code !eff !x !y = if eff { fn! fr -> x fr || y fr } else { fn fr -> x fr || y fr };
let band_code : :bool -> Code -> Code -> Code;
let band_code !eff !x !y = if eff { fn! fr -> x fr & y fr } else { fn fr -> x fr & y fr };
let bor_code : :bool -> Code -> Code -> Code;
let bor_code !eff !x !y = if eff { fn! fr -> x fr | y fr } else { fn fr -> x fr | y fr };
let bxor_code : :bool -> Code -> Code -> Code;
let bxor_code !eff !x !y = if eff { fn! fr -> x fr ^ y fr } else { fn fr -> x fr ^ y fr };
let shl_code : :bool -> Code -> Code -> Code;
let shl_code !eff !x !y = if eff { fn! fr -> x fr << y fr } else { fn fr -> x fr << y fr };
let shr_code : :bool -> Code -> Code -> Code;
let shr_code !eff !x !y = if eff { fn! fr -> x fr >> y fr } else { fn fr -> x fr >> y fr };
let neg_code : :bool -> Code -> Code;
let neg_code !eff !x = if eff { fn! fr -> 0 - x fr } else { fn fr -> 0 - x fr };
let not_code : :bool -> Code -> Code;
let not_code !eff !x = if eff { fn! fr -> not (x fr) } else { fn fr -> not (x fr) };
let bnot_code : :bool -> Code -> Code;
let bnot_code !eff !x = if eff { fn! fr -> ~ (x fr) } else { fn fr -> ~ (x fr) };

let list_code : :bool -> [Code] -> Code;
let list_code eff !items = list_built eff (settled items);
let list_built : :bool -> [Code] -> Code;
let list_built !eff !items = if eff { fn! fr -> list.map (fn e -> e fr) items } else { fn fr -> list.map (fn e -> e fr) items };

let array_code : :bool -> [Code] -> Code;
let array_code eff !items = array_built eff (settled items);
let array_built : :bool -> [Code] -> Code;
let array_built !eff !items = if eff { fn! fr -> array.of_list (list.map (fn e -> e fr) items) } else { fn fr -> array.of_list (list.map (fn e -> e fr) items) };

let map_code : :bool -> [Code] -> Code;
let map_code eff !kvs = map_built eff (settled kvs);
let map_built : :bool -> [Code] -> Code;
let map_built !eff !kvs = if eff { fn! fr -> pairs_into %{} kvs fr } else { fn fr -> pairs_into %{} kvs fr };

let pairs_into : :map -> [Code] -> Frame -> :map;
let pairs_into m kvs fr = match kvs {
    [k, v, ..rest] => pairs_into m.[k fr => v fr] rest fr,
    _ => m,
};

let get_code : :bool -> Code -> Code -> Code;
let get_code !eff !container !key = if eff { fn! fr -> (container fr).[key fr] } else { fn fr -> (container fr).[key fr] };
let get_else_code : :bool -> Code -> Code -> Code -> Code;
let get_else_code !eff !container !key !fallback = if eff { fn! fr -> (container fr).[key fr else fallback fr] } else { fn fr -> (container fr).[key fr else fallback fr] };
let set_code : :bool -> Code -> Code -> Code -> Code;
let set_code !eff !container !key !v = if eff { fn! fr -> (container fr).[key fr => v fr] } else { fn fr -> (container fr).[key fr => v fr] };

// --- nodes -------------------------------------------------------------------------------

/// Node `i`, compiled.
let compile : Program -> :integer -> Code;
let compile prog i = compile_node prog i (image.node (Program.img prog) i) (Program.effects prog).[i];

// --- what may perform an effect ----------------------------------------------------------
//
// A node's code is `fn!` when the node may perform an effect, and `fn` when it cannot: what
// the image says of it (its IMPURE flag, which the compiler sets on a node with an effect
// anywhere under it), and one thing more. An application of a function nobody knows until it
// runs may perform an effect whatever the image says: `list.fold` is pure, and the function it
// is handed need not be. Only a builtin or a member of the VM's own modules whose name has no
// `!` is known not to. And a node holding one is one, because its code suspends the child's:
// compiled code that parks is run again from the top, and makes its suspensions again, so a
// pure closure may only ever suspend what cannot perform an effect.

/// For each node of the image, whether it may perform an effect.
let effects_of : image.Image -> :array;
let effects_of img = {
    let able = capable img;
    let rec table = array.of_list (list.map (fn i -> node_effect img able table i) (list.range 0 (image.count img "NODE")));
    table
};

/// For each function, whether calling it may perform an effect: it is impure, it applies a
/// function nobody knows until it runs, or it calls one that may. The last is a fixpoint over
/// the calls functions make by name, from "no" up, since a function may call itself.
let capable : image.Image -> :array;
let capable img = {
    let fs = list.range 0 (image.count img "FUNC");
    let facts = list.map (fn f -> calls_of img f) fs;
    let own = array.of_list (list.map (fn fact -> fact.[0]) facts);
    let callees = array.of_list (list.map (fn fact -> fact.[1]) facts);
    settle_capable own callees own
};

let settle_capable : :array -> :array -> :array -> :array;
let settle_capable own callees !now = {
    let next = array.of_list (list.map (fn f -> now.[f] || list.any (fn g -> now.[g]) callees.[f]) (list.range 0 (len own)));
    if next == now { now } else { settle_capable own callees next }
};

/// What function `f`'s own body does: `[performs or applies something unknown, the functions it
/// calls by name]`. A closure it makes is a function of its own, and not walked.
let calls_of : image.Image -> :integer -> [:any];
let calls_of img f = {
    let func = image.func img f;
    let walked = walk_body img [image.Func.body func] %{} false [];
    [image.Func.flags func & fn_impure != 0 || walked.[0], walked.[1]]
};

let walk_body : image.Image -> [:integer] -> :map -> :bool -> [:integer] -> [:any];
let walk_body img work !seen !unknown !callees = match work {
    [] => [unknown, callees],
    [i, ..rest] => if i == image.no_node || map.has i seen { walk_body img rest seen unknown callees } else {
        let n = image.node img i;
        let kids = node_children img n;
        let direct = direct_callee img n;
        let applies_unknown = image.Node.op n == 13 && direct == () && not (pure_callee img (image.Node.a n));
        walk_body img (list.append kids rest) seen.[i => true]
            (unknown || image.Node.flags n & flag_impure != 0 || applies_unknown)
            (if direct == () { callees } else { list.cons direct callees })
    },
};

/// The function a call names, when its callee is a global function: `()` otherwise.
let direct_callee : image.Image -> image.Node -> :any;
let direct_callee img n = if image.Node.op n != 13 { () } else {
    let callee = image.node img (image.Node.a n);
    if image.Node.op callee != 10 { () } else {
        let g = image.global img (image.Node.a callee);
        if image.Global.kind g == global_function { image.Global.target g } else { () }
    }
};

/// The nodes a node's code runs, its operands and statements: what the two walks above follow.
let node_children : image.Image -> image.Node -> [:integer];
let node_children img n = {
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    match image.Node.op n {
        13 => list.cons a (image.kids img b c),
        14 => [a, b, c],
        15 => image.kids img a b,
        16 => [b],
        17 => [],
        18 => [],
        19 => [a, b],
        20 => [a],
        op if op >= 21 && op <= 35 => [a, b],
        36 => image.kids img a b,
        37 => image.kids img a b,
        38 => image.kids img a (2 * b),
        39 => [a, b, c],
        40 => [a, b, c],
        41 => list.cons a (image.kids img b c),
        42 => list.cons a (image.kids img b c),
        43 => [a],
        44 => [a, b],
        45 => [a],
        46 => [a],
        op if op >= 47 && op <= 74 => image.kids img b c,
        op if op >= 75 && op <= 80 => [a, b],
        81 => image.kids img a b,
        82 => list.cons a (image.kids img b (2 * c)),
        83 => [a, b],
        84 => [a],
        85 => [a],
        _ => [],
    }
};

let node_effect : image.Image -> :array -> :array -> :integer -> :bool;
let node_effect img able table i = {
    let n = image.node img i;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let any = fn js -> list.any (fn j -> j != image.no_node && table.[j]) js;
    if image.Node.flags n & flag_impure != 0 { true }
    else if image.Node.op n == 13 {
        let callee_may = match direct_callee img n {
            () => not (pure_callee img a),
            f => able.[f],
        };
        callee_may || any (image.kids img b c)
    } else { any (node_children img n) }
};

/// Whether node `i`, as a callee, is a function known now to perform no effect: a builtin or a
/// member of the VM's own modules, by its name.
let pure_callee : image.Image -> :integer -> :bool;
let pure_callee img i = {
    let n = image.node img i;
    match image.Node.op n {
        11 => not (str.ends_with "!" compiler_builtins.names.[image.Node.a n]),
        12 => {
            let obj = image.node img (image.Node.a n);
            image.Node.op obj == 10 && image.Global.kind (image.global img (image.Node.a obj)) != global_function
                && not (str.ends_with "!" (image.string img (image.Node.b n)))
        },
        _ => false,
    }
};

let compile_node : Program -> :integer -> image.Node -> :bool -> Code;
let compile_node prog i n eff = {
    let img = Program.img prog;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let sub = fn j -> compile prog j;
    match image.Node.op n {
        8 => local_code a,
        9 => capture_code a,
        10 => global_code prog a,
        12 => field_code prog a (image.string img b),
        13 => apply_code eff prog i a (image.kids img b c),
        14 => if_code eff (sub a) (sub b) (if c == image.no_node { constant () } else { sub c }),
        15 => block_code eff prog (image.kids img a b),
        // A bind outside a block's statements: the block is what threads the frame it makes,
        // so one here binds nothing anyone reads.
        16 => constant (),
        17 => closure_code prog a,
        18 => closure_code prog a,
        19 => try_code eff (sub a) (sub b) c,
        20 => force_code eff (sub a),
        21 => add_code eff (sub a) (sub b),
        22 => sub_code eff (sub a) (sub b),
        23 => mul_code eff (sub a) (sub b),
        24 => div_code eff (sub a) (sub b),
        25 => mod_code eff (sub a) (sub b),
        26 => eq_code eff (sub a) (sub b),
        27 => ne_code eff (sub a) (sub b),
        28 => lt_code eff (sub a) (sub b),
        29 => le_code eff (sub a) (sub b),
        30 => gt_code eff (sub a) (sub b),
        31 => ge_code eff (sub a) (sub b),
        32 => and_code eff (sub a) (sub b),
        33 => or_code eff (sub a) (sub b),
        34 => neg_code eff (sub a),
        35 => not_code eff (sub a),
        36 => list_code eff (list.map sub (image.kids img a b)),
        37 => array_code eff (list.map sub (image.kids img a b)),
        38 => map_code eff (list.map sub (image.kids img a (2 * b))),
        39 => if c == image.no_node { get_code eff (sub a) (sub b) } else { get_else_code eff (sub a) (sub b) (sub c) },
        40 => set_code eff (sub a) (sub b) (sub c),
        41 => switch_code eff prog (sub a) (image.kids img b c) false,
        42 => switch_code eff prog (sub a) (image.kids img b c) true,
        43 => type_is_code eff (sub a) surface_types.[b] (c == 1),
        44 => call eff prog (named prog "_list_cons") [a, b],
        45 => call eff prog (named prog "_list_tail") [a],
        46 => call eff prog (named prog "_list_is_empty") [a],
        75 => band_code eff (sub a) (sub b),
        76 => bor_code eff (sub a) (sub b),
        77 => bxor_code eff (sub a) (sub b),
        78 => bnot_code eff (sub a),
        79 => shl_code eff (sub a) (sub b),
        80 => shr_code eff (sub a) (sub b),
        81 => record_code eff (list.map sub (image.kids img a b)) (atom_of prog (if c >= variant_bit { c - variant_bit } else { c })) (c >= variant_bit) (named prog "_record_of"),
        82 => set_many_code eff (sub a) (list.map sub (image.kids img b (2 * c))),
        83 => ensure_code (sub a) (sub b),
        84 => call eff prog (named prog "_match_is_cons") [a],
        85 => call eff prog (named prog "_match_head") [a],
        op if op >= 47 && op <= 74 => call eff prog (builtin prog a) (image.kids img b c),
        op => match constant_of prog i {
            Option.some(v) => constant v,
            Option.none => raise_code ("dre: no meaning for node " + to_string i + "'s op " + to_string op),
        },
    }
};

let raise_code : :string -> Code;
let raise_code !why = fn! fr -> error.raise_as! :dre why;

let float_constant : image.Image -> :integer -> :float;
let float_constant img i = {
    let [low, high] = image.float_bits img i;
    num.float_of_bytes (str.of_int_le 8 (high * 4294967296 + low))
};

let builtin : Program -> :integer -> :any;
let builtin prog id = (Program.builtins prog).[id];

/// A builtin by the name the compiler gives it.
let named : Program -> :string -> :any;
let named prog name = builtin prog compiler_builtins.ids.[name];

/// The value of node `i` if it is a constant: a literal, an atom, a builtin.
let constant_of : Program -> :integer -> Option :any;
let constant_of prog i = {
    let img = Program.img prog;
    let n = image.node img i;
    let a = image.Node.a n;
    match image.Node.op n {
        0 => Option.some (),
        1 => Option.some (image.integer img a),
        2 => Option.some (float_constant img a),
        3 => Option.some (image.string img a),
        4 => Option.some (char.of_code a),
        5 => Option.some (a == 1),
        6 => Option.some (atom_of prog a),
        7 => Option.some (),
        11 => Option.some (builtin prog a),
        _ => Option.none,
    }
};

// --- calls -------------------------------------------------------------------------------

/// An argument: a constant is passed as its value, as the VM passes one, and anything else
/// as a suspension of computing it.
union Arg {
    value(v : :any),
    code(c : Code),
}

/// Node `i` as an argument.
let arg : Program -> :integer -> Arg;
let arg prog i = match constant_of prog i {
    Option.some(v) => Arg.value v,
    Option.none => Arg.code (compile prog i),
};

/// An application. A function of the image named at the top level and given all its arguments
/// is called directly, with no function value made to be applied: that is most calls.
let apply_code : :bool -> Program -> :integer -> :integer -> [:integer] -> Code;
let apply_code eff prog at callee args = {
    let img = Program.img prog;
    let n = image.node img callee;
    let direct = if image.Node.op n == 10 {
        let g = image.global img (image.Node.a n);
        if image.Global.kind g == global_function && image.Func.arity (image.func img (image.Global.target g)) == list.length args && list.length args > 0 {
            Option.some (image.Global.target g)
        } else { Option.none }
    } else { Option.none };
    let spawned = match [image.Node.op n, args] {
        [11, [work]] if image.Node.a n == compiler_builtins.ids.["spawn!"] => thunk_of img work,
        _ => Option.none,
    };
    let raising = match [image.Node.op n, args] {
        [11, [_]] => image.Node.a n == compiler_builtins.ids.["raise!"],
        _ => false,
    };
    if raising { raise_at_code (compile prog (list.head args)) (settled (place_of prog at)) } else { match [direct, spawned] {
        [_, Option.some(f)] => spawn_code prog f,
        [Option.some(f), _] => direct_call eff prog f (list.map (arg prog) args),
        _ => apply_args eff (compile prog callee) (list.map (arg prog) args),
    } }
};

/// The function of node `i`, if it makes a thunk.
let thunk_of : image.Image -> :integer -> Option :integer;
let thunk_of img i = {
    let n = image.node img i;
    if (image.Node.op n == 17 || image.Node.op n == 18) && image.Func.arity (image.func img (image.Node.a n)) == 0 {
        Option.some (image.Node.a n)
    } else { Option.none }
};

/// A call eff of a value known now -- a builtin -- on the nodes `args`.
let call : :bool -> Program -> :any -> [:integer] -> Code;
let call eff prog f args = apply_args eff (constant f) (list.map (arg prog) args);

/// Function `f` of the image called with these arguments, its frame made here.
let direct_call : :bool -> Program -> :integer -> [Arg] -> Code;
let direct_call eff prog f args = match list.map code_of args {
    // An argument each one suspension of its code: a chain of suspended calls -- an
    // accumulator nothing forces -- is forced a level at a time, and every frame between
    // two levels is a frame on every level of it.
    [a] => direct1 eff prog f a,
    [a, b] => direct2 eff prog f a b,
    [a, b, c] => direct3 eff prog f a b c,
    [a, b, c, d] => direct4 eff prog f a b c d,
    _ => direct_built eff prog f (settled args),
};

/// An argument as code, a constant too.
let code_of : Arg -> Code;
let code_of x = match x {
    Arg.value(v) => constant v,
    Arg.code(c) => c,
};

let direct1 : :bool -> Program -> :integer -> Code -> Code;
let direct1 !eff !prog !f !a = if eff { fn! fr -> { let c = function_of prog f; invoke c (a fr :: Compiled.pad c) #[] } } else { fn fr -> { let c = function_of prog f; invoke c (a fr :: Compiled.pad c) #[] } };
let direct2 : :bool -> Program -> :integer -> Code -> Code -> Code;
let direct2 !eff !prog !f !a !b = if eff { fn! fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: Compiled.pad c) #[] } } else { fn fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: Compiled.pad c) #[] } };
let direct3 : :bool -> Program -> :integer -> Code -> Code -> Code -> Code;
let direct3 !eff !prog !f !a !b !d = if eff { fn! fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: Compiled.pad c) #[] } } else { fn fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: Compiled.pad c) #[] } };
let direct4 : :bool -> Program -> :integer -> Code -> Code -> Code -> Code -> Code;
let direct4 !eff !prog !f !a !b !d !e = if eff { fn! fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: e fr :: Compiled.pad c) #[] } } else { fn fr -> { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: e fr :: Compiled.pad c) #[] } };

let direct_built : :bool -> Program -> :integer -> [Arg] -> Code;
let direct_built !eff !prog !f !args = if eff { fn! fr -> {
    let c = function_of prog f;
    invoke c (list.append (list.map (fn x -> passed x fr) args) (Compiled.pad c)) #[]
} } else { fn fr -> {
    let c = function_of prog f;
    invoke c (list.append (list.map (fn x -> passed x fr) args) (Compiled.pad c)) #[]
} };

/// An argument as it is passed: a constant as itself, anything else suspended.
let passed : Arg -> Frame -> :any;
let passed x fr = match x {
    Arg.value(v) => v,
    Arg.code(c) => c fr,
};

/// An application of `f` to however many arguments. One with a constant among them is
/// applied an argument at a time, so that each constant can be handed over as the value it
/// is; the rest are applied at once.
let apply_args : :bool -> Code -> [Arg] -> Code;
let apply_args eff !f !args = {
    let kept = settled args;
    if list.any (fn x -> match x { Arg.value(_) => true, _ => false }) kept {
        list.fold (fn g x -> match x {
            Arg.value(v) => passing eff g v,
            Arg.code(c) => apply1 eff g c,
        }) f kept
    } else { apply_codes eff f (list.map (fn x -> match x { Arg.code(c) => c, Arg.value(v) => constant v }) kept) }
};

/// `g`'s answer applied to `v`, which a strict parameter has in hand, so that it is the value
/// that is passed and not a suspension of reading it.
let passing : :bool -> Code -> :any -> Code;
let passing !eff !g !v = if eff { fn! fr -> (g fr) v } else { fn fr -> (g fr) v };

let apply0 : :bool -> Code -> Code;
let apply0 !eff !f = if eff { fn! fr -> (f fr) () } else { fn fr -> (f fr) () };
let apply1 : :bool -> Code -> Code -> Code;
let apply1 !eff !f !a = if eff { fn! fr -> (f fr) (a fr) } else { fn fr -> (f fr) (a fr) };
let apply2 : :bool -> Code -> Code -> Code -> Code;
let apply2 !eff !f !a !b = if eff { fn! fr -> (f fr) (a fr) (b fr) } else { fn fr -> (f fr) (a fr) (b fr) };
let apply3 : :bool -> Code -> Code -> Code -> Code -> Code;
let apply3 !eff !f !a !b !c = if eff { fn! fr -> (f fr) (a fr) (b fr) (c fr) } else { fn fr -> (f fr) (a fr) (b fr) (c fr) };
let apply4 : :bool -> Code -> Code -> Code -> Code -> Code -> Code;
let apply4 !eff !f !a !b !c !d = if eff { fn! fr -> (f fr) (a fr) (b fr) (c fr) (d fr) } else { fn fr -> (f fr) (a fr) (b fr) (c fr) (d fr) };
let apply5 : :bool -> Code -> Code -> Code -> Code -> Code -> Code -> Code;
let apply5 !eff !f !a !b !c !d !e = if eff { fn! fr -> (f fr) (a fr) (b fr) (c fr) (d fr) (e fr) } else { fn fr -> (f fr) (a fr) (b fr) (c fr) (d fr) (e fr) };

/// An application of `f` to however many arguments, each suspended as an argument is.
let apply_codes : :bool -> Code -> [Code] -> Code;
let apply_codes eff f args = match args {
    [] => apply0 eff f,
    [a] => apply1 eff f a,
    [a, b] => apply2 eff f a b,
    [a, b, c] => apply3 eff f a b c,
    [a, b, c, d] => apply4 eff f a b c d,
    [a, b, c, d, e] => apply5 eff f a b c d e,
    [a, b, c, d, e, ..rest] => apply_codes eff (apply5 eff f a b c d e) rest,
};

/// A global as it is read: a top-level value from this process's world, a function as a value
/// of it, a module the VM provides as that module, and an action run.
let global_code : Program -> :integer -> Code;
let global_code prog i = {
    let img = Program.img prog;
    let g = image.global img i;
    if image.Global.kind g != global_function { constant (module_value prog (image.import_path img (image.Global.target g))) }
    else {
        let f = image.func img (image.Global.target g);
        if is_action f { action_code prog (image.Global.target g) }
        else if is_value f { world_code prog (Program.places prog).[i] }
        else { function_code prog (image.Global.target g) }
    }
};

let action_code : Program -> :integer -> Code;
let action_code !prog !f = fn fr -> { let c = function_of prog f; invoke c (Compiled.pad c) #[] };

let function_code : Program -> :integer -> Code;
let function_code !prog !f = fn! fr -> function_value (function_of prog f) #[];

/// `module.member`: a member of a module the VM provides, found once where the module is named
/// at the top level, and where it is a value, each time.
let field_code : Program -> :integer -> :string -> Code;
let field_code prog obj name = {
    let img = Program.img prog;
    let n = image.node img obj;
    let named_global = image.Node.op n == 10 && image.Global.kind (image.global img (image.Node.a n)) != global_function;
    if named_global {
        let path = image.import_path img (image.Global.target (image.global img (image.Node.a n)));
        match member prog path name {
            Option.some(v) => constant v,
            Option.none => missing_member_code path name,
        }
    } else { dynamic_field_code prog (compile prog obj) name }
};

let missing_member_code : :string -> :string -> Code;
let missing_member_code !path !name = fn! fr -> no_member! path name;

let dynamic_field_code : Program -> Code -> :string -> Code;
let dynamic_field_code !prog !o !name = fn! fr -> {
    let path = (Program.module_paths prog).[to_string (o fr) else ""];
    match member prog path name {
        Option.some(v) => v,
        Option.none => no_member! path name,
    }
};

/// A native by its module and name. `m.f!` names `m.f` where there is no `f!`: a pure function
/// called impurely.
let member : Program -> :string -> :string -> Option :any;
let member prog path name = {
    let natives = Program.natives prog;
    let full = path + "." + name;
    let plain = if str.ends_with "!" name { path + "." + str.slice 0 (len name - 1) name } else { full };
    Option.or_else (fn u -> map.lookup plain natives) (map.lookup full natives)
};

let no_member! : :string -> :string -> :any;
let no_member! path name = error.raise_as! :no_such_member ("module `" + path + "` has no member `" + name + "`");

// --- blocks ------------------------------------------------------------------------------

/// A block's statements, in order. A bind makes the frame the statements after it run in; a
/// statement the image marks strict is forced where it stands; the last is the block's value.
union Step {
    bind(slot : :integer, value : Code, strict : :bool, knot : :bool),
    expr(value : Code, strict : :bool),
}

let block_code : :bool -> Program -> [:integer] -> Code;
let block_code eff prog stmts = steps_code eff (list.map (fn s -> step prog s) stmts);

/// A block's statements as code. One the image says performs an effect runs as an impure
/// block does, a statement at a time; any other is pure, and its strict statements -- a
/// strict parameter, a `match`'s subject -- are forced in order all the same, by `lazy.after`.
let steps_code : :bool -> [Step] -> Code;
let steps_code !eff !steps = if eff { impure_steps (settled steps) } else { pure_steps (settled steps) };
let impure_steps : [Step] -> Code;
let impure_steps !steps = fn! fr -> run_steps! steps fr;
let pure_steps : [Step] -> Code;
let pure_steps !steps = fn fr -> run_steps steps fr;

let step : Program -> :integer -> Step;
let step prog s = {
    let img = Program.img prog;
    let n = image.node img s;
    let strict = image.Node.flags n & flag_strict != 0;
    if image.Node.op n == 16 {
        let value_op = image.Node.op (image.node img (image.Node.b n));
        // A closure or a thunk may name itself -- `let rec go x = .. go ..` -- and is made in
        // the frame that already holds it, as the VM suspends it to the same end.
        Step.bind (image.Node.a n) (compile prog (image.Node.b n)) strict (value_op == 17 || value_op == 18)
    } else { Step.expr (compile prog s) strict }
};

let run_steps! : [Step] -> Frame -> :any;
let run_steps! steps fr = match steps {
    [] => (),
    [Step.expr(e, _)] => e fr,
    [Step.expr(e, strict), ..rest] => {
        if strict { whnf (e fr); };
        run_steps! rest fr
    },
    [Step.bind(slot, e, strict, knot), ..rest] => {
        let next = bound slot e knot fr;
        if strict { whnf ((Frame.slots next).[slot]); };
        run_steps! rest next
    },
};

let run_steps : [Step] -> Frame -> :any;
let run_steps steps fr = match steps {
    [] => (),
    [Step.expr(e, _)] => e fr,
    [Step.expr(e, strict), ..rest] => if strict { lazy.after (e fr) (run_steps rest fr) } else { run_steps rest fr },
    [Step.bind(slot, e, strict, knot), ..rest] => {
        let next = bound slot e knot fr;
        if strict { lazy.after ((Frame.slots next).[slot]) (run_steps rest next) } else { run_steps rest next }
    },
};

let bound : :integer -> Code -> :bool -> Frame -> Frame;
let bound slot e knot fr = if knot {
    let rec next = Frame.make ((Frame.slots fr).[slot => e next]) (Frame.caps fr);
    next
} else { Frame.make ((Frame.slots fr).[slot => e fr]) (Frame.caps fr) };

// --- closures ----------------------------------------------------------------------------

/// A closure or thunk of function `f`: its captures read from the frame it is made in, a
/// parent's slot or one of the parent's own captures.
let closure_code : Program -> :integer -> Code;
let closure_code !prog !f = fn! fr -> {
    let c = function_of prog f;
    function_value c (captured c (Frame.slots fr) (Frame.caps fr))
};

/// What `c` captures, from its parent's slots and captures. Each is a suspension of reading
/// it, since reading a slot is forcing what is in it, and the arrays are taken first so that
/// what each suspension holds is them and not the parent's frame.
let captured : Compiled -> :array -> :array -> :array;
let captured !c !slots !pcaps = array.of_list (list.map (fn d ->
    if d >= capture_of_parent { pcaps.[d - capture_of_parent] } else { slots.[d] }) (Compiled.captures c));

/// `spawn! $( .. )`, the thunk made here and handed over as it is. Handed on as an argument
/// is, it was a suspension of making it, which `spawn!` copied with the frame it held.
let spawn_code : Program -> :integer -> Code;
let spawn_code !prog !f = fn! fr -> {
    let c = function_of prog f;
    spawn! (function_value c (captured c (Frame.slots fr) (Frame.caps fr)))
};

// --- the rest ----------------------------------------------------------------------------

let try_code : :bool -> Code -> Code -> :integer -> Code;
let try_code eff !body !handler !slot = fn! fr ->
    try! { whnf (body fr) } catch e { handler (Frame.make ((Frame.slots fr).[slot => e]) (Frame.caps fr)) };

/// The body's answer or error, then the cleanup, which `defer!` runs on every way out.
let ensure_code : Code -> Code -> Code;
let ensure_code !body !cleanup = fn! fr -> ensured! body cleanup fr;

let ensured! : Code -> Code -> Frame -> :any;
let ensured! body cleanup fr = {
    defer! whnf (cleanup fr);
    whnf (body fr)
};

/// `switch_atom` keys on its subject, a record by its id; `switch_head` on the head of a list
/// cell or the first element of an array.
let switch_code : :bool -> Program -> Code -> [:integer] -> :bool -> Code;
let switch_code eff prog subject kids on_atom = {
    let img = Program.img prog;
    let arms = list.map (fn [k, t] -> [atom_of prog (image.Node.a (image.node img k)), compile prog t]) (list.chunks 2 (list.take (list.length kids - 1) kids));
    let table = list.fold (fn m [k, t] -> if map.has k m { m } else { m.[k => t] }) %{} arms;
    switch_built eff subject table (compile prog (list.last kids)) on_atom (named prog "_record_id")
};

let switch_built : :bool -> Code -> :map -> Code -> :bool -> :any -> Code;
let switch_built eff subject table otherwise on_atom record_id = switch_kept eff subject (settled table) otherwise on_atom record_id;

let switch_kept : :bool -> Code -> :map -> Code -> :bool -> :any -> Code;
let switch_kept !eff !subject !table !otherwise !on_atom !record_id = if eff { fn! fr -> {
        let s = whnf (subject fr);
        let key = if on_atom { record_key record_id s } else { head_key s };
        match key {
            Option.some(k) => (table.[k else otherwise]) fr,
            Option.none => otherwise fr,
        }
    } } else { fn fr -> {
        let s = whnf (subject fr);
        let key = if on_atom { record_key record_id s } else { head_key s };
        match key {
            Option.some(k) => (table.[k else otherwise]) fr,
            Option.none => otherwise fr,
        }
    } };

let record_key : :any -> :any -> Option :atom;
let record_key record_id s = match type_of s {
    :atom => Option.some s,
    _ => match record_id s { () => Option.none, id => Option.some id },
};

let head_key : :any -> Option :atom;
let head_key s = match type_of s {
    :list => if list.is_empty s { Option.none } else { atom_or_none (list.head s) },
    :array => if len s > 0 { atom_or_none s.[0] } else { Option.none },
    _ => Option.none,
};

let atom_or_none : :any -> Option :atom;
let atom_or_none v = if type_of v == :atom { Option.some v } else { Option.none };

/// `type_is`'s kinds, in `dream_type`'s order.
let surface_types : #[:atom];
let surface_types = #[:integer, :float, :char, :bool, :unit, :string, :atom, :list, :array, :map];

let type_is_code : :bool -> Code -> :atom -> :bool -> Code;
let type_is_code !eff !subject !want !invert = if eff { fn! fr -> (type_of (subject fr) == want) != invert } else { fn fr -> (type_of (subject fr) == want) != invert };

let record_code : :bool -> [Code] -> :atom -> :bool -> :any -> Code;
let record_code eff fields id variant make = record_built eff (settled fields) id variant make;
let record_built : :bool -> [Code] -> :any -> :any -> (:any -> :any -> :array -> :any) -> Code;
let record_built !eff !fields !id !variant !make = if eff { fn! fr -> make id variant (array.of_list (list.map (fn f -> f fr) fields)) } else { fn fr -> make id variant (array.of_list (list.map (fn f -> f fr) fields)) };

let set_many_code : :bool -> Code -> [Code] -> Code;
let set_many_code eff container kvs = set_many_built eff container (settled kvs);
let set_many_built : :bool -> Code -> [Code] -> Code;
let set_many_built !eff !container !kvs = if eff { fn! fr -> pairs_onto (container fr) kvs fr } else { fn fr -> pairs_onto (container fr) kvs fr };

let pairs_onto : :any -> [Code] -> Frame -> :any;
let pairs_onto acc kvs fr = match kvs {
    [k, v, ..rest] => pairs_onto acc.[k fr => v fr] rest fr,
    _ => acc,
};

// --- running -----------------------------------------------------------------------------

/// The image's `main!`, run: what `dream IMAGE` does, in a world of its own.
let main! : Program -> :any;
let main! prog = {
    let c = function_of prog (image.Image.entry (Program.img prog));
    whnf (invoke c (Compiled.pad c) #[])
};

when test {
    import std.test;

    let tests : [:any];
    let tests = [
        test.case "the builtins are the compiler's, by position" $(
            test.eq! (list.length compiler_builtins.names) builtins.count
        ),
    ];
}
