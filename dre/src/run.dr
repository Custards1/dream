// dre's machine: an image's functions compiled into closures of the language dre itself is
// written in, and run.
//
// The program's values are this program's values. An integer, a string, a list, a map, a
// record, an error and a process are each the thing itself, so a builtin or a native given one
// is the builtin or native the VM running dre has, and `spawn!`, `send!`, `try!` and the
// collector come with them. A function of the image is a function here too: an arity's worth of
// parameters around its compiled body, so a native that takes a function -- `spawn!` above all,
// whose argument is a thunk, which is a function of no arguments -- is given something it can
// call. What dre adds is only what an image says and a value does not: frames, captures,
// globals, and which statements must run, and in what order.
//
// A node becomes a `Code`, a function from the frame it runs in to its value. Nothing is
// interpreted at run time but those closures: the tree is walked once, here, and each node's
// operands are found then rather than every time it runs.
//
// What must happen in order is written as a statement of an impure block, here as in the
// image: a statement is forced where it stands, and that is what the image's STRICT flag asks.
// A value that is only computed is left to the language's own laziness, which is the image's.
//
// What is shared, and what is not. The compiled program -- every function's closures, the
// image, the tables -- is made once and never changes, and a process started by `spawn!`
// copies what its work can reach, which through any closure of it was all of it. So the whole
// program is compiled when it is loaded and moved where every process reads it and none copies
// it (`vm.share!`). What changes is each process's own: a frame, a function value made while
// running, and the program's top-level values, which are made when first read and live in the
// frame's `world`, a table of them per process. The VM keeps a process's globals apart in the
// same way.
//
// For that to be possible nothing the compiled program holds may be a suspension: a shared
// value is one every process reads and none may update. So every closure made here is made by a
// builder whose parameters are strict, `!x`, and a list a closure keeps is settled before it is
// kept. Something left suspended would be refused, loudly, when the program is shared.

import std.array;
import std.builtins;
import std.char;
import std.error;
import std.lazy;
import std.list;
import std.map;
import std.num;
import std.str;
import std.vm;

import dreams.aot.image;
import dreams.builtins as compiler_builtins;

/// What a node computes, given the frame it runs in.
type Code = Frame -> :any;

/// A running function's slots -- its parameters first, then what its blocks bind -- the values
/// it captured where it was made, and this process's top-level values.
group Frame { slots : :array, caps : :array, world : :array }

/// A node's flags (dream/docs/bytecode-format.md).
let flag_strict = 1;

/// A function's flags.
let fn_impure = 1;
let fn_global_value = 8;

/// A global's kinds.
let global_function = 0;

/// A capture descriptor whose top bit is set names a capture of the parent, not a slot.
let capture_of_parent = 2147483648;

/// The atom index in `record_make`'s `c`, whose top bit says the record is a variant.
let variant_bit = 2147483648;

/// One function of the image, as it runs here: what it is, and its body compiled. `pad` is the
/// slots after the parameters, empty, made once: a frame is the arguments in front of it.
group Compiled {
    arity : :integer,
    impure : :bool,
    slots : :integer,
    captures : [:integer],
    pad : [:any],
    body : Code,
}

/// A loaded image and everything dre made of it, all of it shared.
group Program {
    img : image.Image,
    atoms : :array,
    funcs : :array,
    builtins : :array,
    natives : :map,
    /// The path of each module `natives` holds, by how the module is written (`<module math>`):
    /// what a `field` of a module that is a value -- `let m = math; m.abs 1` -- looks its members
    /// up under. By the text and not the module, because a module is a key by its identity, and
    /// the shared copy of the table is not the table the program was handed its modules from.
    module_paths : :map,
}

/// `x` forced all the way down, and answered: what a closure keeps of a list or a table.
let settled : :any -> :any;
let settled x = if lazy.settled x { x } else { () };

/// `x`, evaluated as far as its outermost constructor. Asked in a condition, the one place the
/// language must evaluate, as `lazy.forced` says.
let whnf : :any -> :any;
let whnf x = if lazy.forced x { x } else { x };

/// The image's atom `i` as an atom of this program.
let atom_of : Program -> :integer -> :atom;
let atom_of prog i = (Program.atoms prog).[i];

/// An image read to be run, compiled whole and shared. `builtins` and `natives` are what its
/// `builtin` nodes and its host modules' members are: the VM's own, with whatever the caller
/// replaced (dre's arguments, the image's payload).
let load! : image.Image -> :array -> :map -> Program;
let load! img table natives = {
    // Every name the image writes as an atom, made an atom here: what the VM does when it
    // loads one, and the only thing a program cannot do for itself.
    let atoms = array.of_list (list.forced (list.map (fn i -> vm.intern_atom! (image.atom img i)) (list.range 0 (image.count img "KATM"))));
    let rec prog = Program.make img atoms
        (array.of_list (list.map (fn i -> compile_function! prog i) (list.range 0 (image.count img "FUNC"))))
        table natives
        (list.fold (fn m [path, v] -> if type_of v == :module { m.[to_string v => path] } else { m }) %{} (map.pairs natives));
    // Sharing forces it all the way down, which is every function compiled.
    vm.share! prog
};

// --- functions ---------------------------------------------------------------------------

let compile_function! : Program -> :integer -> Compiled;
let compile_function! prog i = {
    let img = Program.img prog;
    let f = image.func img i;
    let arity = image.Func.arity f;
    let slots = image.Func.slots f;
    Compiled.make arity (image.Func.flags f & fn_impure != 0) slots
        (image.kids img (image.func_captures_at img i) (image.Func.captures f))
        (list.replicate (if slots > arity { slots - arity } else { 0 }) ())
        (compile! prog (image.Func.body f))
};

let function_of : Program -> :integer -> Compiled;
let function_of prog f = (Program.funcs prog).[f];

/// `c` run with `args`, its parameters with its other slots after them.
let invoke : Compiled -> [:any] -> :array -> :array -> :any;
let invoke c args caps world = (Compiled.body c) (Frame.make (array.of_list args) caps world);

/// Function `c` as a value: a function of this language of the same arity, which runs the
/// compiled body. A thunk is the arity-0 case. Past seven parameters it is curried, which is
/// the same function to anyone who applies it. An impure function is an impure one here,
/// because `type_of` says which, and a program may ask.
let function_value! : Compiled -> :array -> :array -> :any;
let function_value! c caps w = {
    let pad = Compiled.pad c;
    if Compiled.impure c { impure_value! c caps w } else { match Compiled.arity c {
        0 => $( invoke c pad caps w ),
        1 => fn a -> invoke c (a :: pad) caps w,
        2 => fn a b -> invoke c (a :: b :: pad) caps w,
        3 => fn a b d -> invoke c (a :: b :: d :: pad) caps w,
        4 => fn a b d e -> invoke c (a :: b :: d :: e :: pad) caps w,
        5 => fn a b d e g -> invoke c (a :: b :: d :: e :: g :: pad) caps w,
        6 => fn a b d e g h -> invoke c (a :: b :: d :: e :: g :: h :: pad) caps w,
        7 => fn a b d e g h k -> invoke c (a :: b :: d :: e :: g :: h :: k :: pad) caps w,
        n => curried c caps w n [],
    } }
};

let impure_value! : Compiled -> :array -> :array -> :any;
let impure_value! c caps w = {
    let pad = Compiled.pad c;
    match Compiled.arity c {
        // Named, because a lambda is `:pure_fn` to `type_of` whatever it calls.
        0 => { let f! () = invoke! c pad caps w; f! },
        1 => { let f! a = invoke! c (a :: pad) caps w; f! },
        2 => { let f! a b = invoke! c (a :: b :: pad) caps w; f! },
        3 => { let f! a b d = invoke! c (a :: b :: d :: pad) caps w; f! },
        4 => { let f! a b d e = invoke! c (a :: b :: d :: e :: pad) caps w; f! },
        5 => { let f! a b d e g = invoke! c (a :: b :: d :: e :: g :: pad) caps w; f! },
        6 => { let f! a b d e g h = invoke! c (a :: b :: d :: e :: g :: h :: pad) caps w; f! },
        7 => { let f! a b d e g h k = invoke! c (a :: b :: d :: e :: g :: h :: k :: pad) caps w; f! },
        n => curried c caps w n [],
    }
};

/// `invoke`, as an effect: what an impure function's value calls, so that it is one.
let invoke! : Compiled -> [:any] -> :array -> :array -> :any;
let invoke! c args caps w = invoke c args caps w;

let curried : Compiled -> :array -> :array -> :integer -> [:any] -> :any;
let curried c caps w left got = if left == 0 { invoke c (list.append (list.reverse got) (Compiled.pad c)) caps w }
    else { fn a -> curried c caps w (left - 1) (list.cons a got) };

/// This process's top-level values: for each global that is a value -- a pure binding of no
/// parameters -- its body's value, made the first time it is read. Every other global is
/// nothing here: a function is made where it is named, and an impure binding of no parameters is
/// an action, run each time it is named.
let world_of : Program -> :array;
let world_of prog = {
    let img = Program.img prog;
    let rec world = array.of_list (list.map (fn i -> {
        let g = image.global img i;
        if image.Global.kind g == global_function && is_value (image.func img (image.Global.target g)) {
            invoke (function_of prog (image.Global.target g)) (Compiled.pad (function_of prog (image.Global.target g))) #[] world
        } else { () }
    }) (list.range 0 (image.count img "GLBL")));
    world
};

let is_value : image.Func -> :bool;
let is_value f = image.Func.arity f == 0 && (image.Func.flags f & fn_impure == 0 || image.Func.flags f & fn_global_value != 0);

let is_action : image.Func -> :bool;
let is_action f = image.Func.arity f == 0 && image.Func.flags f & fn_impure != 0 && image.Func.flags f & fn_global_value == 0;

/// A module as a value: one the VM provides is the VM's own, which `natives` holds by its
/// path. Another is a module of the image, which nothing but `field` asks for, and that is
/// resolved where it is written.
let module_value : Program -> :string -> :any;
let module_value prog path = (Program.natives prog).[path else [:module, path]];

// --- builders ----------------------------------------------------------------------------
//
// Each closure the compiler makes, made by a function whose parameters are strict, so that
// what it captures is a value and the program can be shared.

let constant! : :any -> Code;
let constant! !v = { let code! fr = v; code! };

let local_code! : :integer -> Code;
let local_code! !i = { let code! fr = (Frame.slots fr).[i]; code! };

let capture_code! : :integer -> Code;
let capture_code! !i = { let code! fr = (Frame.caps fr).[i]; code! };

let world_code! : :integer -> Code;
let world_code! !i = { let code! fr = (Frame.world fr).[i]; code! };

let if_code! : Code -> Code -> Code -> Code;
let if_code! !c !y !n = { let code! fr = if c fr { y fr } else { n fr }; code! };

let force_code! : Code -> Code;
let force_code! !e = { let code! fr = whnf (e fr); code! };

// Each operator written into its own closure rather than passed to one: a chain of suspended
// sums is forced a level at a time, and a call in between was a frame more on every level.
let add_code! !x !y = { let code! fr = x fr + y fr; code! };
let sub_code! !x !y = { let code! fr = x fr - y fr; code! };
let mul_code! !x !y = { let code! fr = x fr * y fr; code! };
let div_code! !x !y = { let code! fr = x fr / y fr; code! };
let mod_code! !x !y = { let code! fr = x fr % y fr; code! };
let eq_code! !x !y = { let code! fr = x fr == y fr; code! };
let ne_code! !x !y = { let code! fr = x fr != y fr; code! };
let lt_code! !x !y = { let code! fr = x fr < y fr; code! };
let le_code! !x !y = { let code! fr = x fr <= y fr; code! };
let gt_code! !x !y = { let code! fr = x fr > y fr; code! };
let ge_code! !x !y = { let code! fr = x fr >= y fr; code! };
let and_code! !x !y = { let code! fr = x fr && y fr; code! };
let or_code! !x !y = { let code! fr = x fr || y fr; code! };
let band_code! !x !y = { let code! fr = x fr & y fr; code! };
let bor_code! !x !y = { let code! fr = x fr | y fr; code! };
let bxor_code! !x !y = { let code! fr = x fr ^ y fr; code! };
let shl_code! !x !y = { let code! fr = x fr << y fr; code! };
let shr_code! !x !y = { let code! fr = x fr >> y fr; code! };
let neg_code! !x = { let code! fr = 0 - x fr; code! };
let not_code! !x = { let code! fr = not (x fr); code! };
let bnot_code! !x = { let code! fr = ~ (x fr); code! };

let list_code! : [Code] -> Code;
let list_code! !items = list_built! (settled items);
let list_built! !items = { let code! fr = { let each! e = e fr; list.map each! items }; code! };

let array_code! : [Code] -> Code;
let array_code! !items = array_built! (settled items);
let array_built! !items = { let code! fr = array.of_list ({ let each! e = e fr; list.map each! items }); code! };

let map_code! : [Code] -> Code;
let map_code! !kvs = map_built! (settled kvs);
let map_built! !kvs = { let code! fr = pairs_into %{} kvs fr; code! };

let pairs_into : :map -> [Code] -> Frame -> :map;
let pairs_into m kvs fr = match kvs {
    [k, v, ..rest] => pairs_into m.[k fr => v fr] rest fr,
    _ => m,
};

let get_code! !container !key = { let code! fr = (container fr).[key fr]; code! };
let get_else_code! !container !key !fallback = { let code! fr = (container fr).[key fr else fallback fr]; code! };
let set_code! !container !key !v = { let code! fr = (container fr).[key fr => v fr]; code! };

// --- nodes -------------------------------------------------------------------------------

/// Node `i`, compiled.
let compile! : Program -> :integer -> Code;
let compile! prog i = {
    let img = Program.img prog;
    let n = image.node img i;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let sub = fn j -> compile! prog j;
    match image.Node.op n {
        8 => local_code! a,
        9 => capture_code! a,
        10 => global_code! prog a,
        12 => field_code! prog a (image.string img b),
        13 => apply_code! prog a (image.kids img b c),
        14 => if_code! (sub a) (sub b) (if c == image.no_node { constant! () } else { sub c }),
        15 => block_code! prog (image.kids img a b),
        // A bind outside a block's statements: the block is what threads the frame it makes,
        // so one here binds nothing anyone reads.
        16 => constant! (),
        17 => closure_code! prog a,
        18 => closure_code! prog a,
        19 => try_code! (sub a) (sub b) c,
        20 => force_code! (sub a),
        21 => add_code! (sub a) (sub b),
        22 => sub_code! (sub a) (sub b),
        23 => mul_code! (sub a) (sub b),
        24 => div_code! (sub a) (sub b),
        25 => mod_code! (sub a) (sub b),
        26 => eq_code! (sub a) (sub b),
        27 => ne_code! (sub a) (sub b),
        28 => lt_code! (sub a) (sub b),
        29 => le_code! (sub a) (sub b),
        30 => gt_code! (sub a) (sub b),
        31 => ge_code! (sub a) (sub b),
        32 => and_code! (sub a) (sub b),
        33 => or_code! (sub a) (sub b),
        34 => neg_code! (sub a),
        35 => not_code! (sub a),
        36 => list_code! (list.map sub (image.kids img a b)),
        37 => array_code! (list.map sub (image.kids img a b)),
        38 => map_code! (list.map sub (image.kids img a (2 * b))),
        39 => if c == image.no_node { get_code! (sub a) (sub b) } else { get_else_code! (sub a) (sub b) (sub c) },
        40 => set_code! (sub a) (sub b) (sub c),
        41 => switch_code! prog (sub a) (image.kids img b c) false,
        42 => switch_code! prog (sub a) (image.kids img b c) true,
        43 => type_is_code! (sub a) surface_types.[b] (c == 1),
        44 => call! prog (named prog "_list_cons") [a, b],
        45 => call! prog (named prog "_list_tail") [a],
        46 => call! prog (named prog "_list_is_empty") [a],
        75 => band_code! (sub a) (sub b),
        76 => bor_code! (sub a) (sub b),
        77 => bxor_code! (sub a) (sub b),
        78 => bnot_code! (sub a),
        79 => shl_code! (sub a) (sub b),
        80 => shr_code! (sub a) (sub b),
        81 => record_code! (list.map sub (image.kids img a b)) (atom_of prog (if c >= variant_bit { c - variant_bit } else { c })) (c >= variant_bit) (named prog "_record_of"),
        82 => set_many_code! (sub a) (list.map sub (image.kids img b (2 * c))),
        83 => ensure_code! (sub a) (sub b),
        84 => call! prog (named prog "_match_is_cons") [a],
        85 => call! prog (named prog "_match_head") [a],
        op if op >= 47 && op <= 74 => call! prog (builtin prog a) (image.kids img b c),
        op => match constant_of prog i {
            Option.some(v) => constant! v,
            Option.none => raise_code! ("dre: no meaning for node " + to_string i + "'s op " + to_string op),
        },
    }
};

let raise_code! : :string -> Code;
let raise_code! !why = { let code! fr = error.raise_as! :dre why; code! };

let float_constant : image.Image -> :integer -> :float;
let float_constant img i = {
    let [low, high] = image.float_bits img i;
    num.float_of_bytes (str.of_int_le 8 (high * 4294967296 + low))
};

let builtin : Program -> :integer -> :any;
let builtin prog id = (Program.builtins prog).[id];

/// A builtin by the name the compiler gives it.
let named : Program -> :string -> :any;
let named prog name = builtin prog compiler_builtins.ids.[name];

/// The value of node `i` if it is a constant: a literal, an atom, a builtin.
let constant_of : Program -> :integer -> Option :any;
let constant_of prog i = {
    let img = Program.img prog;
    let n = image.node img i;
    let a = image.Node.a n;
    match image.Node.op n {
        0 => Option.some (),
        1 => Option.some (image.integer img a),
        2 => Option.some (float_constant img a),
        3 => Option.some (image.string img a),
        4 => Option.some (char.of_code a),
        5 => Option.some (a == 1),
        6 => Option.some (atom_of prog a),
        7 => Option.some (),
        11 => Option.some (builtin prog a),
        _ => Option.none,
    }
};

// --- calls -------------------------------------------------------------------------------

/// An argument: a constant is passed as its value, as the VM passes one, and anything else
/// as a suspension of computing it.
union Arg {
    value(v : :any),
    code(c : Code),
}

/// Node `i` as an argument.
let arg! : Program -> :integer -> Arg;
let arg! prog i = match constant_of prog i {
    Option.some(v) => Arg.value v,
    Option.none => Arg.code (compile! prog i),
};

/// An application. A function of the image named at the top level and given all its arguments
/// is called directly, with no function value made to be applied: that is most calls.
let apply_code! : Program -> :integer -> [:integer] -> Code;
let apply_code! prog callee args = {
    let img = Program.img prog;
    let n = image.node img callee;
    let direct = if image.Node.op n == 10 {
        let g = image.global img (image.Node.a n);
        if image.Global.kind g == global_function && image.Func.arity (image.func img (image.Global.target g)) == list.length args && list.length args > 0 {
            Option.some (image.Global.target g)
        } else { Option.none }
    } else { Option.none };
    match direct {
        Option.some(f) => direct_call! prog f (list.map (arg! prog) args),
        Option.none => apply_args! (compile! prog callee) (list.map (arg! prog) args),
    }
};

/// A call of a value known now -- a builtin -- on the nodes `args`.
let call! : Program -> :any -> [:integer] -> Code;
let call! prog f args = apply_args! (constant! f) (list.map (arg! prog) args);

/// Function `f` of the image called with these arguments, its frame made here.
let direct_call! : Program -> :integer -> [Arg] -> Code;
let direct_call! prog f args = match list.map code_of! args {
    // An argument each one suspension of its code: a chain of suspended calls -- an
    // accumulator nothing forces -- is forced a level at a time, and every frame between
    // two levels is a frame on every level of it.
    [a] => direct1! prog f a,
    [a, b] => direct2! prog f a b,
    [a, b, c] => direct3! prog f a b c,
    [a, b, c, d] => direct4! prog f a b c d,
    _ => direct_built! prog f (settled args),
};

/// An argument as code, a constant too.
let code_of! : Arg -> Code;
let code_of! x = match x {
    Arg.value(v) => constant! v,
    Arg.code(c) => c,
};

let direct1! !prog !f !a = { let code! fr = { let c = function_of prog f; invoke c (a fr :: Compiled.pad c) #[] (Frame.world fr) }; code! };
let direct2! !prog !f !a !b = { let code! fr = { let c = function_of prog f; invoke c (a fr :: b fr :: Compiled.pad c) #[] (Frame.world fr) }; code! };
let direct3! !prog !f !a !b !d = { let code! fr = { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: Compiled.pad c) #[] (Frame.world fr) }; code! };
let direct4! !prog !f !a !b !d !e = { let code! fr = { let c = function_of prog f; invoke c (a fr :: b fr :: d fr :: e fr :: Compiled.pad c) #[] (Frame.world fr) }; code! };

let direct_built! !prog !f !args = { let code! fr = {
    let c = function_of prog f;
    invoke c (list.append ({ let each! x = passed x fr; list.map each! args }) (Compiled.pad c)) #[] (Frame.world fr)
}; code! };

/// An argument as it is passed: a constant as itself, anything else suspended.
let passed : Arg -> Frame -> :any;
let passed x fr = match x {
    Arg.value(v) => v,
    Arg.code(c) => c fr,
};

/// An application of `f` to however many arguments. One with a constant among them is
/// applied an argument at a time, so that each constant can be handed over as the value it
/// is; the rest are applied at once.
let apply_args! : Code -> [Arg] -> Code;
let apply_args! !f !args = {
    let kept = settled args;
    if list.any (fn x -> match x { Arg.value(_) => true, _ => false }) kept {
        list.fold (fn g x -> match x {
            Arg.value(v) => passing! g v,
            Arg.code(c) => apply1! g c,
        }) f kept
    } else { apply_codes! f (list.map (fn x -> match x { Arg.code(c) => c, Arg.value(v) => constant! v }) kept) }
};

/// `g`'s answer applied to `v`, which a strict parameter has in hand, so that it is the value
/// that is passed and not a suspension of reading it.
let passing! : Code -> :any -> Code;
let passing! !g !v = { let code! fr = (g fr) v; code! };

let apply0! !f = { let code! fr = (f fr) (); code! };
let apply1! !f !a = { let code! fr = (f fr) (a fr); code! };
let apply2! !f !a !b = { let code! fr = (f fr) (a fr) (b fr); code! };
let apply3! !f !a !b !c = { let code! fr = (f fr) (a fr) (b fr) (c fr); code! };
let apply4! !f !a !b !c !d = { let code! fr = (f fr) (a fr) (b fr) (c fr) (d fr); code! };
let apply5! !f !a !b !c !d !e = { let code! fr = (f fr) (a fr) (b fr) (c fr) (d fr) (e fr); code! };

/// An application of `f` to however many arguments, each suspended as an argument is.
let apply_codes! : Code -> [Code] -> Code;
let apply_codes! f args = match args {
    [] => apply0! f,
    [a] => apply1! f a,
    [a, b] => apply2! f a b,
    [a, b, c] => apply3! f a b c,
    [a, b, c, d] => apply4! f a b c d,
    [a, b, c, d, e] => apply5! f a b c d e,
    [a, b, c, d, e, ..rest] => apply_codes! (apply5! f a b c d e) rest,
};

/// A global as it is read: a top-level value from this process's world, a function as a value
/// of it, a module the VM provides as that module, and an action run.
let global_code! : Program -> :integer -> Code;
let global_code! prog i = {
    let img = Program.img prog;
    let g = image.global img i;
    if image.Global.kind g != global_function { constant! (module_value prog (image.import_path img (image.Global.target g))) }
    else {
        let f = image.func img (image.Global.target g);
        if is_action f { action_code! prog (image.Global.target g) }
        else if is_value f { world_code! i }
        else { function_code! prog (image.Global.target g) }
    }
};

let action_code! : Program -> :integer -> Code;
let action_code! !prog !f = { let code! fr = { let c = function_of prog f; invoke c (Compiled.pad c) #[] (Frame.world fr) }; code! };

let function_code! : Program -> :integer -> Code;
let function_code! !prog !f = { let code! fr = function_value! (function_of prog f) #[] (Frame.world fr); code! };

/// `module.member`: a member of a module the VM provides, found once where the module is named
/// at the top level, and where it is a value, each time.
let field_code! : Program -> :integer -> :string -> Code;
let field_code! prog obj name = {
    let img = Program.img prog;
    let n = image.node img obj;
    let named_global = image.Node.op n == 10 && image.Global.kind (image.global img (image.Node.a n)) != global_function;
    if named_global {
        let path = image.import_path img (image.Global.target (image.global img (image.Node.a n)));
        match member prog path name {
            Option.some(v) => constant! v,
            Option.none => missing_member_code! path name,
        }
    } else { dynamic_field_code! prog (compile! prog obj) name }
};

let missing_member_code! : :string -> :string -> Code;
let missing_member_code! !path !name = { let code! fr = no_member! path name; code! };

let dynamic_field_code! : Program -> Code -> :string -> Code;
let dynamic_field_code! !prog !o !name = { let code! fr = {
    let path = (Program.module_paths prog).[to_string (o fr) else ""];
    match member prog path name {
        Option.some(v) => v,
        Option.none => no_member! path name,
    }
}; code! };

/// A native by its module and name. `m.f!` names `m.f` where there is no `f!`: a pure function
/// called impurely.
let member : Program -> :string -> :string -> Option :any;
let member prog path name = {
    let natives = Program.natives prog;
    let full = path + "." + name;
    let plain = if str.ends_with "!" name { path + "." + str.slice 0 (len name - 1) name } else { full };
    Option.or_else (fn u -> map.lookup plain natives) (map.lookup full natives)
};

let no_member! : :string -> :string -> :any;
let no_member! path name = error.raise_as! :no_such_member ("module `" + path + "` has no member `" + name + "`");

// --- blocks ------------------------------------------------------------------------------

/// A block's statements, in order. A bind makes the frame the statements after it run in; a
/// statement the image marks strict is forced where it stands; the last is the block's value.
union Step {
    bind(slot : :integer, value : Code, strict : :bool, knot : :bool),
    expr(value : Code, strict : :bool),
}

let block_code! : Program -> [:integer] -> Code;
let block_code! prog stmts = steps_code! (list.map (fn s -> step! prog s) stmts);

let steps_code! : [Step] -> Code;
let steps_code! !steps = steps_built! (settled steps);
let steps_built! !steps = { let code! fr = run_steps! steps fr; code! };

let step! : Program -> :integer -> Step;
let step! prog s = {
    let img = Program.img prog;
    let n = image.node img s;
    let strict = image.Node.flags n & flag_strict != 0;
    if image.Node.op n == 16 {
        let value_op = image.Node.op (image.node img (image.Node.b n));
        // A closure or a thunk may name itself -- `let rec go x = .. go ..` -- and is made in
        // the frame that already holds it, as the VM suspends it to the same end.
        Step.bind (image.Node.a n) (compile! prog (image.Node.b n)) strict (value_op == 17 || value_op == 18)
    } else { Step.expr (compile! prog s) strict }
};

let run_steps! : [Step] -> Frame -> :any;
let run_steps! steps fr = match steps {
    [] => (),
    [Step.expr(e, _)] => e fr,
    [Step.expr(e, strict), ..rest] => {
        if strict { whnf (e fr); };
        run_steps! rest fr
    },
    [Step.bind(slot, e, strict, knot), ..rest] => {
        let next = bound slot e knot fr;
        if strict { whnf ((Frame.slots next).[slot]); };
        run_steps! rest next
    },
};

let bound : :integer -> Code -> :bool -> Frame -> Frame;
let bound slot e knot fr = if knot {
    let rec next = Frame.make ((Frame.slots fr).[slot => e next]) (Frame.caps fr) (Frame.world fr);
    next
} else { Frame.make ((Frame.slots fr).[slot => e fr]) (Frame.caps fr) (Frame.world fr) };

// --- closures ----------------------------------------------------------------------------

/// A closure or thunk of function `f`: its captures read from the frame it is made in, a
/// parent's slot or one of the parent's own captures.
let closure_code! : Program -> :integer -> Code;
let closure_code! !prog !f = { let code! fr = {
    let c = function_of prog f;
    let caps = array.of_list (list.map (fn d ->
        if d >= capture_of_parent { (Frame.caps fr).[d - capture_of_parent] } else { (Frame.slots fr).[d] })
        (Compiled.captures c));
    function_value! c caps (Frame.world fr)
}; code! };

// --- the rest ----------------------------------------------------------------------------

let try_code! : Code -> Code -> :integer -> Code;
let try_code! !body !handler !slot = {
    let code! fr = try! { whnf (body fr) } catch e { handler (Frame.make ((Frame.slots fr).[slot => e]) (Frame.caps fr) (Frame.world fr)) };
    code!
};

/// The body's answer or error, then the cleanup, which `defer!` runs on every way out.
let ensure_code! : Code -> Code -> Code;
let ensure_code! !body !cleanup = { let code! fr = ensured! body cleanup fr; code! };

let ensured! : Code -> Code -> Frame -> :any;
let ensured! body cleanup fr = {
    defer! whnf (cleanup fr);
    whnf (body fr)
};

/// `switch_atom` keys on its subject, a record by its id; `switch_head` on the head of a list
/// cell or the first element of an array.
let switch_code! : Program -> Code -> [:integer] -> :bool -> Code;
let switch_code! prog subject kids on_atom = {
    let img = Program.img prog;
    let arms = list.map (fn [k, t] -> [atom_of prog (image.Node.a (image.node img k)), compile! prog t]) (list.chunks 2 (list.take (list.length kids - 1) kids));
    let table = list.fold (fn m [k, t] -> if map.has k m { m } else { m.[k => t] }) %{} arms;
    switch_built! subject table (compile! prog (list.last kids)) on_atom (named prog "_record_id")
};

let switch_built! : Code -> :map -> Code -> :bool -> :any -> Code;
let switch_built! subject table otherwise on_atom record_id = switch_kept! subject (settled table) otherwise on_atom record_id;

let switch_kept! !subject !table !otherwise !on_atom !record_id = {
    { let code! fr = {
        let s = whnf (subject fr);
        let key = if on_atom { record_key record_id s } else { head_key s };
        match key {
            Option.some(k) => (table.[k else otherwise]) fr,
            Option.none => otherwise fr,
        }
    }; code! }
};

let record_key : :any -> :any -> Option :atom;
let record_key record_id s = match type_of s {
    :atom => Option.some s,
    _ => match record_id s { () => Option.none, id => Option.some id },
};

let head_key : :any -> Option :atom;
let head_key s = match type_of s {
    :list => if list.is_empty s { Option.none } else { atom_or_none (list.head s) },
    :array => if len s > 0 { atom_or_none s.[0] } else { Option.none },
    _ => Option.none,
};

let atom_or_none : :any -> Option :atom;
let atom_or_none v = if type_of v == :atom { Option.some v } else { Option.none };

/// `type_is`'s kinds, in `dream_type`'s order.
let surface_types = #[:integer, :float, :char, :bool, :unit, :string, :atom, :list, :array, :map];

let type_is_code! : Code -> :atom -> :bool -> Code;
let type_is_code! !subject !want !invert = { let code! fr = (type_of (subject fr) == want) != invert; code! };

let record_code! : [Code] -> :atom -> :bool -> :any -> Code;
let record_code! fields id variant make = record_built! (settled fields) id variant make;
let record_built! !fields !id !variant !make = { let code! fr = make id variant (array.of_list ({ let each! f = f fr; list.map each! fields })); code! };

let set_many_code! : Code -> [Code] -> Code;
let set_many_code! container kvs = set_many_built! container (settled kvs);
let set_many_built! !container !kvs = { let code! fr = pairs_onto (container fr) kvs fr; code! };

let pairs_onto : :any -> [Code] -> Frame -> :any;
let pairs_onto acc kvs fr = match kvs {
    [k, v, ..rest] => pairs_onto acc.[k fr => v fr] rest fr,
    _ => acc,
};

// --- running -----------------------------------------------------------------------------

/// The image's `main!`, run: what `dream IMAGE` does, in a world of its own.
let main! : Program -> :any;
let main! prog = {
    let c = function_of prog (image.Image.entry (Program.img prog));
    whnf (invoke c (Compiled.pad c) #[] (world_of prog))
};

when test {
    import std.test;

    let tests = [
        test.case "the builtins are the compiler's, by position" $(
            test.eq! (list.length compiler_builtins.names) builtins.count
        ),
    ];
}
