// Writes src/natives.dr: every member of every module the VM provides, as a
// value under its full name. The VM is what knows the names (`vm.host_members`),
// so this is run on it whenever a native is added:
//
//     dream build/dreams.dream -L mind -o /tmp/natives.dream dre/tools/natives.dr
//     dream /tmp/natives.dream > dre/src/natives.dr
import std.console;
import std.list;
import std.str;
import std.vm;

let modules = ["std.math", "std.tensor", "std.vm", "std.ffi", "std.io", "std.net", "std.tls", "std.crypto", "std.os"];

let short m = str.slice 4 (len m - 4) m;

/// A module's own line -- the module as a value, which `type_of` calls `:module` -- then each member.
let entry! m = match vm.host_members m {
    () => [],
    members => list.cons (str.concat_all ["    \"", m, "\" => ", short m])
        (list.map (fn [name, _] -> str.concat_all ["    \"", m, ".", name, "\" => ", short m, ".", name]) members),
};

let main! = {
    console.print! "// Generated by dre/tools/natives.dr from what the VM says it provides; do not edit.";
    console.print! "// Each member of the VM's own modules, as a value, by its full name: what a `field`";
    console.print! "// of a host module is in an image dre runs.";
    list.each! (fn m -> console.print! ("import " + m + ";")) modules;
    console.print! "";
    console.print! "/// Every native, by `module.member`, and each module by its path. An action, because naming an";
    console.print! "/// impure function is one.";
    console.print! "let table! = %{";
    console.print! (str.join_str ",\n" (list.flat_map entry! modules));
    console.print! "};"
};
