// Lowering: syntax trees into the execution-tree arena.
//
// By the time this runs, every question about what a name means has been
// answered: `scope` recorded which slot, capture, global or builtin each
// occurrence denotes, where every binder put its value, and what function each
// lambda and thunk became. So this pass decides nothing about naming. It walks
// the same trees a second time and emits nodes, looking up rather than working
// out -- which is why it is mostly a table of shapes.
//
// That split is deliberate. A batch compiler could fuse the two passes and
// often does; keeping them apart means the answers exist as a value that
// something other than the emitter can read -- a language server asking what is
// under the cursor, or a console session resolving one expression against a
// program already loaded.
//
// What is *not* here yet: `comp` and `comp!`, which are evaluated at compile
// time and so need a VM to run them on, and the image writer that turns this
// arena into bytes. Both are their own step.

import std.list;
import std.str;
import std.macros;

import dreams.ast;
import dreams.builtins;
import dreams.diag;
import dreams.emit;
import dreams.fuse;
import dreams.ir;
import dreams.opt;
import dreams.modules;
import std.vm;
import dreams.scope;

// --- the lowering state -----------------------------------------------------
//
// The arena being built, the resolutions being read, and which file the code
// came from, so a diagnostic raised this late still points at a line.

let lowering r p source =
    %{ :r => r, :prog => p, :source => source, :ctx => 0, :diags => [],
       // Which node is each function's body. Filled in as the functions are
       // met, because a lambda's body is lowered where it is written -- into
       // the same arena as everything else -- and only the entry point differs.
       :func_bodies => %{},
       // Compile-time expressions waiting to be evaluated: `[node, function]`.
       // The node is a placeholder that whatever the function comes to will
       // overwrite, once the program has been built and can be run.
       :pending_comp => [],
       // Slots that are read but never written, and the expression each one
       // stands for. Only ever non-empty while a fused loop's body is being
       // emitted -- see "deforestation" below.
       :subst => %{} };

let res l    = l.[:r else ()];
let prog l   = l.[:prog else ir.program];
let source l = l.[:source else 0];
/// The module whose names this body was resolved against. Not always the module
/// it was written in: a body inherited through `derive` is lowered once per
/// deriving module, and resolves differently each time.
let ctx l = l.[:ctx else 0];
let l_diags l = l.[:diags else []];

let set_prog p l = l.[:prog => p];
let set_res r l = l.[:r => r];
let set_source i l = l.[:source => i];
let set_ctx i l = l.[:ctx => i];

let func_bodies l = l.[:func_bodies else (%{})];
/// The node index is forced before it is stored, for the reason `ir.settled`
/// gives: an unforced one is a thunk holding the frame that would compute it,
/// and that frame holds this state -- which holds the arena as it stood when
/// the function's body was finished. One per function is not many, but it is
/// one *whole arena* apiece.
let set_func_body fi n l =
    if type_of n != :nothing {
        l.[:func_bodies => (((func_bodies l)).[fi => n])]
    } else { l };

let subst l = l.[:subst else (%{})];
let set_subst m l = l.[:subst => m];

let pending_comp l = l.[:pending_comp else []];
let add_comp node fi l = l.[:pending_comp => (list.append (pending_comp l) [[node, fi]])];

let complain span message l =
    l.[:diags => (list.append (l_diags l) [diag.in_source (source l) (diag.error span message)])];

let warn span message note l =
    l.[:diags => (list.append (l_diags l)
                     [diag.in_source (source l) (diag.with_note note (diag.warning span message))])];

/// Emit a node: `[lowering, index]`.
let emit n l = {
    let [program, index] = ir.push_node n (prog l);
    [set_prog program l, index]
};

let emit_leaf op l = emit (ir.leaf op) l;

let kids xs l = {
    let [program, offset] = ir.push_kids xs (prog l);
    [set_prog program l, offset]
};

let set_flag i f l = set_prog (ir.set_node_flag i f (prog l)) l;

let is_impure_node i l = ir.node_is_impure (ir.node_at i (prog l));

/// Effects are visible through any enclosing node, so the flag travels up.
let inherit i children l =
    if list.any (fn k -> ir.is_node k && is_impure_node k l) children { set_flag i ir.f_impure l }
    else { l };

/// What `scope` recorded for the name at this span.
let lookup span l = scope.resolution (res l) (ctx l) (source l) span;

/// The slot a binder at this span was given.
let slot_at span l =
    expand macros.with_some binding (scope.binding (res l) (ctx l) (source l) span)
        (list.nth 1 binding);

// --- constants ----------------------------------------------------------------

let const_int v l = {
    let [program, index] = ir.intern_int v (prog l);
    emit (ir.node :const_int index ir.no_node ir.no_node) (set_prog program l)
};

let const_float v l = {
    let [program, index] = ir.intern_float v (prog l);
    emit (ir.node :const_float index ir.no_node ir.no_node) (set_prog program l)
};

let const_str v l = {
    let [program, index] = ir.intern_str v (prog l);
    emit (ir.node :const_str index ir.no_node ir.no_node) (set_prog program l)
};

let const_atom v l = {
    let [program, index] = ir.intern_atom v (prog l);
    emit (ir.node :const_atom index ir.no_node ir.no_node) (set_prog program l)
};

let const_char c l = emit (ir.node :const_char (char_code c) ir.no_node ir.no_node) l;
let const_bool b l = emit (ir.node :const_bool (if b { 1 } else { 0 }) ir.no_node ir.no_node) l;

// --- calls ----------------------------------------------------------------------

/// `f a b` is one node with two arguments, not two nested calls: currying is the
/// language's story about partial application, not the VM's about call frames.
let emit_apply callee args l = {
    let placed = kids args l;
    let made = emit (ir.node :apply callee (list.nth 1 placed) (list.length args))
                    (list.head placed);
    let i = list.nth 1 made;
    let inherited = inherit i (list_cons callee args) (list.head made);
    // Calling an impure value is itself an effect, and the callee has to be
    // forced where it stands for that effect to happen in written order.
    let sequenced =
        if is_impure_node callee inherited {
            set_flag callee ir.f_strict (set_flag i ir.f_impure inherited)
        }
        else { inherited };
    [sequenced, i]
};

/// An ordinary call: a saturated call of a wrapper is the call it stands for.
/// See "wrappers" in `scope` -- the rewrite removes a frame that bound nothing
/// but the arguments the inner call was going to get.
let lower_apply callee args span l = {
    let found = callee_resolution callee l;
    match unwrap found args 8 l {
        // ..and a wrapper around a `get` or a `set` is that operation.
        [[:op, kind], actual] => lower_expr (op_expr kind actual span) l,
        [target, actual] => {
            let f = emit_target target l;
            let done = lower_all actual (list.head f);
            emit_apply (list.nth 1 f) (list.nth 1 done) (list.head done)
        },
        _ => {
            let f = lower_callee callee found l;
            let done = lower_all args (list.head f);
            emit_apply (list.nth 1 f) (list.nth 1 done) (list.head done)
        },
    }
};

let builtin_ref name l =
    match builtins.id name {
        () => emit_leaf :unit l,
        b  => emit (ir.node :builtin b ir.no_node ir.no_node) l,
    };

let call_builtin name args l = {
    let got = builtin_ref name l;
    emit_apply (list.nth 1 got) args (list.head got)
};

let binary op a b l = {
    let made = emit (ir.node op a b ir.no_node) l;
    [inherit (list.nth 1 made) [a, b] (list.head made), list.nth 1 made]
};

let bool_and a b l = binary :and a b l;
let eq_const v k l = binary :eq v k l;

// --- names ----------------------------------------------------------------------

// --- wrappers ---------------------------------------------------------------------
//
// `scope` worked out which globals are wrappers -- one application of their own
// parameters and literals, and nothing else. Here a saturated call of one
// becomes the call it stands for, which removes a frame and a call per use.
// Chained wrappers unwrap together: `at_end` is `list.is_empty` is
// `list_is_empty`, and a call of the first emits the last.
//
// The depth cap is not a guess about how deep a chain goes -- two wrappers that
// name each other would unwrap forever, and a compiler must terminate on a
// program that will not run.

/// What the callee of an application resolves to, when it is a name at all.
let callee_resolution callee l =
    match callee {
        [:name, _, span]     => lookup span l,
        [:field, _, field, span] =>
            // As in `lower_field`, the dotted span may resolve to the base
            // value rather than the member -- a field of a value is not a
            // callee resolution, and a call of one must lower as an ordinary
            // expression (and must not be taken for a wrapper's target).
            match lookup span l {
                () => (),
                found => if resolved_name found == field { found } else { () },
            },
        _ => (),
    };

/// The call site's arguments, rebuilt as the wrapper's body arranged them.
let wrapper_actuals plan args =
    list.map (fn step ->
        match step {
            [:param, k] => list.nth k args,
            [:const, e] => e,
        }) plan;

/// The container operation a wrapper stands for, rebuilt around a call's own
/// arguments. They are syntax rather than nodes, so each is lowered exactly
/// where it would have been -- the same promise the call rewrite makes.
let op_expr kind operands span =
    match kind {
        :get => ast.get_e (list.nth 0 operands) (list.nth 1 operands)
                          (if list.length operands > 2 { list.nth 2 operands } else { () }) span,
        _    => ast.set_e (list.nth 0 operands) (list.nth 1 operands) (list.nth 2 operands) span,
    };

/// `[target, arguments]` when this is a saturated call of a wrapper, or `()`.
///
/// The arguments are syntax, not nodes: they are lowered at the call site
/// exactly as they would have been, which is what keeps every one of them the
/// same thunk in the same place.
let rec unwrap found args fuel l =
    if fuel <= 0 { () }
    else {
        match found {
            [:global, _, _, g]           => unwrap_global found g args fuel l,
            [:member, [:dream, _], _, g] => unwrap_global found g args fuel l,
            _ => (),
        }
    };

let unwrap_global found g args fuel l =
    match ((scope.wrappers (res l))).[g else ()] {
        () => (),
        [target, plan, arity] =>
            if list.length args != arity { () }
            else {
                let actual = wrapper_actuals plan args;
                // The target may be a wrapper too, and unwrapping stops at
                // whatever is not one -- which is the answer either way.
                match unwrap target actual (fuel - 1) l {
                    () => [target, actual],
                    deeper => deeper,
                }
            },
    };

/// The callee of an application, given what it resolved to. A name or a member
/// whose resolution is already in hand skips the second lookup; anything else
/// is an ordinary expression.
let lower_callee callee found l =
    match callee {
        [:name, n, span] =>
            match found { () => lower_expr callee l, _ => lower_resolved n found span l },
        [:field, _, field, span] =>
            match found {
                () => lower_expr callee l,
                _ =>
                    // A resolution naming the base rather than the field is
                    // nothing to do with a callee; the call is ordinary.
                    if resolved_name found == field { lower_resolved field found span l }
                    else { lower_expr callee l },
            },
        _ => lower_expr callee l,
    };

/// The node for a wrapper's target, marked impure when the name it ends in
/// says so -- the same rule `lower_name` applies to a name written by hand.
let emit_target found l = {
    let got = emit_resolution found l;
    if builtins.is_impure_name (resolved_name found) {
        [set_flag (list.nth 1 got) ir.f_impure (list.head got), list.nth 1 got]
    }
    else { got }
};

/// The name a resolution ends in, which is what says whether it is impure.
let resolved_name found =
    match found {
        [:builtin, name] => name,
        [:global, _, name, _] => name,
        [:member, _, field, _] => field,
        _ => "",
    };

/// A name, as `scope` already decided it. The only work left is which node
/// shape carries the answer -- and marking it impure when the name says so, so
/// that the VM sequences the effect rather than only the compiler knowing about
/// it. `scope` refused the pure functions that reach an effect; this records
/// which nodes *are* one.
let lower_name name span l = lower_resolved name (lookup span l) span l;

/// The same, for a caller that has already asked what the name resolves to.
/// Applications ask, because a call of a wrapper is rewritten and one that is
/// not should not pay for the question twice.
let lower_resolved name found span l = {
    let got = emit_resolution_or found span l;
    if builtins.is_impure_name name {
        [set_flag (list.nth 1 got) ir.f_impure (list.head got), list.nth 1 got]
    }
    else { got }
};

let emit_name span l = emit_resolution (lookup span l) l;

/// A local, or -- when nothing ever writes that slot -- the expression it
/// stands for, lowered here. The slot is taken out of the substitution while
/// its own expression is lowered, so a table that somehow named itself would
/// stop rather than spin; nothing builds one, and a compiler must terminate on
/// a program that will not run.
let emit_local slot l =
    match ((subst l)).[slot else ()] {
        () => emit (ir.node :local slot ir.no_node ir.no_node) l,
        e  => {
            let got = lower_expr e (set_subst (map_remove (subst l) slot) l);
            [set_subst (subst l) (list.head got), list.nth 1 got]
        },
    };

/// A recorded resolution, or -- when there is none -- whatever `emit_resolution`
/// makes of that, which is the same unit placeholder it always was.
let emit_resolution_or found span l = emit_resolution found l;

/// One resolution, as the node that fetches it. Separate from `emit_name`
/// because a wrapper's call site emits a resolution it did not read off a name.
let emit_resolution found l =
    match found {
        [:local, slot, _]   => emit_local slot l,
        [:capture, idx, _]  => emit (ir.node :capture idx ir.no_node ir.no_node) l,
        [:global, _, _, g]  => emit (ir.node :global g ir.no_node ir.no_node) l,
        [:builtin, name]    => builtin_ref name l,
        [:closure, fi]      => emit (ir.node :make_closure fi ir.no_node ir.no_node) l,
        [:thunk, fi]        => emit (ir.node :make_thunk fi ir.no_node ir.no_node) l,
        // A Dream module's member is one global, known at compile time. A host
        // module's is a field of the module value, looked up at run time,
        // because the host owns the table.
        [:member, [:dream, _], _, g] => emit (ir.node :global g ir.no_node ir.no_node) l,
        [:member, [:native, _, mg], field, _] => {
            let obj = emit (ir.node :global mg ir.no_node ir.no_node) l;
            let named = ir.intern_str field (prog (list.head obj));
            emit (ir.node :field (list.nth 1 obj) (list.nth 1 named) ir.no_node)
                 (set_prog (list.head named) (list.head obj))
        },
        // Resolution already complained; a unit keeps the arena well formed so
        // the rest of the program still lowers and every error is reported at
        // once rather than one per run.
        _ => emit_leaf :unit l,
    };

// --- expressions -----------------------------------------------------------------

let rec lower_expr e l =
    match e {
        [:int, v, _]   => const_int v l,
        [:float, v, _] => const_float v l,
        [:str, v, _]   => const_str v l,
        [:char, c, _]  => const_char c l,
        [:bool, b, _]  => const_bool b l,
        [:atom, n, _]  => const_atom n l,
        [:unit, _]     => emit_leaf :unit l,

        // A name `scope` staged stands for the stage that was bound to it and
        // read here once. The `let` that bound it is gone from the block
        // below, so this is the only place the body is written -- which is the
        // whole of what staging does when the pipeline turns out not to fuse.
        [:name, n, span] =>
            match scope.staging (res l) (ctx l) (source l) span {
                [:body, body] => lower_expr body l,
                _ => lower_name n span l,
            },
        [:field, _, _, span] => lower_field e span l,

        // A pipeline `scope` decided to fuse is a loop and a call of it, and
        // neither the producer nor the consumer is called at all. Asked first,
        // because everything below is about a call that still happens.
        [:apply, callee, args, span] =>
            match scope.fusion (res l) (ctx l) (source l) span {
                () => lower_apply callee args span l,
                p  => lower_fused p l,
            },

        // `x |> f a` is folded into the single call `f a x` rather than a call
        // of a call. That is what lets a variadic host function take everything
        // at the call site, which a nested application would split up.
        [:pipe, lhs, rhs, span] =>
            match rhs {
                [:apply, callee, args, _] =>
                    lower_expr (ast.apply_e callee (list.append args [lhs]) span) l,
                _ => lower_expr (ast.apply_e rhs [lhs] span) l,
            },

        // `:neg` and `:not` are what the parser already calls them, and what
        // the arena calls them, so there is nothing to translate.
        [:unary, op, x, _] => {
            let a = lower_expr x l;
            binary op (list.nth 1 a) ir.no_node (list.head a)
        },

        [:binary, op, lhs, rhs, _] => {
            let a = lower_expr lhs l;
            let b = lower_expr rhs (list.head a);
            binary op (list.nth 1 a) (list.nth 1 b) (list.head b)
        },

        [:if, cond, t, el, _] => {
            let c = lower_expr cond l;
            let a = lower_expr t (list.head c);
            let b = match el {
                () => emit_leaf :unit (list.head a),
                x  => lower_expr x (list.head a),
            };
            let made = emit (ir.node :if (list.nth 1 c) (list.nth 1 a) (list.nth 1 b))
                            (list.head b);
            // The condition decides which branch runs, so it is forced here
            // rather than wherever its value happens to be wanted.
            [set_flag (list.nth 1 c) ir.f_strict
                (inherit (list.nth 1 made) [list.nth 1 c, list.nth 1 a, list.nth 1 b]
                         (list.head made)),
             list.nth 1 made]
        },

        [:block, stmts, span] => lower_block stmts span l,

        // A lambda and a thunk are functions `scope` already numbered. Their
        // bodies are lowered here, into the same arena as everything else --
        // a function is a body node and a descriptor, not a separate arena --
        // and what is emitted in their place is the instruction that makes one
        // at run time.
        [:lambda, ps, body, span] => lower_function span :make_closure ps body l,
        [:thunk, body, span] => lower_function span :make_thunk [] body l,

        [:try, body, _, handler, span] => {
            let b = lower_expr body l;
            let h = lower_expr handler (list.head b);
            let held = expand macros.coalesce (slot_at span (list.head h)) 0;
            let made = emit (ir.node :try (list.nth 1 b) (list.nth 1 h) held) (list.head h);
            [inherit (list.nth 1 made) [list.nth 1 b, list.nth 1 h] (list.head made),
             list.nth 1 made]
        },

        [:list, xs, _]  => lower_seq :make_list xs l,
        [:array, xs, _] => lower_seq :make_array xs l,
        [:map, pairs, _] =>
            lower_seq :make_map
                      (list.concat (list.map (fn kv -> [list.nth 0 kv, list.nth 1 kv]) pairs))
                      l,

        [:match, scrutinee, arms, span] => lower_match scrutinee arms span l,

        // `comp` and `comp!` are evaluated before the program runs, which means
        // running them -- so the expression is lowered into a function of its
        // own and a placeholder is left where its value will go. What it comes
        // to is not known until the whole program has been built, because the
        // expression may call any of it.
        [:comp, _, body, span] =>
            match lookup span l {
                [:comp, fi, _] => {
                    let inner = lower_expr body l;
                    let done = set_func_body fi (list.nth 1 inner)
                                             (mark_tail (list.nth 1 inner) (list.head inner));
                    let made = emit_leaf :unit done;
                    [add_comp (list.nth 1 made) fi (list.head made), list.nth 1 made]
                },
                _ => emit_leaf :unit l,
            },

        // A container read or changed at a key. A `get`'s fallback is lowered
        // where it is written and only evaluated when the key is missing; a
        // `set`'s value is stored unforced, as a map literal's values are.
        [:get, container, key, fallback, _] => {
            let a = lower_expr container l;
            let b = lower_expr key (list.head a);
            let f = match fallback {
                () => [list.head b, ir.no_node],
                x  => lower_expr x (list.head b),
            };
            let made = emit (ir.node :get (list.nth 1 a) (list.nth 1 b) (list.nth 1 f)) (list.head f);
            [inherit (list.nth 1 made) [list.nth 1 a, list.nth 1 b, list.nth 1 f] (list.head made),
             list.nth 1 made]
        },
        [:set, container, key, value, _] => {
            let a = lower_expr container l;
            let b = lower_expr key (list.head a);
            let v = lower_expr value (list.head b);
            let made = emit (ir.node :set (list.nth 1 a) (list.nth 1 b) (list.nth 1 v)) (list.head v);
            [inherit (list.nth 1 made) [list.nth 1 a, list.nth 1 b, list.nth 1 v] (list.head made),
             list.nth 1 made]
        },

        // What a top-level destructuring became in `scope`: the hidden global
        // holding the checked value, and a global per name.
        [:destructure, pattern, body, span] => lower_destructure pattern body span l,
        [:destructured, hidden, pattern, name_span] => lower_destructured hidden pattern name_span l,

        _ => emit_leaf :unit l,
    };

/// A nested function: lower its body, remember which node that was, and emit
/// the instruction that builds the closure or thunk.
let rec lower_function span op ps body l =
    match lookup span l {
        [_, fi] => {
            let inner = lower_body ps body l;
            let done = set_func_body fi (list.nth 1 inner)
                                     (mark_tail (list.nth 1 inner) (list.head inner));
            let made = emit (ir.node op fi ir.no_node ir.no_node) done;
            // Suspending an effect is not performing one, so a thunk is a pure
            // value -- unless what it suspends is effectful, in which case
            // whoever forces it is performing that effect and needs to know.
            if is_impure_node (list.nth 1 inner) done {
                [set_flag (list.nth 1 made) ir.f_impure (list.head made), list.nth 1 made]
            }
            else { made }
        },
        _ => emit_leaf :unit l,
    };

/// A function's body, with its strict parameters forced and its pattern
/// parameters taken apart in front of it.
///
/// A strict parameter is a strict statement reading its slot, first and in
/// parameter order: a block evaluates a strict non-final statement, and
/// evaluating a `local` forces what is in it. So the function is strict in
/// that parameter on every path, which is also exactly what the JIT's
/// admission test asks (`Analyzer::strict_of` counts strict statements).
///
/// Such a parameter's argument arrives in its slot like any other -- a function's
/// parameters are its first slots, in order -- and its names are bound out of
/// that slot before the body runs. They are bound lazily, as a destructuring
/// `let` binds them, so naming an argument's parts makes a function no stricter
/// in it.
let lower_body ps body l =
    if not (list.any (fn p -> has_pattern p || ast.param_strict p) ps) { lower_expr body l }
    else {
        let forced = list.fold (fn acc pair ->
            if not (ast.param_strict (list.nth 0 pair)) { acc }
            else {
                let read = emit (ir.node :local (list.nth 1 pair) ir.no_node ir.no_node) (list.head acc);
                [set_flag (list.nth 1 read) ir.f_strict (list.head read),
                 list.append (list.nth 1 acc) [list.nth 1 read]]
            }) [l, []] (list.zip ps (list.range 0 (list.length ps)));
        let bound = list.fold (fn acc pair ->
            match ast.param_pattern (list.nth 0 pair) {
                () => acc,
                pattern => {
                    let arg = emit (ir.node :local (list.nth 1 pair) ir.no_node ir.no_node) (list.head acc);
                    let parts = destructure pattern (list.nth 1 arg) (list.head arg);
                    [list.head parts, list.append (list.nth 1 acc) (list.nth 1 parts)]
                },
            }) [list.head forced, list.nth 1 forced] (list.zip ps (list.range 0 (list.length ps)));
        let inner = lower_expr body (list.head bound);
        let stmts = list.append (list.nth 1 bound) [list.nth 1 inner];
        let placed = kids stmts (list.head inner);
        let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node)
                        (list.head placed);
        [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
    };

let has_pattern p = match ast.param_pattern p { () => false, _ => true };

/// Lower a list of expressions, keeping their order: `[lowering, indices]`.
let rec lower_all es l =
    list.fold (fn acc e -> {
        let got = lower_expr e (list.head acc);
        [list.head got, list.append (list.nth 1 acc) [list.nth 1 got]]
    }) [l, []] es;

let rec lower_seq op items l = {
    let done = lower_all items l;
    let placed = kids (list.nth 1 done) (list.head done);
    let n = if op == :make_map { list.length items / 2 } else { list.length items };
    let made = emit (ir.node op (list.nth 1 placed) n ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) (list.nth 1 done) (list.head made), list.nth 1 made]
};

/// A runtime field read: the object is a value and the field is looked up on
/// it when the program runs.
let lower_value_field obj field l = {
    let o = lower_expr obj l;
    let named = ir.intern_str field (prog (list.head o));
    let made = emit (ir.node :field (list.nth 1 o) (list.nth 1 named) ir.no_node)
                    (set_prog (list.head named) (list.head o));
    [inherit (list.nth 1 made) [list.nth 1 o] (list.head made), list.nth 1 made]
};

/// A module member written with a dot. When the object is a namespace the whole
/// thing is one name, already resolved; otherwise it is a field of a value.
///
/// The field node's span begins where the base name's does -- the parser widens
/// the primary's span over the dotted name -- so the lookup above may answer
/// the *base's* resolution rather than the member's. Only a namespace member's
/// resolution names the field it ends in; a resolution naming anything else is
/// the base value leaking through, and the field is read at run time.
let rec lower_field e span l =
    match lookup span l {
        () =>
            match e {
                [:field, obj, field, _] => lower_value_field obj field l,
                _ => emit_leaf :unit l,
            },
        found =>
            match e {
                [:field, obj, field, _] =>
                    if resolved_name found == field { lower_name field span l }
                    else { lower_value_field obj field l },
                _ => emit_leaf :unit l,
            },
    };

let rec lower_block stmts span l = {
    // A statement lowers to one node, except a destructuring `let`, which
    // lowers to several binds. So each node travels with the statement it came
    // from, which is what a warning about a discarded value points at.
    let done = list.fold (fn acc st ->
        match st {
            // A `let` whose body was written where it is read binds nothing and
            // lowers to nothing. It contributes no node, so it is not a
            // statement whose value could be discarded either.
            [:let, _, _, _, _, sp] if scope.staging (res l) (ctx l) (source l) sp == :elided =>
                acc,
            // A signature is a promise to the type checker. It lowers to
            // nothing, so it is not a statement either.
            [:sig, _, _, _] => acc,

            [:let, n, ps, body, _, sp] => {
                let value =
                    if list.is_empty ps { lower_expr body (list.head acc) }
                    // A local `let f x = ..` is a function like any other: it
                    // was numbered by `scope` and its body is lowered here.
                    else { lower_function sp :make_closure ps body (list.head acc) };
                let held = expand macros.coalesce (slot_at sp (list.head value)) 0;
                let bound = bind_value held (list.nth 1 value) (list.head value);
                [list.head bound, list.append (list.nth 1 acc) [[list.nth 1 bound, st]]]
            },
            // The value is held exactly as a plain `let` holds it, and the names
            // are bound out of it -- see "destructuring".
            [:let_p, pattern, body, sp] => {
                let value = lower_expr body (list.head acc);
                let held = expand macros.coalesce (slot_at sp (list.head value)) 0;
                let bound = bind_value held (list.nth 1 value) (list.head value);
                let reader = emit (ir.node :local held ir.no_node ir.no_node) (list.head bound);
                let parts = destructure pattern (list.nth 1 reader) (list.head reader);
                [list.head parts,
                 list.append (list.nth 1 acc)
                     (list.map (fn k -> [k, st]) (list_cons (list.nth 1 bound) (list.nth 1 parts)))]
            },
            _ => {
                let got = lower_expr st (list.head acc);
                [list.head got, list.append (list.nth 1 acc) [[list.nth 1 got, st]]]
            },
        }) [l, []] stmts;
    // A non-final statement contributes nothing but its effects. Inside an
    // impure function force it, so those effects happen in the order they were
    // written rather than whenever something happens to want the value. Inside
    // a pure one there are no effects to have, so it is dead code -- and
    // forcing it would only risk raising an error the program never asked for.
    let impure_here = match lookup span (list.head done) { [:block, yes] => yes, _ => false };
    let pairs = list.nth 1 done;
    let stmt_nodes = list.map (fn pair -> list.nth 0 pair) pairs;
    let sequenced =
        if list.length pairs <= 1 { list.head done }
        else {
            list.fold (fn acc pair -> {
                let k = list.nth 0 pair;
                let st = list.nth 1 pair;
                // A bind stays lazy: the ones whose value is effectful were
                // already forced where they were bound.
                if ir.node_op (ir.node_at k (prog acc)) == :bind { acc }
                else if impure_here { set_flag k ir.f_strict acc }
                else if is_impure_node k acc { acc }
                else {
                    warn (ast.span st)
                         "this statement's value is discarded, and a pure expression has no other effect"
                         "only the final expression of a block is used" acc
                }
            }) (list.head done) (list.take (list.length pairs - 1) pairs)
        };
    let placed = kids stmt_nodes sequenced;
    let made = emit (ir.node :block (list.nth 1 placed) (list.length stmt_nodes) ir.no_node)
                    (list.head placed);
    [inherit (list.nth 1 made) stmt_nodes (list.head made), list.nth 1 made]
};

/// A block's bind: `[lowering, node]`. Lazy, unless the value has effects --
/// binding an effectful expression sequences it here rather than at first use,
/// so effects happen in written order.
let bind_value slot value l = {
    let made = emit (ir.node :bind slot value ir.no_node) l;
    let i = list.nth 1 made;
    let inherited = inherit i [value] (list.head made);
    if is_impure_node value inherited {
        [set_flag value ir.f_strict (set_flag i ir.f_strict inherited), i]
    }
    else { [inherited, i] }
};

// --- deforestation ----------------------------------------------------------------
//
// `scope` decided that a pipeline of `std.list` combinators is one loop, gave
// that loop a function and a global, and resolved the fold's function inside
// it. What is left is to write the loop out.
//
// Every fused loop has the same shape, whichever source it came from:
//
//     let rec loop cursor carried acc =
//         if <done> { acc } else { loop <next> carried <step> };
//
// `range` counts the cursor up and carries its limit; `replicate` counts it
// down and carries the element. Three parameters and no captures, because the
// JIT compiles a function of its arguments and a capture is a frame it would
// have to keep -- and a global callee is the only self call it recognises at
// all (`check_self_call` in dream/src/jit.cpp).

let local_node slot l = emit (ir.node :local slot ir.no_node ir.no_node) l;

/// The call that enters the loop: the producer's arguments, in the order they
/// were written, and then the seed. They are lowered here, in the frame the
/// pipeline was written in, which is where they were always going to be
/// evaluated -- and so with whatever substitution was already in force, which
/// is how a pipeline written inside another one's stage still works.
let lower_fused p l = {
    let outer = subst l;
    let built = set_subst outer (fused_body p (set_subst (subst_of p) l));
    let inits = lower_all (list.nth 1 (fuse.plan_source p)) built;
    let seeded =
        match fuse.plan_seed p {
            [:expr, e] => lower_expr e (list.head inits),
            [:int, v]  => const_int v (list.head inits),
            _          => emit_leaf :unit (list.head inits),
        };
    let callee = emit (ir.node :global (fuse.plan_gi p) ir.no_node ir.no_node)
                      (list.head seeded);
    emit_apply (list.nth 1 callee)
               (list.append (list.nth 1 inits) [list.nth 1 seeded])
               (list.head callee)
};

let subst_of p =
    list.fold (fn m e -> m.[(list.nth 0 e) => (list.nth 1 e)])
              (%{}) (fuse.plan_subst p);

/// The loop itself, emitted into the same arena as everything else -- a
/// function is a body node and a descriptor, not an arena of its own.
let fused_body p l = {
    let stag = list.nth 0 (fuse.plan_source p);
    let replicating = stag == :replicate;

    // Done: `range` stops at its limit, `replicate` when there is nothing left
    // to repeat. Both are the condition the combinator itself tests, said
    // about a counter instead of about a list.
    let cur0 = local_node fuse.cursor_slot l;
    let done =
        if replicating {
            let zero = const_int 0 (list.head cur0);
            binary :le (list.nth 1 cur0) (list.nth 1 zero) (list.head zero)
        }
        else {
            let limit = local_node fuse.carried_slot (list.head cur0);
            binary :ge (list.nth 1 cur0) (list.nth 1 limit) (list.head limit)
        };

    let answer = local_node fuse.acc_slot (list.head done);

    // The turn that takes this element, and -- when a `filter` says it might
    // not be taken -- the turn that leaves the accumulator alone.
    let taken = self_turn p replicating (fn l0 -> fused_step p l0) (list.head answer);
    let advanced =
        match fuse.plan_guards p {
            [] => taken,
            gs => {
                let cond = lower_guards gs (list.head taken);
                let skipped = self_turn p replicating (fn l0 -> local_node fuse.acc_slot l0)
                                        (list.head cond);
                let made = emit (ir.node :if (list.nth 1 cond) (list.nth 1 taken)
                                         (list.nth 1 skipped))
                                (list.head skipped);
                [set_flag (list.nth 1 cond) ir.f_strict
                    (inherit (list.nth 1 made)
                             [list.nth 1 cond, list.nth 1 taken, list.nth 1 skipped]
                             (list.head made)),
                 list.nth 1 made]
            },
        };
    let otherwise =
        if fuse.plan_strict p { forced_acc (list.nth 1 advanced) (list.head advanced) }
        else { advanced };

    let made = emit (ir.node :if (list.nth 1 done) (list.nth 1 answer) (list.nth 1 otherwise))
                    (list.head otherwise);
    let i = list.nth 1 made;
    let settled =
        set_flag (list.nth 1 done) ir.f_strict
            (inherit i [list.nth 1 done, list.nth 1 answer, list.nth 1 otherwise]
                     (list.head made));
    set_func_body (fuse.plan_fi p) i (mark_tail i settled)
};

/// One turn of the loop: the cursor moved on, whatever the source carries
/// passed through untouched, and whatever accumulator the caller asks for.
///
/// Emitted fresh every time it is wanted, rather than built once and pointed
/// at twice. The arena is a tree -- a node reached from two parents would be
/// walked twice by everything that reads it, and would take a flag meant for
/// one of them in both places.
let self_turn p replicating acc_at l = {
    let cur = local_node fuse.cursor_slot l;
    let one = const_int 1 (list.head cur);
    let advanced = binary (if replicating { :sub } else { :add })
                          (list.nth 1 cur) (list.nth 1 one) (list.head one);
    let carried = local_node fuse.carried_slot (list.head advanced);
    let acc = acc_at (list.head carried);
    let callee = emit (ir.node :global (fuse.plan_gi p) ir.no_node ir.no_node)
                      (list.head acc);
    emit_apply (list.nth 1 callee)
               [list.nth 1 advanced, list.nth 1 carried, list.nth 1 acc]
               (list.head callee)
};

/// The `filter`s, as one condition. `and` is short-circuiting, which is what
/// keeps the order right: an element the first filter rejects never reaches
/// the second, exactly as it never reached the second `filter`'s call.
let lower_guards gs l =
    list.fold (fn acc g -> {
        let got = lower_expr g (list.head acc);
        match list.nth 1 acc {
            () => [list.head got, list.nth 1 got],
            prev => binary :and prev (list.nth 1 got) (list.head got),
        }
    }) [l, ()] gs;

/// What the accumulator becomes: the fold's own function, whose parameters
/// `scope` bound to these very slots, or the operator `sum` and `product`
/// stand for.
let fused_step p l =
    match fuse.plan_step p {
        [:ast, body] => lower_expr body l,
        [:op, op] => {
            let a = local_node fuse.acc_slot l;
            let x = emit_local (fuse.plan_elem p) (list.head a);
            binary (if op == :mul { :mul } else { :add })
                   (list.nth 1 a) (list.nth 1 x) (list.head x)
        },
        _ => emit_leaf :unit l,
    };

/// `fold_strict`, which forces each step before taking the next.
///
/// It forces the accumulator at the *top* of the following iteration rather
/// than at the bottom of this one, which comes to the same thing -- the chain
/// of suspensions never gets past one link either way -- and is the only way
/// to say it that the JIT can still take. A `let` would need a slot the frame
/// holds, and a compiled frame's slots are registers; a statement is just a
/// statement, and one marked strict is run where it stands.
let forced_acc call l = {
    let acc = local_node fuse.acc_slot l;
    let forced = emit (ir.node :force (list.nth 1 acc) ir.no_node ir.no_node) (list.head acc);
    let marked = set_flag (list.nth 1 forced) ir.f_strict (list.head forced);
    let placed = kids [list.nth 1 forced, call] marked;
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [list.nth 1 forced, call] (list.head made), list.nth 1 made]
};

// --- patterns ---------------------------------------------------------------------
//
// A pattern becomes a test and a set of bindings. The test answers whether the
// arm is taken; the bindings say what its body may name. Nothing is forced
// beyond what deciding takes, which is what keeps `match` usable on a lazy
// structure -- walking a list one cell at a time rather than asking its length.

/// `[lowering, test, binds]`, where a bind is `[span, value node]` -- the span
/// being where the binder was written, which is how the slot is found.
let rec pattern_test p subject binds l =
    match p {
        [:wildcard, _] => { let t = const_bool true l; [list.head t, list.nth 1 t, binds] },
        [:bind, _, span] => {
            let t = const_bool true l;
            [list.head t, list.nth 1 t, list.append binds [[span, subject]]]
        },
        [:as_p, inner, _, name_span, _] =>
            pattern_test inner subject (list.append binds [[name_span, subject]]) l,
        [:literal, e, _] => {
            let k = lower_expr e l;
            let cmp = eq_const subject (list.nth 1 k) (list.head k);
            [list.head cmp, list.nth 1 cmp, binds]
        },
        [:list_p, items, rest, _]     => list_test items rest subject binds l,
        [:array_p, items, rest, span] => array_test items rest subject binds span l,
        [:map_p, pairs, span] => map_test pairs subject binds span l,
        _ => { let t = const_bool true l; [list.head t, list.nth 1 t, binds] },
    };

/// The value must be a list at all. Without this `[]` would match anything that
/// is not a cons cell -- an array, a map, a number -- because "not a cell" and
/// "the end of a list" look the same from `match_is_cons` alone. `type_of`
/// answers `:list` for both the empty list and a cell, so one test covers every
/// list pattern.
let rec is_type name subject l = {
    let ty = call_builtin "type_of" [subject] l;
    let want = const_atom name (list.head ty);
    eq_const (list.nth 1 ty) (list.nth 1 want) (list.head want)
};

let rec list_test items rest subject binds l = {
    let typed = is_type "list" subject l;
    // Walked one cell at a time, so nothing beyond what the pattern names is
    // ever forced.
    let walked = list.fold (fn acc item -> {
        let l0 = list.nth 0 acc;
        let test = list.nth 1 acc;
        let cursor = list.nth 2 acc;
        let bs = list.nth 3 acc;
        let cons_test = call_builtin "match_is_cons" [cursor] l0;
        let with_cons = bool_and test (list.nth 1 cons_test) (list.head cons_test);
        let head = call_builtin "match_head" [cursor] (list.head with_cons);
        let inner = pattern_test item (list.nth 1 head) bs (list.head head);
        let both = bool_and (list.nth 1 with_cons) (list.nth 1 inner) (list.nth 0 inner);
        let tail = call_builtin "match_tail" [cursor] (list.head both);
        [list.head tail, list.nth 1 both, list.nth 1 tail, list.nth 2 inner]
    }) [list.head typed, list.nth 1 typed, subject, binds] items;

    let l1 = list.nth 0 walked;
    let test = list.nth 1 walked;
    let cursor = list.nth 2 walked;
    let bs = list.nth 3 walked;
    match rest {
        // `..` takes whatever is left, including nothing, so there is no
        // further test -- only a binding, when it was named.
        [()] => [l1, test, bs],
        [_, name_span] => [l1, test, list.append bs [[name_span, cursor]]],
        // A fixed-length list: what is left must be the end.
        _ => {
            let cons_test = call_builtin "match_is_cons" [cursor] l1;
            let ends = binary :not (list.nth 1 cons_test) ir.no_node (list.head cons_test);
            let both = bool_and test (list.nth 1 ends) (list.head ends);
            [list.head both, list.nth 1 both, bs]
        },
    }
};

/// An array knows its own length, so the shape is one comparison rather than a
/// walk.
let rec array_test items rest subject binds span l = {
    let typed = is_type "array" subject l;
    let length = call_builtin "len" [subject] (list.head typed);
    let want = const_int (list.length items) (list.head length);
    let sized =
        if rest == () { eq_const (list.nth 1 length) (list.nth 1 want) (list.head want) }
        else { binary :ge (list.nth 1 length) (list.nth 1 want) (list.head want) };
    let start = bool_and (list.nth 1 typed) (list.nth 1 sized) (list.head sized);

    let done = list.fold (fn acc pair -> {
        let l0 = list.nth 0 acc;
        let at = const_int (list.nth 1 pair) l0;
        let element = call_builtin "match_at" [subject, list.nth 1 at] (list.head at);
        let inner = pattern_test (list.nth 0 pair) (list.nth 1 element) (list.nth 2 acc)
                                (list.head element);
        let both = bool_and (list.nth 1 acc) (list.nth 1 inner) (list.nth 0 inner);
        [list.head both, list.nth 1 both, list.nth 2 inner]
    }) [list.head start, list.nth 1 start, binds]
       (list.zip items (list.range 0 (list.length items)));

    // `#[a, ..rest]` names the remainder, which an array cannot hand back
    // without copying, so it is reported rather than silently allocating.
    match rest {
        [name, _] =>
            [complain span ("`.." + name + "` cannot name the rest of an array")
                      (list.nth 0 done),
             list.nth 1 done, list.nth 2 done],
        _ => done,
    }
};

let rec map_test pairs subject binds span l = {
    let typed = is_type "map" subject l;
    list.fold (fn acc kv -> {
        let l0 = list.nth 0 acc;
        let k = lower_expr (list.nth 0 kv) l0;
        // `[v]` when the key is there, `[]` when it is not -- so presence and
        // the value come out of one lookup.
        let found = call_builtin "match_key" [subject, list.nth 1 k] (list.head k);
        let present = call_builtin "match_is_cons" [list.nth 1 found] (list.head found);
        let with_key = bool_and (list.nth 1 acc) (list.nth 1 present) (list.head present);
        let held = call_builtin "match_head" [list.nth 1 found] (list.head with_key);
        let inner = pattern_test (list.nth 1 kv) (list.nth 1 held) (list.nth 2 acc) (list.head held);
        let both = bool_and (list.nth 1 with_key) (list.nth 1 inner) (list.nth 0 inner);
        [list.head both, list.nth 1 both, list.nth 2 inner]
    }) [list.head typed, list.nth 1 typed, binds] pairs
};

// --- destructuring ----------------------------------------------------------------
//
// A destructuring `let`, a pattern parameter and a top-level destructuring all
// come to the same two steps. The value is checked against the pattern by the
// very test a `match` arm makes, and bound, checked, to a slot of its own; then
// each name is bound to its part of *that* slot. Every one of those binds is lazy,
// so nothing happens until a name is used -- and reading any name's part forces
// the checked slot first, which runs the check once for all of them.

/// The value if it fits the pattern, and a raise of `:match_error` if it does
/// not: a `match` whose one arm hands the value back.
let check_value pattern value l = {
    let tested = pattern_test pattern value [] l;
    let test = list.nth 1 tested;
    let kind = const_atom "match_error" (list.nth 0 tested);
    let raised = call_builtin "raise!" [list.nth 1 kind] (list.head kind);
    let failing = set_flag (list.nth 1 raised) ir.f_strict (list.head raised);
    let made = emit (ir.node :if test value (list.nth 1 raised)) failing;
    [set_flag test ir.f_strict
        (inherit (list.nth 1 made) [test, value, list.nth 1 raised] (list.head made)),
     list.nth 1 made]
};

/// The binds a destructuring comes to, given a node that reads the value:
/// `[lowering, binds]`. The first holds the checked value, and each of the rest
/// binds a name to its part of the first.
let destructure pattern value l = {
    let checked = check_value pattern value l;
    let slot = expand macros.coalesce (slot_at (scope.checked_span pattern) (list.head checked)) 0;
    let held = emit (ir.node :bind slot (list.nth 1 checked) ir.no_node) (list.head checked);
    let reader = emit (ir.node :local slot ir.no_node ir.no_node) (list.head held);
    let parts = extract pattern (list.nth 1 reader) (fn _ -> true) [] (list.head reader);
    list.fold (fn acc part -> {
        let s = expand macros.coalesce (slot_at (list.nth 0 part) (list.head acc)) 0;
        let made = emit (ir.node :bind s (list.nth 1 part) ir.no_node) (list.head acc);
        [list.head made, list.append (list.nth 1 acc) [list.nth 1 made]]
    }) [list.nth 0 parts, [list.nth 1 held]] (list.nth 1 parts)
};

/// The parts of a value a pattern names, as `[lowering, binds]` with each bind
/// `[span, node]` -- what `pattern_test` answers, without the test, which has
/// already been made. Only what `want` asks for is walked to: a name of a
/// top-level destructuring is a global of its own and reads its one part, not
/// every part.
///
/// These are the accessors a `match` uses. They force the cells on the way,
/// which the check already forced, and never the part itself.
let rec extract p subject want binds l =
    match p {
        [:bind, _, span] =>
            [l, if want span { list.append binds [[span, subject]] } else { binds }],
        [:as_p, inner, _, name_span, _] =>
            extract inner subject want
                    (if want name_span { list.append binds [[name_span, subject]] } else { binds }) l,
        [:list_p, items, rest, _] => extract_list items rest subject want binds l,
        [:array_p, items, _, _] =>
            list.fold (fn acc pair ->
                if not (wants want (list.nth 0 pair)) { acc }
                else {
                    let at = const_int (list.nth 1 pair) (list.nth 0 acc);
                    let element = call_builtin "match_at" [subject, list.nth 1 at] (list.head at);
                    extract (list.nth 0 pair) (list.nth 1 element) want (list.nth 1 acc)
                            (list.head element)
                }) [l, binds] (list.zip items (list.range 0 (list.length items))),
        [:map_p, pairs, _] =>
            list.fold (fn acc kv ->
                if not (wants want (list.nth 1 kv)) { acc }
                else {
                    let k = lower_expr (list.nth 0 kv) (list.nth 0 acc);
                    let found = call_builtin "match_key" [subject, list.nth 1 k] (list.head k);
                    let held = call_builtin "match_head" [list.nth 1 found] (list.head found);
                    extract (list.nth 1 kv) (list.nth 1 held) want (list.nth 1 acc) (list.head held)
                }) [l, binds] pairs,
        _ => [l, binds],
    };

/// A list a cell at a time, and no further than the last part wanted.
let rec extract_list items rest cursor want binds l =
    match items {
        [] =>
            match rest {
                [_, name_span] =>
                    [l, if want name_span { list.append binds [[name_span, cursor]] } else { binds }],
                _ => [l, binds],
            },
        [item, ..more] => {
            let got =
                if not (wants want item) { [l, binds] }
                else {
                    let head = call_builtin "match_head" [cursor] l;
                    extract item (list.nth 1 head) want binds (list.head head)
                };
            if not (list.any (fn i -> wants want i) more || rest_wanted want rest) { got }
            else {
                let tail = call_builtin "match_tail" [cursor] (list.head got);
                extract_list more rest (list.nth 1 tail) want (list.nth 1 got) (list.head tail)
            }
        },
    };

/// Does this pattern bind anything `want` asks for?
let wants want p = list.any (fn b -> want (list.nth 1 b)) (scope.pattern_bindings p);

let rest_wanted want rest = match rest { [_, name_span] => want name_span, _ => false };

/// The hidden global behind a top-level destructuring: the value, held, and then
/// checked. Shaped as a `match` is -- a strict bind of the subject, then the test
/// -- because it is only ever forced by a name that needs the check, and a global
/// remembers what it came to.
let lower_destructure pattern body span l = {
    let value = lower_expr body l;
    let held = expand macros.coalesce (slot_at span (list.head value)) 0;
    let bind = emit (ir.node :bind held (list.nth 1 value) ir.no_node) (list.head value);
    let i = list.nth 1 bind;
    let sequenced = set_flag i ir.f_strict (inherit i [list.nth 1 value] (list.head bind));
    let reader = emit (ir.node :local held ir.no_node ir.no_node) sequenced;
    let checked = check_value pattern (list.nth 1 reader) (list.head reader);
    let placed = kids [i, list.nth 1 checked] (list.head checked);
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [i, list.nth 1 checked] (list.head made), list.nth 1 made]
};

/// One name of a top-level destructuring: its part of the hidden global. The
/// hidden global is found by name in the module this body was resolved against,
/// which under `derive` is the deriving module -- whose hidden global it is.
let lower_destructured hidden pattern name_span l =
    match scope.global_index (scope.r_env_at (res l) (ctx l)) hidden {
        () => emit_leaf :unit l,
        g => {
            let value = emit (ir.node :global g ir.no_node ir.no_node) l;
            let parts = extract pattern (list.nth 1 value)
                                (fn s -> ast.span_start s == ast.span_start name_span)
                                [] (list.head value);
            match list.nth 1 parts {
                [part] => [list.nth 0 parts, list.nth 1 part],
                _ => emit_leaf :unit (list.nth 0 parts),
            }
        },
    };

// --- match --------------------------------------------------------------------

let rec lower_match scrutinee arms span l = {
    let value = lower_expr scrutinee l;
    let held = expand macros.coalesce (slot_at span (list.head value)) 0;
    let bind = emit (ir.node :bind held (list.nth 1 value) ir.no_node) (list.head value);
    let i = list.nth 1 bind;
    // Every pattern but `_` and a bare name looks at the subject, and the arms
    // are tried in order, so evaluating it once up front is both cheaper and
    // the only way the order is observable at all.
    let sequenced = set_flag i ir.f_strict (inherit i [list.nth 1 value] (list.head bind));

    let chain = lower_arms arms held span sequenced;
    let dispatched = dispatch arms (list.nth 2 chain) held (list.nth 1 chain) (list.head chain);
    let placed = kids [i, list.nth 1 dispatched] (list.head dispatched);
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [i, list.nth 1 dispatched] (list.head made), list.nth 1 made]
};

// --- jumping to the arm -----------------------------------------------------------
//
// The arms of a `match` are tried in order, and an arm that misses is not
// free: `[:name, n, sp]` against a subject it does not fit is a `type_of`, a
// cons test, a head read and an equality -- about a dozen reductions -- before
// the next arm is asked. The compiler is built out of matches of forty such
// arms, and a node that is the fortieth kind paid for thirty-nine misses.
// Measured on a twenty-arm match over `[:tag, a, b]`, reaching the last arm
// cost 1645 ms to the first arm's 343.
//
// Most of those arms say, in their first element, which subjects they could
// ever match: `[:name, ..]` only a cell whose head is `:name`, `:empty` only
// the atom `:empty`. So a `match` with enough of them starts with a switch on
// that atom, which jumps into the ordinary chain of tests at the first arm
// that could match. It jumps *into* the chain rather than replacing it: every
// target is a suffix of the chain `lower_arms` built, so every test that runs
// is one that would have run, each arm is lowered once, and an arm that does
// not match after all -- the wrong length, a guard that says no -- falls
// through to the arms below it exactly as before. What is skipped is only
// arms that could not have matched.
//
// That is sound without any type. A declared union is what makes a `match`
// look like this, but the patterns alone say which tags they take.
//
// The one thing to be careful of is forcing. `switch_head` reads the head of
// a cell, and reading means forcing. It is only emitted when the chain would
// have forced that head before anything else: the arms in front of the first
// tagged-cell arm are all atom literals, which compare the subject and cannot
// match a cell, so for a cell the first thing the chain does is force its head
// to compare it with a tag.

/// What an arm's pattern says about the subjects it could match: `[:head, n]`
/// for a list whose first element is the atom `n`, `[:atom, n]` for the atom
/// itself, and `:any` for everything else.
let rec arm_key p = match p {
    [:as_p, inner, _, _, _] => arm_key inner,
    [:literal, [:atom, n, _], _] => [:atom, n],
    [:list_p, [[:literal, [:atom, n, _], _], .._], _, _] => [:head, n],
    _ => :any,
};

/// The position of the first element `pred` accepts, or `()`.
let rec find_index_from i pred xs = match xs {
    [] => (),
    [x, ..rest] => if pred x { i } else { find_index_from (i + 1) pred rest },
};
let find_index pred xs = find_index_from 0 pred xs;

/// Fewer tags than this and the chain is already cheap.
let min_switch = 3;

/// The distinct tags of one kind, in the order the arms first name them.
let tags_of kind keys = list.fold (fn acc k -> match k {
    [kd, n] if kd == kind && not (list.contains n acc) => list.append acc [n],
    _ => acc,
}) [] keys;

/// The chain suffix of the first arm that could match: the first whose key is
/// one of `fits`, or `:any`. The last suffix is the `match_error` raise.
let first_fit fits keys suffixes =
    match find_index (fn k -> k == :any || list.contains k fits) keys {
        () => list.nth (list.length keys) suffixes,
        j => list.nth j suffixes,
    };

/// A switch node over `tags`, keyed on `kind`, with `default` for everything else.
let switch_node op kind tags keys suffixes held default l = {
    let entries = list.fold (fn acc n -> {
        let key = const_atom n (list.head acc);
        [list.head key, list.append (list.nth 1 acc) [list.nth 1 key, first_fit [[kind, n]] keys suffixes]]
    }) [l, []] tags;
    let subject = emit (ir.node :local held ir.no_node ir.no_node) (list.head entries);
    let run = list.append (list.nth 1 entries) [default];
    let placed = kids run (list.head subject);
    let made = emit (ir.node op (list.nth 1 subject) (list.nth 1 placed) (list.length run)) (list.head placed);
    [inherit (list.nth 1 made) run (list.head made), list.nth 1 made]
};

/// The node a `match` starts at: a switch into `chain` when enough arms name a
/// tag, and `chain` itself otherwise.
let dispatch arms suffixes held chain l = {
    let keys = list.map (fn a -> arm_key (ast.arm_pattern a)) arms;
    let heads = tags_of :head keys;
    let atoms = tags_of :atom keys;
    // Everything in front of the first tagged-cell arm is an atom literal.
    let head_ok = match find_index (fn k -> match k { [:head, _] => true, _ => false }) keys {
        () => false,
        j => list.all (fn k -> match k { [:atom, _] => true, _ => false }) (list.take j keys),
    };
    let use_heads = head_ok && list.length heads >= min_switch;
    let use_atoms = list.length atoms >= min_switch || (use_heads && not (list.is_empty atoms));
    let head_tags = list.map (fn n -> [:head, n]) heads;
    // Under a `switch_head`, only a cell whose head names no tag, or something
    // that is not a cell, reaches the atom switch -- and a cell of either kind
    // can only be matched by an `:any` arm. On its own, a cell may be matched
    // by any tagged-cell arm, so none of them may be skipped.
    let atom_default = if use_heads { first_fit [] keys suffixes } else { first_fit head_tags keys suffixes };
    let by_atom = if not use_atoms { [l, ()] }
                  else { switch_node :switch_atom :atom atoms keys suffixes held atom_default l };
    if not use_heads {
        match list.nth 1 by_atom { () => [l, chain], node => by_atom }
    } else {
        // Not a cell, or a cell whose head is no tag: the atom switch when
        // there is one, and otherwise the first arm that is not a tagged cell.
        let fallback = match list.nth 1 by_atom {
            () => first_fit (list.map (fn n -> [:atom, n]) atoms) keys suffixes,
            node => node,
        };
        switch_node :switch_head :head heads keys suffixes held fallback (list.head by_atom)
    }
};

let rec lower_arms arms held span l =
    match arms {
        // Nothing matched. Dream is dynamically typed, so exhaustiveness cannot
        // be checked; saying so at run time is the honest answer, and a `_` arm
        // is how a program declares itself total.
        [] => {
            let kind = const_atom "match_error" l;
            let raised = call_builtin "raise!" [list.nth 1 kind] (list.head kind);
            [set_flag (list.nth 1 raised) ir.f_strict (list.head raised), list.nth 1 raised,
             [list.nth 1 raised]]
        },
        [arm, ..rest] => {
            let subject = emit (ir.node :local held ir.no_node ir.no_node) l;
            let tested = pattern_test (ast.arm_pattern arm) (list.nth 1 subject) []
                                      (list.head subject);
            let test = list.nth 1 tested;

            // The bindings go into their slots before the guard or the body can
            // name them. The slot is the one resolution gave the binder, found
            // by where it was written.
            let bound = list.fold (fn acc b -> {
                let l0 = list.head acc;
                let s = expand macros.coalesce (slot_at (list.nth 0 b) l0) 0;
                let made = emit (ir.node :bind s (list.nth 1 b) ir.no_node) l0;
                [inherit (list.nth 1 made) [list.nth 1 b] (list.head made),
                 list.append (list.nth 1 acc) [list.nth 1 made]]
            }) [list.nth 0 tested, []] (list.nth 2 tested);

            let taken =
                match ast.arm_guard arm {
                    () => {
                        let body = lower_expr (ast.arm_body arm) (list.head bound);
                        [list.head body, list.append (list.nth 1 bound) [list.nth 1 body]]
                    },
                    g => {
                        let cond = lower_expr g (list.head bound);
                        let forced = set_flag (list.nth 1 cond) ir.f_strict (list.head cond);
                        let body = lower_expr (ast.arm_body arm) forced;
                        // A guard that fails falls through to the arms below,
                        // which is why they are lowered inside the guarded arm
                        // rather than beside it.
                        let fallback = lower_arms rest held span (list.head body);
                        let made = emit (ir.node :if (list.nth 1 cond) (list.nth 1 body)
                                                 (list.nth 1 fallback))
                                        (list.head fallback);
                        [inherit (list.nth 1 made)
                                 [list.nth 1 cond, list.nth 1 body, list.nth 1 fallback]
                                 (list.head made),
                         list.append (list.nth 1 bound) [list.nth 1 made]]
                    },
                };

            let placed = kids (list.nth 1 taken) (list.head taken);
            let block = emit (ir.node :block (list.nth 1 placed) (list.length (list.nth 1 taken))
                                      ir.no_node)
                             (list.head placed);
            let blocked = inherit (list.nth 1 block) (list.nth 1 taken) (list.head block);

            // A guarded arm has folded the rest of them into its guard's false
            // branch, but that does not cover a pattern that fails before the
            // guard is ever asked: the rest must also be reachable from the
            // pattern test's false path, guard or no guard.
            let otherwise = lower_arms rest held span blocked;
            let made = emit (ir.node :if test (list.nth 1 block) (list.nth 1 otherwise))
                            (list.head otherwise);
            [set_flag test ir.f_strict
                (inherit (list.nth 1 made) [test, list.nth 1 block, list.nth 1 otherwise]
                         (list.head made)),
             list.nth 1 made,
             // Where each arm's test starts, and the raise after the last:
             // what a switch in front of the chain jumps to (`dispatch`).
             list_cons (list.nth 1 made) (list.nth 2 otherwise)]
        },
    };

// --- tail calls ------------------------------------------------------------------

/// Flag the calls a function ends with, so the VM can reuse the frame instead
/// of growing the stack -- a loop written as recursion 100k deep should not
/// overflow. Only the positions a function actually finishes in count: the
/// branches of an `if`, the last statement of a block, and the call itself.
let rec mark_tail i l =
    if not (ir.is_node i) { l }
    else {
        let n = ir.node_at i (prog l);
        match ir.node_op n {
            :apply => set_flag i ir.f_tail l,
            :if    => mark_tail (ir.node_c n) (mark_tail (ir.node_b n) l),
            // Every target, which is every value a switch can finish with;
            // the keys in between are atoms and are not calls.
            :switch_head => mark_targets n l,
            :switch_atom => mark_targets n l,
            // A block's value is its last statement, so that is the only
            // child that can be in tail position.
            :block =>
                if ir.node_b n > 0 { mark_tail (ir.kid_at (ir.node_a n + ir.node_b n - 1) (prog l)) l }
                else { l },
            :force => mark_tail (ir.node_a n) l,
            _ => l,
        }
    };

let mark_targets n l =
    list.fold (fn acc k -> if k % 2 == 1 || k == ir.node_c n - 1 {
                               mark_tail (ir.kid_at (ir.node_b n + k) (prog acc)) acc
                           } else { acc })
              l (list.range 0 (ir.node_c n));

// --- the whole program ---------------------------------------------------------

/// Lower every body the resolver queued.
///
/// The order is the resolver's, which is the loader's: dependencies before
/// whatever uses them. Nothing here depends on that -- a global is an index by
/// now, and an index does not care when it was filled in -- but keeping it means
/// a dump reads in the order the program was written.
/// Intern a string and answer `[lowering, index]`.
let strk text l = { let got = ir.intern_str text (prog l); [set_prog (list.head got) l, list.nth 1 got] };

/// Push one function's captures into the shared pool and answer where they
/// went. Captures live in the same pool as call arguments and block statements
/// because they are the same thing to a loader: a contiguous run of indices
/// addressed by an offset and a count.
let place_captures caps l = {
    let encoded = list.map (fn c ->
        match c {
            [:local, slot] => ir.encode_capture false slot,
            [:capture, idx] => ir.encode_capture true idx,
            _ => 0,
        }) caps;
    kids encoded l
};

/// The four `link_*` folds below build their record lists with `list_cons` and
/// reverse once at the end rather than appending. `list.append xs [x]` is one
/// reduction and a copy of `xs`, so a profile counts none of it and the list
/// costs O(n^2) bytes to build -- these three fold lambdas were, between them,
/// 39% of everything a 3,200-declaration program allocated, and 3.5x what the
/// same program at half the size allocated. See the note over `s_imports_rev`
/// in [scope.dr](scope.dr), which is the same mistake in the other direction.
/// The function records, as an image stores them. The two halves of a function
/// meet here: `scope` knows its name, arity, frame size and captures, and
/// lowering knows which node its body turned out to be.
let link_funcs r bodies l = link_funcs_from r bodies l 0;

/// `link_funcs`, from function index `from` onward, appending to an image
/// `funcs` list the caller already carries. A session links only what one entry
/// added, so the records before them -- and the capture runs their functions
/// placed -- are never rebuilt. `link_funcs` is this with `from` 0 on the empty
/// list, which is why the two share the fold below.
let link_funcs_from r bodies l from = {
    let zip = list.zip (list.drop from (scope.funcs r))
                       (list.range from (list.length (scope.funcs r)));
    let built = list.fold (fn acc pair -> {
        let f = list.nth 0 pair;
        let fi = list.nth 1 pair;
        let l0 = list.head acc;
        let named = strk (scope.func_name f) l0;
        let placed = place_captures (scope.func_captures f) (list.head named);
        let flags = (if scope.func_impure f { ir.fn_impure } else { 0 })
                  + (if f.[:rec else false] { ir.fn_rec } else { 0 })
                  + (if f.[:thunk else false] { ir.fn_thunk } else { 0 })
                  // A parameterless pure binding is a value the VM forces once
                  // and remembers; an impure one has to run again every time.
                  + (if f.[:thunk else false] && not (scope.func_impure f) {
                         ir.fn_global_value
                     } else { 0 });
        [list.head placed,
         list_cons
             %{ :name => list.nth 1 named, :body => bodies.[fi else ir.no_node],
                 :arity => scope.func_arity f, :flags => flags,
                 :slots => scope.func_slots f,
                 :n_captures => list.length (scope.func_captures f),
                 :captures_off => list.nth 1 placed,
                 :span_start => ast.span_start (f.[:span else ast.no_span]),
                 :span_end => ast.span_end (f.[:span else ast.no_span]) }
             (list.nth 1 acc)]
    }) [l, []] zip;
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_globals r l = link_globals_from r l 0;

/// `link_globals`, from global record `from` onward, appending to a carried
/// image `globals` list -- the sibling of `link_funcs_from`, same reason.
let link_globals_from r l from = {
    let fresh = list.drop from (scope.r_global_recs r);
    let built = list.fold (fn acc g -> {
        let named = strk (list.nth 1 g) (list.head acc);
        let is_module = list.nth 2 g == :module;
        [list.head named,
         list_cons
             %{ :name => list.nth 1 named,
                :kind => if is_module { ir.global_module } else { ir.global_function },
                :target => match list.nth 3 g { () => ir.no_node, t => t },
                :flags => ir.g_exported
                          + (if builtins.is_impure_name (list.nth 1 g) { ir.g_impure }
                             else { 0 }) }
             (list.nth 1 acc)]
    }) [l, []] fresh;
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_imports r l = {
    let built = list.fold (fn acc i -> {
        let path = strk (list.nth 0 i) (list.head acc);
        let alias = strk (list.nth 1 i) (list.head path);
        [list.head alias,
         list_cons %{ :path => list.nth 1 path, :alias => list.nth 1 alias }
                   (list.nth 1 acc)]
    }) [l, []] (scope.r_imports r);
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_modules ld r l = {
    let built = list.fold (fn acc m -> {
        let mi = list.nth 0 m;
        let mod_at = modules.module_at ld mi;
        let named = strk (modules.module_name mod_at) (list.head acc);
        let src = strk (modules.module_path mod_at) (list.head named);
        [list.head src,
         list_cons
             %{ :name => list.nth 1 named, :source => list.nth 1 src,
                :globals_start => list.nth 1 m, :globals_count => list.nth 2 m,
                :flags => if list.nth 3 m { ir.m_abstract } else { 0 },
                :derives => match list.nth 4 m { () => ir.no_node, d => d } }
             (list.nth 1 acc)]
    }) [l, []] (scope.r_module_recs r);
    [list.head built, list.reverse (list.nth 1 built)]
};

/// The function `main!` compiles to, or nothing. The entry point is a global of
/// the root module, which is the last one loaded -- everything else was loaded
/// because it reached it. The *last* `main!` body wins: a session recompiles
/// its entry point every entry on top of a carried resolution, so the newest
/// body is the one appended last, and a fresh compile has exactly one anyway.
let find_entry ld r = {
    let last = modules.module_count ld - 1;
    let hits = list.filter (fn b -> list.nth 0 b == last
                                    && scope.decl_name (list.nth 2 b) == "main!")
                           (scope.bodies r);
    if list.is_empty hits { ir.no_node } else { list.nth 3 (list.last hits) }
};

/// Lower every body the resolver queued, then link what comes out.
///
/// The order is the resolver's, which is the loader's: dependencies before
/// whatever uses them. Nothing here depends on that -- a global is an index by
/// now, and an index does not care when it was filled in -- but keeping it means
/// a dump reads in the order the program was written.
/// Force what one body's lowering produced: the arena's two counts, and the
/// table saying which node each function's body became.
///
/// `ir.settle` keeps the arena flat *within* a body, and that is not enough,
/// because nothing forces the accumulator *between* them. Without this the pass
/// answers a suspension per body, nine hundred of them stacked on each other,
/// and forcing the last one walks the whole tower with every intermediate arena
/// still live -- which is how lowering the compiler itself ran the machine out
/// of memory. Forced here, what is carried from one body to the next is an
/// arena, and the one before it is garbage.
let settle_body l =
    if ir.node_count (prog l) >= 0 && ir.kid_count (prog l) >= 0
       && len (func_bodies l) >= 0 { l } else { l };

/// Lower a slice of the resolver's bodies into an arena that may already hold
/// the rest of the program. The narrow heart of the walk in `lower_program`:
/// that pass calls it over everything it resolved, from an empty start, and a
/// session calls it over the one body an entry added, into the arena it
/// carried. Nodes are appended and a node's index never moves, so a carried
/// arena is safe for exactly the reason the whole-program arena always was.
let lower_from r low bodies =
    list.fold_strict (fn acc b -> {
        let src = list.nth 1 b;
        let d = list.nth 2 b;
        let fi = list.nth 3 b;
        let got = lower_body (scope.decl_params d) (scope.decl_body d)
                             (set_ctx (list.nth 0 b) (set_source src acc));
        settle_body (set_func_body fi (list.nth 1 got)
                                  (mark_tail (list.nth 1 got) (list.head got)))
    }) (set_res r low) bodies;

let lower_program r = {
    let walked = lower_from r (lowering r ir.program 0) (scope.bodies r);

    let fs = link_funcs r (func_bodies walked) walked;
    let gs = link_globals r (list.head fs);
    let is = link_imports r (list.head gs);
    let linked = list.head is;

    let p = ((((((prog linked)).[:funcs => (list.nth 1 fs)])).[:globals => (list.nth 1 gs)])).[:imports => (list.nth 1 is)];
    ((set_prog p linked)).[:image => (ir.finish p)]
};

/// Evaluate every compile-time expression the program contains, and put the
/// values where the placeholders were.
///
/// Done after linking, because an expression may call anything in the program
/// and so needs the whole of it to be runnable first. Each one is run against
/// an image of the program with that expression as the entry point -- the
/// dependencies are replaced with constants before their users run.
/// Follow execution-tree references, including called functions and closures,
/// until another comp placeholder is reached. Stop there: its own dependencies
/// are settled before it is evaluated. The visited set also bounds recursion.
let rec comp_dependencies todo seen found pending p funcs globals = match todo {
    [] => found,
    [index, ..rest] =>
        if not (ir.is_node index) || map_has seen index {
            comp_dependencies rest seen found pending p funcs globals
        } else if map_has pending index {
            comp_dependencies rest (seen.[index => true]) (list_cons index found) pending p funcs globals
        } else {
            let n = ir.node_at index p;
            let op = ir.node_op n;
            let direct = list.map (fn k -> opt.operand k n) (opt.edges_of op);
            let run = match opt.run_of op {
                () => [],
                [offset, count, width] => list.map (fn i -> ir.kid_at i p)
                    (list.range (opt.operand offset n)
                        (opt.operand offset n + opt.operand count n * width)),
            };
            let function_body fi = if ir.is_node fi { [funcs.[fi].[:body]] } else { [] };
            let called = match op {
                :global => {
                    let g = globals.[ir.node_a n];
                    if g.[:kind] == ir.global_function { function_body g.[:target] } else { [] }
                },
                :make_closure => function_body (ir.node_a n),
                :make_thunk => function_body (ir.node_a n),
                _ => [],
            };
            comp_dependencies (direct + run + called + rest) (seen.[index => true]) found
                              pending p funcs globals
        },
};

/// Settle them in an order where nothing is evaluated before what it reads.
///
/// `built` is the serialized image the next evaluation runs against, and the
/// whole of the cost here is how often it has to be made again. Building one
/// is `ir.finish` plus `emit.to_binary`, and both are the size of the
/// *program* rather than of the expression -- so one per compile-time
/// expression is the program's size times however many there are. On a
/// self-compile that was 30% of every reduction the compiler made.
///
/// It almost never has to be rebuilt. Settling one overwrites its
/// placeholder, and the only thing that can read that placeholder is an
/// expression which depends on it -- so the image stays good until a
/// dependency of something still waiting has been settled. A program whose
/// compile-time expressions are independent of each other, which is nearly
/// all of them, builds exactly one, and the rest are that one with four
/// bytes of header changed.
let rec settle_comp_order! rows done built l =
    if list.is_empty rows { l }
    else {
        let ready = list.filter (fn row -> list.all (fn node -> map_has done node) row.[1]) rows;
        if list.is_empty ready {
            complain ast.no_span "cyclic dependency between compile-time expressions" l
        } else {
            let row = list.head ready;
            let one = row.[0];
            // Each evaluation sees the constants its dependencies installed,
            // rather than the original image full of unit placeholders.
            let image = match built {
                () => emit.to_binary (ir.finish (prog l)),
                ready_made => ready_made,
            };
            let settled = settle_comp! (fn fi -> emit.with_entry image fi) one l;
            if list.length (l_diags settled) > list.length (l_diags l) { settled }
            else {
                let rest = list.filter (fn r -> r.[0].[0] != one.[0]) rows;
                let wanted = list.any (fn r -> list.contains one.[0] r.[1]) rest;
                settle_comp_order! rest (done.[one.[0] => true])
                                   (if wanted { () } else { image }) settled
            }
        }
    };

let settle_comps! l = {
    let pend = pending_comp l;
    if list.is_empty pend { l }
    else {
        let p = prog l;
        let funcs = array_of_list (ir.funcs p);
        let globals = array_of_list (ir.globals p);
        let pending = list.fold (fn m one -> m.[one.[0] => true]) %{} pend;
        let rows = list.map (fn one -> [one,
            comp_dependencies [funcs.[one.[1]].[:body]] %{} [] pending p funcs globals]) pend;
        settle_comp_order! rows %{} () l
    }
};

/// The whole thing, with the module table an image also needs. The loader is
/// wanted here and nowhere else, which is why it is a separate way in rather
/// than an argument threaded through every step.
let link! ld r = {
    let low = settle_comps! (lower_program r);
    let ms = link_modules ld r low;
    let named = strk (modules.module_name (modules.module_at ld
                          (modules.module_count ld - 1)))
                     (list.head ms);
    let sourced = strk (modules.module_path (modules.module_at ld
                            (modules.module_count ld - 1)))
                       (list.head named);
    let p = ((((((((prog (list.head sourced))).[:modules => (list.nth 1 ms)])).[:entry => (find_entry ld r)])).[:module_name => (list.nth 1 named)])).[:source_name => (list.nth 1 sourced)];
    ((set_prog p (list.head sourced))).[:image => (ir.finish p)]
};

// --- compile-time values ------------------------------------------------------
//
// What an expression came to, turned back into nodes. A compile-time value is
// data -- that is what makes it something an image can hold -- so this is a
// walk over the shapes data comes in, and nothing else needs to be handled: the
// evaluator refuses to hand back a closure or a process in the first place.

let rec emit_const v l =
    match type_of v {
        :integer => const_int v l,
        :float   => const_float v l,
        :string  => const_str v l,
        :char    => const_char v l,
        :bool    => const_bool v l,
        :unit    => emit_leaf :unit l,
        // `to_string` of an atom keeps the leading colon, which is not part of
        // the name the image stores.
        :atom    => const_atom (str.slice 1 (str.byte_length (to_string v) - 1) (to_string v)) l,
        :list    => const_seq :make_list (list.map (fn x -> x) v) l,
        :array   => const_seq :make_array (array_to_list v) l,
        :map     => const_seq :make_map
                        (list.concat (list.map (fn kv -> [list.nth 0 kv, list.nth 1 kv])
                                               (map_pairs v))) l,
        _ => emit_leaf :unit l,
    };

let rec const_seq op items l = {
    let done = list.fold (fn acc x -> {
        let got = emit_const x (list.head acc);
        [list.head got, list.append (list.nth 1 acc) [list.nth 1 got]]
    }) [l, []] items;
    let placed = kids (list.nth 1 done) (list.head done);
    let n = if op == :make_map { list.length items / 2 } else { list.length items };
    emit (ir.node op (list.nth 1 placed) n ir.no_node) (list.head placed)
};

/// Evaluate one compile-time expression and put what it came to where the
/// placeholder was.
///
/// The expression is run by building an image whose entry point is its own
/// function and handing that to a VM. That is the whole trick, and it is only
/// available to a compiler that is itself running on one: the value a `comp`
/// produces is produced by exactly the machinery that would have produced it at
/// run time, so the two cannot disagree.
/// `bytes_of` is handed the function index to enter at and answers the image
/// to run. It is a function rather than the image itself so that a caller
/// which has already serialized the program can hand the same bytes back
/// with only the entry changed -- see `emit.with_entry`.
let settle_comp! bytes_of one l = {
    let node = list.nth 0 one;
    let fi = list.nth 1 one;
    let value = try! { vm.eval_image! (bytes_of fi) }
                catch e { [:comp_error, e] };
    match value {
        [:comp_error, why] =>
            complain (ast.no_span)
                     ("a compile-time expression could not be evaluated: " + to_string why) l,
        v => {
            let built = emit_const v l;
            // The placeholder keeps its index -- everything already points at
            // it -- and becomes the node the value is.
            set_prog (ir.set_node node (ir.node_at (list.nth 1 built) (prog (list.head built)))
                                  (prog (list.head built)))
                     (list.head built)
        },
    }
};

let image l = l.[:image else (ir.finish ir.program)];

let diags l = l_diags l;

/// Everything the resolver and the lowerer between them had to say.
let all_diags r l = list.append (scope.r_diags r) (l_diags l);

// --- reading it back ------------------------------------------------------------

/// The whole program as text: each function, then the arena it was built into.
/// This is what `--ir` prints. A tree written out one node per line is far
/// easier to check than a nest of indices, which is also why the tests compare
/// against it rather than against node records.
let dump l = {
    let img = image l;
    let fs = img.[:funcs else []];
    let strs = img.[:strs else []];
    let name_of i = if i < list.length strs { list.nth i strs } else { "?" };
    str.join_str "\n"
        (list.append
            (list.map (fn i -> {
                let f = list.nth i fs;
                "fn" + to_string i + " " + name_of (f.[:name else 0])
                + "/" + to_string (f.[:arity else 0])
                + "  slots=" + to_string (f.[:slots else 0])
                + (match f.[:n_captures else 0] {
                       0 => "",
                       n => "  captures=" + to_string n
                             + "@" + to_string (f.[:captures_off else 0]),
                   })
                + "  body=" + to_string (f.[:body else ir.no_node])
             }) (list.range 0 (list.length fs)))
            [ir.dump img])
};
