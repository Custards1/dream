// Module resolution and loading.
//
// Dream compiles whole programs. `import std.list` is resolved to a file, that
// file is parsed, and its own imports are followed, until the entire reachable
// program is in hand. Everything is then lowered into a single image.
//
// Whole-program compilation is what makes `derive` cheap: specializing a base
// module's code against a deriving module's implementations needs the base
// module's syntax tree, not just its signature. It also means a call to another
// Dream module resolves to a global index at compile time rather than a name
// lookup at run time.
//
// A module path that has no file behind it is assumed to be provided by the
// host -- `std.console` is C++ in the VM, not Dream. Those are listed
// explicitly so a typo in an import is an error rather than a mystery at run
// time.
//
// The loader is a value, not an object. Every step takes one and answers
// another, which is what lets the whole thing be pure of shared state while
// still being thoroughly effectful about the file system: a step's input is the
// previous step's output, so the data dependency alone fixes the order things
// happen in. Nothing has to be undone, and there is no point at which half a
// module is registered.

import std.io;
import std.list;
import std.os;
import std.str;
import std.vm;

import dreams.ast;
import dreams.syntax;
import dreams.config;
import dreams.diag;
import dreams.package;
import dreams.parser;
import dreams.path;

/// Modules the VM provides natively. An `import` of one of these resolves to a
/// runtime lookup rather than to Dream source. This must match the runtime's
/// registry exactly.
///
/// An embedder can add to this list for one compilation with `--host-module`,
/// which is what makes a program importing a module registered at run time
/// compilable. It is deliberately not a wildcard: naming the module is what
/// keeps a typo in an import an error rather than a mystery later.
let native_modules =
    ["std.console", "std.ffi", "std.io", "std.math", "std.net", "std.os", "std.vm"];

let is_native p = list.contains p native_modules;


// --- a loaded module ---------------------------------------------------------

/// What `load!` answers: every module and file the program reaches, keyed by
/// index, and what the loader had to say about them.
type Loader = :map;

/// `source` is an index into the loader's file list, so a diagnostic raised
/// about this module can quote the line it came from.
mapping Module {
    name = ""
    path = ""
    source = 0
    items = []
}

// Visibility travels with the module's declarations.
let loaded name path source items =
    (Module.make name path source
        (list.filter (fn item -> ast.kind item != :private) items)).[:private_spans =>
            list.map ast.span (list.filter (fn item -> ast.kind item == :private) items)];

let with_new_items m items = m.[:items => items];

let private_declaration m span =
    list.any (fn sp -> ast.span_start sp <= ast.span_start span
                   && ast.span_end span <= ast.span_end sp)
             (m.[:private_spans else []]);

let module_name m = Module.name m;
let module_path m = Module.path m;
let module_source m = Module.source m;
let module_items m = Module.items m;

// --- the loader --------------------------------------------------------------

let loader packages cfg search_paths host_modules =
    %{ :packages => packages, :config => cfg, :search_paths => search_paths,
       :host_modules => host_modules,
       // Dependencies first, so a later pass never meets a module before what
       // it uses. That ordering is the reason a module is recorded only once
       // everything it imports has been -- and it is why the table is keyed by
       // a dense index rather than by name: the index *is* the order.
       :modules => %{}, :module_count => 0,
       :by_name => %{}, :by_path => %{},
       :files => %{}, :file_count => 0, :expanding => %{},
       :natives => [], :namespaces => [],
       :diags => [], :visited => %{}, :in_progress => [],
       // Files whose contents come from memory rather than from disk. An
       // editor holds a buffer that has not been saved -- often has never been
       // saved -- and every question it asks is about the buffer.
       :overlay => %{},
       // Files whose text has been parsed before: path -> [text, parse result].
       // A language server reuses a module's parse across requests -- the only
       // file that changes is the buffer being edited, and re-lexing and
       // re-parsing every reachable module on every keystroke is the whole cost
       // of answering one -- so a same-text hit skips the parse entirely.
       :parsed => %{} };

let packages l     = l.[:packages else package.empty];
let config_of l    = l.[:config else config.empty];
let search_paths l = l.[:search_paths else []];
let host_modules l = l.[:host_modules else []];
/// Every module that was loaded, in order. Derived, because the table it
/// comes from is keyed by index -- so ask `module_count` when the count is all
/// that is wanted, which is what nearly every caller wanted.
let modules l      = list.map (fn i -> module_at l i) (list.range 0 (module_count l));
let module_map l   = l.[:modules else %{}];
let module_count : Loader -> :integer;
let module_count l = l.[:module_count else 0];
let by_name l      = l.[:by_name else (%{})];
let by_path l      = l.[:by_path else (%{})];
/// Every source file, in order. Derived from the table below, and wanted in
/// this shape by exactly one caller: `diag.render_all`, which is handed the
/// whole program's files once, at the end of a compile that has something to
/// say. Every other reader knows the index it wants -- a diagnostic carries
/// one -- and asks `file_at`.
let files : Loader -> [:any];
let files l        = list.map (fn i -> file_at l i) (list.range 0 (file_count l));
let file_map l     = l.[:files else %{}];
let file_count : Loader -> :integer;
let file_count l   = l.[:file_count else 0];
let file_at l i    = (file_map l).[i else ()];

/// Record a file's text and say where it went. Keyed by index like the module
/// table above and for the same two reasons: appending copied the list, once
/// per file, and `expand.install!` rewrote one entry with the `set` opcode,
/// which copies every cell in front of it, once per macro call.
let add_file f l =
    put :file_count (file_count l + 1) (put :files ((file_map l).[file_count l => f]) l);
let set_file i f l = put :files ((file_map l).[i => f]) l;

/// Where the word `expand` is written in each file, by source index: the
/// parser's answer (`parser.expand_sites`), kept where the pass that needs it
/// can ask. A module shares the source index of the file it was written in,
/// submodules and records included, so this answers for a module as well.
///
/// It exists so that macro expansion can find the declarations it is about
/// without walking the ones it is not. The walk it replaces was 11% of a
/// self-compile and every program paid it, macros or not, because "has this
/// declaration got an `expand` in it?" was asked by reading the whole
/// program's syntax. See `parser.expand_sites` for why the answer is sound.
let expanding l = l.[:expanding else %{}];
let expand_sites l source = (expanding l).[source else []];
let note_expanding source sites l =
    if list.is_empty sites { l } else { put :expanding ((expanding l).[source => sites]) l };
let natives : Loader -> [:string];
let natives l      = l.[:natives else []];
let namespaces l   = l.[:namespaces else []];
let diags : Loader -> [:map];
let diags l        = l.[:diags else []];
let visited l      = l.[:visited else (%{})];
let in_progress l  = l.[:in_progress else []];
/// Path to text, for the files this loader should not read from disk.
let overlay l      = l.[:overlay else (%{})];
let with_overlay o l = l.[:overlay => o];
/// Path to a `[text, parse result]` pair for a file that has been parsed
/// before. Feeding a loader a previous loader's map is what makes two analyses
/// of the same program parse nothing twice.
let parsed l       = l.[:parsed else (%{})];
let with_parsed p l = l.[:parsed => p];
let put_parsed file v l = with_parsed (((parsed l)).[file => v]) l;

/// `[owner, kind, name, fields, members, span]` for each `group`, `struct` or
/// `mapping` declaration, where `owner` is the module it was written in.
/// `note_records` is the only thing that adds to this and says why it exists.
let records l      = l.[:records else []];

/// What each `expand` in the program named: `[module, source, offset, what]`,
/// one entry per call site, where `what` is the resolution of the macro's own
/// name wrapped as `[:macro, ..]`.
///
/// Expansion happens before resolution and *replaces* the call, so by the time
/// the resolver walks this program the name the author wrote is not in it and
/// nothing would ever record what it meant. An editor asks exactly that
/// question -- hover and go-to-definition are "what is this name" -- so the
/// pass that did resolve it says so here, and `scope.resolve!` seeds its
/// occurrence table with these. See `note_macro` in dreams/expand.dr.
let expansions l   = l.[:expansions else []];

/// Should macro expansion measure itself, and what did it measure?
///
/// Off unless a tool asks, and the reason is not the handful of clock reads.
/// A phase charges itself around a `strict!`, because in a lazy language a
/// phase that has not been forced has not run -- and that changes *when* the
/// work happens as well as who is charged for it. Expansion relies on that in
/// one place: a round whose modules are all refused before any of them runs
/// never forces the image, and so never builds one. Charging the image would
/// take that away. So `--time` turns this on and an ordinary build does not.
///
/// `macro_meter` is what came back: `[:phases, :counts]`, written by
/// `expand.publish_meter` and read by `main.show_time!`. Nothing in the
/// compiler reads it, the way nothing reads `records` -- it is here because
/// the pass that spends the time is the only one that can say where.
let metering l     = l.[:metering else false];
let with_metering : Loader -> Loader;
let with_metering l = put :metering true l;
let macro_meter l  = l.[:macro_meter else ()];

let put k v l = l.[k => v];

/// The index of a module, by any name it answers to, or `()`.
let find l name = ((by_name l)).[name else ()];

let module_at l i = (module_map l).[i else ()];

/// Record a module at the end, which is the index everything else will know it
/// by. The two writers are `load_items!` and `hoist_mod!`, and both used to say
/// `list.append (modules l) [m]` -- which copies the list, so loading a program
/// was O(modules^2) bytes. See "A table indexed by module wants to be a map" in
/// docs/notes/compiler-scaling.md: this is the same finding as `scope.envs`, on the loader's copy of
/// the same table.
let add_module m l =
    put :module_count (module_count l + 1) (put :modules ((module_map l).[module_count l => m]) l);

/// Replace module `mi`. Expansion rewrites a declaration in place and puts the
/// module back; nothing here changes the count.
let set_module mi m l = put :modules ((module_map l).[mi => m]) l;

/// Rewrite every module. Expansion does this twice -- once to stage a snapshot
/// and once to turn `macro` declarations into ordinary `let`s -- and both used
/// to rebuild the whole list.
let map_modules f l =
    put :modules (list.fold (fn acc i -> acc.[i => f (module_at l i)])
                            (module_map l) (list.range 0 (module_count l))) l;

/// Is this path provided by the runtime rather than by Dream source?
let is_host l p = is_native p || list.contains p (host_modules l);

let note d l = put :diags (list.append (diags l) [d]) l;

/// Record a diagnostic against the file it was found in.
let complain span message source l = note (diag.in_source source (diag.error span message)) l;

let complain_note span message extra source l =
    note (diag.in_source source (diag.with_note extra (diag.error span message))) l;

let mark_visited name l = put :visited (((visited l)).[name => true]) l;
let is_visited l name = map_has (visited l) name;

/// Native modules are recorded in first-seen order, because that order is the
/// index a call to one is compiled to.
let record_native p l =
    if list.contains p (natives l) { l } else { put :natives (list.append (natives l) [p]) l };

let enter name l = put :in_progress (list.append (in_progress l) [name]) l;
let leave l = {
    let stack = in_progress l;
    put :in_progress (list.take (list.length stack - 1) stack) l
};
let is_loading l name = list.contains name (in_progress l);

// --- resolving a name to a file ----------------------------------------------

let dotted_segments p = list.filter (fn s -> not (str.is_empty s)) (str.split "." p);

let rec search_for! bases rel =
    match bases {
        [] => (),
        [base, ..rest] => {
            let direct = path.with_extension "dr" (path.join_all base rel);
            // `std/list/mod.dr` lets a module grow into a directory later
            // without any of its importers changing.
            let as_dir = path.join (path.join_all base rel) "mod.dr";
            if path.is_file! direct { direct }
            else if path.is_file! as_dir { as_dir }
            else { search_for! rest rel }
        },
    };

/// Turn a dotted path into a file.
///
/// The first segment may name a package, which is what makes grouping
/// independent of layout: `std.list` is the module `list` in whichever
/// directory calls itself `std`. Failing that, the whole path is a module
/// inside the current package, so a project's own files are reachable without
/// repeating its name. The bare search paths come last, so a project with no
/// manifest still works.
let resolve_path! l dotted = {
    let segs = dotted_segments dotted;
    let ps = packages l;
    let in_package =
        if list.length segs > 1 {
            match package.find ps (list.head segs) {
                () => (),
                pkg => package.module_file! pkg (list.tail segs),
            }
        }
        else {
            // A package may also hold a module named after itself: `std`
            // meaning `std/mod.dr` or `std/std.dr`.
            match package.find ps (list.head segs) {
                () => (),
                pkg => match package.module_file! pkg ["mod"] {
                    () => package.module_file! pkg [list.head segs],
                    f  => f,
                },
            }
        };
    match in_package {
        () => match match package.current ps {
                        () => (),
                        cur => package.module_file! cur segs,
                    } {
            () => search_for! (search_paths l) segs,
            f  => f,
        },
        f => f,
    }
};

/// Is `dep` a module already loaded under one of `current`'s enclosing scopes?
/// `derive shape` inside `a.circle` means `a.shape`, the sibling, so the search
/// walks outwards: `a.circle.shape`, then `a.shape`, then nothing. Answers with
/// the qualified name it found.
let rec local_module l scope dep = {
    let candidate = scope + "." + dep;
    if find l candidate != () { candidate }
    else {
        let segs = dotted_segments scope;
        if list.length segs <= 1 { () }
        else { local_module l (str.join_str "." (list.take (list.length segs - 1) segs)) dep }
    }
};

/// The name a module is known by, regardless of how it was imported: the
/// package it belongs to, plus its path inside that package.
///
/// Where the file actually *is* decides this, not how it was spelled. A
/// dependency reached as `../greet` produces a path that literally begins with
/// the depending package's directory, so comparing the text would claim the
/// wrong owner. Nested packages are legal, so the innermost one wins: the
/// longest source root still containing the file is its real owner.
let canonical_name! l file fallback = {
    let real = path.absolute! file;
    let best = list.fold (fn found pkg -> {
        let src = path.absolute! (package.src pkg);
        match package.module_name src real {
            () => found,
            inside => {
                let depth = list.length (path.segments src);
                if list.head found >= depth { found }
                else { [depth, package.name pkg + "." + inside] }
            },
        }
    }) [0 - 1, ()] (package.packages (packages l));
    match list.nth 1 best { () => fallback, name => name }
};

// --- explaining a failure ----------------------------------------------------

let comma_list xs = if list.is_empty xs { "nothing" } else { str.join_str ", " xs };

/// Explain a failed import in terms of what was actually searched. An import
/// that cannot be resolved is nearly always a small mistake -- a typo, a
/// missing `-L` -- and which of those it is shows in what the compiler could
/// see, so that is what it says.
let unresolved_note! l dotted = {
    let ps = packages l;
    let first = list.head (dotted_segments dotted);
    match package.find ps first {
        () => {
            let hosts = list.append native_modules (host_modules l);
            let head = "no package is named `" + first + "`, and no file matched.\n"
                       + "Host-provided modules: " + comma_list hosts + ".";
            let embedding =
                if list.is_empty (host_modules l) {
                    "\nAn embedder's own host module must be named with "
                    + "`--host-module <path>` so that importing it compiles."
                }
                else { "" };
            let known =
                if list.is_empty (package.names ps) {
                    "\nNo packages were found. A package is any directory with a "
                    + "`mind.toml`; point at one with -L."
                }
                else { "\nKnown packages: " + comma_list (package.names ps) + "." };
            let here = match package.current ps {
                () => "",
                cur => "\nCurrent package `" + package.name cur + "` provides: "
                       + comma_list (package.modules! cur) + ".",
            };
            head + embedding + known + here
        },
        pkg => {
            let rest = if str.starts_with (first + ".") dotted {
                           str.slice (str.byte_length first + 1)
                                     (str.byte_length dotted - str.byte_length first - 1) dotted
                       }
                       else { dotted };
            "package `" + package.name pkg + "` was found at " + package.root pkg
            + ", but has no module `" + rest + "`."
            + "\nIt provides: " + comma_list (package.modules! pkg) + "."
        },
    }
};

// --- `when`, resolved before anything else looks at the module ---------------

/// Flatten `when` items, keeping only the branches whose condition holds. Done
/// as the file is read, so the rest of the compiler never sees a conditional
/// item at all -- and an `import` inside a `when` that is off is never
/// followed, so a module only test builds need is never even opened.
let rec expand_items cfg items =
    list.concat (list.map (fn item ->
        match item {
            [:when, cond, inner, _] =>
                if config.eval cfg cond { expand_items cfg inner } else { [] },
            [:priv, d, span] => [d, [:private, span]],
            [:record, kind, name, fields, members, bases, span] =>
                [syntax.record_derived kind name fields members bases span],
            // A union is a module and, in the parent, a global of the same
            // name holding its description -- see `syntax.union_decl`.
            [:union_decl, name, params, variants, members, span] =>
                syntax.union_decl name params variants members span,
            other => [other],
        }) items);

/// Every record declaration `expand_items` is about to rewrite, in the same
/// order and under the same `when` conditions -- an item the configuration
/// switches off becomes no module, so it is no record either.
let rec record_items cfg items =
    list.concat (list.map (fn item ->
        match item {
            [:when, cond, inner, _] =>
                if config.eval cfg cond { record_items cfg inner } else { [] },
            [:record, kind, name, fields, members, bases, span] =>
                [[kind, name, fields, members, span]],
            _ => [],
        }) items);

/// Remember what `owner`'s records were written as, before the rewrite.
///
/// A `group`, a `struct` or a `mapping` becomes a module of generated
/// functions, and those carry spans in a reserved part of the offset space
/// because several of them stand where one declaration was written. So by the
/// time any later pass walks this program the fields are gone, the kind is
/// gone, and the place it was written is gone with them -- an editor asking
/// "what is `Point.x` and where is it" has nothing at all to answer from, and
/// answered `x ` and the end of the file. This is that, kept, and nothing in
/// the compiler reads it: `owner + "." + name` is the module the rewrite made.
let note_records owner items l =
    put :records (records l + list.map (fn r -> list_cons owner r)
                                       (record_items (config_of l) items)) l;

// --- loading -----------------------------------------------------------------

/// The dotted paths a module depends on, with the span to blame: its imports
/// and its `derive`s, which resolve the same way.
let dependencies items =
    list.concat (list.map (fn item ->
        match item {
            [:import, segs, _, _, span] => [[str.join_str "." segs, span]],
            [:derive, segs, span]       => [[str.join_str "." segs, span]],
            _ => [],
        }) items);

/// The same cycle, wherever it is noticed. `modules must form a tree` is the
/// whole explanation: they are compiled together into one image, so there is no
/// point at which a half-built module could be handed to the one that needs it.
let cycle at name from_source l =
    complain_note at ("import cycle: " + str.join_str " -> " (in_progress l) + " -> " + name)
                  "modules are compiled together, so their imports must form a tree"
                  from_source l;

/// Find a hoisted module through an alternate spelling of its parent file.
let rec nested_module l dotted =
    match find l dotted {
        i if i != () => i,
        _ => {
            let segs = dotted_segments dotted;
            if list.length segs <= 1 { () }
            else {
                let parent = str.join_str "." (list.take (list.length segs - 1) segs);
                match nested_module l parent {
                    () => (),
                    i => find l (module_name (module_at l i) + "." + list.last segs),
                }
            }
        },
    };

/// A dotted import can name a block inside a file, or a member of that block.
/// Load the nearest containing file before asking what it declares.
let rec load_container! l dotted at from_source = {
    let segs = dotted_segments dotted;
    if list.length segs <= 1 { l }
    else {
        let parent = str.join_str "." (list.take (list.length segs - 1) segs);
        if nested_module l parent != () { l }
        else if resolve_path! l parent != () { load_named! l parent at from_source }
        else { load_container! l parent at from_source }
    }
};

let rec load_named! l dotted at from_source =
    if is_host l dotted { record_native dotted (mark_visited dotted l) }
    else if is_visited l dotted { l }
    else if is_loading l dotted { cycle at dotted from_source l }
    else {
        match resolve_path! l dotted {
            // No file, for a module the host provides when there is none.
            // No module by that name -- but a *package* by that name is
            // `import std;`, which brings in everything the package provides.
            () => {
                let containing = load_container! l dotted at from_source;
                let nested = nested_module containing dotted;
                let segs = dotted_segments dotted;
                let parent = str.join_str "." (list.take (list.length segs - 1) segs);
                let owner = nested_module containing parent;
                let tried = load_package! containing dotted at from_source;
                if nested != () {
                    mark_visited dotted (put :by_name
                        (((by_name containing)).[dotted => nested]) containing)
                }
                else if owner != () {
                    // Resolution binds the final segment like a selective import.
                    put :by_name (((by_name containing)).[parent => owner]) containing
                }
                else if list.nth 1 tried { list.head tried }
                else {
                    complain_note at ("cannot find module `" + dotted + "`")
                                  (unresolved_note! l dotted) from_source (list.head tried)
                }
            },
            file => {
                // Identity is the file. Already loaded under another spelling
                // means another name for the same module, not another module.
                let abs = path.absolute! file;
                match ((by_path l)).[abs else ()] {
                    () => {
                        let name = canonical_name! l file dotted;
                        // The check above compares the name as *written*, which
                        // is not enough on its own: a module being loaded is on
                        // the stack under its canonical name, and `import b`
                        // from inside `pkg.a` is spelled nothing like `pkg.a`.
                        // Two files importing each other would then recurse
                        // until the stack ran out. So the question is asked
                        // again here, where the file has been resolved and can
                        // be named the way the stack names it.
                        if is_loading l name { cycle at name from_source l }
                        else {
                            let after = load_file! l file name at from_source;
                            // The spelling the importer used becomes another
                            // way to reach the module it found.
                            let aliased = match find after name {
                                () => after,
                                i  => put :by_name (((by_name after)).[dotted => i]) after,
                            };
                            mark_visited dotted aliased
                        }
                    },
                    existing =>
                        mark_visited dotted
                            (put :by_name (((by_name l)).[dotted => existing]) l),
                }
            },
        }
    };

/// `import std;` where `std` names a package rather than a module: load every
/// module the package provides, and record the name as a namespace so that
/// `std.list` resolves through it.
///
/// Answers `[loader, found]`, so a caller can tell "there was no such package"
/// from "the package was empty" and report the first as an unresolved import.
let rec load_package! l dotted at from_source =
    match package.find (packages l) dotted {
        () => [l, false],
        pkg => {
            let members = package.modules! pkg;
            if list.is_empty members {
                [complain_note at ("package `" + dotted + "` provides no modules")
                               "a package's modules are the `.dr` files under its `src`"
                               from_source l,
                 true]
            }
            else {
                let seen = mark_visited dotted
                    (put :namespaces (list.append (namespaces l) [dotted]) l);
                [list.fold (fn acc m -> {
                    let full = dotted + "." + m;
                    // A module of the package that is already being loaded is
                    // the one doing the importing: `mind/std/all.dr` says
                    // `import std;`. That is asking for its siblings, not a
                    // cycle.
                    if is_loading acc full { acc } else { load_named! acc full at from_source }
                 }) seen members,
                 true]
            }
        },
    };

let rec load_file! l file name at from_source =
    if is_visited l name { l }
    else {
        // The overlay first: a file that is open in an editor is whatever the
        // editor says it is, and what is on disk is out of date by definition.
        let text = match ((overlay l)).[file else ()] {
            () => path.read_file! file,
            t => t,
        };
        match text {
            () => complain at ("cannot read " + file) from_source l,
            text0 => load_text! l text0 file name file
        }
    };

/// Register `mod child { .. }` as the module `parent.child`, and answer the
/// import that replaces it in the parent: `[loader, item]`.
///
/// The submodule shares the parent's source file, so its diagnostics point at
/// the right lines. It is deliberately *not* recorded by path: identity there
/// is the file, and the file already belongs to the parent.
let rec hoist_mod! l parent source m =
    match m {
        [:mod, child, items, span] => {
            let full = parent + "." + child;
            let stand_in = ast.import_d (dotted_segments full) child () span;
            if find l full != () {
                [complain span ("`" + child + "` is already a module here") source l, stand_in]
            }
            else {
                // Its own `when`s and nested `mod`s, resolved the way a file's
                // are: by the time this is recorded it is an ordinary module.
                let kept = expand_items (config_of l) items;
                let nested = list.fold (fn acc item ->
                    match item {
                        [:mod, _, _, _] => {
                            let done = hoist_mod! (list.head acc) full source item;
                            [list.head done, list.append (list.nth 1 acc) [list.nth 1 done]]
                        },
                        other => [list.head acc, list.append (list.nth 1 acc) [other]],
                    }) [note_records full items l, []] kept;
                let inner_items = list.nth 1 nested;

                // A submodule may import, so follow those before it is recorded.
                let followed = list.fold (fn acc d -> {
                    let dep = list.head d;
                    // Its own submodule, put there by the hoist above, or a
                    // sibling reached by walking outwards: either way already
                    // registered.
                    if find acc dep != () || local_module acc full dep != () { acc }
                    else { load_named! acc dep (list.nth 1 d) source }
                }) (enter full (list.head nested))
                   (dependencies inner_items);

                let recorded = leave followed;
                let index = module_count recorded;
                [mark_visited full
                    (put :by_name (((by_name recorded)).[full => index])
                        (add_module (loaded full full source inner_items) recorded)),
                 stand_in]
            }
        },
        _ => [l, m],
    };

// --- parsing ahead ------------------------------------------------------------
//
// Parsing is a fifth of a compile and every file's parse is independent of
// every other's, but the loader cannot know which files it needs until it has
// parsed the ones that import them -- it walks the imports depth first, and the
// order it records modules in is the order that walk finishes them.
//
// So the walk stays exactly as it is, and only the parsing moves. When a
// module has been parsed, each of its imports that names a file not yet seen
// is read and handed to a process of its own to parse, all of them at once;
// the walk then descends into the first while the others are being parsed on
// other workers, and meets each one's answer waiting when it gets there. A
// module's imports are usually several files, and each of those imports more,
// so the machine stays busy from the root down. On a self-compile this is most
// of the parse stage taken off the critical path.
//
// Nothing about what is loaded, or in what order, depends on this: a parse
// fetched ahead is used only when the walk reaches the same file with the same
// text, and anything else -- a dependency that resolves some other way, a file
// the walk ends up reaching under another name -- is simply parsed where it
// always was. A parse that raises is not the child's to report: it answers
// `:crashed`, and the file is parsed again in place, where the raise happens
// exactly as it did before there was a child.

let fetched l = l.[:prefetch else (%{})];

/// The text a file would be loaded with: the editor's buffer, then the disk.
let text_of! l file = match ((overlay l)).[file else ()] {
    () => path.read_file! file,
    t => t,
};

/// A process parsing `text`. Its own function, and not written inline where it
/// is used, because a suspension carries the frame it was made in and `spawn!`
/// copies the suspension into the child whole: made inside the walk, that frame
/// held the loader, and every child received a copy of every module parsed so
/// far. Here the frame holds the text and nothing else.
let parse_elsewhere! text =
    spawn! $( try! { strict! (parser.parse_module text) } catch e { [:crashed, e] } );

/// The same, answering through the shared area; see `load_shared!`. A parse
/// the area refuses -- nothing in one should hold a suspension, but if it did
/// -- comes back `:crashed` and is parsed again in place, like any other.
let parse_shared! text =
    spawn! $( try! { vm.share! (parser.parse_module text) } catch e { [:crashed, e] } );

/// Start parsing, elsewhere, every file these imports of the module `name`
/// will load and nothing has yet.
/// The modules a file's text imports at the top level, read off the text
/// without parsing it: every line that begins `import `, up to the end of the
/// dotted name. A guess, and allowed to be one -- a name it misses is parsed
/// where the walk meets it, and one it invents is a parse nobody joins -- and
/// cheap enough to make before a file is parsed, which is what lets the
/// parses of a whole program start at once rather than a level at a time.
let name_bytes = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";

let rec import_lines text at acc = {
    let i = str_find text "\nimport " at;
    if i < 0 { acc }
    else {
        let start = i + 8;
        let stop = str_span text start name_bytes;
        let named = str_slice text start (stop - start);
        let bare = if str.ends_with "." named { str_slice named 0 (len named - 1) } else { named };
        import_lines text stop (if len bare == 0 { acc } else { list_cons bare acc })
    }
};

let scanned_imports text = list.reverse (import_lines ("\n" + text) 0 []);

/// Start parsing, elsewhere, every file these dotted names will load and
/// nothing has yet -- and, reading each one's imports off its text, every file
/// those will load too.
let rec prefetch! l deps = match deps {
    [] => l,
    [dep, ..rest] => {
        let file = if is_host l dep || is_visited l dep { () } else { resolve_path! l dep };
        let wanted = file != () && not (map_has (fetched l) file)
                     && not (map_has (by_path l) (path.absolute! file));
        let text = if wanted { text_of! l file } else { () };
        if text == () { prefetch! l rest }
        else {
            let child = if l.[:share_parses else false] { parse_shared! text }
                        else { parse_elsewhere! text };
            let marked = put :prefetch ((fetched l).[file => [text, child]]) l;
            prefetch! (prefetch! marked (scanned_imports text)) rest
        }
    },
};

/// This file's parse: the one fetched ahead if there is one for the same text,
/// and one made here otherwise.
let parse_of! l file text = match ((fetched l)).[file else ()] {
    [same, child] if same == text => match join! child {
        [:crashed, _] => parser.parse_module text,
        answer => answer,
    },
    _ => parser.parse_module text,
};

let rec load_text! l0 text display name file = {
    // Every file this one leads to is set parsing before this one is parsed.
    // For the root that is the whole program; for any other file it is almost
    // always nothing, because the root's scan already reached it.
    let l = prefetch! l0 (scanned_imports text);
    let source = file_count l;
    let read = add_file (diag.source display text) l;
    // A same-text parse already in hand is reused rather than done again: an
    // editor sends the whole buffer with every change, and every request after
    // the change is about that same buffer.
    match ((parsed l)).[file else ()] {
        [same, result] => {
            if same == text { load_items! read source result display name file text }
            else {
                let parsed = parse_of! l file text;
                load_items! (put_parsed file [text, parsed] read) source parsed display name file text
            }
        },
        _ => {
            let parsed = parse_of! l file text;
            load_items! (put_parsed file [text, parsed] read) source parsed display name file text
        },
    }
};

/// The part of loading that a same-text hit skips: registering an already
/// parsed module. `parsed` is `parser.parse_module`'s answer -- `[:ok, items,
/// sites]` or `[:error, message, span]`. `source` is the file's index in the
/// loader's table, counted before this file is added -- a file shares a source
/// with the submodules written inside it, which means the pre-add count.
let load_items! l source parsed display name file text = {
    match parsed {
        [:error, message, span] => complain span message source l,
        [:ok, items, sites] => {
            // Resolve `when` before anything else looks at the module.
            let kept = expand_items (config_of l) items;
            let noted = note_records name items (note_expanding source sites l);

            // A `mod name { .. }` is a module written inside another. Register
            // it as `parent.name` and leave the parent importing it, so from
            // here on a submodule and a file are the same thing to every later
            // pass. Submodules go into the list first, which keeps the
            // dependencies-first order.
            let hoisted = list.fold (fn acc item ->
                match item {
                    [:mod, _, _, _] => {
                        let done = hoist_mod! (list.head acc) name source item;
                        [list.head done, list.append (list.nth 1 acc) [list.nth 1 done]]
                    },
                    other => [list.head acc, list.append (list.nth 1 acc) [other]],
                }) [enter name noted, []] kept;
            let items_out = list.nth 1 hoisted;

            // Follow this module's own imports before recording it, so the
            // module list comes out with dependencies first.
            let followed = list.fold (fn acc d -> {
                let dep = list.head d;
                // `import io.{ .. }` inside a module declaring `mod io { .. }`
                // means *that* submodule, already loaded, so there is nothing
                // to search the file system for.
                if local_module acc name dep != () { acc }
                else { load_named! acc dep (list.nth 1 d) source }
            }) (list.head hoisted)
               (dependencies items_out);

            let recorded = leave followed;
            let index = module_count recorded;
            mark_visited name
                (put :by_path (((by_path recorded)).[(path.absolute! file) => index])
                    (put :by_name (((by_name recorded)).[name => index])
                        (add_module (loaded name file source items_out) recorded)))
        },
    }
};

// --- the test runner ---------------------------------------------------------

/// Does this module export tests? A module opts in by defining `tests`, by
/// convention inside a `when test { .. }` so that it costs nothing otherwise.
let exports_tests m =
    list.any (fn item ->
        match item {
            [:let, "tests", [], _, _, span] => not (private_declaration m span),
            _ => false,
        }) (module_items m);

/// Build an entry point that runs the tests every loaded module exports.
///
/// Generating the runner from what was actually loaded means there is no
/// registry to keep in step, and no test that is silently never run.
let add_test_runner! l = {
    let suites = list.flat_map (fn i ->
            if exports_tests (module_at l i) { [[module_name (module_at l i), i]] } else { [] })
        (list.range 0 (module_count l));
    let src =
        if list.is_empty suites {
            // Still a valid program: it reports that there was nothing to run,
            // which is more use than an image with no entry point. One string,
            // not two: `console.print!` is variadic, so a second argument would
            // be a second thing printed, and generated code should not depend on
            // that to read correctly.
            "import std.console;\n"
            + "let main! = { console.print! \"no tests found "
            + "(a module exports tests by defining `tests`)\" };\n"
        }
        else {
            let alias s = "dreams_test_module_" + to_string (list.nth 1 s);
            "// Generated by `--test`: runs the tests each module exports.\n"
            + "import std.test as dreams_test_framework;\n"
            + str.join_str "" (list.map (fn s -> "import " + list.head s + " as " + alias s + ";\n")
                                        suites)
            + "let main! = dreams_test_framework.main_of! [\n"
            + str.join_str "" (list.map (fn s -> "    [\"" + list.head s + "\", "
                                                 + alias s + ".tests],\n") suites)
            + "];\n"
        };
    load_text! l src "<generated test runner>" "dreams.test_main" "<generated test runner>"
};

// --- the entry point ---------------------------------------------------------

/// Load the root file and everything it reaches.
///
/// The loader comes back even when loading failed, because it carries the
/// source files the diagnostics point into -- an error that cannot quote its
/// own line is much less use.
let load_root! l file test_mode = {
    // Name the root the way any other module in its package would be, so that a
    // module's identity does not depend on it being the entry point.
    let name = canonical_name! l file (path.stem file);
    let loaded_all = load_file! l file name ast.no_span 0;
    if test_mode { add_test_runner! loaded_all } else { loaded_all }
};

/// The session form of `load_root!`: a loader that already holds a program is
/// given the root file again, and the root is re-read in place at the *same*
/// index. Nothing else is touched -- a dependency stays visited, so its parse,
/// its `by_name`/`by_path` entries and its position in the module list all
/// survive. That is the whole point: a REPL compiles one entry at a time onto a
/// carried loader instead of discovering and loading everything from scratch on
/// every entry.
///
/// The old root has to be unmounted first, or it would be appended a second
/// time and the module list would grow by one -- and with it, every module's
/// index. Unmounting is exactly the three places the root is recorded: the
/// module list (it is last), the by-name and by-path maps that point at it, and
/// the visited mark that would otherwise make `load_file!` skip the re-read.
let reload_root! l file test_mode = {
    let name = canonical_name! l file (path.stem file);
    match find l name {
        () => load_root! l file test_mode,
        root_index => {
            let last = module_count l - 1;
            let unmounted =
                put :module_count last
                    (put :modules (map_remove (module_map l) last)
                        (put :by_name (map_remove (by_name l) name)
                            (put :by_path (map_remove (by_path l) (path.absolute! file))
                                (put :visited (map_remove (visited l) name) l))));
            load_file! unmounted file name ast.no_span 0
        }
    }
};

/// Where a module is looked for when nothing said where to look.
///
/// A compiler that can only find the standard library when it is told to is a
/// compiler every script has to be told about, so a root file gets three search
/// paths for free, and the order they are searched in is the point:
///
///   1. its own directory, so a program's siblings are modules of it;
///   2. the nearest enclosing `mind` directory that holds a `std`, so a
///      checkout is its own installation and `dream/tests/programs/match.dr`
///      can import `std.list` with no `-L` at all;
///   3. every entry of `$MINDV2_PATH`, which is where an installation keeps
///      what it ships.
///
/// The checkout beats the installation, and that is not a preference. With it
/// the other way round, an installed library that has fallen behind silently
/// shadows the one being edited: this compiler failed to build itself against
/// its own standard library because an older copy of `std` was installed, and
/// the error named a function that was right there in the file. A library that
/// travels with the source it is being built against is the one that was meant.
///
/// What the command line asked for comes before all three, because a search
/// path given by hand is a decision and these are a convenience.
let rec enclosing_minds! dir acc = {
    let candidate = path.join dir "mind";
    let grown = if io.is_dir! (path.join candidate "std") { list.append acc [candidate] }
                else { acc };
    let up = path.dirname dir;
    if up == dir { grown } else { enclosing_minds! up grown }
};

let default_search_paths! file extra =
    list.concat [
        // A root may be written `NAME=DIR`; as a search path it is the directory.
        list.map package.root_dir extra,
        [path.dirname file],
        enclosing_minds! (path.dirname (path.absolute! file)) [],
        match os.env! "MINDV2_PATH" {
            () => [],
            v => list.map (fn r -> path.expand_home! r) (package.split_roots v),
        },
    ];

/// The usual way in: discover packages around `file`, then load it.
let load! : :string -> [:string] -> :any -> :bool -> Loader;
let load! file roots cfg test_mode =
    load_root! (loader (package.discover! file roots) cfg (default_search_paths! file roots) [])
               file test_mode;

/// The same, with every parse fetched ahead handed back through the runtime's
/// shared area rather than copied (`vm.share!`), which is what a one-shot
/// compile wants: its syntax trees live as long as it does, and the copy was
/// most of what a parse elsewhere cost the walk that joins it. Not the
/// default, because nothing in the shared area is freed before the runtime
/// is, and a language server loads the program again at every keystroke.
let load_shared! : :string -> [:string] -> :any -> :bool -> Loader;
let load_shared! file roots cfg test_mode =
    load_root! (put :share_parses true
                    (loader (package.discover! file roots) cfg (default_search_paths! file roots) []))
               file test_mode;

/// The same, reading `ov` -- a map of path to text -- instead of the disk for
/// the files it names. This is what a language server loads through: the
/// program it must answer questions about is the one in the editor's buffers,
/// which may differ from the one on disk in every file at once.
let load_overlaid! : :string -> [:string] -> :any -> :bool -> %{ :string => :string } -> Loader;
let load_overlaid! file roots cfg test_mode ov =
    load_overlaid_cached! file roots cfg test_mode ov (%{});

/// `load_overlaid!` with the previous loader's parse cache carried in. Every
/// file whose text has not changed since that loader parsed it is loaded from
/// the cached result rather than lexed and parsed again; a language server that
/// answers a running editor this way parses only the buffer being edited.
///
/// The map travels back out in the loader it produces -- `parsed` -- so the
/// caller keeps passing what it got last time, and what it costs is one string
/// compare per module per request.
let load_overlaid_cached! file roots cfg test_mode ov parsed =
    load_root! (with_parsed parsed (with_overlay ov (loader (package.discover! file roots) cfg
                                                           (default_search_paths! file roots) [])))
               file test_mode;

let failed l = diag.error_count (diags l) > 0;

/// Every module that was loaded, in the order a later pass must walk them:
/// dependencies before what uses them.
let names l = list.map (fn m -> module_name m) (modules l);





// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    /// A loader with nothing found and nothing configured, which is what the
    /// tests that do not touch the file system start from.
    let bare cfg = loader package.empty cfg [] [];

    /// Load one module from text, the way a file would be but without one.
    let from_text! cfg src = load_text! (bare cfg) src "<test>" "t" "<test>";

    let on = config.define "test" config.empty;

    let items_of src = match parser.parse_module src { [:ok, items, _] => items, _ => [] };

    let tests = [
        // --- names ---
        test.case "a dotted path is its segments"
            $( test.eq! [["std", "list"], ["list"]]
                        [dotted_segments "std.list", dotted_segments "list"] ),
        test.case "the host's own modules are known by name"
            $( test.eq! [true, false] [is_native "std.console", is_native "std.nope"] ),

        // --- `when`, resolved as the file is read ---
        test.case "a when that holds contributes its items"
            $( test.eq! 1 (list.length (expand_items on (items_of "when test { let a = 1; }"))) ),
        test.case "a when that does not hold contributes nothing"
            $( test.eq! [] (expand_items config.empty (items_of "when test { let a = 1; }")) ),

        // What `expand_items` is about to destroy, kept for a tool. Nothing in
        // the compiler reads it -- see `note_records`.
        test.case "a record declaration is remembered as it was written"
            $( test.eq! [[:list, "Point", ["x", "y"]]]
                        (list.map (fn r -> [list.nth 0 r, list.nth 1 r,
                                            list.map (fn f -> ast.field_name f) (list.nth 2 r)])
                                  (record_items on (items_of "group Point { x, y }"))) ),
        test.case "the three keywords keep their backing kinds apart"
            $( test.eq! [:list, :array, :map]
                        (list.map (fn r -> list.head r)
                                  (record_items on (items_of
                                      "group A { x }\nstruct B { x }\nmapping C { x }"))) ),
        test.case "a record inside a `when` that is on is remembered"
            $( test.eq! 1 (list.length (record_items on
                              (items_of "when test { group Hidden { x } }"))) ),
        test.case "a record inside a `when` that is off becomes no module and no record"
            $( test.eq! [] (record_items config.empty
                              (items_of "when test { group Hidden { x } }")) ),
        test.case "a record's fields keep the spans they were written at"
            $( test.eq! [[14, 15], [17, 18]]
                        (list.map (fn f -> ast.field_span f)
                                  (list.nth 2 (list.head (record_items on
                                      (items_of "group Point { x, y }"))))) ),
        test.case "a nested when is resolved too"
            $( test.eq! 1 (list.length (expand_items on
                   (items_of "when test { when test { let a = 1; } }"))) ),
        test.case "an import inside a when that is off is never followed"
            $( test.eq! [] (natives (from_text! config.empty "when test { import std.console; }")) ),
        test.case "an import inside a when that holds is"
            $( test.eq! ["std.console"] (natives (from_text! on "when test { import std.console; }")) ),

        // --- what a module depends on ---
        test.case "imports and derives are both dependencies"
            $( test.eq! ["std.list", "std.seq"]
                        (list.map (fn d -> list.head d)
                                  (dependencies (items_of "import std.list;\nderive std.seq;"))) ),
        test.case "a let is not a dependency"
            $( test.eq! [] (dependencies (items_of "let a = 1;")) ),

        // --- loading ---
        test.case "a module is recorded under its name"
            $( test.eq! ["t"] (names (from_text! on "let a = 1;")) ),
        test.case "a host module is recorded rather than searched for"
            $( test.eq! [["std.console"], ["t"]]
                        { let l = from_text! on "import std.console;";
                          [natives l, names l] } ),
        test.case "the same host module twice is recorded once"
            $( test.eq! ["std.console"]
                        (natives (from_text! on "import std.console;\nimport std.console;")) ),
        test.case "a parse error is a diagnostic, not a raise"
            $( test.eq! 1 (list.length (diags (from_text! on "let = ;"))) ),
        test.case "a module that failed to parse is not recorded"
            $( test.eq! [] (names (from_text! on "let = ;")) ),
        test.case "failure is what the diagnostics say it is"
            $( test.eq! [true, false]
                        [failed (from_text! on "let = ;"), failed (from_text! on "let a = 1;")] ),

        // --- `mod`, hoisted to a module of its own ---
        test.case "a mod becomes a module named for its parent"
            $( test.eq! ["t.inner", "t"] (names (from_text! on "mod inner { let a = 1; }")) ),
        test.case "a nested mod is hoisted the whole way out"
            $( test.eq! ["t.a.b", "t.a", "t"]
                        (names (from_text! on "mod a { mod b { let x = 1; } }")) ),
        test.case "the parent is left importing what was hoisted out of it"
            $( test.eq! [[:import, ["t", "inner"], "inner", ()]]
                        (list.map (fn i -> list.take 4 i)
                                  (module_items (module_at (from_text! on "mod inner { let a = 1; }")
                                                           1))) ),
        test.case "a mod's own imports are followed"
            $( test.eq! ["std.console"]
                        (natives (from_text! on "mod inner { import std.console; }")) ),
        test.case "two mods of one name is an error, not a silent replacement"
            $( test.eq! 1 (list.length (diags (from_text! on
                   "mod a { let x = 1; }\nmod a { let y = 2; }"))) ),
        test.case "a when inside a mod is resolved as a file's would be"
            $( test.eq! [] (natives (from_text! config.empty
                   "mod inner { when test { import std.console; } }")) ),

        // --- the module a name is already loaded under ---
        test.case "a sibling is found by walking outwards"
            $( test.eq! ["a.shape", ()]
                        { let l = put :by_name (((%{})).["a.shape" => 0])
                                      (bare on);
                          [local_module l "a.circle" "shape", local_module l "a.circle" "nope"] } ),
        test.case "a module's own submodule is found first"
            $( test.eq! "a.b.util"
                        (local_module (put :by_name (((((%{})).["a.b.util" => 0])).["a.util" => 1]) (bare on))
                                      "a.b" "util") ),

        // --- the stack that catches a cycle ---
        test.case "what is being loaded is what is on the stack"
            $( test.eq! [true, false, false]
                        { let l = enter "b" (enter "a" (bare on));
                          [is_loading l "a", is_loading (leave l) "b", is_loading (bare on) "a"] } ),

        // --- the generated test runner ---
        test.case "a module exports tests by defining `tests`"
            $( test.eq! [true, false, false]
                        [exports_tests (loaded "m" "m" 0 (items_of "let tests = [];")),
                         exports_tests (loaded "m" "m" 0 (items_of "let tests x = [];")),
                         exports_tests (loaded "m" "m" 0 (items_of "let other = [];"))] ),
        test.case "a runner is generated even when nothing exports tests"
            $( test.eq! ["t", "dreams.test_main"]
                        (names (add_test_runner! (from_text! on "let a = 1;"))) ),

        // --- explaining a failure ---
        test.case "a list of nothing says so rather than being blank"
            $( test.eq! ["nothing", "a, b"] [comma_list [], comma_list ["a", "b"]] ),
        test.case "an unresolved import says what was searched"
            $( test.true! (str.contains_str "no package is named `nowhere`"
                                            (unresolved_note! (bare on) "nowhere.at_all")) ),
    ];
}
