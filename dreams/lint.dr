// Warnings about programs that are correct and will still go wrong.
//
// The first trap is an accumulator nobody forces.
//
//     let rec total i n acc = if i > n { acc } else { total (i + 1) n (acc + i) };
//
// Dream is lazy, so each call hands `acc + i` on suspended, holding the last
// call's `acc`, which is itself suspended. Nothing in the loop looks at it, so
// a million-step loop builds a million-link chain, and forcing the answer
// walks it -- far enough to run the machine out of depth. `list.fold_strict`
// exists because of it, `bytescan` grew a guard because of it, and the cure is
// one character: `!acc` forces the argument as each call starts.
//
// A strictness analysis could find these and more, and was measured worthless
// for what it was built for (see "NOT a strictness analysis" in
// docs/notes/vm-performance.md). This is the narrow case instead, read off the
// syntax: a parameter whose every use either grows it by `+`, `-` or `*` in a
// call of the function itself, hands it back unchanged to the same position,
// or *is* the function's answer. A parameter used any other way -- tested,
// passed to anything else, rebound, named in a lambda -- is left alone,
// because that use may be what forces it. So the warning is never wrong about
// the chain; it only misses the ones it cannot see.

import std.list;
import dreams.ast;

/// What a walk over one parameter's uses has found: whether a call grows it,
/// and whether anything else touches it. `other` is what clears it.
group Uses { grows = false, other = false }

let no_uses = Uses.new ();
let grown u = Uses.set_grows true u;
let touched u = Uses.set_other true u;

/// The operators that build a chain when their result is handed on unforced.
/// `/` and `%` are left out: a loop does not usually accumulate through them,
/// and either can raise, which is a reason the program might want it lazy.
let grows_through : :atom -> :bool;
let grows_through op = op == :add || op == :sub || op == :mul;

/// A saturated call of the function itself: `f a b` for an `f` of two
/// parameters. Partial applications and calls through a pipe are not counted.
let self_args f k e = match e {
    [:apply, [:name, g, _], args, _] if g == f && list.length args == k => args,
    _ => (),
};

/// Every use of `n` anywhere in `e` is "something else", except inside a call
/// of the function itself, which `call_uses` reads argument by argument.
///
/// The walk is over the tree as lists rather than node by node, so that it
/// cannot miss a form: any string equal to `n` that is not a plain `[:name, n,
/// _]` -- a binder, a pattern, a field, a parameter of a lambda -- counts as
/// touching it, which is the conservative answer.
let rec uses f k i n e u =
    if Uses.other u { u }
    else { match e {
        [:name, m, _] => if m == n { touched u } else { u },
        _ => match self_args f k e {
            () => match type_of e {
                :list => list.fold (fn acc x -> uses f k i n x acc) u e,
                :string => if e == n { touched u } else { u },
                _ => u,
            },
            args => call_uses f k i n args 0 u,
        },
    } };

let rec call_uses f k i n args j u =
    match args {
        [] => u,
        [a, ..rest] =>
            call_uses f k i n rest (j + 1) (if j == i { step_uses f k i n a u } else { uses f k i n a u }),
    };

/// The argument in the parameter's own position: handed back as it is, grown
/// by an operator, or anything else.
let step_uses f k i n a u =
    match a {
        [:name, m, _] if m == n => u,
        [:binary, op, [:name, m, _], r, _] if m == n && grows_through op => uses f k i n r (grown u),
        [:binary, op, l, [:name, m, _], _] if m == n && op != :sub && grows_through op =>
            uses f k i n l (grown u),
        _ => uses f k i n a u,
    };

/// Uses in answer position, where the parameter being the answer is not a use
/// at all: the caller gets the chain and forces it, and that is the overflow.
let rec answer_uses f k i n e u =
    match e {
        [:name, m, _] if m == n => u,
        [:if, c, t, el, _] => answer_uses f k i n el (answer_uses f k i n t (uses f k i n c u)),
        [:block, stmts, _] if not (list.is_empty stmts) => {
            let last = list.last stmts;
            let before = list.fold (fn acc s -> uses f k i n s acc) u (list.take (list.length stmts - 1) stmts);
            match last {
                [:let, _, _, _, _, _] => uses f k i n last before,
                [:let_p, _, _, _] => uses f k i n last before,
                _ => answer_uses f k i n last before,
            }
        },
        [:match, s, arms, _] =>
            list.fold (fn acc arm -> match arm {
                           [pattern, guard, body, _] =>
                               answer_uses f k i n body (uses f k i n guard (uses f k i n pattern acc)),
                           _ => uses f k i n arm acc,
                       })
                      (uses f k i n s u) arms,
        _ => uses f k i n e u,
    };

/// The parameters of `let f ps = body` that are accumulators nothing forces,
/// as `[name, span]`. Strict parameters, patterns and `()` are never named.
let lazy_accumulators : :string -> [:any] -> :any -> [:any];
let lazy_accumulators f ps body = {
    let k = list.length ps;
    list.concat (list.map (fn i -> {
        let p = list.nth i ps;
        let n = ast.param_name p;
        if type_of n != :string || ast.param_strict p || ast.param_pattern p != () { [] }
        else {
            let u = answer_uses f k i n body no_uses;
            if Uses.grows u && not (Uses.other u) { [[n, list.nth 1 p]] } else { [] }
        }
    }) (list.range 0 k))
};

// --- a force that is itself suspended ------------------------------------------
//
// The other trap, and the one docs/language-spec.md has to warn about in
// words: `[:ok, strict! x]` reads as "force `x`, then build the pair", and it
// is a pair whose second element is a suspended force. An element of a list,
// array or map is suspended like any other, and a `strict!` written as one is
// an element, so it forces nothing until the element is read -- which is the
// moment it would have been forced anyway. The fix is to make it a statement,
// which a block runs in order: `strict! x;` and then `[:ok, x]`.
//
// Only the literal element is read. `f (strict! x)` is as suspended, but an
// argument may go to a native that forces it, or be forced in the callee's
// first line, and telling those apart is a strictness analysis; an element of
// a literal is never anything but stored.

/// Is this `strict! e`?
let is_force e = match e {
    [:apply, [:name, "strict!", _], [_], _] => true,
    _ => false,
};

let element_force acc x = if is_force x { list.cons (ast.span x) acc } else { acc };

/// The spans of every `strict!` written as an element of a literal in `e`, in
/// the order they were written.
let suspended_forces : :any -> [:any];
let suspended_forces e = list.reverse (forces_in e []);

let rec forces_in e acc =
    if type_of e != :list { acc }
    else {
        let here = match e {
            [:list, items, _] if type_of items == :list => list.fold element_force acc items,
            [:array, items, _] if type_of items == :list => list.fold element_force acc items,
            [:map, pairs, _] if type_of pairs == :list =>
                list.fold (fn a pair -> match pair { [k, v] => element_force (element_force a k) v, _ => a })
                          acc pairs,
            _ => acc,
        };
        list.fold (fn a x -> forces_in x a) here e
    };

// --- local, syntax-proven pitfalls -------------------------------------------

/// Keep the literal kind: map keys need not share numeric equality semantics.
/// Unknown expressions and floats are deliberately left to runtime.
let literal_key e = match e {
    [kind, value, _] if list.contains kind [:int, :str, :char, :atom, :bool] => [kind, value],
    [:unit, _] => [:unit],
    _ => (),
};

let rec catches_all p = match p {
    [:wildcard, _] => true,
    [:bind, _, _] => true,
    [:as_p, inner, _, _, _] => catches_all inner,
    _ => false,
};

let pattern_key p = match p {
    [:literal, e, _] => literal_key e,
    _ => (),
};

let rec duplicate_keys pairs seen acc = match pairs {
    [] => acc,
    [[k, _], ..rest] => {
        let key = literal_key k;
        let next = if key != () && list.contains key seen {
            list.cons [ast.span k, "duplicate literal map key: the earlier value is overwritten",
                       "remove the duplicate key or give this entry a different key"] acc
        } else { acc };
        duplicate_keys rest (if key == () { seen } else { list.cons key seen }) next
    },
    _ => acc,
};

let rec unreachable_arms arms covered seen acc = match arms {
    [] => acc,
    [[p, guard, _, span], ..rest] => {
        let key = pattern_key p;
        let unreachable = covered || (key != () && list.contains key seen);
        let next = if unreachable {
            list.cons [span, "unreachable match arm: an earlier unguarded arm already matches it",
                       "remove this arm, move it before the earlier arm, or guard the earlier arm"] acc
        } else { acc };
        unreachable_arms rest (covered || (guard == () && catches_all p))
            (if guard == () && key != () { list.cons key seen } else { seen }) next
    },
    _ => acc,
};

let rec literal_zero e = match e {
    [:int, v, _] => v == 0,
    [:float, v, _] => v == 0.0,
    [:unary, :neg, inner, _] => literal_zero inner,
    _ => false,
};

/// `[span, message, note]` in source traversal order. Walk each body once so
/// nested functions and literals are checked without duplicate diagnostics.
let pitfalls e = list.reverse (pitfalls_in e []);

let rec pitfalls_in e acc =
    if type_of e != :list { acc }
    else {
        let here = match e {
            [:map, pairs, _] => duplicate_keys pairs [] acc,
            [:match, _, arms, _] => unreachable_arms arms false [] acc,
            [:binary, op, _, divisor, _] if (op == :div || op == :mod) && literal_zero divisor =>
                list.cons [ast.span divisor,
                           (if op == :div { "division" } else { "remainder" }) + " by a literal zero",
                           "check the divisor: zero can raise an error or produce a non-finite result"] acc,
            _ => acc,
        };
        list.fold (fn a x -> pitfalls_in x a) here e
    };

when test {
    import std.test;
    import dreams.parser;

    /// The names `lazy_accumulators` reports for the first declaration of `src`.
    let flagged src = match parser.parse_module src {
        [:ok, [[:let, f, ps, body, _, _], .._], _] =>
            list.map (fn p -> list.head p) (lazy_accumulators f ps body),
        other => other,
    };

    /// How many suspended forces the first declaration of `src` has.
    let forces src = match parser.parse_module src {
        [:ok, [[:let, _, _, body, _, _], .._], _] => list.length (suspended_forces body),
        other => other,
    };

    let tests = [
        test.case "a force in a list is suspended"
            $( test.eq! 1 (forces "let f! x = [:ok, strict! x];") ),
        test.case "in an array and a map, key or value"
            $( test.eq! 3 (forces "let f! x = [#[strict! x], %{ (strict! x) => 1, :k => strict! x }];") ),
        test.case "a force as a statement is not"
            $( test.eq! 0 (forces "let f! x = { strict! x; [:ok, x] };") ),
        test.case "nor one around the literal"
            $( test.eq! 0 (forces "let f! x = strict! [:ok, x];") ),
        test.case "nested literals are read too"
            $( test.eq! 1 (forces "let f! x = { let y = [1, [2, strict! x]]; y };") ),
        test.case "an accumulator grown by + and only answered is flagged"
            $( test.eq! ["acc"] (flagged "let rec t i n acc = if i > n { acc } else { t (i + 1) n (acc + i) };") ),
        test.case "the counter beside it is tested, so only the accumulator is"
            $( test.eq! ["acc"] (flagged "let rec t i n acc = if i > n { acc } else { t (i + 1) n (acc * 2) };") ),
        test.case "a strict accumulator is not flagged"
            $( test.eq! [] (flagged "let rec t i n !acc = if i > n { acc } else { t (i + 1) n (acc + i) };") ),
        test.case "an accumulator the body looks at is forced every step"
            $( test.eq! [] (flagged "let rec t i n acc = if i > n || acc < 0 { acc } else { t (i + 1) n (acc + i) };") ),
        test.case "one passed to anything else may be forced there"
            $( test.eq! [] (flagged "let rec t i n acc = if i > n { g acc } else { t (i + 1) n (acc + i) };") ),
        test.case "subtracting from it grows it; subtracting it does not"
            $( test.eq! [["a"], []]
                        [flagged "let rec t i a = if i == 0 { a } else { t (i - 1) (a - i) };",
                         flagged "let rec t i a = if i == 0 { a } else { t (i - 1) (i - a) };"] ),
        test.case "an accumulator built by a cons is a list, not a chain"
            $( test.eq! [] (flagged "let rec t i n acc = if i > n { acc } else { t (i + 1) n (list.cons i acc) };") ),
        test.case "a name rebound in the body is not the parameter"
            $( test.eq! [] (flagged "let rec t i acc = if i == 0 { acc } else { let acc = 1; t (i - 1) (acc + 1) };") ),
        test.case "the answer through a match and a block still counts as the answer"
            $( test.eq! ["acc"]
                        (flagged "let rec t xs acc = match xs { [] => { acc }, [x, ..rest] => t rest (acc + x) };") ),
        test.case "an accumulator handed back unchanged is carried, not grown"
            $( test.eq! [] (flagged "let rec t i acc = if i == 0 { acc } else { t (i - 1) acc };") ),
    ];
}
