// The IR: a flat arena of fixed-size execution-tree nodes.
//
// The point of this representation is load speed. Every node is a 16-byte
// record and every edge is an index into the same arena, so the node section of
// an image is loadable by slicing bytes -- there are no pointers to relocate
// and no tree to rebuild. Variadic children (block statements, call arguments,
// list elements) live in a side pool addressed by an offset and a count.
//
// Because the VM evaluates lazily, the tree *is* the program: a node is forced
// on demand, and the strict flag marks the points where evaluation order is
// observable -- effects sequenced inside an impure block.
//
// Nothing here decides anything. This module owns the shape of the arena and
// the arithmetic of appending to it; what to append is `lower`'s business.
//
// A note on how it is built. Appending to the end of a list costs the length of
// the list, and a real program is tens of thousands of nodes, so building the
// arena that way would be quadratic. Instead every pool is kept *reversed* --
// pushing is a cons -- alongside the count that gives the next index. The
// reversal happens once, at the end, in `finish`.

import std.list;
import std.str;
import std.dynamic.{fold,map}

// --- opcodes -------------------------------------------------------------------
//
// Named by atom rather than by number, so that a dump reads and a mistake is a
// missing name rather than a wrong integer. The numbers are the VM's and must
// not be renumbered: they are what an image stores.

let ops = [
    [:nop, 0, "nop"],

    // Leaves. `a` indexes the matching constant table unless noted.
    [:const_int, 1, "int"], [:const_float, 2, "float"], [:const_str, 3, "str"],
    /// `a` is the Unicode scalar value directly.
    [:const_char, 4, "char"],
    /// `a` is 0 or 1.
    [:const_bool, 5, "bool"], [:const_atom, 6, "atom"], [:unit, 7, "unit"],

    // References. `a` is a slot, capture index, global index or builtin id.
    [:local, 8, "local"], [:capture, 9, "capture"],
    [:global, 10, "global"], [:builtin, 11, "builtin"],

    /// `a` = object node, `b` = string constant naming the field.
    [:field, 12, "field"],
    /// `a` = callee, `b` = kids offset, `c` = argument count.
    [:apply, 13, "apply"],
    /// `a` = cond, `b` = then, `c` = else (absent when there is none).
    [:if, 14, "if"],
    /// `a` = kids offset, `b` = statement count. The value is the last one.
    [:block, 15, "block"],
    /// `a` = local slot, `b` = value. Binds lazily inside a block.
    [:bind, 16, "bind"],
    /// `a` = function index; captures come from that function's descriptor.
    [:make_closure, 17, "closure"],
    /// `a` = function index of a generated zero-arity thunk.
    [:make_thunk, 18, "thunk"],
    /// `a` = body, `b` = handler, `c` = slot holding the caught error.
    [:try, 19, "try"],
    /// `a` = the node to force to weak head normal form.
    [:force, 20, "force"],

    [:add, 21, "add"], [:sub, 22, "sub"], [:mul, 23, "mul"],
    [:div, 24, "div"], [:mod, 25, "mod"],
    [:eq, 26, "eq"], [:ne, 27, "ne"], [:lt, 28, "lt"],
    [:le, 29, "le"], [:gt, 30, "gt"], [:ge, 31, "ge"],
    /// Short-circuiting: `b` is only forced when it has to be.
    [:and, 32, "and"], [:or, 33, "or"],
    [:neg, 34, "neg"], [:not, 35, "not"],

    /// `a` = kids offset, `b` = element count.
    [:make_list, 36, "list"], [:make_array, 37, "array"],
    /// `a` = kids offset, `b` = pair count; kids are `k0, v0, k1, v1, ..`.
    [:make_map, 38, "map"],

    /// `a` = container, `b` = key, `c` = what to answer when nothing is at that
    /// key, or absent to raise instead. A map by key; an array or a list by
    /// position.
    [:get, 39, "get"],
    /// `a` = container, `b` = key, `c` = the new value, stored unforced. The
    /// answer is the container changed at that key; the one given is untouched.
    [:set, 40, "set"],

    /// `a` = the subject; `b` = kids offset, `c` = kids count. The kids are
    /// pairs of an atom constant and the node to go to when the key is that
    /// atom, then the node for every other key. `switch_head` keys on the head
    /// of a list cell, `switch_atom` on the subject itself. See `dispatch` in
    /// lower.dr.
    [:switch_head, 41, "switch_head"], [:switch_atom, 42, "switch_atom"],
    /// `a` = subject, `b` = surface type 0..9, `c` = invert (0 or 1).
    [:type_is, 43, "type_is"],
    [:cons, 44, "cons"], [:list_tail, 45, "list_tail"],
    [:list_is_empty, 46, "list_is_empty"],
    [:str_chars, 47, "str_chars"],
    [:error_new, 48, "error_new"],
    [:error_kind, 49, "error_kind"],
    [:error_payload, 50, "error_payload"],
    [:str_slice, 51, "str_slice"],
    [:str_find, 52, "str_find"],
    [:str_byte, 53, "str_byte"],
    [:str_le, 54, "str_le"],
    [:str_span, 55, "str_span"],
    [:str_upto, 56, "str_upto"],
    [:char_code, 57, "char_code"],
    [:char_of_code, 58, "char_of_code"],
    [:to_float, 59, "to_float"],
    [:float_bytes, 60, "float_bytes"],
    [:float_of_bytes, 61, "float_of_bytes"],
    [:to_int, 62, "to_int"],
    [:parse_int, 63, "parse_int"],
    [:parse_float, 64, "parse_float"],
    [:to_existing_atom, 65, "to_existing_atom"],
    [:array_new, 66, "array_new"],
    [:array_to_list, 67, "array_to_list"],
    [:map_has, 68, "map_has"],
    [:map_remove, 69, "map_remove"],
    [:map_pairs, 70, "map_pairs"],
    [:data_count, 71, "data_count"],
    [:data_at, 72, "data_at"],
    [:compare, 73, "compare"],

];

priv let nth = list.nth;

// The table above is the readable form; these are the three ways it is
// actually asked about. A linear scan of it was the single largest thing in a
// self-compile -- 20 million reductions, a quarter of the whole -- because
// `opcode` is asked once per node the lowerer emits and `op_of_code` once per
// node an image is read back from, and each answer walked an average of twenty
// three-element lists to find one atom. A list searched more often than it is
// built wants to be a map. These maps are evaluated with `comp` when the
// compiler is built, so a compilation only reads them.
//
// (That cost was invisible until `--profile` learnt to attribute the
// reductions a nested force makes, which is most of them. It named
// `check_expr` before that, and `check_expr` was not the problem.)
// The tables depend only on the bytecode vocabulary, so build them into the
// compiler image. Destructuring makes each column's meaning explicit.
priv let op_codes = comp fold (fn m [op, code, _] -> m.[op => code]) %{} ops;
priv let op_names = comp fold (fn m [op, _, name] -> m.[op => name]) %{} ops;
priv let op_of_codes = comp fold (fn m [op, code, _] -> m.[code => op]) %{} ops;

/// The VM's number for an opcode, or `()` if it is not one.
let opcode op = op_codes.[op else ()];

/// The short name an opcode dumps as.
let op_name : :atom -> :string;
let op_name op = op_names.[op else "?"];

/// The opcode a number stands for, for reading an image back.
let op_of_code n = op_of_codes.[n else ()];

// --- function flags -------------------------------------------------------------

let fn_impure = 1;
let fn_rec = 2;
/// A parameterless binding: a zero-arity function.
let fn_thunk = 4;
/// ..and a pure one is a value the VM forces once and remembers, where an
/// impure one is an action that has to run again on every call.
let fn_global_value = 8;

// --- global flags ---------------------------------------------------------------

let g_exported = 1;
let g_impure = 2;

/// What a global points at.
let global_function = 0;
let global_module = 1;

/// A module with a hole in it: it declares a virtual nobody filled.
let m_abstract = 2;

/// How a capture says where the enclosing frame keeps the value. The high bit
/// means "in that frame's captures" rather than "in one of its slots".
let cap_from_capture = 2147483648;

let encode_capture : :bool -> :integer -> :integer;
let encode_capture from_capture index =
    if from_capture { cap_from_capture + index } else { index };

// --- node flags ------------------------------------------------------------------

/// Must be forced where it appears; its effects are ordered.
let f_strict = 1;
/// Performs, or may perform, effects.
let f_impure = 2;
/// In tail position of its enclosing function.
let f_tail = 4;

let has_flag : :integer -> :integer -> :bool;
let has_flag flags f = (flags / f) % 2 == 1;
let add_flag : :integer -> :integer -> :integer;
let add_flag flags f = if has_flag flags f { flags } else { flags + f };

/// Sentinel for an absent edge. The VM spells it as an all-ones word; a
/// distinct atom is safer here, where a stray arithmetic slip on a large
/// integer would be silent and this is loud.
let no_node = :none;

let is_node n = n != no_node;

// --- a node --------------------------------------------------------------------

/// The arena as it is built: tables keyed by index, a pool per constant type.
/// See "the program" below for why a map and not lists.
type Program = :map;

/// The finished program `finish` hands the image writer: every table flattened
/// into the order the image lays it out in.
type Image = :map;

/// `[op, flags, a, b, c]`. The VM's record also carries a 16-bit `aux` field
/// that nothing generates yet; it is written as zero and left out here rather
/// than threaded through every constructor unused.
group Node { op, flags, a, b, c }

let node op a b c = Node.make op 0 a b c;
let node_op = Node.op;
let node_flags = Node.flags;
let node_a = Node.a;
let node_b = Node.b;
let node_c = Node.c;

let leaf op = node op no_node no_node no_node;

let with_flags flags n = Node.set_flags n flags;

let node_is_impure n = has_flag (node_flags n) f_impure;

// --- the constant pools ---------------------------------------------------------
//
// One pool per type, each deduplicated: the same string written twice in a
// program is one entry. A pool is `[reversed values, count, index by value]`.

group Pool {
    values = []
    count = 0
    index = %{}

    // Interning belongs to the pool: indexes are stable and values stay lazy.
    intern value self = match (index self).[value else ()] {
        () => {
            let next = count self;
            [make (list_cons value (values self)) (next + 1)
                  ((index self).[value => next]), next]
        },
        found => [self, found],
    }
}

let pool_new = Pool.new ();
let pool_values = Pool.values;
let pool_count = Pool.count;
let pool_index = Pool.index;

/// Intern a value: `[pool, index]`. The index is stable once given.
let intern v p = Pool.intern v p;

let pool_list p = list.reverse (pool_values p);

// --- the program ----------------------------------------------------------------
//
// A note on how the arena is built. The obvious representation is a list, and
// it is the wrong one: appending to the end of a list costs its length, looking
// up an index costs the index, and a real program is tens of thousands of nodes
// -- so emitting one would be quadratic, and setting a flag on a node already
// emitted would be quadratic again. Both happen constantly.
//
// So the pools are maps from index to value, with the count alongside to say
// what the next index is. Pushing and reading are both cheap, a flag can be set
// on a node long after it was emitted, and the whole thing is turned into flat
// lists once, in `finish`, where the cost is paid a single time.

let program = %{
    :nodes => %{}, :node_count => 0,
    :kids => %{}, :kid_count => 0,
    :funcs => [], :globals => [], :modules => [], :imports => [],
    :ints => pool_new, :floats => pool_new, :strs => pool_new, :atoms => pool_new,
    // The function `main!` compiles to, and the names an image reports itself
    // by. All three are filled in when the program is linked.
    :entry => no_node, :module_name => 0, :source_name => 0,
};

let nodes p      = p.[:nodes else (%{})];
let node_count : Program -> :integer;
let node_count p = p.[:node_count else 0];
let kids p       = p.[:kids else (%{})];
let kid_count : Program -> :integer;
let kid_count p  = p.[:kid_count else 0];
let funcs p      = p.[:funcs else []];
let globals p    = p.[:globals else []];
let prog_modules p = p.[:modules else []];
let imports p    = p.[:imports else []];
let entry p      = p.[:entry else no_node];
let module_name p = p.[:module_name else 0];
let source_name p = p.[:source_name else 0];

let ints p   = p.[:ints else pool_new];
let floats p = p.[:floats else pool_new];
let strs p   = p.[:strs else pool_new];
let atoms p  = p.[:atoms else pool_new];

/// True, having forced every field of `n` on the way to saying so.
///
/// A node handed to `push_node` is an *unforced* one: an argument is a thunk,
/// and a thunk carries the frame that would build it -- which is the lowerer's
/// frame, and that frame holds the arena as it stood one node ago. So an arena
/// of unforced nodes is not an arena at all, it is every version of one. The
/// map is persistent, so each version shares its entries with the last and
/// copies the path to the one it added, and a live chain of them is a trie
/// with several branches per entry rather than the third of one a settled map
/// has. Measured on a self-compile, before this: 745,534 live trie branches
/// averaging 169 bytes against 552,026 entries, and 219,134 frames nothing
/// could reach but a node that had not been looked at yet.
///
/// Forcing the *spine* is not enough and that was measured too -- the fields
/// are where the frames hang, so all five are named here.
///
/// The shape is `fold_strict`'s and the reason is the one given there: an
/// argument is not evaluated, so `push_node (settled n) p` would suspend the
/// call to `settled` and change nothing. A condition is the one place the
/// language must evaluate something. `type_of` is the cheapest builtin that
/// cannot answer without evaluating, `:nothing` is not one of its answers, so
/// every clause is true, `&&` reaches the last of them, and the answer is
/// always true -- which is why the caller's `else` is unreachable and says so.
///
/// Asked through `to_string`, which is one native call that cannot answer
/// without evaluating every part of what it is given: the five questions
/// written out were a dozen reductions a node, and this is asked of every node
/// the compiler emits and every flag it sets.
let settled n = type_of (to_string n) == :string;

/// Force the arena's spine.
///
/// Everything in Dream is lazy, and a lazy structure built in a loop is a chain
/// of thunks that all stay live until something forces the end of it -- which
/// for a program of any size is far more memory than the program itself. So the
/// spine is forced as it is built: each push collapses the step before it, and
/// what stays live is the arena rather than the history of how it was made.
///
/// Only the spine -- the *tables*. What goes into them is forced by `settled`
/// at the push, which is a separate job and was found much later: this keeps
/// the arena from being a chain of suspended puts, and that keeps it from
/// being a chain of its own versions, which is a different chain with a
/// different cause and was worth four hundred megabytes.
let settle p = if len (nodes p) >= 0 && len (kids p) >= 0 { p } else { p };

/// The node at an index. Every edge in the arena is one of these.
let node_at : :integer -> Program -> [:any];
let node_at i p = ((nodes p)).[i else (leaf :nop)];

let kid_at : :integer -> Program -> :integer | :atom;
let kid_at i p = ((kids p)).[i else no_node];

/// Append a node: `[program, index]`.
let push_node : [:any] -> Program -> [Program, :integer];
let push_node n p = {
    let i = node_count p;
    if settled n {
        [settle (((p.[:nodes => (((nodes p)).[i => n])])).[:node_count => (i + 1)]),
         i]
    } else { [p, i] }
};

/// Append a run of children: `[program, offset]`. The run is contiguous, which
/// is what lets a parent address it with one offset and a count.
///
/// A child is a node index and is stored forced, for the reason `settled`
/// gives about nodes: an unforced one is a thunk holding the frame that would
/// compute it, and that frame holds the arena of the moment it was written.
/// The fold is strict for the reason `list.fold_strict` gives -- a lazy one
/// answers a chain of suspended puts, and a run of children is as long as a
/// call's argument list.
let push_kids xs p = {
    let at = kid_count p;
    let filled = list.fold_strict (fn acc pair -> {
        let kid = nth 0 pair;
        if type_of kid != :nothing { acc.[(at + nth 1 pair) => kid] } else { acc }
    }) (kids p) (list.zip xs (list.range 0 (list.length xs)));
    [settle (((p.[:kids => filled])).[:kid_count => (at + list.length xs)]), at]
};

let intern_int v p   = { let got = intern v (ints p);   [p.[:ints => (list.head got)], nth 1 got] };
let intern_float v p = { let got = intern v (floats p); [p.[:floats => (list.head got)], nth 1 got] };
let intern_str v p   = { let got = intern v (strs p);   [p.[:strs => (list.head got)], nth 1 got] };

/// An atom is stored as the string-table index of its name, because the runtime
/// interns atoms by name when it loads an image. Interning the name first is
/// what makes that index exist.
let intern_atom v p = {
    let named = intern_str v p;
    let got = intern (nth 1 named) (atoms (list.head named));
    [((list.head named)).[:atoms => (list.head got)], nth 1 got]
};

/// Set a flag on a node already in the arena. Nodes are appended and never
/// moved, so an index stays valid, and a flag discovered late -- that a call is
/// in tail position, that a value turned out to be effectful -- can still be
/// recorded where it belongs.
///
/// Settled for the reason `settled` gives, and this is the site that reason was
/// written for without anyone noticing: `push_node` above has always refused an
/// unforced node, and this wrote one straight past it. `with_flags` is a `set`
/// of a list, so what went into the arena was a *suspended* one, holding the
/// frame of whichever lowering function asked for the flag -- and that frame
/// holds the lowering state, which holds the arena as it stood at that node.
/// Lowering sets a flag on most of the nodes it emits (tail position,
/// strictness, impurity), so the arena was a chain of tens of thousands of its
/// own versions, held together by nodes nobody had looked at yet. It was 45% of
/// a self-compile's live set.
let set_node_flag i f p = {
    let n = node_at i p;
    let flagged = with_flags (add_flag (node_flags n) f) n;
    if settled flagged {
        settle (p.[:nodes => (((nodes p)).[i => flagged])])
    } else { p }
};

let node_flags_at i p = node_flags (node_at i p);

/// Replace a node already in the arena.
///
/// Only compile-time evaluation needs this: the expression is lowered into a
/// placeholder, and what it came to is only known once the program has been
/// built and run. Everything else emits a node once and leaves it alone.
///
/// Settled like the two writers above, and for the same reason -- there are
/// only twenty or so of these in a self-compile, so this is consistency rather
/// than a measurement.
let set_node i n p =
    if settled n { settle (p.[:nodes => (((nodes p)).[i => n])]) } else { p };

// --- what the arena becomes -------------------------------------------------------

/// Put every pool the right way round. Everything downstream -- the dump, and
/// eventually the image writer -- reads this rather than the building form.
let finish : Program -> Image;
let finish p = (finish_rest p).[:nodes => list.map (fn i -> node_at i p) (list.range 0 (node_count p))]
                              .[:kids => list.map (fn i -> kid_at i p) (list.range 0 (kid_count p))];

/// Everything `finish` makes but the arena itself, for a pass that reads the
/// arena from its tables and writes a new one.
let finish_rest : Program -> Image;
let finish_rest p = %{
    :funcs => funcs p, :globals => globals p,
    :modules => prog_modules p, :imports => imports p,
    :ints => pool_list (ints p), :floats => pool_list (floats p),
    :strs => pool_list (strs p), :atoms => pool_list (atoms p),
    :entry => entry p, :module_name => module_name p, :source_name => source_name p,
};

// --- reading it back --------------------------------------------------------------

/// One node, as a line. The operands are shown the way the opcode uses them,
/// because `a` meaning "a constant index" and `a` meaning "another node" look
/// identical otherwise, and that is exactly the mistake worth catching.
/// A string as it would be written in source. `to_string` is the identity on a
/// plain string, which in a dump loses the one thing that tells a string
/// constant from a name -- `str hi` and `local hi` should not look alike.
let quoted s =
    "\"" + str.join_str "" (list.map (fn ch ->
        if ch == '"' { "\\\"" }
        else if ch == '\\' { "\\\\" }
        else if ch == '\n' { "\\n" }
        else if ch == '\t' { "\\t" }
        else { str.of_chars [ch] }) (str.chars s)) + "\"";

let show_node img i n = {
    let const_at pool at = {
        let xs = img.[pool else []];
        if at == no_node || at >= list.length xs { "?" } else { to_string (nth at xs) }
    };
    let operands =
        match node_op n {
            :const_int   => const_at :ints (node_a n),
            :const_float => const_at :floats (node_a n),
            :const_str   => quoted (const_at :strs (node_a n)),
            :const_atom  => {
                let ats = img.[:atoms else []];
                let at = node_a n;
                if at >= list.length ats { ":?" }
                else { ":" + const_at :strs (nth at ats) }
            },
            :const_char  => "'" + str.of_chars [char_of_code (node_a n)] + "'",
            :const_bool  => if node_a n == 1 { "true" } else { "false" },
            :unit        => "",
            :local       => "@" + to_string (node_a n),
            :capture     => "^" + to_string (node_a n),
            :global      => "g" + to_string (node_a n),
            :builtin     => "b" + to_string (node_a n),
            :field       => to_string (node_a n) + " ." + const_at :strs (node_b n),
            :apply       => to_string (node_a n) + " kids@" + to_string (node_b n)
                            + "x" + to_string (node_c n),
            :block       => "kids@" + to_string (node_a n) + "x" + to_string (node_b n),
            :make_list   => "kids@" + to_string (node_a n) + "x" + to_string (node_b n),
            :make_array  => "kids@" + to_string (node_a n) + "x" + to_string (node_b n),
            :make_map    => "kids@" + to_string (node_a n) + "x" + to_string (node_b n),
            :switch_head => to_string (node_a n) + " kids@" + to_string (node_b n)
                            + "x" + to_string (node_c n),
            :switch_atom => to_string (node_a n) + " kids@" + to_string (node_b n)
                            + "x" + to_string (node_c n),
            :bind        => "@" + to_string (node_a n) + " = " + to_string (node_b n),
            :make_closure => "fn" + to_string (node_a n),
            :make_thunk  => "fn" + to_string (node_a n),
            :get         => to_string (node_a n) + "[" + to_string (node_b n)
                            + (if is_node (node_c n) { " else " + to_string (node_c n) } else { "" })
                            + "]",
            :set         => to_string (node_a n) + "[" + to_string (node_b n) + " => "
                            + to_string (node_c n) + "]",
            _ => str.join_str " " (list.filter (fn x -> x != "")
                     (list.map (fn e -> if is_node e { to_string e } else { "" })
                               [node_a n, node_b n, node_c n])),
        };
    let marks = (if has_flag (node_flags n) f_strict { "!" } else { "" })
              + (if has_flag (node_flags n) f_impure { "~" } else { "" })
              + (if has_flag (node_flags n) f_tail { ">" } else { "" });
    "  " + to_string i + "  " + op_name (node_op n)
    + (if operands == "" { "" } else { " " + operands })
    + (if marks == "" { "" } else { "  " + marks })
};

/// The whole arena, as text. This is what `--dump` prints, and what a test
/// compares against: a tree written out one node per line is far easier to read
/// in a failure than a nest of indices.
let dump img =
    str.join_str "\n"
        (list.map (fn i -> show_node img i (nth i (img.[:nodes else []])))
                  (list.range 0 (list.length (img.[:nodes else []]))));

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let built = {
        let a = push_node (leaf :unit) program;
        let b = push_node (node :force (nth 1 a) no_node no_node) (list.head a);
        list.head b
    };

    let tests = [
        test.case "an opcode knows its number and its name"
            $( test.eq! [13, "apply", :apply]
                        [opcode :apply, op_name :apply, op_of_code 13] ),
        test.case "every opcode has a distinct number"
            $( test.eq! (list.length ops)
                        (list.length (list.unique (list.map (fn o -> nth 1 o) ops))) ),
        test.case "opcode numbers are the VM's, in order from zero"
            $( test.eq! (list.range 0 (list.length ops)) (list.map (fn o -> nth 1 o) ops) ),
        test.case "an unknown opcode is not invented"
            $( test.eq! [(), ()] [opcode :nonsense, op_of_code 999] ),

        test.case "flags are set and read back"
            $( test.eq! [true, false, true]
                        { let f = add_flag (add_flag 0 f_strict) f_tail;
                          [has_flag f f_strict, has_flag f f_impure, has_flag f f_tail] } ),
        test.case "setting a flag twice sets it once"
            $( test.eq! f_strict (add_flag (add_flag 0 f_strict) f_strict) ),

        test.case "nodes are numbered from zero as they are pushed"
            $( test.eq! [0, 1]
                        { let a = push_node (leaf :unit) program;
                          let b = push_node (leaf :unit) (list.head a);
                          [nth 1 a, nth 1 b] } ),
        test.case "a node can be read back by its index"
            $( test.eq! [:unit, :force]
                        [node_op (node_at 0 built), node_op (node_at 1 built)] ),
        test.case "a flag can be set on a node already in the arena"
            $( test.true! (node_is_impure (node_at 0 (set_node_flag 0 f_impure built))) ),
        test.case "setting a flag leaves the other nodes alone"
            $( test.false! (node_is_impure (node_at 1 (set_node_flag 0 f_impure built))) ),

        test.case "a run of children is contiguous, and says where it starts"
            $( test.eq! [0, 3]
                        { let a = push_kids [1, 2, 3] program;
                          let b = push_kids [4] (list.head a);
                          [nth 1 a, nth 1 b] } ),
        test.case "children come back in the order they went in"
            $( test.eq! [1, 2, 3, 4]
                        { let a = push_kids [1, 2, 3] program;
                          ((finish (list.head (push_kids [4] (list.head a))))).[:kids else []] } ),

        test.case "a constant is interned once"
            $( test.eq! [0, 0, 1]
                        { let a = intern_str "x" program;
                          let b = intern_str "x" (list.head a);
                          let c = intern_str "y" (list.head b);
                          [nth 1 a, nth 1 b, nth 1 c] } ),
        test.case "the pool comes out in index order"
            $( test.eq! ["x", "y"]
                        { let a = intern_str "x" program;
                          let b = intern_str "y" (list.head a);
                          ((finish (list.head b))).[:strs else []] } ),
        test.case "an atom is stored as the index of its name"
            $( test.eq! [["ok"], [0]]
                        { let got = intern_atom "ok" program;
                          let p = list.head got;
                          [((finish p)).[:strs else []], ((finish p)).[:atoms else []]] } ),
        test.case "the same atom interns once"
            $( test.eq! [0, 0]
                        { let a = intern_atom "ok" program;
                          let b = intern_atom "ok" (list.head a);
                          [nth 1 a, nth 1 b] } ),
        test.case "the pools are separate"
            $( test.eq! [0, 0]
                        { let a = intern_int 1 program;
                          let b = intern_float 1.0 (list.head a);
                          [nth 1 a, nth 1 b] } ),

        test.case "a node keeps its index however many are added after it"
            $( test.eq! :unit
                        { let a = push_node (leaf :unit) program;
                          let b = push_node (leaf :force) (list.head a);
                          node_op (node_at (nth 1 a) (list.head b)) } ),
        test.case "the arena comes out in the order it was built"
            $( test.eq! [:unit, :force]
                        (list.map (fn n -> node_op n) (((finish built)).[:nodes else []])) ),
        test.case "a dump shows one node per line, with its index"
            $( test.eq! ["  0  unit", "  1  force 0"] (str.split "\n" (dump (finish built))) ),
        test.case "a dump shows a constant's value, not its index"
            $( test.true! (str.contains_str "\"hi\""
                   { let interned = intern_str "hi" program;
                     let n = push_node (node :const_str (nth 1 interned) no_node no_node)
                                       (list.head interned);
                     dump (finish (list.head n)) }) ),
    ];
}
