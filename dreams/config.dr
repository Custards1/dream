// Compile-time configuration: what `when` conditions are tested against.
//
// A flag is either defined or not (`test`), and a setting has a value
// (`os == "linux"`). Both come from the command line, except for the handful
// the compiler knows about itself.
//
// Conditions are resolved while loading, before anything else looks at a
// module, so a `when` that is off costs nothing: an `import` inside it is never
// followed, and a module that only test builds need is never even read. That is
// why this module sits below `modules` rather than beside the later passes --
// by the time anything downstream sees a syntax tree, no `when` remains in it.
//
// Everything here is pure. The one thing that has to ask the outside world what
// it is -- the platform -- does so in `defaults!`, which is the only impure
// function in the file and is called once, at startup.

import std.list;
import std.os;
import std.str;

// --- the configuration ------------------------------------------------------
//
// Flags and settings are kept apart because they answer different questions.
// A setting *also* counts as defined, so `when os { .. }` is true while
// `when nonsense { .. }` is false -- but a flag has no value to compare, and
// `when test == "x"` should be false rather than an error.

//
// A package's options are a third kind, and are *scoped*: `-D sqlite:vendored`
// is `vendored` for the modules of `sqlite` and for nobody else, which is what
// lets a dependency's settings be kept at all -- a program-wide `vendored`
// would switch on every `when vendored` in every package. `scoped` holds them
// by package, `here` is the package whose module is being read, and `aliases`
// takes any name a package is known by -- the key it was listed under, or its
// own -- to the one it is filed under. The loader fills in the last two;
// nothing else here knows what a package is.

mapping Configuration {
    flags = %{}
    values = %{}
    scoped = %{}
    aliases = %{}
    here = ()
}

let flags c = Configuration.flags c;
let values c = Configuration.values c;
let scoped c = Configuration.scoped c;

/// A configuration with nothing defined. `defaults!` is what a compilation
/// actually starts from; this is what a test starts from.
let empty = Configuration.new ();

let define name c = Configuration.set_flags c ((flags c).[name => true]);

let set key value c = Configuration.set_values c ((values c).[key => value]);

/// The name a package's settings are filed under.
let canonical c key = (Configuration.aliases c).[key else key];

/// Set `name` to `value` for package `key` alone.
let set_in key name value c = {
    let k = canonical c key;
    let now = (scoped c).[k else (%{})];
    Configuration.set_scoped c ((scoped c).[k => now.[name => value]])
};

/// Accepts `name`, `name=value`, `key:name` or `key:name=value`, which is what
/// `-D` takes. A `=` with nothing after it defines the setting as the empty
/// string rather than being rejected: `-D features=` is a legitimate way to say
/// "none". The scope is marked with a colon rather than a dot because a key may
/// have dots in it and a name may not; a bare scoped name is `true`, the value
/// a `bool` option is written with.
let define_arg arg c = {
    let at = str.find "=" arg;
    let lhs = if at < 0 { arg } else { str.slice 0 at arg };
    let rhs = if at < 0 { () } else { str.slice (at + 1) (str.byte_length arg - at - 1) arg };
    let colon = str.find ":" lhs;
    match [colon >= 0, rhs] {
        [true, _] => {
            let key = str.slice 0 colon lhs;
            let name = str.slice (colon + 1) (str.byte_length lhs - colon - 1) lhs;
            set_in key name (match rhs { () => "true", v => v }) c
        },
        [false, ()] => define arg c,
        [false, v] => set lhs v c,
    }
};

/// The same configuration, read from inside package `key`'s modules. `()` is
/// a module that belongs to no package, which sees the program's settings only.
let within key c = Configuration.set_here c (match key { () => (), k => canonical c k });

/// Refile every scope under its canonical name, now that the names are known:
/// `-D` is read before the packages are found, so a scope set through a key
/// is keyed by it until here. Answers `[configuration, unknown keys]`, a key
/// being unknown when `known` says so -- a `-D` that names no package is a
/// typo, and a typo that is quietly ignored is the worst answer to one.
let with_aliases aliases known c = {
    let named = Configuration.set_aliases c aliases;
    let refiled = list.fold (fn m [k, table] -> {
        let to = canonical named k;
        m.[to => list.fold (fn t [n, v] -> t.[n => v]) (m.[to else (%{})]) (map_pairs table)]
    }) (%{}) (map_pairs (scoped c));
    [Configuration.set_scoped named refiled,
     list.filter (fn k -> not (known k)) (list.map (fn [k, _] -> k) (map_pairs (scoped c)))]
};

/// A package option as a condition reads it: `[:ok, value]` when the name is
/// one -- `sqlite.vendored` anywhere, `vendored` inside `sqlite` -- and `()`
/// when it is not, so the program's settings answer instead. A dotted name is
/// only ever an option, so `[:ok, ()]` for one nobody set rather than falling
/// through to a flag no `-D` could have spelled.
let option c name = {
    let dot = str.find "." name;
    match dot >= 0 {
        true => {
            let key = str.slice 0 dot name;
            let rest = str.slice (dot + 1) (str.byte_length name - dot - 1) name;
            [:ok, ((scoped c).[canonical c key else (%{})]).[rest else ()]]
        },
        false => match Configuration.here c {
            () => (),
            k => match ((scoped c).[k else (%{})]).[name else ()] {
                () => (),
                v => [:ok, v],
            },
        },
    }
};

let rec define_args args c =
    match args {
        [] => c,
        [a, ..rest] => define_args rest (define_arg a c),
    };

let is_defined name c = map_has (flags c) name;

/// The value of a setting, or `()` when it has none.
let value key c = ((values c)).[key else ()];

// --- what the compiler knows about itself -----------------------------------

/// The platform atom as the string a `when` compares against. `to_string` of an
/// atom keeps the leading `:`, which is not what `os == "linux"` is written
/// with, so the colon comes off here rather than at every comparison.
let platform_name p = { let s = to_string p; str.slice 1 (str.byte_length s - 1) s };

/// `os`, `arch` and `family`, filled in from the machine this is running on.
///
/// Only `os` can be asked for honestly: the VM reports the platform and
/// nothing else, so `arch` is left undefined rather than guessed at. An
/// undefined setting makes `when arch == "x86_64"` false, which is the safe
/// way to be wrong -- the alternative is code compiled for the wrong machine.
let defaults! () = {
    let os_name = platform_name (os.platform ());
    empty
        |> set "os" os_name
        |> set "family" (if os_name == "windows" { "windows" } else { "unix" })
};

// --- evaluating a condition -------------------------------------------------

/// The vocabulary the parser produces for `when`: `true`/`false`, a bare flag,
/// `setting == "value"`, and `not` / `&&` / `||` over those.
let rec eval c cond =
    match cond {
        [:const, b]     => b,
        // A package's own option first. One set to `false` is off, which is
        // how a `bool` option says so; one never set is off too.
        [:flag, name]   => match option c name {
            [:ok, v] => v != () && v != "false",
            // A setting that has a value counts as defined.
            _ => is_defined name c || map_has (values c) name,
        },
        [:equals, k, v] => match option c k {
            [:ok, found] => found == v,
            _ => value k c == v,
        },
        [:not, inner]   => not (eval c inner),
        [:and, l, r]    => eval c l && eval c r,
        [:or, l, r]     => eval c l || eval c r,
        // The parser cannot produce anything else. A condition it never made
        // is not a reason to stop the compilation, but it must not silently
        // switch code *on*.
        _ => false,
    };

/// Every flag and setting a condition names, whatever its answer.
///
/// A condition that came out false was still decided by what it read, and an
/// image compiled through `when os == "windows"` on Linux is missing the
/// Windows branch as surely as it holds the Linux one. So the loader keeps
/// this for every condition it evaluates, and the image's target is pinned by
/// it (`target.from_reads`).
let rec reads cond =
    match cond {
        [:flag, name]   => [name],
        [:equals, k, _] => [k],
        [:not, inner]   => reads inner,
        [:and, l, r]    => list.append (reads l) (reads r),
        [:or, l, r]     => list.append (reads l) (reads r),
        _ => [],
    };

// --- reporting --------------------------------------------------------------

/// Every flag and setting, one per line, sorted -- what `--print-cfg` shows.
/// Settings are quoted so that a value with a space in it still reads as one.
let describe c = {
    let named = list.map (fn [name, _] -> name) (map_pairs (flags c));
    let valued = list.map (fn [name, value] -> name + " = \"" + value + "\"")
                          (map_pairs (values c));
    // Each package's options under its name, after the program's settings.
    let options = list.sort (list.flat_map (fn [key, table] ->
        list.map (fn [name, value] -> key + ":" + name + " = \"" + value + "\"") (map_pairs table))
        (map_pairs (scoped c)));
    list.append (list.sort (list.append named valued)) options
};

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let with_flags = empty |> define "test" |> set "os" "linux";

    let tests = [
        test.case "a flag is defined once it is named"
            $( test.eq! [true, false]
                        [is_defined "test" with_flags, is_defined "release" with_flags] ),
        test.case "a setting keeps its value"
            $( test.eq! ["linux", ()] [value "os" with_flags, value "arch" with_flags] ),
        test.case "-D takes a bare flag or a setting"
            $( test.eq! [true, "x86_64"]
                        [is_defined "release" (define_arg "release" empty),
                         value "arch" (define_arg "arch=x86_64" empty)] ),
        test.case "a setting may be defined as empty"
            $( test.eq! "" (value "features" (define_arg "features=" empty)) ),
        test.case "a value containing `=` keeps the rest of it"
            $( test.eq! "a=b" (value "x" (define_arg "x=a=b" empty)) ),
        test.case "true and false need nothing defined"
            $( test.eq! [true, false] [eval empty [:const, true], eval empty [:const, false]] ),
        test.case "a bare flag asks whether it is defined"
            $( test.eq! [true, false]
                        [eval with_flags [:flag, "test"], eval with_flags [:flag, "nope"]] ),
        test.case "a setting counts as defined"
            $( test.true! (eval with_flags [:flag, "os"]) ),
        test.case "== compares a setting's value"
            $( test.eq! [true, false, false]
                        [eval with_flags [:equals, "os", "linux"],
                         eval with_flags [:equals, "os", "macos"],
                         eval with_flags [:equals, "arch", "x86_64"]] ),
        test.case "not, && and || combine conditions"
            $( test.eq! [false, true, true, false]
                        [eval with_flags [:not, [:flag, "test"]],
                         eval with_flags [:and, [:flag, "test"], [:equals, "os", "linux"]],
                         eval with_flags [:or, [:flag, "nope"], [:flag, "test"]],
                         eval with_flags [:and, [:flag, "test"], [:flag, "nope"]]] ),
        test.case "an unknown condition is off rather than on"
            $( test.false! (eval with_flags [:nonsense, "test"]) ),
        test.case "a condition reads every name in it, taken or not"
            $( test.eq! ["os", "test", "arch"]
                        (reads [:or, [:and, [:equals, "os", "linux"], [:not, [:flag, "test"]]],
                                [:equals, "arch", "x86_64"]]) ),
        test.case "describe lists flags and quoted settings, sorted"
            $( test.eq! ["os = \"linux\"", "test"] (describe with_flags) ),
        test.case "-D key:name sets a package's option"
            $( test.eq! [%{ "sqlite" => %{ "vendored" => "true", "threads" => "off" } }, %{}]
                        { let c = empty |> define_arg "sqlite:vendored" |> define_arg "sqlite:threads=off";
                          [scoped c, flags c] } ),
        test.case "an option is read inside its package and nowhere else"
            $( test.eq! [true, false, false]
                        { let c = define_arg "sqlite:vendored" empty;
                          [eval (within "sqlite" c) [:flag, "vendored"],
                           eval (within "app" c) [:flag, "vendored"],
                           eval c [:flag, "vendored"]] } ),
        test.case "an option set to false is off, and shadows the program's flag"
            $( test.eq! [false, true]
                        { let c = empty |> define "vendored" |> define_arg "sqlite:vendored=false";
                          [eval (within "sqlite" c) [:flag, "vendored"],
                           eval (within "app" c) [:flag, "vendored"]] } ),
        test.case "a dotted name reads another package's option"
            $( test.eq! [true, false, true]
                        { let c = empty |> define_arg "sqlite:threads=off" |> within "app";
                          [eval c [:equals, "sqlite.threads", "off"],
                           eval c [:flag, "json.pretty"],
                           eval c [:flag, "sqlite.threads"]] } ),
        test.case "the program's settings answer where the package has no option"
            $( test.true! (eval (within "sqlite" (define_arg "sqlite:x" with_flags))
                                [:equals, "os", "linux"]) ),
        test.case "a scope set through a key is refiled under the package's name"
            $( test.eq! ["true", ["nope"]]
                        { let [c, unknown] = with_aliases (%{ "sqlite" => "sqlite3" })
                                                          (fn k -> k != "nope")
                                                          (empty |> define_arg "sqlite:v"
                                                                 |> define_arg "nope:x");
                          [(scoped c).["sqlite3" else (%{})].["v" else ()], unknown] } ),
        test.case "describe lists each package's options after the program's"
            $( test.eq! ["os = \"linux\"", "test", "sqlite:v = \"true\""]
                        (describe (define_arg "sqlite:v" with_flags)) ),
        test.case "the platform's atom loses its colon"
            $( test.eq! "linux" (platform_name :linux) ),
    ];
}
