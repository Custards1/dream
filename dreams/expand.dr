// Syntax macros run on the same VM as `comp!`, before runtime name resolution.
// This layer sits above scope/lower to keep the compiler's imports acyclic.
import std.core;
import std.list;
import std.str;
import std.vm;
import dreams.ast;
import dreams.diag;
import dreams.emit;
import dreams.ir;
import dreams.lower;
import dreams.modules;
import dreams.scope;
import dreams.syntax;

let rec has_expansion tree = match type_of tree {
    :list => match tree {
        [:expand, _, _] => true,
        [:macro, _, _, _, _] => true,
        _ => has_expansion_in tree,
    },
    _ => false,
};
// Syntax contains many scalar fields (names, tags and offsets). Reject those
// before list matching, and walk children without a predicate closure at each
// level of the tree.
let rec has_expansion_in trees = match trees {
    [] => false,
    [tree, ..rest] => has_expansion tree || has_expansion_in rest,
};
let macro_let item = match item {
    [:macro, n, ps, b, sp] => ast.let_d n ps b false sp,
    _ => item,
};

/// Unexpanded runtime expressions are deliberately unavailable to a transformer.
/// A demanded placeholder raises instead of silently manufacturing a value.
let rec stage tree = match tree {
    [:expand, _, sp] => ast.binary_e :div (ast.int_e 1 sp) (ast.int_e 0 sp) sp,
    [:macro, _, _, _, _] => stage (macro_let tree),
    _ => if type_of tree == :list { list.map (fn x -> stage x) tree } else { tree },
};
let replace_module l mi m = modules.set_module mi m l;
let with_items m items = core.map_put m :items items;
let loader s = core.map_get s :loader ();
let next s = core.map_get s :next 3221225472;
let put_loader l s = core.map_put s :loader l;

// --- what a round of expansion costs -------------------------------------------
//
// Expansion is the one stage of this compiler that *is* the compiler: a macro
// is answered by staging the program, resolving what the transformer reaches,
// lowering it, serializing an image and handing that to a VM. `--time` says
// what the stage came to, which was enough to justify the three changes that
// took it from seven seconds of a self-compile to under half of one. It cannot
// say which of those five things is left, and the next change proposed for it
// -- a compile-time VM that is loaded once and called, rather than an image
// built and loaded per round (dreams/TODO.md) -- is a redesign of exactly two
// of them. So each phase charges itself, and the question has an answer before
// anything is rewritten to improve it.
//
// Every reading is taken twice, for the reason `main.dr`'s `timed!` gives at
// length: forcing a phase walks everything the phases before it built, and the
// second `strict!` finds all of that already forced, so it measures the walk
// alone. The difference is what this phase did that nothing before it had.
//
// None of it runs unless `modules.metering` is on, and that is not about the
// clock reads -- it is that forcing a phase is a decision about *when* it
// happens. A round that refuses every one of its modules never forces the
// image and so never builds one, which is deliberate; a meter that charged the
// image would have to build it first.

let no_meter = %{ :phases => %{}, :counts => %{} };
let metering s = modules.metering (loader s);
let meter_of s = core.map_get s :meter no_meter;
let put_meter m s = core.map_put s :meter m;

/// The clock, the reduction count and the bytes allocated, as one reading, so
/// that three questions about a phase cannot be answered from three moments.
///
/// Bound one at a time rather than written as a list of three calls, because a
/// list literal's elements are thunks and a reading taken when somebody gets
/// round to looking at it is not a reading. An impure `let` is a statement, so
/// these three happen here, in this order.
let reading! u = {
    let ns = vm.now_ns! ();
    let reductions = vm.reductions! ();
    let allocated = vm.allocated! ();
    [ns, reductions, allocated]
};
/// `a - b`, elementwise and never below zero -- used twice, first to turn two
/// readings into an interval and then to take the walk back off the work.
let minus a b = list.map (fn [x, y] -> if x > y { x - y } else { 0 }) (list.zip a b);

/// Force `value` and answer `[value, [ns, reductions, bytes]]`.
///
/// The value arrives unevaluated -- an argument is a thunk -- which is the
/// whole of the trick and the reason there is no lambda here.
let charge! on value =
    if not on { [value, [0, 0, 0]] }
    else {
        let before = reading! ();
        strict! value
        let forced = reading! ();
        strict! value
        let walked = reading! ();
        [value, minus (minus forced before) (minus walked forced)]
    };

let add_reading meter name r = {
    let phases = core.map_get meter :phases %{};
    let cur = core.map_get phases name [0, 0, 0, 0];
    core.map_put meter :phases (core.map_put phases name
        [list.nth 0 cur + list.nth 0 r, list.nth 1 cur + list.nth 1 r,
         list.nth 2 cur + list.nth 2 r, list.nth 3 cur + 1])
};

/// Charge a reading already taken to `s`, for the phases whose value *is* the
/// next state and so cannot be handed back beside one.
let charged s name r = if metering s { put_meter (add_reading (meter_of s) name r) s } else { s };

/// Force `value`, charge what that cost to `name`, and answer `[state, value]`.
let phase! s name value = {
    let r = charge! (metering s) value;
    [charged s name (list.nth 1 r), list.head r]
};

/// Count something a phase cannot time: images built, wrappers run, calls
/// answered, times a fallback was taken.
let counted s name n = if not (metering s) { s } else {
    let meter = meter_of s;
    let tallies = core.map_get meter :counts %{};
    put_meter (core.map_put meter :counts
        (core.map_put tallies name (core.map_get tallies name 0 + n))) s
};
/// Several at once. The counts arrive as thunks and a meter that is off never
/// forces one, so a round pays nothing for being countable.
let counts s pairs = list.fold (fn acc [name, n] -> counted acc name n) s pairs;
let tally s name = core.map_get (core.map_get (meter_of s) :counts %{}) name 0;
let vm_starts s = tally s :vm_starts;

/// Two meters added together, which the fallback paths need: a batch that
/// failed spent its phases before the path that answered spent its own, and a
/// reader wants the compile rather than the half of it that worked.
let merge_meter a b = {
    let join key combine = list.fold (fn m [k, v] -> core.map_put m k (combine (core.map_get m k ()) v))
                                     (core.map_get a key %{}) (core.map_pairs (core.map_get b key %{}));
    %{ :phases => join :phases (fn old v -> match old {
           () => v,
           _ => list.map (fn [x, y] -> x + y) (list.zip old v),
       }),
       :counts => join :counts (fn old v -> match old { () => v, n => n + v }) }
};

/// The meter, on the loader, for a tool to read. `modules.macro_meter` is the
/// other end and says why it is kept there.
let publish_meter s l =
    if not (metering s) { l } else { modules.put :macro_meter (meter_of s) l };
let fail s mi sp message =
    put_loader (modules.complain sp message (modules.module_source (modules.module_at (loader s) mi))
                                (loader s)) s;

/// Remember that the name at `start` in module `mi` was a macro, and which.
///
/// Expansion is the only pass that ever resolves this occurrence: it replaces
/// the call it belongs to, so the resolver proper walks a program the name is
/// no longer written in. Recording it costs one entry per call site and is
/// what lets an editor answer "what is this" about the name the author typed
/// rather than about the code it turned into -- see `modules.expansions`.
///
/// The offset is the *source* one, from the call as written, not the freshened
/// copy the wrapper was compiled from. `[:macro, reference]` rather than the
/// reference alone, because by the time anything reads this the macro is an
/// ordinary global -- `macro_let` has rewritten the declaration -- and the
/// wrapper is the only thing left saying it was ever anything else.
let note_macro s mi start reference = {
    let l = loader s;
    put_loader (modules.put :expansions (modules.expansions l
        + [[mi, modules.module_source (modules.module_at l mi), start, [:macro, reference]]]) l) s
};

/// Only a declaration marked `macro` may be the target of `expand`. Use the
/// normal resolver so aliases and selective imports mean exactly what they do
/// for ordinary functions.
let macro_definition l reference = {
    let target = match reference {
        [:global, mi, name, _] => [mi, name],
        [:member, [:dream, mi], name, _] => [mi, name],
        _ => (),
    };
    match target {
        () => (),
        [mi, name] => list.first_or () (list.filter (fn item -> match item {
            [:macro, n, _, _, _] => n == name,
            _ => false,
        }) (modules.module_items (modules.module_at l mi))),
    }
};

/// `comp` inside a macro dependency is evaluated only if that dependency is
/// demanded by the macro VM. Unrelated runtime `comp!` effects must not run for
/// every expansion. Its isolated function already has the right environment.
let staged_lowering low = {
    let ready = list.fold (fn acc [placeholder, function] -> {
        let [lowered, closure] = lower.emit (ir.node :make_closure function ir.no_node ir.no_node) acc;
        lower.set_prog (ir.set_node placeholder (ir.node :apply closure 0 0)
                                   (lower.prog lowered)) lowered
    }) low (lower.pending_comp low);
    core.map_put ready :pending_comp []
};

/// The whole program, staged and compiled, for the macro VM to be given calls
/// against: `evaluate!` appends a disposable entry per call to this and
/// discards it afterwards, just as the REPL does.
///
/// **One of these serves the whole program, until it does not.** The snapshot
/// falls behind the moment a declaration is expanded, and a macro *can* demand
/// a declaration that has been -- which is the only reason it was once rebuilt
/// for every declaration, at a cost of the whole program's resolve and lower
/// apiece. What makes reuse safe instead of merely fast is that falling behind
/// is never silent: an expansion that has not happened yet is staged as `1 / 0`
/// and a macro is pure, so it cannot catch what that raises. So a declaration
/// that fails at all is expanded a second time against a fresh snapshot, from
/// the state before the first attempt -- see `expand!`. A program whose macros
/// all succeed builds exactly one of these; one whose macro genuinely fails
/// builds a second and fails the same way, which is a compile that was not
/// going to finish.
let prepare! l = prepare_work! l (work_of l);

/// The program as a transformer sees it: every `expand` replaced by `1 / 0`
/// and every `macro` read as the `let` it is.
///
/// Only declarations containing an expansion need placeholders. Reuse the
/// work list from discovery instead of copying every syntax node in every
/// imported module just to change the handful containing `expand`.
///
/// It is separate from `prepare_work!` so that the two halves of a snapshot
/// can be charged separately. They answer different questions and the meter
/// said so the moment it could: staging is where the program is first walked
/// -- and so where a lazy parse is finally paid -- and declaring is the walk
/// for names that `scope.resolve!` makes again afterwards.
let stage_program l work = {
    let replaced = apply_items l (list.map (fn [mi, i, tree] ->
        [mi, i, stage tree]) work);
    modules.map_modules (fn m ->
        with_items m (list.map macro_let (modules.module_items m))) replaced
};

let prepare_work! l work = {
    let staged = stage_program l work;
    %{ :loader => staged, :declared => scope.declare! staged }
};

/// Lower and link only the temporary wrapper. The base arena and function
/// indices stay fixed, and each call discards its wrapper instead of growing
/// the cache. Compile-time dependencies remain lazy in the embedded VM.
let invocation_image resolved =
    ir.finish (lower.prog (staged_lowering
        (core.map_remove (lower.lower_program resolved) :image)));

/// One `expand` call as the expression the macro VM will evaluate: the macro's
/// own name applied to its arguments, each argument quoted into the expression
/// that constructs it. `[expression, argument count]` -- the count is what the
/// arity check compares against, and the quoted arguments no longer say it.
let call_body call sp = {
    let [callee, args] = match call {
        [:apply, callee, args, _] => [callee, args],
        _ => [call, []],
    };
    [if list.is_empty args { callee }
     else { ast.apply_e callee (list.map (fn a -> syntax.literal a sp) args) sp },
     list.length args]
};

/// The name a quoted call names, which is the occurrence the resolver answered
/// about and so the one to ask which macro this is.
let called_name body = match body {
    [:apply, f, _, _] => f,
    x => x,
};

/// Each call on its own, so that a diagnostic names the call it is about.
/// `evaluate!` falls back to this whenever one image cannot answer for all of
/// them; with a single call it is the path `evaluate!` takes itself, so this
/// terminates.
let one_by_one! base s mi calls =
    list.fold (fn [st, values] call -> {
        let got = evaluate! base st mi [call];
        strict! got
        [list.head got, values + list.nth 1 got]
    }) [s, []] calls;

/// One module's calls for a round. A single module is the unit because a call
/// resolves against the imports of the module it was *written* in, so two
/// modules cannot share a wrapper -- but they can share an image, which is
/// where the cost actually is.
let evaluate! base s mi calls = {
    let got = evaluate_round! base s [[mi, calls]];
    [list.head got, list.head (list.nth 1 got)]
};

/// Evaluate every `expand` of one round of the whole program on the macro VM:
/// `[state, values per job]`, one value per call in the order given, and `()`
/// where the call could not be run and a diagnostic was raised instead.
///
/// **One image for the round, not one per declaration.** Building an image is
/// `ir.finish` plus `emit.to_binary`, and both are the size of the *program*
/// rather than of the call: on a self-compile, serializing the arena for each
/// declaration that used a macro was 30% of every reduction the compiler made
/// and most of a stage that was 75% of the compile -- eighteen copies of a
/// twenty-four-thousand-node program to expand eighteen one-line trees.
///
/// So every module's wrapper for this round goes into one image, and each is
/// entered by patching the four header bytes that say where to start
/// (`emit.with_entry`). That is sound for the same reason the shared snapshot
/// is: the wrappers are independent of one another, and a wrapper that turns
/// out to need something this image does not have raises rather than
/// answering wrongly -- see `prepare!` -- which puts it on the slow path
/// below.
///
/// **Failure is the slow path, deliberately.** A batch has one entry and one
/// result, so a raise anywhere in it is one failure for the whole image and
/// says nothing about which call raised. Rather than generate a `try` around
/// each call -- which means naming `strict!` and `to_string` in the wrapper,
/// and a module is free to declare a global of either name, which would win --
/// a module whose batch fails at all is thrown away and its calls are run one
/// at a time, where the wrapper *is* the call and every diagnostic is the one
/// this gave before batching existed. A failing expansion fails the compile,
/// so the round is run twice only for a build that was not going to finish.
let evaluate_round! base s jobs = {
    let l = loader s;
    let staged = base.[:loader];

    // A wrapper per module, each freshened from the running offset counter so
    // that no two generated declarations of one round can collide.
    let prepared = list.fold (fn [acc, n] [mi, calls] -> {
        let sp = list.nth 1 (list.head calls);
        let quoted = list.map (fn [call, at] -> call_body call at) calls;
        let alone = list.length calls == 1;
        let body = if alone { list.head (list.head quoted) }
                   else { ast.list_e (list.map (fn q -> list.head q) quoted) sp };
        let [wrapper, after] = syntax.fresh
            (ast.let_d "<macro expansion>!" [] body false sp) n;
        [core.cons [mi, calls, quoted, alone, sp, wrapper] acc, after]
    }) [[], next s] jobs;
    let plans = list.reverse (list.head prepared);
    let s1 = counts (core.map_put s :next (list.nth 1 prepared))
        [[:rounds, 1], [:wrappers, list.length plans],
         [:calls, list.fold (fn n plan -> n + list.length (list.nth 1 plan)) 0 plans]];

    // Declared together and resolved once, so that the incremental link below
    // sees every wrapper as this round's new bodies.
    let declaring = phase! s1 :declare (list.fold (fn acc plan ->
        scope.declare_items! staged (list.head plan) [list.nth 5 plan] acc)
        base.[:declared] plans);
    let s2 = list.head declaring;
    let declared = list.nth 1 declaring;
    // Only the bodies this round's wrappers can reach are resolved and lowered;
    // everything else is stubbed. `:whole` is how a path that has already been
    // failed by that asks for the program instead -- see `unreached_body`.
    let resolving = phase! s2 :resolve (scope.resolve_reachable! staged declared
        (if base.[:whole else false] { 0 }
         else { scope.pending_count base.[:declared] }));
    let s3 = list.head resolving;
    let resolved = list.nth 1 resolving;

    // Lazily, because a round in which every module is refused before it runs
    // -- a bad arity, a name that is not a macro -- must not pay for one. That
    // is also why the meter is off by default: charging these two forces them.
    let arena = invocation_image resolved;
    let bytes = emit.to_binary arena;

    /// A returned value, checked and given offsets of its own, with the range
    /// it occupies recorded against the site it came from -- so a diagnostic
    /// in generated code is reported where the `expand` is written.
    let install! mi m st value at = match value {
        [:error, message] if type_of message == :string => [fail st mi at message, ()],
        _ => if syntax.expression value {
                 let [expression, after_expression] = syntax.fresh value (next st);
                 let si = modules.module_source m;
                 let source = diag.with_origin (next st) after_expression at
                                               (modules.file_at (loader st) si);
                 let s2 = put_loader (modules.set_file si source (loader st)) st;
                 [core.map_put s2 :next after_expression, expression]
             } else {
                 [fail st mi at "a macro must return a valid expression syntax tree", ()]
             },
    };

    /// One module's share: what its calls named, whether that is allowed, and
    /// the answers, by entering the shared image at this module's wrapper.
    let run! st plan = {
        let [mi, calls, quoted, alone, sp, wrapper] = plan;
        let m = modules.module_at staged mi;

        // The wrapper's body once it has been freshened, one expression per
        // call: the body itself when there is one call and the elements of
        // the list when there are several. Their spans are what the resolver
        // keyed its answers by, which is why they are read back from the
        // wrapper rather than kept.
        let targets = if alone { [scope.decl_body wrapper] }
                      else { match scope.decl_body wrapper {
                                 [:list, elements, _] => elements,
                                 other => [other],
                             } };

        // What each call's name resolved to, and the macro it named. Asked
        // once per call rather than once per question about it: the arity
        // check, the diagnostic and the note an editor reads are all the same
        // lookup.
        let sites = list.range 0 (list.length calls);
        let references = list.map (fn i ->
            scope.resolution resolved mi (modules.module_source m)
                             (ast.span (called_name (list.nth i targets)))) sites;
        let definitions = list.map (fn i -> macro_definition l (list.nth i references)) sites;

        /// What is wrong with call `i`, or `()`.
        let objection i =
            match list.nth i definitions {
                () => "`expand` needs the name of a declared macro",
                definition => {
                    let arity = list.length (list.nth 2 definition);
                    let given = list.nth 1 (list.nth i quoted);
                    if arity == given { () }
                    else { "macro expects " + to_string arity + " syntax arguments, received "
                           + to_string given }
                },
            };
        let objections = list.map (fn i -> objection i) sites;

        /// The state with every call that named a macro written down, for an
        /// editor. Only the paths that answer here do this: the one that falls
        /// back to running the calls singly lets each of those record its own.
        let noted = list.fold (fn acc i -> match list.nth i definitions {
            () => acc,
            _ => note_macro acc mi
                     (ast.span_start (ast.span (called_name (list.head (list.nth i calls)))))
                     (list.nth i references),
        }) st sites;
        let complaint =
            match list.filter (fn o -> o != ()) objections {
                [] => if diag.error_count (scope.r_diags resolved) == 0 { () }
                      else { "cannot compile macro: "
                             + str.join_str "; " (list.map (fn d -> diag.message d)
                                 (list.filter (fn d -> diag.is_error d) (scope.r_diags resolved))) },
                [why, .._] => why,
            };

        match complaint {
            why if alone && why != () => [fail (counted noted :refused 1) mi sp why, [()]],
            why if why != () => one_by_one! (base.[:whole => true])
                                    (counted st :one_by_one 1) mi calls,
            _ => {
                let entries = list.filter (fn b -> list.nth 0 b == mi
                    && scope.decl_name (list.nth 2 b) == "<macro expansion>!")
                    (scope.bodies resolved);
                let entry = list.nth 3 (list.head entries);
                // The round's arena and its bytes are shared by every module in
                // it, so only the first one to get here pays for them: a meter
                // takes two readings and the second finds the work already
                // done, which is exactly what makes the ones after it free.
                // With the meter off these are still the thunks they were, and
                // `emit.with_entry` below forces them inside the `try!`.
                let building = phase! noted :image arena;
                let ready = phase! (list.head building) :emit bytes;
                let started = reading! ();
                let outcome = try! {
                    let value = vm.eval_image! (emit.with_entry bytes entry);
                    strict! value
                    [:ok, value]
                } catch e { [:error, to_string e] };
                let ran = counted (charged (list.head ready) :vm (minus (reading! ()) started))
                                  :vm_starts 1;
                match outcome {
                    [:error, why] if alone =>
                        [fail ran mi sp ("macro evaluation failed: " + why), [()]],
                    [:error, _] => one_by_one! (base.[:whole => true])
                                       (counted ran :one_by_one 1) mi calls,
                    [:ok, value] => {
                        let installing = charge! (metering ran) (list.fold (fn [acc, answers] pair -> {
                            let got = install! mi m acc (list.head pair)
                                               (list.nth 1 (list.nth 1 pair));
                            [list.head got, core.cons (list.nth 1 got) answers]
                        }) [ran, []] (list.zip (if alone { [value] } else { value }) calls));
                        let done = list.head installing;
                        [charged (list.head done) :install (list.nth 1 installing),
                         list.reverse (list.nth 1 done)]
                    },
                }
            },
        }
    };

    let done = list.fold (fn [st, acc] plan -> {
        let got = run! st plan;
        strict! got
        [list.head got, core.cons (list.nth 1 got) acc]
    }) [s3, []] plans;
    // One image serves the whole round, so it is counted here rather than in
    // `run!`, which would count it once per module that read it -- and only
    // when something actually entered it, because a round that refuses every
    // module never forces one. That is what `vm_starts` moving says.
    let ended = list.head done;
    [if vm_starts ended == vm_starts s3 { ended }
     else { counts ended [[:images, 1], [:image_bytes, str.byte_length bytes]] },
     list.reverse (list.nth 1 done)]
};

/// A tree with every `expand` of this round replaced by a numbered hole, and
/// those calls collected in the order the holes were numbered: `[tree, [calls
/// reversed, count]]`.
///
/// Outside-in: a call's arguments are passed untouched, so nothing inside one
/// is a hole and an argument may name what does not exist, perform an effect,
/// or be another `expand` the macro discards. What a macro *returns* is punched
/// again on the next round, which is where a nested call is found.
let rec punch tree acc = match tree {
    [:expand, call, sp] => {
        let [calls, n] = acc;
        [[:expansion_hole, n, sp], [core.cons [call, sp] calls, n + 1]]
    },
    _ => if type_of tree != :list { [tree, acc] }
         else {
             let done = list.fold (fn [parts, a] part -> {
                 let got = punch part a;
                 [core.cons (list.head got) parts, list.nth 1 got]
             }) [[], acc] tree;
             [list.reverse (list.head done), list.nth 1 done]
         },
};

let rec fill tree values = match tree {
    [:expansion_hole, n, _] => list.nth n values,
    _ => if type_of tree != :list { tree }
         else { list.map (fn part -> fill part values) tree },
};

/// Expand one declaration to a fixpoint, a round at a time. Each round is one
/// image; the rounds are the *nesting* of macro calls, not their number, so a
/// declaration with forty calls written side by side takes one. A bound
/// catches recursive expansion, since a macro whose answer calls it again
/// never runs out of rounds on its own.
///
/// This is the one-declaration form, which is what the fallback below uses
/// when a whole-program round could not answer. `rounds_all!` is the ordinary
/// path and expands every declaration together.
let rec rounds! base s mi tree depth = {
    let punched = punch tree [[], 0];
    let calls = list.reverse (list.head (list.nth 1 punched));
    let refused sp = ast.unit_e sp;
    if list.is_empty calls { [s, tree] }
    else if depth >= 64 {
        [list.fold (fn st call ->
             fail st mi (list.nth 1 call) "macro expansion exceeded 64 nested calls") s calls,
         fill (list.head punched) (list.map (fn call -> refused (list.nth 1 call)) calls)]
    } else {
        let result = evaluate! base s mi calls;
        // Both the syntax and the updated loader contain lazy fields whose
        // frames retain this round's resolver and lowered program. Finish them
        // before the next round, so a declaration with many expands does not
        // keep every temporary compilation alive at once.
        strict! result
        let [state, values] = result;
        let answers = list.map (fn pair -> match list.head pair {
            () => refused (list.nth 1 (list.nth 1 pair)),
            answer => answer,
        }) (list.zip values calls);
        rounds! base state mi (fill (list.head punched) answers) (depth + 1)
    }
};

/// Every declaration of the program, expanded together, a round at a time.
///
/// A round used to be one declaration's nesting depth, and an image was built
/// for each. But the declarations of a program do not depend on one another's
/// expansion -- each is staged against the same snapshot, in which every
/// unexpanded `expand` is the same `1 / 0` -- so their rounds can be the same
/// rounds, and then a round is one image for the whole program rather than
/// one per declaration. A program's round count is the deepest nesting any
/// one declaration has, which is almost always one.
///
/// `items` is `[module, index, tree]` for every declaration that had an
/// `expand` in it. What comes back is the same list with the trees expanded.
let rec rounds_all! base s items depth = {
    let punched = list.map (fn it -> {
        let got = punch (list.nth 2 it) [[], 0];
        [list.nth 0 it, list.nth 1 it, list.head got,
         list.reverse (list.head (list.nth 1 got))]
    }) items;
    let active = list.filter (fn j -> not (list.is_empty (list.nth 3 j))) punched;
    if list.is_empty active { [s, items] }
    else if depth >= 64 {
        let failed = list.fold (fn st j ->
            list.fold (fn acc call -> fail acc (list.head j) (list.nth 1 call)
                          "macro expansion exceeded 64 nested calls") st (list.nth 3 j))
            s active;
        [failed, list.map (fn j -> [list.nth 0 j, list.nth 1 j,
            fill (list.nth 2 j) (list.map (fn call -> ast.unit_e (list.nth 1 call))
                                          (list.nth 3 j))]) punched]
    } else {
        // One job per module, its declarations' calls in the order they were
        // punched, so the answers come back in an order the walk below can
        // hand out again without keying anything.
        let mods = list.fold (fn acc j ->
            if list.contains (list.head j) acc { acc } else { acc + [list.head j] }) [] active;
        let jobs = list.map (fn mi -> [mi, list.concat (list.map (fn j -> list.nth 3 j)
            (list.filter (fn j -> list.head j == mi) active))]) mods;
        let result = evaluate_round! base s jobs;
        // Both the syntax and the updated loader contain lazy fields whose
        // frames retain this round's resolver and lowered program. Finish them
        // before the next round, so a program with many expands does not keep
        // every temporary compilation alive at once.
        strict! result
        let [state, per_module] = result;
        let pool = list.fold (fn m pair -> m.[list.head pair => list.nth 1 pair])
                             %{} (list.zip mods per_module);
        let filled = list.fold (fn [acc, remaining] j -> {
            let calls = list.nth 3 j;
            if list.is_empty calls {
                [core.cons [list.nth 0 j, list.nth 1 j, list.nth 2 j] acc, remaining]
            } else {
                let mi = list.head j;
                let mine = remaining.[mi else []];
                let answers = list.map (fn pair -> match list.head pair {
                    () => ast.unit_e (list.nth 1 (list.nth 1 pair)),
                    answer => answer,
                }) (list.zip (list.take (list.length calls) mine) calls);
                [core.cons [mi, list.nth 1 j, fill (list.nth 2 j) answers] acc,
                 remaining.[mi => list.drop (list.length calls) mine]]
            }
        }) [[], pool] punched;
        rounds_all! base state (list.reverse (list.head filled)) (depth + 1)
    }
};

let base_of s  = core.map_get s :base ();
let put_base b s = core.map_put s :base b;

/// Declaration `i` of module `mi`, expanded and put back where it was.
///
/// `with_new_items` for the reason `apply_items` gives: what a transformer
/// hands back may name `core` where the source did not.
let expand_item! base s mi i item = {
    let result = rounds! base s mi item 0;
    strict! result
    let [state, expanded] = result;
    let current = modules.module_at (loader state) mi;
    put_loader (replace_module (loader state) mi
        (modules.with_new_items current
            ((modules.module_items current).[i => expanded]))) state
};

let complaints s = list.length (modules.diags (loader s));

/// Is offset `at` inside this declaration, and is any of `sites`?
let holds item at = {
    let sp = ast.span item;
    ast.span_start sp <= at && at < ast.span_end sp
};
let rec in_item sites item = match sites {
    [] => false,
    [at, ..rest] => holds item at || in_item rest item,
};

/// Every declaration that has an `expand` in it, as `[module, index, tree]`.
///
/// This runs on every compile, macros or not -- it is how the question "is
/// there anything to expand?" is answered -- and it used to answer it by
/// walking every node of every declaration in the program. On a self-compile
/// that was **11% of every reduction the compiler made**, to find eighteen
/// declarations out of two thousand.
///
/// The parser already knows. `modules.expand_sites` is where the word
/// `expand` is written in this module's file, so the declarations that can
/// hold one are the ones whose span an offset falls inside, and only those
/// are walked. A file with no offsets at all -- which is nearly every file --
/// is not looked at.
///
/// **The offsets have to account for the declarations, or they decide
/// nothing.** An `expand` inside a `when` the configuration switched off is
/// written in the file and belongs to no declaration that survives here, and
/// that is a real case: `std.macros` tests its own macros. So the check is
/// two-way -- every offset must land inside one of the declarations picked --
/// and a file where it does not falls back to the walk it would have had.
/// Getting this wrong in the other direction would leave an `[:expand, ..]`
/// node in a program nothing expands, so it is written to be checkable
/// rather than to be clever.
///
/// Where it does walk, it walks the items rather than indexing them: a
/// `list.nth i items` inside a fold over `0..length` is a walk per
/// declaration, which is a module's declarations squared.
let work_of l = list.concat (list.map (fn mi -> {
    let m = modules.module_at l mi;
    let sites = modules.expand_sites l (modules.module_source m);
    if list.is_empty sites { [] }
    else {
        let numbered = list.reverse (list.nth 1 (list.fold (fn [i, acc] item ->
            [i + 1, core.cons [i, item] acc]) [0, []] (modules.module_items m)));
        let picked = list.filter (fn [_, item] -> in_item sites item) numbered;
        let accounted = list.all (fn at ->
            list.any (fn [_, item] -> holds item at) picked) sites;
        list.map (fn [i, item] -> [mi, i, item])
            (list.filter (fn [_, item] -> has_expansion (macro_let item))
                         (if accounted { picked } else { numbered }))
    }
}) (list.range 0 (modules.module_count l)));

/// Put every expanded declaration back where it came from.
///
/// `with_new_items` rather than `with_items`: a transformer may hand back a
/// tree naming something the module's source never did, and `core` is the one
/// name a module gets bound without asking for it. So the module forgets what
/// it was known to mention and is asked again -- which is a handful of modules
/// rather than the program, and is the reason the rest of them can keep the
/// loader's answer across the copy expansion stages against.
let apply_items l items = list.fold (fn acc [mi, i, tree] -> {
    let current = modules.module_at acc mi;
    replace_module acc mi
        (modules.with_new_items current ((modules.module_items current).[i => tree]))
}) l items;

/// The original algorithm: one declaration at a time, each against a snapshot
/// rebuilt whenever the last one raised.
///
/// This is what runs when the whole-program round could not answer for
/// everything. It is slower by the size of the program times the number of
/// declarations, and it is the path that gives a real failure the diagnostic
/// it had before any batching existed -- so a build that is going to fail
/// fails the same way, having spent the time only because it was failing.
let sequential! l =
    list.fold (fn s mi -> {
        let m = modules.module_at (loader s) mi;
        // The same filter `work_of` uses, at its coarsest: a file with no
        // `expand` written in it has nothing here. This is the fallback path
        // and it re-walks by declaration rather than picking, because what
        // sent it here is a snapshot that could not answer and the order is
        // the whole of what it has to offer.
        let items = if list.is_empty (modules.expand_sites (loader s) (modules.module_source m)) {
                        []
                    } else { modules.module_items m };
        list.fold_strict (fn acc i -> {
            let item = list.nth i items;
            if not (has_expansion (macro_let item)) { acc }
            else {
                // The path a failed batch falls to resolves whole programs:
                // it is here because something the reachable-only snapshot
                // stubbed was demanded, and only a program with no stubs in it
                // can tell that apart from a macro that genuinely raised.
                let preparing = charge! (metering acc) (match base_of acc {
                    () => (prepare! (loader acc)).[:whole => true],
                    b => b,
                });
                let base = list.head preparing;
                let before = complaints acc;
                // Charged onto the state this declaration produced rather than
                // handed back beside it, because a snapshot this fold already
                // has costs nothing to reuse and the reading says so: the
                // second `strict!` finds it forced.
                let first = charged (expand_item! base acc mi i item)
                                    :snapshot (list.nth 1 preparing);
                strict! first
                // A declaration that raised may have been asking for one the
                // snapshot has not caught up with. That is the only thing a
                // stale snapshot can do -- see `prepare!` -- so a fresh one
                // and a second attempt settles which it was, started again
                // from before the first so that a failure that is real is
                // still reported exactly once.
                if complaints first == before { put_base base first }
                else {
                    let again = charge! (metering acc)
                        ((prepare! (loader acc)).[:whole => true]);
                    let fresh = list.head again;
                    put_base fresh (charged (expand_item! fresh acc mi i item)
                                            :snapshot (list.nth 1 again))
                }
            }
        }) s (list.range 0 (list.length items))
    }) %{ :loader => l, :next => 3221225472 } (list.range 0 (modules.module_count l));

let expand! l = if modules.failed l { l } else { expand_work! l (work_of l) };

/// `work` is every declaration with an `expand` in it, which is also the
/// answer to whether there is anything to do: finding it is a walk of the
/// whole program's syntax, and asking first whether the walk is worth making
/// was the same walk again.
let expand_work! l work = {
    let start = %{ :loader => l, :next => 3221225472 };
    // Finding the work is the one phase every compile pays, macros or not, so
    // it is charged even though it is not part of a round.
    let discovery = phase! start :discover work;
    let s0 = list.head discovery;
    let found = list.nth 1 discovery;
    if list.is_empty found { l }
    else {
        // Two charges, not one. Staging walks every item of every module, which
        // is where a lazily parsed program is finally parsed; declaring walks
        // every declaration for its name, which is the walk `scope.resolve!`
        // makes again once expansion is done. Charging them together said only
        // that the pair was most of a macro's cost, which is not a thing
        // anyone can act on.
        let staging = phase! s0 :stage (stage_program l found);
        let staged = list.nth 1 staging;
        let declaring = phase! (list.head staging) :snapshot (scope.declare! staged);
        let snapshot = [list.head declaring,
                        %{ :loader => staged, :declared => list.nth 1 declaring }];
        let batched = rounds_all! (list.nth 1 snapshot) (list.head snapshot) found 0;
        strict! batched
        let state = list.head batched;
        // Nothing complained, so one snapshot answered for the whole program
        // and the batch is the answer. Otherwise a declaration wanted
        // something the shared snapshot did not have, or genuinely failed,
        // and only the original order can tell those apart -- so the whole
        // program is expanded again the old way, from the original loader, and
        // the batch is discarded rather than merged.
        // The fallback is a second expansion of the whole program, so its meter
        // is added to the batch's rather than replacing it: what the compile
        // spent is what both attempts spent, and `sequential` is what says a
        // reader is looking at two of them. Both come out of one call, because
        // `sequential!` is impure and asking it twice would expand twice.
        let outcome = if complaints state == list.length (modules.diags l) {
                [state, apply_items (loader state) (list.nth 1 batched)]
            } else {
                let seq = sequential! l;
                [counted (put_meter (merge_meter (meter_of state) (meter_of seq)) state)
                         :sequential 1,
                 loader seq]
            };
        publish_meter (list.head outcome) (modules.map_modules (fn m -> with_items m
            (list.map macro_let (modules.module_items m))) (list.nth 1 outcome))
    }
};
