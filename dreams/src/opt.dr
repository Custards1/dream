// The optimizer: one rebuild of the finished arena.
//
// Lowering emits a node wherever the source says one, and says nothing about
// whether it has emitted that node before. It has, constantly. `local 3` is one
// record and a self-compile writes ten thousand of them; `head` as a
// callee is a `builtin` beside an `apply` and there are seven thousand of those;
// a whole `if x == () { .. }` written twice in two modules is two identical
// subtrees. Nothing downstream can tell the copies apart, because a node record
// is the entire description of what it does -- there is no identity in it, only
// an opcode, its flags and three operands.
//
// So the arena is rebuilt once, bottom up, into a fresh one that keeps a table
// of everything it has already emitted. A node whose record has been seen is
// not appended again; the edge that wanted it points at the copy that exists.
// Because the children are rebuilt first, two equal subtrees reach this with
// equal operands, and the sharing compounds all the way up: on `dreams` itself
// 67,306 nodes become 19,323 and the image goes from 1.29 MB to 474 KB. Flat,
// only 47% of the arena is duplicate records; bottom up it is 71%.
//
// The same walk answers two other questions for free, which is why they are
// here rather than in passes of their own:
//
//   - **What is dead.** The walk starts from the function bodies, so a node
//     nothing reaches is never copied. Wrapper lowering leaves these behind by
//     the hundred -- it emits the call before deciding to rewrite it -- and
//     before this pass they were written into the image and loaded by the VM.
//   - **Which runs of children are the same.** A variadic node addresses its
//     children as an offset and a count into one side pool, so two calls with
//     the same arguments want the same run, and after the sharing above they
//     have the same indices to look identical by. Half the pool goes.
//
// What makes all of this sound is that a node is a *function of the frame it is
// evaluated against*, and of nothing else. Sharing one between two functions
// does not make them share anything at run time: each forces it against its own
// frame, and `local 3` means "slot 3 of whoever is asking". Memoization belongs
// to the thunk the machine builds, which is a pair of a node and a frame, so
// two sites that share a node still get a thunk each.
//
// The one exception is `field`, and it is not about correctness -- see
// `shareable` below.
//
// **Why this is a second walk and not part of `ir.push_node`.** Interning as
// nodes are pushed would be strictly cheaper -- no second walk, no memo, and
// lowering already pays for the push. It is also wrong, because a node's flags
// are not final when it is pushed. `ir.set_node_flag` exists precisely so that
// a flag discovered late -- that a call turned out to be in tail position, that
// a value turned out to be effectful -- can be set on a node already in the
// arena, and setting one on a node shared at push time would hand it to every
// other site sharing it. A flag is the compiler's answer to "when does this
// run?", so that is not a small error. The same argument puts this after
// `settle_comps!` rather than merely after lowering: a compile-time expression
// overwrites its placeholder once the program has been built and run.
//
// The one instruction rewrite fuses a primitive `type_of` comparison into a
// runtime type test. It forces exactly the same subject and preserves errors;
// it does not trust a gradual signature. Everything else is copied with its
// operands renumbered or removed because no body reaches it. `--no-opt` keeps
// the original arena for comparison.

import std.list;
import std.lazy;
import std.vm;

import dreams.ir;
import dreams.builtins;
import std.array;
import std.map;

// --- what an operand means ----------------------------------------------------
//
// A rebuild has to renumber every edge and copy everything else, so it has to
// know which is which -- and the three operand fields of a node record are not
// typed. `a` is another node in `force`, a frame slot in `bind`, a function
// index in `closure`, a constant index in `int` and a Unicode scalar in `char`.
// Getting one wrong is silent in the worst way: the image still loads, the
// section table still adds up, and some program somewhere reads a slot number
// as a node index and evaluates whatever happens to live there.
//
// So the two tables below are written out per opcode rather than inferred, and
// an opcode named in neither is a leaf whose operands are all copied. The
// operands are numbered 0, 1, 2 for `a`, `b`, `c`.

/// Which operands are edges to other nodes.
let node_edges = [
    /// `a` is the object; `b` is the string constant naming the field.
    [:field, [0]],
    /// `a` is the callee; `b` and `c` address the argument run below.
    [:apply, [0]],
    [:if, [0, 1, 2]],
    /// `a` is the slot bound; only the value is a node.
    [:bind, [1]],
    /// `a` is the body and `b` the handler; `c` is the slot the error binds to.
    [:try, [0, 1]],
    [:ensure, [0, 1]],
    [:force, [0]],
    [:type_is, [0]],
    [:cons, [0, 1]], [:list_tail, [0]], [:list_is_empty, [0]],
    [:neg, [0]], [:not, [0]],
    [:add, [0, 1]], [:sub, [0, 1]], [:mul, [0, 1]],
    [:div, [0, 1]], [:mod, [0, 1]],
    [:eq, [0, 1]], [:ne, [0, 1]], [:lt, [0, 1]],
    [:le, [0, 1]], [:gt, [0, 1]], [:ge, [0, 1]],
    [:and, [0, 1]], [:or, [0, 1]],
    [:band, [0, 1]], [:bor, [0, 1]], [:bxor, [0, 1]], [:shl, [0, 1]], [:shr, [0, 1]],
    [:bnot, [0]],
    /// `c` is the fallback, and absent when there is none.
    [:get, [0, 1, 2]],
    [:set, [0, 1, 2]],
    /// `a` is the container; the pairs are a run.
    [:set_many, [0]],
    /// `a` is the subject; the table is a run.
    [:switch_head, [0]], [:switch_atom, [0]],
];

/// Which opcodes address a run of children, as `[op, offset operand, count
/// operand, kids per count]`. The multiplier is for `map`, whose count is a
/// number of pairs and whose run is two kids each.
let node_runs = [
    [:str_chars, 1, 2, 1],
    [:error_new, 1, 2, 1],
    [:error_kind, 1, 2, 1],
    [:error_payload, 1, 2, 1],
    [:str_slice, 1, 2, 1],
    [:str_find, 1, 2, 1],
    [:str_byte, 1, 2, 1],
    [:str_le, 1, 2, 1],
    [:str_span, 1, 2, 1],
    [:str_upto, 1, 2, 1],
    [:char_code, 1, 2, 1],
    [:char_of_code, 1, 2, 1],
    [:to_float, 1, 2, 1],
    [:float_bytes, 1, 2, 1],
    [:float_of_bytes, 1, 2, 1],
    [:to_int, 1, 2, 1],
    [:parse_int, 1, 2, 1],
    [:parse_float, 1, 2, 1],
    [:to_existing_atom, 1, 2, 1],
    [:array_new, 1, 2, 1],
    [:array_to_list, 1, 2, 1],
    [:map_has, 1, 2, 1],
    [:map_remove, 1, 2, 1],
    [:map_pairs, 1, 2, 1],
    [:data_count, 1, 2, 1],
    [:data_at, 1, 2, 1],
    [:compare, 1, 2, 1],
    [:str_interp, 1, 2, 1],

    [:apply, 1, 2, 1],
    [:block, 0, 1, 1],
    [:make_list, 0, 1, 1],
    [:make_array, 0, 1, 1],
    [:record_make, 0, 1, 1],
    [:make_map, 0, 1, 2],
    [:set_many, 1, 2, 2],
    [:switch_head, 1, 2, 1],
    [:switch_atom, 1, 2, 1],
];

// Asked once per node of the program, which is the shape of question that has
// twice been the most expensive thing in a self-compile when it was answered by
// walking a list. Both tables are built once, at module level.
let edge_map = fold (fn m e -> m.[(list.nth 0 e) => (list.nth 1 e)])
                         (%{}) node_edges;
let run_map = fold (fn m e -> m.[(list.nth 0 e) => [list.nth 1 e, list.nth 2 e, list.nth 3 e]])
                        (%{}) node_runs;

let edges_of : :atom -> [:integer];
let edges_of op = edge_map.[op else []];
let run_of : :atom -> [:integer] | :unit;
let run_of op = run_map.[op else ()];

/// An opcode with no children at all: every operand it has is a number that
/// means something other than "the node over there". Half the arena is these --
/// `local`, `builtin`, `global`, `atom`, `int` -- and the walk below treats
/// them differently, so the question is asked once per node and gets its own
/// table rather than two misses on the two above.
let leaf_map = fold (fn m e -> m.[(list.nth 0 e) => false])
                         (fold (fn m e -> m.[(list.nth 0 e) => false])
                                    (%{}) node_edges)
                         node_runs;
let is_leaf : :atom -> :bool;
let is_leaf op = leaf_map.[op else true];

/// Operand `k` of a node, and a node with operand `k` replaced. A node is
/// `[op, flags, a, b, c]`, so operand `k` is at position `k + 2`.
let operand : :integer -> ir.Node -> :any;
let operand k n = n.[k + 2 else ir.no_node];
let set_operand : :integer -> :any -> ir.Node -> ir.Node;
let set_operand k v n = n.[k + 2 => v];

/// Whether two equal copies of this node may become one.
///
/// Only `field` may not, and the reason is speed rather than meaning. A member
/// access carries an inline cache in the VM, and the cache is indexed *by node*:
/// `member_value` in [dream/src/interp.cpp](dream/src/interp.cpp) remembers
/// against the site which member of which module it found last time. Sharing a
/// site would still be correct -- the cache stores the import index alongside
/// the answer and falls back to the search when it does not match, precisely so
/// that a node meeting a different module cannot read the wrong member out of
/// the right one -- but a shared site is one that can meet more than one module,
/// and a cache that misses is worse than no sharing. There are 842 of them in
/// `dreams` against 47,000 nodes saved, so this costs nothing worth having.
let shareable : ir.Node -> :bool;
let shareable n = ir.node_op n != :field;

// --- the rebuild state ----------------------------------------------------------
//
// The arena being built, and the three tables that keep the walk from doing
// anything twice. All of them are maps rather than lists for the reason
// `ir.program` gives: appending to a list costs its length and indexing one
// costs the index, and there are tens of thousands of both here.

mapping State {
    // Input is indexed out of order: arrays for an image, maps for a program.
    src = #[]
    src_kids = #[]
    // Output pools are consed in reverse and flattened only when finished.
    out = []
    count = 0
    out_kids = []
    kid_count = 0
    // Node record to output index; child run to output offset.
    seen = %{}
    runs = %{}
    // Old node index to new: revisiting shared subtrees must not copy them.
    memo = %{}
    memo_base = 0
    remap = ()
    memo_leaves = false
    parts = #[]
    fo = 0
    go = 0
    invented_from = 0
    filled = %{}
    type_ids = %{}
}

let state : (:array | :map) -> (:array | :map) -> State;
let state nodes kids = State.new () |> State.set_src nodes |> State.set_src_kids kids;

let src : State -> :array | :map;
let src s        = State.src s;
let src_kids : State -> :array | :map;
let src_kids s   = State.src_kids s;
let out : State -> [ir.Node];
let out s        = State.out s;
let count : State -> :integer;
let count s      = State.count s;
let out_kids : State -> [:any];
let out_kids s   = State.out_kids s;
let kid_count : State -> :integer;
let kid_count s  = State.kid_count s;
let seen : State -> :map;
let seen s       = State.seen s;
let runs : State -> :map;
let runs s       = State.runs s;
let memo : State -> :map;
let memo s       = State.memo s;

/// Force what has been built so far.
///
/// The same move `ir.settle` makes and for the same reason: every table here
/// grows by one `map_put` per node, and a `map_put` nobody forces is a
/// suspension holding the map before it. Left alone that is sixty thousand of
/// them stacked up, every intermediate table live at once, and forcing the last
/// walks the whole history. Forced as it is built, what stays live is the five
/// tables and nothing else.
///
/// Called once per node, from `rebuild`, and not by the table writes
/// underneath it -- a node passes through `keep` and at most one `keep_run` on
/// its way back up, so settling at the top of that catches every write with a
/// chain three long rather than one. Settling at each write instead cost 2.8%
/// of a self-compile to force what the next call would have forced anyway.
let settle : State -> State;
let settle s =
    if lazy.forced (out s) && lazy.forced (out_kids s) && lazy.forced (seen s)
       && lazy.forced (runs s) && lazy.forced (memo s) { s } else { s };

let node_at : :integer -> State -> ir.Node;
let node_at i s = (src s).[i else ir.leaf :nop];

// --- several arenas at once ---------------------------------------------------------
//
// A program lowered in parts arrives as several arenas, each already shared
// within itself, each numbering its nodes from zero and interning its own
// constants -- see "lowering in parts" in [dreams/src/lower.dr](dreams/src/lower.dr).
// `optimize_parts` shares them *across* each other in one rebuild, reading
// them where they lie rather than laid end to end first. Every node a body
// reaches is in the same arena as the body, because a part is a set of whole
// bodies, so a function's body names its part as well as its node
// (`part_base`), the walk switches arenas at each body, and the memo is keyed
// by both halves. What is not the arena's own is renamed on the way through:
// a constant (an `int`, `str` or `atom` leaf, and the string a `field` names)
// indexes the part's pool, and a part resolved in parts also numbered its
// functions and invented globals for itself -- from where the declarations
// left off, so `fo` moves every closure, thunk and `comp` placeholder, and `go`
// every global at or past `invented_from` (see "resolving in parts" in
// dreams/src/scope.dr).
//
// Leaves are memoized here where `rebuild` does not memoize them. A lowered
// arena is nearly a tree; a shared part is the opposite, a leaf there being
// one node with a thousand parents, and re-keying it at every one of them was
// most of what a merge cost.

/// Node `i` of part `k` is `k * part_base + i` wherever a function names it.
let part_base = 134217728;

let memo_base : State -> :integer;
let memo_base s = State.memo_base s;
let remap s = State.remap s;
let memo_leaves : State -> :bool;
let memo_leaves s = State.memo_leaves s;

/// Read from part `k` from here on.
let enter_part : :integer -> State -> State;
let enter_part k s = {
    let part = (State.parts s).[k];
    (s
        |> State.set_src (part.[:nodes else #[]])
        |> State.set_src_kids (part.[:kids else #[]])
        |> State.set_remap (part.[:remap else ()])
        |> State.set_memo_base (k * part_base)
        |> State.set_fo (part.[:fo else 0])
        |> State.set_go (part.[:go else 0]))
};

/// A leaf as the whole program numbers it: `remap_leaf_by` for its constant,
/// and the part's offsets for the function or invented global it names.
let remap_leaf : ir.Node -> State -> ir.Node;
let remap_leaf n s = match remap s {
    () => n,
    m => {
        let fo = State.fo s;
        match ir.node_op n {
            :make_closure => set_operand 0 (ir.node_a n + fo) n,
            :make_thunk => set_operand 0 (ir.node_a n + fo) n,
            :unit => if ir.is_node (ir.node_a n) { set_operand 0 (ir.node_a n + fo) n } else { n },
            :global => if ir.node_a n >= (State.invented_from s) {
                           set_operand 0 (ir.node_a n + (State.go s)) n
                       } else { n },
            _ => remap_leaf_by m n,
        }
    },
};

/// A leaf of a part, kept -- or, when it is a `comp` placeholder whose value
/// has been settled, the part-0 node that value was lowered to, rebuilt in its
/// place. See "running what was lowered in parts" in dreams/src/lower.dr.
let rebuild_leaf n s =
    match (if ir.node_op n == :unit && ir.is_node (ir.node_a n) { (State.filled s).[ir.node_a n else ()] }
           else { () }) {
        () => keep n s,
        value => {
            let back = memo_base s / part_base;
            let got = rebuild value (enter_part 0 s);
            [enter_part back (list.head got), list.nth 1 got]
        },
    };

/// A `field` with the string naming it renamed the same way, and a
/// `record_make` with the atom naming what it makes -- keeping the bit that
/// says it is a variant.
let remap_field : ir.Node -> State -> ir.Node;
let remap_field n s = match remap s {
    () => n,
    m => match ir.node_op n {
        :field => set_operand 1 ((m.[:strs]).[ir.node_b n]) n,
        :record_make => {
            let c = ir.node_c n;
            let bit = if c >= ir.record_variant { ir.record_variant } else { 0 };
            set_operand 2 ((m.[:atoms]).[c - bit] + bit) n
        },
        _ => n,
    },
};
let kid_at i s = (src_kids s).[i else ir.no_node];

// These are runtime representation tests, not signature assumptions. Gradual
// callers and integer overflow must still be observed as they are at runtime.
// The numbers match dream_type in dream/include/dream/h.
let type_codes = %{ "integer" => 0, "float" => 1, "char" => 2,
    "bool" => 3, "unit" => 4, "string" => 5, "atom" => 6,
    "list" => 7, "array" => 8, "map" => 9 };

let type_test call written invert flags s = {
    // The atom as the program numbers it, when this is one part of several:
    // `type_ids` is keyed by the merged pool.
    let atom = remap_leaf written s;
    let callee = node_at (ir.node_a call) s;
    let code = (State.type_ids s).[ir.node_a atom else ()];
    if ir.node_op call == :apply && ir.node_c call == 1
       && ir.node_op callee == :builtin && ir.node_a callee == type_of_id
       && ir.node_op atom == :const_atom && code != () {
        ir.with_flags flags (ir.node :type_is (kid_at (ir.node_b call) s) code invert)
    } else { () }
};

/// Fuse before rebuilding children, so the unused call, atom and argument run
/// never enter the new image. A literal on either side has no forcing effect.
let primitive_ops = %{
    19 => [:str_chars, 1],
    23 => [:error_new, 2],
    24 => [:error_kind, 1],
    25 => [:error_payload, 1],
    26 => [:str_slice, 3],
    27 => [:str_find, 3],
    28 => [:str_byte, 2],
    29 => [:str_le, 2],
    30 => [:str_span, 3],
    31 => [:str_upto, 3],
    32 => [:char_code, 1],
    33 => [:char_of_code, 1],
    34 => [:to_float, 1],
    35 => [:float_bytes, 1],
    36 => [:float_of_bytes, 1],
    37 => [:to_int, 1],
    38 => [:parse_int, 1],
    39 => [:parse_float, 1],
    40 => [:to_existing_atom, 1],
    41 => [:array_new, 2],
    43 => [:array_to_list, 1],
    44 => [:map_has, 2],
    45 => [:map_remove, 2],
    46 => [:map_pairs, 1],
    47 => [:data_count, 1],
    48 => [:data_at, 1],
    49 => [:compare, 2],
    52 => [:str_interp, 1],
};

/// The three list builtins that become opcodes of their own, keyed by the
/// runtime ID of the builtin they replace. Looked up per `apply` the pass
/// rebuilds, so the IDs are settled here once rather than asked of
/// `builtins.id` three times a node.
let list_ops = %{
    builtins.id "_list_cons" => [:cons, 2],
    builtins.id "_list_tail" => [:list_tail, 1],
    builtins.id "_list_is_empty" => [:list_is_empty, 1],
};

let type_of_id = builtins.id "type_of";

let specialize : ir.Node -> State -> ir.Node;
let specialize n s = match ir.node_op n {
    :apply => {
        let callee = node_at (ir.node_a n) s;
        let id = ir.node_a callee;
        let count = ir.node_c n;
        let primitive = primitive_ops.[id else ()];
        let op = match list_ops.[id else ()] {
            [op, arity] if arity == count => op,
            _ => (),
        };
        if ir.node_op callee == :builtin && op != () {
            ir.with_flags (ir.node_flags n) (ir.node op (kid_at (ir.node_b n) s)
                (if count == 2 { kid_at (ir.node_b n + 1) s } else { ir.no_node }) ir.no_node)
        } else if ir.node_op callee == :builtin && primitive != ()
                  && count == list.nth 1 primitive {
            ir.with_flags (ir.node_flags n)
                (ir.node (list.head primitive) id (ir.node_b n) count)
        } else { n }
    },
    op if op == :eq || op == :ne => {
        let a = node_at (ir.node_a n) s;
        let b = node_at (ir.node_b n) s;
        let invert = if op == :ne { 1 } else { 0 };
        match type_test a b invert (ir.node_flags n) s {
            () => match type_test b a invert (ir.node_flags n) s {
                () => n,
                test => test,
            },
            test => test,
        }
    },
    _ => n,
};

/// Append a node, or answer the index of one already emitted that says the same
/// thing: `[state, index]`.
///
/// The key is the record itself, written out. A list cannot be a map key --
/// keys are compared by identity, and two equal lists are two objects -- so the
/// five fields become a string, which can. That is one native call and a short
/// string per node, against a trie walk per field for the nested-map form.
let keep n s =
    if not (shareable n) {
        let i = count s;
        [(s |> State.set_out (list.cons n (out s)) |> State.set_count (i + 1)), i]
    } else {
        let key = to_string n;
        match (seen s).[key else ()] {
            () => {
                let i = count s;
                [(s |> State.set_out (list.cons n (out s)) |> State.set_count (i + 1) |> State.set_seen ((seen s).[key => i])),
                 i]
            },
            found => [s, found],
        }
    };

/// Append a run of children, given back to front, or answer the offset of an
/// identical run already placed: `[state, offset]`.
///
/// Back to front because that is how both callers build one and how the pool
/// is kept: the pool is a list in reverse, so the run goes on the front of it
/// back to front, which is the order it is already in, and `+` puts it there in
/// one machine walk. Reversing it to key it and reversing it again to place it
/// was two Dream loops per run for nothing -- the key only has to be the same
/// for the same run, and every run is keyed the same way.
let keep_run rev s = {
    let key = to_string rev;
    match (runs s).[key else ()] {
        () => {
            let at = kid_count s;
            [(s
                |> State.set_out_kids (rev + out_kids s)
                |> State.set_kid_count (at + list.length rev)
                |> State.set_runs ((runs s).[key => at])),
             at]
        },
        found => [s, found],
    }
};

// --- the walk --------------------------------------------------------------------

/// Rebuild the node at `i` into the new arena: `[state, new index]`.
///
/// Children first, so that by the time a node is looked up in the sharing table
/// its operands are already the indices the copy would have, and two subtrees
/// that mean the same thing are the same record.
///
/// A leaf skips the memo, and which nodes get one is worth the paragraph
/// because the obvious answer -- all of them -- is the slower one. The arena
/// this reads is very nearly a tree: on `dreams` itself, walking it with no
/// memo at all visits 77,920 nodes against 66,336 distinct, so the whole table
/// buys 17% fewer visits and charges a lookup and an insert on a table the size
/// of the program for every one of them. Half those entries are leaves, and a
/// leaf is the one node a re-walk cannot make expensive: it has no children, so
/// visiting it twice is twice one visit rather than twice a subtree, and no
/// amount of sharing above it can compound. So leaves are simply re-walked --
/// `keep` answers them from the sharing table anyway, which is the same table
/// the memo would have been consulted for -- and the memo is kept for nodes
/// with children, where a shared subtree could otherwise be copied once per
/// path to it and a deep enough DAG could take exponential time.
let rec rebuild i s =
    if not (ir.is_node i) { [s, i] }
    else {
        let n = node_at i s;
        let leaf = is_leaf (ir.node_op n);
        if leaf && not (memo_leaves s) { keep n s }
        else {
            let key = i + memo_base s;
            match (memo s).[key else ()] {
                () => {
                    let got = if leaf { rebuild_leaf (remap_leaf n s) s } else { rebuild_node n s };
                    let s1 = list.head got;
                    let at = list.nth 1 got;
                    [settle (s1 |> State.set_memo ((memo s1).[key => at])), at]
                },
                found => [s, found],
            }
        }
    };

/// The rebuild proper, for a node with children that has not been met before.
let rec rebuild_node n s = {
    // A part was specialized by its own rebuild; sharing parts only renames.
    let n = if memo_leaves s { remap_field n s } else { specialize n s };
    let op = ir.node_op n;
    // The edges, left to right. Each answers the state it left behind and the
    // node with that one operand renumbered.
    let edged = rebuild_edges (edges_of op) n s;
    // Then the run of children, if this opcode has one.
    let run = match run_of op {
                  () => edged,
                  spec => rebuild_run spec (list.nth 1 edged) (list.head edged),
              };
    keep (list.nth 1 run) (list.head run)
};

/// Rebuild each edge operand in turn: `[state, node]`, with the node's
/// operands renumbered. A loop of its own rather than a fold, which paid for a
/// closure call and a pair per edge.
let rec rebuild_edges ks n s = match ks {
    [] => [s, n],
    [k, ..rest] => {
        let got = rebuild (operand k n) s;
        rebuild_edges rest (set_operand k (list.nth 1 got) n) (list.head got)
    },
};

/// Rebuild one node's run of children and point the node at the new run:
/// `[state, node]`.
let rec rebuild_run spec n s = {
    let off = operand (list.nth 0 spec) n;
    let many = operand (list.nth 1 spec) n * list.nth 2 spec;
    let built = rebuild_kids off 0 many [] s;
    let placed = keep_run (list.nth 1 built) (list.head built);
    [list.head placed, set_operand (list.nth 0 spec) (list.nth 1 placed) n]
};

/// Rebuild `many` children from `off`, collecting the new indices in reverse:
/// `[state, reversed]`.
let rec rebuild_kids off k many !acc s =
    if k >= many { [s, acc] }
    else {
        let got = rebuild (kid_at (off + k) s) s;
        rebuild_kids off (k + 1) many (list.cons (list.nth 1 got) acc) (list.head got)
    };

// --- the pass ----------------------------------------------------------------------

/// Carry one function's capture descriptors across to the new pool.
///
/// Captures share the kids pool with call arguments and block statements --
/// `place_captures` in [dreams/src/lower.dr](dreams/src/lower.dr) says why -- so a pass
/// that rebuilds that pool from the nodes alone drops every one of them, and a
/// `closure` then reads its captures out of whatever indices now live at the
/// offset it remembers. The VM catches it at load (`capture list extends past
/// the kids pool`) only when the run happened to fall off the end.
///
/// A descriptor is not an edge: it is a slot number, or a capture index with
/// the high bit set, read against the *defining* frame. So the run is copied
/// verbatim rather than renumbered, and only its offset changes. It still goes
/// through `keep_run`, which is sound for the same reason sharing an argument
/// run is: the pool is a flat array of numbers, and two runs holding the same
/// numbers are the same run to everyone who reads it.
let place_captures f s = {
    let off = f.[:captures_off else 0];
    let many = f.[:n_captures else 0];
    if many == 0 { [s, 0] }
    else { keep_run (map (fn k -> kid_at (off + many - 1 - k) s) (list.range 0 many)) s }
};

/// Rebuild every reachable node of a finished image.
///
/// The entry points are the function bodies and there are no others: a global
/// names a function, a closure and a thunk name a function, and the image's
/// entry is a function. So a node no body reaches is a node nothing can ever
/// evaluate.
///
/// Everything the image holds that is not a node or a kid is carried through
/// untouched, which is what makes this safe to drop into the middle of a build:
/// the constant pools keep their indices, so every `int`, `str` and `atom` node
/// still names what it named, and `funcs` changes in exactly two fields.
let optimize : ir.Image -> ir.Image;
let optimize img =
    optimize_tables img (array.of_list (ir.Image.nodes img)) (array.of_list (ir.Image.kids img));

/// The same, for a program as `lower` builds it: straight from its tables,
/// which a read indexes as well as it does an array, so the arena is never
/// flattened into the lists an image of it would hold -- only the rebuild is.
let optimize_program : ir.Program -> ir.Image;
let optimize_program p = optimize_tables (ir.finish_rest p) (ir.nodes p) (ir.kids p);

let optimize_tables : ir.Image -> (:array | :map) -> (:array | :map) -> ir.Image;
let optimize_tables img nodes kids = {
    let walked = walk_funcs (ir.Image.funcs img) (fresh img nodes kids);
    finished img (list.head walked) (list.reverse (list.nth 1 walked))
};

/// A state to walk from: the arena to read, and nothing written yet.
let fresh : ir.Image -> (:array | :map) -> (:array | :map) -> State;
let fresh img nodes kids = {
    let strings = array.of_list (ir.Image.strs img);
    let ids = list.map (fn at -> type_codes.[strings.[at else ""] else ()])
                      (ir.Image.atoms img);
    let type_ids = fold (fn m pair -> m.[list.head pair => list.nth 1 pair])
                            %{} (list.zip (list.range 0 (list.length ids)) ids);
    ((state nodes kids) |> State.set_type_ids type_ids)
};

/// Start sharing one more body into a state that is already sharing others: its
/// arena is read from here on, and the memo -- which is about that arena's
/// indices -- starts empty. What has been emitted, and the table saying what
/// has, carries on, so a node the body shares with one before it is found.
let enter_body : (:array | :map) -> (:array | :map) -> :map -> State -> State;
let enter_body nodes kids type_ids s =
    (s |> State.set_src nodes |> State.set_src_kids kids |> State.set_memo (%{}) |> State.set_type_ids type_ids);

/// `type_ids` for a program whose pools are still growing: which atom index is
/// each of the ten names a runtime type test can be fused against. Ten lookups
/// in each pool's own index, so it is cheap enough to ask for every body.
let type_ids_in : ir.Pool -> ir.Pool -> %{:integer => :integer};
let type_ids_in strs atoms =
    fold (fn m kv -> {
        let [name, code] = kv;
        match (ir.pool_index strs).[name else ()] {
            () => m,
            si => match (ir.pool_index atoms).[si else ()] {
                () => m,
                ai => m.[ai => code],
            },
        }
    }) %{} (map.pairs type_codes);

/// Share several arenas into one: `parts` is an array of `%{ :nodes, :kids,
/// :remap, :fo, :go }`, arrays both, and each of `img`'s functions names its
/// body as `part * part_base + node`. Part 0 holds no nodes: it is the linked
/// program's own kids pool, where the functions' captures are. See "several
/// arenas at once".
let optimize_parts : ir.Image -> :array -> :integer -> ir.Image;
let optimize_parts img parts invented_from = optimize_parts_filled img parts invented_from %{};

/// The same, with each settled `comp` placeholder read as the part-0 node its
/// value was lowered to: `filled` maps the function a placeholder waits on to
/// that node.
///
/// The walk is the VM's (`vm.share_arenas`), and is `optimize_parts_by_hand`
/// step for step: this is a whole-program walk a warm build cannot keep
/// between builds, and in Dream it was a map insert and a `to_string` per node.
let optimize_parts_filled : ir.Image -> :array -> :integer -> :map -> ir.Image;
let optimize_parts_filled img parts invented_from filled = {
    let [nodes, kids, funcs] = vm.share_arenas [(ir.Image.funcs img), parts, invented_from, filled,
                                                edge_map, run_map, part_base];
    img |> ir.Image.set_nodes nodes |> ir.Image.set_kids kids |> ir.Image.set_funcs funcs
};

/// The walk `vm.share_arenas` makes, as the definition of it: the tests below
/// hold the two to each other.
let optimize_parts_by_hand : ir.Image -> :array -> :integer -> :map -> ir.Image;
let optimize_parts_by_hand img parts invented_from filled = {
    let s0 = ((fresh img #[] #[])
        |> State.set_parts parts
        |> State.set_memo_leaves true
        |> State.set_invented_from invented_from
        |> State.set_filled filled);
    let walked = list.fold (fn acc f -> {
        let body = f.[:body else ir.no_node];
        let entered = if ir.is_node body { enter_part (body / part_base) (list.head acc) }
                      else { list.head acc };
        let local = if ir.is_node body { body % part_base } else { body };
        let got = rebuild local entered;
        let caps = place_captures f (enter_part 0 (list.head got));
        [settle (list.head caps),
         list.cons ((f.[:body => (list.nth 1 got)]).[:captures_off => (list.nth 1 caps)])
                   (list.nth 1 acc)]
    }) [s0, []] (ir.Image.funcs img);
    finished img (list.head walked) (list.reverse (list.nth 1 walked))
};

/// Rebuild each function's body and captures, in order: `[state, functions]`,
/// the functions rebuilt and reversed.
let walk_funcs fs s0 =
    list.fold (fn acc f -> {
        let got = rebuild (f.[:body else ir.no_node]) (list.head acc);
        let caps = place_captures f (list.head got);
        [settle (list.head caps),
         list.cons ((f.[:body => (list.nth 1 got)]).[:captures_off => (list.nth 1 caps)])
                   (list.nth 1 acc)]
    }) [s0, []] fs;

/// A constant leaf with its pool index renamed through `m`, and any other node
/// as it is: a constant's operand is the only one a part numbers for itself.
let remap_leaf_by : :map -> ir.Node -> ir.Node;
let remap_leaf_by m n = match ir.node_op n {
    :const_int => set_operand 0 ((m.[:ints]).[ir.node_a n]) n,
    :const_float => set_operand 0 ((m.[:floats]).[ir.node_a n]) n,
    :const_str => set_operand 0 ((m.[:strs]).[ir.node_a n]) n,
    :const_atom => set_operand 0 ((m.[:atoms]).[ir.node_a n]) n,
    _ => n,
};

/// The image a finished walk describes.
let finished : ir.Image -> State -> [:map] -> ir.Image;
let finished img s funcs =
    img |> ir.Image.set_nodes (list.reverse (out s)) |> ir.Image.set_kids (list.reverse (out_kids s))
        |> ir.Image.set_funcs funcs;

when test {
    import std.test;

    /// An image with nothing in it but nodes, kids and the bodies that reach
    /// them. Everything else `optimize` carries through untouched, so a test of
    /// the walk does not need it.
    let image : [ir.Node] -> [:integer] -> [:integer] -> :map;
    let image nodes kids bodies =
        %{ :nodes => nodes, :kids => kids,
           :funcs => list.map (fn b -> %{ :body => b }) bodies };

    let with_caps nodes kids bodies caps =
        %{ :nodes => nodes, :kids => kids,
           :funcs => list.map (fn pair ->
               %{ :body => list.nth 0 pair,
                  :captures_off => list.nth 0 (list.nth 1 pair),
                  :n_captures => list.nth 1 (list.nth 1 pair) })
               (list.zip bodies caps) };

    let nodes_of : :map -> [ir.Node];
    let nodes_of img = ir.Image.nodes img;
    let kids_of : :map -> [:integer];
    let kids_of img = ir.Image.kids img;
    let bodies_of : :map -> [:integer];
    let bodies_of img = list.map (fn f -> f.[:body else ir.no_node])
                                 (ir.Image.funcs img);
    let caps_of : :map -> [[:integer, :integer]];
    let caps_of img = list.map (fn f -> [f.[:captures_off else 0],
                                         f.[:n_captures else 0]])
                               (ir.Image.funcs img);

    /// `local 0` twice over, as two bodies.
    let two_locals = optimize (image [ir.node :local 0 ir.no_node ir.no_node,
                                      ir.node :local 0 ir.no_node ir.no_node] [] [0, 1]);

    /// The same one-argument negation written twice.
    let two_trees = optimize (image [ir.node :local 0 ir.no_node ir.no_node,
                                     ir.node :local 0 ir.no_node ir.no_node,
                                     ir.node :neg 0 ir.no_node ir.no_node,
                                     ir.node :neg 1 ir.no_node ir.no_node] [] [2, 3]);

    /// Two parts and the linked program's own arena, with something in them
    /// for every step of the walk: constants renamed through a part's pools, a
    /// function and an invented global moved past the parts before, a `field`
    /// renamed and never shared, a call with a run of arguments, a settled
    /// `comp` placeholder read from part 0, captures, and a node two parts
    /// both have.
    let none = ir.no_node;
    let pools ints strs = %{ :ints => array.of_list ints, :floats => #[], :strs => array.of_list strs, :atoms => #[] };
    let parts = array.of_list [
        %{ :nodes => array.of_list [[:const_int, 0, 1, none, none], [:local, 0, 2, none, none]],
           :kids => array.of_list [4, 5] },
        %{ :nodes => array.of_list [[:add, 0, 1, 2, none], [:const_int, 0, 0, none, none],
                                    [:global, 0, 70, none, none], [:make_closure, 0, 1, none, none]],
           :kids => #[], :remap => pools [3] [], :fo => 0, :go => 5 },
        %{ :nodes => array.of_list [[:apply, 0, 1, 0, 2], [:field, 0, 4, 0, none], [:const_int, 0, 0, none, none],
                                    [:unit, 0, 0, none, none], [:local, 0, 2, none, none],
                                    [:add, 0, 2, 2, none], [:make_closure, 0, 1, none, none]],
           :kids => array.of_list [2, 3], :remap => pools [3] [6], :fo => 10, :go => 7 },
    ];
    let parted = %{ :funcs => [%{ :body => part_base + 0 },
                               %{ :body => 2 * part_base + 0, :n_captures => 2, :captures_off => 0 },
                               %{ :body => 2 * part_base + 5 },
                               %{ :body => part_base + 3 },
                               %{ :body => none }] };
    let filled = %{ 10 => 0 };

    let tests = [
        test.case "the VM shares parts as the walk written here does"
            $( test.eq! (optimize_parts_by_hand parted parts 60 filled)
                        (optimize_parts_filled parted parts 60 filled) ),
        test.case "two copies of a leaf become one node"
            $( test.eq! 1 (list.length (nodes_of two_locals)) ),
        test.case "and both bodies point at it"
            $( test.eq! [0, 0] (bodies_of two_locals) ),

        // The whole point of rebuilding children first: equal subtrees only
        // look equal once their operands have been renumbered.
        test.case "two copies of a subtree become one node"
            $( test.eq! 2 (list.length (nodes_of two_trees)) ),
        test.case "and both bodies point at it"
            $( test.eq! [1, 1] (bodies_of two_trees) ),

        test.case "a node nothing reaches is dropped"
            $( test.eq! 1 (list.length (nodes_of (optimize
                   (image [ir.leaf :unit, ir.node :local 5 ir.no_node ir.no_node] [] [0])))) ),
        test.case "and what is kept is what was reachable"
            $( test.eq! [:unit] (list.map (fn n -> ir.node_op n) (nodes_of (optimize
                   (image [ir.node :local 5 ir.no_node ir.no_node, ir.leaf :unit] [] [1])))) ),

        // Two nodes that differ only in a flag are two nodes: a flag is the
        // compiler's answer to "when does this run?", so sharing across one
        // would move an effect or drop a force.
        test.case "nodes that differ only in a flag are not shared"
            $( test.eq! 2 (list.length (nodes_of (optimize
                   (image [ir.leaf :unit,
                           ir.with_flags ir.f_strict (ir.leaf :unit)] [] [0, 1])))) ),

        // `field` owns an inline cache in the VM, indexed by node.
        test.case "a field is never shared, though what it reads is"
            $( test.eq! 3 (list.length (nodes_of (optimize
                   (image [ir.node :global 3 ir.no_node ir.no_node,
                           ir.node :field 0 7 ir.no_node,
                           ir.node :field 0 7 ir.no_node] [] [1, 2])))) ),

        // The class of mistake that is silent: an operand that is a slot, a
        // function index or a Unicode scalar must be copied, never renumbered.
        test.case "a bind's slot is copied, not renumbered"
            $( test.eq! [5, 0] { let img = optimize (image
                   [ir.leaf :unit, ir.node :bind 5 0 ir.no_node] [] [1]);
                   let b = list.nth 1 (nodes_of img);
                   [ir.node_a b, ir.node_b b] } ),
        test.case "a char's scalar is copied, not renumbered"
            $( test.eq! 955 (ir.node_a (list.head (nodes_of (optimize
                   (image [ir.node :const_char 955 ir.no_node ir.no_node] [] [0]))))) ),
        test.case "a closure's function index is copied, not renumbered"
            $( test.eq! 42 (ir.node_a (list.head (nodes_of (optimize
                   (image [ir.node :make_closure 42 ir.no_node ir.no_node] [] [0]))))) ),

        // A run of children is addressed by offset and count, so two runs that
        // hold the same indices are one run.
        test.case "two identical runs of children become one"
            $( test.eq! [1, 1] { let img = optimize (image
                   [ir.leaf :unit, ir.node :block 0 1 ir.no_node, ir.node :block 1 1 ir.no_node]
                   [0, 0] [1, 2]);
                   [list.length (kids_of img), list.length (nodes_of img) - 1] } ),
        test.case "a run's elements are renumbered with everything else"
            $( test.eq! [0] { let img = optimize (image
                   [ir.node :local 9 ir.no_node ir.no_node, ir.leaf :unit,
                    ir.node :block 1 1 ir.no_node] [9, 0] [2]);
                   kids_of img } ),

        // Captures share the kids pool but are not edges: a descriptor is a
        // slot, or a capture index with the high bit set, read against the
        // defining frame. Dropping them is how the VM comes to say "capture
        // list extends past the kids pool".
        test.case "a capture run survives the rebuild"
            $( test.eq! [7, ir.cap_from_capture + 1] { let img = optimize (with_caps
                   [ir.leaf :unit] [7, ir.cap_from_capture + 1] [0] [[0, 2]]);
                   kids_of img } ),
        test.case "and the function still points at it"
            $( test.eq! [[0, 2]] (caps_of (optimize (with_caps
                   [ir.leaf :unit] [7, ir.cap_from_capture + 1] [0] [[0, 2]]))) ),
        test.case "a function with no captures asks for no run"
            $( test.eq! [[0, 0]] (caps_of (optimize (image [ir.leaf :unit] [] [0]))) ),

        // Nothing is invented and nothing is folded: the pass only ever emits a
        // node lowering already emitted, with its edges renumbered.
        test.case "an arena with nothing to share is unchanged"
            $( test.eq! 3 (list.length (nodes_of (optimize (image
                   [ir.node :local 0 ir.no_node ir.no_node,
                    ir.node :local 1 ir.no_node ir.no_node,
                    ir.node :add 0 1 ir.no_node] [] [2])))) ),
        test.case "an empty program comes out empty"
            $( test.eq! [[], []] { let img = optimize (image [] [] []);
                                   [nodes_of img, kids_of img] } ),
    ];
}
