// Lowering: syntax trees into the execution-tree arena.
//
// By the time this runs, every question about what a name means has been
// answered: `scope` recorded which slot, capture, global or builtin each
// occurrence denotes, where every binder put its value, and what function each
// lambda and thunk became. So this pass decides nothing about naming. It walks
// the same trees a second time and emits nodes, looking up rather than working
// out -- which is why it is mostly a table of shapes.
//
// That split is deliberate. A batch compiler could fuse the two passes and
// often does; keeping them apart means the answers exist as a value that
// something other than the emitter can read -- a language server asking what is
// under the cursor, or a console session resolving one expression against a
// program already loaded.
//
// What is *not* here yet: `comp` and `comp!`, which are evaluated at compile
// time and so need a VM to run them on, and the image writer that turns this
// arena into bytes. Both are their own step.

import std.progress;
import std.atom;
import std.list;
import std.lazy;
import std.map;
import std.str;
import std.macros;

import dreams.ast;
import dreams.builtins;
import dreams.diag;
import dreams.emit;
import dreams.fuse;
import dreams.ir;
import dreams.opt;
import dreams.modules;
import std.tensor;
import std.vm;
import dreams.scope;
import dreams.unit;
import std.array;
import std.char;
import std.types;

// --- the lowering state -----------------------------------------------------
//
// The arena being built, the resolutions being read, and which file the code
// came from, so a diagnostic raised this late still points at a line.

/// The lowering state: the arena being built, and -- once `link!` has run --
/// the finished image and what each `comp` came to.
mapping Lowering {
    r = ()
    prog = ()
    source = 0
    ctx = 0
    diags = []
    // Function index to its lowered body node, including inline lambdas.
    func_bodies = %{}
    // [placeholder node, function, source, span], settled after linking.
    pending_comp = []
    // Read-only slots substituted while emitting a fused loop.
    subst = %{}
    comp_values = %{}
    image = ()
    // Per-part arenas and the values used to patch settled comp placeholders.
    arenas = ()
    invented_from = 0
    filled = %{}
    sharing = ()
}

let lowering : scope.Resolution -> ir.Program -> :integer -> Lowering;
let lowering r p source =
    Lowering.new () |> Lowering.set_r r |> Lowering.set_prog p |> Lowering.set_source source;

let res : Lowering -> scope.Resolution;
let res l    = Lowering.r l;
let prog : Lowering -> ir.Program;
let prog l   = Lowering.prog l;
let source : Lowering -> :integer;
let source l = Lowering.source l;
/// The module whose names this body was resolved against. Not always the module
/// it was written in: a body inherited through `derive` is lowered once per
/// deriving module, and resolves differently each time.
let ctx : Lowering -> :integer;
let ctx l = Lowering.ctx l;
let l_diags : Lowering -> [:map];
let l_diags l = Lowering.diags l;

let set_prog : ir.Program -> Lowering -> Lowering;
let set_prog p l = (l |> Lowering.set_prog p);
let set_res : scope.Resolution -> Lowering -> Lowering;
let set_res r l = (l |> Lowering.set_r r);
let set_source : :integer -> Lowering -> Lowering;
let set_source i l = (l |> Lowering.set_source i);
let set_ctx : :integer -> Lowering -> Lowering;
let set_ctx i l = (l |> Lowering.set_ctx i);

let func_bodies : Lowering -> %{:integer => :integer};
let func_bodies l = Lowering.func_bodies l;
/// The node index is forced before it is stored, for the reason `ir.settled`
/// gives: an unforced one is a thunk holding the frame that would compute it,
/// and that frame holds this state -- which holds the arena as it stood when
/// the function's body was finished. One per function is not many, but it is
/// one *whole arena* apiece.
let set_func_body fi n l =
    if ir.settled n {
        (l |> Lowering.set_func_bodies ((func_bodies l).[fi => n]))
    } else { l };

let subst l = Lowering.subst l;
let set_subst m l = (l |> Lowering.set_subst m);

let pending_comp : Lowering -> [[:any]];
let pending_comp l = Lowering.pending_comp l;
let add_comp node fi span l =
    (l |> Lowering.set_pending_comp (list.append (pending_comp l) [[node, fi, source l, span]]));

/// What each compile-time expression came to, once it has: `[source, start]
/// => value`, keyed the way the checker names a `comp` it meets.
///
/// Kept because a value known at compile time is the best evidence of its
/// type there is, and the checker runs after this pass rather than before it.
/// `typecheck` reads it to give a `comp` the type of what it produced, and to
/// run a refinement's predicate over it -- see "compile-time contracts" there.
/// Nothing in the image depends on it.
let comp_values : Lowering -> :map;
let comp_values l = Lowering.comp_values l;
let comp_key : :integer -> ast.Span -> :integer;
let comp_key source span = source * 4294967296 + ast.span_start span;

let complain span message l =
    (l |> Lowering.set_diags (list.append (l_diags l) [diag.in_source (source l) (diag.error span message)]));

let warn span message note l =
    (l |> Lowering.set_diags (list.append (l_diags l)
                     [diag.in_source (source l) (diag.with_note note (diag.warning span message))]));

/// Emit a node: `[lowering, index]`.
let emit : ir.Node -> Lowering -> [Lowering, :integer];
let emit n l = {
    let [program, index] = ir.push_node n (prog l);
    [set_prog program l, index]
};

let emit_leaf : :atom -> Lowering -> [Lowering, :integer];
let emit_leaf op l = emit (ir.leaf op) l;

let kids : [:any] -> Lowering -> [Lowering, :integer];
let kids xs l = {
    let [program, offset] = ir.push_kids xs (prog l);
    [set_prog program l, offset]
};

let set_flag i f l = set_prog (ir.set_node_flag i f (prog l)) l;

let is_impure_node i l = ir.node_is_impure (ir.node_at i (prog l));

/// Effects are visible through any enclosing node, so the flag travels up.
let inherit i children l =
    if ir.has_impure (prog l) && any_impure children (prog l) { set_flag i ir.f_impure l }
    else { l };

let rec any_impure ks p = match ks {
    [] => false,
    [k, ..rest] => (ir.is_node k && ir.node_is_impure (ir.node_at k p)) || any_impure rest p,
};

/// What `scope` recorded for the name at this span.
let lookup span l = scope.resolution (res l) (ctx l) (source l) span;

/// The slot a binder at this span was given.
let slot_at span l =
    expand macros.with_some binding (scope.binding (res l) (ctx l) (source l) span)
        (list.nth 1 binding);

// --- constants ----------------------------------------------------------------

/// An integer constant: a `KINT` entry when it is a fixnum, which is every
/// integer a program is likely to write.
///
/// One that is not -- a literal past 2^62, or a compile-time value that grew
/// into a bignum -- has no `i64` to be, so it is written as its digits and read
/// back by `_parse_int` where it is used. That keeps the image format what it
/// was, at the price of a parse each time the expression is evaluated, which a
/// literal at the top of a definition pays once. The lower bound is spelled as
/// arithmetic because it was written before a seed that could read it as a
/// literal existed.
let const_int : :integer -> Lowering -> [Lowering, :integer];
let const_int v l =
    if v > 4611686018427387903 || v < 0 - 4611686018427387903 - 1 {
        let [l1, digits] = const_str (to_string v) l;
        call_builtin "_parse_int" [digits] l1
    } else {
        let [program, index] = ir.intern_int v (prog l);
        emit (ir.node :const_int index ir.no_node ir.no_node) (set_prog program l)
    };

let const_float : :float -> Lowering -> [Lowering, :integer];
let const_float v l = {
    let [program, index] = ir.intern_float v (prog l);
    emit (ir.node :const_float index ir.no_node ir.no_node) (set_prog program l)
};

let const_str : :string -> Lowering -> [Lowering, :integer];
let const_str v l = {
    let [program, index] = ir.intern_str v (prog l);
    emit (ir.node :const_str index ir.no_node ir.no_node) (set_prog program l)
};

let const_atom : :string -> Lowering -> [Lowering, :integer];
let const_atom v l = {
    let [program, index] = ir.intern_atom v (prog l);
    emit (ir.node :const_atom index ir.no_node ir.no_node) (set_prog program l)
};

let const_char : :char -> Lowering -> [Lowering, :integer];
let const_char c l = emit (ir.node :const_char (char.code c) ir.no_node ir.no_node) l;
let const_bool : :bool -> Lowering -> [Lowering, :integer];
let const_bool b l = emit (ir.node :const_bool (if b { 1 } else { 0 }) ir.no_node ir.no_node) l;

// --- calls ----------------------------------------------------------------------

/// `f a b` is one node with two arguments, not two nested calls: currying is the
/// language's story about partial application, not the VM's about call frames.
let emit_apply : :integer -> [:integer] -> Lowering -> [Lowering, :integer];
let emit_apply callee args l = {
    let placed = kids args l;
    let made = emit (ir.node :apply callee (list.nth 1 placed) (list.length args))
                    (list.head placed);
    let i = list.nth 1 made;
    let inherited = inherit i (list.cons callee args) (list.head made);
    // Calling an impure value is itself an effect, and the callee has to be
    // forced where it stands for that effect to happen in written order.
    let sequenced =
        if is_impure_node callee inherited {
            set_flag callee ir.f_strict (set_flag i ir.f_impure inherited)
        }
        else { inherited };
    [sequenced, i]
};

/// An ordinary call: a saturated call of a wrapper is the call it stands for.
/// See "wrappers" in `scope` -- the rewrite removes a frame that bound nothing
/// but the arguments the inner call was going to get.
let lower_apply : ast.Expr -> [ast.Expr] -> ast.Span -> Lowering -> [Lowering, :integer];
let lower_apply callee args span l = {
    let found = callee_resolution callee l;
    match [found, args] {
        [scope.Meaning.builtin("defer!"), _] =>
            emit_leaf :unit (complain span "`defer!` needs one expression and must be a block statement" l),
        // A record, as its constructor writes it: one `record_make`, and no
        // array of fields made only to be copied out of.
        [scope.Meaning.builtin("_record_of"), [[:atom, id, _], [:bool, variant, _], [:array, fields, _]]] =>
            lower_record id variant fields l,
        _ => lower_call found callee args span l,
    }
};

let lower_call found callee args span l =
    match unwrap found args 8 l {
        // ..and a wrapper around a `get` or a `set` is that operation.
        [scope.Inline.op(kind), actual] => lower_expr (op_expr kind actual span) l,
        // A constructor whose fields are all lazy is the record it makes; one
        // with a strict field is called, so its frame forces the field.
        [scope.Inline.record(id, variant, true, _), actual] => lower_record id variant actual l,
        [scope.Inline.record(_, _, false, _), _] => {
            let f = lower_callee callee found l;
            let done = lower_all args (list.head f);
            emit_apply (list.nth 1 f) (list.nth 1 done) (list.head done)
        },
        [target, actual] => {
            let f = emit_target target l;
            let done = lower_all actual (list.head f);
            emit_apply (list.nth 1 f) (list.nth 1 done) (list.head done)
        },
        _ => {
            let f = lower_callee callee found l;
            let done = lower_all args (list.head f);
            emit_apply (list.nth 1 f) (list.nth 1 done) (list.head done)
        },
    };

/// `record_make`: the fields, each in a lazy position, and the id as an atom
/// of the image, with the top bit of `c` saying whether it names a variant.
/// See `RecordMake` in dream/src/image.hpp.
let lower_record : :string -> :bool -> [ast.Expr] -> Lowering -> [Lowering, :integer];
let lower_record id variant fields l = {
    let done = lower_all fields l;
    let placed = kids (list.nth 1 done) (list.head done);
    let [program, index] = ir.intern_atom id (prog (list.head placed));
    let c = if variant { index + ir.record_variant } else { index };
    let made = emit (ir.node :record_make (list.nth 1 placed) (list.length fields) c)
                    (set_prog program (list.head placed));
    [inherit (list.nth 1 made) (list.nth 1 done) (list.head made), list.nth 1 made]
};

/// What the constructor a pattern names makes: `[id, variant, arity]`, or
/// `()` when it names no constructor. Read from the resolver's wrappers,
/// where every constructor is filed with the id it stamps (`scope.wrapper_of`).
let constructor_of ctor l =
    match callee_resolution ctor l {
        scope.Meaning.global(_, _, g) => constructor_at g l,
        scope.Meaning.member(scope.Ref.dream(_), _, g) => constructor_at g l,
        _ => (),
    };

let constructor_at g l =
    match (scope.wrappers (res l)).[g else ()] {
        scope.Wrapper(scope.Inline.record(id, variant, _, fields), _, _) => [id, variant, fields],
        _ => (),
    };

let builtin_ref name l =
    match builtins.id name {
        () => emit_leaf :unit l,
        b  => emit (ir.node :builtin b ir.no_node ir.no_node) l,
    };

let call_builtin name args l = {
    let got = builtin_ref name l;
    emit_apply (list.nth 1 got) args (list.head got)
};

let binary op a b l = {
    let made = emit (ir.node op a b ir.no_node) l;
    [inherit (list.nth 1 made) [a, b] (list.head made), list.nth 1 made]
};

let bool_and a b l = binary :and a b l;
let eq_const v k l = binary :eq v k l;

// --- names ----------------------------------------------------------------------

// --- wrappers ---------------------------------------------------------------------
//
// `scope` worked out which globals are wrappers -- one application of their own
// parameters and literals, and nothing else. Here a saturated call of one
// becomes the call it stands for, which removes a frame and a call per use.
// Chained wrappers unwrap together: `at_end` is `list.is_empty` is
// `_list_is_empty`, and a call of the first emits the last.
//
// The depth cap is not a guess about how deep a chain goes -- two wrappers that
// name each other would unwrap forever, and a compiler must terminate on a
// program that will not run.

/// What the callee of an application resolves to, when it is a name at all.
let callee_resolution callee l =
    match callee {
        [:name, _, span]     => lookup span l,
        [:field, _, field, span] =>
            // As in `lower_field`, the dotted span may resolve to the base
            // value rather than the member -- a field of a value is not a
            // callee resolution, and a call of one must lower as an ordinary
            // expression (and must not be taken for a wrapper's target).
            match lookup span l {
                () => (),
                found => if resolved_name found == field { found } else { () },
            },
        _ => (),
    };

/// The call site's arguments, rebuilt as the wrapper's body arranged them.
let wrapper_actuals plan args =
    list.map (fn step ->
        match step {
            scope.Arg.param(k) => list.nth k args,
            scope.Arg.constant(e) => e,
        }) plan;

/// The container operation a wrapper stands for, rebuilt around a call's own
/// arguments. They are syntax rather than nodes, so each is lowered exactly
/// where it would have been -- the same promise the call rewrite makes.
let op_expr kind operands span =
    match kind {
        :get => ast.get_e (list.nth 0 operands) (list.nth 1 operands)
                          (if list.length operands > 2 { list.nth 2 operands } else { () }) span,
        _    => ast.set_e (list.nth 0 operands) (list.nth 1 operands) (list.nth 2 operands) span,
    };

/// `[target, arguments]` when this is a saturated call of a wrapper, or `()`.
///
/// The arguments are syntax, not nodes: they are lowered at the call site
/// exactly as they would have been, which is what keeps every one of them the
/// same thunk in the same place.
let rec unwrap found args fuel l =
    if fuel <= 0 { () }
    else {
        match found {
            scope.Meaning.global(_, _, g) => unwrap_global found g args fuel l,
            scope.Meaning.member(scope.Ref.dream(_), _, g) => unwrap_global found g args fuel l,
            _ => (),
        }
    };

let unwrap_global found g args fuel l =
    match (scope.wrappers (res l)).[g else ()] {
        () => (),
        scope.Wrapper(target, plan, arity) =>
            if list.length args != arity { () }
            else {
                let actual = wrapper_actuals plan args;
                // The target may be a wrapper too, and unwrapping stops at
                // whatever is not one -- which is the answer either way.
                match unwrap target actual (fuel - 1) l {
                    () => [target, actual],
                    deeper => deeper,
                }
            },
    };

/// A wrapper named as a value rather than called -- `list.map char.of_code
/// cs` -- is the builtin it wraps, when it passes its parameters on unchanged
/// and in order. Calling the value then reaches the builtin directly, where
/// it would otherwise make a frame per call to do nothing but call it, which
/// is the cost the rewrite above removes from a call and would leave on every
/// element of a `map`.
///
/// Narrower than the call rewrite on purpose. A builtin has a fixed arity and
/// so does a wrapper of it with the same parameters, so the two values take
/// the same arguments and do the same thing with them. A reordering, a
/// literal, or a target that is another Dream function would each need a
/// value of their own, and are left as the wrapper. Only a bare reference is
/// rewritten: a call of a wrapper with too few or too many arguments still
/// calls the wrapper.
let as_value found l =
    match builtin_alias found 8 l {
        () => found,
        b  => b,
    };

let rec builtin_alias found fuel l =
    if fuel <= 0 { () }
    else {
        match found {
            scope.Meaning.builtin(_) => found,
            scope.Meaning.global(_, _, g) => builtin_alias_global g fuel l,
            scope.Meaning.member(scope.Ref.dream(_), _, g) => builtin_alias_global g fuel l,
            _ => (),
        }
    };

let builtin_alias_global g fuel l =
    match (scope.wrappers (res l)).[g else ()] {
        scope.Wrapper(target, plan, arity) =>
            if plan == scope.passed_on arity {
                builtin_alias target (fuel - 1) l
            } else { () },
        _ => (),
    };

/// The callee of an application, given what it resolved to. A name or a member
/// whose resolution is already in hand skips the second lookup; anything else
/// is an ordinary expression.
let lower_callee callee found l =
    match callee {
        [:name, n, span] =>
            match found { () => lower_expr callee l, _ => lower_resolved n found span l },
        [:field, _, field, span] =>
            match found {
                () => lower_expr callee l,
                _ =>
                    // A resolution naming the base rather than the field is
                    // nothing to do with a callee; the call is ordinary.
                    if resolved_name found == field { lower_resolved field found span l }
                    else { lower_expr callee l },
            },
        _ => lower_expr callee l,
    };

/// The node for a wrapper's target, marked impure when the name it ends in
/// says so -- the same rule `lower_name` applies to a name written by hand.
let emit_target found l = {
    let got = emit_resolution found l;
    if builtins.is_impure_name (resolved_name found) {
        [set_flag (list.nth 1 got) ir.f_impure (list.head got), list.nth 1 got]
    }
    else { got }
};

/// The name a resolution ends in, which is what says whether it is impure.
let resolved_name found =
    match found {
        scope.Meaning.builtin(name) => name,
        scope.Meaning.global(_, name, _) => name,
        scope.Meaning.member(_, field, _) => field,
        _ => "",
    };

/// A name, as `scope` already decided it. The only work left is which node
/// shape carries the answer -- and marking it impure when the name says so, so
/// that the VM sequences the effect rather than only the compiler knowing about
/// it. `scope` refused the pure functions that reach an effect; this records
/// which nodes *are* one.
let lower_name name span l = lower_resolved name (as_value (lookup span l) l) span l;

/// The same, for a caller that has already asked what the name resolves to.
/// Applications ask, because a call of a wrapper is rewritten and one that is
/// not should not pay for the question twice.
let lower_resolved name found span l = {
    let got = emit_resolution_or found span l;
    if builtins.is_impure_name name {
        [set_flag (list.nth 1 got) ir.f_impure (list.head got), list.nth 1 got]
    }
    else { got }
};

let emit_name span l = emit_resolution (lookup span l) l;

/// A local, or -- when nothing ever writes that slot -- the expression it
/// stands for, lowered here. The slot is taken out of the substitution while
/// its own expression is lowered, so a table that somehow named itself would
/// stop rather than spin; nothing builds one, and a compiler must terminate on
/// a program that will not run.
let emit_local slot l =
    match (subst l).[slot else ()] {
        () => emit (ir.node :local slot ir.no_node ir.no_node) l,
        e  => {
            let got = lower_expr e (set_subst (map.remove slot (subst l)) l);
            [set_subst (subst l) (list.head got), list.nth 1 got]
        },
    };

/// A recorded resolution, or -- when there is none -- whatever `emit_resolution`
/// makes of that, which is the same unit placeholder it always was.
let emit_resolution_or found span l = emit_resolution found l;

/// One resolution, as the node that fetches it. Separate from `emit_name`
/// because a wrapper's call site emits a resolution it did not read off a name.
let emit_resolution found l =
    match found {
        scope.Meaning.local(slot, _) => emit_local slot l,
        scope.Meaning.capture(idx, _) => emit (ir.node :capture idx ir.no_node ir.no_node) l,
        scope.Meaning.global(_, _, g) => emit (ir.node :global g ir.no_node ir.no_node) l,
        scope.Meaning.builtin(name) => builtin_ref name l,
        scope.Meaning.closure(fi) => emit (ir.node :make_closure fi ir.no_node ir.no_node) l,
        scope.Meaning.thunk(fi) => emit (ir.node :make_thunk fi ir.no_node ir.no_node) l,
        // A Dream module's member is one global, known at compile time. A host
        // module's is a field of the module value, looked up at run time,
        // because the host owns the table.
        scope.Meaning.member(scope.Ref.dream(_), _, g) => emit (ir.node :global g ir.no_node ir.no_node) l,
        scope.Meaning.member(scope.Ref.native(_, mg), field, _) => {
            let obj = emit (ir.node :global mg ir.no_node ir.no_node) l;
            let named = ir.intern_str field (prog (list.head obj));
            emit (ir.node :field (list.nth 1 obj) (list.nth 1 named) ir.no_node)
                 (set_prog (list.head named) (list.head obj))
        },
        // Resolution already complained; a unit keeps the arena well formed so
        // the rest of the program still lowers and every error is reported at
        // once rather than one per run.
        _ => emit_leaf :unit l,
    };

// --- expressions -----------------------------------------------------------------

/// The resolver reserves one scratch slot for each saturated prelude member.
/// Identity comes from its resolved global, so a user's `Result.map` is left
/// alone. Partial applications keep their ordinary call frames.
let result_call e l = match e {
    [:pipe, x, rhs, sp] => match rhs {
        [:apply, f, args, _] => result_call (ast.apply_e f (list.append args [x]) sp) l,
        _ => result_call (ast.apply_e rhs [x] sp) l,
    },
    [:apply, f, args, sp] => {
        let g = match callee_resolution f l {
            scope.Meaning.global(_, _, gi) => gi,
            scope.Meaning.member(scope.Ref.dream(_), _, gi) => gi,
            _ => (),
        };
        let slot = scope.result_slot (res l) (ctx l) (source l) (ast.span f);
        match (scope.Resolution.result_roles (res l)).[g else ()] {
            [kind, tag, arity] if list.length args == arity && slot != () =>
                [kind, tag, args, slot],
            _ => (),
        }
    },
    _ => (),
};

let result_id kind ok = "std.prelude." + kind + "." +
    if kind == "Result" { if ok { "ok" } else { "error" } }
    else { if ok { "some" } else { "none" } };

let node_block nodes l = {
    let placed = kids nodes l;
    let made = emit (ir.node :block (list.nth 1 placed) (list.length nodes) ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) nodes (list.head made), list.nth 1 made]
};

let node_if cond yes no l = {
    let made = emit (ir.node :if cond yes no) l;
    [inherit (list.nth 1 made) [cond, yes, no] (list.head made), list.nth 1 made]
};

/// Peel maps of this union into each region. A stage that can choose another
/// variant starts a new region, so its following stages are emitted once.
/// A stage is [tag, argument node (or absent), scratch slot].
let rec lower_result_chain e kind stages l = match result_call e l {
    [k, tag, args, slot] if k == kind && (list.is_empty stages || fuse.result_maps tag) => {
        let argument = if list.length args == 1 { [l, ir.no_node] }
                       else { lower_expr (list.head args) l };
        lower_result_chain (list.last args) kind
            (list.cons [tag, list.nth 1 argument, slot] stages) (list.head argument)
    },
    _ => {
        let value = lower_expr e l;
        result_branch (list.nth 1 value) kind stages
                      (list.nth 2 (list.head stages)) (list.head value)
    },
};

/// Evaluate a union once, checking both ids just as the original match did.
let rec result_branch value kind stages slot l = {
    let bound = emit (ir.node :bind slot value ir.no_node) l;
    let sequenced = set_flag (list.nth 1 bound) ir.f_strict (inherit (list.nth 1 bound) [value] (list.head bound));
    let local = emit (ir.node :local slot ir.no_node ir.no_node) sequenced;
    let self = list.nth 1 local;
    let index = const_int 0 (list.head local);
    let payload = call_builtin "_match_at" [self, list.nth 1 index] (list.head index);
    let yes = result_continue kind true (list.nth 1 payload) self stages (list.head payload);
    let no = result_continue kind false (list.nth 1 payload) self stages (list.head yes);
    let good_id = const_atom (result_id kind true) (list.head no);
    let good = call_builtin "_record_is" [list.nth 1 good_id, self] (list.head good_id);
    let bad_id = const_atom (result_id kind false) (list.head good);
    let bad = call_builtin "_record_is" [list.nth 1 bad_id, self] (list.head bad_id);
    let failure = match_failure self [0, 0] (list.head bad);
    let checked = node_if (list.nth 1 bad) (list.nth 1 no) (list.nth 1 failure) (list.head failure);
    let branch = node_if (list.nth 1 good) (list.nth 1 yes) (list.nth 1 checked) (list.head checked);
    node_block [list.nth 1 bound, list.nth 1 branch] (list.head branch)
};

/// `original` is the whole union when no mapping has changed its payload.
/// Passing that node through preserves the input record on either untouched
/// branch, including the differently typed failure of `Result.map`.
let rec result_continue kind ok payload original stages l = match stages {
    [] => if ir.is_node original { [l, original] } else {
        let placed = kids (if kind == "Option" && not ok { [] } else { [payload] }) l;
        let [program, id] = ir.intern_atom (result_id kind ok) (prog (list.head placed));
        emit (ir.node :record_make (list.nth 1 placed) (if kind == "Option" && not ok { 0 } else { 1 })
                     (id + ir.record_variant)) (set_prog program (list.head placed))
    },
    [[tag, arg, slot], ..rest] => match tag {
        :map => if ok {
            let mapped = emit_apply arg [payload] l;
            result_continue kind ok (list.nth 1 mapped) ir.no_node rest (list.head mapped)
        } else { result_continue kind ok payload original rest l },
        :map_error => if not ok {
            let mapped = emit_apply arg [payload] l;
            result_continue kind ok (list.nth 1 mapped) ir.no_node rest (list.head mapped)
        } else { result_continue kind ok payload original rest l },
        :and_then => if ok {
            let next = emit_apply arg [payload] l;
            if list.is_empty rest { next }
            else { result_branch (list.nth 1 next) kind rest (list.nth 2 (list.head rest)) (list.head next) }
        } else { result_continue kind ok payload original rest l },
        :and => if ok {
            if list.is_empty rest { [l, arg] } else { result_branch arg kind rest (list.nth 2 (list.head rest)) l }
        } else { result_continue kind ok payload original rest l },
        :or_else => if not ok {
            let argument = if kind == "Result" { [l, payload] } else { emit_leaf :unit l };
            let next = emit_apply arg [list.nth 1 argument] (list.head argument);
            if list.is_empty rest { next }
            else { result_branch (list.nth 1 next) kind rest (list.nth 2 (list.head rest)) (list.head next) }
        } else { result_continue kind ok payload original rest l },
        :otherwise => if not ok {
            if list.is_empty rest { [l, arg] } else { result_branch arg kind rest (list.nth 2 (list.head rest)) l }
        } else { result_continue kind ok payload original rest l },
        :flatten => if ok {
            if list.is_empty rest { [l, payload] } else { result_branch payload kind rest (list.nth 2 (list.head rest)) l }
        } else { result_continue kind ok payload original rest l },
        :unwrap_or => [l, if ok { payload } else { arg }],
        :unwrap_or_else => if ok { [l, payload] }
            else if kind == "Result" { emit_apply arg [payload] l }
            else {
                let unit = emit_leaf :unit l;
                emit_apply arg [list.nth 1 unit] (list.head unit)
            },
        _ => result_continue kind ok payload original rest l,
    },
};

let lower_expr : ast.Expr -> Lowering -> [Lowering, :integer];
let rec lower_expr e l =
    match e {
        [:int, v, _]   => const_int v l,
        [:float, v, _] => const_float v l,
        [:str, v, _]   => const_str v l,
        [:char, c, _]  => const_char c l,
        [:bool, b, _]  => const_bool b l,
        [:atom, n, _]  => const_atom n l,
        [:unit, _]     => emit_leaf :unit l,

        // A name `scope` staged stands for the stage that was bound to it and
        // read here once. The `let` that bound it is gone from the block
        // below, so this is the only place the body is written -- which is the
        // whole of what staging does when the pipeline turns out not to fuse.
        [:name, n, span] =>
            match scope.staging (res l) (ctx l) (source l) span {
                scope.Staging.body(body) => lower_expr body l,
                _ => lower_name n span l,
            },
        [:field, _, _, span] => lower_field e span l,

        // A pipeline `scope` decided to fuse is a loop and a call of it, and
        // neither the producer nor the consumer is called at all. Asked first,
        // because everything below is about a call that still happens.
        [:apply, callee, args, span] =>
            match scope.fusion (res l) (ctx l) (source l) span {
                () => match result_call e l {
                    () => lower_apply callee args span l,
                    [kind, _, _, _] => lower_result_chain e kind [] l,
                },
                p  => lower_fused p l,
            },

        // `x |> f a` is folded into the single call `f a x` rather than a call
        // of a call. That is what lets a variadic host function take everything
        // at the call site, which a nested application would split up.
        [:pipe, lhs, rhs, span] =>
            match rhs {
                [:apply, callee, args, _] =>
                    lower_expr (ast.apply_e callee (list.append args [lhs]) span) l,
                _ => lower_expr (ast.apply_e rhs [lhs] span) l,
            },

        // An interpolated string is the `str_interp` opcode over the list of
        // its pieces (`ast.interp_e`), emitted directly, as `::` is `:cons`.
        [:unary, :interp, x, _] => {
            let a = lower_expr x l;
            let placed = kids [list.nth 1 a] (list.head a);
            let made = emit (ir.node :str_interp (builtins.id "_str_interp") (list.nth 1 placed) 1)
                            (list.head placed);
            [inherit (list.nth 1 made) [list.nth 1 a] (list.head made), list.nth 1 made]
        },

        // `:neg` and `:not` are what the parser already calls them, and what
        // the arena calls them, so there is nothing to translate.
        [:unary, op, x, _] => {
            let a = lower_expr x l;
            binary op (list.nth 1 a) ir.no_node (list.head a)
        },

        // Every binary operator is the arena's operator of the same name, and
        // that includes `x :: xs`: `:cons` is the cell the `list.cons` builtin
        // is rewritten into by `opt`, written here directly.
        [:binary, op, lhs, rhs, _] => {
            let a = lower_expr lhs l;
            let b = lower_expr rhs (list.head a);
            binary op (list.nth 1 a) (list.nth 1 b) (list.head b)
        },

        [:if, cond, t, el, _] => {
            let c = lower_expr cond l;
            let a = lower_expr t (list.head c);
            let b = match el {
                () => emit_leaf :unit (list.head a),
                x  => lower_expr x (list.head a),
            };
            let made = emit (ir.node :if (list.nth 1 c) (list.nth 1 a) (list.nth 1 b))
                            (list.head b);
            // The condition decides which branch runs, so it is forced here
            // rather than wherever its value happens to be wanted.
            [set_flag (list.nth 1 c) ir.f_strict
                (inherit (list.nth 1 made) [list.nth 1 c, list.nth 1 a, list.nth 1 b]
                         (list.head made)),
             list.nth 1 made]
        },

        [:block, stmts, span] => lower_block stmts span l,

        // A lambda and a thunk are functions `scope` already numbered. Their
        // bodies are lowered here, into the same arena as everything else --
        // a function is a body node and a descriptor, not a separate arena --
        // and what is emitted in their place is the instruction that makes one
        // at run time.
        [:lambda, ps, body, span] => lower_function span :make_closure ps body l,
        [:thunk, body, span] => lower_function span :make_thunk [] body l,

        [:try, body, _, handler, span] => {
            let b = lower_expr body l;
            let h = lower_expr handler (list.head b);
            let held = expand macros.coalesce (slot_at span (list.head h)) 0;
            let made = emit (ir.node :try (list.nth 1 b) (list.nth 1 h) held) (list.head h);
            [inherit (list.nth 1 made) [list.nth 1 b, list.nth 1 h] (list.head made),
             list.nth 1 made]
        },

        [:list, xs, _]  => lower_seq :make_list xs l,
        [:array, xs, _] => lower_seq :make_array xs l,
        [:map, pairs, _] =>
            lower_seq :make_map
                      (list.concat (map (fn kv -> [list.nth 0 kv, list.nth 1 kv]) pairs))
                      l,

        [:match, scrutinee, arms, span] => lower_match scrutinee arms span l,

        // `comp` and `comp!` are evaluated before the program runs, which means
        // running them -- so the expression is lowered into a function of its
        // own and a placeholder is left where its value will go. What it comes
        // to is not known until the whole program has been built, because the
        // expression may call any of it.
        [:comp, _, body, span] =>
            match lookup span l {
                scope.Meaning.compiled(fi, _) => {
                    // A function of its own, so none of a fused loop's
                    // substitution applies in it (see `lower_function`).
                    let inner = lower_expr body (set_subst %{} l);
                    let done = set_subst (subst l)
                                   (set_func_body fi (list.nth 1 inner)
                                                  (mark_tail (list.nth 1 inner) (list.head inner)));
                    // The placeholder carries the function it waits on. A
                    // bare `unit` would be shared with every other `unit` by
                    // the optimizer, and a program lowered in parts is
                    // optimized before its expressions are settled -- see
                    // "lowering in parts" -- so the one written here has to
                    // stay itself and be findable afterwards.
                    let made = emit (ir.node :unit fi ir.no_node ir.no_node) done;
                    [add_comp (list.nth 1 made) fi span (list.head made), list.nth 1 made]
                },
                _ => emit_leaf :unit l,
            },

        // The element a fused loop over a list or an array is at -- never
        // written, only substituted for the slot it stands in (see "a list or
        // an array as the source" in `fuse`).
        [:fused_element, tag] => fused_element tag l,

        // A container read or changed at a key. A `get`'s fallback is lowered
        // where it is written and only evaluated when the key is missing; a
        // `set`'s value is stored unforced, as a map literal's values are.
        [:get, container, key, fallback, _] => {
            let a = lower_expr container l;
            let b = lower_expr key (list.head a);
            let f = match fallback {
                () => [list.head b, ir.no_node],
                x  => lower_expr x (list.head b),
            };
            let made = emit (ir.node :get (list.nth 1 a) (list.nth 1 b) (list.nth 1 f)) (list.head f);
            [inherit (list.nth 1 made) [list.nth 1 a, list.nth 1 b, list.nth 1 f] (list.head made),
             list.nth 1 made]
        },
        [:set, container, key, value, _] => {
            let a = lower_expr container l;
            let b = lower_expr key (list.head a);
            let v = lower_expr value (list.head b);
            fuse_set (list.nth 1 a) (list.nth 1 b) (list.nth 1 v) (list.head v)
        },

        // What a top-level destructuring became in `scope`: the hidden global
        // holding the checked value, and a global per name.
        [:destructure, pattern, body, span] => lower_destructure pattern body span l,
        [:destructured, hidden, pattern, name_span] => lower_destructured hidden pattern name_span l,

        _ => emit_leaf :unit l,
    };

/// `c.[k => v]`, given the three as nodes -- or, when `c` is itself a change at
/// a constant key and `k` is a constant too, one `set_many` of every pair.
///
/// This is what a pipeline of setters comes to: `P.set_x` is a wrapper, so
/// `p |> P.set_a 1 |> P.set_b 2` lowers to `set (set p 0 1) 1 2`, and each
/// `set` copied the whole record for one field. The chain is fused here, as it
/// is lowered, because only here are the inner node's parts still in hand to be
/// laid out as one run of kids; the inner `set` is left behind unreached, and
/// the optimizer drops it.
///
/// Fusing never costs more than it saves. A node is a function of the frame it
/// is evaluated against, so an inner `set` some other expression wants as well
/// is evaluated there on its own account either way; what is shared between two
/// uses is a binding, which is a `local` and never fused through. The keys
/// must be constants so that the order in which they are read, and which one
/// raises, cannot differ from the chain's.
let fuse_set : :integer -> :integer -> :integer -> Lowering -> [Lowering, :integer];
let fuse_set c k v l = {
    let p = prog l;
    let inner = ir.node_at c p;
    let earlier = if not (constant_key k p) { () } else {
        match ir.node_op inner {
            :set if constant_key (ir.node_b inner) p => [ir.node_b inner, ir.node_c inner],
            :set_many => map (fn i -> (ir.kids p).[ir.node_b inner + i])
                                  (list.range 0 (2 * ir.node_c inner)),
            _ => (),
        }
    };
    match earlier {
        () => {
            let made = emit (ir.node :set c k v) l;
            [inherit (list.nth 1 made) [c, k, v] (list.head made), list.nth 1 made]
        },
        pairs => {
            let base = ir.node_a inner;
            let items = pairs + [k, v];
            let placed = kids items l;
            let made = emit (ir.node :set_many base (list.nth 1 placed) (list.length items / 2))
                            (list.head placed);
            [inherit (list.nth 1 made) (list.cons base items) (list.head made), list.nth 1 made]
        },
    }
};

/// Whether node `i` is a key `set_many` may hold: an int or atom constant.
let constant_key : :integer -> ir.Program -> :bool;
let constant_key i p = match ir.node_op (ir.node_at i p) {
    :const_int => true,
    :const_atom => true,
    _ => false,
};

/// A nested function: lower its body, remember which node that was, and emit
/// the instruction that builds the closure or thunk.
let rec lower_function span op ps body l =
    match function_at (lookup span l) {
        () => emit_leaf :unit l,
        fi => {
            // A function of its own has a frame of its own, numbered from
            // zero like every frame: a fused loop's substitution is about the
            // loop's slots, and a slot of the same number in here is another
            // slot. What the function needs of the loop it captured, and a
            // loop whose substituted slot is captured is never fused
            // (`scope.captures_substituted`).
            let inner = lower_body ps body (set_subst %{} l);
            let done = set_subst (subst l)
                           (set_func_body fi (list.nth 1 inner)
                                          (mark_tail (list.nth 1 inner) (list.head inner)));
            let made = emit (ir.node op fi ir.no_node ir.no_node) done;
            // Suspending an effect is not performing one, so a thunk is a pure
            // value -- unless what it suspends is effectful, in which case
            // whoever forces it is performing that effect and needs to know.
            if is_impure_node (list.nth 1 inner) done {
                [set_flag (list.nth 1 made) ir.f_impure (list.head made), list.nth 1 made]
            }
            else { made }
        },
    };

/// The function a closure or a thunk was resolved to, or `()`.
let function_at found = match found {
    scope.Meaning.closure(fi) => fi,
    scope.Meaning.thunk(fi) => fi,
    _ => (),
};

/// A function's body, with its strict parameters forced and its pattern
/// parameters taken apart in front of it.
///
/// A strict parameter is a strict statement reading its slot, first and in
/// parameter order: a block evaluates a strict non-final statement, and
/// evaluating a `local` forces what is in it. So the function is strict in
/// that parameter on every path, which is also exactly what the JIT's
/// admission test asks (`Analyzer::strict_of` counts strict statements).
///
/// Such a parameter's argument arrives in its slot like any other -- a function's
/// parameters are its first slots, in order -- and its names are bound out of
/// that slot before the body runs. They are bound lazily, as a destructuring
/// `let` binds them, so naming an argument's parts makes a function no stricter
/// in it.
let lower_body ps body l =
    if not (list.any (fn p -> has_pattern p || ast.param_strict p) ps) { lower_expr body l }
    else {
        let forced = fold (fn acc pair ->
            if not (ast.param_strict (list.nth 0 pair)) { acc }
            else {
                let read = emit (ir.node :local (list.nth 1 pair) ir.no_node ir.no_node) (list.head acc);
                [set_flag (list.nth 1 read) ir.f_strict (list.head read),
                 list.append (list.nth 1 acc) [list.nth 1 read]]
            }) [l, []] (list.zip ps (list.range 0 (list.length ps)));
        let bound = fold (fn acc pair ->
            match ast.param_pattern (list.nth 0 pair) {
                () => acc,
                pattern => {
                    let arg = emit (ir.node :local (list.nth 1 pair) ir.no_node ir.no_node) (list.head acc);
                    let parts = destructure pattern (list.nth 1 arg) (list.head arg);
                    [list.head parts, list.append (list.nth 1 acc) (list.nth 1 parts)]
                },
            }) [list.head forced, list.nth 1 forced] (list.zip ps (list.range 0 (list.length ps)));
        let inner = lower_expr body (list.head bound);
        let stmts = list.append (list.nth 1 bound) [list.nth 1 inner];
        let placed = kids stmts (list.head inner);
        let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node)
                        (list.head placed);
        [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
    };

let has_pattern p = match ast.param_pattern p { () => false, _ => true };

/// Lower a list of expressions, keeping their order: `[lowering, indices]`.
let rec lower_all es l =
    list.fold (fn acc e -> {
        let got = lower_expr e (list.head acc);
        [list.head got, list.append (list.nth 1 acc) [list.nth 1 got]]
    }) [l, []] es;

let rec lower_seq op items l = {
    let done = lower_all items l;
    let placed = kids (list.nth 1 done) (list.head done);
    let n = if op == :make_map { list.length items / 2 } else { list.length items };
    let made = emit (ir.node op (list.nth 1 placed) n ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) (list.nth 1 done) (list.head made), list.nth 1 made]
};

/// A runtime field read: the object is a value and the field is looked up on
/// it when the program runs.
let lower_value_field obj field l = {
    let o = lower_expr obj l;
    let named = ir.intern_str field (prog (list.head o));
    let made = emit (ir.node :field (list.nth 1 o) (list.nth 1 named) ir.no_node)
                    (set_prog (list.head named) (list.head o));
    [inherit (list.nth 1 made) [list.nth 1 o] (list.head made), list.nth 1 made]
};

/// A module member written with a dot. When the object is a namespace the whole
/// thing is one name, already resolved; otherwise it is a field of a value.
///
/// The field node's span begins where the base name's does -- the parser widens
/// the primary's span over the dotted name -- so the lookup above may answer
/// the *base's* resolution rather than the member's. Only a namespace member's
/// resolution names the field it ends in; a resolution naming anything else is
/// the base value leaking through, and the field is read at run time.
let rec lower_field e span l =
    match lookup span l {
        () =>
            match e {
                [:field, obj, field, _] => lower_value_field obj field l,
                _ => emit_leaf :unit l,
            },
        found =>
            match e {
                [:field, obj, field, _] =>
                    if resolved_name found == field { lower_name field span l }
                    else { lower_value_field obj field l },
                _ => emit_leaf :unit l,
            },
    };

/// Only a direct statement registers cleanup; aliases and nested calls do not.
let deferred st l = match st {
    [:apply, callee, [body], _] =>
        if callee_resolution callee l == scope.Meaning.builtin "defer!" { [body] } else { [] },
    _ => [],
};

let rec cleanup_block pairs l = match pairs {
    [] => emit_leaf :unit l,
    [pair, ..rest] => {
        let k = list.head pair;
        if not (list.is_empty (deferred (list.nth 1 pair) l)) {
            let body = cleanup_block rest l;
            let made = emit (ir.node :ensure (list.nth 1 body) k ir.no_node) (list.head body);
            [set_flag (list.nth 1 made) ir.f_impure (list.head made), list.nth 1 made]
        } else if list.is_empty rest { [l, k] }
        else {
            let tail = cleanup_block rest l;
            let placed = kids [k, list.nth 1 tail] (list.head tail);
            let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) [k, list.nth 1 tail] (list.head made), list.nth 1 made]
        }
    },
};

let rec lower_block stmts span l = {
    // A statement lowers to one node, except a destructuring `let`, which
    // lowers to several binds. So each node travels with the statement it came
    // from, which is what a warning about a discarded value points at.
    let done = list.fold (fn acc st ->
        match st {
            // A `let` whose body was written where it is read binds nothing and
            // lowers to nothing. It contributes no node, so it is not a
            // statement whose value could be discarded either.
            [:let, _, _, _, _, sp] if scope.staging (res l) (ctx l) (source l) sp == scope.Staging.elided =>
                acc,
            // A signature is a promise to the type checker. It lowers to
            // nothing, so it is not a statement either.
            [:sig, _, _, _] => acc,

            [:let, n, ps, body, _, sp] => {
                let value =
                    if list.is_empty ps { lower_expr body (list.head acc) }
                    // A local `let f x = ..` is a function like any other: it
                    // was numbered by `scope` and its body is lowered here.
                    else { lower_function sp :make_closure ps body (list.head acc) };
                let held = expand macros.coalesce (slot_at sp (list.head value)) 0;
                let bound = bind_value held (list.nth 1 value) (list.head value);
                [list.head bound, list.append (list.nth 1 acc) [[list.nth 1 bound, st]]]
            },
            // The value is held exactly as a plain `let` holds it, and the names
            // are bound out of it -- see "destructuring".
            [:let_p, pattern, body, sp] => {
                let value = lower_expr body (list.head acc);
                let held = expand macros.coalesce (slot_at sp (list.head value)) 0;
                let bound = bind_value held (list.nth 1 value) (list.head value);
                let reader = emit (ir.node :local held ir.no_node ir.no_node) (list.head bound);
                let parts = destructure pattern (list.nth 1 reader) (list.head reader);
                [list.head parts,
                 list.append (list.nth 1 acc)
                     (map (fn k -> [k, st]) (list.cons (list.nth 1 bound) (list.nth 1 parts)))]
            },
            _ => {
                let got = match deferred st (list.head acc) {
                    [body] => lower_expr body (list.head acc),
                    _ => lower_expr st (list.head acc),
                };
                [list.head got, list.append (list.nth 1 acc) [[list.nth 1 got, st]]]
            },
        }) [l, []] stmts;
    // A non-final statement contributes nothing but its effects. Inside an
    // impure function force it, so those effects happen in the order they were
    // written rather than whenever something happens to want the value. Inside
    // a pure one there are no effects to have, so it is dead code -- and
    // forcing it would only risk raising an error the program never asked for.
    let impure_here = match lookup span (list.head done) { scope.Meaning.block(yes) => yes, _ => false };
    let pairs = list.nth 1 done;
    let stmt_nodes = list.map (fn pair -> list.nth 0 pair) pairs;
    let sequenced =
        if list.length pairs <= 1 { list.head done }
        else {
            fold (fn acc pair -> {
                let k = list.nth 0 pair;
                let st = list.nth 1 pair;
                // A bind stays lazy: the ones whose value is effectful were
                // already forced where they were bound.
                if not (list.is_empty (deferred st acc)) { acc }
                else if ir.node_op (ir.node_at k (prog acc)) == :bind { acc }
                else if impure_here { set_flag k ir.f_strict acc }
                else if is_impure_node k acc { acc }
                else {
                    warn (ast.span st)
                         "this statement's value is discarded, and a pure expression has no other effect"
                         "only the final expression of a block is used" acc
                }
            }) (list.head done) (list.take (list.length pairs - 1) pairs)
        };
    if list.any (fn pair -> not (list.is_empty (deferred (list.nth 1 pair) sequenced))) pairs {
        cleanup_block pairs sequenced
    } else {
        let placed = kids stmt_nodes sequenced;
        let made = emit (ir.node :block (list.nth 1 placed) (list.length stmt_nodes) ir.no_node)
                        (list.head placed);
        [inherit (list.nth 1 made) stmt_nodes (list.head made), list.nth 1 made]
    }
};

/// A block's bind: `[lowering, node]`. Lazy, unless the value has effects --
/// binding an effectful expression sequences it here rather than at first use,
/// so effects happen in written order.
let bind_value slot value l = {
    let made = emit (ir.node :bind slot value ir.no_node) l;
    let i = list.nth 1 made;
    let inherited = inherit i [value] (list.head made);
    if is_impure_node value inherited {
        [set_flag value ir.f_strict (set_flag i ir.f_strict inherited), i]
    }
    else { [inherited, i] }
};

// --- deforestation ----------------------------------------------------------------
//
// `scope` decided that a pipeline of `std.list` combinators is one loop, gave
// that loop a function and a global, and resolved the fold's function inside
// it. What is left is to write the loop out.
//
// Every fused loop has the same shape, whichever source it came from:
//
//     let rec loop cursor carried acc =
//         if <done> { acc } else { loop <next> carried <step> };
//
// `range` counts the cursor up and carries its limit; `replicate` counts it
// down and carries the element. Three parameters and no captures, because the
// JIT compiles a function of its arguments and a capture is a frame it would
// have to keep -- and a global callee is the only self call it recognises at
// all (`check_self_call` in dream/src/jit.cpp).

let local_node slot l = emit (ir.node :local slot ir.no_node ir.no_node) l;

/// The call that enters the loop: the producer's arguments, in the order they
/// were written, and then the seed. They are lowered here, in the frame the
/// pipeline was written in, which is where they were always going to be
/// evaluated -- and so with whatever substitution was already in force, which
/// is how a pipeline written inside another one's stage still works.
let lower_fused p l = {
    let outer = subst l;
    let built = set_subst outer (fused_body p (set_subst (subst_of p) l));
    let inits = fused_inits (fuse.Plan.source p) built;
    let seeded =
        match fuse.Plan.seed p {
            fuse.Seed.written(e) => lower_expr e (list.head inits),
            fuse.Seed.number(v)  => const_int v (list.head inits),
        };
    // The names from the frame around it, read where they were resolved.
    let free = lower_all (map (fn [n, sp] -> [:name, n, sp]) (fuse.Plan.free p)) (list.head seeded);
    let callee = emit (ir.node :global (fuse.Plan.gi p) ir.no_node ir.no_node)
                      (list.head free);
    emit_apply (list.nth 1 callee)
               (list.append (list.append (list.nth 1 inits) [list.nth 1 seeded]) (list.nth 1 free))
               (list.head callee)
};

let subst_of p =
    list.fold (fn m e -> m.[(list.nth 0 e) => (list.nth 1 e)])
              (%{}) (fuse.Plan.subst p);

/// The loop's cursor and what it carries, at the call that enters it: a
/// producer's arguments as they were written; a list as the cursor, with
/// nothing carried; an array carried, with the cursor at zero. The container
/// is lowered once, here, where it was always going to be evaluated.
let fused_inits source l = match source {
    // The list as the cursor, and the count from zero.
    [:enumerate, [xs]] => {
        let got = lower_expr xs l;
        let zero = const_int 0 (list.head got);
        [list.head zero, [list.nth 1 got, list.nth 1 zero]]
    },
    [:list, [xs]] => {
        let got = lower_expr xs l;
        let none = emit_leaf :unit (list.head got);
        [list.head none, [list.nth 1 got, list.nth 1 none]]
    },
    [:array, [xs]] => {
        let zero = const_int 0 l;
        let got = lower_expr xs (list.head zero);
        [list.head got, [list.nth 1 zero, list.nth 1 got]]
    },
    [_, args] => lower_all args l,
};

/// The element a loop over a list or an array is at: the head of what is
/// left of the list, or the array at the cursor. The loop has already asked
/// whether there is one.
let fused_element tag l = {
    let cur = local_node fuse.cursor_slot l;
    match tag {
        // The pair `enumerate` would have made: the count and the head.
        :enumerate => {
            let held = local_node fuse.carried_slot (list.head cur);
            let zero = const_int 0 (list.head held);
            let head = emit (ir.node :get (list.nth 1 cur) (list.nth 1 zero) ir.no_node) (list.head zero);
            let headed = inherit (list.nth 1 head) [list.nth 1 cur, list.nth 1 zero] (list.head head);
            let placed = kids [list.nth 1 held, list.nth 1 head] headed;
            let made = emit (ir.node :make_list (list.nth 1 placed) 2 ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) [list.nth 1 held, list.nth 1 head] (list.head made), list.nth 1 made]
        },
        // The pair `zip` would have made: the two heads.
        :zip => {
            let first = fused_element :list l;
            let second = carried_head (list.head first);
            let placed = kids [list.nth 1 first, list.nth 1 second] (list.head second);
            let made = emit (ir.node :make_list (list.nth 1 placed) 2 ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) [list.nth 1 first, list.nth 1 second] (list.head made), list.nth 1 made]
        },
        :list => {
            let zero = const_int 0 (list.head cur);
            let made = emit (ir.node :get (list.nth 1 cur) (list.nth 1 zero) ir.no_node) (list.head zero);
            [inherit (list.nth 1 made) [list.nth 1 cur, list.nth 1 zero] (list.head made), list.nth 1 made]
        },
        _ => {
            let held = local_node fuse.carried_slot (list.head cur);
            let made = emit (ir.node :get (list.nth 1 held) (list.nth 1 cur) ir.no_node) (list.head held);
            [inherit (list.nth 1 made) [list.nth 1 held, list.nth 1 cur] (list.head made), list.nth 1 made]
        },
    }
};

/// The head of the second list `zip` walks, which it carries.
let carried_head l = {
    let held = local_node fuse.carried_slot l;
    let zero = const_int 0 (list.head held);
    let made = emit (ir.node :get (list.nth 1 held) (list.nth 1 zero) ir.no_node) (list.head zero);
    [inherit (list.nth 1 made) [list.nth 1 held, list.nth 1 zero] (list.head made), list.nth 1 made]
};

/// The loop itself, emitted into the same arena as everything else -- a
/// function is a body node and a descriptor, not an arena of its own.
let fused_body p l = {
    let stag = list.nth 0 (fuse.Plan.source p);
    let replicating = stag == :replicate;

    // Done: `range` stops at its limit, `replicate` when there is nothing left
    // to repeat. Both are the condition the combinator itself tests, said
    // about a counter instead of about a list. A list is done when what is
    // left of it is empty, and an array when the cursor reaches its length.
    let cur0 = local_node fuse.cursor_slot l;
    let done =
        match stag {
            :replicate => {
                let zero = const_int 0 (list.head cur0);
                binary :le (list.nth 1 cur0) (list.nth 1 zero) (list.head zero)
            },
            :list => call_builtin "_list_is_empty" [list.nth 1 cur0] (list.head cur0),
            :enumerate => call_builtin "_list_is_empty" [list.nth 1 cur0] (list.head cur0),
            // Either list running out ends it, the first asked first.
            :zip => {
                let one = call_builtin "_list_is_empty" [list.nth 1 cur0] (list.head cur0);
                let held = local_node fuse.carried_slot (list.head one);
                let other = call_builtin "_list_is_empty" [list.nth 1 held] (list.head held);
                binary :or (list.nth 1 one) (list.nth 1 other) (list.head other)
            },
            :array => {
                let held = local_node fuse.carried_slot (list.head cur0);
                let size = call_builtin "len" [list.nth 1 held] (list.head held);
                binary :ge (list.nth 1 cur0) (list.nth 1 size) (list.head size)
            },
            _ => {
                let limit = local_node fuse.carried_slot (list.head cur0);
                binary :ge (list.nth 1 cur0) (list.nth 1 limit) (list.head limit)
            },
        };

    // What the loop answers when the source runs out: the accumulator, or --
    // for a sink that stops early -- what it answers when nothing decided it.
    let sink = fuse.Plan.sink p;
    let answer = match sink {
        :collect => lower_seq :make_list [] (list.head done),
        :concat => lower_seq :make_list [] (list.head done),
        :any => const_bool false (list.head done),
        :all => const_bool true (list.head done),
        :none => const_bool true (list.head done),
        :find => emit_leaf :unit (list.head done),
        _ => local_node fuse.acc_slot (list.head done),
    };

    // The turn that takes this element, and -- when a `filter` says it might
    // not be taken -- the turn that leaves the accumulator alone.
    let taken = if fuse.decides_early sink { deciding_turn p stag sink (list.head answer) }
                else if sink == fuse.collect || sink == :concat { collecting_turn p stag sink (list.head answer) }
                else { self_turn p stag (fn l0 -> fused_step p l0) (list.head answer) };
    let advanced =
        match fuse.Plan.guards p {
            [] => taken,
            gs => {
                let cond = lower_guards gs (list.head taken);
                let skipped = self_turn p stag (fn l0 -> local_node fuse.acc_slot l0)
                                        (list.head cond);
                let made = emit (ir.node :if (list.nth 1 cond) (list.nth 1 taken)
                                         (list.nth 1 skipped))
                                (list.head skipped);
                [set_flag (list.nth 1 cond) ir.f_strict
                    (inherit (list.nth 1 made)
                             [list.nth 1 cond, list.nth 1 taken, list.nth 1 skipped]
                             (list.head made)),
                 list.nth 1 made]
            },
        };
    let otherwise =
        if fuse.Plan.strict p { forced_acc (list.nth 1 advanced) (list.head advanced) }
        else { advanced };

    let made = emit (ir.node :if (list.nth 1 done) (list.nth 1 answer) (list.nth 1 otherwise))
                    (list.head otherwise);
    let i = list.nth 1 made;
    let settled =
        set_flag (list.nth 1 done) ir.f_strict
            (inherit i [list.nth 1 done, list.nth 1 answer, list.nth 1 otherwise]
                     (list.head made));
    set_func_body (fuse.Plan.fi p) i (mark_tail i settled)
};

/// One turn of the loop: the cursor moved on, whatever the source carries
/// passed through untouched, and whatever accumulator the caller asks for.
///
/// Emitted fresh every time it is wanted, rather than built once and pointed
/// at twice. The arena is a tree -- a node reached from two parents would be
/// walked twice by everything that reads it, and would take a flag meant for
/// one of them in both places.
let self_turn p stag acc_at l = {
    let cur = local_node fuse.cursor_slot l;
    let advanced = match stag {
        :list => call_builtin "_list_tail" [list.nth 1 cur] (list.head cur),
        :enumerate => call_builtin "_list_tail" [list.nth 1 cur] (list.head cur),
        :zip => call_builtin "_list_tail" [list.nth 1 cur] (list.head cur),
        _ => {
            let one = const_int 1 (list.head cur);
            binary (if stag == :replicate { :sub } else { :add })
                   (list.nth 1 cur) (list.nth 1 one) (list.head one)
        },
    };
    // Carried unchanged, but for `enumerate`'s count, which goes up by one,
    // and `zip`'s second list, which moves on with the first.
    let carried = match stag {
        :enumerate => {
            let held = local_node fuse.carried_slot (list.head advanced);
            let one = const_int 1 (list.head held);
            binary :add (list.nth 1 held) (list.nth 1 one) (list.head one)
        },
        :zip => {
            let held = local_node fuse.carried_slot (list.head advanced);
            call_builtin "_list_tail" [list.nth 1 held] (list.head held)
        },
        _ => local_node fuse.carried_slot (list.head advanced),
    };
    let acc = acc_at (list.head carried);
    // The names from the frame around it, handed straight back.
    let free = list.fold (fn got i -> {
        let read = local_node (fuse.arity + i) (list.head got);
        [list.head read, list.append (list.nth 1 got) [list.nth 1 read]]
    }) [list.head acc, []] (list.range 0 (list.length (fuse.Plan.free p)));
    let callee = emit (ir.node :global (fuse.Plan.gi p) ir.no_node ir.no_node)
                      (list.head free);
    emit_apply (list.nth 1 callee)
               (list.append [list.nth 1 advanced, list.nth 1 carried, list.nth 1 acc] (list.nth 1 free))
               (list.head callee)
};

/// One turn of a loop that stops at the first element that decides it: the
/// predicate asked, and either the answer -- `true` for `any`, `false` for
/// `all` and `none`, the element for `find` -- or the next turn. Nothing after the deciding element
/// is asked, as `list.any` asks nothing after it.
let deciding_turn p stag sink l = {
    // A sink that decides early always has its predicate written down.
    let asked = match fuse.Plan.step p {
        fuse.Step.written(body, ps) => fused_written p body ps l,
        fuse.Step.op(_) => const_bool false l,
    };
    // `find` answers the element itself, read again where it is answered:
    // a `map`'s output is computed a second time, for the one element found.
    let on = if sink == :find { emit_local (fuse.Plan.elem p) (list.head asked) }
             else { const_bool (sink == :any) (list.head asked) };
    let next = self_turn p stag (fn l0 -> local_node fuse.acc_slot l0) (list.head on);
    let [yes, no] = if sink == :all { [list.nth 1 next, list.nth 1 on] } else { [list.nth 1 on, list.nth 1 next] };
    let made = emit (ir.node :if (list.nth 1 asked) yes no) (list.head next);
    [set_flag (list.nth 1 asked) ir.f_strict
        (inherit (list.nth 1 made) [list.nth 1 asked, yes, no] (list.head made)),
     list.nth 1 made]
};

/// One cell of a chain that ends in a list: the element consed onto the call
/// for the rest, built as `list.map` builds its cells -- `_list_cons` of the
/// element and the recursive call -- so the element and the rest are as lazy
/// as they were there.
let collecting_turn p stag sink l = {
    let x = emit_local (fuse.Plan.elem p) l;
    let rest = self_turn p stag (fn l0 -> local_node fuse.acc_slot l0) (list.head x);
    // `concat`'s element is a list of its own, appended as `list.append`
    // appends it.
    if sink == :concat { binary :add (list.nth 1 x) (list.nth 1 rest) (list.head rest) }
    else { call_builtin "_list_cons" [list.nth 1 x, list.nth 1 rest] (list.head rest) }
};

/// The `filter`s, as one condition. `and` is short-circuiting, which is what
/// keeps the order right: an element the first filter rejects never reaches
/// the second, exactly as it never reached the second `filter`'s call.
let lower_guards gs l =
    list.fold (fn acc g -> {
        let got = lower_expr g (list.head acc);
        match list.nth 1 acc {
            () => [list.head got, list.nth 1 got],
            prev => binary :and prev (list.nth 1 got) (list.head got),
        }
    }) [l, ()] gs;

/// What the accumulator becomes: the fold's own function, whose parameters
/// `scope` bound to these very slots, or the operator `sum` and `product`
/// stand for.
let fused_step p l =
    match fuse.Plan.step p {
        // `count`: one more when the predicate holds.
        fuse.Step.written(body, ps) if fuse.Plan.sink p == :count => {
            let a = local_node fuse.acc_slot l;
            let asked = fused_written p body ps (list.head a);
            let one = const_int 1 (list.head asked);
            let more = binary :add (list.nth 1 a) (list.nth 1 one) (list.head one);
            let same = local_node fuse.acc_slot (list.head more);
            let made = emit (ir.node :if (list.nth 1 asked) (list.nth 1 more) (list.nth 1 same)) (list.head same);
            [set_flag (list.nth 1 asked) ir.f_strict
                (inherit (list.nth 1 made) [list.nth 1 asked, list.nth 1 more, list.nth 1 same] (list.head made)),
             list.nth 1 made]
        },
        fuse.Step.written(body, ps) => fused_written p body ps l,
        // `length`: one more for every element that got this far.
        fuse.Step.op(:length) => {
            let a = local_node fuse.acc_slot l;
            let one = const_int 1 (list.head a);
            binary :add (list.nth 1 a) (list.nth 1 one) (list.head one)
        },
        // `last`: the element, in place of the one before it.
        fuse.Step.op(:last) => emit_local (fuse.Plan.elem p) l,
        // `reverse`: the element, as lazy as it was, consed onto the rest.
        fuse.Step.op(:reverse) => {
            let a = local_node fuse.acc_slot l;
            let x = emit_local (fuse.Plan.elem p) (list.head a);
            call_builtin "_list_cons" [list.nth 1 x, list.nth 1 a] (list.head x)
        },
        // `from_pairs`: the pair's first element keyed to its second, read as
        // `list.nth` reads them -- `()` for a pair that is short.
        fuse.Step.op(:pairs) => {
            let a = local_node fuse.acc_slot l;
            let k = pair_part (fuse.Plan.elem p) 0 (list.head a);
            let v = pair_part (fuse.Plan.elem p) 1 (list.head k);
            fuse_set (list.nth 1 a) (list.nth 1 k) (list.nth 1 v) (list.head v)
        },
        fuse.Step.op(op) => {
            let a = local_node fuse.acc_slot l;
            let x = emit_local (fuse.Plan.elem p) (list.head a);
            binary (if op == :mul { :mul } else { :add })
                   (list.nth 1 a) (list.nth 1 x) (list.head x)
        },
    };

/// A step written at the call site: its body, and -- when the element was
/// written as a pattern, `fn acc [k, v]` -- the element taken apart in front of
/// it, checked as the lambda's own parameter would have been (`lower_body`).
let fused_written p body ps l =
    match if list.length ps == 2 { ast.param_pattern (list.head ps) } else { () } {
        () => element_written p body ps l,
        // The accumulator taken apart first, from its slot, as the lambda's
        // own first parameter would have been.
        pattern => {
            let arg = local_node fuse.acc_slot l;
            let parts = destructure pattern (list.nth 1 arg) (list.head arg);
            let inner = element_written p body ps (list.head parts);
            let stmts = list.append (list.nth 1 parts) [list.nth 1 inner];
            let placed = kids stmts (list.head inner);
            let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
        },
    };

/// The step's body with its element taken apart in front of it, when the
/// element was written as a pattern.
let element_written p body ps l =
    match [list.head (fuse.Plan.source p), ast.param_pattern (list.last ps)] {
        [_, ()] => lower_expr body l,
        // `fn acc [i, x]` over `enumerate`: each name bound straight from the
        // count and the head. The pair always has two elements, so there is
        // nothing to check and no reason to build it.
        [:enumerate, [:list_p, [first, second], (), _]] if plain_binder first && plain_binder second => {
            let count = local_node fuse.carried_slot l;
            let i = bound_to first (list.nth 1 count) (list.head count);
            let x = fused_element :list (list.head i);
            let j = bound_to second (list.nth 1 x) (list.head x);
            let inner = lower_expr body (list.head j);
            let stmts = list.append (list.append (list.nth 1 i) (list.nth 1 j)) [list.nth 1 inner];
            let placed = kids stmts (list.head inner);
            let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
        },
        // `fn acc [x, y]` over `zip`: each name bound straight from a head.
        [:zip, [:list_p, [first, second], (), _]] if plain_binder first && plain_binder second => {
            let x = fused_element :list l;
            let i = bound_to first (list.nth 1 x) (list.head x);
            let y = carried_head (list.head i);
            let j = bound_to second (list.nth 1 y) (list.head y);
            let inner = lower_expr body (list.head j);
            let stmts = list.append (list.append (list.nth 1 i) (list.nth 1 j)) [list.nth 1 inner];
            let placed = kids stmts (list.head inner);
            let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
        },
        [_, pattern] => {
            let arg = emit_local (fuse.Plan.elem p) l;
            let parts = destructure pattern (list.nth 1 arg) (list.head arg);
            let inner = lower_expr body (list.head parts);
            let stmts = list.append (list.nth 1 parts) [list.nth 1 inner];
            let placed = kids stmts (list.head inner);
            let made = emit (ir.node :block (list.nth 1 placed) (list.length stmts) ir.no_node) (list.head placed);
            [inherit (list.nth 1 made) stmts (list.head made), list.nth 1 made]
        },
    };

/// A name or `_`: a part of a pattern that needs no check of its own.
let plain_binder pat = match pat { [:bind, _, _] => true, [:wildcard, _] => true, _ => false };

/// `[lowering, statements]`: `value` bound to the name `pat` gives, or nothing
/// for `_`.
let bound_to pat value l = match pat {
    [:bind, _, span] => {
        let made = emit (ir.node :bind (expand macros.coalesce (slot_at span l) 0) value ir.no_node) l;
        [list.head made, [list.nth 1 made]]
    },
    _ => [l, []],
};

/// Part `i` of the pair in slot `slot`, or `()`.
let pair_part slot i l = {
    let x = emit_local slot l;
    let at = const_int i (list.head x);
    let none = emit_leaf :unit (list.head at);
    let made = emit (ir.node :get (list.nth 1 x) (list.nth 1 at) (list.nth 1 none)) (list.head none);
    [inherit (list.nth 1 made) [list.nth 1 x, list.nth 1 at, list.nth 1 none] (list.head made), list.nth 1 made]
};

/// `fold_strict`, which forces each step before taking the next.
///
/// It forces the accumulator at the *top* of the following iteration rather
/// than at the bottom of this one, which comes to the same thing -- the chain
/// of suspensions never gets past one link either way -- and is the only way
/// to say it that the JIT can still take. A `let` would need a slot the frame
/// holds, and a compiled frame's slots are registers; a statement is just a
/// statement, and one marked strict is run where it stands.
///
/// The seed is forced too, on the first turn, as `list.fold` forces it: a
/// strict fold is strict in its accumulator from the start, and `fold_lazy`
/// is the fold for a seed that must stay unforced.
let forced_acc call l = {
    let acc = local_node fuse.acc_slot l;
    let forced = emit (ir.node :force (list.nth 1 acc) ir.no_node ir.no_node) (list.head acc);
    let marked = set_flag (list.nth 1 forced) ir.f_strict (list.head forced);
    let placed = kids [list.nth 1 forced, call] marked;
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [list.nth 1 forced, call] (list.head made), list.nth 1 made]
};

// --- patterns ---------------------------------------------------------------------
//
// A pattern becomes a test and a set of bindings. The test answers whether the
// arm is taken; the bindings say what its body may name. Nothing is forced
// beyond what deciding takes, which is what keeps `match` usable on a lazy
// structure -- walking a list one cell at a time rather than asking its length.

/// `[lowering, test, binds]`, where a bind is `[span, value node]` -- the span
/// being where the binder was written, which is how the slot is found.
let rec pattern_test p subject binds l =
    match p {
        [:wildcard, _] => { let t = const_bool true l; [list.head t, list.nth 1 t, binds] },
        [:bind, _, span] => {
            let t = const_bool true l;
            [list.head t, list.nth 1 t, list.append binds [[span, subject]]]
        },
        [:as_p, inner, _, name_span, _] =>
            pattern_test inner subject (list.append binds [[name_span, subject]]) l,
        [:literal, e, _] => {
            let k = lower_expr e l;
            let cmp = eq_const subject (list.nth 1 k) (list.head k);
            [list.head cmp, list.nth 1 cmp, binds]
        },
        [:cons_p, head, tail, _, _] => {
            let cell = call_builtin "_match_is_cons" [subject] l;
            let h = call_builtin "_match_head" [subject] (list.head cell);
            let first = pattern_test head (list.nth 1 h) binds (list.head h);
            let first_test = bool_and (list.nth 1 cell) (list.nth 1 first) (list.head first);
            let t = call_builtin "_match_tail" [subject] (list.head first_test);
            let rest = pattern_test tail (list.nth 1 t) (list.nth 2 first) (list.head t);
            let both = bool_and (list.nth 1 first_test) (list.nth 1 rest) (list.head rest);
            [list.head both, list.nth 1 both, list.nth 2 rest]
        },
        [:list_p, items, rest, _]     => list_test items rest subject binds l,
        [:array_p, items, rest, span] => array_test items rest subject binds span l,
        [:map_p, pairs, span] => map_test pairs subject binds span l,
        [:record_p, ctor, fields, span] => record_test ctor fields subject binds span l,
        [:success_p, inner, _] => success_test inner subject binds l,
        _ => { let t = const_bool true l; [list.head t, list.nth 1 t, binds] },
    };

/// `Shape.circle(r)`: one question for what it is -- the constructor's id,
/// which is also how many fields it has -- then the fields by position, as an
/// array pattern's elements. A name that is no constructor, or the wrong
/// number of fields, is an error here rather than an arm that never matches.
let rec record_test ctor fields subject binds span l =
    match constructor_of ctor l {
        () => {
            let t = const_bool false (complain span ("`" + written ctor + "` is not a constructor") l);
            [list.head t, list.nth 1 t, binds]
        },
        [id, _, arity] =>
            if arity != list.length fields {
                let said = "`" + written ctor + "` makes " + to_string arity
                           + (if arity == 1 { " field" } else { " fields" }) + ", and this pattern has "
                           + to_string (list.length fields);
                let t = const_bool false (complain span said l);
                [list.head t, list.nth 1 t, binds]
            }
            else {
                let k = const_atom id l;
                let is = call_builtin "_record_is" [list.nth 1 k, subject] (list.head k);
                fold (fn acc pair -> {
                    let at = const_int (list.nth 1 pair) (list.nth 0 acc);
                    let field = call_builtin "_match_at" [subject, list.nth 1 at] (list.head at);
                    let inner = pattern_test (list.nth 0 pair) (list.nth 1 field) (list.nth 2 acc)
                                            (list.head field);
                    let both = bool_and (list.nth 1 acc) (list.nth 1 inner) (list.nth 0 inner);
                    [list.head both, list.nth 1 both, list.nth 2 inner]
                }) [list.head is, list.nth 1 is, binds]
                   (list.zip fields (list.range 0 (list.length fields)))
            },
    };

/// `let?`'s pattern: the subject is the prelude's `Result.ok` or
/// `Option.some` -- asked by id, as `record_test` asks -- and `inner` is
/// matched against the one field both of them hold.
let success_test inner subject binds l = {
    let tests = list.fold (fn acc id -> {
        let k = const_atom id (list.head acc);
        let is = call_builtin "_record_is" [list.nth 1 k, subject] (list.head k);
        match list.nth 1 acc {
            () => is,
            before => binary :or before (list.nth 1 is) (list.head is),
        }
    }) [l, ()] ast.success_ids;
    let at = const_int 0 (list.head tests);
    let field = call_builtin "_match_at" [subject, list.nth 1 at] (list.head at);
    let inner_t = pattern_test inner (list.nth 1 field) binds (list.head field);
    let both = bool_and (list.nth 1 tests) (list.nth 1 inner_t) (list.nth 0 inner_t);
    [list.head both, list.nth 1 both, list.nth 2 inner_t]
};

/// The value must be a list at all. Without this `[]` would match anything that
/// is not a cons cell -- an array, a map, a number -- because "not a cell" and
/// "the end of a list" look the same from `_match_is_cons` alone. `type_of`
/// answers `:list` for both the empty list and a cell, so one test covers every
/// list pattern.
let rec is_type name subject l = {
    let ty = call_builtin "type_of" [subject] l;
    let want = const_atom name (list.head ty);
    eq_const (list.nth 1 ty) (list.nth 1 want) (list.head want)
};

let rec list_test items rest subject binds l = {
    let typed = is_type "list" subject l;
    // Walked one cell at a time, so nothing beyond what the pattern names is
    // ever forced.
    let walked = list.fold (fn acc item -> {
        let l0 = list.nth 0 acc;
        let test = list.nth 1 acc;
        let cursor = list.nth 2 acc;
        let bs = list.nth 3 acc;
        let cons_test = call_builtin "_match_is_cons" [cursor] l0;
        let with_cons = bool_and test (list.nth 1 cons_test) (list.head cons_test);
        let head = call_builtin "_match_head" [cursor] (list.head with_cons);
        let inner = pattern_test item (list.nth 1 head) bs (list.head head);
        let both = bool_and (list.nth 1 with_cons) (list.nth 1 inner) (list.nth 0 inner);
        let tail = call_builtin "_match_tail" [cursor] (list.head both);
        [list.head tail, list.nth 1 both, list.nth 1 tail, list.nth 2 inner]
    }) [list.head typed, list.nth 1 typed, subject, binds] items;

    let l1 = list.nth 0 walked;
    let test = list.nth 1 walked;
    let cursor = list.nth 2 walked;
    let bs = list.nth 3 walked;
    match rest {
        // `..` takes whatever is left, including nothing, so there is no
        // further test -- only a binding, when it was named.
        [()] => [l1, test, bs],
        [_, name_span] => [l1, test, list.append bs [[name_span, cursor]]],
        // A fixed-length list: what is left must be the end.
        _ => {
            let cons_test = call_builtin "_match_is_cons" [cursor] l1;
            let ends = binary :not (list.nth 1 cons_test) ir.no_node (list.head cons_test);
            let both = bool_and test (list.nth 1 ends) (list.head ends);
            [list.head both, list.nth 1 both, bs]
        },
    }
};

/// An array knows its own length, so the shape is one comparison rather than a
/// walk.
let rec array_test items rest subject binds span l = {
    let typed = is_type "array" subject l;
    let length = call_builtin "len" [subject] (list.head typed);
    let want = const_int (list.length items) (list.head length);
    let sized =
        if rest == () { eq_const (list.nth 1 length) (list.nth 1 want) (list.head want) }
        else { binary :ge (list.nth 1 length) (list.nth 1 want) (list.head want) };
    let start = bool_and (list.nth 1 typed) (list.nth 1 sized) (list.head sized);

    let done = fold (fn acc pair -> {
        let l0 = list.nth 0 acc;
        let at = const_int (list.nth 1 pair) l0;
        let element = call_builtin "_match_at" [subject, list.nth 1 at] (list.head at);
        let inner = pattern_test (list.nth 0 pair) (list.nth 1 element) (list.nth 2 acc)
                                (list.head element);
        let both = bool_and (list.nth 1 acc) (list.nth 1 inner) (list.nth 0 inner);
        [list.head both, list.nth 1 both, list.nth 2 inner]
    }) [list.head start, list.nth 1 start, binds]
       (list.zip items (list.range 0 (list.length items)));

    // `#[a, ..rest]` names the remainder, which an array cannot hand back
    // without copying, so it is reported rather than silently allocating.
    match rest {
        [name, _] =>
            [complain span ("`.." + name + "` cannot name the rest of an array")
                      (list.nth 0 done),
             list.nth 1 done, list.nth 2 done],
        _ => done,
    }
};

let rec map_test pairs subject binds span l = {
    let typed = is_type "map" subject l;
    list.fold (fn acc kv -> {
        let l0 = list.nth 0 acc;
        let k = lower_expr (list.nth 0 kv) l0;
        // `[v]` when the key is there, `[]` when it is not -- so presence and
        // the value come out of one lookup.
        let found = call_builtin "_match_key" [subject, list.nth 1 k] (list.head k);
        let present = call_builtin "_match_is_cons" [list.nth 1 found] (list.head found);
        let with_key = bool_and (list.nth 1 acc) (list.nth 1 present) (list.head present);
        let held = call_builtin "_match_head" [list.nth 1 found] (list.head with_key);
        let inner = pattern_test (list.nth 1 kv) (list.nth 1 held) (list.nth 2 acc) (list.head held);
        let both = bool_and (list.nth 1 with_key) (list.nth 1 inner) (list.nth 0 inner);
        [list.head both, list.nth 1 both, list.nth 2 inner]
    }) [list.head typed, list.nth 1 typed, binds] pairs
};

// --- destructuring ----------------------------------------------------------------
//
// A destructuring `let`, a pattern parameter and a top-level destructuring all
// come to the same two steps. The value is checked against the pattern by the
// very test a `match` arm makes, and bound, checked, to a slot of its own; then
// each name is bound to its part of *that* slot. Every one of those binds is lazy,
// so nothing happens until a name is used -- and reading any name's part forces
// the checked slot first, which runs the check once for all of them.

// --- a failed match ---------------------------------------------------------------
//
// A `match` that nothing fits, and a destructuring the value does not, raise an
// error of kind `:match_error` whose payload is `[value, path, line, col]`: what
// did not fit, and where. Until this said both, the error was the bare atom,
// and the only way to find which of a program's thousands of `match`es had
// failed, or on what, was to go looking.
//
// The position is worked out here, from the places table `with_places` puts on
// the resolution, because the image carries no spans for the machine to report
// from. A lowering without one -- a macro's, the REPL's -- reports `"?"` and
// zeros. One string per *file*, not per site: a site's line and column are
// integers, so the image's string table grows by the files it was read from.

/// Where each source's lines start, by source index: `[path, starts,
/// origins]`, where `origins` maps a macro's generated text back to its call.
let places_of : modules.Loader -> %{ :integer => :list };
let places_of ld = fold (fn acc i -> {
    let src = modules.file_at ld i;
    // The text itself is left behind: only its line starts and the ranges a
    // macro generated are wanted, and this table is shared with every part.
    let origins = diag.Source.make (diag.source_path src) "" (diag.origins src);
    // Left lazy: `vm.share!` forces it where the table is shared, and a whole
    // lowering builds a file's table only once a `match` in it asks.
    acc.[i => [shown_path ld (diag.source_path src), diag.line_starts (diag.source_text src), origins]]
}) (%{}) (list.range 0 (modules.file_count ld));

/// A file's name as a failed match reports it: relative to the search path it
/// was found under -- `std/list.dr`, not wherever this machine keeps `mind` --
/// and as it was written when no search path holds it. The image carries it,
/// and an image should say the same thing whoever built it.
let shown_path : modules.Loader -> :string -> :string;
let shown_path ld p = {
    let dirs = map (fn d -> if str.ends_with "/" d { d } else { d + "/" }) (modules.search_paths ld);
    let longest = fold (fn best d ->
        if str.starts_with d p && str.byte_length d > str.byte_length best { d } else { best }) "" dirs;
    str.slice (str.byte_length longest) (str.byte_length p) p
};

/// The resolution, carrying the places table its lowering reports from.
let with_places : modules.Loader -> scope.Resolution -> scope.Resolution;
let with_places ld r = (r |> scope.Resolution.set_places (places_of ld));

let places r = scope.Resolution.places r;

/// `[path, line, col]` for a span in the source being lowered.
let place_of span l = match (places (res l)).[source l else ()] {
    () => ["?", 0, 0],
    [path, starts, src] => {
        let at = diag.place_in starts (ast.span_start (diag.origin_span src span));
        [path, list.nth 0 at, list.nth 1 at]
    },
};

/// What the places of a part's sources come to, for its unit key: a part
/// lowered against one set of line starts is not the part lowered against
/// another, even where every span in it is the same.
let places_key r bodies = {
    let srcs = list.unique (map (fn nb -> list.nth 1 (list.nth 1 nb)) bodies);
    map (fn i -> match (places r).[i else ()] {
        () => (),
        [path, starts, _] => [path, starts],
    }) (list.sort srcs)
};

/// The raise a failed match comes to: `subject` is the node that reads what
/// did not fit, and `span` where it was written.
///
/// One call of `_match_fail`, which builds the error and raises it. Built here
/// from `_error_new`, a list and `raise!`, every site was four nodes and seven
/// kids of its own, and the compiler's image grew 13% for its two thousand
/// sites; as one call the builtin, the path and the small integers are shared
/// constants and a site is the call and its four kids.
let match_failure : :integer -> ast.Span -> Lowering -> [Lowering, :integer];
let match_failure subject span l = {
    let at = place_of span l;
    let path = const_str (list.nth 0 at) l;
    let line = const_int (list.nth 1 at) (list.head path);
    let col = const_int (list.nth 2 at) (list.head line);
    let raised = call_builtin "_match_fail" [subject, list.nth 1 path, list.nth 1 line, list.nth 1 col]
                              (list.head col);
    [set_flag (list.nth 1 raised) ir.f_strict (list.head raised), list.nth 1 raised]
};

/// The value if it fits the pattern, and a raise of `:match_error` if it does
/// not: a `match` whose one arm hands the value back.
let check_value pattern value l = {
    let tested = pattern_test pattern value [] l;
    let test = list.nth 1 tested;
    let raised = match_failure value (ast.span pattern) (list.nth 0 tested);
    let failing = list.head raised;
    let made = emit (ir.node :if test value (list.nth 1 raised)) failing;
    [set_flag test ir.f_strict
        (inherit (list.nth 1 made) [test, value, list.nth 1 raised] (list.head made)),
     list.nth 1 made]
};

/// The binds a destructuring comes to, given a node that reads the value:
/// `[lowering, binds]`. The first holds the checked value, and each of the rest
/// binds a name to its part of the first.
/// A constructor as it was written: `Shape.circle`, `geo.Shape.circle`.
let rec written e = match e {
    [:name, n, _] => n,
    [:field, obj, n, _] => written obj + "." + n,
    _ => ast.show e,
};

/// The parts at each position of an array or a record, by `_match_at`.
let extract_at items subject want binds l =
    fold (fn acc pair ->
        if not (wants want (list.nth 0 pair)) { acc }
        else {
            let at = const_int (list.nth 1 pair) (list.nth 0 acc);
            let element = call_builtin "_match_at" [subject, list.nth 1 at] (list.head at);
            extract (list.nth 0 pair) (list.nth 1 element) want (list.nth 1 acc)
                    (list.head element)
        }) [l, binds] (list.zip items (list.range 0 (list.length items)));

let destructure pattern value l = {
    let checked = check_value pattern value l;
    let slot = expand macros.coalesce (slot_at (scope.checked_span pattern) (list.head checked)) 0;
    let held = emit (ir.node :bind slot (list.nth 1 checked) ir.no_node) (list.head checked);
    let reader = emit (ir.node :local slot ir.no_node ir.no_node) (list.head held);
    let parts = extract pattern (list.nth 1 reader) (fn _ -> true) [] (list.head reader);
    list.fold (fn acc part -> {
        let s = expand macros.coalesce (slot_at (list.nth 0 part) (list.head acc)) 0;
        let made = emit (ir.node :bind s (list.nth 1 part) ir.no_node) (list.head acc);
        [list.head made, list.append (list.nth 1 acc) [list.nth 1 made]]
    }) [list.nth 0 parts, [list.nth 1 held]] (list.nth 1 parts)
};

/// The parts of a value a pattern names, as `[lowering, binds]` with each bind
/// `[span, node]` -- what `pattern_test` answers, without the test, which has
/// already been made. Only what `want` asks for is walked to: a name of a
/// top-level destructuring is a global of its own and reads its one part, not
/// every part.
///
/// These are the accessors a `match` uses. They force the cells on the way,
/// which the check already forced, and never the part itself.
let rec extract p subject want binds l =
    match p {
        [:bind, _, span] =>
            [l, if want span { list.append binds [[span, subject]] } else { binds }],
        [:as_p, inner, _, name_span, _] =>
            extract inner subject want
                    (if want name_span { list.append binds [[name_span, subject]] } else { binds }) l,
        [:cons_p, head, tail, _, _] => {
            let first = if wants want head {
                let h = call_builtin "_match_head" [subject] l;
                extract head (list.nth 1 h) want binds (list.head h)
            } else { [l, binds] };
            if wants want tail {
                let t = call_builtin "_match_tail" [subject] (list.head first);
                extract tail (list.nth 1 t) want (list.nth 1 first) (list.head t)
            } else { first }
        },
        [:list_p, items, rest, _] => extract_list items rest subject want binds l,
        [:array_p, items, _, _] => extract_at items subject want binds l,
        [:record_p, _, fields, _] => extract_at fields subject want binds l,
        [:map_p, pairs, _] =>
            list.fold (fn acc kv ->
                if not (wants want (list.nth 1 kv)) { acc }
                else {
                    let k = lower_expr (list.nth 0 kv) (list.nth 0 acc);
                    let found = call_builtin "_match_key" [subject, list.nth 1 k] (list.head k);
                    let held = call_builtin "_match_head" [list.nth 1 found] (list.head found);
                    extract (list.nth 1 kv) (list.nth 1 held) want (list.nth 1 acc) (list.head held)
                }) [l, binds] pairs,
        _ => [l, binds],
    };

/// A list a cell at a time, and no further than the last part wanted.
let rec extract_list items rest cursor want binds l =
    match items {
        [] =>
            match rest {
                [_, name_span] =>
                    [l, if want name_span { list.append binds [[name_span, cursor]] } else { binds }],
                _ => [l, binds],
            },
        [item, ..more] => {
            let got =
                if not (wants want item) { [l, binds] }
                else {
                    let head = call_builtin "_match_head" [cursor] l;
                    extract item (list.nth 1 head) want binds (list.head head)
                };
            if not (list.any (fn i -> wants want i) more || rest_wanted want rest) { got }
            else {
                let tail = call_builtin "_match_tail" [cursor] (list.head got);
                extract_list more rest (list.nth 1 tail) want (list.nth 1 got) (list.head tail)
            }
        },
    };

/// Does this pattern bind anything `want` asks for?
let wants want p = list.any (fn b -> want (list.nth 1 b)) (scope.pattern_bindings p);

let rest_wanted want rest = match rest { [_, name_span] => want name_span, _ => false };

/// The hidden global behind a top-level destructuring: the value, held, and then
/// checked. Shaped as a `match` is -- a strict bind of the subject, then the test
/// -- because it is only ever forced by a name that needs the check, and a global
/// remembers what it came to.
let lower_destructure pattern body span l = {
    let value = lower_expr body l;
    let held = expand macros.coalesce (slot_at span (list.head value)) 0;
    let bind = emit (ir.node :bind held (list.nth 1 value) ir.no_node) (list.head value);
    let i = list.nth 1 bind;
    let sequenced = set_flag i ir.f_strict (inherit i [list.nth 1 value] (list.head bind));
    let reader = emit (ir.node :local held ir.no_node ir.no_node) sequenced;
    let checked = check_value pattern (list.nth 1 reader) (list.head reader);
    let placed = kids [i, list.nth 1 checked] (list.head checked);
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [i, list.nth 1 checked] (list.head made), list.nth 1 made]
};

/// One name of a top-level destructuring: its part of the hidden global. The
/// hidden global is found by name in the module this body was resolved against,
/// which under `derive` is the deriving module -- whose hidden global it is.
let lower_destructured hidden pattern name_span l =
    match scope.global_index (scope.r_env_at (res l) (ctx l)) hidden {
        () => emit_leaf :unit l,
        g => {
            let value = emit (ir.node :global g ir.no_node ir.no_node) l;
            let parts = extract pattern (list.nth 1 value)
                                (fn s -> ast.span_start s == ast.span_start name_span)
                                [] (list.head value);
            match list.nth 1 parts {
                [part] => [list.nth 0 parts, list.nth 1 part],
                _ => emit_leaf :unit (list.nth 0 parts),
            }
        },
    };

// --- match --------------------------------------------------------------------

let rec lower_match scrutinee arms span l = {
    let value = lower_expr scrutinee l;
    let held = expand macros.coalesce (slot_at span (list.head value)) 0;
    let bind = emit (ir.node :bind held (list.nth 1 value) ir.no_node) (list.head value);
    let i = list.nth 1 bind;
    // Every pattern but `_` and a bare name looks at the subject, and the arms
    // are tried in order, so evaluating it once up front is both cheaper and
    // the only way the order is observable at all.
    let sequenced = set_flag i ir.f_strict (inherit i [list.nth 1 value] (list.head bind));

    let chain = lower_arms arms held span sequenced;
    let dispatched = dispatch arms (list.nth 2 chain) held (list.nth 1 chain) (list.head chain);
    let placed = kids [i, list.nth 1 dispatched] (list.head dispatched);
    let made = emit (ir.node :block (list.nth 1 placed) 2 ir.no_node) (list.head placed);
    [inherit (list.nth 1 made) [i, list.nth 1 dispatched] (list.head made), list.nth 1 made]
};

// --- jumping to the arm -----------------------------------------------------------
//
// The arms of a `match` are tried in order, and an arm that misses is not
// free: `[:name, n, sp]` against a subject it does not fit is a `type_of`, a
// cons test, a head read and an equality -- about a dozen reductions -- before
// the next arm is asked. The compiler is built out of matches of forty such
// arms, and a node that is the fortieth kind paid for thirty-nine misses.
// Measured on a twenty-arm match over `[:tag, a, b]`, reaching the last arm
// cost 1645 ms to the first arm's 343.
//
// Most of those arms say, in their first element, which subjects they could
// ever match: `[:name, ..]` only a cell whose head is `:name`, `:empty` only
// the atom `:empty`. So a `match` with enough of them starts with a switch on
// that atom, which jumps into the ordinary chain of tests at the first arm
// that could match. It jumps *into* the chain rather than replacing it: every
// target is a suffix of the chain `lower_arms` built, so every test that runs
// is one that would have run, each arm is lowered once, and an arm that does
// not match after all -- the wrong length, a guard that says no -- falls
// through to the arms below it exactly as before. What is skipped is only
// arms that could not have matched.
//
// That is sound without any type. A declared union is what makes a `match`
// look like this, but the patterns alone say which tags they take.
//
// The one thing to be careful of is forcing. `switch_head` reads the head of
// a cell, and reading means forcing. It is only emitted when the chain would
// have forced that head before anything else: the arms in front of the first
// tagged-cell arm are all atom literals, which compare the subject and cannot
// match a cell, so for a cell the first thing the chain does is force its head
// to compare it with a tag.

/// What an arm's pattern says about the subjects it could match.
union Key {
    // A list -- or an array -- whose first element is the atom `tag`.
    head(tag)
    // The atom `tag` itself, or a record whose id it is (see `arm_key`).
    atom(tag)
    // Anything else.
    any
}

/// The `Key` of an arm whose pattern is `p`.
///
/// A constructor pattern is keyed by its record's id, as an atom: `switch_atom`
/// keys a record by its id (`take_switch`, `Emitter::switch_node`), so a
/// `match` over a union jumps to the arm for the variant in hand instead of
/// asking `_record_is` of each arm above it. The id is in the record's header,
/// so reading it forces nothing the chain would not have. That an atom spelled
/// like an id gets the same key is harmless: the switch only skips arms that
/// cannot match, and the arm it lands on still runs its own test.
let rec arm_key p l = match p {
    [:as_p, inner, _, _, _] => arm_key inner l,
    [:literal, [:atom, n, _], _] => Key.atom n,
    [:record_p, ctor, _, _] => match constructor_of ctor l {
        [id, _, _] => Key.atom id,
        _ => Key.any,
    },
    [:list_p, [[:literal, [:atom, n, _], _], .._], _, _] => Key.head n,
    // A `union struct` variant: `switch_head` reads an array's first element
    // as it reads a cell's head, and the arm's own test still tells the two
    // apart, so a list arm and an array arm with one tag share a key safely.
    [:array_p, [[:literal, [:atom, n, _], _], .._], _, _] => Key.head n,
    _ => Key.any,
};

/// The position of the first element `pred` accepts, or `()`.
let rec find_index_from !i pred xs = match xs {
    [] => (),
    [x, ..rest] => if pred x { i } else { find_index_from (i + 1) pred rest },
};
let find_index pred xs = find_index_from 0 pred xs;

/// Fewer tags than this and the chain is already cheap.
let min_switch = 3;

/// The distinct tags `pick` finds in the keys, in the order the arms first
/// name them.
let tags_of pick keys = list.fold (fn acc k -> match pick k {
    () => acc,
    n => if list.contains n acc { acc } else { list.append acc [n] },
}) [] keys;

let head_tag k = match k { Key.head(n) => n, _ => () };
let atom_tag k = match k { Key.atom(n) => n, _ => () };

/// The chain suffix of the first arm that could match: the first whose key is
/// one of `fits`, or `Key.any`. The last suffix is the `match_error` raise.
let first_fit fits keys suffixes =
    match find_index (fn k -> k == Key.any || list.contains k fits) keys {
        () => list.nth (list.length keys) suffixes,
        j => list.nth j suffixes,
    };

/// A switch node over `tags`, each the `Key` that `keyed` makes of it, with
/// `default` for everything else.
let switch_node op keyed tags keys suffixes held default l = {
    let entries = list.fold (fn acc n -> {
        let key = const_atom n (list.head acc);
        [list.head key, list.append (list.nth 1 acc) [list.nth 1 key, first_fit [keyed n] keys suffixes]]
    }) [l, []] tags;
    let subject = emit (ir.node :local held ir.no_node ir.no_node) (list.head entries);
    let run = list.append (list.nth 1 entries) [default];
    let placed = kids run (list.head subject);
    let made = emit (ir.node op (list.nth 1 subject) (list.nth 1 placed) (list.length run)) (list.head placed);
    [inherit (list.nth 1 made) run (list.head made), list.nth 1 made]
};

/// The node a `match` starts at: a switch into `chain` when enough arms name a
/// tag, and `chain` itself otherwise.
let dispatch arms suffixes held chain l = {
    let keys = list.map (fn a -> arm_key (ast.arm_pattern a) l) arms;
    let heads = tags_of head_tag keys;
    let atoms = tags_of atom_tag keys;
    // Everything in front of the first tagged-cell arm is an atom literal.
    let head_ok = match find_index (fn k -> head_tag k != ()) keys {
        () => false,
        j => list.all (fn k -> atom_tag k != ()) (list.take j keys),
    };
    let use_heads = head_ok && list.length heads >= min_switch;
    let use_atoms = list.length atoms >= min_switch || (use_heads && not (list.is_empty atoms));
    let head_tags = list.map Key.head heads;
    // Under a `switch_head`, only a cell whose head names no tag, or something
    // that is not a cell, reaches the atom switch -- and a cell of either kind
    // can only be matched by an `:any` arm. On its own, a cell may be matched
    // by any tagged-cell arm, so none of them may be skipped.
    let atom_default = if use_heads { first_fit [] keys suffixes } else { first_fit head_tags keys suffixes };
    let by_atom = if not use_atoms { [l, ()] }
                  else { switch_node :switch_atom Key.atom atoms keys suffixes held atom_default l };
    if not use_heads {
        match list.nth 1 by_atom { () => [l, chain], node => by_atom }
    } else {
        // Not a cell, or a cell whose head is no tag: the atom switch when
        // there is one, and otherwise the first arm that is not a tagged cell.
        let fallback = match list.nth 1 by_atom {
            () => first_fit (list.map Key.atom atoms) keys suffixes,
            node => node,
        };
        switch_node :switch_head Key.head heads keys suffixes held fallback (list.head by_atom)
    }
};

let rec lower_arms arms held span l =
    match arms {
        // Nothing matched. Exhaustiveness is checked only where the checker
        // knows the subject is a declared union; everywhere else saying so at
        // run time, with the value and the place, is the honest answer, and a
        // `_` arm is how a program declares itself total.
        [] => {
            let subject = emit (ir.node :local held ir.no_node ir.no_node) l;
            let raised = match_failure (list.nth 1 subject) span (list.head subject);
            [list.head raised, list.nth 1 raised, [list.nth 1 raised]]
        },
        [arm, ..rest] => {
            let subject = emit (ir.node :local held ir.no_node ir.no_node) l;
            let tested = pattern_test (ast.arm_pattern arm) (list.nth 1 subject) []
                                      (list.head subject);
            let test = list.nth 1 tested;

            // The bindings go into their slots before the guard or the body can
            // name them. The slot is the one resolution gave the binder, found
            // by where it was written.
            let bound = list.fold (fn acc b -> {
                let l0 = list.head acc;
                let s = expand macros.coalesce (slot_at (list.nth 0 b) l0) 0;
                let made = emit (ir.node :bind s (list.nth 1 b) ir.no_node) l0;
                [inherit (list.nth 1 made) [list.nth 1 b] (list.head made),
                 list.append (list.nth 1 acc) [list.nth 1 made]]
            }) [list.nth 0 tested, []] (list.nth 2 tested);

            let taken =
                match ast.arm_guard arm {
                    () => {
                        let body = lower_expr (ast.arm_body arm) (list.head bound);
                        [list.head body, list.append (list.nth 1 bound) [list.nth 1 body]]
                    },
                    g => {
                        let cond = lower_expr g (list.head bound);
                        let forced = set_flag (list.nth 1 cond) ir.f_strict (list.head cond);
                        let body = lower_expr (ast.arm_body arm) forced;
                        // A guard that fails falls through to the arms below,
                        // which is why they are lowered inside the guarded arm
                        // rather than beside it.
                        let fallback = lower_arms rest held span (list.head body);
                        let made = emit (ir.node :if (list.nth 1 cond) (list.nth 1 body)
                                                 (list.nth 1 fallback))
                                        (list.head fallback);
                        [inherit (list.nth 1 made)
                                 [list.nth 1 cond, list.nth 1 body, list.nth 1 fallback]
                                 (list.head made),
                         list.append (list.nth 1 bound) [list.nth 1 made]]
                    },
                };

            let placed = kids (list.nth 1 taken) (list.head taken);
            let block = emit (ir.node :block (list.nth 1 placed) (list.length (list.nth 1 taken))
                                      ir.no_node)
                             (list.head placed);
            let blocked = inherit (list.nth 1 block) (list.nth 1 taken) (list.head block);

            // A guarded arm has folded the rest of them into its guard's false
            // branch, but that does not cover a pattern that fails before the
            // guard is ever asked: the rest must also be reachable from the
            // pattern test's false path, guard or no guard.
            let otherwise = lower_arms rest held span blocked;
            let made = emit (ir.node :if test (list.nth 1 block) (list.nth 1 otherwise))
                            (list.head otherwise);
            [set_flag test ir.f_strict
                (inherit (list.nth 1 made) [test, list.nth 1 block, list.nth 1 otherwise]
                         (list.head made)),
             list.nth 1 made,
             // Where each arm's test starts, and the raise after the last:
             // what a switch in front of the chain jumps to (`dispatch`).
             list.cons (list.nth 1 made) (list.nth 2 otherwise)]
        },
    };

// --- tail calls ------------------------------------------------------------------

/// Flag the calls a function ends with, so the VM can reuse the frame instead
/// of growing the stack -- a loop written as recursion 100k deep should not
/// overflow. Only the positions a function actually finishes in count: the
/// branches of an `if`, the last statement of a block, and the call itself.
let rec mark_tail i l =
    if not (ir.is_node i) { l }
    else {
        let n = ir.node_at i (prog l);
        match ir.node_op n {
            :apply => set_flag i ir.f_tail l,
            :if    => mark_tail (ir.node_c n) (mark_tail (ir.node_b n) l),
            // Every target, which is every value a switch can finish with;
            // the keys in between are atoms and are not calls.
            :switch_head => mark_targets n l,
            :switch_atom => mark_targets n l,
            // A block's value is its last statement, so that is the only
            // child that can be in tail position.
            :block =>
                if ir.node_b n > 0 { mark_tail (ir.kid_at (ir.node_a n + ir.node_b n - 1) (prog l)) l }
                else { l },
            :force => mark_tail (ir.node_a n) l,
            _ => l,
        }
    };

let mark_targets n l =
    fold (fn acc k -> if k % 2 == 1 || k == ir.node_c n - 1 {
                               mark_tail (ir.kid_at (ir.node_b n + k) (prog acc)) acc
                           } else { acc })
              l (list.range 0 (ir.node_c n));

// --- the whole program ---------------------------------------------------------

/// Lower every body the resolver queued.
///
/// The order is the resolver's, which is the loader's: dependencies before
/// whatever uses them. Nothing here depends on that -- a global is an index by
/// now, and an index does not care when it was filled in -- but keeping it means
/// a dump reads in the order the program was written.
/// Intern a string and answer `[lowering, index]`.
let strk : :string -> Lowering -> [Lowering, :integer];
let strk text l = { let got = ir.intern_str text (prog l); [set_prog (list.head got) l, list.nth 1 got] };

/// Push one function's captures into the shared pool and answer where they
/// went. Captures live in the same pool as call arguments and block statements
/// because they are the same thing to a loader: a contiguous run of indices
/// addressed by an offset and a count.
let place_captures caps l = {
    let encoded = list.map (fn c ->
        match c {
            scope.Capture.local(slot) => ir.encode_capture false slot,
            scope.Capture.outer(idx) => ir.encode_capture true idx,
            _ => 0,
        }) caps;
    kids encoded l
};

/// The four `link_*` folds below build their record lists with `_list_cons` and
/// reverse once at the end rather than appending. `list.append xs [x]` is one
/// reduction and a copy of `xs`, so a profile counts none of it and the list
/// costs O(n^2) bytes to build -- these three fold lambdas were, between them,
/// 39% of everything a 3,200-declaration program allocated, and 3.5x what the
/// same program at half the size allocated. See the note over `s_imports_rev`
/// in [scope.dr](scope.dr), which is the same mistake in the other direction.
/// The function records, as an image stores them. The two halves of a function
/// meet here: `scope` knows its name, arity, frame size and captures, and
/// lowering knows which node its body turned out to be.
let link_funcs : scope.Resolution -> :map -> Lowering -> [Lowering, [:map]];
let link_funcs r bodies l = link_funcs_from r bodies l 0;

/// `[path, line, col]` where a function was written, from the places table,
/// or `["", 0, 0]` where there is none -- a session's lowering, a function
/// the compiler made up. The image keeps it so that an error can say which
/// functions it was raised in (`locate_error` in dream/src/interp.cpp).
let func_place : scope.Resolution -> :map -> [:string, :integer, :integer];
let func_place r f = match (places r).[(scope.Function.source f) else ()] {
    () => ["", 0, 0],
    [path, starts, src] => {
        let span = scope.Function.span f;
        let [line, col] = diag.place_in starts (ast.span_start (diag.origin_span src span));
        [path, line, col]
    },
};

/// `link_funcs`, from function index `from` onward, appending to an image
/// `funcs` list the caller already carries. A session links only what one entry
/// added, so the records before them -- and the capture runs their functions
/// placed -- are never rebuilt. `link_funcs` is this with `from` 0 on the empty
/// list, which is why the two share the fold below.
let link_funcs_from : scope.Resolution -> :map -> Lowering -> :integer -> [Lowering, [:map]];
let link_funcs_from r bodies l from = {
    let zip = list.zip (list.drop from (scope.funcs r))
                       (list.range from (list.length (scope.funcs r)));
    let built = list.fold (fn acc pair -> {
        let f = list.nth 0 pair;
        let fi = list.nth 1 pair;
        let l0 = list.head acc;
        let named = strk (scope.func_name f) l0;
        let [path, line, col] = func_place r f;
        let pathed = if line == 0 { [list.head named, -1] } else { strk path (list.head named) };
        let placed = place_captures (scope.func_captures f) (list.head pathed);
        let flags = (if scope.func_impure f { ir.fn_impure } else { 0 })
                  + (if scope.Function.recursive f { ir.fn_rec } else { 0 })
                  + (if (scope.Function.thunk f) { ir.fn_thunk } else { 0 })
                  // A parameterless pure binding is a value the VM forces once
                  // and remembers; an impure one has to run again every time.
                  + (if (scope.Function.thunk f) && not (scope.func_impure f) {
                         ir.fn_global_value
                     } else { 0 });
        [list.head placed,
         list.cons
             %{ :name => list.nth 1 named, :body => bodies.[fi else ir.no_node],
                 :arity => scope.func_arity f, :flags => flags,
                 :slots => scope.func_slots f,
                 :n_captures => list.length (scope.func_captures f),
                 :captures_off => list.nth 1 placed,
                 :line => line, :col => col, :source => list.nth 1 pathed + 1 }
             (list.nth 1 acc)]
    }) [l, []] zip;
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_globals r l = link_globals_from r l 0;

/// `link_globals`, from global record `from` onward, appending to a carried
/// image `globals` list -- the sibling of `link_funcs_from`, same reason.
let link_globals_from : scope.Resolution -> Lowering -> :integer -> [Lowering, [:map]];
let link_globals_from r l from = {
    let fresh = list.drop from (scope.r_global_recs r);
    let built = list.fold (fn acc g -> {
        let named = strk (list.nth 1 g) (list.head acc);
        let is_module = list.nth 2 g == :module;
        [list.head named,
         list.cons
             %{ :name => list.nth 1 named,
                :kind => if is_module { ir.global_module } else { ir.global_function },
                :target => match list.nth 3 g { () => ir.no_node, t => t },
                :flags => ir.g_exported
                          + (if builtins.is_impure_name (list.nth 1 g) { ir.g_impure }
                             else { 0 }) }
             (list.nth 1 acc)]
    }) [l, []] fresh;
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_imports : scope.Resolution -> Lowering -> [Lowering, [:map]];
let link_imports r l = {
    let built = list.fold (fn acc i -> {
        let path = strk (list.nth 0 i) (list.head acc);
        let alias = strk (list.nth 1 i) (list.head path);
        [list.head alias,
         list.cons %{ :path => list.nth 1 path, :alias => list.nth 1 alias }
                   (list.nth 1 acc)]
    }) [l, []] (scope.r_imports r);
    [list.head built, list.reverse (list.nth 1 built)]
};

let link_modules : modules.Loader -> scope.Resolution -> Lowering -> [Lowering, [:map]];
let link_modules ld r l = {
    let built = list.fold (fn acc m -> {
        let mi = list.nth 0 m;
        let mod_at = modules.module_at ld mi;
        let named = strk (modules.module_name mod_at) (list.head acc);
        let src = strk (modules.module_path mod_at) (list.head named);
        [list.head src,
         list.cons
             %{ :name => list.nth 1 named, :source => list.nth 1 src,
                :globals_start => list.nth 1 m, :globals_count => list.nth 2 m,
                :flags => if list.nth 3 m { ir.m_abstract } else { 0 },
                :derives => match list.nth 4 m { () => ir.no_node, d => d } }
             (list.nth 1 acc)]
    }) [l, []] (scope.r_module_recs r);
    [list.head built, list.reverse (list.nth 1 built)]
};

/// The function `main!` compiles to, or nothing. The entry point is a global of
/// the root module, which is the last one loaded -- everything else was loaded
/// because it reached it. The *last* `main!` body wins: a session recompiles
/// its entry point every entry on top of a carried resolution, so the newest
/// body is the one appended last, and a fresh compile has exactly one anyway.
let find_entry ld r = {
    let last = modules.module_count ld - 1;
    let hits = filter (fn b -> list.nth 0 b == last
                                    && scope.decl_name (list.nth 2 b) == "main!")
                           (scope.bodies r);
    if list.is_empty hits { ir.no_node } else { list.nth 3 (list.last hits) }
};

/// Lower every body the resolver queued, then link what comes out.
///
/// The order is the resolver's, which is the loader's: dependencies before
/// whatever uses them. Nothing here depends on that -- a global is an index by
/// now, and an index does not care when it was filled in -- but keeping it means
/// a dump reads in the order the program was written.
/// Force what one body's lowering produced: the arena's two counts, and the
/// table saying which node each function's body became.
///
/// `ir.settle` keeps the arena flat *within* a body, and that is not enough,
/// because nothing forces the accumulator *between* them. Without this the pass
/// answers a suspension per body, nine hundred of them stacked on each other,
/// and forcing the last one walks the whole tower with every intermediate arena
/// still live -- which is how lowering the compiler itself ran the machine out
/// of memory. Forced here, what is carried from one body to the next is an
/// arena, and the one before it is garbage.
let settle_body l =
    if lazy.forced (ir.node_count (prog l)) && lazy.forced (ir.kid_count (prog l))
       && lazy.forced (func_bodies l) { l } else { l };

/// Lower a slice of the resolver's bodies into an arena that may already hold
/// the rest of the program. The narrow heart of the walk in `lower_program`:
/// that pass calls it over everything it resolved, from an empty start, and a
/// session calls it over the one body an entry added, into the arena it
/// carried. Nodes are appended and a node's index never moves, so a carried
/// arena is safe for exactly the reason the whole-program arena always was.
let lower_from : scope.Resolution -> Lowering -> [[:any]] -> Lowering;
let lower_from r low bodies =
    fold (fn acc b -> {
        let src = list.nth 1 b;
        let d = list.nth 2 b;
        let fi = list.nth 3 b;
        let got = lower_body (scope.decl_params d) (scope.decl_body d)
                             (set_ctx (list.nth 0 b) (set_source src acc));
        settle_body (set_func_body fi (list.nth 1 got)
                                  (mark_tail (list.nth 1 got) (list.head got)))
    }) (set_res r low) bodies;

let lower_program : scope.Resolution -> Lowering;
let lower_program r = {
    let walked = lower_from r (lowering r ir.program 0) (scope.bodies r);

    let fs = link_funcs r (func_bodies walked) walked;
    let gs = link_globals r (list.head fs);
    let is = link_imports r (list.head gs);
    let linked = list.head is;

    let p = prog linked
        |> ir.Program.set_funcs (list.nth 1 fs) |> ir.Program.set_globals (list.nth 1 gs)
        |> ir.Program.set_imports (list.nth 1 is);
    ((set_prog p linked) |> Lowering.set_image (ir.finish p))
};

/// Evaluate every compile-time expression the program contains, and put the
/// values where the placeholders were.
///
/// Done after linking, because an expression may call anything in the program
/// and so needs the whole of it to be runnable first. Each one is run against
/// an image of the program with that expression as the entry point -- the
/// dependencies are replaced with constants before their users run.
/// Follow execution-tree references, including called functions and closures,
/// until another comp placeholder is reached. Stop there: its own dependencies
/// are settled before it is evaluated. The visited set also bounds recursion.
let rec comp_dependencies todo seen found pending p funcs globals = match todo {
    [] => found,
    [index, ..rest] =>
        if not (ir.is_node index) || map.has index seen {
            comp_dependencies rest seen found pending p funcs globals
        } else if map.has index pending {
            comp_dependencies rest (seen.[index => true]) (list.cons index found) pending p funcs globals
        } else {
            let n = ir.node_at index p;
            let op = ir.node_op n;
            let direct = map (fn k -> opt.operand k n) (opt.edges_of op);
            let run = match opt.run_of op {
                () => [],
                [offset, count, width] => map (fn i -> ir.kid_at i p)
                    (list.range (opt.operand offset n)
                        (opt.operand offset n + opt.operand count n * width)),
            };
            let function_body fi = if ir.is_node fi { [funcs.[fi].[:body]] } else { [] };
            let called = match op {
                :global => {
                    let g = globals.[ir.node_a n];
                    if g.[:kind] == ir.global_function { function_body g.[:target] } else { [] }
                },
                :make_closure => function_body (ir.node_a n),
                :make_thunk => function_body (ir.node_a n),
                _ => [],
            };
            comp_dependencies (direct + run + called + rest) (seen.[index => true]) found
                              pending p funcs globals
        },
};

/// Every function a compile-time expression can reach: its own, and whatever
/// its nodes name -- a function global, a closure, a thunk -- followed the whole
/// way down. The answer is a set of function indices.
let rec comp_reach todo seen fns p funcs globals = match todo {
    [] => fns,
    [index, ..rest] =>
        if not (ir.is_node index) || map.has index seen {
            comp_reach rest seen fns p funcs globals
        } else {
            let n = ir.node_at index p;
            let op = ir.node_op n;
            let direct = map (fn k -> opt.operand k n) (opt.edges_of op);
            let run = match opt.run_of op {
                () => [],
                [offset, count, width] => map (fn i -> ir.kid_at i p)
                    (list.range (opt.operand offset n)
                        (opt.operand offset n + opt.operand count n * width)),
            };
            let fi = match op {
                :global => {
                    let g = globals.[ir.node_a n];
                    if g.[:kind] == ir.global_function { g.[:target] } else { ir.no_node }
                },
                :make_closure => ir.node_a n,
                :make_thunk => ir.node_a n,
                _ => ir.no_node,
            };
            let fresh = ir.is_node fi && not (map.has fi fns);
            let called = if fresh { [funcs.[fi].[:body]] } else { [] };
            comp_reach (direct + run + called + rest) (seen.[index => true])
                       (if fresh { fns.[fi => true] } else { fns }) p funcs globals
        },
};

/// The image compile-time expressions are run against: the program cut down to
/// what they can reach. Compile-time contracts are run the same way
/// (`contract.batch_image`), with their batch as the one root.
///
/// It used to be the whole program, serialized as lowered, and that was most
/// of what a compile-time expression cost -- on a self-compile, six one-line
/// `comp`s paid for writing out 142,000 nodes, a second of the compile, to run
/// code that touches a few hundred of them. An expression can only ever run
/// what its nodes name, so every other function is given one shared body that
/// raises, and the optimizer, which copies only what a body reaches, drops the
/// rest of the arena on the way to the image. An incomplete answer here would
/// be loud rather than wrong: a function it missed raises when called, and the
/// `comp` is reported as failing to evaluate.
///
/// Running the optimized arena rather than the lowered one is the same
/// program: `opt` is the pass every build runs before its image is written.
let comp_image : [:integer] -> Lowering -> :string;
let comp_image fis l = if in_parts l { parts_image fis l } else { whole_image fis l };

let whole_image fis l = {
    let p = prog l;
    let funcs = array.of_list (ir.funcs p);
    let globals = array.of_list (ir.globals p);
    let reached = comp_reach (list.map (fn fi -> funcs.[fi].[:body]) fis) %{}
                             (list.fold (fn m fi -> m.[fi => true]) %{} fis)
                             p funcs globals;
    let [l1, one] = const_int 1 l;
    let [l2, zero] = const_int 0 l1;
    let [l3, stub] = emit (ir.node :div one zero ir.no_node) l2;
    let img = ir.finish (prog l3);
    let cut = map (fn pair -> {
        let [fi, f] = pair;
        if map.has fi reached { f } else { f.[:body => stub] }
    }) (list.zip (list.range 0 (list.length (ir.Image.funcs img))) (ir.Image.funcs img));
    emit.to_binary (opt.optimize (ir.Image.set_funcs cut img))
};

/// Settle them in an order where nothing is evaluated before what it reads.
///
/// `built` is the serialized image the next evaluation runs against, and the
/// whole of the cost here is how often it has to be made again. Building one
/// is `ir.finish` plus `emit.to_binary`, and both are the size of the
/// *program* rather than of the expression -- so one per compile-time
/// expression is the program's size times however many there are. On a
/// self-compile that was 30% of every reduction the compiler made.
///
/// It almost never has to be rebuilt. Settling one overwrites its
/// placeholder, and the only thing that can read that placeholder is an
/// expression which depends on it -- so the image stays good until a
/// dependency of something still waiting has been settled. A program whose
/// compile-time expressions are independent of each other, which is nearly
/// all of them, builds exactly one, and the rest are that one with four
/// bytes of header changed.
let rec settle_comp_order! rows done built l =
    if list.is_empty rows { l }
    else {
        let ready = list.filter (fn row -> list.all (fn node -> map.has node done) row.[1]) rows;
        if list.is_empty ready {
            complain ast.no_span "cyclic dependency between compile-time expressions" l
        } else {
            let row = list.head ready;
            let one = row.[0];
            // Each evaluation sees the constants its dependencies installed,
            // rather than the original image full of unit placeholders.
            let image = match built {
                () => comp_image (map (fn r -> r.[0].[1]) rows) l,
                ready_made => ready_made,
            };
            let settled = settle_comp! (fn fi -> emit.with_entry image fi) one l;
            if list.length (l_diags settled) > list.length (l_diags l) { settled }
            else {
                let rest = list.filter (fn r -> r.[0].[0] != one.[0]) rows;
                let wanted = list.any (fn r -> list.contains one.[0] r.[1]) rest;
                settle_comp_order! rest (done.[one.[0] => true])
                                   (if wanted { () } else { image }) settled
            }
        }
    };

let settle_comps! : Lowering -> Lowering;
let settle_comps! l = {
    let pend = pending_comp l;
    if list.is_empty pend { l }
    else if in_parts l { settle_parts_comps! l }
    else {
        let p = prog l;
        let funcs = array.of_list (ir.funcs p);
        let globals = array.of_list (ir.globals p);
        let pending = fold (fn m one -> m.[one.[0] => true]) %{} pend;
        let rows = map (fn one -> [one,
            comp_dependencies [funcs.[one.[1]].[:body]] %{} [] pending p funcs globals]) pend;
        settle_comp_order! rows %{} () l
    }
};

/// The whole thing, with the module table an image also needs. The loader is
/// wanted here and nowhere else, which is why it is a separate way in rather
/// than an argument threaded through every step.
let link! : modules.Loader -> scope.Resolution -> Lowering;
let link! ld r = link_rest! ld r (lower_program (with_places ld r));

/// Everything after the arena is built and its functions linked: the
/// compile-time expressions, the module table and the entry point.
let link_rest! ld r lowered = {
    // Not when the program has already failed. An expression evaluated now
    // runs the program as it was lowered, and a name that did not resolve was
    // lowered to `()` -- so all it can do is raise a second error after the
    // one that matters, or, where a loop or a recursion reads one, not finish
    // at all. The build is failing either way. Contracts were already checked
    // only on a program without errors (`type_diags!` in compile.dr); see "A
    // program that does not resolve ran the machine out of memory" in
    // docs/notes/macro-expansion.md for the macro half of the same mistake.
    let low = if diag.error_count (all_diags r lowered) > 0 { lowered }
              else { settle_comps! lowered };
    let ms = link_modules ld r low;
    let named = strk (modules.module_name (modules.module_at ld
                          (modules.module_count ld - 1)))
                     (list.head ms);
    let sourced = strk (modules.module_path (modules.module_at ld
                            (modules.module_count ld - 1)))
                       (list.head named);
    let p = prog (list.head sourced)
        |> ir.Program.set_modules (list.nth 1 ms) |> ir.Program.set_entry (find_entry ld r)
        |> ir.Program.set_module_name (list.nth 1 named) |> ir.Program.set_source_name (list.nth 1 sourced);
    ((set_prog p (list.head sourced)) |> Lowering.set_image (ir.finish p))
};

// --- lowering in parts -----------------------------------------------------------
//
// Lowering a body needs the resolution and nothing else -- not the arena, not
// any other body -- so a program can be lowered in several processes at once,
// each into an arena of its own. On a self-compile that is 2.2 s of work that
// takes 0.6 s on four cores. What had to be true for that is the design:
//
//   - **The resolution crosses by pointer.** Each process needs all of it, and
//     copying it into four of them was 0.43 s -- most of what the split saves.
//     `vm.share!` puts it in the runtime's shared area once, and a `spawn!`
//     whose work holds it copies a pointer (`SharedArea` in dream/src/heap.hpp).
//     The parts come back the same way.
//   - **The parts are dealt round-robin, and the count is fixed.** Bodies
//     differ threefold in how many nodes a byte of their source becomes, so
//     contiguous slices of equal source were a third apart, and the slowest
//     one is the stage. Dealt one at a time they come out within 12% of each
//     other. The count is `part_count` and not the number of cores, because
//     which part a body is in decides how the merged constant pools are
//     numbered, and an image must not depend on the machine that built it.
//   - **Each body is shared into its part as soon as it is lowered.** A body
//     is lowered into an arena of its own, where a flag can still be set on a
//     node already emitted -- lowering does that constantly -- and once it is
//     finished, and its flags with it, the optimizer rebuilds it into the
//     part's table of everything the part has emitted (`opt.enter_body`), and
//     the arena is dropped. The constant pools carry on from body to body.
//     A part comes back a third of what it lowered, and no table of a whole
//     part's unshared nodes is ever built -- which is what the arena used to
//     be, and was most of what lowering allocated.
//   - **Sharing across the parts is one process's work, started the moment
//     they are joined** (`share_parts_elsewhere!`, `opt.optimize_parts`),
//     reading the parts where they lie: nothing lays them out end to end
//     first. It is 0.7 s, and this process spends it settling the `comp`s and
//     checking the types.
//   - **Nothing here needs the whole arena.** A `comp` or a compile-time
//     contract runs against an image of what it can reach, and that is made
//     from the parts too; see "running what was lowered in parts".
//
// Compile-time expressions are settled after the parts are shared, so a
// placeholder must survive two rebuilds as itself -- and a bare `unit` would
// be shared with every other one. So a placeholder carries its function's
// index (see the `comp` case of `lower_expr`), which keeps it distinct and
// lets it be found in the shared image, where `patched` overwrites it.
//
// What a part says about itself -- a diagnostic, a pending expression -- is
// kept against the position of the body that said it, and put back in that
// order, so a program lowered in parts reports exactly what one lowered whole
// does, in the same order.

/// How many parts a program is lowered in. See above for why it is fixed.
let part_count : :integer;
let part_count = 4;

/// Lower some of the program's bodies, `[position, body]` each, into an arena
/// of their own, share it, and answer the part `link_parts` merges.
let lower_part : scope.Resolution -> [[:any]] -> :map;
let lower_part r numbered = {
    let walked = list.fold (fn acc nb -> {
        let [low, shared, bodies, notes] = acc;
        // A fresh arena for every body: the constant pools are the part's and
        // carry on, and everything else is this body's and is thrown away once
        // it has been shared into the part.
        let cleared = ((set_prog (ir.cleared (prog low)) low)
            |> Lowering.set_diags ([])
            |> Lowering.set_pending_comp ([])
            |> Lowering.set_func_bodies (%{}));
        let done = lower_from r cleared [list.nth 1 nb];
        let p = prog done;
        // In the table's own order: a part's numbering is its own business,
        // and sharing the parts renumbers every node in function order anyway.
        let roots = map.pairs (func_bodies done);
        let rebuilt = fold (fn st pair -> {
            let got = opt.rebuild (list.nth 1 pair) (list.head st);
            [list.head got, (list.nth 1 st).[list.head pair => list.nth 1 got]]
        }) [opt.enter_body (ir.nodes p) (ir.kids p) (opt.type_ids_in (ir.strs p) (ir.atoms p)) shared,
            bodies] roots;
        let said = l_diags done;
        let waiting = pending_comp done;
        let noted = if list.is_empty said && list.is_empty waiting { notes }
                    else { list.cons [list.head nb, said, waiting] notes };
        let next = opt.settle (list.head rebuilt);
        let found = list.nth 1 rebuilt;
        // Forced before they are carried, for the reason `lazy.forced` gives: a
        // suspended one would hold the state of the body before it.
        if lazy.forced noted && lazy.forced done && lazy.forced found {
            [done, next, found, noted]
        } else { [done, next, found, noted] }
    }) [set_res r (lowering r ir.program 0), opt.state #[] #[], %{}, []] numbered;
    let [low, shared, bodies, notes] = walked;
    let p = prog low;
    %{ :nodes => list.reverse (opt.out shared),
       :kids => list.reverse (opt.out_kids shared),
       :bodies => list.sort_on (fn pair -> list.head pair) (map.pairs bodies),
       :ints => ir.pool_list (ir.ints p), :floats => ir.pool_list (ir.floats p),
       :strs => ir.pool_list (ir.strs p), :atoms => ir.pool_list (ir.atoms p),
       :notes => list.reverse notes }
};

/// A process lowering one part, handed a resolution that is already shared.
/// Its own function so that the suspension `spawn!` copies holds the
/// resolution and the slice and nothing else; the part comes back shared, so
/// joining it is a pointer too.
/// The cache is strict: see `scope.walk_elsewhere!` for what an unforced
/// argument carried into every part's process.
let part_elsewhere! !cache r slice = spawn! $( vm.share! (lower_unit! cache (lowering_key cache r slice) r slice) );

/// What a part is lowered against besides its own walk: the wrappers it
/// reaches, as a key. Only those -- a literal in a wrapper keeps its span,
/// which a call site lowered from it carries into the image, so a wrapper
/// moving does change its callers; keyed on the whole table, one character
/// typed anywhere above a wrapper re-lowered every part in the program.
/// Worked out in the part's own process: worked out in the one that starts
/// them, it was every part's key one after another before any part began.
/// The line starts of the part's own files are in it as well, because a failed
/// `match` reports its line (see "a failed match").
let lowering_key : unit.Cache -> scope.Resolution -> [:any] -> :string | :unit;
let lowering_key cache r slice = match cache {
    () => (),
    _ => match scope.unit_key r {
        () => (),
        walk => unit.key ["lower", walk, unit.digest (reached_wrappers (scope.wrappers r) r),
                          unit.digest (places_key r slice)],
    },
};

/// Lower one part, or read it back: see "a part as a unit" in `scope`. A
/// part's lowering is a function of its walk -- whose key covers the declared
/// program and the part's bodies -- and of the wrappers of the whole program,
/// which every part lowers against; `k` is made of those two. Positions are
/// counted from the part's first body for the reason the walk's are.
let lower_unit! cache k r slice = match [cache, slice] {
    [(), _] => lower_part r slice,
    [_, []] => lower_part r slice,
    [_, [[from, .._], .._]] => {
        let local = unit.shifted (0 - from) slice;
        let lowered = match unit.recall! cache "lower" k {
            () => {
                let part = lower_part r local;
                unit.keep! cache "lower" k part
                part
            },
            kept => kept,
        };
        lowered.[:notes => unit.shifted from (lowered.[:notes])]
    },
};

/// Lower the whole program in parts and link it: what `link!` does, in
/// `part_count` processes. Each part comes back shared within itself.
let link_parallel! : modules.Loader -> scope.Resolution -> :any -> Lowering;
let link_parallel! ld r cache = {
    let rs = vm.share! (with_places ld r);
    // A resolution made in parts is lowered in the same parts, each against
    // the part that walked it -- which is the only one that knows what its
    // names mean (`scope.parts`) -- with the wrappers of the whole program.
    // One resolved whole is dealt out here instead.
    let work = match scope.parts rs {
        () => {
            let all = scope.bodies rs;
            let numbered = list.zip (list.range 0 (list.length all)) all;
            map (fn k -> [rs, filter (fn nb -> list.head nb % part_count == k) numbered])
                     (list.range 0 part_count)
        },
        walked => {
            let wrappers = vm.share! (scope.wrappers rs);
            let where = vm.share! (places rs);
            list.map (fn pr -> [(pr
                |> scope.Resolution.set_wrappers wrappers
                |> scope.Resolution.set_places where), scope.part_bodies pr]) walked
        },
    };
    // Dealt before any process starts: a slice left lazy would cross into its
    // child as a suspension holding every body, and be dealt there.
    strict! work
    let running = strict! (list.map (fn w -> part_elsewhere! cache (list.head w) (list.nth 1 w)) work);
    let parts = progress.join_all! "lowering" running;
    let offsets = list.map (fn w -> scope.part_offsets (list.head w)) work;
    let head = link_head rs offsets parts;
    // Sharing across the parts starts now, in a process of its own, and runs
    // while this one settles the `comp`s and checks the types: see `patched`.
    let sharing = share_parts_elsewhere! (vm.share! (for_sharing rs head));
    // What each body said, back in the order of the bodies, with a waiting
    // expression's function moved as the part's functions were.
    let oa = array.of_list offsets;
    let pa = array.of_list parts;
    let notes = list.sort_on (fn note -> list.head note) (list.concat (list.map (fn k -> {
        let fo = list.head (oa.[k]);
        list.map (fn note -> {
            let [position, said, waiting] = note;
            [position, said, list.map (fn one -> {
                let [_, fi, src, span] = one;
                [ir.no_node, fi + fo, src, span]
            }) waiting]
        }) ((pa.[k]).[:notes])
    }) (list.range 0 (list.length parts))));
    let said = list.concat (map (fn note -> list.nth 1 note) notes);
    let waiting = list.concat (map (fn note -> list.nth 2 note) notes);
    let lowered = ((set_prog (head.[:prog]) (head.[:base]))
        |> Lowering.set_diags said
        |> Lowering.set_pending_comp waiting
        |> Lowering.set_arenas (head.[:arenas])
        |> Lowering.set_invented_from (scope.invented_from rs));
    let linked = ((link_rest! ld rs lowered) |> Lowering.set_sharing sharing);
    // The image, should anything ask for it without the sharing process's --
    // the process failed, or the build did. Lazy, and shared here, in this
    // process: the parts are never laid out any other way.
    (linked |> Lowering.set_image (patched linked (opt.optimize_parts (list.head (for_sharing rs head))
                                                          (head.[:arenas]) (scope.invented_from rs))))
};

/// The wrappers a part's names reach, and the wrappers those stand for, as
/// `[global, wrapper]` sorted: what its lowering reads of the table.
let reached_wrappers all r = {
    let used = fold (fn m [_, meaning] -> match meaning {
        scope.Meaning.global(_, _, gi) if gi != () => m.[gi => true],
        scope.Meaning.member(_, _, gi) if gi != () => m.[gi => true],
        _ => m,
    }) (%{}) (map.pairs (scope.refs r));
    let rec close seen todo = match todo {
        [] => seen,
        [gi, ..rest] => match all.[gi else ()] {
            () => close seen rest,
            w => {
                let next = scope.target_global (list.head w);
                if map.has gi seen { close seen rest }
                else { close (seen.[gi => w]) (list.cons next rest) }
            },
        },
    };
    list.sort_on list.head (map.pairs (close (%{}) (map.keys used)))
};

/// Whether this lowering was made in parts, and so has no arena of its own:
/// only the parts, and a small table of nodes it emitted itself.
let in_parts l = (Lowering.arenas l) != ();

/// The process sharing this lowering's parts, if it was lowered in parts.
let sharing l = Lowering.sharing l;

/// What the sharing process is handed: the linked program's records, as an
/// image whose functions name their bodies where the parts hold them, the
/// parts, and where invented globals start. Everything in it is shared before
/// it crosses, so starting the process is a pointer.
let for_sharing r head = [ir.finish_rest (head.[:prog]), head.[:arenas], scope.invented_from r];

/// A process sharing the parts into one arena while this one settles the
/// `comp`s and checks the types. The shared image comes back with every `comp`
/// placeholder still in it, for `patched` to fill. A raise in it answers
/// `:crashed`, and the image is shared in this process instead.
let share_parts_elsewhere! work =
    spawn! $( try! { vm.share! (opt.optimize_parts (list.nth 0 work) (list.nth 1 work) (list.nth 2 work)) }
              catch e { [:crashed, e] } );

/// The image the sharing process answered, finished: its `comp` placeholders
/// replaced by what they came to, and the tables `link_rest!` added after it
/// started -- the modules, the entry, the names -- taken from this lowering.
///
/// The process started from this lowering's constant pools as they stood
/// before any `comp` was settled, and settling only ever *adds* to a pool, so
/// every constant its image names means the same in the pools here. Each value
/// is lowered again into the shared image, which interns nothing new -- this
/// lowering already did -- and the placeholder is overwritten, as
/// `settle_comp!` does in the arena it settles.
///
/// The patching is done on empty tables that count from where the shared arena
/// ends: settling a `comp` appends its value's nodes and overwrites one
/// placeholder, and reads nothing already there. So what it wrote is laid over
/// the arena's lists afterwards (`overlaid`) rather than the whole arena being
/// turned into tables to be written and flattened back -- which was most of
/// the time a warm build of a large program spent after sharing, and all of it
/// for a build with no `comp` in it.
let patched : Lowering -> ir.Image -> ir.Image;
let patched l img = {
    let p = prog l;
    let nodes = ir.Image.nodes img;
    let kids = ir.Image.kids img;
    let n_nodes = list.length nodes;
    let n_kids = list.length kids;
    let tables = p |> ir.Program.set_nodes %{} |> ir.Program.set_node_count n_nodes
                   |> ir.Program.set_kids %{} |> ir.Program.set_kid_count n_kids
                   |> ir.Program.set_funcs (ir.Image.funcs img);
    let placed = list.head (list.fold (fn acc n -> {
        let [m, i] = acc;
        [if ir.node_op n == :unit && ir.is_node (ir.node_a n) { m.[ir.node_a n => i] } else { m }, i + 1]
    }) [%{}, 0] nodes);
    let values = comp_values l;
    let filled = fold (fn acc one -> {
        let [_, fi, src, span] = one;
        match values.[comp_key src span else ()] {
            () => acc,
            v => {
                let built = emit_const v acc;
                let at = placed.[fi else ir.no_node];
                if not (ir.is_node at) { list.head built }
                else {
                    set_prog (ir.set_node at (ir.node_at (list.nth 1 built) (prog (list.head built)))
                                         (prog (list.head built)))
                             (list.head built)
                }
            },
        }
    }) (set_prog tables l) (pending_comp l);
    let q = prog filled;
    ir.finish_rest q
        |> ir.Image.set_nodes (overlaid nodes (ir.nodes q) n_nodes (ir.node_count q) (ir.leaf :nop))
        |> ir.Image.set_kids (overlaid kids (ir.kids q) n_kids (ir.kid_count q) ir.no_node)
};

/// `xs`, the first `n` entries of an arena, with what a table wrote over them
/// and after them, up to `count`: the arena `ir.finish` would have flattened
/// from one table holding both.
let overlaid xs written n count fill =
    if len written == 0 { xs }
    else {
        list.append (map (fn ix -> written.[list.head ix else list.nth 1 ix]) (list.zip (list.range 0 n) xs))
                    (map (fn i -> written.[i else fill]) (list.range n count))
    };

// --- running what was lowered in parts ----------------------------------------
//
// A `comp` and a compile-time contract are run against an image of the
// program cut down to what they can reach (`comp_image`), and a program
// lowered in parts has no arena to cut it from -- deliberately: laying the
// parts out as one was 0.4 s on the critical path, and the only thing that
// needed it was this. So the image is made from the parts directly: which
// functions the roots reach is walked across the parts, every other function
// is the shared stub, and `opt.optimize_parts` -- the rebuild the sharing
// process makes of the whole program -- makes the image from what is left.
//
// What this lowering emits itself -- the stub, a contract's formula, a
// `comp`'s value -- goes into its own small arena, which is part 0 of the
// parts (the part the functions' captures are in already). A settled `comp`
// is not written over its placeholder, since the placeholder is in a part and
// the parts are not this lowering's to change; `:filled` says which part-0
// node stands for it, and the rebuild reads that node wherever the
// placeholder is.

/// The parts, with part 0 as this lowering's own arena now.
let current_arenas l = {
    let p = prog l;
    (Lowering.arenas l).[0 => ((Lowering.arenas l).[0] |> ir.Program.set_nodes (ir.nodes p) |> ir.Program.set_kids (ir.kids p))]
};

/// What the functions `todo` start from can reach, walked across the parts:
/// `[functions, placeholders]`, the second the `comp` placeholders met on the
/// way, by the function each waits on. A node is `part * opt.part_base + i`.
let rec reach_parts todo seen fns met arenas funcs globals invented_from = match todo {
    [] => [fns, met],
    [key, ..rest] =>
        if not (ir.is_node key) || map.has key seen {
            reach_parts rest seen fns met arenas funcs globals invented_from
        } else {
            let k = key / opt.part_base;
            let part = arenas.[k];
            let at = k * opt.part_base;
            let n = (part.[:nodes]).[key % opt.part_base else (ir.leaf :nop)];
            let op = ir.node_op n;
            let fo = part.[:fo else 0];
            let direct = map (fn e -> {
                let v = opt.operand e n;
                if ir.is_node v { at + v } else { v }
            }) (opt.edges_of op);
            let run = match opt.run_of op {
                () => [],
                [off_at, count_at, width] => map (fn t -> {
                    let kid = (part.[:kids]).[opt.operand off_at n + t else ir.no_node];
                    if ir.is_node kid { at + kid } else { kid }
                }) (list.range 0 (opt.operand count_at n * width)),
            };
            let fi = match op {
                :global => {
                    let a = ir.node_a n;
                    let g = globals.[if k > 0 && a >= invented_from { a + part.[:go else 0] } else { a }];
                    if g.[:kind] == ir.global_function { g.[:target] } else { ir.no_node }
                },
                :make_closure => ir.node_a n + fo,
                :make_thunk => ir.node_a n + fo,
                _ => ir.no_node,
            };
            let waits = if op == :unit && ir.is_node (ir.node_a n) { met.[ir.node_a n + fo => true] } else { met };
            let fresh = ir.is_node fi && not (map.has fi fns);
            let called = if fresh { [(funcs.[fi]).[:body]] } else { [] };
            reach_parts (direct + run + called + rest) (seen.[key => true])
                        (if fresh { fns.[fi => true] } else { fns }) waits
                        arenas funcs globals invented_from
        },
};

/// `comp_image` for a lowering made in parts.
let parts_image fis l = {
    let [l1, one] = const_int 1 l;
    let [l2, zero] = const_int 0 l1;
    let [l3, stub] = emit (ir.node :div one zero ir.no_node) l2;
    let p = prog l3;
    let funcs = array.of_list (ir.funcs p);
    let reached = list.head (reach_parts (list.map (fn fi -> (funcs.[fi]).[:body]) fis) %{}
                                         (list.fold (fn m fi -> m.[fi => true]) %{} fis) %{}
                                         (current_arenas l3) funcs (array.of_list (ir.globals p))
                                         (Lowering.invented_from l));
    let cut = map (fn pair -> {
        let [fi, f] = pair;
        if map.has fi reached { f } else { f.[:body => stub] }
    }) (list.zip (list.range 0 (list.length (ir.funcs p))) (ir.funcs p));
    emit.to_binary (opt.optimize_parts_filled (ir.Image.set_funcs cut (ir.finish_rest p)) (current_arenas l3)
                                              (Lowering.invented_from l) (Lowering.filled l))
};

/// The `comp` placeholders the function `fi`'s body can reach: the
/// expressions that have to be settled before it can be run.
let parts_dependencies fi l = {
    let p = prog l;
    let funcs = array.of_list (ir.funcs p);
    let met = list.nth 1 (reach_parts [(funcs.[fi]).[:body]] %{} (%{fi => true}) %{} (current_arenas l)
                                      funcs (array.of_list (ir.globals p)) (Lowering.invented_from l));
    map (fn kv -> list.head kv) (map.pairs met)
};

/// `settle_comps!` for a lowering made in parts: the same order, the same
/// images, but a value is written into this lowering's own arena and recorded
/// against its function (`:filled`) rather than over its placeholder.
let settle_parts_comps! l = {
    let pend = pending_comp l;
    let waiting = fold (fn m one -> m.[one.[1] => true]) %{} pend;
    let rows = map (fn one -> [one, filter (fn fi -> map.has fi waiting && fi != one.[1])
                                                     (parts_dependencies (one.[1]) l)]) pend;
    settle_parts_order! rows %{} () l
};

let rec settle_parts_order! rows done built l =
    if list.is_empty rows { l }
    else {
        let ready = list.filter (fn row -> list.all (fn fi -> map.has fi done) row.[1]) rows;
        if list.is_empty ready {
            complain ast.no_span "cyclic dependency between compile-time expressions" l
        } else {
            let row = list.head ready;
            let one = row.[0];
            let fi = one.[1];
            let image = match built {
                () => parts_image (list.map (fn r -> r.[0].[1]) rows) l,
                ready_made => ready_made,
            };
            let settled = settle_part_comp! (emit.with_entry image fi) one l;
            if list.length (l_diags settled) > list.length (l_diags l) { settled }
            else {
                let rest = list.filter (fn r -> r.[0].[1] != fi) rows;
                let wanted = list.any (fn r -> list.contains fi r.[1]) rest;
                settle_parts_order! rest (done.[fi => true]) (if wanted { () } else { image }) settled
            }
        }
    };

/// A `comp` whose evaluation raised, as what its `try!` caught. A record of the
/// compiler's own, so that no value a program can produce -- the list
/// `[:comp_error, e]` was one -- is taken for a failure.
struct Raised { why }

/// The failure of a `comp`, reported where it is written. It used to be
/// reported with no span at all, which for a compile-time API is the difference
/// between "this call is wrong" and "something in the program is".
let comp_failed src span why l =
    (l |> Lowering.set_diags (list.append (l_diags l)
                    [diag.in_source src (diag.error span
                        ("this compile-time expression could not be evaluated: " + to_string why))]));

/// `settle_comp!` for a lowering made in parts: see `settle_parts_comps!`.
let settle_part_comp! bytes one l = {
    let [_, fi, src, span] = one;
    let value = try! { vm.eval_image! bytes } catch e { Raised.make e };
    match value {
        Raised(why) => comp_failed src span why l,
        v => {
            let built = emit_const v l;
            let placed = ((list.head built)
                |> Lowering.set_filled ((Lowering.filled (list.head built)).[fi => list.nth 1 built]));
            (placed |> Lowering.set_comp_values ((comp_values placed).[comp_key src span => v]))
        },
    }
};

/// Intern every value of a part's pool into the program's: `[program, the
/// program's index for each of the part's, in order]`.
let intern_each intern vs p = {
    let got = list.fold (fn acc v -> {
        let one = intern v (list.head acc);
        [list.head one, list.cons (list.nth 1 one) (list.nth 1 acc)]
    }) [p, []] vs;
    [list.head got, array.of_list (list.reverse (list.nth 1 got))]
};

/// An atom as a part stored it -- the index of its name in the part's string
/// pool -- interned into the program's atom pool by the name's index there.
let intern_atom_at strs si p = {
    let got = ir.intern (strs.[si]) (ir.atoms p);
    [ir.Program.set_atoms (list.head got) p, list.nth 1 got]
};

/// The linked program of a lowering made in parts, before anything in it has
/// been laid out: the constant pools merged, every function's record linked
/// against where its body lies in the parts, and the parts as
/// `opt.optimize_parts` reads them: `%{ :prog, :base, :arenas }`.
let link_head : scope.Resolution -> [[:integer, :integer]] -> [:map] -> :map;
let link_head r offsets parts = {
    // Arrays, since each is read by a part's index in a loop over the parts:
    // a list read that way is a walk to the part, every time, and the loop
    // quadratic in the number of modules.
    let pa = array.of_list parts;
    let oa = array.of_list offsets;
    // The constant pools, part by part, and each part's table from its own
    // indices to the program's.
    let pooled = list.fold (fn acc part -> {
        let p0 = list.head acc;
        let [p1, ints] = intern_each ir.intern_int (part.[:ints]) p0;
        let [p2, floats] = intern_each ir.intern_float (part.[:floats]) p1;
        let [p3, strs] = intern_each ir.intern_str (part.[:strs]) p2;
        let [p4, atoms] = intern_each (fn si q -> intern_atom_at strs si q) (part.[:atoms]) p3;
        [p4, list.cons %{ :ints => ints, :floats => floats, :strs => strs, :atoms => atoms }
                       (list.nth 1 acc)]
    }) [ir.program, []] parts;
    let ra = array.of_list (list.reverse (list.nth 1 pooled));
    // Every function's body, as the part it is in and its node there -- part
    // k is `k + 1` here, part 0 being this lowering's own arena -- and under
    // the function's index in the whole program: a part numbers its functions
    // from where the declarations left off, and is moved past the parts before
    // it (see "resolving in parts" in `scope`).
    let bodies = list.fold (fn m k -> {
        let fo = list.head (oa.[k]);
        list.fold (fn m2 fb -> m2.[list.head fb + fo => ((k + 1) * opt.part_base + list.nth 1 fb)])
                  m ((pa.[k]).[:bodies])
    }) %{} (list.range 0 (list.length parts));
    let base = set_res r (lowering r (list.head pooled) 0);
    let fs = link_funcs r bodies base;
    let gs = link_globals r (list.head fs);
    let is = link_imports r (list.head gs);
    let p = prog (list.head is)
        |> ir.Program.set_funcs (list.nth 1 fs) |> ir.Program.set_globals (list.nth 1 gs)
        |> ir.Program.set_imports (list.nth 1 is);
    let arenas = array.of_list (list.cons %{ :nodes => ir.nodes p, :kids => ir.kids p }
        (list.map (fn k -> %{ :nodes => array.of_list ((pa.[k]).[:nodes]),
                              :kids => array.of_list ((pa.[k]).[:kids]),
                              :remap => ra.[k],
                              :fo => list.head (oa.[k]), :go => list.nth 1 (oa.[k]) })
                  (list.range 0 (list.length parts))));
    %{ :prog => p, :base => base, :arenas => arenas }
};

// --- compile-time values ------------------------------------------------------
//
// What an expression came to, turned back into nodes. A compile-time value is
// data -- that is what makes it something an image can hold -- so this is a
// walk over the shapes data comes in, and nothing else needs to be handled: the
// evaluator refuses to hand back a closure or a process in the first place.

let emit_const : :any -> Lowering -> [Lowering, :integer];
let rec emit_const v l =
    match type_of v {
        :integer => const_int v l,
        :float   => const_float v l,
        :tensor  => {
            let [l1, shape] = emit_const (tensor.shape v) l;
            let [l2, bytes] = const_str (tensor.to_bytes v) l1;
            call_builtin "_tensor_of_bytes" [shape, bytes] l2
        },
        :string  => const_str v l,
        :char    => const_char v l,
        :bool    => const_bool v l,
        :unit    => emit_leaf :unit l,
        :atom    => const_atom (atom.name v) l,
        :list    => const_seq :make_list (list.map (fn x -> x) v) l,
        :array   => const_seq :make_array (array.to_list v) l,
        :map     => const_seq :make_map
                        (list.concat (map (fn kv -> [list.nth 0 kv, list.nth 1 kv])
                                               (map.pairs v))) l,
        _ => match types.record_id v {
            () => emit_leaf :unit l,
            id => const_record (atom.name id) (types.record_fields v) (types.is_variant v) l,
        },
    };

/// A record a compile-time expression made, as the constructor would have
/// made it: one `record_make` of its fields.
let rec const_record id fields variant l = {
    let done = list.fold (fn acc x -> {
        let got = emit_const x (list.head acc);
        [list.head got, list.append (list.nth 1 acc) [list.nth 1 got]]
    }) [l, []] fields;
    let placed = kids (list.nth 1 done) (list.head done);
    let [program, index] = ir.intern_atom id (prog (list.head placed));
    emit (ir.node :record_make (list.nth 1 placed) (list.length fields)
                  (if variant { index + ir.record_variant } else { index }))
         (set_prog program (list.head placed))
};

let rec const_seq op items l = {
    let done = list.fold (fn acc x -> {
        let got = emit_const x (list.head acc);
        [list.head got, list.append (list.nth 1 acc) [list.nth 1 got]]
    }) [l, []] items;
    let placed = kids (list.nth 1 done) (list.head done);
    let n = if op == :make_map { list.length items / 2 } else { list.length items };
    emit (ir.node op (list.nth 1 placed) n ir.no_node) (list.head placed)
};

/// Evaluate one compile-time expression and put what it came to where the
/// placeholder was.
///
/// The expression is run by building an image whose entry point is its own
/// function and handing that to a VM. That is the whole trick, and it is only
/// available to a compiler that is itself running on one: the value a `comp`
/// produces is produced by exactly the machinery that would have produced it at
/// run time, so the two cannot disagree.
/// `bytes_of` is handed the function index to enter at and answers the image
/// to run. It is a function rather than the image itself so that a caller
/// which has already serialized the program can hand the same bytes back
/// with only the entry changed -- see `emit.with_entry`.
let settle_comp! bytes_of one l = {
    let [node, fi, src, span] = one;
    let value = try! { vm.eval_image! (bytes_of fi) } catch e { Raised.make e };
    match value {
        Raised(why) => comp_failed src span why l,
        v => {
            let built = emit_const v l;
            // The placeholder keeps its index -- everything already points at
            // it -- and becomes the node the value is.
            let placed = set_prog (ir.set_node node (ir.node_at (list.nth 1 built) (prog (list.head built)))
                                               (prog (list.head built)))
                                  (list.head built);
            (placed |> Lowering.set_comp_values ((comp_values placed).[comp_key src span => v]))
        },
    }
};

let image : Lowering -> ir.Image;
let image l = match Lowering.image l { () => ir.finish ir.program, img => img };

let diags l = l_diags l;

/// Everything the resolver and the lowerer between them had to say.
let all_diags : scope.Resolution -> Lowering -> [:map];
let all_diags r l = list.append (scope.r_diags r) (l_diags l);

// --- reading it back ------------------------------------------------------------

/// The whole program as text: each function, then the arena it was built into.
/// This is what `--ir` prints. A tree written out one node per line is far
/// easier to check than a nest of indices, which is also why the tests compare
/// against it rather than against node records.
let dump : Lowering -> :string;
let dump l = {
    let img = image l;
    let fs = ir.Image.funcs img;
    let strs = ir.Image.strs img;
    let name_of i = if i < list.length strs { list.nth i strs } else { "?" };
    str.join_str "\n"
        (list.append
            (map (fn i -> {
                let f = list.nth i fs;
                "fn" + to_string i + " " + name_of (f.[:name else 0])
                + "/" + to_string (f.[:arity else 0])
                + "  slots=" + to_string (f.[:slots else 0])
                + (match f.[:n_captures else 0] {
                       0 => "",
                       n => "  captures=" + to_string n
                             + "@" + to_string (f.[:captures_off else 0]),
                   })
                + "  body=" + to_string (f.[:body else ir.no_node])
            }) (list.range 0 (list.length fs)))
            [ir.dump img])
};
