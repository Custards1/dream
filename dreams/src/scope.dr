// Resolution and purity: what every name means, and what may reach an effect.
//
// This is the first pass that looks *inside* a body. The loader answered which
// files a program is made of; this answers what each name in them denotes, and
// refuses the programs where that question has no good answer.
//
// Two jobs, done in one walk because they need the same information:
//
//   1. Resolution -- every name is a local, a name captured from an enclosing
//      function, a global of this module, a member brought in by an import, or
//      a builtin. A name that is none of those is an error here rather than a
//      surprise at run time, and so is `list.nope`, which names a module that
//      exists and a member that does not.
//
//   2. Purity -- a name ending in `!` denotes something impure, and a pure
//      function may not reach one. That rule is what makes `pure_fn` and
//      `impure_fn` different types rather than a naming convention.
//
// What this pass does *not* do is allocate slots or capture indices. Those are
// emission's business, and leaving them out is what keeps this pass readable:
// resolution only has to answer whether a name is in scope, not where the VM
// will find it at run time.
//
// It runs in two phases over the whole program, because a module may use a name
// from a module declared after it. Every module's environment is built first,
// then every body is checked against the finished environments.

import std.progress;
import std.list;
import std.map;
import std.vm;
import std.str;
import std.macros;

import dreams.ast;
import dreams.builtins;
import dreams.diag;
import dreams.fuse;
import dreams.syntax;
import dreams.lint;
import dreams.modules;
import dreams.unit;
import std.array;
import std.lazy;

// --- what a name in front of a dot can be ------------------------------------
//
// A Dream module is resolved at compile time -- `list.map` names one particular
// global -- while a host module keeps a lookup at run time, because the host
// owns its member table. A package is neither: it is a namespace holding
// modules, and only what is inside one is a value.

union Ref {
    // A Dream module, by its index in the loader.
    dream(module)
    // A host module keeps a global holding the module value, because its
    // members are looked up at run time -- the host owns the table. The index
    // travels with the reference so that a member reached through it needs
    // nothing looked up again later.
    native(path, global)
    // A package: a namespace holding modules, by its dotted prefix.
    group(prefix)
}

// --- what a name means ----------------------------------------------------------
//
// What resolution records at each name occurrence (`record`, read back with
// `resolution`), and at the few other places lowering has to be told what this
// pass decided: a block, a function written inline, a `comp`, a `match`. Every
// pass after this one reads these rather than resolving anything again.
//
// These were tagged lists -- `[:global, mi, name, gi]` -- and so was `Ref`. As
// records, a `match` on one jumps by the variant's id, and a pattern cannot
// mistake one for a syntax node that happens to start with the same atom:
// `[:block, impure]` and the block `[:block, stmts, span]` were told apart
// only by their length. `comp` and `match` are keywords, hence `compiled` and
// `subject`.
union Meaning {
    // A slot in this function's frame, and where the name was bound.
    local(slot, span)
    // A capture threaded in from an enclosing function (see `capture`).
    capture(index, span)
    // A global of module `module`.
    global(module, name, index)
    builtin(name)
    // A member reached through a module, `list.map`, or brought in by
    // `import a.{x}`. `index` is the global for a Dream module and `()` for a
    // host's, whose table is looked up at run time.
    member(ref, field, index)
    // Several standard members share this unqualified name. Types select one
    // before lowering; the candidates are [module, field, global].
    overloaded(name, candidates)
    // A block, and whether effects were allowed where it was written: lowering
    // forces its statements only inside an impure function.
    block(impure)
    // A function written inline, by its index: `$( .. )`, `fn ..`, a local
    // `let f x = ..`.
    thunk(func)
    closure(func)
    // A `comp`, by the function it became, and whether it was `comp!`.
    compiled(func, impure)
    // The slot a `match` holds its subject in.
    subject(slot)
    // The name after an `expand`, and what it resolved to. By the time
    // anything reads this the macro is an ordinary global, and this is the
    // only thing left saying it was ever anything else (`expand.note_macro`).
    // `macro` is a keyword.
    expanded(reference)
}

// --- a module's environment ---------------------------------------------------

/// What `resolve!` answers: every name's meaning, every function and global
/// the program declares, and what resolution had to say about them.
mapping Resolution {
    envs = %{}
    frames = []
    diags = []
    refs = %{}
    overload_uses = %{}
    selections = %{}
    binds = %{}
    funcs = %{}
    func_count = 0
    bodies = []
    defs = []
    imports = []
    global_recs = []
    module_recs = []
    wrappers = %{}
    roles = %{}
    result_roles = %{}
    result_slots = %{}
    role_names = %{}
    fusions = %{}
    fused = []
    fuse = false
    staged = %{}
    next_global = 0
    parts = ()
    part_offsets = [0, 0]
    invented_from = 0
    part_bodies = []
    part_candidates = []
    part_notes = []
    // `[position, globals]` for each body of a part: the globals it names,
    // recorded as `walk_part` walks it, which is what `reached` follows.
    part_uses = []
    unit_key = ()
    places = %{}
}

mapping Environment {
    name = ""
    source = 0
    globals = %{}
    aliases = %{}
    only = %{}
    derives = ()
    // The names in `only` that were lent by the prelude rather than imported
    // (`lend_prelude`), each mapped to `true`.
    lent = %{}
    overloads = %{}
}

let env : :string -> :integer -> Environment;
let env name source = Environment.make name source %{} %{} %{} () %{} %{};

let env_name : Environment -> :string;
let env_name e = Environment.name e;
let env_source : Environment -> :integer;
let env_source e = Environment.source e;
let globals : Environment -> :map;
let globals e = Environment.globals e;
let aliases : Environment -> %{:string => Ref};
let aliases e = Environment.aliases e;
let only : Environment -> :map;
let only e = Environment.only e;
let derives e = Environment.derives e;

/// A global is bound to `[kind, index]`. The index is the VM's: globals are
/// numbered across the whole program, and a module's are contiguous, which is
/// what lets an image record a module as a range rather than a list. The kind
/// is for everything else -- diagnostics, and later a language server.
let with_global : :string -> :atom -> :integer -> Environment -> Environment;
let with_global n kind idx e = e.[:globals => (globals e).[n => [kind, idx]]];

/// The index a global was given, or `()`.
let global_index e n = expand macros.with_some g ((globals e).[n else ()]) (list.nth 1 g);

let global_kind e n = expand macros.with_some g ((globals e).[n else ()]) (list.nth 0 g);
let with_alias : :string -> Ref -> Environment -> Environment;
let with_alias n r e     = e.[:aliases => (aliases e).[n => r]];
let with_only : :string -> :any -> Environment -> Environment;
let with_only n v e      = e.[:only => (only e).[n => v]];
let without_only : :string -> Environment -> Environment;
let without_only n e     = Environment.set_lent (map.remove n (Environment.lent e))
                                                (e.[:only => (map.remove n (only e))]);

/// Was `n` lent to this module by the prelude, rather than imported or declared?
let is_lent : Environment -> :string -> :bool;
let is_lent e n = map.has n (Environment.lent e);

let has_global : Environment -> :string -> :bool;
let has_global e n = map.has n (globals e);
let alias_of e n   = (aliases e).[n else ()];
let only_of e n    = (only e).[n else ()];

/// Names visible inside the module, sorted. The global behind a destructuring
/// is an implementation detail, so completion must not offer it.
let visible_names : Environment -> [:string];
let visible_names e =
    list.sort (filter (fn n -> not (is_hidden_name n))
                           (map (fn kv -> list.head kv) (map.pairs (globals e))));

let is_private : Environment -> :string -> :bool;
let is_private e n = map.has n (e.[:private else (%{})]);

/// Public names used by member completion and missing-member diagnostics.
let exports : Environment -> [:string];
let exports e = filter (fn n -> not (is_private e n)) (visible_names e);

// --- diagnostics ---------------------------------------------------------------

let err span message source ds =
    list.append ds [diag.in_source source (diag.error span message)];

let err_note span message note source ds =
    list.append ds [diag.in_source source (diag.with_note note (diag.error span message))];

// --- the pass state ------------------------------------------------------------

/// `envs` is keyed by module index, in the loader's order. `pending` is every
/// body still to be checked, as `[ctx, source, decl]`, where `ctx` is the module
/// whose names it resolves against and `source` the file it was written in. For
/// a derived body those differ, and that difference is the whole of what
/// `derive` means.
/// Besides what each name means, declaring a program produces the tables an
/// image is linked by: which globals exist and what each one points at, which
/// host modules are imported, and which range of globals belongs to which
/// module. They are built here because this is the pass that hands out the
/// indices they are keyed by.
mapping State {
    envs = %{}
    pending = []
    diags = []
    next_global = 0
    imports = []
    global_recs = []
    module_recs = []
}

let state : State;
let state = State.new ();

let envs : State -> %{:integer => Environment};
let envs s    = State.envs s;
let next_global : State -> :integer;
let next_global s = State.next_global s;

/// Take the next global index: `[state, index]`. Handing them out here, while
/// declarations are still being walked in order, is what keeps each module's
/// globals contiguous.
let take_global s = [(s |> State.set_next_global (next_global s + 1)), next_global s];

// Four of this state's fields grow one entry at a time and end up as long as
// the program: the imports, the global records, the queue of bodies to walk
// and one record per module. Each is held **reversed**, and the accessor below
// is what puts it in order.
//
// The reason is that `list.append xs [x]` is one reduction and a copy of `xs`.
// A profile counts the reduction and says nothing about the copy, so an
// accumulator built this way is invisible there and quadratic in *bytes*: on a
// program of 3,200 declarations, `record_global` and `add_pending` were 282 MB
// and 281 MB apiece where 1,600 cost 80 MB each -- 3.5x for twice the program,
// which is the shape of an n^2 with a fixed cost in it. A `_list_cons` is one
// cell whatever the list behind it, and one `list.reverse` at the end is one
// pass. Nothing that reads these is in a loop over the program; where something
// only wanted the length, it asks for the count instead and never builds the
// ordered list at all.
let s_imports_rev s     = State.imports s;
let s_global_recs_rev s = State.global_recs s;
let pending_rev s       = State.pending s;
let s_module_recs_rev s = State.module_recs s;

let s_imports : State -> [[:any]];
let s_imports s     = list.reverse (s_imports_rev s);
let s_global_recs : State -> [[:any]];
let s_global_recs s = list.reverse (s_global_recs_rev s);
let s_module_recs : State -> [[:any]];
let s_module_recs s = list.reverse (s_module_recs_rev s);

/// How many there are, without putting them in order to find out.
let s_global_recs_count : State -> :integer;
let s_global_recs_count s = list.length (s_global_recs_rev s);
let pending_count : State -> :integer;
let pending_count s       = list.length (pending_rev s);

/// Reserve the import record for a host module: `[state, index]`. The index is
/// what the module's global points at, because a host module is reached through
/// the runtime rather than through a function of this program.
let take_import path alias s =
    [(s |> State.set_imports (list.cons [path, alias] (s_imports_rev s))),
     list.length (s_imports_rev s)];

/// `[index, name, kind, target]`. A function's target is its function index,
/// which is not known until its body has been walked, so it is filled in at the
/// end; a module's is its import index, which is known now.
let record_global gi name kind target s =
    (s |> State.set_global_recs (list.cons [gi, name, kind, target] (s_global_recs_rev s)));
let pending : State -> [[:any]];
let pending s = list.reverse (pending_rev s);
let diags : State -> [State];
let diags s   = State.diags s;

/// Module `mi`'s environment, and whether it has one yet. Modules are declared
/// in the loader's order, so an import can name one that is still ahead of the
/// walk -- which is what `has_env` is asked, and it used to be spelled
/// `mi < list.length (envs s)` because a list had no other way to say it.
let env_at s mi  = (envs s).[mi else ()];
let has_env : State -> (:integer | :unit) -> :bool;
let has_env s mi = map.has mi (envs s);

/// Replace module `mi`'s environment.
///
/// This was a list, twice over, and each time for the reason the next
/// paragraph gives. First it was rebuilt here with a `list.map` and a
/// `list.nth` per element, which is O(modules^2) *reductions* per call and
/// made declaring a program cubic in its module count. Then it was the `set`
/// opcode on a list -- one reduction, so the profile went quiet, but `list_set`
/// allocates a fresh cell for every element in front of the one it replaces,
/// so a call still cost O(modules) *bytes* and there is one per declaration.
/// That is the same invisible quadratic `record_global` and `add_pending` had,
/// in the other axis.
///
/// It is a map keyed by module index now, so both halves are O(log32 modules):
/// a put rebuilds the path to one leaf and shares the rest, and `env_at` is a
/// lookup rather than a walk of the modules in front of the one asked for.
/// Nothing wanted the order -- every reader indexes -- so the keys stay dense
/// 0..n-1 and `has_env` is what the `mi < list.length` guards were.
let set_env : :integer -> Environment -> State -> State;
let set_env mi e s = (s |> State.set_envs ((envs s).[mi => e]));

let add_pending p s = (s |> State.set_pending (list.cons p (pending_rev s)));

let complain span message source s =
    (s |> State.set_diags (err span message source (diags s)));

let complain_note span message note source s =
    (s |> State.set_diags (err_note span message note source (diags s)));

// --- reading the syntax tree ---------------------------------------------------

let dotted segs = str.join_str "." segs;

/// The name an import or a derive binds when it does not say so: the last
/// segment of the path as written. `import a.b.c;` binds `c`.
let default_alias segs given = match given { () => list.last segs, a => a };

let decl_name : ast.Decl -> :string;
let decl_name d   = list.nth 1 d;
let decl_params : ast.Decl -> [ast.Param];
let decl_params d = list.nth 2 d;
let decl_body : ast.Decl -> :any;
let decl_body d   = list.nth 3 d;
let decl_rec : ast.Decl -> :bool;
let decl_rec d    = list.nth 4 d;
let decl_span : ast.Decl -> ast.Span;
let decl_span d   = list.nth 5 d;

/// A declaration is impure when its name says so. There is no other marker --
/// the spelling *is* the declaration, which is why a call site can tell without
/// looking anything up.
let decl_impure : ast.Decl -> :bool;
let decl_impure d = builtins.is_impure_name (decl_name d);

let virtual_name v   = list.nth 1 v;
let virtual_params v = list.nth 2 v;
let virtual_body v   = list.nth 3 v;
let virtual_dyn v    = list.nth 4 v;
let virtual_span v   = list.nth 5 v;

/// A virtual with a body has a default, which becomes an ordinary `let` of the
/// module that did not implement it -- checked there, so the default sees that
/// module's overrides rather than the ones where it was written.
let virtual_as_let v =
    ast.let_d (virtual_name v) (virtual_params v) (virtual_body v) false (virtual_span v);

/// A virtual left open in the very module that declared it. It still *binds*
/// the name, so the rest of that module resolves against it -- calling it is
/// what raises, and a module meant to be derived from was never meant to be run
/// directly. The body is a placeholder that is never checked, because there is
/// nothing there that anyone wrote.
let virtual_as_hole name v =
    ast.let_d (virtual_name v) (virtual_params v)
              (ast.apply_e (ast.name_e "raise!" (virtual_span v))
                           [ast.str_e ("`" + virtual_name v + "` is a virtual of module `"
                                       + name + (if virtual_dyn v {
                                                     "`, and the value it was called on does not carry "
                                                     + "an implementation: only a record written "
                                                     + "`derive dyn` does"
                                                 } else { "` with no implementation" }))
                                      (virtual_span v)]
                           (virtual_span v))
              false (virtual_span v);

/// The names a parameter list binds. A parameter may be `()`, a slot that binds
/// nothing, which is what `let now! () = ..` uses.
let param_names ps =
    filter_map (fn p -> ast.param_name p) ps;

// --- resolving a module path ---------------------------------------------------

/// An import is resolved against the enclosing modules first, so that
/// `import io.{ quiet };` inside a module declaring `mod io { .. }` means that
/// submodule rather than a file called `io` somewhere else.
let relative_path : modules.Loader -> :integer -> :string -> :string;
let relative_path l mi p =
    match modules.local_module l (modules.module_name (modules.module_at l mi)) p {
        () => p,
        found => found,
    };

// --- namespaces ----------------------------------------------------------------

/// Every module name in the program, which is what a namespace is described in
/// terms of: a package holds whatever modules were loaded under its prefix.
let module_names : modules.Loader -> [:string];
let module_names l = map (fn m -> modules.module_name m) (modules.modules l);

/// `field` inside a namespace: the module `prefix.field` if there is one,
/// otherwise a deeper namespace if any module lives under it.
let group_member l prefix field = {
    let candidate = prefix + "." + field;
    match modules.find l candidate {
        () => {
            let deeper = candidate + ".";
            if list.any (fn n -> str.starts_with deeper n) (module_names l)
               || list.contains candidate (modules.namespaces l) {
                Ref.group candidate
            }
            else { () }
        },
        target => Ref.dream target,
    }
};

/// What a namespace holds, for the note on a failed lookup: the names directly
/// under it, without the ones further down -- `std.list` but not `std.list.x`.
let group_contents : modules.Loader -> :string -> :string;
let group_contents l prefix = {
    let at = str.byte_length prefix + 1;
    let inside = list.unique (filter (fn rest -> not (str.contains_str "." rest))
        (map (fn n -> str.slice at (str.byte_length n - at) n)
                  (filter (fn n -> str.starts_with (prefix + ".") n) (module_names l))));
    if list.is_empty inside { "it holds nothing" }
    else { "it holds: " + str.join_str ", " (list.sort inside) }
};

// --- phase one: what each module binds ------------------------------------------

let rec declare_import_names mi r p names span s =
    list.fold (fn acc sel -> {
        let e = env_at acc mi;
        let bound = default_alias [list.nth 0 sel] (list.nth 1 sel);
        let inaccessible = match r {
            Ref.dream(target) => target != mi && has_env acc target
                && is_private (env_at acc target) (list.nth 0 sel),
            _ => false,
        };
        if inaccessible {
            complain span ("member `" + p + "." + list.nth 0 sel + "` is private") (env_source e) acc
        }
        else if has_global e bound || (only_of e bound != () && not (is_lent e bound)) {
            complain span ("`" + bound + "` is already bound in this module") (env_source e) acc
        }
        else { set_env mi (with_only bound [r, list.nth 0 sel, p] (without_only bound e)) acc }
    }) s names;

let rec declare_import l mi imp s = {
    let e = env_at s mi;
    let written = list.nth 1 imp;
    let names = list.nth 3 imp;
    let span = list.nth 4 imp;
    let alias = default_alias written (list.nth 2 imp);
    let p = relative_path l mi (dotted written);
    // `import path.{ a, b }` binds members rather than the module, so the
    // module's own name is never taken and cannot collide.
    let takes_members = names != () && not (list.is_empty names);
    let parent = relative_path l mi (dotted (list.take (list.length written - 1) written));

    if not takes_members && modules.find l p == ()
       && list.length written > 1 && modules.find l parent != () {
        let owner = modules.find l parent;
        let member = list.last written;
        if has_env s owner && not (has_global (env_at s owner) member) {
            complain span ("module `" + parent + "` has no member `" + member + "`")
                     (env_source e) s
        }
        else {
            declare_import l mi
                (ast.import_d (modules.dotted_segments parent) ()
                              [[member, list.nth 2 imp]] span) s
        }
    }
    else if not takes_members && alias_of e alias != () {
        complain span ("`" + alias + "` is already imported here") (env_source e) s
    }
    else {
        match modules.find l p {
            () =>
                if list.contains p (modules.namespaces l) {
                    // A whole package: a namespace, not a module and not a value.
                    if takes_members {
                        complain span ("`" + p + "` is a package, so `.{ .. }` has no members to take")
                                 (env_source e) s
                    }
                    else { set_env mi (with_alias alias (Ref.group p) e) s }
                }
                else if not (list.contains p (modules.natives l)) {
                    complain span ("cannot find module `" + p + "`") (env_source e) s
                }
                else {
                    // Host-provided. The global holding the module value is
                    // taken either way: `import std.io.{ open! };` still has to
                    // reach the module at run time to ask it for `open!`.
                    let got = take_global s;
                    let g = list.nth 1 got;
                    let brought = take_import p alias (list.head got);
                    let noted = record_global g alias :module (list.nth 1 brought)
                                              (list.head brought);
                    if takes_members {
                        declare_import_names mi (Ref.native p g) p names span noted
                    }
                    else {
                        // A value as well as a namespace, so a bare mention of
                        // the alias yields the module itself.
                        set_env mi (with_global alias :module g
                                        (with_alias alias (Ref.native p g) e))
                                noted
                    }
                },
            target =>
                if takes_members { declare_import_names mi (Ref.dream target) p names span s }
                else { set_env mi (with_alias alias (Ref.dream target) e) s },
        }
    }
};

let declare_derive l mi d s = {
    let e = env_at s mi;
    let written = list.nth 1 d;
    let span = list.nth 2 d;
    let p = relative_path l mi (dotted written);
    match modules.find l p {
        () => complain span ("cannot derive `" + p + "`: it is not a Dream module")
                       (env_source e) s,
        base =>
            if derives e != () {
                complain span "a module can derive only one other module" (env_source e) s
            }
            else {
                // The base's aliases come along for anything this module has not
                // bound itself, so the base's own code still resolves once it is
                // copied in here.
                let inherited = fold (fn acc kv ->
                    if map.has (list.head kv) (aliases acc) { acc }
                    else { with_alias (list.head kv) (list.nth 1 kv) acc })
                    e (map.pairs (aliases (env_at s base)));
                set_env mi ((with_alias (default_alias written ()) (Ref.dream base)
                                                     inherited).[:derives => base]) s
            },
    }
};

/// The items a module contributes, base first: a derived module is checked as
/// though the base's code had been written into it, which is what lets a virtual
/// bind to the implementation rather than to the default.
///
/// Answers `[items, seen]`, each item paired with the module that owns it, so a
/// diagnostic about inherited code points at the file it was written in.
let effective_items : modules.Loader -> :integer -> [:integer] -> [[:any]];
let rec effective_items l mi seen =
    if list.contains mi seen { [[], seen] }
    else {
        let items = modules.module_items (modules.module_at l mi);
        let bases = fold (fn acc item ->
            match item {
                [:derive, segs, _] =>
                    match modules.find l (relative_path l mi (dotted segs)) {
                        () => acc,
                        base => {
                            let got = effective_items l base (list.nth 1 acc);
                            [list.append (list.head acc) (list.head got), list.nth 1 got]
                        },
                    },
                _ => acc,
            }) [[], list.cons mi seen] items;
        [list.append (list.head bases) (map (fn i -> [mi, i]) items), list.nth 1 bases]
    };

/// The `let`s of a module as they are being gathered: the entries by position,
/// where each name sits, and how many there are.
///
/// This is not the list it looks like it should be, and the reason is the one
/// these notes keep rediscovering: a list searched more often than it is built
/// wants to be a map. `collect_let` asks "have I already got this name?" once
/// per declaration, and asking a list makes gathering a module quadratic in the
/// module's size -- with a `list.map` building an intermediate of everything
/// collected so far, and a `list.append` copying it, per declaration. On a
/// module of sixteen hundred declarations that single scan was a sixth of every
/// reduction the compiler made, and a program using a macro paid it twice,
/// because expansion declares the staged program as well as the real one.
///
/// The positions are what make it a map and still ordered: a name keeps the
/// slot it was first given, so a later declaration from a module this one
/// derives replaces an earlier one *where it stood*, and `gathered` reads them
/// back in declaration order.
mapping Gather {
    entries = %{}
    slots = %{}
    count = 0
}

let gather_new = Gather.make %{} %{} 0;

/// The collection as the rest of declaration reads it: one entry per position,
/// in declaration order.
let gathered : Gather -> [[:string, ast.Decl]];
let gathered g = map (fn i -> (Gather.entries g).[i]) (list.range 0 (Gather.count g));

/// The `let`s a module ends up with, base first, a later one of the same name
/// replacing an earlier one from a *different* module. Redefining a name from a
/// module you derive is the point of deriving; redefining one from this very
/// module is a mistake.
let rec collect_lets l items !acc s =
    match items {
        [] => [acc, s],
        [oi, ..rest] => {
            let owner = list.head oi;
            match list.nth 1 oi {
                [:let, _, _, _, _, _] => {
                    let got = collect_let l owner (list.nth 1 oi) acc s;
                    collect_lets l rest (list.head got) (list.nth 1 got)
                },
                [:let_p, _, _, _] => {
                    let got = fold (fn g d -> collect_let l owner d (list.head g) (list.nth 1 g))
                                        [acc, s] (expand_let_pattern (list.nth 1 oi));
                    collect_lets l rest (list.head got) (list.nth 1 got)
                },
                _ => collect_lets l rest acc s,
            }
        },
    };

/// Every `let` of a module, gathered and handed back as a list: `[lets, s]`.
/// The two callers want the list; the map is an implementation detail of
/// getting there without a scan per declaration.
let collected_lets l items s = {
    let got = collect_lets l items gather_new s;
    [gathered (list.head got), list.nth 1 got]
};

/// One `let` into the collection: `[acc, s]`.
let collect_let l owner d acc s = {
    let n = decl_name d;
    let entry = [owner, d, true, ()];
    let slot = Gather.count acc;
    match (Gather.slots acc).[n else ()] {
        () => [Gather.make ((Gather.entries acc).[slot => entry])
                           ((Gather.slots acc).[n => slot])
                           (slot + 1), s],
        at =>
            if list.head ((Gather.entries acc).[at]) != owner {
                [Gather.set_entries ((Gather.entries acc).[at => entry]) acc, s]
            }
            // A hidden global repeats only where the names beside it repeat, and
            // those are reported in the terms the source was written in.
            else if is_hidden_name n { [acc, s] }
            else {
                [acc, complain (decl_span d) ("`" + n + "` is already bound in this module")
                               (modules.module_source (modules.module_at l owner)) s]
            },
    }
};

// --- destructuring at the top level ---------------------------------------------
//
// A top-level `let` is a global, and a destructuring one binds several, so it
// becomes several `let`s: a hidden global holding the value checked against the
// pattern, and a global for each name, reading its part of the hidden one. A
// global is forced once and remembered, so the check runs once however many of
// the names a program uses -- the job the checked slot does for a destructuring
// inside a function (see "destructuring" below).
//
// The hidden global is named after its pattern, in a spelling no source can
// write, so nothing can name it and a profile still says what it is. Two
// destructurings that render alike bind the same names: in one module the
// second is already an error through those names, and across a `derive` the
// later replaces the earlier together with every name it binds, which is the
// override that was meant.

let hidden_name pattern = "<let " + ast.show_pattern pattern + ">";

let is_hidden_name : :string -> :bool;
let is_hidden_name n = str.starts_with "<" n;

/// The hidden global's body: the value, checked against the pattern.
let destructure_e pattern body span = [:destructure, pattern, body, span];

/// One name's body: its part of the hidden global's value, which part being
/// the one the name was written at.
let destructured_e hidden pattern name_span = [:destructured, hidden, pattern, name_span];

let expand_let_pattern item =
    match item {
        [:let_p, pattern, body, span] => {
            let hidden = hidden_name pattern;
            list.cons (ast.let_d hidden [] (destructure_e pattern body span) false span)
                      (map (fn b -> ast.let_d (list.nth 0 b) []
                                                   (destructured_e hidden pattern (list.nth 1 b))
                                                   false (list.nth 1 b))
                                (pattern_bindings pattern))
        },
        _ => [item],
    };

let rec collect_virtuals items !acc =
    match items {
        [] => acc,
        [oi, ..rest] =>
            match list.nth 1 oi {
                [:virtual, n, _, _, _, _] =>
                    if list.any (fn ov -> virtual_name (list.nth 1 ov) == n) acc {
                        collect_virtuals rest acc
                    }
                    else { collect_virtuals rest (list.append acc [oi]) },
                _ => collect_virtuals rest acc,
            },
    };

/// A behavior's contract is its explicit parameter list and public name.
/// Values remain dynamically typed; aliases must spell out their parameters
/// so checking a contract never requires evaluating an implementation.
let check_virtual_impl l v od s = {
    let owner = list.head od;
    let d = list.nth 1 od;
    let expected = list.length (virtual_params v);
    let actual = list.length (decl_params d);
    let source = modules.module_source (modules.module_at l owner);
    if actual != expected {
        complain (decl_span d)
            ("implementation of `" + virtual_name v + "` requires " + to_string expected
             + (if expected == 1 { " parameter, found " } else { " parameters, found " })
             + to_string actual) source s
    } else if modules.private_declaration (modules.module_at l owner) (decl_span d) {
        complain (decl_span d) ("implementation of `" + virtual_name v + "` must be public") source s
    } else { s }
};

/// A virtual nobody implemented. Three outcomes, and which one depends on who
/// left the hole open.
let unimplemented l mi owner v lets s =
    if owner == mi && virtual_dyn v {
        [list.append lets (dispatching mi (modules.module_name (modules.module_at l mi)) v), s]
    }
    else { match virtual_body v {
        // No body: a hole, and whether that is an error depends on who left it.
        // This arm comes first because `()` is a value like any other -- a bare
        // binder below it would match the hole too, and every virtual would
        // look as though it had a default.
        () =>
            if owner == mi {
                // The module that declared the hole. It stays abstract rather
                // than failing to compile -- but the name is still bound, or
                // the module's own code could not refer to what it declared.
                // Raising is an effect, so the stub is allowed to perform one
                // however pure the virtual it stands for was declared.
                [list.append lets
                     [[owner, virtual_as_hole (modules.module_name (modules.module_at l mi)) v,
                       true, true]],
                 s]
            }
            else {
                [lets,
                 complain_note (module_span l mi)
                     ("module `" + modules.module_name (modules.module_at l mi)
                      + "` derives `" + modules.module_name (modules.module_at l owner)
                      + "` but does not implement `" + virtual_name v + "`")
                     ("add `let " + virtual_name v + " "
                      + str.join_str "" (map (fn p -> to_string (ast.param_name p) + " ")
                                                  (virtual_params v))
                      + "= ..`, or give the virtual a default body")
                     (modules.module_source (modules.module_at l mi)) s]
            },
        // A default body: it becomes a `let` of the module that did not
        // implement it, and is checked there.
        _ => [list.append lets [[owner, virtual_as_let v, true, ()]], s],
    } };

// --- dispatch -----------------------------------------------------------------
//
// `derive` specializes: a record that derives `shape` gets its own copy of
// `describe`, compiled against its own `area`, and nothing is decided at run
// time. What that cannot give is a function written once against `shape` for
// values of any record -- `shape.area x` in the module that declared the hole
// raises, and the generic caller has to be handed the operations instead.
//
// `virtual dyn let` and `derive dyn` are the opt-in for that, one on each
// side, and each side is compiled from its own module alone (which is what
// keeps a module's unit independent of who derives it):
//
//   - A record written `derive dyn shape` carries a table in slot 0 of every
//     value (`syntax.record_derived` lays it out): the global `<dispatch>`, a
//     map from each `dyn` virtual it inherits -- named `module.virtual`, so a
//     virtual of the base's own base is told apart -- to the record's
//     implementation of it. `dispatch_table` writes that global.
//
//   - In the module that declares it, a `dyn` virtual is a dispatcher: it
//     reads slot 0 of its *last* argument -- the receiver, by the convention
//     that a member takes `self` last so it pipes -- and calls what the table
//     names; anything without a table gets the default, or the hole's raise,
//     which moves to a hidden global of its own (`dispatching`).
//
// A record that derives without `dyn` is laid out exactly as before, and a
// base with no `dyn` virtual compiles exactly as before: the cost is paid by
// the declarations that ask for it, and only there. The dispatcher looks at
// what it is handed before trusting it, so a plain list whose first element
// happens to be a map is still a plain list -- unless that map has the
// virtual's own key, which no program writes by accident.

/// The table's key for a virtual: the declaring module's name and its own.
let dispatch_key module v = module + "." + virtual_name v;

/// The name the default (or the hole) of a `dyn` virtual moves to.
let dispatch_default_name v = "<" + virtual_name v + " default>";

/// A `dyn` virtual in the module that declared it: two `let` entries, the
/// dispatcher under the virtual's own name and the default it falls back on.
///
/// The dispatcher is generated whole and given generated spans (`syntax.fresh`,
/// in a block keyed by the virtual's position): resolution keys a name by where
/// it is written, so its several references to the receiver must each be
/// somewhere different. The default keeps the spans it was written with, and
/// moves aside unchanged, so a diagnostic in it still points into the source.
let dispatching mi module v = {
    let at = virtual_span v;
    let n = list.length (virtual_params v);
    let arg i = "<arg " + to_string i + ">";
    let args = map (fn i -> ast.name_e (arg i) at) (list.range 0 n);
    let receiver = ast.name_e (arg (n - 1)) at;
    let kind_is k = ast.binary_e :eq (ast.name_e "<kind>" at) (ast.atom_e k at) at;
    let lookup =
        ast.match_e (ast.apply_e (ast.name_e "type_of" at) [receiver] at)
            // A `group` or a `struct` is a record, which `type_of` names by
            // its declaration; the table is its slot 0 all the same.
            [ast.arm (ast.bind_p "<kind>" at)
                     (ast.binary_e :or
                          (ast.binary_e :or (ast.binary_e :or (kind_is "list") (kind_is "array") at)
                                        (kind_is "map") at)
                          (ast.binary_e :ne (ast.apply_e (ast.name_e "_record_id" at) [receiver] at)
                                        (ast.unit_e at) at) at)
                     (ast.match_e (ast.get_e receiver (ast.int_e 0 at) (ast.unit_e at) at)
                          [ast.arm (ast.bind_p "<table>" at)
                                   (ast.binary_e :eq (ast.apply_e (ast.name_e "type_of" at)
                                                                  [ast.name_e "<table>" at] at)
                                                 (ast.atom_e "map" at) at)
                                   (ast.get_e (ast.name_e "<table>" at)
                                              (ast.str_e (dispatch_key module v) at)
                                              (ast.unit_e at) at) at,
                           ast.arm (ast.wildcard_p at) () (ast.unit_e at) at] at) at,
             ast.arm (ast.wildcard_p at) () (ast.unit_e at) at] at;
    let body =
        ast.match_e lookup
            [ast.arm (ast.literal_p (ast.unit_e at) at) ()
                     (ast.apply_e (ast.name_e (dispatch_default_name v) at) args at) at,
             ast.arm (ast.bind_p "<impl>" at) ()
                     (ast.apply_e (ast.name_e "<impl>" at) args at) at] at;
    let params = map (fn i -> ast.param (arg i) at) (list.range 0 n);
    let generated = list.head (syntax.fresh [params, body]
                                            (3221225472 + ast.span_start at * 128));
    let hole = virtual_body v == ();
    let fallback = if hole { virtual_as_hole module v } else { virtual_as_let v };
    let aside = 3221225472 + ast.span_start at * 128 + 126;
    [[mi, ast.let_d (virtual_name v) (list.head generated) (list.nth 1 generated) false at, true, ()],
     [mi, ast.let_d (dispatch_default_name v) (decl_params fallback) (decl_body fallback) false
                    [aside, aside + 1],
      true, if hole || builtins.is_impure_name (virtual_name v) { true } else { () }]]
};

/// The global `<dispatch>` of a `derive dyn` record: each `dyn` virtual it
/// inherits, by key, to the name of its implementation here -- resolved in
/// this module, so it is the record's own, or the default it inherited.
/// Answers the `let` entries to add and the state, which has an error in it
/// when the base has no `dyn` virtual and there would be nothing to carry.
let dispatch_table l mi virtuals span lets s = {
    let dyns = list.filter (fn ov -> virtual_dyn (list.nth 1 ov)) virtuals;
    if list.is_empty dyns {
        [lets,
         complain_note span "`derive dyn` names a module with no `dyn` virtual, so there is nothing to dispatch"
             "declare the operations to call generically as `virtual dyn let ..`, or write `derive`"
             (modules.module_source (modules.module_at l mi)) s]
    }
    else {
        let pairs = list.map (fn ov -> {
            let v = list.nth 1 ov;
            [ast.str_e (dispatch_key (modules.module_name (modules.module_at l (list.head ov))) v) span,
             ast.name_e (virtual_name v) span]
        }) dyns;
        let table = list.head (syntax.fresh (ast.map_e pairs span)
                                            (3221225472 + ast.span_start span * 128));
        [list.append lets [[mi, ast.let_d syntax.dispatch_table_name [] table false span, true, ()]], s]
    }
};

/// A `let` and an `import path.{ .. }` of the same name would both bind it, and
/// the `let` would quietly win. Say so instead: which one the author meant is
/// not something to guess at.
let report_clashes mi span s = {
    let e = env_at s mi;
    let clashing = filter (fn n -> has_global e n)
                               (map (fn kv -> list.head kv) (map.pairs (only e)));
    // A name the prelude lent is the module's to take: declaring it is
    // shadowing, not a clash (`lend_prelude`).
    let given_back = fold (fn acc n ->
        if is_lent (env_at acc mi) n { set_env mi (without_only n (env_at acc mi)) acc } else { acc })
        s clashing;
    fold (fn acc n -> {
        let e2 = env_at acc mi;
        let sel = only_of e2 n;
        ((complain_note span ("`" + n + "` is already bound in this module")
                 ("it is imported from `" + list.nth 2 sel + "` and also defined here; rename one, "
                  + "or use `" + list.nth 2 sel + "." + list.nth 1 sel + "` where the import is meant")
                 (env_source e2) acc) |> State.set_envs (envs (set_env mi (without_only n e2) acc)))
    }) given_back (filter (fn n -> not (is_lent e n)) clashing)
};

/// The span to hang a module-wide complaint on: its first item, or nothing.
let module_span l mi = {
    let items = modules.module_items (modules.module_at l mi);
    if list.is_empty items { ast.no_span } else { ast.span (list.head items) }
};

/// Declare one global `let`: take a global index, bind the name, and queue its
/// body for phase two. This is the loop `declare_module` folds over its lets,
/// factored out because a session needs exactly the same for one statement of
/// its root module -- and the order of a module's globals is decided in this one
/// place, so session mode cannot take a different one without meaning different
/// indices.
let declare_one_let l mi od s = {
    let owner = list.head od;
    let d = list.nth 1 od;
    let original = env_at s mi;
    let e = if modules.private_declaration (modules.module_at l owner) (decl_span d) {
        original.[:private => ((original.[:private else (%{})]).[(decl_name d) => true])]
    } else { original };
    if has_global e (decl_name d) {
        complain (decl_span d) ("`" + decl_name d + "` is already bound in this module")
                 (modules.module_source (modules.module_at l owner)) s
    }
    else {
        let got = take_global s;
        let bound = set_env mi (with_global (decl_name d)
                                    (if decl_impure d { :impure } else { :pure })
                                    (list.nth 1 got) e)
                            (record_global (list.nth 1 got) (decl_name d) :function ()
                                           (list.head got));
        if list.nth 2 od {
            add_pending [mi, modules.module_source (modules.module_at l owner), d,
                         list.nth 3 od] bound
        }
        else { bound }
    }
};

/// Declare the items of a module that the caller has sliced out of its
/// `:items` -- a session statement at a time. Same rules as `declare_module`:
/// imports first, then the `let`s. What it does not do is record
/// the module: that happens once the module's globals are known, which a
/// session does when it links rather than here.
///
/// A module being declared a second time carries its environment -- the name a
/// fresh declaration binds is old news to an accumulation. Only the file index
/// is refreshed, because a session re-reads its root each entry and the file it
/// was parsed from moves.
let declare_items! : modules.Loader -> :integer -> [ast.Decl] -> State -> State;
let declare_items! l mi items s0 = {
    let s1 =
        if has_env s0 mi { s0 }
        else { set_env mi (env (modules.module_name (modules.module_at l mi))
                               (modules.module_source (modules.module_at l mi))) s0 };
    let s2 = set_env mi ((env_at s1 mi) |> Environment.set_source (modules.module_source (modules.module_at l mi))) s1;
    let pairs = map (fn i -> [mi, i]) items;
    let imported = fold (fn acc item ->
        match item {
            [:import, _, _, _, _] => declare_import l mi item acc,
            _ => acc,
        }) s2 items;
    // A session declares a slice of one module, so the question is asked of the
    // items in hand. `declare_module` below asks it of the modules instead,
    // which it can because it has all of every one of them.
    let collected = collected_lets l pairs imported;
    let declared = list.fold (fn acc od -> declare_one_let l mi od acc)
                             (list.nth 1 collected) (list.head collected);
    lend_prelude l mi (report_clashes mi (module_span l mi) declared)
};

let declare_module : modules.Loader -> :integer -> State -> State;
let declare_module l mi s0 = {
    // Where this module's globals begin. They are contiguous because this is
    // the only thing handing out indices and it finishes one module before it
    // starts the next -- which is what lets an image record a module as a range
    // rather than as a list.
    let globals_from = next_global s0;
    let m = modules.module_at l mi;
    let s1 = set_env mi (env (modules.module_name m) (modules.module_source m)) s0;
    let items = modules.module_items m;

    // Aliases first: imports, then derives, which also bring the base module's
    // aliases along.
    let imported = fold (fn acc item ->
        match item {
            [:import, _, _, _, _] => declare_import l mi item acc,
            _ => acc,
        }) s1 items;
    let derived = fold (fn acc item ->
        match item {
            [:derive, _, _] => declare_derive l mi item acc,
            _ => acc,
        }) imported items;

    let effective = list.head (effective_items l mi []);
    let collected = collected_lets l effective derived;
    let virtuals = collect_virtuals effective [];

    // Every virtual that nothing implemented, in declaration order.
    let filled = list.fold (fn acc ov -> {
        let v = list.nth 1 ov;
        if list.any (fn od -> decl_name (list.nth 1 od) == virtual_name v) (list.head acc) { acc }
        else { unimplemented l mi (list.head ov) v (list.head acc) (list.nth 1 acc) }
    }) collected virtuals;

    // A `derive dyn` record's table, now that its virtuals are known.
    let filled = fold (fn acc item -> match item {
        [:dispatch, _, span] => dispatch_table l mi virtuals span (list.head acc) (list.nth 1 acc),
        _ => acc,
    }) filled items;

    // Check every inherited declaration, including a contract redeclared by
    // an intermediate module. Deduplicating defaults must not hide a contract.
    let contracts = list.fold (fn acc oi -> match list.nth 1 oi {
        [:virtual, _, _, _, _, _] => {
            let v = list.nth 1 oi;
            match list.find
                (fn od -> decl_name (list.nth 1 od) == virtual_name v) (list.head filled) {
                () => acc,
                od => check_virtual_impl l v od acc,
            }
        },
        _ => acc,
    }) (list.nth 1 filled) effective;

    // Declare the globals, and queue every body for phase two.
    let declared = list.fold (fn acc od -> declare_one_let l mi od acc)
                             contracts (list.head filled);

    let checked = lend_prelude l mi (report_clashes mi (module_span l mi) declared);
    // A module that declares a virtual is abstract: it has a hole in it, and
    // running it directly would reach one.
    (checked |> State.set_module_recs (list.cons [mi, globals_from, next_global checked - globals_from,
                    not (list.is_empty virtuals), derives (env_at checked mi)]
                   (s_module_recs_rev checked)))
};

// --- frames ---------------------------------------------------------------------
//
// A frame is one function. The stack grows inwards, so the function being
// resolved is at the front, and its enclosing functions follow.
//
// Resolution searches every frame, because a name in an enclosing function is
// still reachable -- it is *captured*, and threading that capture down through
// each frame in between is this pass's job rather than a later one's. Purity, by
// contrast, asks only the innermost frame: whether *this* function may perform
// an effect.
//
// A frame also allocates the slots its locals live in, and remembers the widest
// the frame ever got, which is what the VM needs to size an activation record.

mapping Frame {
    func = 0
    scopes = []
    next_slot = 0
    max_slots = 0
    cap_names = []
    caps = []
    impure = false
    display = ""
    staged = %{}
}

let frame func impure display = Frame.make func [[]] 0 0 [] [] impure display %{};

let frame_func f = Frame.func f;
let scopes f = Frame.scopes f;
let next_slot f = Frame.next_slot f;
let max_slots f = Frame.max_slots f;
let cap_names f = Frame.cap_names f;
let caps f = Frame.caps f;
let frame_impure f = Frame.impure f;
let frame_display f = Frame.display f;

/// The stages this frame has bound a name to and will write where they are
/// read. It hangs off the frame rather than off the resolver so that it stops
/// at a function boundary without anyone having to remember to clear it: a
/// lambda inside the block gets a new frame, and a stage moved into one would
/// need the enclosing frame's names as captures -- which is the one thing a
/// fused loop, being a global, has none of.
let frame_staged f = Frame.staged f;

/// A capture says where the enclosing frame keeps the value: in one of its own
/// slots, or in one of *its* captures. Threading it down like this is what lets
/// a closure three levels deep reach a name without any frame in between having
/// to know why it is holding it.
union Capture {
    local(slot)
    outer(index)
}

// --- the resolver's state --------------------------------------------------------
//
// One record threaded through the whole walk. Diagnostics are only half of what
// comes out: `refs` records what every name occurrence turned out to mean, and
// `funcs` records every function the program contains. Lowering reads both
// rather than working them out again, and a language server can read them
// without lowering anything at all.

/// Functions are kept by index rather than in a list. A function is finished
/// long after it is started -- `end_func` fills in the slots and captures its
/// body turned out to need -- so they are written to as well as appended, and
/// rebuilding a list to change one entry costs the length of the list every
/// time. On a program with a thousand functions that is the difference between
/// compiling and not.
let resolver : %{:integer => Environment} -> Resolution;
let resolver es = Resolution.set_envs es (Resolution.new ());

let r_envs : Resolution -> %{:integer => Environment};
let r_envs r   = Resolution.envs r;

/// Module `mi`'s environment, out of a finished resolution. The same lookup
/// `env_at` is, for the readers that hold a resolver rather than the scope
/// state -- `lower` and `lucid` both do, and both used to reach in with a
/// `list.nth` of their own.
let r_env_at r mi = (r_envs r).[mi else ()];
let r_imports : Resolution -> [[:any]];
let r_imports r     = Resolution.imports r;
let r_global_recs : Resolution -> [[:any]];
let r_global_recs r = Resolution.global_recs r;
let r_module_recs : Resolution -> [[:any]];
let r_module_recs r = Resolution.module_recs r;

/// A global that names a function nothing lowered. It can only happen for a
/// virtual left open in the module that declared it -- there is nothing written
/// to call -- and calling it is what raises.
let no_function = ();
let frames r   = Resolution.frames r;
let r_diags : Resolution -> [:map];
let r_diags r  = Resolution.diags r;
let refs : Resolution -> %{:integer => Meaning};
let refs r     = Resolution.refs r;
let binds : Resolution -> :map;
let binds r    = Resolution.binds r;
let func_map : Resolution -> %{:integer => Function};
let func_map r   = Resolution.funcs r;
let func_count : Resolution -> :integer;
let func_count r = Resolution.func_count r;

/// One function by index.
let func_at : Resolution -> :integer -> Function;
let func_at r i = (func_map r).[i else (%{})];

/// Every function, in index order. Built on demand: what the walk needs is
/// access by index, and what everything downstream wants is the sequence.
let funcs : Resolution -> [Function];
let funcs r = map (fn i -> func_at r i) (list.range 0 (func_count r));
/// The bodies queued for the walk, in the order they were queued. Reversed in
/// the state for the reason the three fields above are -- see the note there.
let bodies_rev r = Resolution.bodies r;
let bodies : Resolution -> [[:any]];
let bodies r     = list.reverse (bodies_rev r);
let bodies_count : Resolution -> :integer;
let bodies_count r = list.length (bodies_rev r);
/// Global index -> `Wrapper` for every wrapper. See "wrappers".
let wrappers : Resolution -> %{:integer => Wrapper};
let wrappers r = Resolution.wrappers r;
let defs : Resolution -> [[:any]];
let defs r     = Resolution.defs r;

// --- what deforestation left behind ------------------------------------------
//
// Three tables, all empty unless this resolution is the one a compile runs.
// `roles` says which global is which `std.list` member, so a call site can be
// recognised by the index it resolved to rather than by how it was spelled.
// `fusions` is the plan for each pipeline, found by where the call was
// written. `fused` is the globals the pass invented, which go on the end of
// the program's global table -- after every module's, because they belong to
// no module.

let roles r    = Resolution.roles r;
/// The *spellings* any of those globals go by, which is what makes asking
/// cheap. `fuse_shape` is asked about every application in the program, and
/// resolving a callee to find out it is not `fold` would put a scan of the
/// frame stack on the compiler's hottest path. A name nothing was ever bound
/// to under cannot be a pipeline, and that is one lookup.
let role_names r = Resolution.role_names r;
let fusions r  = Resolution.fusions r;
/// The globals deforestation invented, in the order it invented them. Held
/// reversed and reversed once here, like the three fields at the top of this
/// file and for the same reason: a program whose every declaration folds over a
/// range invents a loop per declaration, and appending each one to the end cost
/// 124 MB of a 3,200-declaration compile against 31 MB of one half its size.
let fused_rev r = Resolution.fused r;
let fused r     = list.reverse (fused_rev r);
let fuses r    = Resolution.fuse r;

/// The plan for the pipeline written at this span, or `()`.
///
/// The span is checked and not only its start, because the key is a byte
/// offset and two applications can begin at the same byte -- `x |> f a` is
/// lowered as an application that starts where `x` does, and it is not this
/// one.
let fusion r ctx source span =
    match (fusions r).[(ref_key ctx source (ast.span_start span)) else ()] {
        () => (),
        p => if fuse.Plan.span p == span { p } else { () },
    };

/// What the current frame has staged, and how to change it. Both answer
/// through the innermost frame, so a block installs its own and puts the
/// enclosing one back when it ends.
let staged_now r =
    if list.is_empty (frames r) { %{} } else { frame_staged (list.head (frames r)) };

let set_staged m r = update_frame (fn f -> (f |> Resolution.set_staged m)) r;

/// The stage a name stands for here, or `()`. A name is only ever staged in
/// the frame it was written in, so this is one lookup and no walk.
let staged_use r n = (staged_now r).[n else ()];

/// The same, asked by a `let` about itself: is *this* statement the one whose
/// body was moved? Two `let`s in a block may share a name, and only the one
/// whose span matches is the one that was staged.
let staged_here r n span =
    match staged_use r n {
        () => (),
        st => if fuse.Staged.span st == span { st } else { () },
    };

// What lowering has to be told, because it must make the same decision and
// must not remake it: a `let` that no longer binds anything, and a name that
// stands for the body of one. A pass that disagreed with this one would either
// lower a stage twice or build a loop over a name nothing bound.

/// What `staging` answers: the stage a name stands for, written elsewhere, or
/// that this is the `let` that used to bind one.
union Staging {
    body(expr)
    elided
}

let staged_table r = Resolution.staged r;

let record_staged ctx source span what r =
    (r |> Resolution.set_staged ((staged_table r).[(ref_key ctx source (ast.span_start span)) => what]));

/// `Staging.body` where a name stands for a stage written elsewhere,
/// `Staging.elided` at the `let` that used to bind it, or `()`.
let staging r ctx source span =
    (staged_table r).[(ref_key ctx source (ast.span_start span)) else ()];

let set_frames fs r = (r |> Resolution.set_frames fs);

let on_front f xs = list.cons (f (list.head xs)) (list.tail xs);

/// Replace the innermost frame.
let update_frame f r =
    if list.is_empty (frames r) { r } else { set_frames (on_front f (frames r)) r };

/// Replace the frame `i` steps out from the innermost one.
let rec update_frame_at i f fs =
    if i <= 0 { on_front f fs }
    else { list.cons (list.head fs) (update_frame_at (i - 1) f (list.tail fs)) };

let frame_at r i = list.nth i (frames r);
let frame_count r = list.length (frames r);

/// Where a name occurrence is recorded.
///
/// A byte offset is unique within one file, and the file makes it unique within
/// the program -- but not within a *resolution*. A body inherited through
/// `derive` is walked once for every module that derives it, from the same file
/// and the same offsets, and each walk resolves it differently: that is the
/// whole point of deriving. So the module the body was resolved against is part
/// of the key, or the last walk would quietly overwrite the others.
let ref_key : :integer -> :integer -> :integer -> :integer;
let ref_key ctx source start = (ctx * 65536 + source) * 4294967296 + start;

/// True, having forced `v` and everything inside it on the way to saying so.
///
/// The same job `ir.settled` does for a node, for the two tables below, and it
/// has to be a walk rather than a list of fields because a resolution is a
/// small tree of its own: `[:member, [:dream, mi], field, gi]`.
///
/// What it is for is the finding under "A lazy value stored in a map pins the
/// map it was made in": a map is persistent, so a put shares the entries and
/// copies the path to the one it added, and *one* map is cheap where every
/// version of one is not. A lazy value is what keeps the old versions
/// reachable -- a thunk carries the frame that would compute it, and in a walk
/// that threads the resolver through every name that frame holds the resolver
/// as it stood one occurrence ago, which holds `refs` as it stood then. Store
/// N lazy resolutions and the table holds N versions of itself.
///
/// Forcing the spine is not enough, and that was measured before this was
/// written: the elements are where the frames hang. `[:global, ctx_mi c, name,
/// global_index e name]` in normal form is a list of three thunks, and each of
/// them holds the context and the environment it would have been computed
/// from.
///
/// It is `lazy.settled`, one native call where a walk written here was a call
/// per cell -- three million reductions of a self-compile -- and it answers
/// true rather than handing `v` back, because `record .. (forced what)` would
/// suspend the call and change nothing: the callers ask it in a condition, and
/// their `else` below is unreachable. It was `to_string` once, which forced
/// the same way but rendered a string nobody read, and did it where nothing
/// could be collected; checking std's tests ran a gigabyte through one
/// nursery that way, a resolution here being a deep chain of suspensions.
let forced : :any -> :bool;
let forced v = lazy.settled v;

/// Force the two tables' spines.
///
/// The other half of the same problem, and the same answer `ir.settle` gives:
/// forcing the values keeps a table from being a chain of its own versions,
/// and forcing the spine keeps it from being a chain of suspended puts. A
/// resolution threads `r` through every name in the program, so a `map_put`
/// nobody forces is a suspension holding the resolver before it -- twenty-five
/// thousand of them stacked up, with every intermediate table live at once.
let settle_refs r = if lazy.forced (refs r) && lazy.forced (binds r) { r } else { r };

/// Record what a name occurrence means. This is the pass's real output: a
/// diagnostic says what went wrong, but `refs` says what went *right*, which is
/// what everything downstream actually needs.
let record ctx source span what r =
    if forced what {
        settle_refs
            (r |> Resolution.set_refs ((refs r).[(ref_key ctx source (ast.span_start span)) => what]))
    } else { r };

/// What was recorded at this occurrence, or `()`.
let resolution r ctx source span =
    (refs r).[(ref_key ctx source (ast.span_start span)) else ()];

/// Where a *binding* put its value: `[name, slot]` for the binder at this span.
///
/// Kept apart from `refs`, which is about name *uses*. A binder and a use can
/// share a span -- a `let` in a block is both the closure it makes and the name
/// it binds -- and more importantly this is what frees lowering from having to
/// walk patterns in the same order as this pass did. It asks where a binder's
/// slot is; it does not recount.
let record_bind ctx source span name slot r =
    if forced name && forced slot {
        settle_refs
            (r |> Resolution.set_binds ((binds r).[(ref_key ctx source (ast.span_start span)) => [name, slot]]))
    } else { r };

let binding r ctx source span =
    (binds r).[(ref_key ctx source (ast.span_start span)) else ()];

let note_diag d r = (r |> Resolution.set_diags (list.append (r_diags r) [d]));

let complain_at span message source r =
    note_diag (diag.in_source source (diag.error span message)) r;

let complain_note_at span message note source r =
    note_diag (diag.in_source source (diag.with_note note (diag.error span message))) r;

// --- functions --------------------------------------------------------------------

/// A function record: everything the VM needs about one function except its
/// body, which lowering supplies.
///
/// `source` is the file the span is in, which is what lets the image say
/// where the function was written (`lower.link_funcs`), and so where an error
/// raised in it came from.
mapping Function {
    name = ""
    arity = 0
    impure = false
    recursive = false
    thunk = false
    span = [0, 0]
    source = 0
    slots = 0
    captures = []
}

let func_rec : :string -> :integer -> :bool -> :bool -> :bool -> ast.Span -> :integer -> Function;
let func_rec name arity impure is_rec thunk span source =
    Function.make name arity impure is_rec thunk span source 0 [];

let func_name : Function -> :string;
let func_name f  = Function.name f;
let func_arity : Function -> :integer;
let func_arity f = Function.arity f;
let func_slots : Function -> :integer;
let func_slots f = Function.slots f;
let func_captures : Function -> [Capture];
let func_captures f = Function.captures f;
let func_impure : Function -> :bool;
let func_impure f = Function.impure f;

/// Reserve a function and push a frame for it. The index is stable: functions
/// are only ever appended, so it can be recorded at the call site before the
/// body has been walked.
/// Reserve a function and push a frame for it.
///
/// `impure` and `allow` are not the same question, and collapsing them is a
/// mistake worth naming. `impure` is what the function *is* -- only a name
/// ending in `!` makes one, and it is what a caller sees. `allow` is whether
/// effects may happen while its body is walked. A lambda written inside an
/// impure function may perform effects but is not itself impure; a thunk may
/// always perform them, because suspending an effect is not performing one.
let begin_func name arity impure allow is_rec thunk span source r = {
    let fi = func_count r;
    let with_func =
        (r
            |> Resolution.set_funcs ((func_map r).[fi => (func_rec name arity impure is_rec thunk span source)])
            |> Resolution.set_func_count (fi + 1));
    [set_frames (list.cons (frame fi allow name) (frames with_func)) with_func, fi]
};

/// Pop the frame and write what it learned -- how many slots the function needs
/// and what it captures -- into the function record.
let end_func fi r = {
    let fr = list.head (frames r);
    let finished = ((func_at r fi) |> Function.set_slots (max_slots fr) |> Function.set_captures (caps fr));
    set_frames (list.tail (frames r))
               (r |> Resolution.set_funcs ((func_map r).[fi => finished]))
};

// --- scopes and slots --------------------------------------------------------------

let push_scope r = update_frame (fn fr -> fr.[:scopes => (list.cons [] (scopes fr))]) r;

/// Leaving a scope takes its names out of sight. It does *not* give the slots
/// back.
///
/// Recycling them looks free -- only one arm of a `match` ever runs, so two
/// arms could share -- but it is not, because the language is lazy. An arm's
/// body can hand back a value that has not been evaluated yet, and that value
/// reads its binders out of the frame when it finally is. If a later scope has
/// taken those slots by then, it reads whatever that scope put there instead.
/// A frame is as big as everything the function binds, which is what the
/// reference compiler does too.
let pop_scope r =
    update_frame (fn fr -> fr.[:scopes => (list.tail (scopes fr))]) r;

/// Bind a name to a slot that has already been taken, without taking another.
let bind_at ctx source name slot span r =
    record_bind ctx source span name slot
        (update_frame (fn f ->
            if name == "_" { f }
            else { f.[:scopes => (on_front (fn sc -> list.append sc [[name, slot, span]]) (scopes f))] }) r);

/// Keep a slot out of circulation for the rest of the frame, after the scope
/// that named it has gone.
///
/// Almost every binding is done with when its scope ends, and the slot goes
/// back. A `catch` binder is the exception -- see the `:try` case below.
let reserve_slot slot r =
    update_frame (fn fr ->
        (fr.[:next_slot => (if slot + 1 > next_slot fr { slot + 1 } else { next_slot fr })]).[:max_slots => (if slot + 1 > max_slots fr { slot + 1 } else { max_slots fr })]) r;

/// Bind one name in the innermost scope, giving it a slot. `_` is a wildcard:
/// it takes a slot, because something has to be stored there, but binds no name,
/// so nothing can reach it.
let bind_one ctx source name span r = {
    let fr = list.head (frames r);
    let slot = next_slot fr;
    let widened = if slot + 1 > max_slots fr { slot + 1 } else { max_slots fr };
    [record_bind ctx source span name slot (update_frame (fn f ->
        ((if name == "_" { f }
             else { f.[:scopes => (on_front (fn sc -> list.append sc [[name, slot, span]])
                                                     (scopes f))] }).[:next_slot => (slot + 1)]).[:max_slots => widened]) r),
     slot]
};

let rec bind_all ctx source bindings r =
    match bindings {
        [] => r,
        [b, ..rest] =>
            bind_all ctx source rest
                (list.head (bind_one ctx source (list.nth 0 b) (list.nth 1 b) r)),
    };

/// A local's `[slot, span]` in one frame, innermost scope first, or `()`.
let lookup_local fr name = {
    let rec in_scopes ss =
        match ss {
            [] => (),
            [sc, ..rest] => {
                let hit = list.filter (fn e -> list.nth 0 e == name) sc;
                if list.is_empty hit { in_scopes rest }
                // A later binding of the same name in one scope shadows an
                // earlier one, so the last match wins.
                else { list.last hit }
            },
        };
    in_scopes (scopes fr)
};

/// Thread `name` down from an enclosing frame, adding a capture to every frame
/// along the way. Answers `[r, index]` -- the capture's index in frame `i` --
/// or `[r, ()]` when no enclosing frame has it.
let rec capture i name r =
    if i >= frame_count r { [r, ()] }
    else {
        let fr = frame_at r i;
        let at = list.index_of name (cap_names fr);
        if at >= 0 { [r, at] }
        else if i + 1 >= frame_count r { [r, ()] }
        else {
            let outer = frame_at r (i + 1);
            let from = match lookup_local outer name {
                () => {
                    let up = capture (i + 1) name r;
                    match list.nth 1 up {
                        () => [list.head up, ()],
                        ci => [list.head up, Capture.outer ci],
                    }
                },
                found => [r, Capture.local (list.nth 1 found)],
            };
            match list.nth 1 from {
                () => [list.head from, ()],
                desc => {
                    let r2 = list.head from;
                    let idx = list.length (caps (frame_at r2 i));
                    [set_frames (update_frame_at i (fn f ->
                         (f.[:cap_names => (list.append (cap_names f) [name])]).[:caps => (list.append (caps f) [desc])])
                         (frames r2)) r2,
                     idx]
                },
            }
        }
    };

/// Where a name is, as far as the frame stack is concerned: a slot in this
/// function, or a capture threaded in from an enclosing one.
let resolve_in_frames name r =
    if list.is_empty (frames r) { [r, ()] }
    else {
        match lookup_local (list.head (frames r)) name {
            () => {
                let got = capture 0 name r;
                match list.nth 1 got {
                    () => [list.head got, ()],
                    ci => [list.head got, Meaning.capture ci ast.no_span],
                }
            },
            found => [r, Meaning.local (list.nth 1 found) (list.nth 2 found)],
        }
    };

/// Is the name bound by some enclosing function? Asked where only the answer
/// matters and threading a capture would be wrong -- deciding whether `list` in
/// `list.map` is a local or a module, for one.
let in_scope r name =
    list.any (fn fr -> lookup_local fr name != ()) (frames r);

/// May an effect happen here? An empty stack means there is no function to be
/// pure, which is the case for a compile-time expression.
let impure_ok r =
    if list.is_empty (frames r) { true } else { frame_impure (list.head (frames r)) };

let display_of r =
    if list.is_empty (frames r) { "" } else { frame_display (list.head (frames r)) };

// --- phase two: resolving a body ---------------------------------------------------

/// The context a body is resolved in: the whole program, the module whose names
/// it resolves against, and the file it was written in. For a body inherited
/// through `derive` those last two differ, and that difference is the whole of
/// what `derive` means.
mapping Context {
    l = ()
    mi = 0
    source = 0
}

let ctx : modules.Loader -> :integer -> :integer -> Context;
let ctx l mi source = Context.make l mi source;

let ctx_l c = Context.l c;
let ctx_mi c = Context.mi c;
let ctx_source c = Context.source c;

let ctx_env c r = (r_envs r).[ctx_mi c else ()];
let env_of c r i = (r_envs r).[i else ()];

let report c span message r = complain_at span message (ctx_source c) r;
let report_note c span message note r = complain_note_at span message note (ctx_source c) r;
let warn_note c span message note r =
    note_diag (diag.in_source (ctx_source c) (diag.with_note note (diag.warning span message))) r;

/// Record that an effect happens here, rejecting it in a pure function.
let note_effect c span what r =
    if impure_ok r { r }
    else {
        match syntax.default_field (display_of r) {
            // There is no `!` to add: a default is what reading the field
            // answers, and reading a field is pure.
            () => report_note c span
                      ("cannot use " + what + " inside the pure function `" + display_of r + "`")
                      "mark the function impure by ending its name with `!`, e.g. `let f! x = ..`" r,
            f => report c span ("cannot use " + what + " in the default of `" + f
                                + "`: a default is what reading the field answers, and that is pure") r,
        }
    };

/// A member reached through a module: `list.map`, or `map` after
/// `import std.list.{map}` -- the two resolve identically, which is what stops
/// them from ever disagreeing, including about purity.
let check_member c r_ref shown field span r = {
    let r1 =
        match r_ref {
            Ref.dream(target) => {
                let e = env_of c r target;
                if is_private e field && not (encloses (ctx_env c r) (ctx_mi c) target) {
                    report c span ("member `" + shown + "." + field + "` is private") r
                }
                else if has_global e field {
                    // The global index, so lowering has nothing left to look
                    // up: a cross-module call is one index by the time the
                    // image is written, which is the whole point of compiling
                    // the program as a whole.
                    record (ctx_mi c) (ctx_source c) span
                           (Meaning.member r_ref field (global_index e field)) r
                }
                else {
                    report_note c span
                        ("module `" + shown + "` has no member `" + field + "`")
                        (if list.is_empty (exports e) { "it exports nothing" }
                         else { "it exports: " + str.join_str ", " (exports e) }) r
                }
            },
            // The host owns its member table, so there is nothing to check the
            // name against here; only its purity is this pass's business.
            // A host module keeps its lookup until run time -- the host owns
            // the member table -- so what is recorded is the module's own
            // global and the field name to ask it for.
            Ref.native(_, _) => record (ctx_mi c) (ctx_source c) span (Meaning.member r_ref field ()) r,
            // A namespace holds modules, not members. Reaching here means the
            // name was used one level too shallow, as in `std.map` for
            // `std.list.map`.
            Ref.group(prefix) =>
                report_note c span ("`" + prefix + "` is a package, not a module")
                    (group_contents (ctx_l c) prefix + "; `" + field
                     + "` would have to be inside one") r,
            _ => r,
        };
    if builtins.is_impure_name field {
        match r_ref {
            Ref.dream(_) => note_effect c span ("the impure function `" + shown + "." + field + "`") r1,
            _ => note_effect c span ("the impure member `" + field + "`") r1,
        }
    }
    else { r1 }
};

/// `field` as a *submodule* of a module. A module's aliases hold everything it
/// imported as well as what it declared, so the name alone is not enough:
/// `text.str` must not reach `std.str` just because `text` imports it. Only a
/// module actually named `parent.field` counts, which is exactly what
/// `mod field { .. }` creates.
let submodule c r target field =
    match alias_of (env_of c r target) field {
        Ref.dream(inner) =>
            if modules.module_name (modules.module_at (ctx_l c) inner)
               == modules.module_name (modules.module_at (ctx_l c) target) + "." + field {
                Ref.dream inner
            }
            else { () },
        _ => (),
    };

/// If this expression names a module or a namespace rather than a value, which
/// one -- and the spelling to show in a diagnostic. `[ref, shown]`, or `()`.
///
/// A record or a union brought in by `import a.{R}` is a namespace too, the
/// same one `import a.R` gives. What that import binds is `a`'s global `R`,
/// the description that makes `R` a type; before a dot it used to stay that
/// value, so `R.field x` asked a list for a member and failed at run time,
/// while the same line after `import a.R` worked.
let rec as_namespace c r e =
    match e {
        [:name, n, _] =>
            if in_scope r n { () }
            else {
                match alias_of (ctx_env c r) n {
                    () => match only_of (ctx_env c r) n {
                        [Ref.dream(target), member, _] => match submodule c r target member {
                            () => (),
                            inner => [inner, n],
                        },
                        _ => (),
                    },
                    m => [m, n],
                }
            },
        [:field, obj, field, _] =>
            match as_namespace c r obj {
                () => (),
                base =>
                    match list.head base {
                        Ref.group(prefix) =>
                            match group_member (ctx_l c) prefix field {
                                () => (),
                                inner => [inner, list.nth 1 base + "." + field],
                            },
                        Ref.dream(target) =>
                            match submodule c r target field {
                                () => (),
                                inner => [inner, list.nth 1 base + "." + field],
                            },
                        // A host module's members are values, not namespaces.
                        _ => (),
                    },
            },
        _ => (),
    };

/// `path.join` where `path` is a local as well as an imported module that has
/// a `join`. The local wins -- a name in scope is a value before it is a
/// namespace -- so this reads a member of whatever the local holds, and the
/// program fails at run time with "a string has no member `join`", nowhere
/// near the parameter that caused it. The names that collide are the common
/// ones (`path`, `file`, `list`, `map`, `str`), so this was easy to write and
/// hard to see; it is a warning rather than an error because the program
/// means something, just very probably not what was meant. A host module has
/// no member table to check against, so any member of one counts.
let shadowed_module c r obj field span r1 =
    match obj {
        [:name, n, _] if in_scope r n =>
            match alias_of (ctx_env c r) n {
                Ref.dream(target) if has_global (env_of c r target) field =>
                    shadow_warning c n field span r1,
                Ref.native(_, _) => shadow_warning c n field span r1,
                _ => r1,
            },
        _ => r1,
    };

let shadow_warning c n field span r =
    warn_note c span ("`" + n + "` here is a local, not the module `" + n + "`")
        ("so `" + n + "." + field + "` reads a member of the local's value; rename the local") r;

/// A warning for each parameter of `let n ps = body` that is an accumulator
/// nothing forces -- grown by a call of `n` itself and otherwise only answered
/// -- with the one character that fixes it. dreams/src/lint.dr says what is and is
/// not counted, and why the check is read off the syntax.
let lazy_accumulators_warned c n ps body r =
    if list.is_empty ps { r }
    else {
        fold (fn acc hit -> {
            let p = list.head hit;
            warn_note c (list.nth 1 hit)
                ("`" + p + "` is an accumulator nothing forces: each call of `" + n
                 + "` hands it on suspended, and the chain overflows when it is read")
                ("make it strict with `!" + p + "`, so each call forces it as it starts") acc
        }) r (lint.lazy_accumulators n ps body)
    };

/// A warning for each `strict!` written as an element of a list, array or map
/// literal, where it is suspended with the element and forces nothing early.
/// dreams/src/lint.dr says why only a literal's element is read.
let suspended_forces_warned c body r =
    fold (fn acc span ->
        warn_note c span
            "this `strict!` is an element, and an element is suspended: it forces nothing until the element is read"
            "force it as a statement first -- `strict! x;` -- and put `x` in the literal" acc)
        r (lint.suspended_forces body);

/// A warning for each pitfall dreams/src/lint.dr can prove from the syntax alone:
/// a repeated literal map key, an arm an earlier one hides, a literal zero
/// divisor.
let pitfalls_warned c body r =
    fold (fn acc hit -> warn_note c (lint.Hit.span hit) (lint.Hit.message hit) (lint.Hit.note hit) acc)
        r (lint.pitfalls body);

/// Every lint a top-level declaration's body is read by, in the order their
/// warnings are reported. A new pass is one more entry here.
let body_lints_warned c n ps body r =
    fold (fn acc pass -> pass acc) r
        [lazy_accumulators_warned c n ps body, suspended_forces_warned c body, pitfalls_warned c body];

/// A module or a namespace written where a value belongs.
let not_a_value c m shown span r =
    report_note c span ("`" + shown + "` is a module, not a value")
        (match m {
             Ref.group(_) => "use a module inside it, as in `" + shown + ".something.member`",
             _ => "use one of its members, as in `" + shown + ".something`",
         }) r;

/// A primitive named outside `std` resolves -- the program means what it
/// says -- but is warned about, with the `std` call to write instead. That
/// call costs nothing over the primitive (see "wrappers" above), so the only
/// thing writing the primitive buys is a name `std` is free to change.
let primitive_named c name span r =
    if not (builtins.is_primitive name) || builtins.written_by_parser name
       || modules.written_in_std (ctx_l c) (ctx_source c) { r }
    else {
        warn_note c span ("`" + name + "` is a primitive, meant to be called through `std`")
            (match builtins.wrapper name {
                 () => "nothing outside `std` should need it",
                 call => "write `" + call + "` instead",
             }) r
    };

let check_name c name span r = {
    let e = ctx_env c r;
    let found = resolve_in_frames name r;
    let r0 = list.head found;
    let r1 =
        match list.nth 1 found {
            // A local or a capture: recorded with where the VM will find it.
            () =>
                if has_global e name {
                    record (ctx_mi c) (ctx_source c) span
                           (Meaning.global (ctx_mi c) name (global_index e name)) r0
                }
                else if builtins.is_builtin name {
                    primitive_named c name span
                        (record (ctx_mi c) (ctx_source c) span (Meaning.builtin name) r0)
                }
                else {
                    match only_of e name {
                        // A member brought in by `import path.{ .. }` resolves
                        // exactly as `path.member` would.
                        () => match (Environment.overloads e).[name else ()] {
                            candidates if candidates != () => {
                                let key = ref_key (ctx_mi c) (ctx_source c) (ast.span_start span);
                                match (Resolution.selections r0).[key else ()] {
                                    () => {
                                        let uses = (Resolution.overload_uses r0).[key => [ctx_mi c, ctx_source c, span]];
                                        record (ctx_mi c) (ctx_source c) span (Meaning.overloaded name candidates)
                                            (r0 |> Resolution.set_overload_uses uses)
                                    },
                                    chosen => record (ctx_mi c) (ctx_source c) span chosen r0,
                                }
                            },
                            _ => match alias_of e name {
                                // A Dream module is a compile-time namespace,
                                // not a value, so say that rather than claiming
                                // the name does not exist.
                                Ref.dream(_) => not_a_value c (Ref.dream 0) name span r0,
                                _ => report c span
                                         ("cannot find `" + name + "` in this scope") r0,
                            },
                        },
                        sel => check_member c (list.nth 0 sel) (list.nth 2 sel) (list.nth 1 sel)
                                            span r0,
                    }
                },
            local => record (ctx_mi c) (ctx_source c) span local r0,
        };
    if builtins.is_impure_name name {
        // `receive!` is syntax, and what it becomes calls this; say what was
        // written (see `syntax.receive_e`).
        let shown = if name == "__receive_start!" { "a `receive!`" } else { "the impure function `" + name + "`" };
        note_effect c span shown r1
    }
    else { r1 }
};

/// The names a pattern binds, each with the span that binds it, in the order
/// they are written -- which is the order their slots are allocated in.
let pattern_bindings : ast.Pattern -> [[:string, ast.Span]];
let rec pattern_bindings p =
    match p {
        [:bind, n, span] => [[n, span]],
        [:as_p, inner, n, name_span, _] => list.append (pattern_bindings inner) [[n, name_span]],
        [:cons_p, head, tail, _, _] => list.append (pattern_bindings head) (pattern_bindings tail),
        [:list_p, items, rest, _] =>
            list.append (list.concat (map (fn i -> pattern_bindings i) items))
                        (rest_bindings rest),
        [:array_p, items, rest, _] =>
            list.append (list.concat (map (fn i -> pattern_bindings i) items))
                        (rest_bindings rest),
        [:map_p, pairs, _] => list.concat (map (fn kv -> pattern_bindings (list.nth 1 kv)) pairs),
        [:record_p, _, fields, _] => list.concat (map (fn f -> pattern_bindings f) fields),
        [:success_p, inner, _] => pattern_bindings inner,
        _ => [],
    };

/// A named `..rest` binds where its name is written, not where its list starts.
let rest_bindings rest = match rest { [n, name_span] => [[n, name_span]], _ => [] };

/// A name a pattern binds twice -- `x :: x`, `[x, x]` -- is reported where it
/// is bound the second time. It reads like a request that the two parts be
/// equal, and nothing would check that: the later binding would quietly shadow
/// the earlier one and the arm would match whatever the two parts were.
let check_repeats c p r = {
    let step acc b = {
        let [seen, r0] = acc;
        let n = list.nth 0 b;
        // `_` binds nothing anyone can name, so it may be written as often as
        // there are parts to ignore.
        if n != "_" && map.has n seen {
            [seen, report c (list.nth 1 b) ("`" + n + "` is bound more than once in this pattern") r0]
        }
        else { [map.put n true seen, r0] }
    };
    list.nth 1 (list.fold step [map.empty, r] (pattern_bindings p))
};

let rec check_expr c e r =
    match e {
        // A name the block staged is not a binding to look up -- there is
        // none, because the `let` was skipped. It *is* the stage, walked here
        // in the frame it was written in, where every name in it still means
        // what it meant.
        [:name, n, span] =>
            match staged_use r n {
                () => check_name c n span r,
                st => record_staged (ctx_mi c) (ctx_source c) span (Staging.body (fuse.Staged.body st))
                          (check_expr c (fuse.Staged.body st) r),
            },

        [:field, obj, field, span] =>
            match as_namespace c r obj {
                () => {
                    let r1 = shadowed_module c r obj field span (check_expr c obj r);
                    if builtins.is_impure_name field {
                        note_effect c span ("the impure member `" + field + "`") r1
                    }
                    else { r1 }
                },
                base => {
                    let m = list.head base;
                    let shown = list.nth 1 base;
                    // `math.deep` where `deep` is a submodule: a namespace one
                    // level further in, and still not a value.
                    let deeper = match m {
                        Ref.dream(target) => submodule c r target field,
                        Ref.group(prefix) => group_member (ctx_l c) prefix field,
                        _ => (),
                    };
                    match deeper {
                        () =>
                            match m {
                                Ref.group(prefix) =>
                                    report_note c span
                                        ("`" + shown + "` has no module `" + field + "`")
                                        (group_contents (ctx_l c) prefix) r,
                                _ => check_member c m shown field span r,
                            },
                        inner => match m {
                            // `optim.Optimizer` where a value belongs: the
                            // module a record became, and beside it the
                            // global of the same name holding its
                            // description -- which is what `Optimizer`
                            // unqualified reads, so the dotted name reads it
                            // too. That is how a field's type names another
                            // module's record.
                            Ref.dream(target) if has_global (env_of c r target) field =>
                                check_member c m shown field span r,
                            _ => not_a_value c inner (shown + "." + field) span r,
                        },
                    }
                },
            },

        // A pipeline of `std.list` combinators is one loop, and the list
        // between them is never built -- see "deforestation" below. Asked
        // first, because a fused call walks its pieces into different frames
        // than an ordinary one does.
        [:apply, callee, args, span] => {
            // Lazy, as a `let` is: walked only when the call is not fused, or
            // a fusion is refused once its loop has been walked.
            let plain = {
                let walked = list.fold (fn acc a -> check_expr c a acc) (check_expr c callee r) args;
                match result_role c r callee {
                    [_, _, arity] if list.length args == arity =>
                        reserve_result c callee walked,
                    _ => walked,
                }
            };
            match fuse_shape c r callee args {
                () => plain,
                shape => match check_fused c e shape r { () => plain, fused => fused },
            }
        },
        [:pipe, l, rhs, _] => {
            let walked = check_expr c rhs (check_expr c l r);
            let [callee, arity] = match rhs {
                [:apply, f, args, _] => [f, list.length args + 1],
                _ => [rhs, 1],
            };
            match result_role c r callee {
                [_, _, needed] if arity == needed =>
                    reserve_result c callee walked,
                _ => walked,
            }
        },
        [:unary, _, x, _] => check_expr c x r,
        [:binary, _, l, rhs, _] => check_expr c rhs (check_expr c l r),
        [:if, cond, t, el, _] => {
            let r1 = check_expr c t (check_expr c cond r);
            match el { () => r1, x => check_expr c x r1 }
        },
        // Whether effects are allowed here is recorded, because lowering needs
        // it and cannot see it: a block's non-final statements are only worth
        // forcing inside an impure function, and inside a pure one they are
        // dead code worth saying so about.
        [:block, stmts, span] => {
            // A block may name a stage of a pipeline and read it once, which is
            // the direct form with a name on it -- see "a stage that was given
            // a name" in `fuse`. The names it stages are in scope for the whole
            // block and no longer, so the enclosing frame's are put back after.
            let saved = staged_now r;
            let entered = stage_block c stmts
                              (record (ctx_mi c) (ctx_source c) span (Meaning.block (impure_ok r)) r);
            set_staged saved (pop_scope (check_block c stmts (push_scope entered)))
        },

        // A `?` the parser could not pull in front of a statement: it is under
        // something that may not run -- the right of `&&` or `||`, a branch, a
        // fallback -- so there is no step that would always run it. See "`?`"
        // in the parser.
        [:question, x, span] =>
            report c span ("`?` answers a failure from the statement it is in, and this one is "
                           + "where it may not run: bind it with `let?` first, or give it a block")
                   (check_expr c x r),
        // `$( .. )` is a value: building it is always allowed, and running it is
        // what needs an impure context. So the thunk's own frame permits
        // effects however pure the function around it is.
        [:thunk, x, span] => {
            let started = begin_func "<thunk>" 0 false true false true span (ctx_source c) r;
            let fi = list.nth 1 started;
            record (ctx_mi c) (ctx_source c) span (Meaning.thunk fi)
                   (end_func fi (check_expr c x (list.head started)))
        },

        // The binder goes out of scope with the handler, but its *slot* stays
        // reserved for the rest of the frame.
        //
        // A `try` is an expression, so it can be forced long after the
        // statement that built it -- and when it is, the VM writes the raised
        // value into this slot. Letting a later binding reuse it means that
        // binding is overwritten by an error from a `try` it has nothing to do
        // with, which is what `let x = try! .. catch e { .. };` did: `x` and
        // `e` shared a slot, so `x` came out holding the error.
        [:try, body, binder, handler, span] => {
            let r1 = check_expr c body r;
            let scoped = push_scope r1;
            let bound = bind_one (ctx_mi c) (ctx_source c) binder span scoped;
            let walked = pop_scope (check_expr c handler (list.head bound));
            reserve_slot (list.nth 1 bound) walked
        },

        // A lambda is not a declaration, so it cannot declare itself impure: it
        // inherits whether effects are allowed from where it is written.
        [:lambda, ps, body, span] => {
            let started = begin_func "<lambda>" (list.length ps) false (impure_ok r) false false span (ctx_source c) r;
            let fi = list.nth 1 started;
            let bound = bind_params c ps (list.head started);
            record (ctx_mi c) (ctx_source c) span (Meaning.closure fi) (end_func fi (check_expr c body bound))
        },

        // A compile-time expression becomes a function of its own, because
        // evaluating it means running it. It is walked with an empty frame
        // stack: it runs before the program does, so there is no local for it
        // to see, and saying so here is better than a mystery later.
        [:comp, impure, x, span] => {
            let outer = frames r;
            let started = begin_func "<comp>" 0 impure impure false true span (ctx_source c) (set_frames [] r);
            let fi = list.nth 1 started;
            let walked = end_func fi (check_expr c x (list.head started));
            record (ctx_mi c) (ctx_source c) span (Meaning.compiled fi impure) (set_frames outer walked)
        },
        [:list, xs, _]  => list.fold (fn acc x -> check_expr c x acc) r xs,
        [:array, xs, _] => list.fold (fn acc x -> check_expr c x acc) r xs,
        [:map, pairs, _] =>
            list.fold (fn acc kv -> check_expr c (list.nth 1 kv) (check_expr c (list.nth 0 kv) acc))
                      r pairs,
        // A `match` needs a slot of its own: every pattern but `_` looks at the
        // subject, and the arms are tried in order, so it is evaluated once up
        // front and held. Resolution hands out that slot rather than leaving
        // lowering to invent one, because the frame's slot count is settled
        // here and a slot invented later would not be counted.
        [:match, scrutinee, arms, span] => {
            let r1 = check_expr c scrutinee r;
            let scoped = push_scope r1;
            let held = bind_one (ctx_mi c) (ctx_source c) "_" span scoped;
            let r2 = record (ctx_mi c) (ctx_source c) span (Meaning.subject (list.nth 1 held)) (list.head held);
            pop_scope (list.fold (fn acc arm -> check_arm c arm acc) r2 arms)
        },

        [:get, container, key, fallback, _] => {
            let r1 = check_expr c key (check_expr c container r);
            match fallback { () => r1, f => check_expr c f r1 }
        },
        [:set, container, key, value, _] =>
            check_expr c value (check_expr c key (check_expr c container r)),

        // The hidden global behind a top-level destructuring. Its value takes a
        // slot, as a `match` subject does, because the pattern reads it more
        // than once and it is evaluated once.
        [:destructure, pattern, body, span] => {
            let held = bind_one (ctx_mi c) (ctx_source c) "_" span r;
            check_destructure c pattern "a `let`"
                (check_pattern c pattern (check_expr c body (list.head held)))
        },
        // One name of a top-level destructuring. Lowering reads its part out of
        // the hidden global, which it finds by name, and the keys that part is
        // found by were resolved with the hidden global's body -- so there is
        // nothing left here to resolve.
        [:destructured, _, _, _] => r,
        _ => r,
    };

/// A block's statements. A `let` binds a name the statements after it can see,
/// so the scope grows as the block is walked.
let rec check_block c stmts r =
    match stmts {
        [] => r,
        [st, ..rest] =>
            match st {
                // A `let` whose body is written where it is read binds nothing
                // and is not walked here. The one place that reads it walks it,
                // in this same frame -- so walking it here as well would give
                // its lambdas a second set of slots and a second function
                // record, and only one of the two would ever be lowered.
                [:let, n, _, _, _, span] if staged_here r n span != () =>
                    check_block c rest r,

                [:let, n, ps, body, is_rec, span] => {
                    // `let rec` puts the name in scope for its own body, so a
                    // closure can refer to itself. The slot is allocated either
                    // way -- what `rec` changes is only when the name reaches it.
                    //
                    // Taking the slot *before* walking the body is the whole
                    // point, and not just tidiness. The VM puts the body's
                    // thunk in this slot and then forces it, so anything the
                    // body binds must land somewhere else: a binder inside the
                    // body given this same slot overwrites the binding being
                    // computed, and the `let` ends up holding whatever the
                    // inner binder put there. That is what
                    //
                    //     let src = match .. { () => .., s => join root s };
                    //
                    // did -- `src` and `s` shared a slot, so `src` came out as
                    // `s`. Walking the body first and binding after frees the
                    // body's slots for the `let` to reuse, which is exactly
                    // the collision.
                    let taken = bind_one (ctx_mi c) (ctx_source c)
                                         (if is_rec { n } else { "_" }) span r;
                    let slot = list.nth 1 taken;
                    let pre = list.head taken;
                    let r1 =
                        if list.is_empty ps { check_expr c body pre }
                        else {
                            let started = begin_func n (list.length ps)
                                                     (builtins.is_impure_name n)
                                                     (builtins.is_impure_name n)
                                                     is_rec false span (ctx_source c) pre;
                            let fi = list.nth 1 started;
                            let bound = bind_params c ps (list.head started);
                            record (ctx_mi c) (ctx_source c) span (Meaning.closure fi)
                                   (end_func fi (check_expr c body
                                                    (lazy_accumulators_warned c n ps body bound)))
                        };
                    check_block c rest
                        (if is_rec { r1 }
                         else { bind_at (ctx_mi c) (ctx_source c) n slot span r1 })
                },
                // `let [a, b] = pair`. The value takes a slot as a plain `let`'s
                // does, and before its body is walked for the same reason; the
                // value checked against the pattern takes another, which every
                // name reads its part from. A map pattern's keys are resolved
                // where the `let` is, before any name it binds is in scope.
                [:let_p, pattern, body, span] => {
                    let held = bind_one (ctx_mi c) (ctx_source c) "_" span r;
                    let walked = check_destructure c pattern "a `let`"
                        (check_repeats c pattern
                            (check_pattern c pattern (check_expr c body (list.head held))));
                    let checked = bind_one (ctx_mi c) (ctx_source c) "_" (checked_span pattern) walked;
                    check_block c rest
                        (bind_all (ctx_mi c) (ctx_source c) (pattern_bindings pattern) (list.head checked))
                },
                // A signature binds nothing and runs nothing; what its type
                // names is the type checker's to resolve (`dreams.types`).
                [:sig, _, _, _] => check_block c rest r,
                _ => check_block c rest (check_expr c st r),
            },
    };

/// One `pattern => body`, with the pattern's names in scope for the guard as
/// well as the body -- a guard exists to ask about what the pattern bound.
let rec check_arm c arm r = {
    let p = ast.arm_pattern arm;
    let r1 = check_repeats c p (check_pattern c p r);
    let scoped = push_scope r1;
    let bound = bind_all (ctx_mi c) (ctx_source c) (pattern_bindings p) scoped;
    let r2 = match ast.arm_guard arm { () => bound, g => check_expr c g bound };
    pop_scope (check_expr c (ast.arm_body arm) r2)
};

/// A pattern binds names, but it also *compares*, and what it compares against
/// is an expression -- resolved in the scope the `match` sits in, not the one
/// the pattern creates, so a key cannot refer to what the pattern is about to
/// bind. In practice that means a map pattern's key: the parser only ever puts
/// a constant in a literal pattern, and a bare name binds rather than compares.
/// Literals are walked anyway, so this stays correct if that ever changes.
let rec check_pattern c p r =
    match p {
        [:literal, e, _] => check_expr c e r,
        [:as_p, inner, _, _, _] => check_pattern c inner r,
        [:cons_p, head, tail, _, _] => check_pattern c tail (check_pattern c head r),
        [:list_p, items, _, _]  => list.fold (fn acc i -> check_pattern c i acc) r items,
        [:array_p, items, _, _] => list.fold (fn acc i -> check_pattern c i acc) r items,
        [:map_p, pairs, _] =>
            list.fold (fn acc kv -> check_pattern c (list.nth 1 kv) (check_expr c (list.nth 0 kv) acc))
                      r pairs,
        // The constructor is an expression, resolved where the `match` is.
        [:record_p, ctor, fields, _] =>
            list.fold (fn acc f -> check_pattern c f acc) (check_expr c ctor r) fields,
        [:success_p, inner, _] => check_pattern c inner r,
        _ => r,
    };

// --- destructuring ----------------------------------------------------------------
//
// `let [a, b] = pair`, and a parameter written as a pattern, take a value apart
// with the patterns `match` uses -- parsed, bound and tested by the same code.
// Only the moment of the test differs. A `let` is lazy, and one that destructures
// is no exception: nothing is looked at until a name it binds is used, and then
// the whole pattern is checked, once however many of its names are used, raising
// `:match_error` when the value does not fit, as a `match` with no arm for it
// would.
//
// That is the slot a destructuring takes beyond its names: the value, checked.
// Every name reads its part out of that slot, so no name is read before the
// check has run, and the check runs the first time only.

/// The pattern under any `as`, which is what says whether there is a shape here
/// to take apart at all.
let rec pattern_shape p = match p { [:as_p, inner, _, _, _] => pattern_shape inner, _ => p };

let takes_apart p =
    match pattern_shape p {
        [:cons_p, _, _, _, _] => true,
        [:list_p, _, _, _]  => true,
        [:array_p, _, _, _] => true,
        [:map_p, _, _]      => true,
        [:record_p, _, _, _] => true,
        _ => false,
    };

/// Where the checked value's slot is recorded: at the shape's closing bracket.
/// A binder is recorded where its name starts, a pattern parameter where its
/// pattern starts, a destructuring `let`'s value where the `let` starts -- and no
/// name starts at a `]` or a `}`.
let checked_span : ast.Pattern -> ast.Span;
let checked_span p = match pattern_shape p {
    [:cons_p, _, _, operator_span, _] => operator_span,
    shape => { let e = ast.span_end (ast.span shape); ast.span_of (e - 1) e },
};

/// The first part of a pattern that asks a question -- a literal -- or `()`.
let rec refutable_part p =
    match p {
        [:literal, _, _]        => p,
        [:as_p, inner, _, _, _] => refutable_part inner,
        [:cons_p, head, tail, _, _] => first_refutable [head, tail],
        [:list_p, items, _, _]  => first_refutable items,
        [:array_p, items, _, _] => first_refutable items,
        [:map_p, pairs, _]      => first_refutable (list.map (fn kv -> list.nth 1 kv) pairs),
        // A shape, as an array pattern is: a value of another constructor
        // does not fit and raises, as an array of another length does.
        [:record_p, _, fields, _] => first_refutable fields,
        _ => (),
    };

let rec first_refutable ps =
    match ps {
        [] => (),
        [p, ..rest] => match refutable_part p { () => first_refutable rest, found => found },
    };

/// A literal pattern as it is written, for a message that names it.
let literal_text e =
    match e {
        [:atom, n, _]  => ":" + n,
        [:str, s, _]   => ast.quote_str s,
        [:char, ch, _] => "'" + str.of_chars [ch] + "'",
        [:unit, _]     => "()",
        [_, v, _]      => to_string v,
        _ => "this literal",
    };

/// Refuse what a destructuring cannot do; `what` names the position.
///
/// A `let` and a parameter have nowhere to go when a value does not fit, so a
/// pattern that asks a question -- a literal anywhere in it -- belongs in a
/// `match`, where another arm can take the answer no. A shape can still fail to
/// fit, and that raises; what cannot be written is a pattern whose point is to
/// be declined. The other two are mistakes: a pattern with no shape only names
/// a value, and one that binds nothing would never be checked, because the
/// check waits for a name to be used.
let check_destructure c p what r =
    match refutable_part p {
        () =>
            if not (takes_apart p) {
                report_note c (ast.span p)
                    ("the pattern of " + what + " has to take apart a list, an array or a map")
                    "to bind a value whole, give it a name" r
            }
            else if list.is_empty (pattern_bindings p) {
                report_note c (ast.span p)
                    "this pattern binds no names, so nothing would ever check it"
                    "a destructuring is checked when a name it binds is first used; `match` checks a shape now" r
            }
            else { r },
        lit =>
            report_note c (ast.span lit)
                ("`" + literal_text (list.nth 1 lit) + "` could fail to match, and " + what
                 + " has no other arm to try")
                "use `match`, with an arm for whatever else the value can be" r,
    };

/// A parameter list. Every parameter takes its slot in order, which is where its
/// argument arrives; then each one written as a pattern binds its names out of
/// that slot, with a slot for the checked argument, as a destructuring `let` has.
/// A pattern's keys see the parameters, and not the names it is about to bind.
let bind_params c ps r =
    list.fold (fn acc p -> bind_pattern_param c p acc)
        (bind_all (ctx_mi c) (ctx_source c) (list.map (fn p -> [ast.param_name p, list.nth 1 p]) ps) r)
        ps;

/// What a parameter written as a pattern binds, once the parameter itself is
/// bound: the pattern checked, a slot for the check, and a slot for each name
/// in it. Nothing for a plain parameter. Shared with a fused loop's step,
/// whose element parameter is bound to the slot the loop reads it from.
let bind_pattern_param c p r =
    match ast.param_pattern p {
        () => r,
        pattern => {
            let walked = check_destructure c pattern "a parameter"
                             (check_repeats c pattern (check_pattern c pattern r));
            let checked = bind_one (ctx_mi c) (ctx_source c) "_" (checked_span pattern) walked;
            bind_all (ctx_mi c) (ctx_source c) (pattern_bindings pattern) (list.head checked)
        },
    };

/// One queued body, resolved in the module whose names it sees. A global `let`
/// is a function like any other -- a parameterless one is a zero-arity function
/// the VM forces once, which is why it gets a frame rather than being treated
/// as a bare expression.
let check_body l p r = {
    let mi = list.nth 0 p;
    let source = list.nth 1 p;
    let d = list.nth 2 p;
    let c = ctx l mi source;
    // A synthesized body may need to be impure whatever its name says: the stub
    // that stands in for an unfilled virtual raises, and raising is an effect.
    let impure = match list.nth 3 p { () => decl_impure d, forced => forced };
    let started = begin_func (decl_name d) (list.length (decl_params d)) impure impure
                             (decl_rec d) (list.is_empty (decl_params d)) (decl_span d) source r;
    let fi = list.nth 1 started;
    // The stub `pruned` queues divides by zero on purpose, and is nobody's to
    // be warned about.
    let params_bound = bind_params c (decl_params d) (list.head started);
    let bound = if decl_name d == "<unreached>" { params_bound }
                else { body_lints_warned c (decl_name d) (decl_params d) (decl_body d) params_bound };
    let done = end_func fi (check_expr c (decl_body d) bound);
    (done |> Resolution.set_bodies (list.cons [mi, source, d, fi] (bodies_rev done)))
};

// --- what a nested module sees ---------------------------------------------------

/// A module written inside another sees the names around it.
///
/// `mod`, and so every `struct`, `group` and `union`, is hoisted out to a
/// module of its own (`modules.hoist_mod!`), and a module sees only what it
/// declares and imports. That made a record an island in the file it was
/// written in: a member could not call the helper declared above it, and a
/// field could not be typed with the record declared beside it -- `Rule`'s
/// `standard : Period` in std.time.zone had to be `:any`. It cannot import
/// its parent instead, because the parent imports it and imports form a tree.
///
/// So once every module has declared its names, each nested one is handed its
/// parent's: every global, import and `import a.{x}` member the parent binds
/// and it does not, as though it had written `import parent.{ name }` for
/// each, and every alias the same way. Its own names win, which is what a
/// lexical scope means, and nothing that resolved before resolves differently.
/// The parents go first -- a parent is recorded after what is hoisted out of
/// it, so that is the order from the last module down -- so a module two
/// levels in sees its grandparent's names through its parent's.
///
/// The names are lent as import entries rather than copied as globals, so
/// what they resolve to is the parent's global, and everything downstream --
/// lowering, the type checker's `type_ref`, the unit cache's key, which holds
/// the declared state this produces -- reads them as it reads an import. A
/// nested module may read its parent's `priv` names (`encloses`), as code
/// written in the parent's file always could.
let inherit_enclosing : modules.Loader -> State -> State;
let inherit_enclosing l s =
    fold (fn acc mi -> match modules.module_within (modules.module_at l mi) {
        () => acc,
        outer_name => match modules.find l outer_name {
            () => acc,
            outer => if has_env acc outer && has_env acc mi {
                         set_env mi (inherited outer (env_at acc outer) (env_at acc mi)) acc
                     } else { acc },
        },
    }) s (list.reverse (list.range 0 (modules.module_count l)));

/// `e`, a module written inside module `outer`, lent `oe`'s names.
let inherited outer oe e = {
    // A name the prelude lent binds nothing here: the enclosing module's own
    // is nearer, and takes it back.
    let binds e n = has_global e n || (only_of e n != () && not (is_lent e n));
    let lendable n = not (is_hidden_name n);
    let values = fold (fn acc [n, _] ->
        if lendable n && not (binds acc n) {
            with_only n [Ref.dream outer, n, env_name oe] (without_only n acc)
        } else { acc })
        e (map.pairs (globals oe));
    // What the enclosing module was itself lent stays lent here.
    let members = fold (fn acc [n, sel] ->
        if lendable n && not (binds acc n) {
            let taken = with_only n sel (without_only n acc);
            if is_lent oe n { Environment.set_lent ((Environment.lent taken).[n => true]) taken } else { taken }
        } else { acc })
        values (map.pairs (only oe));
    let named = fold (fn acc [n, r] ->
        if alias_of acc n == () { with_alias n r acc } else { acc })
        members (map.pairs (aliases oe));
    named.[:within => list.cons outer (within oe)]
};

/// The prelude's names, lent to module `mi` wherever it binds none of its
/// own -- see the head of `std.prelude`. Lent as `import std.prelude.{Result}`
/// would bind them, so a lent name resolves, is checked and is a namespace
/// exactly as an imported one is. It is marked as lent, so a declaration or an
/// import of the same name that comes after it -- a session's next entry --
/// takes the name back rather than clashing with it.
///
/// This runs once a module's own names are declared, which is what makes the
/// prelude the last place a name is looked for. The prelude is loaded ahead
/// of every module that can see it (`modules.with_prelude!`), so its own
/// environment is always there to lend from.
let lend_prelude : modules.Loader -> :integer -> State -> State;
let lend_prelude l mi s =
    match modules.find l modules.prelude_name {
        () => s,
        p if p == mi || not (has_env s p) => s,
        p => {
            let pe = env_at s p;
            let e = env_at s mi;
            let lendable n = not (is_hidden_name n) && not (is_private pe n)
                && not (has_global e n) && only_of e n == () && alias_of e n == ();
            let lent = fold (fn acc [n, _] ->
                if lendable n {
                    Environment.set_lent ((Environment.lent acc).[n => true])
                        (with_only n [Ref.dream p, n, modules.prelude_name] acc)
                }
                else { acc }) e (map.pairs (globals pe));
            set_env mi lent s
        },
    };

/// The modules `e` was written inside, nearest first.
let within e = e.[:within else []];

/// May code in module `mi` read module `target`'s private names? Its own, and
/// those of every module it was written inside.
let encloses e mi target = target == mi || list.contains target (within e);

// --- the entry point ---------------------------------------------------------

/// Declare every module a loader holds, in the loader's order. A fresh compile
/// does this and then checks everything; session mode declares a slice of its
/// root on top of the carried result for a warm start.
let declare! : modules.Loader -> State;
let declare! l =
    lend_shorthands (inherit_enclosing l (fold (fn acc mi -> declare_module l mi acc) state
                                   (list.range 0 (modules.module_count l))));

/// The union members are always available. Collection members join them when
/// their standard module is imported, including an enclosing module's imports.
/// This is a table of declarations, so new public members need no second list
/// in the compiler. Own definitions and explicit selective imports win.
let lend_shorthands s = {
    let supported = ["std.prelude.Result", "std.prelude.Option", "std.list", "std.array", "std.map"];
    let sources = filter (fn [_, e] -> list.contains (env_name e) supported) (map.pairs (envs s));
    let es = fold (fn table [mi, e] -> {
        let visible target = list.any (fn [_, ref] -> ref == Ref.dream target) (map.pairs (aliases e));
        let candidates = fold (fn names [target, te] -> {
            let prelude = str.starts_with "std.prelude." (env_name te);
            if not prelude && not (visible target) && mi != target { names }
            else {
                fold (fn acc n -> {
                    if not (list.contains (global_kind te n) [:pure, :impure]) && not prelude { acc }
                    else if n == "Result" || n == "Option" { acc }
                    else { acc.[n => list.append (acc.[n else []]) [[target, n, global_index te n]]] }
                }) names (exports te)
            }
        }) %{} sources;
        let lent = fold (fn acc [n, choices] -> {
            if has_global acc n || only_of acc n != () || builtins.is_builtin n { acc }
            else { match choices {
                [[target, field, _]] =>
                    Environment.set_lent ((Environment.lent acc).[n => true])
                        (with_only n [Ref.dream target, field, env_name (table.[target])] acc),
                _ => Environment.set_overloads ((Environment.overloads acc).[n => choices]) acc,
            } }
        }) e (map.pairs candidates);
        table.[mi => lent]
    }) (envs s) (map.pairs (envs s));
    State.set_envs es s
};

/// The one body every declaration the reachability walk did not reach shares:
/// the same `1 / 0` an unexpanded `expand` is staged as, declared once.
///
/// They need a body at all, rather than simply being left out, because a global
/// of kind `function` names a function index and the VM rejects an image whose
/// global names none -- `global names an out-of-range function`. So "do not
/// resolve this one" has to be spelled as "resolve something trivial", and the
/// only question is what.
///
/// Spelling it as a raise is what makes an incomplete answer loud instead of
/// wrong. If the walk decides a transformer cannot reach a body and the
/// transformer reaches it anyway, it gets `:divide_by_zero` rather than some
/// other declaration's function -- and a macro is pure, so it cannot catch
/// that, which is the same argument `expand.prepare!` already rests on for a
/// snapshot that has fallen behind. The caller answers a failure by running
/// the round again with every declaration a root, which is the whole program.
///
/// **One of these, not one per declaration**, which is what made the stub
/// cheap enough to stop being the cost of a macro. Nothing says two globals
/// may not name the same function: a `GLOB` is a name, a kind and a `FUNC`
/// index, and the VM checks only that the index is in range. So the stub is
/// declared once and every unreached global points at it, which takes the
/// per-declaration work out of three phases at once -- `check_body` does not
/// run, no function record is built, and no nodes are lowered or serialized
/// for it. See "The stub every unreached declaration shares" in docs/notes/macro-expansion.md for
/// what that was worth.
///
/// It is **parameterless and pure** on purpose, whatever the declarations
/// pointing at it were. A pure 0-arity function is a `GLOBAL_VALUE`, so
/// *naming* one evaluates it -- where a stub of the declaration's own arity
/// would hand back a closure, and a call of it with too few arguments would
/// hand back another one. A walk that misses an edge therefore raises at the
/// first mention rather than partially applying something, which is the louder
/// of the two and the whole reason the body is a raise.
///
/// `mi` and `source` come from one of the declarations it stands in for, so a
/// span in the image points somewhere real. Nothing reads it: the image this
/// goes in is handed to the macro VM and thrown away.
let shared_stub p = {
    let sp = decl_span (list.nth 2 p);
    [list.nth 0 p, list.nth 1 p,
     ast.let_d "<unreached>" []
               (ast.binary_e :div (ast.int_e 1 sp) (ast.int_e 0 sp) sp) false sp,
     ()]
};

/// Which queued body a declaration is, by where it was written.
///
/// A span offset alone does not say which declaration: a file is several
/// modules and two files have offsets in common, so the source index goes in
/// front of it -- the same shape `ref_key` uses for the same reason.
let root_key : :integer -> :integer -> :integer;
let root_key source start = source * 4294967296 + start;

/// The declarations with only the bodies `keep` names queued, and one stub
/// for the rest -- `[declared, stubbed]`, `stubbed` the function globals the
/// stub answers for. `keep` holds positions in the queue; `()` keeps all.
///
/// A body left out still has its global: another module's environment names
/// it, and an image records a module as a range of globals. What it no longer
/// has is a function of its own, and `stubbed_to` points it at the stub's,
/// which raises if it is ever run -- as `resolve_reachable!` does for a macro's
/// image. A build reaches no stub: what it leaves out is what nothing reaches.
let pruned : State -> (%{:integer => :bool} | :unit) -> [State, %{:integer => :bool}];
let pruned declared keep = match keep {
    () => [declared, %{}],
    _ => {
        let all = pending declared;
        let numbered = list.zip (list.range 0 (list.length all)) all;
        let held = filter (fn [i, _] -> map.has i keep) numbered;
        let missing = filter (fn [i, _] -> not (map.has i keep)) numbered;
        let es = envs declared;
        let stubbed = fold (fn acc [_, p] ->
            match global_index (es.[list.head p else ()]) (decl_name (list.nth 2 p)) {
                () => acc,
                gi => acc.[gi => true],
            }) %{} missing;
        match missing {
            [] => [declared, %{}],
            [[_, first], .._] =>
                [declared |> State.set_pending (list.reverse (map (fn [_, p] -> p) held + [shared_stub first])),
                 stubbed],
        }
    },
};

/// A resolution whose left-out function globals are pointed at the stub
/// `pruned` queued -- the one body named `<unreached>`.
let stubbed_to : Resolution -> %{:integer => :bool} -> Resolution;
let stubbed_to r stubbed =
    if len stubbed == 0 { r }
    else {
        match filter (fn b -> decl_name (list.nth 2 b) == "<unreached>") (bodies r) {
            [stub, .._] => (r |> Resolution.set_global_recs (map (fn g -> match g {
                [gi, n, :function, ()] if map.has gi stubbed => [gi, n, :function, stub.[3]],
                _ => g,
            }) (r_global_recs r))),
            [] => r,
        }
    };

/// Which bodies a program reaches from the modules in `roots`: their every
/// body, what those name, what that names, and so on -- positions in the
/// queue, which is the order of `bodies r`.
///
/// Read off a finished walk rather than made by one: each part recorded what
/// every body named as it walked it (`part_uses`). A reference to a global
/// with a body is an edge, and a shorthand call nothing has chosen yet is an
/// edge to every member it might mean.
///
/// Reaching a module reaches its hidden bodies too -- `<dispatch>`, the global
/// behind a top-level destructuring -- since what reads them is lowering, by
/// name, and not a name anyone wrote. Every `type` is reached, for the reason
/// given where the walk starts.
let reached : Resolution -> %{:integer => :bool} -> %{:integer => :bool};
let reached r roots = {
    let bs = bodies r;
    let numbered = list.zip (list.range 0 (list.length bs)) bs;
    let es = envs r;
    let by_global = fold (fn acc [i, b] ->
        match global_index (es.[list.head b else ()]) (decl_name (list.nth 2 b)) {
            () => acc,
            gi => acc.[gi => i],
        }) %{} numbered;
    let hidden = fold (fn acc [i, b] ->
        if is_hidden_name (decl_name (list.nth 2 b)) { acc.[list.head b => list.cons i (acc.[list.head b else []])] }
        else { acc }) %{} numbered;
    // What each body names, recorded by each part as it was walked. Only a
    // walk in parts records it, and `compile.kept` asks only of one.
    let uses : [[:integer, [:integer]]] = match parts r {
        () => [],
        ps => list.concat (list.map (fn p -> Resolution.part_uses p) ps),
    };
    let edges = fold (fn acc [i, gis] -> acc.[i => fold (fn ts gi -> match by_global.[gi else ()] {
        () => ts,
        j => list.cons j ts,
    }) [] gis]) %{} uses;
    // A signature names its types without a reference the walk records, and
    // the checker reads every signature, reached or not; so every `type` is
    // kept, and what its description names is followed like anything else.
    let starts = fold (fn acc [i, b] ->
        if map.has (list.head b) roots || named_type_of (decl_body (list.nth 2 b)) != () { list.cons i acc }
        else { acc }) [] numbered;
    let module_of = array.of_list (map list.head bs);
    let rec visit todo !seen !modules = match todo {
        [] => seen,
        [i, ..rest] =>
            if map.has i seen { visit rest seen modules }
            else {
                let mi = module_of.[i];
                let more = if map.has mi modules { [] } else { hidden.[mi else []] };
                visit (edges.[i else []] + more + rest) (seen.[i => true]) (modules.[mi => true])
            },
    };
    visit starts %{} %{}
};

/// What a `type` declaration's body says -- `[shown, description]` -- or `()`
/// for any other body. A `type` is a `let` whose value is its description,
/// written by the parser as this list.
let named_type_of : ast.Expr -> [:any] | :unit;
let named_type_of body = match body {
    [:list, [[:atom, "named", _], [:str, shown, _], desc], _] => [shown, desc],
    _ => (),
};

/// The globals a meaning names, for `reached`: the one it means, or every
/// candidate of a shorthand call nothing chose.
let reach_targets : Meaning -> [:integer];
let reach_targets m = match m {
    Meaning.overloaded(_, choices) => map (fn [_, _, gi] -> gi) choices,
    _ => match target_global m { () => [], g => [g] },
};

/// Resolve the bodies reachable from `roots`, and stub the rest.
///
/// Macro expansion needs the whole program's *names* -- a transformer may call
/// anything the module it is written in can see -- but it does not need the
/// whole program's *bodies*. A macro reaches its own definition and a handful
/// of helpers; resolving and lowering the other two thousand declarations of a
/// program the size of this compiler is the largest fixed cost an expansion
/// pays, and it is paid whether the macro is one line or a hundred.
///
/// What a body can reach is asked of the ordinary resolver rather than of the
/// syntax: `check_body` already records what every name occurrence resolved
/// to, so an alias, a selective import, a captured closure and a function
/// named but never called all mean here exactly what they mean everywhere
/// else. A reference whose target is one of these queued declarations is an
/// edge; anything else -- a builtin, a host member, a parameter, a local -- is
/// not a body and cannot be one.
///
/// `roots` is a map of `root_key`, or `()` for every declaration -- which is
/// the whole program, and is how the fallback path asks for one. The roots
/// used to be an *index*: the bodies queued after a point, which were the
/// wrappers a round of expansion had just declared. That tied what the image
/// held to which macros this round happened to call, and so to the program
/// rather than to the package it came from. Naming the roots by where they
/// were written is what lets expansion say "the transformers" instead.
let resolve_reachable! : modules.Loader -> State -> (State | :unit) -> Resolution;
let resolve_reachable! l declared roots = {
    let es = envs declared;
    let all = pending declared;
    let queued = list.zip (list.range 0 (list.length all)) all;
    let body_global p = global_index (es.[list.head p else ()])
                                     (decl_name (list.nth 2 p));
    // Global index to queue entry, so that a resolved reference is a body in
    // one lookup rather than a scan of the queue per occurrence.
    let indexed = fold (fn acc [i, p] ->
        match body_global p { () => acc, gi => acc.[gi => [i, p]] }) %{} queued;
    let initial = ((resolver es)
        |> Resolution.set_imports (s_imports declared)
        |> Resolution.set_module_recs (s_module_recs declared)
        |> Resolution.set_diags (diags declared));
    let rec walk todo seen r all_refs = match todo {
        [] => [(r |> Resolution.set_refs all_refs), seen],
        [[i, p], ..rest] =>
            if map.has i seen { walk rest seen r all_refs }
            else {
                // This body's occurrences on their own. Merging them into the
                // running table afterwards keeps reading them proportional to
                // the body rather than to everything resolved so far, which a
                // shared table walked once per body would not be.
                let checked = check_body l p (r |> Resolution.set_refs (%{}));
                let occurrences = map.pairs (refs checked);
                let deps = fold (fn acc [_, reference] -> {
                    // Type selection happens after this walk. Retain the
                    // candidates' bodies so the chosen member can execute.
                    let candidates : [:any] = match reference {
                        Meaning.overloaded(_, choices) => list.map (fn [_, _, gi] -> gi) choices,
                        _ => [target_global reference],
                    };
                    fold (fn reached gi -> match indexed.[gi else ()] {
                        () => reached,
                        found => list.cons found reached,
                    }) acc candidates
                }) [] occurrences;
                let merged = fold (fn acc [key, value] -> acc.[key => value])
                                       all_refs occurrences;
                walk (deps + rest) (seen.[i => true]) checked merged
            },
    };
    let rooted = match roots {
        () => queued,
        picked => filter (fn [_, p] ->
            map.has (root_key (list.nth 1 p) (ast.span_start (decl_span (list.nth 2 p)))) picked)
            queued,
    };
    let [walked, seen] = walk rooted %{} initial %{};
    let missing = filter (fn [i, _] -> not (map.has i seen)) queued;
    // Which globals the stub is answering for. `resolve_from!` fills a
    // function global's target from the body that was queued for it and leaves
    // `no_function` where there was none -- which is also what an unfilled
    // virtual gets, so the rewrite below has to know one from the other rather
    // than replacing every hole it finds.
    let stubbed = fold (fn acc [_, p] ->
        match body_global p { () => acc, gi => acc.[gi => true] }) %{} missing;
    // Either way this is the ordinary tail of a resolution: the globals, the
    // wrappers and the module records are built exactly as a whole-program
    // resolve builds them. The only difference is what is queued -- one stub,
    // or nothing at all when the walk reached everything.
    match missing {
        [] => resolve_from! l (declared |> State.set_pending ([])) walked 0 state,
        [[_, first], ..] => {
            let resolved = resolve_from! l
                (declared |> State.set_pending ([shared_stub first])) walked 0 state;
            // The stub is the only body queued, so it is the first of the
            // accumulator the queue is built in reverse in.
            let fi = list.nth 3 (list.head (bodies_rev resolved));
            (resolved |> Resolution.set_global_recs (map (fn g -> match g {
                [gi, n, :function, ()] if map.has gi stubbed => [gi, n, :function, fi],
                _ => g,
            }) (r_global_recs resolved)))
        },
    }
};

/// Resolve these bodies for what their names mean, and nothing else.
///
/// Expansion asks one question of the resolver that is not about compiling
/// anything: what does the name after an `expand` refer to? It asks it the
/// only way that cannot drift from what the compiler would answer -- by
/// building a declaration whose body *is* those names and resolving it, so
/// that an alias, a selective import, a shadowed global and a renamed module
/// all mean here exactly what they mean everywhere else.
///
/// That declaration used to be declared as a global and resolved with the
/// transformers, which put it in the macro image: a few nodes, but enough to
/// make the image a function of *this round's calls* rather than of the
/// package the transformers came from. It is resolved on its own now and
/// thrown away -- the caller wants `refs` and `r_diags` and nothing else, so
/// there is no global to declare and no body to lower.
let resolve_names! : modules.Loader -> State -> [[:any]] -> Resolution;
let resolve_names! l declared ps = {
    let initial = ((resolver (envs declared))
        |> Resolution.set_imports (s_imports declared)
        |> Resolution.set_module_recs (s_module_recs declared)
        |> Resolution.set_diags (diags declared));
    fold (fn acc p -> check_body l p acc) initial ps
};

/// Resolve the newly-declared part of a program on top of a carried resolution.
///
/// `declared` is the scope state after the new declarations; `r0` the resolver
/// everything up to them produced, with its shared tables already filled in;
/// `from` how many queued bodies belong to earlier declarations and only need
/// their indices this time; `s_pre` the scope state as it was before this
/// declaration, whose global records say how many globals already had records.
///
/// A fresh compile calls this the way `resolve!` always has -- `from` 0, `s_pre`
/// the empty `state` -- so one function serves both, and a session cannot take
/// a different path from a build of the same text.
let resolve_from! : modules.Loader -> State -> Resolution -> :integer -> State -> Resolution;
let resolve_from! l declared r0 from s_pre = {
    let walked = fold (fn acc p -> check_body l p acc) (walk_base l declared r0 from)
                           (list.drop from (pending declared));
    finish_walk declared r0 s_pre walked (bodies walked)
                (map (fn b -> wrapper_candidate walked b) (bodies walked))
};

/// The state a walk of the bodies starts from: the declarations' environments,
/// and what deforestation has to know before the first body is walked.
let walk_base l declared r0 from = {
    let base0 = (r0 |> Resolution.set_envs (envs declared) |> Resolution.set_frames ([]));
    // Deforestation needs three things settled before a body is walked: which
    // global is which `std.list` member, where the globals it invents start,
    // and an empty list to put them in. A resolution that is not a compile --
    // a session's, a language server's -- does not fuse and carries none of it.
    let base =
        if not (fuses r0) { base0 }
        else {
            let base_roles = list_roles l (envs declared);
            (base0
                |> Resolution.set_roles (alias_roles (envs declared) (pending declared) base_roles)
                |> Resolution.set_result_roles (alias_roles (envs declared) (pending declared) (prelude_roles (envs declared)))
                |> Resolution.set_role_names (role_spellings (envs declared) (pending declared) base_roles)
                |> Resolution.set_next_global (next_global declared)
                |> Resolution.set_fused ([]))
        };
    let new_pending = list.drop from (pending declared);
    // The global behind a destructuring is how one was compiled, not something
    // anyone defined, so it stays out of an outline.
    (base |> Resolution.set_defs (list.append (defs base)
                   (map (fn p -> [list.nth 0 p, list.nth 1 p, decl_name (list.nth 2 p),
                                       decl_span (list.nth 2 p)])
                             (filter (fn p -> not (is_hidden_name (decl_name (list.nth 2 p))))
                                          new_pending))))
};

/// Everything after the walk: which function each global names, which globals
/// are wrappers, and the global records. `bs` are the bodies the walk queued,
/// in order, and `candidates` what `wrapper_candidate` said of each -- passed
/// in rather than worked out here because a walk made in parts can only ask
/// a body about itself in the part that walked it (see "resolving in parts").
let finish_walk declared r0 s_pre walked bs candidates = {
    // A global that names a function could not say which function until the
    // function existed, which is now. Joining here rather than threading a
    // half-filled record through the walk keeps the walk about names.
    let by_global = list.fold (fn acc b -> {
        let e = env_at declared (list.nth 0 b);
        match global_index e (decl_name (list.nth 2 b)) {
            () => acc,
            gi => acc.[gi => (list.nth 3 b)],
        }
    }) (%{}) bs;
    // Which globals are wrappers, so lowering can emit what they stand for.
    let aliased = fold (fn acc bc -> {
        let [b, candidate] = bc;
        let mi = list.nth 0 b;
        let d = list.nth 2 b;
        match global_index (env_at declared mi) (decl_name d) {
            () => acc,
            gi =>
                match wrapper_from walked by_global candidate {
                    () => acc,
                    found =>
                        if target_global (Wrapper.target found) == gi { acc }
                        else { acc.[gi => found] },
                },
        }
    }) (%{}) (list.zip bs candidates);

    // Only the globals this declaration added get records, and they go on the
    // end of the ones already in the carried resolution.
    let fresh =
        list.drop (s_global_recs_count s_pre) (s_global_recs declared);
    let filled = map (fn g ->
         match list.nth 2 g {
             :function => [list.nth 0 g, list.nth 1 g, :function,
                           by_global.[(list.nth 0 g) else no_function]],
             _ => g,
         }) fresh;

    (walked |> Resolution.set_wrappers (fold (fn acc kv ->
                 acc.[(list.head kv) => (list.nth 1 kv)])
                       (wrappers r0) (map.pairs aliased))
                           |> Resolution.set_global_recs (list.append (list.append (r_global_recs r0) filled) (fused walked)))
};

/// Resolve and purity-check a whole loaded program.
///
/// Answers the resolver: the diagnostics, and -- just as importantly -- what
/// every name turned out to mean, every function the program contains, and
/// which function holds each module's globals. Lowering reads all of that
/// rather than deriving it a second time.
let resolve! : modules.Loader -> Resolution;
let resolve! l = resolve_chosen! l %{} ();

/// The same with the members each shorthand call was found to mean, and only
/// the bodies `keep` names, the rest answered by a stub (`pruned`), or every
/// body for `keep` `()`.
let resolve_chosen! : modules.Loader -> :map -> (%{:integer => :bool} | :unit) -> Resolution;
let resolve_chosen! l selections keep = {
    let [declared, stubbed] = pruned (declare! l) keep;
    let r0 = ((resolver (envs declared))
        |> Resolution.set_imports (s_imports declared)
        |> Resolution.set_module_recs (s_module_recs declared)
        |> Resolution.set_diags (diags declared)
        |> Resolution.set_selections selections
        |> Resolution.set_fuse true);
    // What expansion already resolved, before the walk begins. An `expand`'s
    // own name is a name occurrence like any other, but the only pass that
    // ever sees it is the one that replaces it -- so this program does not
    // contain it and the walk below cannot record it. Seeding is how those
    // occurrences reach `at`, which is the question hover and go-to-definition
    // are. Nothing downstream reads them: lowering asks about nodes, and the
    // nodes at these offsets are gone. See `modules.expansions`.
    let seeded = fold (fn r e ->
        (r |> Resolution.set_refs ((refs r).[(ref_key (list.nth 0 e) (list.nth 1 e) (list.nth 2 e)) => (list.nth 3 e)])))
        r0 (modules.expansions l);
    stubbed_to (resolve_from! l declared seeded 0 state) stubbed
};

// --- resolving in parts ------------------------------------------------------------
//
// Walking a body reads the declarations and nothing another body's walk wrote,
// so the bodies can be walked in several processes at once, each from the
// same starting state -- 0.95 s of a self-compile, which is almost all of
// resolving, spread over four cores. What one walk shares with the next is
// three counters and one table, and each is why this section exists:
//
//   - **Function indices** are handed out in the order the walk meets
//     functions. Each part numbers its own from where the declarations left
//     off, and the merge moves part k's by the count of every part before it.
//     So the program's functions come in part order rather than body order,
//     which changes the image and nothing else: an index is a name.
//   - **Invented globals** (deforestation's loops) are numbered the same way
//     and moved the same way.
//   - **Name uses and binders** are recorded by span, in two tables that are
//     most of what a resolution weighs. They are not merged at all. Lowering
//     and checking a body ask about that body's names and no other's, so each
//     part is lowered and checked in a process holding its own resolution
//     (`lower.link_parallel!`, `compile.analyze_parallel!`), and what the
//     merge answers carries only what is about the whole program: the
//     functions, the globals, the bodies, the diagnostics, the wrappers. A
//     caller asking the merged resolution what a name means finds nothing;
//     the part that walked the name knows.
//   - **Wrappers** are a table of the whole program read by every part's
//     lowering, and deciding one reads the wrapper's own body. So each part
//     says what its bodies can say about themselves (`wrapper_candidate`) and
//     the merge finishes them against every function (`wrapper_from`).
//
// Diagnostics are kept against the position of the body that said them, and
// put back in that order, so a program resolved in parts reports what one
// resolved whole does, in the same order.

/// The resolution of every part, in part order, or `()` for one walked whole.
let parts r = Resolution.parts r;

/// Where a part's function indices and invented globals start in the whole
/// program's, relative to where the declarations left them: `[functions,
/// globals]`. What `lower` renumbers a part's arena by.
let part_offsets : Resolution -> [:integer, :integer];
let part_offsets r = Resolution.part_offsets r;

/// The first index an invented global may have: every index below it is a
/// declaration's, and is the same in every part.
let invented_from : Resolution -> :integer;
let invented_from r = Resolution.invented_from r;

/// The bodies a part walked, `[position, body]` each, the position being the
/// body's place in the whole program's queue.
let part_bodies : Resolution -> [[:any]];
let part_bodies r = Resolution.part_bodies r;

/// Walk some bodies -- `[position, pending entry]` each -- from the shared
/// starting state `walk_base` made: the part `merge_parts` combines.
let walk_part l base numbered = {
    let walked = list.fold (fn acc np -> {
        let [r0, notes0, uses0] = acc;
        // The body's occurrences on their own, then merged: what it names is
        // what `reached` follows, and read from the walk rather than from the
        // offsets afterwards, since syntax a macro made carries the offsets
        // of the macro's own file.
        let done = check_body l (list.nth 1 np) (r0 |> Resolution.set_diags ([]) |> Resolution.set_refs (%{}));
        let own = refs done;
        let merged = (done |> Resolution.set_refs (fold (fn m [k, v] -> m.[k => v]) (refs r0) (map.pairs own)));
        let said = r_diags done;
        let notes = if list.is_empty said { notes0 }
                    else { list.cons [list.head np, said] notes0 };
        let uses = list.cons [list.head np, list.concat (map reach_targets (map.values own))] uses0;
        // Forced before they are carried, for the reason `lazy.forced` gives.
        if lazy.forced notes && lazy.forced merged && lazy.forced uses { [merged, notes, uses] }
        else { [merged, notes, uses] }
    }) [base, [], []] numbered;
    let r = list.head walked;
    let placed = list.zip (map (fn np -> list.head np) numbered) (bodies r);
    (r
        |> Resolution.set_part_notes (list.reverse (list.nth 1 walked))
        |> Resolution.set_part_bodies placed
        |> Resolution.set_part_candidates (map (fn pb -> wrapper_candidate r (list.nth 1 pb)) placed)
        |> Resolution.set_part_uses (list.reverse (list.nth 2 walked)))
};

/// The parts as one resolution, with the parts kept in it (`parts`) and each
/// part told where it starts (`part_offsets`). See "resolving in parts".
let merge_parts declared r0 base walked = {
    let f0 = func_count base;
    let g0 = next_global base;
    // A part numbered what it invented from `invent_base`; its `go` takes
    // those to where they stand after the declarations and the parts before.
    let counted = list.fold (fn acc r -> {
        let [fo, go, out] = acc;
        [fo + func_count r - f0, go + next_global r - invent_base, list.cons [fo, g0 - invent_base + go] out]
    }) [0, 0, []] walked;
    // Arrays where a part is read by its index in a loop over the parts, as
    // in `lower.link_head`: read from a list, each is a walk to the part.
    let offsets = array.of_list (list.reverse (list.nth 2 counted));
    let told = map (fn kr -> ((list.nth 1 kr) |> Resolution.set_part_offsets (offsets.[list.head kr])))
                        (list.zip (list.range 0 (list.length walked)) walked);
    let ta = array.of_list told;
    let funcs = fold (fn m k -> {
        let r = ta.[k];
        let fo = list.head (offsets.[k]);
        fold (fn m2 i -> m2.[i + fo => func_at r i]) m (list.range f0 (func_count r))
    }) (func_map base) (list.range 0 (list.length told));
    let moved_body pb fo = {
        let [mi, source, d, fi] = list.nth 1 pb;
        [list.head pb, [mi, source, d, fi + fo]]
    };
    let placed = list.sort_on (fn pb -> list.head pb) (list.concat (map (fn k -> {
        let fo = list.head (offsets.[k]);
        map (fn pb -> moved_body pb fo) (part_bodies (ta.[k]))
    }) (list.range 0 (list.length told))));
    let candidates = list.sort_on (fn pc -> list.head pc) (list.concat (map (fn r ->
        list.zip (map (fn pb -> list.head pb) (part_bodies r)) (Resolution.part_candidates r)) told));
    let invented = list.concat (map (fn k -> {
        let [fo, go] = offsets.[k];
        map (fn g -> [list.nth 0 g + go, list.nth 1 g, list.nth 2 g, list.nth 3 g + fo])
                 (fused (ta.[k]))
    }) (list.range 0 (list.length told)));
    let notes = list.sort_on (fn n -> list.head n) (list.concat (map (fn r -> (Resolution.part_notes r)) told));
    let bs = map (fn pb -> list.nth 1 pb) placed;
    let said = list.concat (map (fn n -> list.nth 1 n) notes);
    let numbered = (base |> Resolution.set_funcs funcs |> Resolution.set_func_count (f0 + list.head counted));
    let queued = (numbered |> Resolution.set_bodies (list.reverse bs) |> Resolution.set_next_global (g0 + list.nth 1 counted));
    let whole = (queued
        |> Resolution.set_fused (list.reverse invented)
        |> Resolution.set_diags (list.append (r_diags base) said)
        |> Resolution.set_parts told
        |> Resolution.set_invented_from invent_base);
    finish_walk declared r0 state whole bs (map (fn pc -> list.nth 1 pc) candidates)
};

/// `resolve!`, with the bodies walked in `part_count` processes. The loader,
/// the starting state and every part are shared (`vm.share!`), so what crosses
/// between processes is pointers; see "resolving in parts" for what the
/// answer does and does not hold.
let resolve_parts! : modules.Loader -> :any -> Resolution;
let resolve_parts! l cache = resolve_parts_chosen! l cache %{} () ();

/// The same with the members each shorthand call was found to mean, given the
/// walk made before they were known (`compile.resolve!`). A module where no
/// call chose anything walks to exactly the part it walked then -- its walk
/// reads only its own module's choices (`chosen_in`), and nothing else in
/// what every part starts from has changed -- so that part is kept rather
/// than walked again, and only the modules that chose are. `previous` is
/// `()` for no earlier walk. `keep` is `resolve_chosen!`'s.
let resolve_parts_chosen! : modules.Loader -> :any -> :map -> ([Resolution] | :unit) -> (%{:integer => :bool} | :unit) -> Resolution;
let resolve_parts_chosen! l cache selections previous keep = {
    let [declared, stubbed] = pruned (declare! l) keep;
    let r0 = ((resolver (envs declared))
        |> Resolution.set_imports (s_imports declared)
        |> Resolution.set_module_recs (s_module_recs declared)
        |> Resolution.set_diags (diags declared)
        |> Resolution.set_selections selections
        |> Resolution.set_fuse true);
    let seeded = fold (fn r e ->
        (r |> Resolution.set_refs ((refs r).[(ref_key (list.nth 0 e) (list.nth 1 e) (list.nth 2 e)) => (list.nth 3 e)])))
        r0 (modules.expansions l);
    let shared_l = vm.share! l;
    let declared_base = walk_base shared_l declared seeded 0;
    // Every part invents its globals from `invent_base` rather than from where
    // the declarations left off, and `merge_parts` moves them to where they
    // belong, as it moves each part's functions. The number of declarations
    // is then nothing a part's walk depends on, so adding one does not make
    // every part another part (see "a part as a unit").
    let base = vm.share! (declared_base |> Resolution.set_next_global invent_base);
    let common = match cache { () => "", _ => common_key l base };
    let under = match cache { () => %{}, _ => modules_under l };
    let all = pending declared;
    let numbered = list.zip (list.range 0 (list.length all)) all;
    // One part per module whose bodies it walks, in the order of the modules:
    // a module's bodies are what a change to it changes, so a part is a unit
    // that can be kept between builds (see "a part as a unit"). Dealt before
    // any process starts, for the reason `lower.link_parallel!` gives.
    let by_module = fold (fn m np -> {
        let mi = list.head (list.nth 1 np);
        m.[mi => list.cons np (m.[mi else []])]
    }) (%{}) numbered;
    let slices = strict! (map (fn mi -> list.reverse (by_module.[mi]))
                                   (list.sort (map list.head (map.pairs by_module))));
    let key_of slice = match cache {
        () => "",
        _ => part_key under base common (list.head (list.nth 1 (list.head slice))),
    };
    let choosing = fold (fn m key -> m.[key / 281474976710656 => true]) %{} (map.keys selections);
    let kept : [Option Resolution] = match previous {
        ps if ps != () && list.length ps == list.length slices =>
            map (fn [slice, p] -> if map.has (list.head (list.nth 1 (list.head slice))) choosing { Option.none } else { Option.some p })
                (list.zip slices ps),
        _ => map (fn _ -> Option.none) slices,
    };
    let walking = list.concat (map (fn [slice, p] -> match p { Option.none => [slice], Option.some(_) => [] })
                                   (list.zip slices kept));
    let running = strict! (map (fn slice -> walk_elsewhere! cache shared_l base (key_of slice) slice) walking);
    let fresh = progress.join_all! "resolving" running;
    stubbed_to (merge_parts declared seeded declared_base (in_order kept fresh)) stubbed
};

/// The parts kept from an earlier walk, with the ones walked again put in
/// the holes they left, in order.
let in_order : [Option Resolution] -> [Resolution] -> [Resolution];
let rec in_order kept fresh = match kept {
    [] => [],
    [Option.none, ..rest] => list.cons (list.head fresh) (in_order rest (list.tail fresh)),
    [Option.some(p), ..rest] => list.cons p (in_order rest fresh),
};

/// A process walking one part. Its own function so that the suspension
/// `spawn!` copies holds the loader, the state and the slice -- all shared, or
/// small -- and nothing else. The cache and the key are strict for the same
/// reason: handed in unforced, the key was a suspension of the caller's frame,
/// and every part's process was given a copy of the whole resolution with it
/// -- 1.7 GB more copied on a self-compile, and twice the time, with no cache
/// at all.
let walk_elsewhere! !cache l base !base_key slice = spawn! $( vm.share! (walk_unit! cache l base base_key slice) );

// --- a part as a unit ---------------------------------------------------------------
//
// A part's walk is a function of the state every part starts from and of its
// own module's bodies, so with a unit cache it is kept, as what it added to
// that state, under a key made of both (see `dreams/src/unit.dr`). It is walked
// with positions counted from its own first body, and shifted to where it
// stands after: a body added to an earlier module moves every later one, and
// a unit that held absolute positions would be stale for no reason. The key
// holds only the part of that state the part can read (`part_key`): the
// environments of the modules its own can name, and not the number of globals
// declared, since the globals it invents are numbered from `invent_base`.

/// Where a part walked in parts numbers the globals it invents. Past any
/// program's declarations by far, so that nothing at or above it is a declared
/// global, and small enough to stay a fixnum through every offset added to it.
let invent_base = 67108864;

/// What every part's key holds: the state every part starts from, less what no
/// walk reads, and less the environments, which a part's key holds only as many
/// of as it can see (`part_key`). Less `defs`, the outline of every declaration
/// with its span -- one character typed anywhere moved a span in it. Less the
/// declaring pass's diagnostics and `module_recs`, which the walk carries and
/// never reads. Less the selections -- the member each shorthand call was
/// found to mean -- which a part's key holds only for its own module
/// (`chosen_in`): held whole, the second walk `compile.resolve!` makes once
/// they are known keyed every part anew, and a program that reached a single
/// shorthand anywhere walked an edited module twice. With the modules' names,
/// which the walk reads from the loader for a group's members.
let common_key l base = unit.digest [
    fold (fn b k -> map.remove k b) base [:defs, :envs, :diags, :module_recs, :selections],
    map (fn i -> modules.module_name (modules.module_at l i)) (list.range 0 (modules.module_count l)),
];

/// A part's key: what every part shares, and the environments of the modules
/// the part's own module can reach. A name is resolved in the module's own
/// environment, and through it -- an alias, an `import a.{x}` selection, a
/// namespace -- in the environment of a module it names, or of one of that
/// module's submodules; no walk reads any other. So a declaration added to a
/// module moves the parts that can see it and not the rest, as long as it
/// moves no other module's globals: globals are numbered in module order, so
/// one added early in the program is still seen by nearly every part.
let part_key : :map -> :map -> :string -> :integer -> :string;
let part_key under base common mi = {
    let seen = reached_modules (env_at base mi) (%{ mi => true });
    let visible = list.fold (fn acc key -> list.fold (fn a i -> a.[i => true]) acc (under.[key else []]))
                            seen (map.keys seen);
    let ordered = list.sort (filter (fn t -> type_of t == :integer) (map.keys visible));
    unit.key ["base", common, unit.digest (map (fn t -> [t, env_at base t]) ordered),
              unit.digest (chosen_in base mi)]
};

/// The selections made at calls in module `mi`, in key order: all a part's
/// walk reads of them, since a call is looked up by its own module's
/// `ref_key`, and that key is the module's index above its 48 low bits.
let chosen_in : :map -> :integer -> [[:integer, :any]];
let chosen_in base mi =
    list.sort_on list.head (filter (fn [key, _] -> key / 281474976710656 == mi)
                                   (map.pairs (Resolution.selections base)));

/// The modules under each module and each namespace, by the module's index or
/// the namespace's name: `std` and `std.list` lead to `std.list.sorted`, if
/// there is one. Made once for every part's key, since asked per part it was
/// every module's name against every prefix, for every part -- a quadratic
/// that made a warm build of 800 modules slower than no cache at all.
let modules_under : modules.Loader -> :map;
let modules_under l = {
    let count = modules.module_count l;
    let index = fold (fn m i -> m.[modules.module_name (modules.module_at l i) => i]) (%{}) (list.range 0 count);
    fold (fn acc i -> {
        let parts = str.split "." (modules.module_name (modules.module_at l i));
        let prefixes = map (fn n -> str.join_str "." (list.take n parts)) (list.range 1 (list.length parts));
        fold (fn a pre -> {
            let by_name = a.[pre => list.cons i (a.[pre else []])];
            match index.[pre else ()] { () => by_name, t => by_name.[t => list.cons i (by_name.[t else []])] }
        }) acc prefixes
    }) (%{}) (list.range 0 count)
};

/// Every module an environment names, as `index => true`, and every namespace,
/// as `prefix => true`: read off the environment whole, so that no way of
/// naming a module is missed.
let rec reached_modules v !acc = match v {
    Ref.dream(t) if type_of t == :integer => acc.[t => true],
    Ref.group(p) if type_of p == :string => acc.[p => true],
    xs if type_of xs == :list => list.fold (fn a x -> reached_modules x a) acc xs,
    m if type_of m == :map => fold (fn a kv -> reached_modules (list.nth 1 kv) a) acc (map.pairs m),
    _ => acc,
};

/// Walk one part, or read it back.
let walk_unit! cache l base base_key slice = match cache {
    () => walk_part l base slice,
    _ => walk_kept! cache l base base_key slice,
};

let walk_kept! cache l base base_key slice = {
    let from = list.head (list.head slice);
    let local = unit.shifted (0 - from) slice;
    let k = match cache { () => (), _ => unit.key ["walk", base_key, unit.digest local] };
    let walked = match unit.recall! cache "walk" k {
        () => {
            let r = walk_part l base local;
            unit.keep! cache "walk" k (unit.delta base r)
            r
        },
        d => unit.restore base d,
    };
    (walked
        |> Resolution.set_part_bodies (unit.shifted from (part_bodies walked))
        |> Resolution.set_part_notes (unit.shifted from (Resolution.part_notes walked))
        |> Resolution.set_part_uses (unit.shifted from (Resolution.part_uses walked))
        |> Resolution.set_unit_key k)
};

/// The key a part was kept under, or `()` for a build that keeps none. What
/// lowering keys the part's lowering by, with the wrappers it lowers against.
let unit_key r = Resolution.unit_key r;

// --- wrappers ---------------------------------------------------------------------
//
// A wrapper that only passes its arguments on -- `let head xs = head xs`,
// `let kind t = array_get t 0` -- costs a call and a frame at every use in
// order to do nothing. A standard library is full of them, and so is a compiler:
// reading one token through six of them was a fifth of everything this one did.
//
// So resolution records which globals are exactly that, and lowering emits the
// call the wrapper stands for instead of a call to the wrapper. This is not
// general inlining, and the narrowness is what makes it obviously sound. The
// body must be one application whose arguments are the wrapper's own
// parameters, each used at most once, and literals; the call site must pass
// exactly as many arguments as the wrapper takes.
//
// Under those conditions the rewrite is an identity. The frame that disappears
// bound nothing but the arguments the inner call was going to be given anyway,
// and every argument stays the same thunk in the same place -- so nothing is
// evaluated that was not evaluated before, and nothing twice. Requiring the
// call to be saturated is what keeps a variadic host function honest: a
// variadic native means "everything at this call site", and an unsaturated
// call, or one with arguments to spare, is left alone.

/// One argument of a wrapper's body, as the call site will rebuild it: the
/// caller's k-th argument, or a literal.
union Arg {
    param(index)
    constant(expr)
}

/// What a wrapper's call becomes when it is not a call: one container
/// operation (`:get` or `:set`) on the call's arguments, or a record made of
/// them (see `constructor_of`).
union Inline {
    op(kind)
    record(id, variant, rewritable, fields)
}

/// The call a wrapper stands for. `target` is the `Meaning` of the function
/// called, or an `Inline`; `plan` is an `Arg` for each argument it is given;
/// `arity` is how many the wrapper takes, which a call must pass exactly.
struct Wrapper { target, plan : [Arg], arity : :integer }

/// What a body can say about being a wrapper by itself (`wrapper_candidate`).
union Candidate {
    wrapper(found)
    rename(target)
}

let literal_expr e =
    match e {
        [:int, _, _]   => true,
        [:float, _, _] => true,
        [:str, _, _]   => true,
        [:char, _, _]  => true,
        [:bool, _, _]  => true,
        [:atom, _, _]  => true,
        [:unit, _]     => true,
        // An empty list or map is as much a constant as a number: it names
        // nothing, so it means the same at the call site as in the wrapper.
        // They are what an accessor's default is -- `p.[:nodes else (%{})]`
        // -- and without them every such accessor was a call and a frame.
        [:list, [], _] => true,
        [:map, [], _]  => true,
        _ => false,
    };

/// Where `name` sits in a parameter list, or `-1`.
let param_slot params name = {
    let rec go i =
        if i >= list.length params { 0 - 1 }
        else if ast.param_name (list.nth i params) == name { i }
        else { go (i + 1) };
    go 0
};

/// One argument of a wrapper's body, as the call site will rebuild it: an
/// `Arg`, or `()` for anything that cannot be moved.
let wrapper_arg params used e =
    match e {
        [:name, n, _] => {
            let k = param_slot params n;
            if k < 0 { () }
            // A parameter used twice would put the caller's argument node in
            // two places, and the same work would be done twice where the
            // wrapper's frame did it once.
            else if list.contains k used { () }
            else { Arg.param k }
        },
        _ => if literal_expr e { Arg.constant e } else { () },
    };

let rec wrapper_args params used args !acc =
    match args {
        [] => list.reverse acc,
        [a, ..rest] =>
            match wrapper_arg params used a {
                () => (),
                Arg.param(k) => wrapper_args params (list.cons k used) rest
                                             (list.cons (Arg.param k) acc),
                plan => wrapper_args params used rest (list.cons plan acc),
            },
    };

/// Does this plan pass on every parameter? Each appears at most once already,
/// so counting them is enough.
let params_all_used plan arity =
    list.count (fn step -> match step { Arg.param(_) => true, Arg.constant(_) => false }) plan == arity;

/// The plan of a wrapper that passes every parameter on, in order.
let passed_on : :integer -> [Arg];
let passed_on arity = map (fn k -> Arg.param k) (list.range 0 arity);

/// A target that can be named from another module's frame. A local or a capture
/// cannot: it means something only inside the body it was written in.
let wrapper_target_ok t =
    match t {
        Meaning.builtin(_) => true,
        Meaning.member(Ref.native(_, _), _, _) => true,
        Meaning.member(Ref.dream(_), _, _) => true,
        Meaning.global(_, _, _) => true,
        _ => false,
    };

/// The global a target names, or `()` -- used only to refuse a wrapper that
/// stands for itself.
let target_global t =
    match t {
        Meaning.global(_, _, g) => g,
        Meaning.member(Ref.dream(_), _, g) => g,
        _ => (),
    };

/// The call this declaration stands for: a `Wrapper`, or `()`.
///
/// A record's or a union's constructor is filed here too, whatever it looks
/// like, because the table is where lowering finds what a constructor makes:
/// a constructor pattern asks it for the id to test (`lower.record_test`).
let wrapper_of r mi source d =
    match constructor_of d {
        () => plain_wrapper_of r mi source d,
        made => made,
    };

/// A constructor, as `syntax.record` and `syntax.union_decl` write one --
/// `_record_of :id variant #[fields..]` -- as a `Wrapper` whose target is an
/// `Inline.record`.
///
/// `rewritable` says a call may become the `record_make` itself, the way a
/// wrapper's call becomes the call it stands for: only when its fields are
/// its parameters, in order, and none of them is strict -- a strict field is
/// forced by the constructor's frame, which the rewrite would remove. `make`
/// of a record with no fields takes a `()` it does not keep, and is called.
/// `fields` is how many the record has, which a pattern must take apart.
let constructor_of d =
    match decl_body d {
        [:apply, [:name, "_record_of", _], [[:atom, id, _], [:bool, variant, _], [:array, fields, _]], _] => {
            let params = decl_params d;
            let passed = list.map (fn f -> match f { [:name, n, _] => n, _ => () }) fields;
            let rewritable = not (list.any ast.param_strict params)
                             && passed == map ast.param_name params;
            Wrapper.make (Inline.record id variant rewritable (list.length fields))
                         (passed_on (list.length params)) (list.length params)
        },
        _ => (),
    };

let plain_wrapper_of r mi source d = {
    let params = decl_params d;
    // A wrapper with no parameters is a constant, and a constant is evaluated
    // once and shared. Rewriting its uses into the call it came from would do
    // the work at every use instead.
    if list.is_empty params { () }
    // A strict parameter is forced by the frame the rewrite removes, so a
    // wrapper with one is not an identity: `let set_x !v r = r.[0 => v]` made
    // into a `set` at the call site stored the argument suspended, and a
    // strict record field was exactly as lazy as any other.
    else if list.any ast.param_strict params { () }
    else {
        match decl_body d {
            [:apply, callee, args, _] => {
                let target = match callee {
                                 [:name, _, span]     => resolution r mi source span,
                                 [:field, _, _, span] => resolution r mi source span,
                                 _ => (),
                             };
                if not (wrapper_target_ok target) { () }
                else {
                    match wrapper_args params [] args [] {
                        () => (),
                        plan =>
                            // Every parameter, exactly once. "At most once" is
                            // not enough: an argument the wrapper ignores would
                            // be dropped at the call site and never lowered,
                            // and a lambda in that position was given a
                            // function record when it was resolved. A record
                            // whose body was never emitted is a malformed
                            // image -- the argument is dead, but the hole it
                            // leaves is not.
                            if params_all_used plan (list.length params) {
                                Wrapper.make target plan (list.length params)
                            } else { () },
                    }
                }
            },
            // One `get` or `set` of the parameters is a wrapper as well --
            // `let map_get m k d = m.[k else d]` -- and a call of it becomes
            // that operation on the call's own arguments.
            [:get, container, key, fallback, _] =>
                op_wrapper params :get (match fallback { () => [container, key], f => [container, key, f] }),
            [:set, container, key, value, _] => op_wrapper params :set [container, key, value],
            _ => (),
        }
    }
};

/// What a body can say about being a wrapper by itself: `Candidate.wrapper`
/// when it is one outright, `Candidate.rename` when it is a bare name that may
/// be a rename, or `()`. A rename needs the target's function to say its
/// arity, and so the whole program's functions, which is why `wrapper_from`
/// finishes it: a walk made in parts can only ask a body about its own name
/// uses in the part that walked it, and only knows every function once every
/// part is in (see "resolving in parts").
let wrapper_candidate r b = {
    let [mi, source, d, _] = b;
    match wrapper_of r mi source d {
        () => if not (list.is_empty (decl_params d)) { () }
              else {
                  let target = match decl_body d {
                      [:name, _, span]     => resolution r mi source span,
                      [:field, _, _, span] => resolution r mi source span,
                      _ => (),
                  };
                  if target_global target == () { () } else { Candidate.rename target }
              },
        found => Candidate.wrapper found,
    }
};

/// The `Wrapper` a candidate comes to, given every function, or `()`.
///
/// A declaration that only renames a function -- `let node_op = Node.op;`,
/// `let nth = list.nth;` -- is the wrapper it amounts to, with every parameter
/// passed on in order.
///
/// Such a global's value is the function it names, so a saturated call of it
/// is a call of that function with the same arguments, and nothing is
/// evaluated that was not before: the rename is read once and shared, and the
/// call it stands for is the call it makes. What the rewrite removes is the
/// read and the application of a closure where the named function would have
/// been entered directly -- and, because the target is so often a wrapper
/// itself (a record's accessor is one `get`), usually the call as well. A
/// compiler written in this style renames its accessors at the top of every
/// file, and each of those renames was a call at every use.
///
/// Only a function the program declares, with parameters, is followed: its
/// arity is what says a call is saturated, and a global with no parameters is a
/// value rather than a function.
let wrapper_from r by_global candidate = match candidate {
    Candidate.wrapper(found) => found,
    Candidate.rename(target) => match by_global.[target_global target else ()] {
        () => (),
        fi => {
            let arity = func_arity (func_at r fi);
            if arity < 1 { () }
            else { Wrapper.make target (passed_on arity) arity }
        },
    },
    _ => (),
};

/// A wrapper whose body is one container operation: its target an `Inline.op`.
/// The plan is the operands in order, and each is held to the rule a call's
/// arguments are: a parameter used exactly once, or a literal.
let op_wrapper params kind operands =
    match wrapper_args params [] operands [] {
        () => (),
        plan =>
            if params_all_used plan (list.length params) { Wrapper.make (Inline.op kind) plan (list.length params) }
            else { () },
    };

// --- deforestation ------------------------------------------------------------
//
// A pipeline of `std.list` combinators becomes one loop, and the list between
// them is never built. What that is worth, and why it is worth it here rather
// than in the VM, is written up in `dreams/src/fuse.dr`; this is the half that
// decides *whether*, because only a resolved name can.
//
// "Only a resolved name" is the whole reason this lives in the resolver. A
// pass over the syntax would see `list.range` and have to guess: `list` may be
// a parameter, the module may have declared its own `range`, an import may
// have renamed something, and a module may have been derived from. What a call
// site resolves to is a global index, and an index cannot be spelled two ways
// -- so the question "is this really `std.list`'s `range`?" becomes "is this
// the index `std.list` gave `range`?", which has one answer.
//
// The recognition is narrow on purpose. A sink written as a saturated call,
// whose last argument is *written there* as a saturated call to a source: no
// binding in between, because a named list is a shared one and fusing it would
// build it twice. A fold's function must be a lambda written at the call site,
// because it is inlined into the loop -- passing it by name would leave a
// closure call in the loop's body, and a loop that calls a closure is a loop
// the JIT will not take, which is the entire point of the exercise.

/// Which global a module-level expression plainly names, or `()`.
///
/// Only the two shapes an alias is ever written in -- `list.fold_strict` and,
/// after `import std.list.{fold_strict}`, `fold_strict`. There are no frames at
/// module level, so there is nothing to shadow it and nothing to thread.
let static_global es mi e =
    match e {
        [:name, n, _] => {
            let e0 = es.[mi else ()];
            if has_global e0 n { global_index e0 n }
            else {
                match only_of e0 n {
                    [m, field, _] =>
                        match m { Ref.dream(t) => global_index (es.[t else ()]) field, _ => () },
                    _ => (),
                }
            }
        },
        [:field, obj, field, _] =>
            match obj {
                [:name, a, _] =>
                    match alias_of (es.[mi else ()]) a {
                        Ref.dream(t) => global_index (es.[t else ()]) field,
                        _ => (),
                    },
                _ => (),
            },
        _ => (),
    };

/// Global index -> role, for every member of `std.list` this pass knows about.
///
/// Built once, before a body is walked, because it is the same answer for the
/// whole program: a global index is a property of the program, not of where it
/// is used. A program with no standard library has no roles and no fusion.
let list_roles l es = {
    let names = module_names l;
    fold (fn acc [module, kind] -> {
        let hits = filter (fn i -> list.nth i names == module) (list.range 0 (list.length names));
        if list.is_empty hits { acc }
        else {
            let e = es.[list.head hits else ()];
            fold (fn a n -> match fuse.member_of kind n {
                () => a,
                member => match global_index e n {
                    () => a,
                    gi => a.[gi => member],
                },
            }) acc fuse.member_names
        }
    }) %{} [["std.list", :list], ["std.array", :array], ["std.map", :map]]
};

/// Every spelling those globals answer to: the member names themselves, and
/// the name of any `let` that renames one.
let role_spellings es pend base =
    list.fold (fn acc p -> {
        let d = list.nth 2 p;
        if not (list.is_empty (decl_params d)) { acc }
        else {
            match static_global es (list.nth 0 p) (decl_body d) {
                () => acc,
                target =>
                    if map.has target base { acc.[(decl_name d) => true] } else { acc },
            }
        }
    }) (fold (fn acc n -> acc.[n => true]) (%{}) fuse.member_names)
      pend;

/// The same, through a `let` that only renames one: `let fold = list.fold_strict;`
/// is a global whose value *is* that function, and a call of it is the same
/// call. This is the parameterless sibling of a wrapper, and it exists because
/// naming the fold you mean once at the top of a file is what people actually
/// write -- the benchmark this pass was built for does exactly that.
///
/// One step only. A rename of a rename is not followed, because the table is
/// read while it is being built and a chain would depend on the order.
let alias_roles es pend base =
    list.fold (fn acc p -> {
        let mi = list.nth 0 p;
        let d = list.nth 2 p;
        if not (list.is_empty (decl_params d)) { acc }
        else {
            match global_index (es.[mi else ()]) (decl_name d) {
                () => acc,
                gi =>
                    match static_global es mi (decl_body d) {
                        () => acc,
                        target =>
                            match base.[target else ()] {
                                () => acc,
                                role => acc.[gi => role],
                            },
                    },
            }
        }
    }) base pend;

/// Which global a callee names, asked without recording anything -- the call
/// is walked normally afterwards whether or not it fuses.
let callee_global c r e = match (Resolution.selections r).[(ref_key (ctx_mi c) (ctx_source c) (ast.span_start (ast.span e))) else ()] {
    Meaning.member(Ref.dream(_), _, gi) => gi,
    Meaning.global(_, _, gi) => gi,
    _ => callee_global_written c r e,
};

let callee_global_written c r e =
    match e {
        [:name, n, _] =>
            if in_scope r n { () }
            else {
                let e0 = ctx_env c r;
                if has_global e0 n { global_index e0 n }
                else {
                    match only_of e0 n {
                        [m, field, _] =>
                            match m { Ref.dream(t) => global_index (env_of c r t) field, _ => () },
                        _ => (),
                    }
                }
            },
        [:field, obj, field, _] =>
            match as_namespace c r obj {
                () => (),
                base =>
                    match list.head base {
                        Ref.dream(t) => global_index (env_of c r t) field,
                        _ => (),
                    },
            },
        _ => (),
    };

let role_at c r e = match callee_global c r e { () => (), g => (roles r).[g else ()] };

/// These are scratch slots, not source binders. A pipe shares its starting
/// offset with its input, and an enclosing index can share it with a call.
/// Keep them in their own table, keyed by the callee's ending offset so each
/// stage has its own entry even when the whole pipeline starts at one place.
let reserve_result : Context -> ast.Expr -> Resolution -> Resolution;
let reserve_result c callee r = {
    let slot = next_slot (list.head (frames r));
    let key = ref_key (ctx_mi c) (ctx_source c) (ast.span_end (ast.span callee));
    let slots = (Resolution.result_slots r).[key => slot];
    if lazy.forced slots { (reserve_slot slot r) |> Resolution.set_result_slots slots }
    else { r }
};

let result_slot : Resolution -> :integer -> :integer -> ast.Span -> :integer | :unit;
let result_slot r ctx source span =
    (Resolution.result_slots r).[(ref_key ctx source (ast.span_end span)) else ()];

let prelude_roles es = fold (fn acc kv -> {
    let e = list.nth 1 kv;
    let kind = match env_name e {
        "std.prelude.Result" => "Result", "std.prelude.Option" => "Option", _ => (),
    };
    if kind == () { acc } else {
        fold (fn m name -> match fuse.result_member kind name {
            [tag, arity] => match global_index e name {
                () => m, gi => m.[gi => [kind, tag, arity]],
            },
            _ => m,
        }) acc (map.keys fuse.result_members)
    }
}) (%{}) (map.pairs es);

let result_role c r callee =
    if not (match callee {
        [:field, _, n, _] => map.has n fuse.result_members,
        [:name, _, _] => true,
        _ => false,
    }) { () }
    else { match callee_global c r callee {
        () => (), g => (Resolution.result_roles r).[g else ()],
    } };

/// A pipeline this pass can fuse: what its source is, what its sink does with
/// each element, and the stages between, in the order the elements meet them.
struct Fusion {
    source_tag
    source_args
    seed
    step
    strict : :bool
    steps = []
    // The sink's tag, which `lower` reads for how the loop stops (`fuse.Plan`).
    sink = :fold
    // The names of the frame around it the stages and the sink read, which the
    // loop takes as parameters (see "names from the frame around it" in `fuse`).
    free = []
}

/// The pipeline written as this call, as a `Fusion`, or `()`.
let fuse_shape c r callee args =
    if not (spelled_like_a_role r callee) { () }
    else {
        match role_at c r callee {
            fuse.Member(kind, fuse.Role.sink(tag, n, strict)) =>
                if list.length args != n { () } else { with_source c r (fuse.runs_over kind) tag strict args },
            // A chain of `std.list` stages that ends in a list: one lazy
            // producer (see "a chain that ends in a list" in `fuse`).
            fuse.Member(:list, fuse.Role.step(tag, 2)) if list.length args == 2 => collected c r tag args,
            _ => (),
        }
    };

/// The chain a `map` or `filter` ends, as a `:collect` pipeline whose last
/// stage is the call itself, or `()` -- for a call with no stage behind it,
/// whose only list is the answer.
let collected c r tag args =
    match peel c r :list (list.nth 1 args) [] 16 {
        () => (),
        [src, steps] => {
            let all = steps + [fuse.Stage.make tag (list.nth 0 args)];
            if list.length all < 2 { () }
            else if not (list.all (fn st -> step_ok r st) all) { () }
            else if not (fuse.affordable all 1) { () }
            else {
                let free = pipeline_free r (fuse.Step.op fuse.collect) all;
                if list.length free > fuse.max_free { () }
                else {
                    Fusion.new (list.nth 0 src) (list.nth 1 src) (fuse.Seed.number 0) (fuse.Step.op fuse.collect) false
                        |> Fusion.set_steps all
                        |> Fusion.set_sink fuse.collect
                        |> Fusion.set_free free
                }
            }
        },
    };

/// The stages a block names and reads once, put where every name inside it can
/// find them.
///
/// The decision is syntax and nothing else -- one use, no rebinding in between
/// -- so it does not depend on whether the pipeline turns out to fuse. That is
/// deliberate: a block is staged before it is walked, and whether the `range`
/// in it is really `std.list`'s is not known until the use site is reached. A
/// staged `let` that never fuses is still the same program, one binding
/// shorter, and lowering writes its body where the name was.
let stage_block c stmts r = {
    let found = fuse.staged_lets (fn body -> stage_shaped r body) stmts;
    if list.is_empty found { r }
    else {
        let seen = fold (fn acc st -> acc.[(fuse.Staged.name st) => st])
                             (staged_now r) found;
        set_staged seen
            (fold (fn acc st ->
                record_staged (ctx_mi c) (ctx_source c) (fuse.Staged.span st) Staging.elided acc)
             r found)
    }
};

/// Is a `let`'s body worth counting uses for? A call whose callee is spelled
/// like a `std.list` member -- the same cheap question `fuse_shape` asks before
/// resolving anything, and asked here for the same reason: every block in the
/// program passes through this, and almost none of them contain a pipeline.
///
/// And nothing impure, which is not an optimization guard but the rule that
/// makes moving one sound at all. A pure `let` is lazy: it is not evaluated
/// where it is written, so writing it somewhere else changes nothing. An
/// impure one is a *statement*, forced in the order the block gives, and
/// moving it moves the effect. `dreams` built a payload that way --
///
///     let copied = list.fold_strict (fn ok p -> ok && copy_payload! handle ..) ..;
///     io.close! handle
///
/// -- and staging `copied` put every write after the close, which the runtime
/// answered with `:io_closed`. Purity is spelling in this language, so the
/// test is the one `step_ok` already makes.
let stage_shaped r body =
    match body {
        [:apply, callee, _, _] =>
            spelled_like_a_role r callee
            && not (list.any (fn n -> builtins.is_impure_name n) (fuse.mentioned body)),
        _ => false,
    };

/// Is this callee even spelled like something that could fuse? Answered before
/// anything is resolved, because most applications in a program are not.
let spelled_like_a_role r e =
    match e {
        [:name, n, _]        => map.has n (role_names r),
        [:field, _, field, _] => map.has field (role_names r),
        _ => false,
    };

/// The producer has to be written where the list goes, and nowhere else.
///
/// `fold f acc (range 1 n)` fuses; `let xs = range 1 n; fold f acc xs` does
/// not, and the difference is not tidiness. A bound list may be used twice,
/// and fusing it would produce it twice -- turning one traversal into two, and
/// a list that costs memory into a computation that costs time. One syntactic
/// use is the only case where the list is provably nobody else's. The same
/// rule applies to every stage in between, which is why the chain is peeled
/// out of the syntax rather than looked up anywhere.
let with_source c r over tag strict args =
    match peel c r over (list.last args) [] 16 {
        () => (),
        peeled => {
            let src = list.nth 0 peeled;
            let steps = list.nth 1 peeled;
            if not (list.all (fn st -> step_ok r st) steps) { () }
            // `length` alone is the machine's own walk, which no loop beats,
            // and `reverse` alone is already the loop it would be; over a
            // `filter` or a `map` either is a loop with no list between.
            else if list.contains tag [:length, :reverse, :concat, :last] && list.is_empty steps { () }
            else {
                match sink_step tag strict (list.nth 0 src) (list.nth 1 src) args (ast.span (list.last args)) {
                    () => (),
                    shape => {
                        let free = pipeline_free r (Fusion.step shape) steps;
                        if list.length free > fuse.max_free { () }
                        else if not (fuse.affordable steps (sink_uses shape)) { () }
                        else { shape |> Fusion.set_steps steps |> Fusion.set_free free }
                    }
                }
            }
        },
    };

/// The chain from the consumer inwards, until something that is not a stage:
/// `[[source tag, its arguments], stages in the order elements meet them]`.
/// `over` is what the chain runs over, `:list` or `:array`: a stage of the
/// other module's is not a stage of this pipeline, and neither is a producer
/// of a list in front of an array.
///
/// What is not a stage is the source. A producer this pass knows is one; any
/// other expression is a container the program already has, and the loop
/// walks it (see "a list or an array as the source" in `fuse`).
///
/// The fuel is not a guess about how long a pipeline gets. It is what makes a
/// compiler terminate on a program that will not run, which is the same reason
/// unwrapping a chain of wrappers is capped.
let rec peel c r over e !acc fuel =
    if fuel <= 0 { () }
    else {
        match e {
            [:apply, callee, cargs, _] =>
                match role_at c r callee {
                    fuse.Member(:list, fuse.Role.source(stag, n)) if over == :list =>
                        if list.length cargs != n { () } else { [[stag, cargs], acc] },
                    fuse.Member(kind, fuse.Role.step(stag, n)) if kind == over =>
                        if list.length cargs != n { () }
                        else {
                            peel c r over (list.nth 1 cargs)
                                 (list.cons (fuse.Stage.make stag (fuse.as_lambda 1 (list.nth 0 cargs))) acc) (fuel - 1)
                        },
                    _ => [[over, [e]], acc],
                },
            // A stage the block gave a name to and reads exactly once. The
            // binding is not a barrier between the producer and the consumer;
            // it is the same pipeline written over two lines, and `fuse`'s
            // `staged_lets` is what established that moving it changes nothing.
            [:name, n, _] =>
                match staged_use r n {
                    () => [[over, [e]], acc],
                    st => peel c r over (fuse.Staged.body st) acc (fuel - 1),
                },
            _ => [[over, [e]], acc],
        }
    };

/// A stage is only spliced into the loop when its function was written where
/// it is used: one plain parameter, no effect, and nothing from the frame
/// around it. The same three conditions a fold's function is held to, and for
/// the same three reasons.
let step_ok r st =
    match fuse.Stage.lambda st {
        [:lambda, ps, body, _] =>
            list.length ps == 1
            && ast.param_pattern (list.nth 0 ps) == ()
            // The loop inlines the body and has nowhere to put the force.
            && not (ast.param_strict (list.nth 0 ps))
            && not (list.any (fn n -> builtins.is_impure_name n) (fuse.mentioned body)),
        _ => false,
    };

/// How many times the consumer reads each element -- which is how many times
/// the stage in front of it has to be written out.
let sink_uses shape =
    match Fusion.step shape {
        // A pattern reads the element once, to take it apart.
        fuse.Step.written(_, ps) if ast.param_pattern (list.last ps) != () => 1,
        fuse.Step.written(body, ps) => fuse.uses (ast.param_name (list.last ps)) body,
        // A pair is read for its key and again for its value.
        fuse.Step.op(:pairs) => 2,
        fuse.Step.op(_) => 1,
    };

/// What the accumulator does with each element: a lambda written at the call
/// site, or -- for `sum` and `product`, whose function nobody wrote down --
/// the operator they stand for.
let sink_step tag strict stag src_args args span =
    match tag {
        // `from_pairs` starts from the empty map, written as the literal.
        :pairs => Fusion.new stag src_args (fuse.Seed.written [:map, [], span]) (fuse.Step.op :pairs) strict,
        :length => Fusion.new stag src_args (fuse.Seed.number 0) (fuse.Step.op :length) strict,
        :concat => Fusion.new stag src_args (fuse.Seed.number 0) (fuse.Step.op :concat) false
                       |> Fusion.set_sink :concat,
        :last => Fusion.new stag src_args (fuse.Seed.written [:unit, span]) (fuse.Step.op :last) strict,
        :reverse => Fusion.new stag src_args (fuse.Seed.written [:list, [], span]) (fuse.Step.op :reverse) strict,
        // A predicate of one element, held to what a fold's function is held
        // to and for the same reasons; the loop starts from nothing it reads,
        // or from a count of zero.
        t if fuse.takes_predicate t =>
            match fuse.as_lambda 1 (list.nth 0 args) {
                [:lambda, ps, body, _] =>
                    if list.length ps != 1 { () }
                    else if list.any (fn p -> ast.param_strict p) ps { () }
                    else if list.any (fn n -> builtins.is_impure_name n) (fuse.mentioned body) { () }
                    else {
                        Fusion.new stag src_args (fuse.Seed.number 0) (fuse.Step.written body ps) strict
                            |> Fusion.set_sink t
                    },
                _ => (),
            },
        :fold =>
            match fuse.as_lambda 2 (list.nth 0 args) {
                [:lambda, ps, body, _] =>
                    if list.length ps != 2 { () }
                    // Either parameter may be written as a pattern --
                    // `fn acc [k, v]` is how a fold over pairs is written,
                    // `fn [l, out] x` how one threads two things -- and the
                    // loop takes each apart in front of the body, checked as
                    // the lambda would check it.
                    // Nor does it have anywhere to put a strict parameter's
                    // force: the lambda's body is written into the loop, and
                    // the force is the body's first statement.
                    else if list.any (fn p -> ast.param_strict p) ps { () }
                    // An effect inside the loop would be an effect the machine
                    // no longer sequences -- see "what a body mentions" in
                    // `fuse`.
                    else if list.any (fn n -> builtins.is_impure_name n) (fuse.mentioned body) { () }
                    else {
                        Fusion.new stag src_args (fuse.Seed.written (list.nth 1 args))
                                   (fuse.Step.written body ps) strict
                    },
                _ => (),
            },
        op => Fusion.new stag src_args (fuse.Seed.number (if op == :mul { 1 } else { 0 }))
                         (fuse.Step.op op) strict,
    };

/// The names of the frame around it a step reads: what the loop has to be
/// handed, since a loop is a global and a global has no captures. Over-counts
/// a name the body binds again itself, which hands the loop a parameter it
/// does not read.
let frame_names : Resolution -> fuse.Step -> [:string];
let frame_names r step =
    match step {
        fuse.Step.written(body, ps) => {
            let ours = list.concat (list.map (fn p -> list.cons (ast.param_name p) (match ast.param_pattern p {
                () => [],
                pattern => list.map list.head (pattern_bindings pattern),
            })) ps);
            list.unique (filter (fn n -> not (list.contains n ours) && in_scope r n) (fuse.mentioned body))
        },
        fuse.Step.op(_) => [],
    };

/// Every name of the frame around it a pipeline reads, its sink's and its
/// stages', each once, in the order first met.
let pipeline_free : Resolution -> fuse.Step -> [fuse.Stage] -> [:string];
let pipeline_free r sink steps =
    list.unique (frame_names r sink
                 + list.concat (map (fn st -> frame_names r (fuse.Step.written (fuse.step_body st) (fuse.step_params st))) steps));

/// Take the next global for a loop nobody wrote: `[r, index]`.
///
/// They come after every module's, because a fused loop belongs to no module
/// -- it was not written in one. Nothing reads a module's global range to find
/// out what exists; the range says which module a global came from, and the
/// honest answer here is none.
let take_fused_global name fi r = {
    let gi = Resolution.next_global r;
    [(r |> Resolution.set_next_global (gi + 1) |> Resolution.set_fused (list.cons [gi, name, :function, fi] (fused_rev r))),
     gi]
};

let record_fusion ctx source span p r =
    (r |> Resolution.set_fusions ((fusions r).[(ref_key ctx source (ast.span_start span)) => p]));

/// Walk a pipeline that is going to be fused, and record the plan.
///
/// Where each piece is walked is the whole of the rewrite's honesty. The
/// producer's arguments and the seed are resolved in the frame the pipeline
/// was written in, because that is where they are still evaluated: they become
/// the loop's first arguments, built exactly once, in the order they were
/// written. The fold's function is resolved inside the loop's *own* frame,
/// with its two parameters bound to the slots the loop keeps the accumulator
/// and the element in -- so its body reads them as locals and there is no
/// closure anywhere. Nothing else moves.
///
/// Both callees are walked as well, though no call to either is emitted. An
/// editor asking what is under the cursor is asking about the text, and the
/// text still says `list.fold_strict`.
let check_fused c e shape r = {
    let span = ast.span e;
    let args = list.nth 2 e;
    let stag = Fusion.source_tag shape;
    let seed = Fusion.seed shape;

    // The chain behind the call: every stage but a collecting call's own,
    // which is the call.
    let behind = if Fusion.sink shape == fuse.collect { list.take (list.length (Fusion.steps shape) - 1) (Fusion.steps shape) }
                 else { Fusion.steps shape };
    let r1 = check_chain c (list.last args) (check_expr c (list.nth 1 e) r) behind;
    let r2 = match seed { fuse.Seed.written(x) => check_expr c x r1, fuse.Seed.number(_) => r1 };

    // Each name from the frame around it, read here, in the caller's frame, at
    // an offset of its own (`fuse.free_span`).
    let free = Fusion.free shape;
    let numbered_free = list.zip (list.range 0 (list.length free)) free;
    let r3 = fold (fn acc [i, n] -> check_expr c [:name, n, fuse.free_span (ast.span_start span) i] acc) r2 numbered_free;
    let arity = fuse.arity + list.length free;

    let started = begin_func (fuse.loop_name stag) arity false (impure_ok r3)
                             true false span (ctx_source c) r3;
    let fi = list.nth 1 started;
    // The parameters exist whether or not anything names them, so the frame
    // is as wide as the loop's arity before a stage takes a slot. The names
    // from the frame around it are bound to theirs, after the three every
    // loop has.
    let reserved = fold (fn acc [i, n] ->
        bind_at (ctx_mi c) (ctx_source c) n (fuse.arity + i) (fuse.free_binder_span (ast.span_start span) i) acc)
        (reserve_slot (arity - 1) (list.head started)) numbered_free;

    // A list's or an array's element has no slot of its own to begin from:
    // it is a slot nothing writes, read as the container at the cursor.
    let first =
        if fuse.walks_container stag {
            let fresh = bind_one (ctx_mi c) (ctx_source c) "_" span reserved;
            [list.head fresh, list.nth 1 fresh, [[list.nth 1 fresh, fuse.elements stag]]]
        }
        else { [reserved, fuse.element_slot stag, []] };
    let staged = walk_steps c (Fusion.steps shape) (list.nth 1 first) [] (list.nth 2 first) (list.head first);
    let elem = list.nth 1 staged;
    let inner =
        match Fusion.step shape {
            // A predicate has the element and no accumulator; a fold's
            // function has both.
            fuse.Step.written(body, [elem_p]) => {
                let scoped = push_scope (list.nth 0 staged);
                let bound = bind_pattern_param c elem_p
                                (bind_at (ctx_mi c) (ctx_source c) (ast.param_name elem_p) elem
                                         (list.nth 1 elem_p) scoped);
                pop_scope (check_expr c body bound)
            },
            fuse.Step.written(body, ps) => {
                let acc_p = list.nth 0 ps;
                let elem_p = list.nth 1 ps;
                let scoped = push_scope (list.nth 0 staged);
                let bound = bind_pattern_param c elem_p
                    (bind_at (ctx_mi c) (ctx_source c) (ast.param_name elem_p) elem
                            (list.nth 1 elem_p)
                        (bind_pattern_param c acc_p
                            (bind_at (ctx_mi c) (ctx_source c) (ast.param_name acc_p)
                                     fuse.acc_slot (list.nth 1 acc_p) scoped)));
                pop_scope (check_expr c body bound)
            },
            fuse.Step.op(_) => list.nth 0 staged,
        };
    let walked = end_func fi inner;
    if captures_substituted walked fi (list.nth 3 staged) { () }
    else {
    let taken = take_fused_global (fuse.loop_name stag) fi walked;
    record_fusion (ctx_mi c) (ctx_source c) span
        (fuse.Plan.make span fi (list.nth 1 taken) [stag, Fusion.source_args shape] seed
                        (Fusion.step shape) (Fusion.strict shape) (list.nth 2 staged) (list.nth 3 staged) elem
                        (Fusion.sink shape)
                        (map (fn [i, n] -> [n, fuse.free_span (ast.span_start span) i]) numbered_free))
        (list.head taken)
    }
};

/// Does a function made inside the loop capture a slot the loop never writes?
///
/// A substituted slot -- a `map`'s output, a list's or an array's element --
/// is read by writing its expression where it is read, and that works for a
/// read in the loop's own body. A closure or a suspension made there copies
/// its captures out of the frame when it is made, and the frame's copy of a
/// substituted slot was never written: the closure would see whatever was
/// there. Such a loop is not fused. Every function begun while the loop was
/// walked is asked, nested ones too, which can only refuse a loop that a
/// closer look would have allowed.
let captures_substituted : Resolution -> :integer -> [[:any]] -> :bool;
let captures_substituted r fi subst =
    if list.is_empty subst { false }
    else {
        let slots = fold (fn m [slot, _] -> m.[slot => true]) %{} subst;
        list.any (fn i -> list.any (fn cap -> match cap {
            Capture.local(slot) => map.has slot slots,
            _ => false,
        }) (func_captures (func_at r i))) (list.range (fi + 1) (func_count r))
    };

/// Each stage in turn, in the order the elements meet them.
///
/// A stage's parameter is bound to the slot its input is read from, and then
/// put back out of sight: two stages of one pipeline are siblings, not nested
/// scopes, and leaving the first one's parameter in scope would let a later
/// body resolve a *global* of the same name to it. The slot stays taken --
/// leaving a scope does not give slots back -- which is exactly what a slot
/// that is read but never written needs.
///
/// A `filter` hands its input straight on and contributes a condition. A `map`
/// hands on a slot of its own, which nothing ever writes: see "a stage that
/// has no slot" in `fuse`.
let rec walk_steps c steps slot guards subst r =
    match steps {
        [] => [r, slot, guards, subst],
        [st, ..rest] => {
            let body = fuse.step_body st;
            let p = list.nth 0 (fuse.step_params st);
            let scoped = push_scope r;
            let bound = bind_at (ctx_mi c) (ctx_source c) (ast.param_name p) slot
                                (list.nth 1 p) scoped;
            let walked = pop_scope (check_expr c body bound);
            if fuse.Stage.tag st == :filter {
                walk_steps c rest slot (list.append guards [body]) subst walked
            }
            else {
                let fresh = bind_one (ctx_mi c) (ctx_source c) "_"
                                     (ast.span (fuse.Stage.lambda st)) walked;
                walk_steps c rest (list.nth 1 fresh) guards
                           (list.append subst [[list.nth 1 fresh, body]]) (list.head fresh)
            }
        },
    };

/// Resolve the callees along the chain, though no call to any of them is
/// emitted. An editor asking what is under the cursor is asking about the
/// text, and the text still says `list.map`. `steps` is how many stages
/// `peel` found, and what is past them is the source, walked as it was
/// written: a producer's arguments, or the whole of a container's expression,
/// are evaluated at the fused call, so they are resolved in this frame like
/// any other.
let rec check_chain c e r steps =
    match e {
        [:apply, callee, cargs, _] if not (list.is_empty steps) =>
            check_chain c (list.nth 1 cargs) (check_expr c callee r) (list.tail steps),
        // Through a staged name as well, and for the reason the chain is
        // walked at all. Walking the body here rather than where the `let`
        // stood is what the staging rule bought -- nothing it names is bound
        // again in between, so the two positions resolve alike.
        [:name, n, _] =>
            match staged_use r n { () => check_expr c e r, st => check_chain c (fuse.Staged.body st) r steps },
        _ => check_expr c e r,
    };

/// Just the diagnostics, for a caller that only wants to know whether the
/// program is well formed.
let check! : modules.Loader -> [:map];
let check! l = r_diags (resolve! l);

// --- asking the resolver questions ---------------------------------------------
//
// What a language server needs is not a pass but a query: the user's cursor is
// at a byte offset in a file, and the question is what the name there means and
// where it came from. That is a lookup in `refs`, which is why the walk records
// it rather than only complaining.

/// What the name beginning at this byte offset resolves to, or `()`. The module
/// is part of the question for the same reason it is part of the key.
let at r ctx source offset = (refs r).[(ref_key ctx source offset) else ()];

/// Where a global is defined: `[module, source, span]`, or `()`. The module a
/// name belongs to is part of the question, because two modules may each define
/// the same name.
let definition r mi name = {
    let hit = filter (fn d -> list.nth 0 d == mi && list.nth 2 d == name) (defs r);
    if list.is_empty hit { () }
    else { let d = list.head hit; [list.nth 0 d, list.nth 1 d, list.nth 3 d] }
};

/// Every global a module defines, in declaration order -- a document outline.
let module_defs : Resolution -> :integer -> [[:any]];
let module_defs r mi = filter (fn d -> list.nth 0 d == mi) (defs r);
// --- tests -------------------------------------------------------------------

when test {
    import std.test;
    import dreams.config;
    import dreams.package;

    /// A program built from source text rather than from files. Native imports
    /// still resolve -- the host's modules need no file -- which is enough to
    /// exercise purity, and a second module can be added under a name the first
    /// one imports, which is enough to exercise members.
    let bare! () = modules.loader package.empty config.empty [] [];

    let with_module! l name src = modules.load_text! l src ("<" + name + ">") name ("<" + name + ">");

    let checked! src = check! (with_module! (bare! ()) "t" src);

    /// The whole resolver, for the tests that ask what it recorded rather than
    /// what it complained about.
    let resolved! src = resolve! (with_module! (bare! ()) "t" src);

    /// The slot a binder was given, found by name in the recorded binds.
    let binding_slot r name = {
        let hits = list.filter (fn b -> list.head (list.nth 1 b) == name)
                               (map.pairs (binds r));
        if list.is_empty hits { () } else { list.nth 1 (list.nth 1 (list.head hits)) }
    };

    /// Two modules: `a` as written, then `t`, which may import it.
    let checked_two! a_src t_src =
        check! (with_module! (with_module! (bare! ()) "a" a_src) "t" t_src);

    let messages : [:map] -> [:string];
    let messages ds = list.map (fn d -> diag.message d) ds;
    let first ds = if list.is_empty ds { "" } else { diag.message (list.head ds) };
    let note_of ds = if list.is_empty ds { "" } else { to_string (diag.note (list.head ds)) };

    /// A `let` declaration with nothing in it but its name, for the gather
    /// tests below: what they are about is which slot a name lands in.
    let named n = ast.let_d n [] (ast.unit_e ast.no_span) false ast.no_span;

    /// The names a gather ends up holding, in the order it hands them back,
    /// each with the module that owns it: `[[owner, name], ..]`.
    let gather_of : [[:integer, :string]] -> [[:integer, :string]];
    let gather_of owned =
        list.map (fn e -> [list.head e, decl_name (list.nth 1 e)])
            (gathered (list.fold (fn g [owner, n] ->
                 list.head (collect_let () owner (named n) g state)) gather_new owned));

    let tests = [
        test.case "gathered lets come back in the order they were collected"
            $( test.eq! [[0, "a"], [0, "b"], [0, "c"]]
                        (gather_of [[0, "a"], [0, "b"], [0, "c"]]) ),
        // The point of the map behind the gather: it must not turn a
        // replacement into an append. A module that derives another overrides
        // a name *where the base declared it*, so everything after it keeps
        // the position it had -- which is what an image's global numbering and
        // every diagnostic that cites declaration order rest on.
        test.case "a name redeclared by another module keeps its original slot"
            $( test.eq! [[1, "a"], [0, "b"], [0, "c"]]
                        (gather_of [[0, "a"], [0, "b"], [0, "c"], [1, "a"]]) ),
        test.case "a third owner replaces the second in the same slot"
            $( test.eq! [[2, "a"], [0, "b"]]
                        (gather_of [[0, "a"], [0, "b"], [1, "a"], [2, "a"]]) ),
        // A hidden global -- the one a destructuring compiles to -- repeats
        // wherever the names beside it repeat, so the same module declaring it
        // twice is silently the first one rather than a diagnostic. A name the
        // author wrote is the other case and is a complaint, which needs a
        // loader to name the file and so is tested through `checked!` above.
        test.case "a hidden name the same module declares twice is collected once"
            $( test.eq! [[0, "<let x>"], [0, "b"]]
                        (gather_of [[0, "<let x>"], [0, "b"], [0, "<let x>"]]) ),
        test.case "private bindings are usable inside their module"
            $( test.eq! [] (messages (checked! "priv let x = 1; let main! = x;")) ),
        test.case "private recursive functions resolve"
            $( test.eq! [] (messages (checked! "priv let rec f n = if n == 0 { 0 } else { f (n - 1) }; let main! = f 2;")) ),
        test.case "qualified private access is rejected"
            $( test.eq! "member `a.x` is private"
                (first (checked_two! "priv let x = 1;" "import a; let main! = a.x;")) ),
        test.case "an unused private selective import is rejected"
            $( test.eq! "member `a.x` is private"
                (first (checked_two! "priv let x = 1;" "import a.{x as y}; let main! = 0;")) ),
        test.case "private destructuring keeps every binding private"
            $( test.eq! "member `a.y` is private"
                (first (checked_two! "priv let [x, y] = [1, 2];" "import a; let main! = a.y;")) ),
        test.case "private names are absent from export diagnostics"
            $( test.true! (str.contains_str "it exports: visible"
                (note_of (checked_two! "priv let hidden = 1; let visible = hidden;"
                                      "import a; let main! = a.nope;"))) ),
        test.case "public functions can use private helpers"
            $( test.eq! [] (messages (checked_two! "priv let x = 1; let value = x;"
                                                   "import a; let main! = a.value;")) ),
        test.case "nested modules enforce private visibility"
            $( test.eq! "member `a.x` is private"
                (first (checked! "mod a { priv let x = 1; } let main! = a.x;")) ),
        // A `mod` sees the module it is written in (`inherit_enclosing`).
        test.case "a nested module sees its parent's names, private ones too"
            $( test.eq! [] (checked! "priv let x = 1; mod h { let z = 2; } mod a { let y = x + h.z; } let main! = a.y;") ),
        test.case "a nested module's own name wins over its parent's"
            $( test.eq! [] (checked! "let x = \"s\"; mod a { let x = 1; let y = x + 1; } let main! = a.y;") ),
        test.case "two levels in, the grandparent's names are seen"
            $( test.eq! [] (checked! "let x = 1; mod a { mod b { let y = x; } } let main! = a.b.y;") ),
        test.case "a record's field may be typed with the record beside it"
            $( test.eq! [] (checked! "struct P { x } struct R { p : P } let main! = R.make (P.make 1);") ),
        test.case "a record's member may call the function beside it"
            $( test.eq! [] (checked! "let twice n = n * 2; struct P { x, doubled self = twice (x self) } let main! = P.doubled (P.make 1);") ),
        test.case "conditional private bindings remain private"
            $( test.eq! "member `a.x` is private"
                (first (checked_two! "when true { priv let x = 1; }"
                                     "import a; let main! = a.x;")) ),
        // --- resolution ---
        test.case "a name nothing binds is reported"
            $( test.eq! "cannot find `nope` in this scope" (first (checked! "let main! = nope;")) ),
        test.case "a global of this module is in scope"
            $( test.eq! [] (checked! "let a = 1;\nlet main! = a;") ),
        test.case "a builtin is in scope without being imported"
            $( test.eq! [] (checked! "let main! = to_string (len [1]);") ),
        test.case "a parameter is in scope in the body"
            $( test.eq! [] (checked! "let f x = x;") ),
        test.case "a parameter is not in scope outside it"
            $( test.eq! "cannot find `x` in this scope"
                        (first (checked! "let f x = x;\nlet g = x;")) ),
        test.case "a lambda's parameter is in scope in its body"
            $( test.eq! [] (checked! "let f = fn x -> x;") ),
        test.case "a name from an enclosing function is reachable"
            $( test.eq! [] (checked! "let f x = fn y -> x;") ),
        test.case "`_` binds nothing, so it cannot be used"
            $( test.eq! "cannot find `_` in this scope"
                        (first (checked! "let f = match 1 { _ => _, };")) ),

        // --- blocks ---
        test.case "a let is in scope for the statements after it"
            $( test.eq! [] (checked! "let f = { let a = 1; a };") ),
        test.case "a plain let is not in scope in its own body"
            $( test.eq! "cannot find `a` in this scope"
                        (first (checked! "let f = { let a = a; a };")) ),
        test.case "a let rec is in scope in its own body"
            $( test.eq! [] (checked! "let f = { let rec go n = go n; go 1 };") ),
        test.case "a block's let goes out of scope at the end of the block"
            $( test.eq! "cannot find `a` in this scope"
                        (first (checked! "let f = { { let a = 1; a } a };")) ),

        // --- patterns ---
        test.case "cons binders are visible in guards and bodies"
            $( test.eq! [] (checked! "let f xs = match xs { h :: t if h > 0 => t, _ => [] };") ),
        test.case "cons binders cannot repeat"
            $( test.true! (not (list.is_empty (checked! "let f xs = match xs { x :: x => x };"))) ),
        test.case "a list pattern's binders cannot repeat either"
            $( test.eq! "`x` is bound more than once in this pattern"
                        (first (checked! "let f v = match v { [x, x] => x, _ => 0 };")) ),
        test.case "a pattern binds for the arm's body"
            $( test.eq! [] (checked! "let f v = match v { [x, y] => x + y, };") ),
        test.case "a `..rest` binds a name"
            $( test.eq! [] (checked! "let f v = match v { [x, ..rest] => rest, };") ),
        test.case "an unnamed `..` binds nothing"
            $( test.eq! [] (checked! "let f v = match v { [x, ..] => x, };") ),
        test.case "an `as` pattern binds the whole"
            $( test.eq! [] (checked! "let f v = match v { ([x] as whole) => whole, };") ),
        test.case "a guard sees what the pattern bound"
            $( test.eq! [] (checked! "let f v = match v { [x] if x > 1 => x, };") ),
        test.case "a pattern's names are gone in the next arm"
            $( test.eq! "cannot find `x` in this scope"
                        (first (checked! "let f v = match v { [x] => x, _ => x, };")) ),
        // A bare name in a pattern *binds*; it never compares. The expression
        // inside a pattern is the key of a map pattern, and it is resolved in
        // the scope the `match` sits in rather than the one the pattern makes.
        test.case "a bare name in a pattern binds rather than comparing"
            $( test.eq! [] (checked! "let f v = match v { anything => anything, };") ),
        test.case "a map pattern's key is an expression, resolved outside the arm"
            $( test.eq! "cannot find `nope` in this scope"
                        (first (checked! "let f v = match v { %{ nope => x } => x, };")) ),
        test.case "a map pattern's key cannot see what the pattern binds"
            $( test.eq! "cannot find `x` in this scope"
                        (first (checked! "let f v = match v { %{ x => x } => x, };")) ),
        // A named rest and an `as` alias were both recorded where their list
        // starts -- one position for two names, and so one slot.
        test.case "a named rest and an as alias get slots of their own"
            $( test.true! { let r = resolved! "let f v = match v { [x, ..rest] as whole => whole, _ => 0 };";
                            let a = binding_slot r "rest";
                            let b = binding_slot r "whole";
                            a != () && b != () && a != b } ),

        // --- destructuring ---
        test.case "a destructuring let binds its names for the statements after it"
            $( test.eq! [] (checked! "let f p = { let [a, %{ :k => b }] = p; a + b };") ),
        test.case "a destructuring let's names are not in scope in its own value"
            $( test.eq! "cannot find `a` in this scope"
                        (first (checked! "let f = { let [a] = [a]; a };")) ),
        test.case "a top-level destructuring binds globals"
            $( test.eq! [] (checked! "let [a, ..rest] = [1, 2];\nlet f = a + len rest;") ),
        test.case "a top-level destructuring's names clash as any let's do"
            $( test.eq! ["`a` is already bound in this module"]
                        (messages (checked! "let [a, b] = [1, 2];\nlet a = 3;")) ),
        test.case "a pattern parameter binds for the body"
            $( test.eq! [] (checked! "let f [a, b] %{ :k => c } = a + b + c;") ),
        test.case "a lambda's pattern parameter binds for its body"
            $( test.eq! [] (checked! "let f = fn [x, ..rest] -> rest;") ),
        test.case "a key in a pattern parameter sees the parameters before it"
            $( test.eq! [] (checked! "let f k %{ k => v } = v;") ),
        test.case "a key cannot see what its destructuring binds"
            $( test.eq! "cannot find `x` in this scope"
                        (first (checked! "let f p = { let %{ x => x } = p; x };")) ),
        test.case "a literal in a destructuring let is refused"
            $( test.eq! "`:ok` could fail to match, and a `let` has no other arm to try"
                        (first (checked! "let f p = { let [:ok, v] = p; v };")) ),
        test.case "a literal in a pattern parameter is refused"
            $( test.eq! "`0` could fail to match, and a parameter has no other arm to try"
                        (first (checked! "let f [0, x] = x;")) ),
        test.case "a literal in a top-level destructuring is refused"
            $( test.eq! "`\"x\"` could fail to match, and a `let` has no other arm to try"
                        (first (checked! "let [\"x\", y] = [\"x\", 1];")) ),
        test.case "a destructuring has to take something apart"
            $( test.true! (str.contains_str "a list, an array or a map"
                                            (first (checked! "let f p = { let (x as y) = p; x };"))) ),
        test.case "a destructuring that binds nothing is refused"
            $( test.eq! "this pattern binds no names, so nothing would ever check it"
                        (first (checked! "let f p = { let [_, _] = p; 1 };")) ),
        test.case "the global behind a destructuring is not an export"
            $( test.true! (str.contains_str "it exports: x, y"
                   (note_of (checked_two! "let [x, y] = [1, 2];" "import a;\nlet f = a.nope;"))) ),
        test.case "the global behind a destructuring is not in an outline"
            $( test.eq! ["a", "b", "f"]
                        (list.map (fn d -> list.nth 2 d)
                                  (module_defs (resolved! "let [a, b] = [1, 2];\nlet f = a;") 0)) ),

        // --- try ---
        test.case "a catch binder is in scope in the handler"
            $( test.eq! [] (checked! "let f! = try! { 1 } catch e { e };") ),
        test.case "a catch binder is not in scope after the try"
            $( test.eq! "cannot find `e` in this scope"
                        (first (checked! "let f! = { try! { 1 } catch e { e } e };")) ),

        // --- purity ---
        test.case "a pure function may not reach an effect"
            $( test.eq! "cannot use the impure function `go!` inside the pure function `f`"
                        (first (checked! "let go! = 1;\nlet f = go!;")) ),
        test.case "an impure function may"
            $( test.eq! [] (checked! "let go! = 1;\nlet f! = go!;") ),
        test.case "the note says how to fix it"
            $( test.true! (str.contains_str "ending its name with `!`"
                                            (note_of (checked! "let go! = 1;\nlet f = go!;"))) ),
        test.case "a host module's impure member is an effect too"
            $( test.eq! "cannot use the impure member `stdout!` inside the pure function `f`"
                        (first (checked! "import std.io;\nlet f x = io.stdout! x;")) ),
        test.case "a lambda inside a pure function is still pure"
            $( test.true! (str.contains_str "inside the pure function `<lambda>`"
                   (first (checked! "let go! = 1;\nlet f = fn x -> go!;"))) ),
        test.case "a lambda inside an impure function may perform effects"
            $( test.eq! [] (checked! "let go! = 1;\nlet f! = fn x -> go!;") ),
        test.case "a thunk may be impure wherever it is written"
            $( test.eq! [] (checked! "let go! = 1;\nlet f = $( go! );") ),
        test.case "a local impure function may be declared inside a pure one"
            $( test.eq! [] (checked! "let go! = 1;\nlet f = { let h! x = go!; 1 };") ),

        // --- modules as values ---
        test.case "a host module named alone is a value"
            $( test.eq! [] (checked! "import std.io;\nlet f = io;") ),
        test.case "a Dream module named alone is not"
            $( test.eq! "`a` is a module, not a value"
                        (first (checked_two! "let x = 1;" "import a;\nlet f = a;")) ),
        test.case "a member of a Dream module resolves"
            $( test.eq! [] (checked_two! "let x = 1;" "import a;\nlet f = a.x;") ),
        test.case "a member a Dream module does not have is reported"
            $( test.eq! "module `a` has no member `nope`"
                        (first (checked_two! "let x = 1;" "import a;\nlet f = a.nope;")) ),
        test.case "the note names what the module does export"
            $( test.true! (str.contains_str "it exports: x"
                   (note_of (checked_two! "let x = 1;" "import a;\nlet f = a.nope;"))) ),
        test.case "a module that exports nothing says so"
            $( test.true! (str.contains_str "it exports nothing"
                   (note_of (checked_two! "" "import a;\nlet f = a.nope;"))) ),

        // --- imports ---
        test.case "an imported member resolves as the qualified name would"
            $( test.eq! [] (checked_two! "let x = 1;" "import a.{x};\nlet f = x;") ),
        test.case "an imported member may be renamed"
            $( test.eq! [] (checked_two! "let x = 1;" "import a.{x as y};\nlet f = y;") ),
        test.case "importing a member the module has not got is reported"
            $( test.eq! "module `a` has no member `nope`"
                        (first (checked_two! "let x = 1;" "import a.{nope};\nlet f = nope;")) ),
        test.case "an import that collides with a let is reported"
            $( test.true! (str.contains_str "already bound"
                   (first (checked_two! "let x = 1;" "import a.{x};\nlet x = 2;"))) ),
        test.case "importing the same alias twice is reported"
            $( test.eq! "`io` is already imported here"
                        (first (checked! "import std.io;\nimport std.io;")) ),
        test.case "an impure member keeps its purity through an import list"
            $( test.eq! "cannot use the impure function `a.go!` inside the pure function `f`"
                        (first (checked_two! "let go! = 1;" "import a.{go!};\nlet f = go!;")) ),

        // --- duplicates ---
        test.case "two lets of one name in a module is an error"
            $( test.eq! "`a` is already bound in this module"
                        (first (checked! "let a = 1;\nlet a = 2;")) ),

        // --- builtins and ordinary module bindings ---
        test.case "runtime primitives need no import"
            $( test.eq! 0 (diag.error_count (checked! "let f xs = _list_tail xs;")) ),
        test.case "a primitive named outside std is warned about, with the call to write"
            $( test.eq! [:warning, "`_list_tail` is a primitive, meant to be called through `std`",
                         "write `list.tail xs` instead"]
                        (list.map (fn d -> [diag.severity d, diag.message d, diag.note d])
                                  (checked! "let f xs = _list_tail xs;")).[0] ),
        test.case "and std names its own primitives without one"
            $( test.eq! [] (check! (with_module! (bare! ()) "std.t" "let f xs = _list_tail xs;")) ),
        test.case "a record may carry a base's `dyn` virtuals"
            $( test.eq! []
                   (messages (checked! ("mod shape { virtual dyn let area s; let twice s = 2 * area s }\n"
                                        + "struct Sq derive dyn shape { side\n area s = side s * side s }"))) ),
        test.case "`derive dyn` of a base with nothing to dispatch is an error"
            $( test.eq! "`derive dyn` names a module with no `dyn` virtual, so there is nothing to dispatch"
                   (first (checked! "mod shape { virtual let area s; }\nstruct Sq derive dyn shape { area s = 1 }")) ),
        test.case "an accumulator nothing forces is warned about, with the `!` that fixes it"
            $( test.eq! [:warning, "make it strict with `!acc`, so each call forces it as it starts"]
                        (list.map (fn d -> [diag.severity d, diag.note d])
                                  (checked! "let rec t i acc = if i == 0 { acc } else { t (i - 1) (acc + i) };")).[0] ),
        test.case "and so is one in a block's own `let rec`"
            $( test.eq! 1 (list.length (checked!
                   "let f n = { let rec t i acc = if i == 0 { acc } else { t (i - 1) (acc + i) }; t n 0 };")) ),
        test.case "a strict one is not"
            $( test.eq! [] (checked! "let rec t i !acc = if i == 0 { acc } else { t (i - 1) (acc + i) };") ),
        test.case "the language's own builtins are never warned about"
            $( test.eq! [] (checked! "let f x = to_string (len x);") ),
        test.case "a module that binds core itself keeps its own"
            $( test.eq! [] (checked! "let core = 1;\nlet f = core;") ),
        test.case "a module that never names core is given nothing"
            $( test.eq! [] (checked! "let f x = x;") ),

        // --- what the walk records ---
        //
        // Diagnostics are only half the output. The other half is what every
        // name turned out to mean, which is what lowering reads instead of
        // working it out again -- and what a language server will read to
        // answer "what is this, and where does it come from".
        test.case "a parameter resolves to a slot in its own frame"
            $( test.eq! 0
                        { let src = "let f x = x;";
                          match at (resolved! src) 0 0 (str.find "x;" src) {
                              Meaning.local(slot, _) => slot,
                              other => other,
                          } } ),
        test.case "a local records where it was bound"
            $( test.eq! true
                        { let src = "let f x = x;";
                          match at (resolved! src) 0 0 (str.find "x;" src) {
                              Meaning.local(_, bound) => ast.span_start bound == str.find "x =" src,
                              _ => false,
                          } } ),
        test.case "a second local gets the next slot"
            $( test.eq! [0, 1]
                        { let src = "let f a b = a + b;";
                          let r = resolved! src;
                          list.map (fn o -> match at r 0 0 o { Meaning.local(slot, _) => slot, other => other })
                                   [str.find "a +" src, str.find "b;" src] } ),
        test.case "a global resolves to its module and its index"
            $( test.eq! (Meaning.global 0 "a" 0)
                        { let src = "let a = 1;\nlet f = a;";
                          at (resolved! src) 0 0 (str.find "a;" src) } ),
        test.case "a builtin resolves as a builtin"
            $( test.eq! (Meaning.builtin "len")
                        { let src = "let f xs = len xs;";
                          at (resolved! src) 0 0 (str.find "len" src) } ),
        test.case "a host module's member is recorded with the module it came from"
            $( test.eq! (Meaning.member (Ref.native "std.io" 0) "stdout!" ())
                        { let src = "import std.io;\nlet f! x = io.stdout! x;";
                          at (resolved! src) 0 0 (str.find "io.stdout!" src) } ),

        // --- captures ---
        test.case "a name from the enclosing function becomes a capture"
            $( test.eq! 0
                        { let src = "let f x = fn y -> x;";
                          match at (resolved! src) 0 0 (str.find "x;" src) {
                              Meaning.capture(index, _) => index,
                              other => other,
                          } } ),
        test.case "the lambda records what it captures and where from"
            $( test.eq! [Capture.local 0]
                        (func_captures (list.nth 1 (funcs (resolved! "let f x = fn y -> x;")))) ),
        test.case "a capture is threaded through every frame in between"
            $( test.eq! [[Capture.local 0], [Capture.outer 0]]
                        { let r = resolved! "let f a = fn b -> fn c -> a;";
                          [func_captures (list.nth 1 (funcs r)),
                           func_captures (list.nth 2 (funcs r))] } ),
        test.case "capturing the same name twice captures it once"
            $( test.eq! 1 (list.length
                   (func_captures (list.nth 1 (funcs (resolved! "let f x = fn y -> x + x;"))))) ),

        // --- function records ---
        test.case "a global let is a function with its parameters as slots"
            $( test.eq! ["f", 2, 2]
                        { let f = list.head (funcs (resolved! "let f a b = a;"));
                          [func_name f, func_arity f, func_slots f] } ),
        test.case "a block's lets need slots too"
            $( test.eq! 3 (func_slots (list.head (funcs (resolved! "let f x = { let a = 1; let b = 2; a };")))) ),
        // Slots are not recycled when a scope ends. A value built in one scope
        // can be handed back unevaluated and read its binders out of the frame
        // later, by which time a sibling scope would have overwritten them.
        test.case "a sibling scope gets its own slots rather than reusing them"
            $( test.eq! 3 (func_slots (list.head (funcs
                   (resolved! "let f x = { { let a = 1; a } { let b = 2; b } };")))) ),
        // The collision this prevents: the VM puts the body's thunk in the
        // `let`'s slot and then forces it, so a binder inside the body must
        // not be handed that same slot.
        test.case "a binder inside a let's body does not take the let's slot"
            $( test.true! { let r = resolved! "let f y = { let a = match y { [s] => s, _ => 0 }; a };";
                            let outer = binding_slot r "a";
                            let inner = binding_slot r "s";
                            outer != () && inner != () && outer != inner } ),
        test.case "a thunk is a function of its own"
            $( test.eq! [2, "<thunk>"]
                        { let r = resolved! "let f = $( 1 );";
                          [list.length (funcs r), func_name (list.nth 1 (funcs r))] } ),
        test.case "a lambda is recorded at the span that made it"
            $( test.eq! (Meaning.closure 1)
                        { let src = "let f = fn x -> x;";
                          at (resolved! src) 0 0 (str.find "fn x" src) } ),

        // --- wrappers ---
        test.case "a body that is one get of its parameters is a wrapper"
            $( test.eq! (Inline.op :get)
                        (match map.pairs (wrappers (resolved! "let get m k d = m.[k else d];")) {
                             [[_, w]] => Wrapper.target w,
                             other => other,
                         }) ),
        test.case "so is one set"
            $( test.eq! (Inline.op :set)
                        (match map.pairs (wrappers (resolved! "let put m k v = m.[k => v];")) {
                             [[_, w]] => Wrapper.target w,
                             other => other,
                         }) ),
        // The rule a call's arguments are held to: a parameter used twice would
        // put one argument's work in two places.
        test.case "a get that uses a parameter twice is not"
            $( test.eq! [] (map.pairs (wrappers (resolved! "let get m k = m.[k else k];"))) ),

        // --- what a language server would ask ---
        test.case "a module's globals are listed in declaration order"
            $( test.eq! ["a", "b"]
                        (list.map (fn d -> list.nth 2 d)
                                  (module_defs (resolved! "let a = 1;\nlet b = 2;") 0)) ),
        test.case "a module's globals are numbered from where the module starts"
            $( test.eq! [Meaning.global 0 "a" 0, Meaning.global 0 "b" 1]
                        { let src = "let a = 1;\nlet b = a;\nlet f = b;";
                          let r = resolved! src;
                          [at r 0 0 (str.find "a;\nlet f" src), at r 0 0 (str.find "b;" src)] } ),
        test.case "an imported host module takes a global of its own"
            $( test.eq! (Meaning.global 0 "io" 0)
                        { let src = "import std.io;\nlet f = io;";
                          // The use, not the mention inside the import.
                          at (resolved! src) 0 0 (str.find "f = io" src + 4) } ),
        test.case "a definition can be found by name"
            $( test.true! { let src = "let a = 1;\nlet f = a;";
                            match definition (resolved! src) 0 "a" {
                                () => false,
                                d => ast.span_start (list.nth 2 d) == 0,
                            } } ),
        test.case "a name nothing defines has no definition"
            $( test.eq! () (definition (resolved! "let a = 1;") 0 "nope") ),
    ];
}
