// `dreams` -- the Dream compiler, written in Dream.
//
// Built by `mind`, like any other Dream project: `mind build`, `mind test`,
// `mind run -- FILE`. It has no build of its own and needs none.
//
// Only the lexer exists so far, so the one thing this can do is tokenize a
// file and say what it found. That is deliberately a real command rather than
// a stub: it reads a file off the disk, runs the lexer over it, and reports
// errors the way the finished compiler will have to.

import std.console;
import std.core;
import std.io;
import std.list;
import std.os;
import std.str;

import dreams.ast;
import dreams.lexer;
import dreams.parser;

// --- reading ----------------------------------------------------------------

let rec read_chunks! h acc = {
    let chunk = io.read! h 65536;
    if len chunk == 0 { str.join_str "" (list.reverse acc) }
    else { read_chunks! h (core.cons chunk acc) }
};

/// The whole file, or `()` when it cannot be opened.
let read_file! path = {
    let opened = try! { io.open! path :read } catch e { () };
    match opened {
        () => (),
        h => {
            let text = read_chunks! h [];
            io.close! h
            text
        }
    }
};

// --- reporting --------------------------------------------------------------
//
// A byte offset is what the lexer records, because that is what slices the
// source back out. A person needs a line and a column, so the conversion
// happens here, once, at the point of reporting -- and only for the offsets
// actually reported, which is why it can afford to be a scan.

/// The 1-based line and column of a byte offset: `[line, col]`.
let line_col src offset = {
    let rec walk i line col =
        if i >= offset || i >= str.byte_length src { [line, col] }
        else if core.str_byte src i == 10 { walk (i + 1) (line + 1) 1 }
        else if core.str_byte src i >= 128 && core.str_byte src i < 192 { walk (i + 1) line col }
        else { walk (i + 1) line (col + 1) };
    walk 0 1 1
};

let report! path src message offset = {
    let at = line_col src offset;
    console.error! (path + ":" + to_string (list.head at) + ":" + to_string (list.nth 1 at)
                    + ": error: " + message)
};

// --- commands ---------------------------------------------------------------

let describe t =
    match lexer.value t {
        () => to_string (lexer.kind t),
        v  => to_string (lexer.kind t) + " " + to_string v,
    };

/// Tokenize, and print one token per line with where it came from.
let tokenize! path src = {
    let rec put! ts n =
        match ts {
            [] => n,
            [t, ..rest] =>
                if lexer.is_error t {
                    report! path src (lexer.value t) (lexer.span_start t)
                    0 - 1
                } else {
                    let at = line_col src (lexer.span_start t);
                    console.print! (to_string (list.head at) + ":" + to_string (list.nth 1 at)
                                    + "  " + describe t)
                    put! rest (n + 1)
                },
        };
    let n = put! (lexer.tokens src) 0;
    // The `0` needs its own statement: `console.print!` is variadic, so on the
    // same line it would be one more thing to print rather than the answer.
    if n < 0 { 1 }
    else {
        console.print! ((to_string n) + " tokens")
        0
    }
};

/// Lex without printing: the exit code is the whole answer.
let check! path src =
    match lexer.lex src {
        [:ok, _] => 0,
        [:error, message, offset] => {
            report! path src message offset
            1
        },
        _ => 1,
    };

/// Parse, and print the syntax tree one item per line.
let ast! path src =
    match parser.parse_module src {
        [:ok, items] => {
            list.map (fn i -> console.print! (ast.show i)) items |> strict!
            0
        },
        [:error, message, span] => {
            report! path src message (ast.span_start span)
            1
        },
    };

/// Parse without printing: the exit code is the whole answer.
let check_parse! path src =
    match parser.parse_module src {
        [:ok, _] => 0,
        [:error, message, span] => {
            report! path src message (ast.span_start span)
            1
        },
    };

let usage! () = {
    console.error! "dreams -- the Dream compiler, in Dream"
    console.error! ""
    console.error! "usage: dreams [--tokens | --ast] FILE"
    console.error! ""
    console.error! "  --tokens   print the tokens instead of only checking them"
    console.error! "  --ast      print the syntax tree"
    2
};


let run! args =
    match args {
        [] => usage! (),
        ["--tokens", path] => with_source! path (fn src -> tokenize! path src),
        ["--ast", path] => with_source! path (fn src -> ast! path src),
        [path] => with_source! path (fn src -> check_parse! path src),
        _ => usage! (),
    };

let with_source! path k = {
    let src = read_file! path;
    match src {
        () => {
            console.error! ("dreams: cannot read " + to_string path)
            1
        },
        text => k text,
    }
};

let main! = os.exit! (run! (os.args! ()));
