// `dreams` -- the Dream compiler, written in Dream.
//
// Built by `mind`, like any other Dream project: `mind build`, `mind test`,
// `mind run -- FILE`. It has no build of its own and needs none.
//
// The front end is complete: a program is lexed, parsed, followed through every
// file it imports, resolved, purity-checked, and lowered to execution trees.
// What is missing is the image writer -- the arena exists, but nothing turns it
// into bytes yet -- and `comp`, which needs a VM to evaluate on.
//
// Every stage is a command rather than a stub, which is what makes each one
// usable on the way to the next. Several of them exist because something other
// than a batch compile wants them: `--symbols` and `--at` are questions an
// editor asks, and they read the same tables lowering does.

import std.console;

import std.io;
import std.list;
import std.os;
import std.str;
import std.streams;
import std.vm;

import dreams.ast;
import dreams.compile;
import dreams.config;
import dreams.diag;
import dreams.emit;
import dreams.expand as expansion;
import dreams.ir;
import dreams.lexer;
import dreams.lower;
import dreams.modules;
// Aliased, because `opt` is already the options accessor a few lines down and
// `opt o :output` beside `opt.optimize` reads as one thing doing two jobs.
import dreams.opt as optimizer;
import dreams.package;
import dreams.parser;
import dreams.path;
import dreams.repl;
import dreams.scope;
import dreams.target;
import dreams.typecheck;

let version = "0.1.0";

/// What `--shebang` writes when it is not given a line. `env` so that it finds
/// whichever `dream` is on the PATH rather than one fixed place.
let default_shebang = "#!/usr/bin/env dream";

// --- reporting --------------------------------------------------------------

let report! file src message offset =
    console.error! (diag.position file src offset + ": error: " + message);

/// Print what a pass had to say, and answer the exit code it earns.
let print_diags! sources ds = {
    if list.is_empty ds { () }
    else { console.error! (diag.render_all sources ds) }
    if diag.error_count ds > 0 { 1 } else { 0 }
};

// --- one file at a time -------------------------------------------------------

let describe t =
    match lexer.value t {
        () => to_string (lexer.kind t),
        v  => to_string (lexer.kind t) + " " + to_string v,
    };

/// Tokenize, and print one token per line with where it came from.
let tokenize! file src = {
    let rec put! ts n =
        match ts {
            [] => n,
            [t, ..rest] =>
                if lexer.is_error t {
                    report! file src (lexer.value t) (lexer.span_start t)
                    0 - 1
                } else {
                    let at = diag.line_col src (lexer.span_start t);
                    console.print! (to_string (list.head at) + ":" + to_string (list.nth 1 at)
                                    + "  " + describe t)
                    put! rest (n + 1)
                },
        };
    let n = put! (lexer.tokens src) 0;
    // The `0` needs its own statement: `console.print!` is variadic, so on the
    // same line it would be one more thing to print rather than the answer.
    if n < 0 { 1 }
    else {
        console.print! ((to_string n) + " tokens")
        0
    }
};

/// Parse, and print the syntax tree one item per line.
let ast! file src =
    match parser.parse_module src {
        [:ok, items, _] => {
            list.map (fn i -> console.print! (ast.show i)) items |> strict!
            0
        },
        [:error, message, span] => {
            report! file src message (ast.span_start span)
            1
        },
    };

/// Parse without printing: the exit code is the whole answer. File-local, so it
/// says nothing about imports -- which is exactly what a check on every keypress
/// wants, and why it is worth keeping separate from `--check`.
let parse_only! file src =
    match parser.parse_module src {
        [:ok, _, _] => 0,
        [:error, message, span] => {
            report! file src message (ast.span_start span)
            1
        },
    };

// --- the whole program ---------------------------------------------------------

/// Resolve and purity-check everything the root file reaches, and hold it
/// to its signatures.
let check_program! l o = print_diags! (modules.files l) (compile.check! l o);

/// The build options the command line asked for. The payload sizes are not
/// here: they are measured, which takes the files, and only a build does that.
let compile_options o =
    compile.Options.make (opt o :no_types != true) (opt o :no_opt != true) [] true [];

/// The modules a program pulls in, in the order a later pass must walk them:
/// dependencies before whatever uses them.
let show_modules! l = {
    let width = list.fold (fn w m -> {
        let n = str.byte_length (modules.module_name m);
        if n > w { n } else { w }
    }) 0 (modules.modules l);
    list.map (fn m ->
        console.print! (modules.module_name m
                        + str.repeat (width - str.byte_length (modules.module_name m) + 2) " "
                        + modules.module_path m))
             (modules.modules l) |> strict!
    if list.is_empty (modules.natives l) { () }
    else { console.print! ("host: " + str.join_str ", " (modules.natives l)) }
    print_diags! (modules.files l) (modules.diags l)
};

/// The packages a program can see, and what each provides. What to look at when
/// an import cannot be resolved.
let show_packages! ps = {
    match package.current ps {
        () => console.print! "current package: none",
        cur => console.print! ("current package: " + package.name cur + " (" + package.root cur + ")"),
    }
    list.map (fn p ->
        console.print! ("  " + package.name p + " " + package.version p + "  " + package.root p
                        + "\n      modules: " + str.join_str ", " (package.modules! p)))
             (package.packages ps) |> strict!
    list.map (fn n -> console.error! ("warning: " + n)) (package.notes ps) |> strict!
    0
};

/// The execution trees the program lowers to.
let show_ir! l = {
    let r = scope.resolve! l;
    let low = lower.lower_program r;
    let ds = list.append (modules.diags l) (lower.all_diags r low);
    if diag.error_count ds > 0 { print_diags! (modules.files l) ds }
    else {
        console.print! (lower.dump low)
        print_diags! (modules.files l) ds
    }
};

// --- payloads -----------------------------------------------------------------
//
// `--payload FILE` puts a file's bytes in the image, past everything the rest
// of the container can address. What the compiler handles is the *table* --
// where each datum starts and how long it is -- and never the bytes: a Dream
// string counts its length in 32 bits, which is the very limit the payload
// exists to get past. So a file is measured before the layout and copied after
// it, and at no point is it a value.

/// `NAME=FILE`, or `FILE` alone, as `[name, path]`. A file given no name is
/// called by its last path component, so `--payload lib/libz.so` is
/// `"libz.so"`. What is in front of the first `=` is a name only when it could
/// not be a path, so a file whose own name has an `=` in it still works.
let payload_spec spec = {
    let at = str.find "=" spec;
    if at > 0 && not (str.contains_str "/" (str.slice 0 at spec)) {
        [str.slice 0 at spec, str.slice (at + 1) (str.byte_length spec - at - 1) spec]
    } else { [path.basename spec, spec] }
};

/// How much of a payload is in memory at once. Anything would do; a megabyte
/// is large enough that the loop is not the cost and small enough to be free.
let payload_chunk = 1048576;

/// How many bytes are in this file, or `()` if it cannot be read.
///
/// Asked before anything is laid out, because the answer is what the `LDAT`
/// record will say -- the image commits to a length before a byte is written.
let payload_size! path =
    match try! { io.open! path :read } catch e { () } {
        () => (),
        h => {
            let n = try! { io.size! h } catch e { () };
            strict! n
            io.close! h
            n
        },
    };

/// The first bytes of a payload, which say whether it is a native binary and
/// for what (`target.sniff`). Empty when it cannot be read, which `sniff`
/// takes as data -- an unreadable payload is reported on its own.
let payload_head! path =
    match try! { io.open! path :read } catch e { () } {
        () => "",
        h => {
            let head = try! { io.read! h target.sniff_length } catch e { "" };
            strict! head
            io.close! h
            head
        },
    };

/// Copy exactly `n` bytes of `path` into an open handle.
///
/// Exactly `n`, rather than "until the end": `n` is what `io.size!` reported
/// when the table was laid out, and the table is already written. A file that
/// has grown since would run past the length the image records, and one that
/// has shrunk cannot fill it -- which is the case this answers `false` for,
/// rather than writing a short payload nothing would notice until it was read.
let copy_payload! out path n =
    match try! { io.open! path :read } catch e { () } {
        () => false,
        h => {
            let rec go! left =
                if left <= 0 { true }
                else {
                    let want = if left < payload_chunk { left } else { payload_chunk };
                    match io.read! h want {
                        "" => false,
                        chunk => {
                            streams.write_all! out chunk
                            go! (left - str.byte_length chunk)
                        },
                    }
                };
            let ok = go! n;
            strict! ok
            io.close! h
            ok
        },
    };

/// Compile the program and write the image.
///
/// This is the point of the whole front end: what comes out is a file the VM
/// can map and run. Nothing is written when anything went wrong, so a failed
/// build leaves the last good image where it was rather than a half-written one.
let build! l out shebang specs said o = {
    let named = list.map payload_spec specs;
    let payloads = list.map (fn e -> list.nth 1 e) named;
    let sizes = list.map (fn pth -> payload_size! pth) payloads;
    strict! sizes
    let with_payloads = compile.Options.set_payload_names
                            (compile.Options.set_payloads o sizes)
                            (list.map (fn e -> list.head e) named);
    let b = compile.build! l with_payloads;
    let unreadable = list.filter (fn pair -> list.nth 1 pair == ()) (list.zip payloads sizes);
    // Where the image may run, which is only worth reading the payloads' first
    // bytes for when nobody has said.
    let carried = if said == () && list.is_empty unreadable {
                      target.of_payloads (list.map payload_head! payloads)
                  } else { () };
    let aim = target.decide said carried
                            (target.from_reads (modules.config_of l) (modules.reads l));
    if not (compile.ok b) { print_diags! (compile.files b) (compile.diags b) }
    else if not (list.is_empty unreadable) {
        console.error! ("dreams: cannot read payload " + list.head (list.head unreadable))
        1
    }
    else if list.head aim == :error {
        console.error! ("dreams: " + list.nth 1 aim)
        1
    }
    else {
        let aimed = list.nth 1 aim;
        // Set here, on the image this command writes, and never in
        // `compile.image`: a `comp` runs an image of the same program on the
        // compiler's own VM, and a cross-build's target is not that machine.
        let img = (compile.image b).[:target_flags => target.flags aimed];
        let payload_bytes = list.sum sizes;
        // The shebang goes in front of the image rather than into it: the VM
        // skips a leading `#!` line when it loads a file, which is what makes
        // one file both an image and a program.
        let bytes = match shebang {
                        () => emit.to_binary img,
                        line => line + "\n" + emit.to_binary img,
                    };
        match try! { io.open! out :write } catch e { () } {
            () => {
                console.error! ("dreams: cannot write " + out)
                1
            },
            handle => {
                streams.write_all! handle bytes
                // The payload goes on the end, straight from the files it came
                // from. The section table already names where it starts and how
                // long each datum is, which is why the sizes had to be taken
                // before any of this was laid out.
                let copied = list.fold_strict
                                 (fn ok [pth, n] -> ok && copy_payload! handle pth n)
                                 true (list.zip payloads sizes);
                io.close! handle
                // There is no `chmod` builtin, and the execute bit is the whole
                // point of the `#!` line, so this is one place where shelling
                // out is the implementation rather than a shortcut.
                match [shebang, os.platform ()] { [(), _] => (), [_, :windows] => (), _ => os.exec! "chmod" ["+x", out] }
                if not copied {
                    console.error! ("dreams: a payload was shorter than it measured; "
                                    + out + " is incomplete")
                    1
                } else {
                    console.error! ("compiled -> " + out + " ("
                                + to_string (str.byte_length bytes + payload_bytes)
                                + " bytes, " + to_string (modules.module_count l)
                                + " modules, " + to_string (list.length (img.[:nodes else []]))
                                + " nodes, " + to_string (list.length (img.[:funcs else []]))
                                + " functions"
                                + (if target.is_any aimed { "" }
                                   else { ", for " + target.describe aimed })
                                + (if list.is_empty payloads { "" }
                                   else { ", " + to_string (list.length payloads) + " payloads, "
                                          + to_string payload_bytes + " payload bytes" })
                                + ")")
                    print_diags! (compile.files b) (compile.diags b)
                }
            },
        }
    }
};

/// What the program contains, counted. Useful on its own, and the quickest way
/// to see that a change to the front end did not quietly change its output.
let show_stats! l = {
    let r = scope.resolve! l;
    let lowered = lower.image (lower.lower_program r);
    let img = optimizer.optimize lowered;
    let count! label n = console.print! (label + str.repeat (12 - str.byte_length label) " "
                                        + to_string n);
    count! "modules" (modules.module_count l)
    count! "host" (list.length (modules.natives l))
    count! "globals" (list.length (scope.defs r))
    count! "functions" (list.length (scope.funcs r))
    // Both counts, because the interesting number about the arena is how much
    // of it was the same node written again: `nodes` is what the image carries
    // and `lowered` is what lowering emitted to get there.
    count! "nodes" (list.length (img.[:nodes else []]))
    count! "lowered" (list.length (lowered.[:nodes else []]))
    count! "constants" (list.length (img.[:ints else []])
                       + list.length (img.[:floats else []])
                       + list.length (img.[:strs else []])
                       + list.length (img.[:atoms else []]))
    count! "reductions" (vm.reductions! ())
    print_diags! (modules.files l) (list.append (modules.diags l) (scope.r_diags r))
};

// --- where the time goes ----------------------------------------------------------
//
// A compiler that is slow is slow *somewhere*, and guessing where is how an
// afternoon disappears into the wrong function. This runs the same pipeline a
// build runs and says what each stage cost.
//
// Every reading is taken around a `strict!`, and that is not a detail: in a
// lazy language a stage that has not been forced has not run. Timing
// `modules.load! ..` unforced would time the building of one thunk and hand the
// real work to whoever forced it next, so the numbers would say the front end
// is free and the image writer is everything. Forcing each stage where it is
// measured moves no work -- the next stage would have forced exactly this --
// it only puts the cost where it was incurred.

/// One stage: force it, and answer `[value, work, walk]` in milliseconds.
///
/// The stage arrives here unevaluated, and nothing had to be written to make it
/// so: an argument is a thunk, so `timed! (scope.resolve! l)` hands over the
/// work rather than its result. That is the whole trick, and it is why there is
/// no lambda here -- laziness already is the suspension a timer needs.
///
/// The `strict!` below is where the work happens, and where the clock is read.
/// Forcing at the binding would time the building of a thunk and hand the real
/// work to whoever forced it next, and every stage would look free except the
/// last.
///
/// Two readings, because one would be a lie. Forcing a stage walks everything
/// it is built on -- an arena carries the resolution tables, which carry the
/// syntax trees -- and all of that was forced by the stage before. The second
/// `strict!` finds every thunk already forced and does nothing but walk, which
/// is what the first one spent on ground already covered. The difference is
/// this stage's own work, and it is the column to read.
let timed! value = {
    let before = os.monotonic! ();
    strict! value
    let forced = os.monotonic! ();
    strict! value
    let walked = os.monotonic! ();
    [value, forced - before, walked - forced]
};

let value_of t = list.head t;
let work_of t = list.nth 1 t;
let walk_of t = list.nth 2 t;
/// What this stage did that no stage before it had done.
let own_of t = {
    let d = work_of t - walk_of t;
    if d < 0 { 0 } else { d }
};

/// Time the whole pipeline, stage by stage, and write nothing.
let show_time! o file = {
    let read = timed! (read! o file);
    // Ask expansion to charge its own phases while it runs. `--time` is the
    // only caller that does, and `modules.metering` says why: charging a phase
    // forces it, and one of expansion's phases is deliberately never forced on
    // a round that refuses every module before running one.
    let load = timed! (expansion.expand! (modules.with_metering (value_of read)));
    let l = value_of load;
    let resolved = timed! (scope.resolve! l);
    let r = value_of resolved;
    let checked = timed! (if opt o :no_types == true || diag.error_count (scope.r_diags r) > 0 { [] }
                          else { typecheck.check_program l r });
    let linked = timed! (lower.link! l r);
    let low = value_of linked;
    let built = timed! (lower.image low);
    let lowered = value_of built;
    let shared = timed! (optimizer.optimize lowered);
    let img = value_of shared;
    let written = timed! (emit.to_binary img);
    let bytes = value_of written;

    let stages = [["parse", read], ["expand", load], ["resolve", resolved],
                  ["types", checked], ["lower", linked], ["arena", built], ["share", shared],
                  ["emit", written]];
    let total = list.fold (fn n st -> n + own_of (list.nth 1 st)) 0 stages;
    let pad n text = str.repeat (n - str.byte_length text) " " + text;
    let line! label ms walk = {
        let pct = if total <= 0 { 0 } else { ms * 100 / total };
        console.print! (label + str.repeat (10 - str.byte_length label) " "
                        + pad 6 (to_string ms) + " ms  " + pad 3 (to_string pct) + "%"
                        + (match walk { () => "", w => "   (walk " + to_string w + " ms)" }))
    };
    list.map (fn st -> line! (list.head st) (own_of (list.nth 1 st))
                             (walk_of (list.nth 1 st))) stages |> strict!
    line! "total" total ()
    console.print! ("image     " + to_string (str.byte_length bytes) + " bytes, "
                    + to_string (modules.module_count l) + " modules, "
                    + to_string (list.length (img.[:nodes else []])) + " nodes"
                    + " (from " + to_string (list.length (lowered.[:nodes else []])) + ")")
    show_macros! l
    print_diags! (modules.files l) (list.append (list.append (modules.diags l) (lower.all_diags r low))
                                                (value_of checked))
};

/// What macro expansion spent, broken into the things a round does.
///
/// The `expand` row above is the whole of it and was enough to justify the
/// three changes that took expansion from seven seconds of a self-compile to
/// under half of one. It is not enough to justify the next one, which is a
/// proposal to stop building an image per round at all (dreams/TODO.md): that
/// is a redesign of `lower`, `emit` and `run` together, and whether it is
/// worth doing depends on what those three are against `snapshot` and
/// `resolve`, which it does not touch.
///
/// `discover`, `stage` and `snapshot` are paid once for the program. The rest
/// are paid once per round, and a round is the *nesting* of macro calls rather
/// than their number -- forty calls written side by side are one round, and one
/// macro whose answer calls another is two.
///
/// `stage` and `snapshot` were one row until the pair turned out to be most of
/// what a macro costs a large program, at which point "which of the two?" was
/// the only question left and the meter could not answer it. Staging rewrites
/// every module's items; `snapshot` is `scope.declare!`.
let show_macros! l = match modules.macro_meter l {
    () => (),
    meter => {
        let phases = meter.[:phases else %{}];
        let tallies = meter.[:counts else %{}];
        let count k = tallies.[k else 0];
        let rows = [[:discover, "discover"], [:stage, "stage"],
                    [:snapshot, "snapshot"], [:sites, "sites"],
                    [:resolve, "resolve"], [:image, "lower"], [:emit, "emit"],
                    [:vm, "run"], [:install, "install"]];
        let at k = phases.[k else [0, 0, 0, 0]];
        let ms r = list.nth 0 r / 1000000;
        let total = list.fold (fn n [k, _] -> n + ms (at k)) 0 rows;
        let pad n text = str.repeat (n - str.byte_length text) " " + text;
        let millions n = to_string (n / 1000000) + "." + to_string (n % 1000000 / 100000);
        let plural n one = to_string n + " " + one + (if n == 1 { "" } else { "s" });
        let row! [k, label] = {
            let r = at k;
            let pct = if total <= 0 { 0 } else { ms r * 100 / total };
            console.print! ("  " + label + str.repeat (9 - str.byte_length label) " "
                            + pad 6 (to_string (ms r)) + " ms  " + pad 3 (to_string pct) + "%"
                            + pad 9 (millions (list.nth 1 r)) + " M red"
                            + pad 7 (to_string (list.nth 2 r / 1048576)) + " MB")
        };
        console.print! ("macro     " + str.join_str ", "
            [plural (count :rounds) "round", plural (count :wrappers) "wrapper",
             plural (count :calls) "call",
             plural (count :images) "image" + " of "
                 + to_string (count :image_bytes / 1024) + " KB",
             plural (count :vm_starts) "VM start"]
            + (match [count :one_by_one, count :sequential, count :refused] {
                   [0, 0, 0] => "",
                   [o, q, f] => "  (" + str.join_str ", "
                       (list.filter (fn t -> t != "")
                           [if o == 0 { "" } else { plural o "fallback to one call at a time" },
                            if q == 0 { "" } else { "expanded again in order" },
                            if f == 0 { "" } else { plural f "module refused" }]) + ")",
               }))
        list.map (fn r -> row! r) rows |> strict!
        console.print! ("  " + pad 21 (to_string total) + " ms of the expand row above")
    },
};

// --- questions an editor asks ----------------------------------------------------
//
// Neither of these compiles anything. They read the tables resolution already
// built, which is the point of building them: an editor needs an answer about
// one position, not an image.

/// Which loaded module came from this file, or `()`.
let module_of! l file = {
    let want = path.absolute! file;
    let hits = list.filter (fn i -> path.absolute! (modules.module_path (modules.module_at l i))
                                    == want)
                           (list.range 0 (modules.module_count l));
    if list.is_empty hits { () } else { list.head hits }
};

/// What a file defines, one per line: the outline of a document.
let show_symbols! l file = {
    let r = scope.resolve! l;
    match module_of! l file {
        () => {
            console.error! ("dreams: " + file + " is not part of this program")
            1
        },
        mi => {
            let m = modules.module_at l mi;
            let src = diag.source_text (modules.file_at l (modules.module_source m));
            list.map (fn d -> {
                let at = diag.line_col src (ast.span_start (list.nth 3 d));
                console.print! (to_string (list.head at) + ":" + to_string (list.nth 1 at)
                                + "  " + list.nth 2 d)
            }) (scope.module_defs r mi) |> strict!
            0
        },
    }
};

/// Is this byte the middle of a name? Used to find where the name under a
/// cursor begins, which is what the resolution table is keyed by.
let is_name_byte b =
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57)
    || b == 95 || b == 33;

/// The start of the name containing `offset`. A cursor rests *in* a word, and
/// the table is keyed by where the word starts, so this walks back to it.
let name_start src offset = {
    let rec back i =
        if i <= 0 { 0 }
        else if is_name_byte (str_byte src (i - 1)) { back (i - 1) }
        else { i };
    back offset
};

/// The identifier that begins at this offset, or `""`.
let name_at src at = {
    let rec forward i =
        if i >= str.byte_length src { i }
        else if is_name_byte (str_byte src i) { forward (i + 1) }
        else { i };
    str.slice at (forward at - at) src
};

/// Say what is at a position, and where it came from. The primitive an editor
/// needs for go-to-definition and for hover.
let show_at! l file line col = {
    let r = scope.resolve! l;
    match module_of! l file {
        () => {
            console.error! ("dreams: " + file + " is not part of this program")
            1
        },
        mi => {
            let m = modules.module_at l mi;
            let source = modules.module_source m;
            let src = diag.source_text (modules.file_at l source);
            let at = name_start src (diag.offset_of src line col);
            let pos = diag.line_col src at;
            let here = to_string (list.head pos) + ":" + to_string (list.nth 1 pos) + "  ";
            // Three tables, because a cursor can be on three different things:
            // a name being used, a name being bound, or a name being declared.
            // An editor asks the same question at all three.
            match scope.at r mi source at {
                () =>
                    match scope.binding r mi source (ast.span_of at at) {
                        () =>
                            // A declaration records one span, covering the
                            // whole of it rather than just its name, so a
                            // definition is recognised by the name sitting
                            // under the cursor being the one declared there.
                            match list.filter (fn d ->
                                      list.nth 2 d == name_at src at
                                      && at >= ast.span_start (list.nth 3 d)
                                      && at <= ast.span_end (list.nth 3 d))
                                  (scope.module_defs r mi) {
                                [] => {
                                    console.print! "nothing resolved here"
                                    1
                                },
                                hits => {
                                    console.print! (here + "the definition of `"
                                                    + list.nth 2 (list.head hits) + "`")
                                    0
                                },
                            },
                        b => {
                            console.print! (here + "binds `" + list.nth 0 b + "`, slot "
                                            + to_string (list.nth 1 b))
                            0
                        },
                    },
                found => {
                    console.print! (here + describe_resolution l r found)
                    0
                },
            }
        },
    }
};

/// One resolution, in the terms a person reading it would use.
let describe_resolution l r found =
    match found {
        [:local, slot, span] => "local, slot " + to_string slot
                                + ", bound at byte " + to_string (ast.span_start span),
        [:capture, idx, _] => "captured from an enclosing function, capture " + to_string idx,
        [:global, mi, name, g] =>
            "global `" + name + "` of module " + modules.module_name (modules.module_at l mi)
            + ", index " + to_string g,
        [:builtin, name] => "builtin `" + name + "`",
        [:member, [:dream, target], field, g] =>
            "`" + field + "` of module " + modules.module_name (modules.module_at l target)
            + ", global " + to_string g,
        [:member, [:native, p, _], field, _] => "`" + field + "` of the host module `" + p + "`",
        [:closure, fi] => "a closure over function " + to_string fi,
        [:thunk, fi] => "a thunk over function " + to_string fi,
        [:match, slot] => "the subject of a match, held in slot " + to_string slot,
        other => to_string other,
    };

// --- the command line -----------------------------------------------------------

let defaults = %{ :command => :check, :file => (), :roots => [], :includes => [],
                  :defines => [], :hosts => [], :test => false, :quiet => false,
                  :position => (), :output => (), :shebang => (), :payloads => [],
                  :targets => [], :said => (), :error => () };

let opt o k = o.[k else ()];
let with_opt k v o = o.[k => v];
let append_opt k v o = o.[k => (list.append (o.[k else []]) [v])];

/// `LINE:COL`, as `--at` takes it.
let parse_position text = {
    let parts = str.split ":" text;
    if list.length parts != 2 { () }
    else {
        match [parse_int (list.nth 0 parts), parse_int (list.nth 1 parts)] {
            [(), _] => (),
            [_, ()] => (),
            both => both,
        }
    }
};

/// Read the arguments. A flag that takes a value consumes the next argument,
/// and running out is an error rather than a silent default: `-L` with nothing
/// after it is a mistake worth naming.
let rec parse_args args o =
    match args {
        [] => o,

        // What to do.
        ["--tokens", ..rest]    => parse_args rest (with_opt :command :tokens o),
        ["--ast", ..rest]       => parse_args rest (with_opt :command :ast o),
        ["--parse", ..rest]     => parse_args rest (with_opt :command :parse o),
        ["--check", ..rest]     => parse_args rest (with_opt :command :check o),
        // `--no-emit` is kept as an alias for `--check`: a build tool that
        // learned the one spelling should not have to learn the other.
        ["--no-emit", ..rest]   => parse_args rest (with_opt :command :check o),
        ["-o"] => with_opt :error "-o needs a path" o,
        ["-o", out, ..rest]     => parse_args rest (with_opt :output out
                                                     (with_opt :command :build o)),
        ["--output", out, ..rest] => parse_args rest (with_opt :output out
                                                       (with_opt :command :build o)),
        ["--modules", ..rest]   => parse_args rest (with_opt :command :modules o),
        ["--packages", ..rest]  => parse_args rest (with_opt :command :packages o),
        ["--ir", ..rest]        => parse_args rest (with_opt :command :ir o),
        ["--symbols", ..rest]   => parse_args rest (with_opt :command :symbols o),
        ["--stats", ..rest]     => parse_args rest (with_opt :command :stats o),
        ["--time", ..rest]      => parse_args rest (with_opt :command :time o),
        ["--print-cfg", ..rest] => parse_args rest (with_opt :command :print_cfg o),
        ["--repl", ..rest]      => parse_args rest (with_opt :command :repl o),
        // The VM skips a leading `#!` line, so an image carrying one is both a
        // valid image and a file that runs when it is executed. The line is
        // optional: `--shebang` on its own writes the usual one, and anything
        // that is not another option replaces it.
        ["--shebang"] => with_opt :shebang default_shebang o,
        ["--shebang", nxt, ..rest] =>
            if str.starts_with "-" nxt { parse_args (list.cons nxt rest)
                                                    (with_opt :shebang default_shebang o) }
            else if str.starts_with "#!" nxt { parse_args rest (with_opt :shebang nxt o) }
            else { parse_args rest (with_opt :shebang ("#!" + nxt) o) },
        ["-i", ..rest]          => parse_args rest (with_opt :command :repl o),
        ["--version", ..rest]   => parse_args rest (with_opt :command :version o),
        ["-h", ..rest]          => parse_args rest (with_opt :command :help o),
        ["--help", ..rest]      => parse_args rest (with_opt :command :help o),
        ["--at"] => with_opt :error "--at needs a LINE:COL" o,
        ["--at", at, ..rest] =>
            match parse_position at {
                () => with_opt :error ("--at wants LINE:COL, not " + at) o,
                p  => parse_args rest (with_opt :position p (with_opt :command :at o)),
            },

        // Where to look.
        ["-L"] => with_opt :error "-L needs a directory" o,
        ["-L", dir, ..rest] => parse_args rest (append_opt :roots dir o),
        ["--package-path", dir, ..rest] => parse_args rest (append_opt :roots dir o),
        ["-I"] => with_opt :error "-I needs a directory" o,
        ["-I", dir, ..rest] => parse_args rest (append_opt :includes dir o),
        ["--host-module"] => with_opt :error "--host-module needs a module path" o,
        ["--host-module", m, ..rest] => parse_args rest (append_opt :hosts m o),
        ["--payload"] => with_opt :error "--payload needs a path" o,
        ["--payload", f, ..rest] => parse_args rest (append_opt :payloads f o),

        // What to compile it as.
        ["--target"] => with_opt :error "--target needs a platform, or `any`" o,
        ["--target", t, ..rest] => parse_args rest (append_opt :targets t o),
        ["-D"] => with_opt :error "-D needs a name or name=value" o,
        ["-D", d, ..rest] => parse_args rest (append_opt :defines d o),
        ["--define", d, ..rest] => parse_args rest (append_opt :defines d o),
        ["--test", ..rest] => parse_args rest (with_opt :test true o),
        // Emit the arena exactly as `lower` built it. Nothing should need
        // this, which is the point: when an image misbehaves it answers
        // whether the pass that rewrote it is why.
        ["--no-opt", ..rest] => parse_args rest (with_opt :no_opt true o),
        ["--no-types", ..rest] => parse_args rest (with_opt :no_types true o),
        ["--release", ..rest] => parse_args rest (append_opt :defines "release" o),
        ["--debug-cfg", ..rest] => parse_args rest (append_opt :defines "debug" o),
        ["-q", ..rest] => parse_args rest (with_opt :quiet true o),
        ["--quiet", ..rest] => parse_args rest (with_opt :quiet true o),

        [arg, ..rest] =>
            if str.starts_with "-" arg { with_opt :error ("unknown option " + arg) o }
            else if opt o :file != () { with_opt :error "only one file, please" o }
            else { parse_args rest (with_opt :file arg o) },
    };

let usage! () = {
    list.map (fn line -> console.error! line) [
        "dreams " + version + " -- the Dream compiler, in Dream",
        "",
        "usage: dreams [options] FILE",
        "",
        "what to do (one of; the default is --check):",
        "  -o, --output PATH  compile the program and write the image there",
        "  --check, --no-emit  resolve every name and check purity, across the whole program",
        "  --parse        parse this file alone, following no imports",
        "  --tokens       print the tokens",
        "  --ast          print the syntax tree",
        "  --modules      list the modules the program pulls in",
        "  --packages     list the packages that were found",
        "  --ir           print the execution trees the program lowers to",
        "  --symbols      list what this file defines, with where",
        "  --at LINE:COL  say what is at a position, and where it came from",
        "  --stats        count what the program contains",
        "  --time         compile the whole way and say what each stage cost",
        "  --repl         an interactive session: read, compile, run, repeat",
        "  --print-cfg    print the `when` flags that are defined",
        "  --shebang [LINE]  prefix the image with a `#!` line and make it executable",
        "  -i, --repl     an interactive session: read, compile, run, repeat",
        "  --version      print the version",
        "",
        "where to look:",
        "  -L, --package-path DIR   a package, or a directory holding packages;",
        "                           NAME=DIR is the package at DIR, imported as NAME",
        "  -I, --include DIR        a directory to search for modules",
        "  --host-module PATH       treat PATH as provided by the host",
        "  --payload [NAME=]FILE    put FILE's bytes in the image, reachable as",
        "                           `data_at N` in the order given; NAME (FILE's",
        "                           own name by default) is how `std.foreign`",
        "                           finds a library carried this way",
        "",
        "what to compile it as:",
        "  -D, --define NAME[=V]    define a `when` flag, or set a `when` value;",
        "                           KEY:NAME[=V] sets package KEY's option",
        "  --target SPEC            where the image may run: os=NAME,arch=NAME, or a",
        "                           bare name (linux, macos, windows, x86_64, aarch64);",
        "                           given twice, either; `any` records nothing. Without",
        "                           it, native payloads and `when os` decide",
        "  --test                   define `test`, and add a runner for the tests",
        "                           each module exports",
        "  --release                define `release`",
        "  --no-opt                 emit the arena as lowered, unshared",
        "  --no-types               do not hold the program to its signatures",
        "  --debug-cfg              define `debug`",
        "  -q, --quiet              print only what was asked for",
    ] |> strict!
    2
};

/// Read the file and hand its text to `k`, or fail saying so. The parameter is
/// `file` rather than `path` because `path` is a module here, and a parameter of
/// that name would shadow it.
let with_source! file k =
    match path.read_file! file {
        () => {
            console.error! ("dreams: cannot read " + file)
            1
        },
        text => k text,
    };

/// The configuration a compile starts from: the machine, then the target if
/// one was named (so `when os` follows a cross-build), then `-D`, which is the
/// most specific thing anyone said and so wins.
let configured! o = {
    let base = if opt o :test { config.define "test" (config.defaults! ()) }
               else { config.defaults! () };
    let aimed = match opt o :said { () => base, :any => base, t => target.configure t base };
    config.define_args (opt o :defines) aimed
};

/// Load the whole program the file is the root of, before macros. The include
/// directories are search paths as well as package roots, which is what `-I`
/// means.
///
/// Separate from `load!` so that `--time` can charge reading a program and
/// expanding it to different lines. They used to be one stage called `parse`,
/// and the question "what do the macros cost?" then had no answer short of
/// writing the program twice.
let read! o file =
    modules.load_shared! file (list.append (opt o :roots) (opt o :includes)) (configured! o)
                         (opt o :test == true);

let load! o file = expansion.expand! (read! o file);

let run_command! o file =
    match opt o :command {
        :tokens    => with_source! file (fn src -> tokenize! file src),
        :ast       => with_source! file (fn src -> ast! file src),
        :parse     => with_source! file (fn src -> parse_only! file src),
        :check     => check_program! (load! o file) (compile_options o),
        :build     => build! (load! o file) (opt o :output) (opt o :shebang) (opt o :payloads)
                             (opt o :said) (compile_options o),
        :modules   => show_modules! (load! o file),
        :packages  => show_packages! (package.discover! file (opt o :roots)),
        :ir        => show_ir! (load! o file),
        :stats     => show_stats! (load! o file),
        :time      => show_time! o file,
        :symbols   => show_symbols! (load! o file) file,
        :at        => show_at! (load! o file) file
                               (list.nth 0 (opt o :position)) (list.nth 1 (opt o :position)),
        :repl      => (),
        _ => usage! (),
    };

let run! args = {
    let parsed = parse_args args defaults;
    let o = match target.parse_all (opt parsed :targets) {
        [:ok, said] => with_opt :said said parsed,
        [:error, why] => if opt parsed :error == () { with_opt :error why parsed } else { parsed },
    };
    match opt o :error {
        () =>
            match opt o :command {
                :help => usage! (),
                :version => {
                    console.print! ("dreams " + version)
                    0
                },
                :repl => repl.start! (list.append (opt o :roots) (opt o :includes))
                                     (configured! o) version,
                :print_cfg => {
                    list.map (fn line -> console.print! line) (config.describe (configured! o))
                        |> strict!
                    0
                },
                _ =>
                    match opt o :file {
                        () => usage! (),
                        file => run_command! o file,
                    },
            },
        why => {
            console.error! ("dreams: " + why)
            usage! ()
        },
    }
};

let main! = os.exit! (run! (os.args! ()));
