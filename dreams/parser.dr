// Recursive descent with precedence climbing, over the lexer's token stream.
//
// The Rust parser this replaces walks an array and moves a cursor. There is no
// cursor here. Every function takes the tokens still to read and answers
// `[:ok, value, rest]` -- the same shape `std.json` and `std.toml` use -- so
// the position is a value like any other, backtracking is just keeping the
// list you already had, and nothing has to be undone on failure.
//
// It reads the lexer's **lazy** stream directly, so tokens are scanned as the
// parser asks for them. A file that fails to parse on line 3 is never lexed
// past line 3.
//
// Failure is `[:error, message, span]`. Nothing raises, so the parser is pure.
//
// The one piece of state that has to be threaded is the layout context, and it
// is genuinely contextual rather than incidental:
//
//   nl        whether a line break ends a statement here -- false inside
//             `(`, `[`, `$(`, `#[`, `%{`, true inside a block and at top level
//   no_brace  whether `{` starts a block rather than an argument, which is how
//             `if cond { .. }` knows the brace is the branch
//   indent    the column the current statement began at; a line indented past
//             it continues that statement rather than starting a new one

import std.core;
import std.list;
import std.str;

import dreams.ast;
import dreams.lexer;

// --- results ----------------------------------------------------------------

let ok value rest = [:ok, value, rest];
let err message span = [:error, message, span];

let is_ok r = core.head r == :ok;
let value_of r = list.nth 1 r;
let rest_of r = list.nth 2 r;
let message_of r = list.nth 1 r;
let span_of r = list.nth 2 r;

// --- the layout context -----------------------------------------------------

group Context {
    nl
    no_brace
    indent
    grouped self = make false false (indent self)
    forbid_brace self = set_no_brace self true
    allow_brace self = set_no_brace self false
}

let ctx = Context.make;
let ctx_nl c = Context.nl c;
let ctx_no_brace c = Context.no_brace c;
let ctx_indent c = Context.indent c;

/// Inside a bracket group: newlines stop mattering, and a `{` is an argument
/// again. `( .. )`, `[ .. ]`, `$( .. )`, `#[ .. ]` and `%{ .. }` all do this.
/// Braces are deliberately not in that list -- a block is newline-sensitive.
let grouped c = Context.grouped c;

let no_brace c = Context.forbid_brace c;
let allow_brace c = Context.allow_brace c;

let top = ctx true false 0;

// --- tokens -----------------------------------------------------------------

let at_end ts = list.is_empty ts;
let peek ts = if at_end ts { () } else { list.head ts };
let peek_kind ts = if at_end ts { :eof } else { lexer.kind (list.head ts) };
let peek_value ts = if at_end ts { () } else { lexer.value (list.head ts) };
let peek_span ts =
    if at_end ts { ast.no_span }
    else { lexer.span (list.head ts) };

let at ts k = peek_kind ts == k;

/// The grammar asks several questions of the same token -- can it begin an
/// argument, what kind is it, what is it worth, does its line continuation
/// hold -- and each answer means one `list.head` and one array get when asked
/// through the peekers above. A token is an array precisely so that asking
/// becomes O(1); the peeks are the walk that remains. The decision points
/// below fetch the token once and read its fields directly, which is the same
/// `list.head` followed by the same array gets -- just not repeated.
let kind_of t = lexer.kind t;

/// Does this token continue the statement being parsed, or start a new one?
/// A line break ends a statement unless the line is indented past the
/// statement it follows -- the same cue a reader goes by.
let token_continues c t =
    if not (ctx_nl c) { true }
    else if not (lexer.starts_line t) { true }
    else { lexer.col t > ctx_indent c };

/// Keywords are ordinary identifiers that the parser recognises; the lexer has
/// no idea they are special.
let keywords = ["let", "priv", "rec", "if", "else", "import", "as", "catch", "true", "false",
                "not", "try!", "fn", "virtual", "derive", "comp", "comp!", "when", "mod",
                "match", "macro", "expand", "group", "struct", "mapping", "type"];

/// Those that can never begin an expression, so meeting one ends an argument
/// list. `if`, `fn`, `match` and the rest are missing on purpose: they can.
let non_starters = ["let", "priv", "rec", "else", "import", "as", "catch", "virtual", "derive",
                    "when", "mod", "macro", "type"];

/// The lists above are the readable form; these are how they are asked. A
/// linear scan answers "is this identifier a keyword" in a dozen reductions
/// per candidate, and the parser asks it of every identifier in the program --
/// it was a tenth of everything the compiler did. A map answers it in one
/// hash; `comp` builds both sets into the compiler image.
priv let set_of names = list.fold (fn m n -> m.[n => true]) %{} names;

priv let keyword_set = comp set_of keywords;
priv let non_starter_set = comp set_of non_starters;

let is_kw ts word = at ts :ident && peek_value ts == word;
// Record introducers are contextual: existing code can still bind `group`.
let is_keyword name = match name {
    "group" => false,
    "struct" => false,
    "mapping" => false,
    _ => core.map_has keyword_set name,
};
let is_non_starter name = core.map_has non_starter_set name;

/// The token after this one, for the single place that needs to look ahead:
/// telling `.field` from a `.` that is something else.
let peek2_kind ts = if at_end ts { :eof } else { peek_kind (list.tail ts) };

/// Parse `f` as a statement: its indentation is whatever column it starts at.
let at_statement c ts = ctx (ctx_nl c) (ctx_no_brace c) (if at_end ts { 0 } else { lexer.col (list.head ts) });

/// Name the next thing in the stream. A lexical error token carries its own
/// message as its value, so it names itself.
let describe ts =
    if at_end ts { "the end of the file" }
    else {
        match peek_kind ts {
            :ident => "`" + to_string (peek_value ts) + "`",
            :int => "a number",
            :float => "a number",
            :str => "a string",
            :char => "a character",
            :atom => "an atom",
            :error => to_string (peek_value ts),
            k => "`" + to_string k + "`",
        }
    };

let expect ts k what =
    if at ts k { ok () (list.tail ts) }
    else { err ("expected " + what + ", found " + describe ts) (peek_span ts) };

// --- expressions ------------------------------------------------------------

let parse_expr c ts = parse_pipe c ts;

/// `x |> f a` feeds `x` in as the last argument. Left-associative, and looser
/// than every other operator.
let rec parse_pipe c ts =
    match parse_binary c 0 ts {
        [:error, m, s] => err m s,
        [:ok, lhs, rest] => pipe_tail c lhs rest,
    };

let rec pipe_tail c lhs ts =
    // No indentation check: `|>` can never begin a statement, so a line that
    // starts with one continues the line above whatever its indentation.
    if not (at ts :pipe_into) { ok lhs ts }
    else {
        match parse_binary c 0 (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, rhs, rest] =>
                pipe_tail c (ast.pipe_e lhs rhs (ast.span_to (ast.span lhs) (ast.span rhs))) rest,
        }
    };

/// Precedence climbing. Every infix operator is left-associative, which is why
/// the right side is parsed at one level tighter.
let rec parse_binary c level ts =
    match parse_unary c ts {
        [:error, m, s] => err m s,
        [:ok, lhs, rest] => binary_tail c level lhs rest,
    };

let rec binary_tail c level lhs ts = {
    // As with the pipe: an infix operator cannot start a statement, so meeting
    // one always continues the expression, however the line is indented.
    //
    //     let total = a
    //         + b            // continues
    //     + c                // continues too -- the indentation is irrelevant
    let op = ast.infix_of (peek_kind ts);
    if op == () { ok lhs ts }
    else if ast.precedence op < level { ok lhs ts }
    else {
        match parse_binary c (ast.precedence op + 1) (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, rhs, rest] =>
                binary_tail c level
                            (ast.binary_e op lhs rhs (ast.span_to (ast.span lhs) (ast.span rhs)))
                            rest,
        }
    }
};

/// A leading `-` or `not`. Both bind tighter than any infix operator and
/// looser than application, so `not f x` is `not (f x)`.
let rec parse_unary c ts = {
    let start = peek_span ts;
    if at ts :minus {
        match parse_unary c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, e, rest] => ok (ast.unary_e :neg e (ast.span_to start (ast.span e))) rest,
        }
    }
    else if is_kw ts "not" {
        match parse_unary c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, e, rest] => ok (ast.unary_e :not e (ast.span_to start (ast.span e))) rest,
        }
    }
    else { parse_apply c ts }
};

/// Application is juxtaposition, and binds tighter than every operator: the
/// arguments are however many postfix expressions follow, so `fac n - 1` is
/// `(fac n) - 1`.
let rec parse_apply c ts =
    match parse_postfix c ts {
        [:error, m, s] => err m s,
        [:ok, head, rest] =>
            match gather_args c [] rest {
                [:error, m, s] => err m s,
                // The arguments arrive reversed -- each one consed in front --
                // so the head of the accumulated list is the last argument, and
                // its span closes the application's without walking the list.
                [:ok, args, rest2] =>
                    if list.is_empty args { ok head rest2 }
                    else {
                        ok (ast.apply_e head (list.reverse args)
                            (ast.span_to (ast.span head) (ast.span (list.head args)))) rest2
                    },
            },
    };

let rec gather_args c acc ts =
    if not (can_start_arg c ts) { ok acc ts }
    else {
        match parse_postfix c ts {
            [:error, m, s] => err m s,
            [:ok, a, rest] => gather_args c (core.cons a acc) rest,
        }
    };

/// Can the next token begin another argument? A keyword that cannot start an
/// expression ends the list, and so does a `{` where a brace means a block.
let can_start_arg c ts = {
    let t = peek ts;
    // The old form asked its questions through the peekers -- did the line
    // continue, then what kind, then what value -- and each question walked
    // back to the same token. The token is fetched once, here.
    if t == () { false }
    else if not (token_continues c t) { false }
    else {
        match kind_of t {
            :ident => not (is_non_starter (lexer.value t)),
            :int => true, :float => true, :str => true, :char => true, :atom => true,
            :lparen => true, :lbracket => true,
            :dollar_paren => true, :hash_bracket => true, :percent_brace => true,
            :lbrace => not (ctx_no_brace c),
            _ => false,
        }
    }
};

/// `obj.field`. A `.` at the start of a line continues the expression whatever
/// its indentation, since a line can never begin with one.
let rec parse_postfix c ts =
    match parse_primary c ts {
        [:error, m, s] => err m s,
        [:ok, e, rest] => field_tail c e rest,
    };

let rec field_tail c e ts =
    if not (at ts :dot) { ok e ts }
    else {
        let after = list.tail ts;
        // The original looked two tokens ahead through a peek that walked
        // twice; the same answer is one head on the tail.
        if at_end after { ok e ts }
        else {
            let nametok = list.head after;
            if kind_of nametok == :lbracket { parse_index c e (list.tail after) }
            else if not (kind_of nametok == :ident) { ok e ts }
            else {
                let full = ast.span_to (ast.span e)
                    (ast.span_of (lexer.span_start nametok) (lexer.span_end nametok));
                field_tail c (ast.field_e e (lexer.value nametok) full) (list.tail after)
            }
        }
    };

/// `c.[k]`, `c.[k else d]` and `c.[k => v]`: a container read at a key, read
/// with something to answer when the key is not there, and changed at a key.
/// One spelling for maps, arrays and lists, because it is one pair of
/// operations on all three -- the container decides what a key means.
///
/// The dot is what tells indexing from application: `f [0]` passes a list to
/// `f`, and `xs.[0]` reads one. Inside, the brackets group as every bracket in
/// the language does. It is postfix, so it binds as tightly as `.field` and
/// chains the same way: `grid.[y].[x]`.
let rec parse_index c e ts =
    match parse_expr (grouped c) ts {
        [:error, m, s] => err m s,
        [:ok, key, rest] =>
            if at rest :rbracket {
                field_tail c (ast.get_e e key () (ast.span_to (ast.span e) (peek_span rest)))
                           (list.tail rest)
            }
            else if is_kw rest "else" {
                index_operand c e (list.tail rest) (fn d span -> ast.get_e e key d span)
            }
            else if at rest :fat_arrow {
                index_operand c e (list.tail rest) (fn v span -> ast.set_e e key v span)
            }
            else {
                err ("expected `]`, `else` or `=>` after the key in `.[ ]`, found " + describe rest)
                    (peek_span rest)
            },
    };

/// What follows the `else` of `.[k else d]` or the `=>` of `.[k => v]`, up to
/// the closing bracket.
let rec index_operand c e ts build =
    match parse_expr (grouped c) ts {
        [:error, m, s] => err m s,
        [:ok, operand, rest] =>
            match expect rest :rbracket "`]` to close `.[`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    field_tail c (build operand (ast.span_to (ast.span e) (peek_span rest))) rest2,
            },
    };

// --- primaries --------------------------------------------------------------

let rec parse_primary c ts = {
    let t = peek ts;
    // One peek, once: kind, value and span all come from the token itself,
    // where the peekers above would each have re-walked to it.
    if t == () { err "unexpected end of file in an expression" ast.no_span }
    else {
        let sp = ast.span_of (lexer.span_start t) (lexer.span_end t);
        let rest = list.tail ts;
        match kind_of t {
            :int   => ok (ast.int_e (lexer.value t) sp) rest,
            :float => ok (ast.float_e (lexer.value t) sp) rest,
            :str   => ok (ast.str_e (lexer.value t) sp) rest,
            :char  => ok (ast.char_e (lexer.value t) sp) rest,
            :atom  => ok (ast.atom_e (lexer.value t) sp) rest,

            :lparen        => parse_paren c sp rest,
            :lbracket      => parse_sequence c sp rest :rbracket (fn items span -> ast.list_e items span) "]",
            :hash_bracket  => parse_sequence c sp rest :rbracket (fn items span -> ast.array_e items span) "]",
            :percent_brace => parse_map c sp rest,
            :dollar_paren  => parse_thunk c sp rest,
            :lbrace        => parse_block c sp rest,

            // A lexical error is the last token of a truly-bad input, and it
            // reports itself: its value is the message, its span the point.
            :error => err (lexer.value t) sp,
            :ident => parse_ident c (lexer.value t) sp rest,
            _      => err ("expected an expression, found " + describe ts) sp,
        }
    }
};

/// The keywords that begin an expression, and then plain names.
let rec parse_ident c word sp rest =
    match word {
        "true" => ok (ast.bool_e true sp) rest,
        "false" => ok (ast.bool_e false sp) rest,
        "if" => parse_if c sp rest,
        "fn" => parse_lambda c sp rest,
        "try!" => parse_try c sp rest,
        "match" => parse_match c sp rest,
        "comp" => parse_comp c false sp rest,
        "comp!" => parse_comp c true sp rest,
        "expand" => match parse_apply c rest {
            [:error, m, s] => err m s,
            [:ok, e, after] => ok (ast.expand_e e (ast.span_to sp (ast.span e))) after,
        },
        _ => if is_non_starter word {
            err ("expected an expression, found the keyword `" + word + "`") sp
        } else { ok (ast.name_e word sp) rest },
    };

/// `()` is unit; `( e )` is grouping. Inside the brackets newlines stop
/// ending statements.
let rec parse_paren c sp ts =
    if at ts :rparen { ok (ast.unit_e (ast.span_to sp (peek_span ts))) (list.tail ts) }
    else {
        match parse_expr (grouped c) ts {
            [:error, m, s] => err m s,
            [:ok, e, rest] =>
                match expect rest :rparen "`)`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] => ok e rest2,
                },
        }
    };

/// `[a, b]`, `#[a, b]` -- a comma-separated list, trailing comma allowed.
let rec parse_sequence c sp ts closer build what =
    match comma_list (grouped c) [] ts closer what {
        [:error, m, s] => err m s,
        // `comma_list` hands back the closing bracket's span as well as the
        // items, because by the time it returns the bracket has been consumed
        // and the node's span has to reach to the end of it.
        [:ok, [items, close], rest] => ok (build items (ast.span_to sp close)) rest,
    };

let rec comma_list c acc ts closer what =
    if at ts closer { ok [list.reverse acc, peek_span ts] (list.tail ts) }
    else {
        match parse_expr c ts {
            [:error, m, s] => err m s,
            [:ok, e, rest] => {
                let acc2 = core.cons e acc;
                if at rest :comma { comma_list c acc2 (list.tail rest) closer what }
                else if at rest closer { ok [list.reverse acc2, peek_span rest] (list.tail rest) }
                else { err ("expected `,` or `" + what + "`, found " + describe rest) (peek_span rest) }
            },
        }
    };

/// `%{ k => v, .. }`. Keys are forced; values stay lazy.
let rec parse_map c sp ts = map_entries (grouped c) [] ts sp;

let rec map_entries c acc ts sp =
    if at ts :rbrace { ok (ast.map_e (list.reverse acc) (ast.span_to sp (peek_span ts))) (list.tail ts) }
    else {
        match parse_expr c ts {
            [:error, m, s] => err m s,
            [:ok, k, rest] =>
                match expect rest :fat_arrow "`=>`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] =>
                        match parse_expr c rest2 {
                            [:error, m, s] => err m s,
                            [:ok, v, rest3] => {
                                let acc2 = core.cons [k, v] acc;
                                if at rest3 :comma { map_entries c acc2 (list.tail rest3) sp }
                                else if at rest3 :rbrace {
                                    ok (ast.map_e (list.reverse acc2) (ast.span_to sp (peek_span rest3)))
                                       (list.tail rest3)
                                }
                                else { err ("expected `,` or `}`, found " + describe rest3) (peek_span rest3) }
                            },
                        },
                },
        }
    };

/// `$( e )` -- suspends `e`. Newline-insensitive inside, like any bracket.
let rec parse_thunk c sp ts =
    match parse_expr (grouped c) ts {
        [:error, m, s] => err m s,
        [:ok, e, rest] =>
            match expect rest :rparen "`)` to close `$(`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] => ok (ast.thunk_e e (ast.span_to sp (ast.span e))) rest2,
            },
    };

// --- control forms ----------------------------------------------------------

/// The condition is parsed with `{` meaning a block, so the brace that follows
/// opens the branch rather than being read as one more argument.
let rec parse_if c sp ts =
    match parse_expr (no_brace c) ts {
        [:error, m, s] => err m s,
        [:ok, cond, rest] =>
            match expect rest :lbrace "`{` after the condition of an `if`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    match parse_block c (peek_span rest) rest2 {
                        [:error, m, s] => err m s,
                        [:ok, then_e, rest3] => parse_else c sp cond then_e rest3,
                    },
            },
    };

/// `else` continues the expression whatever its indentation, since a line can
/// never begin with one.
let rec parse_else c sp cond then_e ts =
    if not (is_kw ts "else") { ok (ast.if_e cond then_e () (ast.span_to sp (ast.span then_e))) ts }
    else {
        let after = list.tail ts;
        if is_kw after "if" {
            match parse_if c (peek_span after) (list.tail after) {
                [:error, m, s] => err m s,
                [:ok, chained, rest] =>
                    ok (ast.if_e cond then_e chained (ast.span_to sp (ast.span chained))) rest,
            }
        }
        else {
            match expect after :lbrace "`{` after `else`" {
                [:error, m, s] => err m s,
                [:ok, _, rest] =>
                    match parse_block c (peek_span after) rest {
                        [:error, m, s] => err m s,
                        [:ok, else_e, rest2] =>
                            ok (ast.if_e cond then_e else_e (ast.span_to sp (ast.span else_e))) rest2,
                    },
            }
        }
    };

/// `fn a b -> e`. The body runs as far as the grammar allows, so a lambda
/// passed as a non-final argument has to be parenthesised.
let rec parse_lambda c sp ts =
    match lambda_params [] ts {
        [:error, m, s] => err m s,
        [:ok, params, rest] =>
            if list.is_empty params { err "`fn` needs at least one parameter" sp }
            else {
                match parse_expr c rest {
                    [:error, m, s] => err m s,
                    [:ok, body, rest2] =>
                        ok (ast.lambda_e params body (ast.span_to sp (ast.span body))) rest2,
                }
            },
    };

let rec lambda_params acc ts =
    if at ts :arrow { ok (list.reverse acc) (list.tail ts) }
    else if at ts :ident && not (is_keyword (peek_value ts)) {
        lambda_params (core.cons (ast.param (peek_value ts) (peek_span ts)) acc) (list.tail ts)
    }
    else if at ts :lparen && peek2_kind ts == :rparen {
        // `()` -- a slot that binds no name.
        lambda_params (core.cons (ast.param () (peek_span ts)) acc) (list.tail (list.tail ts))
    }
    else if at ts :lparen {
        match paren_params acc (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, acc2, rest] => lambda_params acc2 rest,
        }
    }
    else if starts_param_pattern ts {
        match param_pattern ts {
            [:error, m, s] => err m s,
            [:ok, p, rest] => lambda_params (core.cons p acc) rest,
        }
    }
    else { err ("expected a parameter or `->`, found " + describe ts) (peek_span ts) };

/// `try! { body } catch e { handler }` -- the `catch` and its binder are both
/// required, which is what makes the error land where the `try!` is.
let rec parse_try c sp ts =
    match expect ts :lbrace "`{` after `try!`" {
        [:error, m, s] => err m s,
        [:ok, _, rest] =>
            match parse_block c sp rest {
                [:error, m, s] => err m s,
                [:ok, body, rest2] =>
                    if not (is_kw rest2 "catch") {
                        err "`try!` needs a `catch`" (peek_span rest2)
                    } else {
                        let after = list.tail rest2;
                        if not (at after :ident) {
                            err ("expected a name after `catch`, found " + describe after) (peek_span after)
                        } else {
                            let binder = peek_value after;
                            match expect (list.tail after) :lbrace "`{` after the `catch` binder" {
                                [:error, m, s] => err m s,
                                [:ok, _, rest3] =>
                                    match parse_block c sp rest3 {
                                        [:error, m, s] => err m s,
                                        [:ok, handler, rest4] =>
                                            ok (ast.try_e body binder handler
                                                          (ast.span_to sp (ast.span handler))) rest4,
                                    },
                            }
                        }
                    },
            },
    };

/// `comp e` and `comp! e`. Both bind tighter than any operator and looser than
/// application, so `comp f x` folds the whole call.
let rec parse_comp c impure sp ts =
    match parse_apply c ts {
        [:error, m, s] => err m s,
        [:ok, e, rest] => ok (ast.comp_e impure e (ast.span_to sp (ast.span e))) rest,
    };

// --- blocks -----------------------------------------------------------------
//
// A block is newline-sensitive: a line break ends a statement, and its value
// is the last statement, or `()` when it is empty. A block may hold `let`
// declarations, which scope to the statements after them.

let rec parse_block c sp ts = block_stmts (allow_brace (ctx true (ctx_no_brace c) (ctx_indent c))) [] ts sp;

let rec block_stmts c acc ts sp =
    if at ts :semi { block_stmts c acc (list.tail ts) sp }
    else if at ts :rbrace {
        ok (ast.block_e (list.reverse acc) (ast.span_to sp (peek_span ts))) (list.tail ts)
    }
    else if at_end ts { err "unterminated block: expected `}`" sp }
    else {
        match parse_statement (at_statement c ts) ts {
            [:error, m, s] => err m s,
            [:ok, st, rest] => block_stmts c (core.cons st acc) rest sp,
        }
    };

/// A statement is a `let` declaration or an expression.
let rec parse_statement c ts =
    if is_kw ts "let" { parse_let c (peek_span ts) (list.tail ts) }
    else if is_kw ts "type" { parse_type c (peek_span ts) (list.tail ts) }
    else { parse_expr c ts };

/// `let name params = body`, with `rec` optional. A block-local `let` that
/// refers to itself needs `rec`; a top-level one does not, because every
/// top-level binding is a global and they are all mutually visible.
let rec parse_let c sp ts = {
    let is_rec = is_kw ts "rec";
    let after_rec = if is_rec { list.tail ts } else { ts };
    if starts_let_pattern after_rec {
        if is_rec {
            err "a destructuring `let` cannot be `rec`: it has no one name to refer to itself by"
                (peek_span ts)
        }
        else { parse_let_pattern c sp after_rec }
    }
    else if not (at after_rec :ident) {
        err ("expected a name after `let`, found " + describe after_rec) (peek_span after_rec)
    }
    else if is_keyword (peek_value after_rec) {
        err ("`" + to_string (peek_value after_rec) + "` is a keyword and cannot be a name")
            (peek_span after_rec)
    }
    else {
        let name = peek_value after_rec;
        match let_params c [] (list.tail after_rec) {
            [:error, m, s] => err m s,
            [:ok, params, rest] =>
                match expect rest :eq "`=` in a `let`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] =>
                        match parse_expr c rest2 {
                            [:error, m, s] => err m s,
                            [:ok, body, rest3] =>
                                ok (ast.let_d name params body is_rec (ast.span_to sp (ast.span body)))
                                   rest3,
                        },
                },
        }
    }
};

// --- type expressions -------------------------------------------------------
//
// A type is written in a grammar of its own, and the reason is the one thing
// that decides the whole design: a description is *data*, and the data it is
// made of is lists, maps and atoms -- exactly what a list, map and atom
// literal already mean. So `[:integer]` cannot be both "the list holding the
// atom `:integer`" and "a list of integers" in the same grammar, and the two
// are told apart by where they are written rather than by how they look.
// Inside a `type` declaration and after a record field's `:`, the forms below
// build a description; everywhere else a bracket is still a list.
//
// What the parser emits is the same tagged data `std.types` constructs at run
// time, so nothing downstream knows a written type from a built one and the
// two cannot disagree about what a description means.
//
//     :integer -> :integer -> :integer     [:fn, :integer, [:fn, ..]]
//     :integer | :float                    [:union, [:integer, :float]]
//     [:integer]                           [:list_of, :integer]
//     [:ok, value]                         [:tuple, [:ok, value]]
//     #[:float]                            [:array_of, :float]
//     %{:string => :integer}               [:map_of, :string, :integer]
//     %{:host => :string}                  [:record, %{:host => :string}]
//     :integer where fn n -> n > 0         [:refine, :integer, <fn>]
//
// Atoms pass straight through, and the parser deliberately keeps no list of
// which ones name a primitive: `std.types` answers that, so the spelling of
// `:integer` is decided in exactly one place. An atom that is not a primitive
// is a literal, which is what makes `[:ok, value]` and `:one_for_one |
// :one_for_all` mean what they look like.

/// A description of a kind the parser builds: `[tag, ..parts]`, as a list
/// expression, which is what `std.types` would have returned.
priv let tagged tag parts span = ast.list_e (core.cons (ast.atom_e tag span) parts) span;

/// The whole of a type. `where` is last so that it refines everything in
/// front of it, and its predicate is an *ordinary* expression -- a type
/// grammar has no way to say `fn n -> n >= 0 && n <= 255`, and should not.
let rec parse_type_expr c ts =
    match parse_type_arrow c ts {
        [:error, m, s] => err m s,
        [:ok, base, rest] =>
            if not (is_kw rest "where") { ok base rest }
            else {
                match parse_expr c (list.tail rest) {
                    [:error, m, s] => err m s,
                    [:ok, predicate, rest2] =>
                        ok (tagged "refine" [base, predicate]
                                   (ast.span_to (ast.span base) (ast.span predicate))) rest2,
                }
            },
    };

/// `a -> b`, right-associative, so `a -> b -> c` is a function of one
/// argument answering a function of one argument -- which is what a curried
/// language means by it, and what `:integer -> :integer -> :integer` says
/// about a two-argument `min`.
let rec parse_type_arrow c ts =
    match parse_type_union c ts {
        [:error, m, s] => err m s,
        [:ok, l, rest] =>
            if not (at rest :arrow) { ok l rest }
            else {
                match parse_type_arrow c (list.tail rest) {
                    [:error, m, s] => err m s,
                    [:ok, r, rest2] =>
                        ok (tagged "fn" [l, r] (ast.span_to (ast.span l) (ast.span r))) rest2,
                }
            },
    };

/// `a | b | c`, flattened into one union rather than nested pairs: a union of
/// unions accepts the same values, and one list is what a reader of the data
/// and `accepts` both expect to find.
let rec parse_type_union c ts =
    match parse_type_apply c ts {
        [:error, m, s] => err m s,
        [:ok, first, rest] =>
            if not (at rest :bar) { ok first rest }
            else { type_union_tail c [first] rest },
    };

let rec type_union_tail c acc ts =
    if not (at ts :bar) {
        let parts = list.reverse acc;
        let span = ast.span_to (ast.span (list.head parts)) (ast.span (list.head acc));
        ok (tagged "union" [ast.list_e parts span] span) ts
    }
    else {
        match parse_type_apply c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, part, rest] => type_union_tail c (core.cons part acc) rest,
        }
    };

/// Application, as everywhere else in the language: `List :integer` calls the
/// type function `List`. Its arguments are types, which is what makes a
/// parameterised type read like the thing it describes.
let rec parse_type_apply c ts =
    match parse_type_postfix c ts {
        [:error, m, s] => err m s,
        [:ok, head, rest] =>
            match gather_type_args c [] rest {
                [:error, m, s] => err m s,
                [:ok, args, rest2] =>
                    if list.is_empty args { ok head rest2 }
                    else {
                        ok (ast.apply_e head (list.reverse args)
                            (ast.span_to (ast.span head) (ast.span (list.head args)))) rest2
                    },
            },
    };

let rec gather_type_args c acc ts =
    if not (type_starts_arg c ts) { ok acc ts }
    else {
        match parse_type_postfix c ts {
            [:error, m, s] => err m s,
            [:ok, a, rest] => gather_type_args c (core.cons a acc) rest,
        }
    };

/// What can begin another argument. `where` has to end the list even though
/// it is an ordinary identifier: it is contextual, so that a program is still
/// free to bind the name everywhere a type is not being written.
let type_starts_arg c ts = {
    let t = peek ts;
    if t == () { false }
    else if not (token_continues c t) { false }
    else {
        match kind_of t {
            :ident => not (is_non_starter (lexer.value t)) && lexer.value t != "where",
            :int => true, :float => true, :str => true, :char => true, :atom => true,
            :lparen => true, :lbracket => true,
            :hash_bracket => true, :percent_brace => true,
            _ => false,
        }
    }
};

let rec parse_type_postfix c ts =
    match parse_type_primary c ts {
        [:error, m, s] => err m s,
        [:ok, e, rest] => type_field_tail c e rest,
    };

/// `types.list_of` and the like: a dotted name reaches a type in another
/// module, and means there exactly what it means in an expression.
let rec type_field_tail c e ts =
    if not (at ts :dot) { ok e ts }
    else {
        let after = list.tail ts;
        if at_end after { ok e ts }
        else if not (kind_of (list.head after) == :ident) { ok e ts }
        else {
            let nametok = list.head after;
            type_field_tail c (ast.field_e e (lexer.value nametok)
                                              (ast.span_to (ast.span e) (lexer.span nametok)))
                              (list.tail after)
        }
    };

/// The atoms that name a kind of value rather than a value. `std.types` holds
/// the same list, and it is the authority -- membership is its question, and
/// answering it here as well would be two places to add a type to.
///
/// What the parser needs it for is one narrower question, asked in exactly one
/// place: whether the key of a `%{ .. }` is a *type* (`%{:string => :integer}`,
/// a map keyed by strings) or a *literal* (`%{:host => :string}`, a record with
/// a field called `:host`). Both are written with the same bracket because
/// both are maps, and what tells them apart is whether the key names a kind.
priv let primitive_atoms = [
    "any", "never",
    "integer", "float", "char", "bool", "unit", "string", "atom",
    "list", "array", "map", "module", "error", "process",
    "pure_fn", "impure_fn", "bigstr",
];

priv let primitive_atom_set = comp set_of primitive_atoms;

/// A single token that stands for a value, which is what a record's key is.
/// A primitive atom is not one: `:string` names every string, and a map whose
/// keys are strings is what `%{:string => :integer}` should mean.
let type_key_is_literal ts =
    match peek_kind ts {
        :atom => not (core.map_has primitive_atom_set (peek_value ts)),
        :str => true, :int => true, :char => true,
        _ => false,
    };

let rec parse_type_primary c ts = {
    let sp = peek_span ts;
    if at_end ts { err "expected a type" sp }
    else {
        match peek_kind ts {
            // A literal stands for itself: `:ok` accepts the atom `:ok`, and
            // `1` the integer 1. `std.types` compares with `==`, so nothing
            // here has to know which literals there are.
            :atom => ok (ast.atom_e (peek_value ts) sp) (list.tail ts),
            :int => ok (ast.int_e (peek_value ts) sp) (list.tail ts),
            :float => ok (ast.float_e (peek_value ts) sp) (list.tail ts),
            :str => ok (ast.str_e (peek_value ts) sp) (list.tail ts),
            :char => ok (ast.char_e (peek_value ts) sp) (list.tail ts),
            :lbracket => parse_type_list c sp (list.tail ts),
            :hash_bracket => parse_type_array c sp (list.tail ts),
            :percent_brace => parse_type_map c sp (list.tail ts),
            :lparen => parse_type_paren c sp (list.tail ts),
            :ident =>
                if peek_value ts == "true" || peek_value ts == "false" {
                    ok (ast.bool_e (peek_value ts == "true") sp) (list.tail ts)
                }
                else if is_keyword (peek_value ts) {
                    err ("`" + to_string (peek_value ts) + "` is a keyword and cannot be a type") sp
                }
                else { ok (ast.name_e (peek_value ts) sp) (list.tail ts) },
            _ => err ("expected a type, found " + describe ts) sp,
        }
    }
};

/// `( t )` groups, and `()` is the unit value -- which as a type accepts
/// exactly unit, the same as `:unit`.
let rec parse_type_paren c sp ts =
    if at ts :rparen { ok (ast.unit_e (ast.span_to sp (peek_span ts))) (list.tail ts) }
    else {
        match parse_type_expr (grouped c) ts {
            [:error, m, s] => err m s,
            [:ok, t, rest] =>
                match expect rest :rparen "`)`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] => ok t rest2,
                },
        }
    };

/// `[t]` is a list of `t`, of any length; `[a, b]` is a list of exactly two
/// elements, the first an `a` and the second a `b`. The two readings are the
/// same question asked of a different number of elements, and between them
/// they cover what a list is used for: a homogeneous sequence, and a tagged
/// tuple -- `[:ok, value]` says what it looks like it says.
///
/// What cannot be written is a one-element tuple, since `[t]` has been spent
/// on the commoner meaning. `types.tuple [t]` is that, spelled out.
let rec parse_type_list c sp ts =
    match type_comma_list c [] ts :rbracket "]" {
        [:error, m, s] => err m s,
        [:ok, [items, close], rest] => {
            let span = ast.span_to sp close;
            match items {
                [only] => ok (tagged "list_of" [only] span) rest,
                _ => ok (tagged "tuple" [ast.list_e items span] span) rest,
            }
        },
    };

/// `#[t]` and `#[a, b]`, which are to an array what the brackets above are to
/// a list.
let rec parse_type_array c sp ts =
    match type_comma_list c [] ts :rbracket "]" {
        [:error, m, s] => err m s,
        [:ok, [items, close], rest] => {
            let span = ast.span_to sp close;
            match items {
                [only] => ok (tagged "array_of" [only] span) rest,
                _ => ok (tagged "array" [ast.list_e items span] span) rest,
            }
        },
    };

let rec type_comma_list c acc ts closer what =
    if at ts closer { ok [list.reverse acc, peek_span ts] (list.tail ts) }
    else {
        match parse_type_expr (grouped c) ts {
            [:error, m, s] => err m s,
            [:ok, t, rest] => {
                let acc2 = core.cons t acc;
                if at rest :comma { type_comma_list c acc2 (list.tail rest) closer what }
                else if at rest closer { ok [list.reverse acc2, peek_span rest] (list.tail rest) }
                else { err ("expected `,` or `" + what + "`, found " + describe rest) (peek_span rest) }
            },
        }
    };

/// `%{ k => v }` is a map, and which map depends on what the key is.
///
///     %{:string => :integer}     every key a string, every value an integer
///     %{:host => :string}        a record: the key `:host` must be there
///
/// The question is settled by the first key alone, because a map that mixed
/// the two would have no reading anybody could predict; a later key of the
/// wrong sort is an error rather than a second rule.
let rec parse_type_map c sp ts =
    if at ts :rbrace {
        ok (tagged "record" [ast.map_e [] (ast.span_to sp (peek_span ts))]
                   (ast.span_to sp (peek_span ts)))
           (list.tail ts)
    }
    else if type_key_is_literal ts { parse_type_record c sp [] ts }
    else { parse_type_map_of c sp ts };

let rec parse_type_map_of c sp ts =
    match type_map_pair (grouped c) ts {
        [:error, m, s] => err m s,
        [:ok, [k, v], rest] =>
            if at rest :comma && not (at (list.tail rest) :rbrace) {
                err "a map type describes all of its keys with one `=>`; a map with more than one key is a record, whose keys are literals"
                    (peek_span rest)
            }
            else {
                let after = if at rest :comma { list.tail rest } else { rest };
                match expect after :rbrace "`}`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] =>
                        ok (tagged "map_of" [k, v] (ast.span_to sp (peek_span after))) rest2,
                }
            },
    };

let rec parse_type_record c sp acc ts =
    if at ts :rbrace {
        let span = ast.span_to sp (peek_span ts);
        ok (tagged "record" [ast.map_e (list.reverse acc) span] span) (list.tail ts)
    }
    else if not (type_key_is_literal ts) {
        err ("a record type's keys are literals, and this one is not: " + describe ts) (peek_span ts)
    }
    else {
        match type_map_pair (grouped c) ts {
            [:error, m, s] => err m s,
            [:ok, pair, rest] => {
                let acc2 = core.cons pair acc;
                if at rest :comma { parse_type_record c sp acc2 (list.tail rest) }
                else if at rest :rbrace {
                    let span = ast.span_to sp (peek_span rest);
                    ok (tagged "record" [ast.map_e (list.reverse acc2) span] span) (list.tail rest)
                }
                else { err ("expected `,` or `}`, found " + describe rest) (peek_span rest) }
            },
        }
    };

let rec type_map_pair c ts =
    match parse_type_expr c ts {
        [:error, m, s] => err m s,
        [:ok, k, rest] =>
            match expect rest :fat_arrow "`=>`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    match parse_type_expr c rest2 {
                        [:error, m, s] => err m s,
                        [:ok, v, rest3] => ok [k, v] rest3,
                    },
            },
    };

/// `type Name params = description`, which is a `let` whose body is written
/// in the type grammar above and whose value is the description it builds,
/// under its own name. Rewriting it here rather than giving types a
/// declaration of their own is what makes imports, privacy, currying, local
/// capture and `comp` obey exactly the rules a `let` already obeys -- a type
/// is a value, and the only thing `type` adds is how its right-hand side is
/// read and that the result remembers what it is called.
///
/// The name is recorded so that a failed check can say which type was
/// expected rather than quoting the data it expanded to.
let parse_type c sp ts =
    if not (at ts :ident) || is_keyword (peek_value ts) {
        err "expected a name after `type`" (peek_span ts)
    } else if str.ends_with "!" (peek_value ts) {
        err "a type name must be pure" (peek_span ts)
    } else {
        let name = peek_value ts;
        match let_params c [] (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, params, rest] =>
                match expect rest :eq "`=` in a `type`" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] =>
                        match parse_type_expr c rest2 {
                            [:error, m, s] => err m s,
                            [:ok, description, rest3] => {
                                let span = ast.span_to sp (ast.span description);
                                ok (ast.let_d name params
                                    (ast.list_e [ast.atom_e "named" sp, ast.str_e name sp,
                                                 description] span)
                                    false span) rest3
                            },
                        },
                },
        }
    };

/// What can begin the pattern of a destructuring `let`: a list, an array or a
/// map, or a parenthesised pattern.
let starts_let_pattern ts =
    at ts :lbracket || at ts :hash_bracket || at ts :percent_brace || at ts :lparen;

/// `let [a, b] = pair`. Only the shape is read here. Which patterns a `let` may
/// take is resolution's question, because a pattern that could fail to match
/// has more to say about itself than a parse error can.
let rec parse_let_pattern c sp ts =
    match parse_pattern (grouped c) ts {
        [:error, m, s] => err m s,
        [:ok, pattern, rest] =>
            match expect rest :eq "`=` after the pattern of a `let`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    match parse_expr c rest2 {
                        [:error, m, s] => err m s,
                        [:ok, body, rest3] =>
                            ok (ast.let_pattern_d pattern body (ast.span_to sp (ast.span body))) rest3,
                    },
            },
    };

/// Parameters, up to whatever follows them. It stops rather than complaining,
/// because what may legally follow depends on the caller: a `let` wants `=`,
/// but `virtual let fold f init xs;` has no body at all and ends at the `;`.
///
/// Three spellings are accepted, and only the first is in the language
/// reference. `f a b` is juxtaposition, the one everything is written in.
/// `f ()` is a slot that occupies a position but binds no name. `f (a, b)` is
/// a parenthesised list, which the reference does not mention at all -- but
/// the Rust parser takes it, so a file that uses it compiles today and has to
/// keep compiling.
///
/// Any of them may hold a pattern -- `f [a, b]`, `f %{ :k => v }` -- which
/// takes its argument apart. An `as` around one is written inside the
/// parenthesised list, `f ([a, b] as pair)`, where the brackets say where it
/// ends; in a row of juxtaposed parameters nothing would.
///
/// The context is consulted for the same reason every other optional
/// continuation consults it: an identifier on the next line may be the next
/// declaration rather than one more parameter of this one. A `let` never
/// noticed, because what follows its parameters is `=` and a `let` with a
/// missing one is an error either way -- but a record body is a list whose
/// entries may be bare names, so `name` and `age` on two lines have to be two
/// fields and not one field of one parameter.
let rec let_params c acc ts =
    if at_end ts || not (token_continues c (list.head ts)) { ok (list.reverse acc) ts }
    else if at ts :ident && not (is_keyword (peek_value ts)) {
        let_params c (core.cons (ast.param (peek_value ts) (peek_span ts)) acc) (list.tail ts)
    }
    else if at ts :lparen && peek2_kind ts == :rparen {
        let_params c (core.cons (ast.param () (peek_span ts)) acc) (list.tail (list.tail ts))
    }
    else if at ts :lparen {
        match paren_params acc (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, acc2, rest] => let_params c acc2 rest,
        }
    }
    else if starts_param_pattern ts {
        match param_pattern ts {
            [:error, m, s] => err m s,
            [:ok, p, rest] => let_params c (core.cons p acc) rest,
        }
    }
    else { ok (list.reverse acc) ts };

/// Can this token begin a parameter that is a pattern? Only a bracketed shape:
/// a name is already a parameter, and a `(` is the parenthesised list.
let starts_param_pattern ts = at ts :lbracket || at ts :hash_bracket || at ts :percent_brace;

/// A parameter that takes its argument apart: `[a, b]`, `#[a, b]`, `%{ :k => v }`.
let rec param_pattern ts =
    match parse_pattern_atom (grouped top) ts {
        [:error, m, s] => err m s,
        [:ok, p, rest] => ok (ast.pattern_param p (ast.span p)) rest,
    };

/// The inside of `(a, b, c)`, already past the `(`. Each element is a pattern,
/// and a name or `_` is the parameter it always was.
let rec paren_params acc ts =
    match parse_pattern (grouped top) ts {
        [:error, m, s] => err m s,
        [:ok, p, rest] => {
            let acc2 = core.cons (param_of p) acc;
            if at rest :comma { paren_params acc2 (list.tail rest) }
            else if at rest :rparen { ok acc2 (list.tail rest) }
            else { err ("expected `,` or `)` in a parameter list, found " + describe rest) (peek_span rest) }
        },
    };

let param_of p =
    match p {
        [:bind, n, sp]  => ast.param n sp,
        [:wildcard, sp] => ast.param "_" sp,
        _ => ast.pattern_param p (ast.span p),
    };

// --- match ------------------------------------------------------------------
//
// Arms are tried in source order and the first that matches wins. `=>` is
// already the map separator and `{ }` already delimits every other control
// form, so `match` introduces no new punctuation.

let rec parse_match c sp ts =
    match parse_expr (no_brace c) ts {
        [:error, m, s] => err m s,
        [:ok, scrutinee, rest] =>
            match expect rest :lbrace "`{` after the subject of a `match`" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    match match_arms (grouped c) [] rest2 {
                        [:error, m, s] => err m s,
                        // As `comma_list` does, and for the same reason: the
                        // closing brace is consumed by the time the arms come
                        // back, and a `match` that does not reach the end of
                        // its own last arm is a declaration whose span stops
                        // at its first one -- which is what a `let f = match
                        // ..` is. See `match_arms`.
                        [:ok, [arms, close], rest3] =>
                            if list.is_empty arms { err "a `match` needs at least one arm" sp }
                            else { ok (ast.match_e scrutinee arms (ast.span_to sp close)) rest3 },
                    },
            },
    };

/// The arms and the span of the `}` that ended them.
///
/// The brace is handed back for the reason `comma_list` gives: it is consumed
/// here, and the `match` node's span has to reach the end of it. It used to
/// end at the *first* token after the `{` instead, which made every `let f =
/// match ..` a declaration whose span covered its header and nothing else --
/// invisible to anything that asks which declaration an offset is in, which
/// is macro discovery, the outline, hover and go-to-definition.
let rec match_arms c acc ts =
    if at ts :rbrace { ok [list.reverse acc, peek_span ts] (list.tail ts) }
    else if at_end ts { err "unterminated `match`: expected `}`" (peek_span ts) }
    else {
        match parse_pattern c ts {
            [:error, m, s] => err m s,
            [:ok, pat, rest] =>
                match arm_guard_and_body c pat rest {
                    [:error, m, s] => err m s,
                    [:ok, a, rest2] => {
                        let acc2 = core.cons a acc;
                        if at rest2 :comma { match_arms c acc2 (list.tail rest2) }
                        else if at rest2 :rbrace { ok [list.reverse acc2, peek_span rest2] (list.tail rest2) }
                        else { err ("expected `,` or `}` after a match arm, found " + describe rest2)
                                   (peek_span rest2) }
                    },
                },
        }
    };

/// `pattern if guard => body`. The guard runs only after the pattern matched,
/// so it can use what the pattern bound.
let rec arm_guard_and_body c pat ts = {
    let guarded = is_kw ts "if";
    match (if guarded { parse_expr (no_brace c) (list.tail ts) } else { ok () ts }) {
        [:error, m, s] => err m s,
        [:ok, guard, rest] =>
            match expect rest :fat_arrow "`=>` in a match arm" {
                [:error, m, s] => err m s,
                [:ok, _, rest2] =>
                    match parse_expr c rest2 {
                        [:error, m, s] => err m s,
                        [:ok, body, rest3] =>
                            ok (ast.arm pat guard body (ast.span_to (ast.span pat) (ast.span body))) rest3,
                    },
            },
    }
};

// --- patterns ---------------------------------------------------------------

let rec parse_pattern c ts =
    match parse_pattern_atom c ts {
        [:error, m, s] => err m s,
        [:ok, p, rest] =>
            // `p as name` binds the whole value as well as its parts.
            if not (is_kw rest "as") { ok p rest }
            else {
                let after = list.tail rest;
                if not (at after :ident) {
                    err ("expected a name after `as`, found " + describe after) (peek_span after)
                } else {
                    ok (ast.as_p p (peek_value after) (peek_span after)
                                 (ast.span_to (ast.span p) (peek_span after)))
                       (list.tail after)
                }
            },
    };

let rec parse_pattern_atom c ts = {
    let t = peek ts;
    if t == () { err "unexpected end of file in a pattern" ast.no_span }
    else {
        let sp = ast.span_of (lexer.span_start t) (lexer.span_end t);
        let rest = list.tail ts;
        match kind_of t {
            :int   => ok (ast.literal_p (ast.int_e (lexer.value t) sp) sp) rest,
            :float => ok (ast.literal_p (ast.float_e (lexer.value t) sp) sp) rest,
            :str   => ok (ast.literal_p (ast.str_e (lexer.value t) sp) sp) rest,
            :char  => ok (ast.literal_p (ast.char_e (lexer.value t) sp) sp) rest,
            :atom  => ok (ast.literal_p (ast.atom_e (lexer.value t) sp) sp) rest,
            :minus =>
                // A negative number literal: `-1` is one pattern, not an operator.
                match peek rest {
                    () => err "expected a number after `-` in a pattern" sp,
                    m =>
                        if kind_of m == :int {
                            ok (ast.literal_p (ast.int_e (0 - lexer.value m) sp) sp) (list.tail rest)
                        } else if kind_of m == :float {
                            ok (ast.literal_p (ast.float_e (0.0 - lexer.value m) sp) sp) (list.tail rest)
                        } else { err "expected a number after `-` in a pattern" sp },
                },
            :lparen =>
                match peek rest {
                    () => err "expected a pattern after `(`" sp,
                    m =>
                        if kind_of m == :rparen { ok (ast.literal_p (ast.unit_e sp) sp) (list.tail rest) }
                        else {
                            // `( p )` only groups. It is how an `as` is written
                            // where its end would otherwise be unclear -- in a
                            // parameter list, or around one element of a list.
                            match parse_pattern (grouped c) rest {
                                [:error, m2, s] => err m2 s,
                                [:ok, p, rest2] =>
                                    match expect rest2 :rparen "`)` to close a pattern" {
                                        [:error, m2, s] => err m2 s,
                                        [:ok, _, rest3] => ok p rest3,
                                    },
                            }
                        },
                },
            :lbracket     => pattern_sequence c sp rest :rbracket (fn i r s -> ast.list_p i r s) "]",
            :hash_bracket => pattern_sequence c sp rest :rbracket (fn i r s -> ast.array_p i r s) "]",
            :percent_brace => pattern_map c sp rest,
            :ident =>
                if lexer.value t == "true"  { ok (ast.literal_p (ast.bool_e true sp) sp) rest }
                else if lexer.value t == "false" { ok (ast.literal_p (ast.bool_e false sp) sp) rest }
                else if lexer.value t == "_" { ok (ast.wildcard_p sp) rest }
                else if is_keyword (lexer.value t) {
                    err ("`" + to_string (lexer.value t) + "` is a keyword and cannot be a binding") sp
                }
                else { ok (ast.bind_p (lexer.value t) sp) rest },
            :error => err (lexer.value t) sp,
            _ => err ("expected a pattern, found " + describe ts) sp,
        }
    }
};

/// `[a, b]`, `[x, ..rest]`, `[x, ..]`. The rest is `()` when the length is
/// fixed, `[name]` when it is bound, and `[()]` when it is ignored.
let rec pattern_sequence c sp ts closer build what = pattern_items c [] ts closer build what sp;

let rec pattern_items c acc ts closer build what sp =
    if at ts closer { ok (build (list.reverse acc) () (ast.span_to sp (peek_span ts))) (list.tail ts) }
    else if at ts :dot_dot {
        let after = list.tail ts;
        let named = at after :ident && not (is_keyword (peek_value after));
        let rest_binding = if named { [peek_value after, peek_span after] } else { [()] };
        let after2 = if named { list.tail after } else { after };
        if at after2 closer {
            ok (build (list.reverse acc) rest_binding (ast.span_to sp (peek_span after2)))
               (list.tail after2)
        }
        else { err ("expected `" + what + "` after `..`, found " + describe after2) (peek_span after2) }
    }
    else {
        match parse_pattern c ts {
            [:error, m, s] => err m s,
            [:ok, p, rest] => {
                let acc2 = core.cons p acc;
                if at rest :comma { pattern_items c acc2 (list.tail rest) closer build what sp }
                else if at rest closer {
                    ok (build (list.reverse acc2) () (ast.span_to sp (peek_span rest))) (list.tail rest)
                }
                else { err ("expected `,` or `" + what + "`, found " + describe rest) (peek_span rest) }
            },
        }
    };

/// `%{ :k => p }` -- keys the pattern does not mention are ignored.
let rec pattern_map c sp ts = pattern_map_entries c [] ts sp;

let rec pattern_map_entries c acc ts sp =
    if at ts :rbrace { ok (ast.map_p (list.reverse acc) (ast.span_to sp (peek_span ts))) (list.tail ts) }
    else {
        match parse_expr c ts {
            [:error, m, s] => err m s,
            [:ok, k, rest] =>
                match expect rest :fat_arrow "`=>` in a map pattern" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] =>
                        match parse_pattern c rest2 {
                            [:error, m, s] => err m s,
                            [:ok, p, rest3] => {
                                let acc2 = core.cons [k, p] acc;
                                if at rest3 :comma { pattern_map_entries c acc2 (list.tail rest3) sp }
                                else if at rest3 :rbrace {
                                    ok (ast.map_p (list.reverse acc2) (ast.span_to sp (peek_span rest3)))
                                       (list.tail rest3)
                                }
                                else { err ("expected `,` or `}`, found " + describe rest3) (peek_span rest3) }
                            },
                        },
                },
        }
    };

// --- the entry point --------------------------------------------------------

/// Parse one expression from source text. `[:ok, expr]` or
/// `[:error, message, span]`.
///
/// The lexer's stream already knows its errors: they are tokens, and every one
/// arrives last. So there is nothing to pre-scan for -- the parse reports one
/// the moment it reaches it, at an expression or pattern position. Walking the
/// whole stream once for a lookup that the walk beneath already performs was
/// five percent of a compile.
let parse_expression src =
    match parse_expr top (lexer.tokens src) {
        [:error, m, s] => err m s,
        [:ok, e, rest] =>
            if at_end rest { [:ok, e] }
            else { err ("unexpected " + describe rest + " after the expression") (peek_span rest) },
        _ => err "the lexer answered something unexpected" ast.no_span,
    };

// --- module items -----------------------------------------------------------
//
// What a file holds, and what a `mod` block holds -- they are the same list,
// which is not a coincidence: the loader registers `mod util { .. }` inside
// module `m` as the module `m.util`, so from that point on a submodule and a
// file are the same thing to every later pass.

let rec parse_item c ts = {
    let sp = peek_span ts;
    match peek_kind ts {
        :error => err (peek_value ts) sp,
        :ident => match peek_value ts {
            "import" => parse_import c sp (list.tail ts),
            "mod" => parse_mod c sp (list.tail ts),
            "derive" => parse_derive c sp (list.tail ts),
            "virtual" => parse_virtual c sp (list.tail ts),
            "when" => parse_when c sp (list.tail ts),
            "let" => parse_let c sp (list.tail ts),
            "type" => parse_type c sp (list.tail ts),
            "priv" => {
                let rest = list.tail ts;
                if not (is_kw rest "let") && not (is_kw rest "type") {
                    err "expected `let` or `type` after `priv`" (peek_span rest)
                }
                else { match (if is_kw rest "type" { parse_type c sp (list.tail rest) }
                              else { parse_let c sp (list.tail rest) }) {
                    [:ok, d, after] => ok (ast.priv_d d (ast.span d)) after,
                    other => other,
                } }
            },
            "macro" => match parse_let c sp (list.tail ts) {
                [:ok, [:let, n, ps, body, _, span], rest] =>
                    ok (ast.macro_d n ps body span) rest,
                [:ok, _, _] => err "a macro needs a name" sp,
                other => other,
            },
            "group" => parse_record c :list sp (list.tail ts),
            "struct" => parse_record c :array sp (list.tail ts),
            "mapping" => parse_record c :map sp (list.tail ts),
            _ => err ("expected `import`, `derive`, `virtual`, `mod`, `when`, `let`, `priv let`, `macro`, `group`, `struct`, `mapping` or `type` at the top level, found "
                      + describe ts) sp,
        },
        _ => err ("expected a declaration, found " + describe ts) sp,
    }
};

let rec parse_record c kind sp ts =
    if not (at ts :ident) || is_keyword (peek_value ts) {
        err "expected a record name" (peek_span ts)
    } else {
        let name = peek_value ts;
        match record_base c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, bases, after_base] =>
                match expect after_base :lbrace "`{` before the record body" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest] =>
                        match record_body (ctx true false (ctx_indent c)) kind name sp [] [] rest {
                            [:ok, [:record, k, n, fs, ms, _, span], after] =>
                                ok [:record, k, n, fs, ms, bases, span] after,
                            other => other,
                        },
                },
        }
    };

/// A record specializes a behavior just as an ordinary module does.
let record_base c ts =
    if is_kw ts "derive" {
        match parse_derive c (peek_span ts) (list.tail ts) {
            [:ok, d, rest] => ok [d] rest,
            other => other,
        }
    } else { ok [] ts };

/// A record body is a list of entries, and it is newline-sensitive for the
/// same reason a block is: an entry may be a function definition, and nobody
/// writing one wants to end it with a comma. So `,` separates entries where it
/// is written and a line break separates them where it is not -- exactly what
/// `;` and a line break do between the statements of a block, and the code
/// below is `block_stmts` with `,` in place of `;`.
///
/// Each entry is parsed at its own column, so a default or a member's body may
/// run over as many lines as it is indented past.
let rec record_body c kind name sp fields members ts =
    if at ts :comma { record_body c kind name sp fields members (list.tail ts) }
    else if at ts :rbrace {
        ok (ast.record_d kind name (list.reverse fields) (list.reverse members)
                         (ast.span_to sp (peek_span ts))) (list.tail ts)
    }
    else if at_end ts { err ("unterminated `" + record_keyword kind + "`: expected `}`") sp }
    else {
        match record_entry (at_statement c ts) name fields members ts {
            [:error, m, s] => err m s,
            [:ok, [:field, f], rest] =>
                record_body c kind name sp (core.cons f fields) members rest,
            [:ok, [:member, m], rest] =>
                record_body c kind name sp fields (core.cons m members) rest,
        }
    };

/// The keyword a backing kind was written with, for a diagnostic that quotes
/// what the reader typed rather than what the compiler made of it.
let record_keyword kind = match kind { :list => "group", :array => "struct", :map => "mapping" };

/// One entry: a field, a field with a default, or a member.
///
/// What tells them apart is whether anything was written between the name and
/// the `=`. `x = 0` is a field whose accessor falls back to `0`; `f self = 0`
/// is a function of one parameter, and a field could not be, because a field
/// is a place in a collection and places do not take arguments. So the
/// parameters are parsed first and the answer follows from whether there were
/// any -- no lookahead for `=`, and no keyword to introduce either form.
let rec record_entry c name fields members ts =
    if not (at ts :ident) {
        err ("expected a field, a member or `}` in `" + name + "`, found " + describe ts) (peek_span ts)
    } else if is_keyword (peek_value ts) {
        err ("`" + to_string (peek_value ts) + "` is a keyword and cannot name a field or a member")
            (peek_span ts)
    } else {
        let entry = peek_value ts;
        let at_name = peek_span ts;
        match let_params c [] (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, params, rest] =>
                if list.is_empty params { record_field_entry c name fields members entry at_name rest }
                else { record_member_entry c name fields members entry at_name params rest }
        }
    };

/// A field, which may be given a default: what reading it answers when the
/// collection has nothing at that key or position.
let record_field_entry c name fields members entry at_name ts =
    if at ts :colon {
        match parse_type_expr c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, description, rest] =>
                match record_field_default c name fields members entry at_name rest {
                    [:ok, [:field, f], after] => ok [:field, f + [description]] after,
                    other => other,
                },
        }
    } else { record_field_default c name fields members entry at_name ts };

let record_field_default c name fields members entry at_name ts =
    if str.ends_with "!" entry {
        err "a record field must be a plain name: `!` marks a name impure, and reading a field is pure"
            at_name
    } else if taken name fields members entry || taken name fields members ("set_" + entry) {
        err ("record field `" + entry + "` conflicts with a generated helper") at_name
    } else { match peek_kind ts {
        :eq => match parse_expr c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, e, after] =>
                if names_something e {
                    err ("a record field's default may not name anything: it is "
                         + "compiled inside the module `" + name + "` becomes, which "
                         + "cannot see the one it is written in") (ast.span e)
                } else {
                    ok [:field, ast.record_field (ast.param entry at_name) e] after
                },
        },
        _ => ok [:field, ast.record_field (ast.param entry at_name) ()] ts,
    } };

/// A member: an ordinary function, compiled inside the module the record
/// becomes. Its body may name anything that module holds -- the accessors, the
/// setters, `make`, `new`, another member -- which is the whole point of
/// writing it there, and is why `names_something` does not apply to it.
let record_member_entry c name fields members entry at_name params ts =
    if taken name fields members entry {
        err ("record member `" + entry + "` conflicts with a generated helper") at_name
    } else { match expect ts :eq ("`=` after the parameters of `" + entry + "`") {
        [:error, m, s] => err m s,
        [:ok, _, rest] => match parse_expr c rest {
            [:error, m, s] => err m s,
            [:ok, body, after] =>
                ok [:member, ast.record_member entry params body
                                               (ast.span_to at_name (ast.span body))] after,
        },
    } };

/// Is this name already spoken for by something the record generates? The two
/// constructors, every field's accessor and setter, and every member so far.
/// Checking against what came *before* is what blames the later of two names
/// and leaves the first where it was written.
let taken name fields members n =
    n == "make" || n == "new" || n == "type"
    || list.any (fn f -> ast.field_name f == n || "set_" + ast.field_name f == n) fields
    || list.any (fn m -> ast.member_name m == n) members;

/// Does this expression name anything?
///
/// A field's default is compiled *inside* the module the record becomes, and a
/// module does not see the one it was written in -- `mod M { let f () = outer;
/// }` cannot find `outer` either. So a default that named a global would be a
/// "cannot find" reported against a span nobody wrote, which is the worst kind
/// of diagnostic there is: the rewrite hands the generated module fresh spans,
/// because a default appears twice in it -- in the accessor's `else` and in
/// `new`'s body -- and two occurrences cannot share one span.
///
/// A member is under no such restriction, and for both halves of that reason:
/// it appears once, so it keeps the spans it was written at, and naming the
/// module's own globals is what it is for.
///
/// A lambda is caught by this too, because its body names its own parameter.
/// That is stricter than it has to be and it is the honest boundary: what can
/// be written is what needs nothing from any scope.
let rec names_something e =
    match e {
        [:name, _, _] => true,
        [:field, _, _, _] => true,
        _ => type_of e == :list && list.any (fn x -> names_something x) e,
    };

/// A dotted path: `std.list`. Answers `[segments, rest]`.
let rec dotted_path acc ts =
    if not (at ts :ident) { err ("expected a module name, found " + describe ts) (peek_span ts) }
    else {
        let acc2 = core.cons (peek_value ts) acc;
        let rest = list.tail ts;
        // Only follow the dot when a name comes after it -- `import a.{x}` has
        // a brace there, and that is a member list, not another segment.
        if at rest :dot && peek2_kind rest == :ident { dotted_path acc2 (list.tail rest) }
        else { ok (list.reverse acc2) rest }
    };

/// `import std.list;`, `import std.list as l;`, `import std.list.{map, sum};`
///
/// The alias defaults to the last segment. A member list binds the members
/// unqualified, and each one resolves exactly as `path.name` would -- which is
/// what stops the two spellings ever disagreeing, including about purity.
let rec parse_import c sp ts =
    match dotted_path [] ts {
        [:error, m, s] => err m s,
        [:ok, segments, rest] =>
            if at rest :dot && peek2_kind rest == :lbrace {
                match import_names [] (list.tail (list.tail rest)) {
                    [:error, m, s] => err m s,
                    [:ok, names, rest2] =>
                        ok (ast.import_d segments () names (ast.span_to sp (peek_span rest))) rest2,
                }
            }
            else if is_kw rest "as" {
                let after = list.tail rest;
                if not (at after :ident) {
                    err ("expected a name after `as`, found " + describe after) (peek_span after)
                } else {
                    ok (ast.import_d segments (peek_value after) ()
                                     (ast.span_to sp (peek_span after)))
                       (list.tail after)
                }
            }
            else { ok (ast.import_d segments () () (ast.span_to sp (peek_span rest))) rest },
    };

/// `{ map, filter, sum as total }`
let rec import_names acc ts =
    if at ts :rbrace { ok (list.reverse acc) (list.tail ts) }
    else if not (at ts :ident) {
        err ("expected a member name, found " + describe ts) (peek_span ts)
    }
    else {
        let name = peek_value ts;
        let after = list.tail ts;
        // `sum as total` renames as it goes.
        let renamed = is_kw after "as";
        let alias = if renamed && at (list.tail after) :ident { peek_value (list.tail after) } else { () };
        let rest = if renamed { list.tail (list.tail after) } else { after };
        let acc2 = core.cons [name, alias] acc;
        if at rest :comma { import_names acc2 (list.tail rest) }
        else if at rest :rbrace { ok (list.reverse acc2) (list.tail rest) }
        else { err ("expected `,` or `}` in an import list, found " + describe rest) (peek_span rest) }
    };

/// `mod name { items }` -- a module written inside another.
let rec parse_mod c sp ts =
    if not (at ts :ident) { err ("expected a name after `mod`, found " + describe ts) (peek_span ts) }
    else {
        let name = peek_value ts;
        match expect (list.tail ts) :lbrace "`{` after a `mod` name" {
            [:error, m, s] => err m s,
            [:ok, _, rest] =>
                match item_list c [] rest true {
                    [:error, m, s] => err m s,
                    [:ok, items, rest2] => ok (ast.mod_d name items (ast.span_to sp sp)) rest2,
                },
        }
    };

/// `derive shapes.shape;` -- fills the holes a base module declared.
let rec parse_derive c sp ts =
    match dotted_path [] ts {
        [:error, m, s] => err m s,
        [:ok, segments, rest] => ok (ast.derive_d segments (ast.span_to sp sp)) rest,
    };

/// `virtual let area s;` -- a hole. With a body it has a default and filling
/// it is optional. A virtual needs at least one parameter, because one without
/// would be a constant rather than a hole.
let rec parse_virtual c sp ts =
    match expect ts :ident "`let` after `virtual`" {
        [:error, m, s] => err m s,
        [:ok, _, _] =>
            if peek_value ts != "let" { err "expected `let` after `virtual`" (peek_span ts) }
            else {
                let after = list.tail ts;
                if not (at after :ident) {
                    err ("expected a name after `virtual let`, found " + describe after) (peek_span after)
                } else {
                    let name = peek_value after;
                    match let_params c [] (list.tail after) {
                        [:error, m, s] => err m s,
                        [:ok, params, rest] =>
                            if list.is_empty params {
                                err ("`" + name + "` has no parameters, so it is a constant rather "
                                     + "than a hole to fill") sp
                            }
                            else if not (at rest :eq) {
                                ok (ast.virtual_d name params () (ast.span_to sp sp)) rest
                            }
                            else {
                                match parse_expr c (list.tail rest) {
                                    [:error, m, s] => err m s,
                                    [:ok, body, rest2] =>
                                        ok (ast.virtual_d name params body
                                                          (ast.span_to sp (ast.span body))) rest2,
                                }
                            },
                    }
                }
            },
    };

/// `when cond { items }`, or `when cond item` for a single one.
///
/// A `when` is resolved before anything is loaded, so an import inside a false
/// branch is never even followed.
let rec parse_when c sp ts =
    match parse_cfg_or c ts {
        [:error, m, s] => err m s,
        [:ok, cond, rest] =>
            if at rest :lbrace {
                match item_list c [] (list.tail rest) true {
                    [:error, m, s] => err m s,
                    [:ok, items, rest2] => ok (ast.when_d cond items (ast.span_to sp sp)) rest2,
                }
            }
            else {
                match parse_item c rest {
                    [:error, m, s] => err m s,
                    [:ok, item, rest2] => ok (ast.when_d cond [item] (ast.span_to sp sp)) rest2,
                }
            },
    };

// The condition vocabulary is deliberately the language's own: `&&`, `||`,
// `not`, parentheses, `true`, `false`, a bare flag, or `setting == "value"`.

let rec parse_cfg_or c ts =
    match parse_cfg_and c ts {
        [:error, m, s] => err m s,
        [:ok, l, rest] =>
            if not (at rest :or_or) { ok l rest }
            else {
                match parse_cfg_or c (list.tail rest) {
                    [:error, m, s] => err m s,
                    [:ok, r, rest2] => ok [:or, l, r] rest2,
                }
            },
    };

let rec parse_cfg_and c ts =
    match parse_cfg_unary c ts {
        [:error, m, s] => err m s,
        [:ok, l, rest] =>
            if not (at rest :and_and) { ok l rest }
            else {
                match parse_cfg_and c (list.tail rest) {
                    [:error, m, s] => err m s,
                    [:ok, r, rest2] => ok [:and, l, r] rest2,
                }
            },
    };

let rec parse_cfg_unary c ts =
    if is_kw ts "not" {
        match parse_cfg_unary c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, e, rest] => ok [:not, e] rest,
        }
    }
    else if at ts :lparen {
        match parse_cfg_or c (list.tail ts) {
            [:error, m, s] => err m s,
            [:ok, e, rest] =>
                match expect rest :rparen "`)` in a `when` condition" {
                    [:error, m, s] => err m s,
                    [:ok, _, rest2] => ok e rest2,
                },
        }
    }
    else if is_kw ts "true"  { ok [:const, true] (list.tail ts) }
    else if is_kw ts "false" { ok [:const, false] (list.tail ts) }
    else if at ts :ident {
        let name = peek_value ts;
        let rest = list.tail ts;
        // `os == "linux"` compares a setting; a bare name asks whether a flag
        // is defined. A setting that has a value counts as defined.
        if at rest :eq_eq && peek_kind (list.tail rest) == :str {
            ok [:equals, name, peek_value (list.tail rest)] (list.tail (list.tail rest))
        }
        else { ok [:flag, name] rest }
    }
    else { err ("expected a `when` condition, found " + describe ts) (peek_span ts) };

/// The items of a file, or of a `mod`/`when` body when `braced` is true.
let rec item_list c acc ts braced =
    if at ts :semi { item_list c acc (list.tail ts) braced }
    else if braced && at ts :rbrace { ok (list.reverse acc) (list.tail ts) }
    else if at_end ts {
        if braced { err "unterminated block: expected `}`" (peek_span ts) }
        else { ok (list.reverse acc) ts }
    }
    else {
        match parse_item (at_statement c ts) ts {
            [:error, m, s] => err m s,
            [:ok, item, rest] => item_list c (core.cons item acc) rest braced,
        }
    };

/// Where the word `expand` is written in a token stream, as byte offsets in
/// the order they occur.
///
/// This is answered here because this is the only place the tokens exist, and
/// it is answered at all because macro expansion had no other way to ask.
/// `[:expand, ..]` is built at exactly one site in this file, out of exactly
/// this word, so a declaration no offset falls inside cannot hold one --
/// which is what lets expansion pick the handful of declarations it is about
/// instead of walking every node of every declaration in the program to find
/// them. That walk was **11% of a self-compile** and every program paid it,
/// macros or not.
///
/// The `.` is what makes it worth scanning tokens rather than searching the
/// text: `import dreams.expand` is a member spelling and not this word at
/// all, and without the lookbehind it flagged every file that imports the
/// expander -- which, in this compiler, is most of the large ones.
///
/// It is a *superset* and has to stay one. `expand` written where the grammar
/// makes no expansion of it -- as a parameter name, say -- names a
/// declaration that is then walked for nothing, and a walk is all that costs.
/// The other direction would lose an expansion silently, which is why the
/// caller checks that the offsets and the declaration spans agree before
/// trusting them.
let rec expand_sites prev ts acc = match ts {
    [] => acc,
    [t, ..rest] => {
        let kind = lexer.kind t;
        expand_sites kind rest
            (if prev != :dot && kind == :ident && lexer.value t == "expand" {
                 core.cons (lexer.span_start t) acc
             } else { acc })
    },
};

/// Parse a whole module from source text: `[:ok, items, sites]`, or
/// `[:error, message, span]`. `sites` is `expand_sites` above, and it is lazy
/// -- a caller that does not read it does not pay for the scan.
///
/// The text is searched before the tokens are, and that is not belt and
/// braces: `core.str_find` is one machine pass over the file where the scan
/// is a Dream loop over every token in it, and a file that does not contain
/// the six bytes cannot contain the word. Nearly every file is such a file --
/// in a program with no macros at all, every one of them is -- so this is
/// what keeps the whole question down to a memchr per file for the programs
/// that are not about macros.
///
/// As with `parse_expression`, a lexical error is already a token in the
/// stream, and a top-level item position is where it ends up.
let parse_module src = {
    let ts = lexer.tokens src;
    match item_list top [] ts false {
        [:error, m, s] => err m s,
        [:ok, items, _] =>
            [:ok, items,
             if str.contains_str "expand" src { expand_sites :none ts [] } else { [] }],
        _ => err "the lexer answered something unexpected" ast.no_span,
    }
};

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    /// An expression's tree, written on one line without spans.
    let shape src =
        match parse_expression src {
            [:ok, e] => ast.show e,
            [:error, m, _] => "error: " + m,
        };

    /// A whole module's items, one line each.
    let items src =
        match parse_module src {
            [:ok, its, _] => str.join_str " " (list.map (fn i -> ast.show i) its),
            [:error, m, _] => "error: " + m,
        };

    /// The message of a module that must not parse.
    let fails_module src =
        match parse_module src {
            [:ok, _, _] => "parsed when it should not have",
            [:error, m, _] => m,
        };

    /// The span of the one declaration in `src`.
    ///
    /// Spans are otherwise absent from these tests on purpose -- `shape` and
    /// `items` drop them, because what a node *is* is a different question
    /// from where it was written. This asks the second question, for the one
    /// construct that got it wrong: a `match` ended at its first arm, so every
    /// `let f = match ..` was a declaration whose span covered its header and
    /// nothing else. Anything that asks which declaration an offset is in --
    /// macro discovery, the outline, hover, completion's locals -- was told
    /// that most of this compiler is in no declaration at all.
    let decl_span src =
        match parse_module src {
            [:ok, [it], _] => ast.span it,
            _ => "did not parse to one declaration",
        };

    /// The message of a source that must not parse.
    let fails src =
        match parse_expression src {
            [:ok, e] => "parsed when it should not have",
            [:error, m, _] => m,
        };

    let tests = [
        test.case "a declaration reaches the end of the match that is its body"
            $( test.eq! [0, 36] (decl_span "let f x = match x { 0 => 1, _ => 2 };") ),
        test.case "and the end of a match nested in its last arm"
            $( test.eq! [0, 53] (decl_span "let f x = match x { 0 => match x { _ => 1 }, _ => 2 };") ),

        test.case "private let retains its visibility"
            $( test.eq! "(priv (let x (int 1)))" (items "priv let x = 1;") ),
        test.case "priv requires a let or type declaration"
            $( test.eq! "expected `let` or `type` after `priv`" (fails_module "priv mod a {}") ),
        test.case "priv is reserved as a binding name"
            $( test.true! (str.contains_str "keyword" (fails_module "let priv = 1;")) ),

        // --- types ---
        //
        // A `type` is a `let` whose right-hand side is read in a grammar of
        // its own, and what that grammar builds is the same tagged data
        // `std.types` constructs. So these tests are about one thing: that
        // what is written turns into the description it claims to mean.
        test.case "a type is a named description"
            $( test.eq! "(let H (list (atom named) (str \"H\") (atom string)))"
                        (items "type H = :string;") ),
        test.case "an arrow is right-associative, which is what currying means"
            $( test.eq! "(let M (list (atom named) (str \"M\") (list (atom fn) (atom integer) (list (atom fn) (atom integer) (atom integer)))))"
                        (items "type M = :integer -> :integer -> :integer;") ),
        test.case "one element in brackets is a list of that"
            $( test.eq! "(let I (list (atom named) (str \"I\") (list (atom list_of) (atom integer))))"
                        (items "type I = [:integer];") ),
        // The reading that makes `[:ok, value]` say what it looks like.
        test.case "more than one element in brackets is a tuple"
            $( test.eq! "(let P a b (list (atom named) (str \"P\") (list (atom tuple) (list (name a) (name b)))))"
                        (items "type P a b = [a, b];") ),
        test.case "an array reads the same two ways"
            $( test.eq! "(let A (list (atom named) (str \"A\") (list (atom array_of) (atom float))))"
                        (items "type A = #[:float];") ),
        test.case "a union is flattened rather than nested"
            $( test.eq! "(let N (list (atom named) (str \"N\") (list (atom union) (list (atom integer) (atom float) (atom string)))))"
                        (items "type N = :integer | :float | :string;") ),
        test.case "a union binds tighter than an arrow"
            $( test.eq! "(let F (list (atom named) (str \"F\") (list (atom fn) (list (atom union) (list (atom integer) (atom float))) (atom string))))"
                        (items "type F = :integer | :float -> :string;") ),
        // Which map it is depends on whether the key names a kind or a value.
        test.case "a map keyed by a kind is a map type"
            $( test.eq! "(let M (list (atom named) (str \"M\") (list (atom map_of) (atom string) (atom integer))))"
                        (items "type M = %{ :string => :integer };") ),
        test.case "a map keyed by a literal is a record type"
            $( test.eq! "(let R (list (atom named) (str \"R\") (list (atom record) (map [(atom host) (atom string)]))))"
                        (items "type R = %{ :host => :string };") ),
        test.case "a map type takes only the one key"
            $( test.true! (str.contains_str "one `=>`"
                           (fails_module "type M = %{ :string => :integer, :atom => :integer };")) ),
        test.case "a record type's later keys must be literals too"
            $( test.true! (str.contains_str "keys are literals"
                           (fails_module "type R = %{ :host => :string, :string => :integer };")) ),
        // `where` reaches an ordinary expression, and is contextual: a
        // program may still bind the name everywhere a type is not written.
        test.case "where refines with an ordinary predicate"
            $( test.eq! "(let B (list (atom named) (str \"B\") (list (atom refine) (atom integer) (fn n (binary gt (name n) (int 0))))))"
                        (items "type B = :integer where fn n -> n > 0;") ),
        test.case "where is not a reserved word"
            $( test.eq! "(let where (int 1))" (items "let where = 1;") ),
        test.case "a private type retains its visibility"
            $( test.eq! "(priv (let H (list (atom named) (str \"H\") (atom string))))"
                        (items "priv type H = :string;") ),
        test.case "a type name must be a name"
            $( test.eq! "expected a name after `type`" (fails_module "type = :integer;") ),
        test.case "a type name must be pure"
            $( test.eq! "a type name must be pure" (fails_module "type Bad! = :integer;") ),
        test.case "a keyword is not a type"
            $( test.true! (str.contains_str "cannot be a type" (fails_module "type T = fn;")) ),
        test.case "a record field carries its description"
            $( test.eq! "(group Point x : (atom integer))" (items "group Point { x : :integer }") ),
        test.case "priv cannot modify a local binding"
            $( test.true! (str.contains_str "keyword" (fails "{ priv let x = 1; x }")) ),
        test.case "macro declarations retain syntax parameters"
            $( test.eq! "(macro identity x (name x))" (items "macro identity x = x;") ),
        test.case "expand consumes an application before operators"
            $( test.eq! "(binary add (expand (apply (name twice) (name x))) (int 1))"
                        (shape "expand twice x + 1") ),
        test.case "records retain their backing kind and field order"
            $( test.eq! "(group Point x y) (struct Pair a b) (mapping Named z a)"
                        (items "group Point { x, y } struct Pair { a, b, } mapping Named { z, a, }") ),
        test.case "a record retains its behavior declaration"
            $( test.eq! "(struct Person (derive example.Named) name)"
                        (items "struct Person derive example.Named { name }") ),
        test.case "record helpers cannot collide"
            $( test.eq! "record field `set_x` conflicts with a generated helper"
                        (fails_module "group Point { x, set_x }") ),
        test.case "a field may be given a default"
            $( test.eq! "(mapping C (retries = (int 3)) host)"
                        (items "mapping C { retries = 3, host }") ),
        // Parameters are the whole of what tells a member from a field, so the
        // two spellings are checked side by side: `x = 0` has none and is a
        // field, `f self = 0` has one and is a function.
        test.case "parameters are what make an entry a member"
            $( test.eq! "(group P (x = (int 0)) (f self = (int 0)))"
                        (items "group P { x = 0, f self = 0 }") ),
        test.case "a member may take more than the record"
            $( test.eq! "(group P x (shifted self d = (apply (name make) (name d))))"
                        (items "group P { x, shifted self d = make d }") ),
        // A record body separates its entries the way a block separates its
        // statements: with the punctuation where it is written, and with a
        // line break where it is not. Without this, `name` and `age` on two
        // lines are one field taking one parameter.
        test.case "a line break separates entries as a comma does"
            $( test.eq! "(mapping P name age)" (items "mapping P {\n    name\n    age\n}") ),
        test.case "a member ends at the line break after it"
            $( test.eq! "(mapping P name (hi self = (apply (name name) (name self))))"
                        (items "mapping P {\n    name\n    hi self = name self\n}") ),
        test.case "an entry may run over a line it is indented past"
            $( test.eq! "(mapping P (n = (binary add (int 1) (int 2))))"
                        (items "mapping P {\n    n =\n        1 + 2\n}") ),
        test.case "a member cannot take a name the record generates"
            $( test.eq! "record member `new` conflicts with a generated helper"
                        (fails_module "group Point { x, new self = 1 }") ),
        test.case "a member may be impure where a field may not"
            $( test.eq! "(group P x (bang! self = (name self)))"
                        (items "group P { x, bang! self = self }") ),
        test.case "a field may not be impure"
            $( test.eq! "a record field must be a plain name: `!` marks a name impure, and reading a field is pure"
                        (fails_module "group Point { x! }") ),
        test.case "record keywords remain usable as local names"
            $( test.eq! "(let group (int 1)) (let struct (int 2)) (let mapping (int 3))"
                        (items "let group = 1; let struct = 2; let mapping = 3;") ),
        // --- literals ---
        test.case "integer"   $( test.eq! "(int 42)" (shape "42") ),
        test.case "float"     $( test.eq! "(float 1.5)" (shape "1.5") ),
        test.case "string"    $( test.eq! "(str \"hi\")" (shape "\"hi\"") ),
        test.case "atom"      $( test.eq! "(atom ok)" (shape ":ok") ),
        test.case "char"      $( test.eq! "(char 'c')" (shape "'c'") ),
        // A dump has to tell a string from a name.
        test.case "a string is quoted in a dump"
            $( test.eq! "(str \"a b\")" (shape "\"a b\"") ),
        test.case "true"      $( test.eq! "(bool true)" (shape "true") ),
        test.case "unit"      $( test.eq! "(unit)" (shape "()") ),
        test.case "name"      $( test.eq! "(name x)" (shape "x") ),
        // A trailing `!` is part of the name, not an operator.
        test.case "an impure name keeps its bang"
            $( test.eq! "(name print!)" (shape "print!") ),

        // --- the rule that carries the most weight ---
        //
        // Application is juxtaposition and binds tighter than every operator,
        // which is why a recursive call usually needs parentheses.
        test.case "application binds tighter than an operator"
            $( test.eq! "(binary sub (apply (name fac) (name n)) (int 1))" (shape "fac n - 1") ),
        test.case "parentheses are what a recursive call wants"
            $( test.eq! "(apply (name fac) (binary sub (name n) (int 1)))" (shape "fac (n - 1)") ),
        test.case "operands of an operator are whole applications"
            $( test.eq! "(binary add (apply (name f) (name a) (name b)) (apply (name g) (name c)))"
                        (shape "f a b + g c") ),
        test.case "application is curried into one node"
            $( test.eq! "(apply (name f) (name a) (name b) (name c))" (shape "f a b c") ),

        // --- precedence, loosest to tightest ---
        test.case "* binds tighter than +"
            $( test.eq! "(binary add (int 1) (binary mul (int 2) (int 3)))" (shape "1 + 2 * 3") ),
        test.case "&& binds tighter than ||"
            $( test.eq! "(binary or (name a) (binary and (name b) (name c)))" (shape "a || b && c") ),
        test.case "comparison is looser than arithmetic"
            $( test.eq! "(binary lt (binary add (name a) (int 1)) (name b))" (shape "a + 1 < b") ),
        test.case "every operator is left-associative"
            $( test.eq! "(binary sub (binary sub (int 1) (int 2)) (int 3))" (shape "1 - 2 - 3") ),
        test.case "the pipe is looser than everything"
            $( test.eq! "(pipe (binary add (name x) (int 1)) (apply (name f) (name a)))"
                        (shape "x + 1 |> f a") ),
        test.case "unary minus"
            $( test.eq! "(unary neg (name x))" (shape "-x") ),
        test.case "not is looser than application"
            $( test.eq! "(unary not (apply (name f) (name x)))" (shape "not f x") ),

        // --- member access ---
        test.case "member access"
            $( test.eq! "(field (name console) print!)" (shape "console.print!") ),
        test.case "member access binds tighter than application"
            $( test.eq! "(apply (field (name console) print!) (str \"hi\"))"
                        (shape "console.print! \"hi\"") ),
        test.case "nested members"
            $( test.eq! "(field (field (name a) b) c)" (shape "a.b.c") ),

        // --- reading and changing a container ---
        test.case "a container read at a key"
            $( test.eq! "(get (name m) (atom k))" (shape "m.[:k]") ),
        test.case "a read with a fallback"
            $( test.eq! "(get (name m) (atom k) (int 0))" (shape "m.[:k else 0]") ),
        test.case "a container changed at a key"
            $( test.eq! "(set (name m) (atom k) (binary add (name v) (int 1)))" (shape "m.[:k => v + 1]") ),
        test.case "indexing chains and binds tighter than application"
            $( test.eq! "(apply (name f) (get (get (name grid) (name y)) (name x)))"
                        (shape "f grid.[y].[x]") ),
        // The dot is the whole difference.
        test.case "without the dot a bracket is still an argument"
            $( test.eq! "(apply (name f) (list (int 0)))" (shape "f [0]") ),
        test.case "an index needs its closing bracket"
            $( test.true! (str.contains_str "`]`" (fails "m.[:k")) ),

        // --- collections ---
        test.case "list"    $( test.eq! "(list (int 1) (int 2))" (shape "[1, 2]") ),
        test.case "array"   $( test.eq! "(array (int 1))" (shape "#[1]") ),
        test.case "map"     $( test.eq! "(map [(atom a) (int 1)])" (shape "%{ :a => 1 }") ),
        test.case "empty list"  $( test.eq! "(list )" (shape "[]") ),
        test.case "a trailing comma is allowed"
            $( test.eq! "(list (int 1))" (shape "[1,]") ),
        // Newlines never end a statement inside a bracket group.
        test.case "a list may span lines"
            $( test.eq! "(list (int 1) (int 2))" (shape "[1,\n 2]") ),

        // --- control forms ---
        test.case "if with else"
            $( test.eq! "(if (name a) (block (name b)) (block (name c)))"
                        (shape "if a { b } else { c }") ),
        test.case "if without else"
            $( test.eq! "(if (name a) (block (name b)))" (shape "if a { b }") ),
        test.case "else if chains"
            $( test.eq! "(if (name a) (block (int 1)) (if (name b) (block (int 2)) (block (int 3))))"
                        (shape "if a { 1 } else if b { 2 } else { 3 }") ),
        // The brace after the condition opens the branch; it is not one more
        // argument to an application in the condition.
        test.case "a condition does not swallow the branch brace"
            $( test.eq! "(if (apply (name f) (name x)) (block (int 1)))" (shape "if f x { 1 }") ),
        test.case "lambda"
            $( test.eq! "(fn x (binary add (name x) (int 1)))" (shape "fn x -> x + 1") ),
        test.case "lambda with several parameters"
            $( test.eq! "(fn a b (binary mul (name a) (name b)))" (shape "fn a b -> a * b") ),
        test.case "thunk"   $( test.eq! "(thunk (apply (name f) (name x)))" (shape "$( f x )") ),
        test.case "try/catch"
            $( test.eq! "(try (block (binary div (int 1) (int 0))) e (block (int 0)))"
                        (shape "try! { 1 / 0 } catch e { 0 }") ),
        test.case "comp"    $( test.eq! "(comp (apply (name f) (name x)))" (shape "comp f x") ),
        test.case "comp!"   $( test.eq! "(comp! (apply (name f) (name x)))" (shape "comp! f x") ),

        // --- blocks ---
        test.case "an empty block"  $( test.eq! "(block)" (shape "{ }") ),
        test.case "a block of statements"
            $( test.eq! "(block (name a) (name b))" (shape "{ a\n  b }") ),
        test.case "semicolons separate statements too"
            $( test.eq! "(block (name a) (name b))" (shape "{ a; b }") ),
        test.case "a block may declare a let"
            $( test.eq! "(block (let x (int 1)) (name x))" (shape "{ let x = 1\n  x }") ),
        test.case "a let with parameters is a function"
            $( test.eq! "(block (let f a b (binary add (name a) (name b))))"
                        (shape "{ let f a b = a + b }") ),
        test.case "let rec is recorded"
            $( test.eq! "(block (let rec go n (name n)))" (shape "{ let rec go n = n }") ),
        // A line indented past the statement it follows continues it.
        test.case "an indented line continues the statement above"
            $( test.eq! "(block (apply (name f) (int 1) (int 2)))" (shape "{ f 1\n    2 }") ),
        test.case "a line at the same indentation starts a new statement"
            $( test.eq! "(block (apply (name f) (int 1)) (int 2))" (shape "{ f 1\n  2 }") ),
        // An operator can never begin a statement, so a line starting with one
        // continues the line above whatever its indentation.
        test.case "a leading operator continues the line above"
            $( test.eq! "(block (binary add (name a) (name b)))" (shape "{ a\n+ b }") ),

        // --- match ---
        test.case "match"
            $( test.eq! "(match (name v) [(int 0) (atom zero)] [_ (atom other)])"
                        (shape "match v { 0 => :zero, _ => :other }") ),
        test.case "a binding pattern"
            $( test.eq! "(match (name v) [n (name n)])" (shape "match v { n => n }") ),
        test.case "a list pattern with a rest"
            $( test.eq! "(match (name v) [[x ..rest] (name x)])"
                        (shape "match v { [x, ..rest] => x }") ),
        test.case "an unnamed rest"
            $( test.eq! "(match (name v) [[x ..] (name x)])" (shape "match v { [x, ..] => x }") ),
        test.case "an empty list pattern"
            $( test.eq! "(match (name v) [[] (int 0)])" (shape "match v { [] => 0 }") ),
        test.case "an array pattern"
            $( test.eq! "(match (name v) [#[a b] (name a)])" (shape "match v { #[a, b] => a }") ),
        test.case "a map pattern"
            $( test.eq! "(match (name v) [%{(atom k) => p} (name p)])"
                        (shape "match v { %{ :k => p } => p }") ),
        test.case "an as pattern"
            $( test.eq! "(match (name v) [(_ as whole) (name whole)])"
                        (shape "match v { _ as whole => whole }") ),
        test.case "a guard"
            $( test.eq! "(match (name v) [n if (binary lt (name n) (int 0)) (atom neg)])"
                        (shape "match v { n if n < 0 => :neg }") ),
        test.case "a negative literal pattern"
            $( test.eq! "(match (name v) [(int -1) (atom neg)])" (shape "match v { -1 => :neg }") ),
        test.case "the subject does not swallow the arms brace"
            $( test.eq! "(match (apply (name f) (name x)) [_ (int 1)])"
                        (shape "match f x { _ => 1 }") ),
        test.case "parentheses group a pattern"
            $( test.eq! "(match (name v) [[([x ..] as first) y] (name first)])"
                        (shape "match v { [([x, ..] as first), y] => first }") ),

        // --- destructuring ---
        //
        // A `let` and a parameter take the patterns a `match` arm takes. Which
        // of them are allowed there is resolution's business, not the parser's.
        test.case "a let may take a pattern"
            $( test.eq! "(let [a b] (name p))" (items "let [a, b] = p;") ),
        test.case "a block's let may take a pattern"
            $( test.eq! "(block (let [x ..rest] (name xs)) (name rest))"
                        (shape "{ let [x, ..rest] = xs\n  rest }") ),
        test.case "a let may take a map apart"
            $( test.eq! "(let %{(atom x) => x (atom y) => y} (name p))"
                        (items "let %{ :x => x, :y => y } = p;") ),
        test.case "a let's pattern may carry an as"
            $( test.eq! "(let ([a] as whole) (name p))" (items "let [a] as whole = p;") ),
        test.case "a destructuring let cannot be rec"
            $( test.true! (str.contains_str "cannot be `rec`" (fails_module "let rec [a] = p;")) ),
        test.case "a parameter may be a pattern"
            $( test.eq! "(let f [a b] c (name a))" (items "let f [a, b] c = a;") ),
        test.case "a lambda's parameter may be a pattern"
            $( test.eq! "(fn %{(atom k) => v} (name v))" (shape "fn %{ :k => v } -> v") ),
        test.case "an as in a parameter is written in the parenthesised list"
            $( test.eq! "(let f ([a b] as pair) c (name pair))"
                        (items "let f ([a, b] as pair, c) = pair;") ),

        // --- parameters ---
        //
        // Three spellings, and only juxtaposition is in the reference. The
        // parenthesised list is undocumented but the Rust parser takes it, so
        // files in this repository already depend on it.
        test.case "juxtaposed parameters"
            $( test.eq! "(let f a b (name a))" (items "let f a b = a") ),
        test.case "a unit parameter binds no name"
            $( test.eq! "(let now! () (int 1))" (items "let now! () = 1") ),
        test.case "a parenthesised parameter list"
            $( test.eq! "(let f a b (name a))" (items "let f(a, b) = a") ),
        test.case "a lambda takes the same shapes"
            $( test.eq! "(fn a b (name a))" (shape "fn (a, b) -> a") ),

        // --- module items ---
        test.case "import"
            $( test.eq! "(import std.list)" (items "import std.list;") ),
        test.case "import with an alias"
            $( test.eq! "(import std.list as l)" (items "import std.list as l;") ),
        test.case "import of members"
            $( test.eq! "(import std.list.{map filter})" (items "import std.list.{map, filter};") ),
        test.case "a member may be renamed"
            $( test.eq! "(import std.list.{sum as total})" (items "import std.list.{sum as total};") ),
        test.case "a whole package"
            $( test.eq! "(import std)" (items "import std;") ),
        test.case "derive"
            $( test.eq! "(derive std.seq)" (items "derive std.seq;") ),
        test.case "a virtual with no body is a hole"
            $( test.eq! "(virtual fold f init xs)" (items "virtual let fold f init xs;") ),
        test.case "a virtual with a body has a default"
            $( test.eq! "(virtual name xs (str \"sequence\"))"
                        (items "virtual let name xs = \"sequence\";") ),
        test.case "a virtual needs a parameter"
            $( test.true! (str.contains_str "constant" (fails_module "virtual let x = 1;")) ),
        test.case "mod"
            $( test.eq! "(mod math (let square x (name x)))"
                        (items "mod math { let square x = x }") ),
        test.case "when with a flag"
            $( test.eq! "(when (flag test) (let x (int 1)))" (items "when test { let x = 1 }") ),
        test.case "when with a single item and no braces"
            $( test.eq! "(when (flag release) (let x (int 1)))" (items "when release let x = 1;") ),
        test.case "a when condition uses the language's own vocabulary"
            $( test.eq! "(when (and (equals os \"linux\") (not (flag release))) (let x (int 1)))"
                        (items "when os == \"linux\" && not release { let x = 1 }") ),
        test.case "top-level lets need no rec"
            $( test.eq! "(let go n (apply (name go) (name n)))" (items "let go n = go n") ),

        // --- errors ---
        test.case "an unclosed parenthesis"
            $( test.true! (str.contains_str "expected `)`" (fails "(1 + 2")) ),
        test.case "a missing catch"
            $( test.eq! "`try!` needs a `catch`" (fails "try! { 1 }") ),
        test.case "fn needs a parameter"
            $( test.eq! "`fn` needs at least one parameter" (fails "fn -> 1") ),
        test.case "a keyword is not an expression"
            $( test.true! (str.contains_str "keyword" (fails "let")) ),
        test.case "trailing tokens are reported"
            $( test.true! (str.contains_str "unexpected" (fails "1 2 )")) ),
        test.case "a lexical error is reported by the parser"
            $( test.true! (str.contains_str "unterminated string" (fails "\"oops")) ),
    ];
}
