// Utilities shared by declaration sugar and macro expansion. Generated syntax
// needs distinct occurrence offsets: resolution keys names and binders by span.

import std.list;
import std.str;
import dreams.ast;

let is_span x = match x {
    [a, b] => type_of a == :integer && type_of b == :integer,
    _ => false,
};

/// Fresh offsets in a reserved part of the 32-bit source-offset space.
/// Returns [tree, next_offset]. A copied argument must be freshened too: a
/// macro may insert it twice, under two different lexical scopes.
let rec fresh tree next =
    if type_of tree != :list || list.is_empty tree { [tree, next] }
    else {
        let has_span = is_span (list.last tree);
        let parts = if has_span { list.take (list.length tree - 1) tree } else { tree };
        let [reversed, end] = list.fold (fn [acc, offset] part -> {
            let [child, after_child] = fresh part offset;
            [list_cons child acc, after_child]
        }) [[], next] parts;
        let items = list.reverse reversed;
        if has_span { [items + [[end, end + 1]], end + 2] }
        else { [items, end] }
    };

/// A value represented as an expression that constructs it, without evaluation.
let rec literal value span = match type_of value {
    :integer => ast.int_e value span,
    :float => ast.float_e value span,
    :bool => ast.bool_e value span,
    :char => ast.char_e value span,
    :string => ast.str_e value span,
    :atom => ast.atom_e (ast.atom_name value) span,
    :unit => ast.unit_e span,
    :list => ast.list_e (list.map (fn v -> literal v span) value) span,
    :array => ast.array_e (list.map (fn v -> literal v span) (array_to_list value)) span,
    :map => ast.map_e (list.map (fn kv -> list.map (fn v -> literal v span) kv)
                              (map_pairs value)) span,
    _ => ast.unit_e span,
};

/// Records are namespaces of ordinary functions over ordinary collections.
///
/// A field's default -- `mapping Config { retries = 3 }` -- is the fallback of
/// the read its accessor compiles to, and nothing else: `c.[k else d]` is one
/// opcode and already means "this, or that when it is not there". So a default
/// costs nothing where it is not used, is lazy where it is, and works the same
/// for a `group` and a `struct`, whose reads are by position.
///
/// It does *not* make `make`'s parameter optional, because arity is fixed in
/// this language and a constructor that sometimes took four arguments and
/// sometimes three would be a different function each time. `new` is that
/// other function, written out: it takes the fields that have no default, in
/// the order they were declared, and fills the rest in. So the two constructors
/// are the two honest readings of a defaulted field -- `make` says "I am giving
/// you all of it" and `new` says "give me the rest" -- and a record with no
/// defaults gets two names for the same thing, which is better than a name that
/// appears and disappears with the declaration.
///
/// Note that `new` puts the default *in the collection* rather than leaving the
/// slot empty for the accessor to fall back on. It has to for a `group` and a
/// `struct`, whose fields are positions and whose later positions would shift;
/// doing the same for a `mapping` is what makes `C.new a == C.make a 3` hold,
/// and equality is the thing a reader will assume.
///
/// A member -- `say_hi self = ..` -- is spliced in as the `let` it already is.
/// Everything generated is freshened first and the members are appended after,
/// which is not tidiness: `fresh` exists because resolution keys names and
/// binders by span, and the generated declarations need new spans because
/// several of them stand where one declaration was written and a default is
/// emitted twice. A member is written once, at a real place, so freshening it
/// would throw away the only spans a diagnostic inside it could point at.
/// Generated spans live above 2^31 and written ones below, so the two cannot
/// collide.
let record kind name fields members span = record_derived kind name fields members [] span;

let record_derived kind name fields members bases span = {
    let named f = ast.name_e (ast.field_name f) (ast.field_span f);
    let build of_field = match kind {
        :list => ast.list_e (list.map of_field fields) span,
        :array => ast.array_e (list.map of_field fields) span,
        :map => ast.map_e (list.map (fn f ->
            [ast.atom_e (ast.field_name f) (ast.field_span f), of_field f]) fields) span,
    };
    let constructor = ast.let_d "make"
        (if list.is_empty fields { [ast.param () span] }
         else { list.map (fn f -> ast.field_param f) fields })
        (build (fn f -> named f)) false span;
    // `new` names only the fields that have no default; the others are their
    // defaults, spliced where the value goes.
    let required = list.filter (fn f -> ast.field_default f == ()) fields;
    let from_default = ast.let_d "new"
        (if list.is_empty required { [ast.param () span] }
         else { list.map (fn f -> ast.field_param f) required })
        (build (fn f -> match ast.field_default f { () => named f, d => d })) false span;
    let helpers = list.concat (list.map (fn i -> {
        let f = list.nth i fields;
        let field = ast.field_name f;
        let obj = ast.name_e "record" span;
        let key = match kind { :map => ast.atom_e field span, _ => ast.int_e i span };
        [ast.let_d field [ast.param "record" span]
                   (ast.get_e obj key (ast.field_default f) span) false span,
         ast.let_d ("set_" + field) [ast.param "record" span, ast.param "value" span]
                   (ast.set_e obj key (ast.name_e "value" span) span) false span]
    }) (list.range 0 (list.length fields)));
    // Every record supplies a structural description, without changing its
    // constructors or forcing its fields. Unannotated fields accept anything.
    // Defaults are carried lazily, so membership agrees with accessor reads.
    let type_fields = list.map (fn i -> {
        let f = list.nth i fields;
        let key = if kind == :map { ast.atom_e (ast.field_name f) span }
                  else { ast.int_e i span };
        let description = match ast.field_type f { () => ast.atom_e "any" span, t => t };
        let defaults = match ast.field_default f { () => [], d => [d] };
        ast.list_e [key, description, ast.list_e defaults span] span
    }) (list.range 0 (list.length fields));
    let description = ast.let_d "type" []
        (ast.list_e [ast.atom_e "named" span, ast.str_e name span,
            ast.list_e [ast.atom_e "shape" span, literal kind span,
                        ast.list_e type_fields span] span] span) false span;
    let generated = list.head (fresh ([constructor, from_default] + helpers)
                                     (2147483648 + ast.span_start span * 128));
    let written = list.map (fn m -> ast.let_d (ast.member_name m) (ast.member_params m)
                                              (ast.member_body m) true (ast.member_span m))
                           members;
    // Each field type occurs once, so retain its written spans for diagnostics.
    ast.mod_d name (bases + generated + [description] + record_sigs kind name fields span + written) span
};

/// What every generated function of a record promises, for the type checker.
///
/// A signature compiles to nothing (see `ast.sig_d`), so these change no
/// image; what they change is that `Point.make 1 "two"` and `Point.x 3` are
/// mistakes the checker can see when the fields were given types. An
/// unannotated field is `:any` here as it is in the description, so a record
/// nobody annotated promises nothing it did not already.
///
/// The record's own type is spelled `type`, which is the description's global
/// in the generated module -- so the checker resolves it the way it resolves
/// any name in a signature, and nothing here has to know how.
///
/// Only a record with at least one annotated field gets them. One that
/// annotates nothing has promised nothing, and code that uses it -- reading a
/// defaulted field of an empty map, say, which is legitimate -- must check
/// exactly as it compiled before any of this existed.
///
/// A `mapping`'s accessor asks only for the field it reads, and for any map
/// at all when that field has a default: `Config.retries %{}` is `3`. A
/// `group`'s or a `struct`'s reads by position, so it takes the record.
let record_sigs kind name fields span =
    if list.all (fn f -> ast.field_type f == ()) fields { [] }
    else {
        let self = shown_as name (ast.name_e "type" span) span;
        let field_t f = match ast.field_type f { () => ast.atom_e "any" span, t => t };
        let arrows ts result = list.fold (fn acc t -> arrow t acc) result (list.reverse ts);
        let required = list.filter (fn f -> ast.field_default f == ()) fields;
        let takes fs = if list.is_empty fs { [ast.atom_e "any" span] } else { list.map field_t fs };
        let reads f = match [kind, ast.field_default f] {
            [:map, ()] => ast.list_e [ast.atom_e "record" span,
                                      ast.map_e [[ast.atom_e (ast.field_name f) span, field_t f]] span] span,
            [:map, _] => ast.atom_e "map" span,
            _ => self,
        };
        [ast.sig_d "make" (arrows (takes fields) self) span,
         ast.sig_d "new" (arrows (takes required) self) span]
        + list.concat (list.map (fn f ->
              [ast.sig_d (ast.field_name f) (arrow (reads f) (field_t f)) span,
               ast.sig_d ("set_" + ast.field_name f) (arrow self (arrow (field_t f) self)) span])
              fields)
    };

/// A type that reads as `name` wherever it is shown. Inside the generated
/// module the record's own type is the global `type`, which is the right thing
/// to resolve and the wrong thing to print: `circle : :float -> type` says
/// nothing a reader can use. `[:named, name, t]` is what a `type` declaration
/// is, and both the checker and a signature's printer read the name from it.
let shown_as name t span = ast.list_e [ast.atom_e "named" span, ast.str_e name span, t] span;

/// `a -> b` as the type grammar builds it.
let arrow a b = ast.list_e [ast.atom_e "fn" (ast.span b), a, b] (ast.span b);

// --- unions --------------------------------------------------------------------

/// `union Shape { circle(radius : :float), empty }`, as a module of ordinary
/// functions: one constructor per variant, a description called `type`, the
/// members as written, and a signature for every constructor. The parent gets
/// a global of the union's own name holding the description, so `Shape` is a
/// type wherever a type is written -- `[Shape]`, `types.check Shape v` --
/// while `Shape.circle` still reaches the module, because a name in front of a
/// dot is looked up as a module first. Answers the items that replace the
/// declaration in its parent.
///
/// A variant is `[:tag, ..fields]`, and a variant with no fields is the atom
/// `:tag` itself. Both are what this language already writes by hand --
/// `[:ok, value]` and `:done` -- which is the point: a declared union
/// describes the values programs already build, and matches them with the
/// patterns they already use. So the description is exactly the one a `type`
/// declaration would give (`[:circle, :float] | :empty`), except that the tag
/// is written as a `literal`, so that a variant called `error` or `list` means
/// the atom and not the kind of value `std.types` would otherwise read it as.
///
/// Parameters make it generic: `union Option a { some(value : a), none }`.
/// The description is then a function of them, as a parameterised `type` is,
/// and the constructors' signatures say `a -> Option a` -- `a` being free in a
/// signature is what makes it a type variable.
let union_decl name params variants members span = {
    let at_ = span;
    let lit_tag v = ast.list_e [ast.atom_e "literal" at_, ast.atom_e (ast.variant_name v) at_] at_;
    let field_t f = match list.nth 2 f { () => ast.atom_e "any" at_, t => t };
    let described v = match ast.variant_fields v {
        [] => lit_tag v,
        fs => ast.list_e [ast.atom_e "tuple" at_,
                          ast.list_e (list_cons (lit_tag v) (list.map field_t fs)) at_] at_,
    };
    let description = ast.let_d "type" params
        (ast.list_e [ast.atom_e "named" at_, ast.str_e name at_,
                     ast.list_e [ast.atom_e "union" at_,
                                 ast.list_e (list.map described variants) at_] at_] at_) false at_;
    let constructors = list.map (fn v -> {
        let fs = ast.variant_fields v;
        let tag = ast.atom_e (ast.variant_name v) at_;
        match fs {
            [] => ast.let_d (ast.variant_name v) [] tag false at_,
            _ => ast.let_d (ast.variant_name v)
                    (list.map (fn f -> ast.param (list.nth 0 f) (list.nth 1 f)) fs)
                    (ast.list_e (list_cons tag (list.map (fn f -> ast.name_e (list.nth 0 f) (list.nth 1 f)) fs)) at_)
                    false at_,
        }
    }) variants;
    // The union's own type, applied to its parameters: `type a b`, read in
    // the generated module where `type` is the description's global.
    let self = shown_as name (match params {
        [] => ast.name_e "type" at_,
        ps => ast.apply_e (ast.name_e "type" at_) (list.map (fn p -> ast.name_e (ast.param_name p) at_) ps) at_,
    }) at_;
    let sigs = list.map (fn v ->
        ast.sig_d (ast.variant_name v)
            (list.fold (fn acc f -> arrow (field_t f) acc) self (list.reverse (ast.variant_fields v)))
            (ast.variant_span v)) variants;
    // What the parent sees under the union's own name: the description.
    let alias = ast.let_d name params
        (match params {
            [] => ast.field_e (ast.name_e name at_) "type" at_,
            ps => ast.apply_e (ast.field_e (ast.name_e name at_) "type" at_)
                              (list.map (fn p -> ast.name_e (ast.param_name p) at_) ps) at_,
        }) false at_;
    // Freshened together, so that no two generated nodes share an offset --
    // resolution keys names and binders by where they start. The description
    // is not: each field type occurs in it once, so it keeps the spans it was
    // written at and a mistake in one is reported where it is, as a record's
    // description does.
    let [generated, _] = fresh (constructors + [alias]) (2147483648 + ast.span_start span * 128);
    let written = list.map (fn m -> ast.let_d (ast.member_name m) (ast.member_params m)
                                              (ast.member_body m) true (ast.member_span m))
                           members;
    let made = list.take (list.length constructors) generated;
    [ast.mod_d name (made + [description] + sigs + written) span, list.last generated]
};

// --- foreign libraries -------------------------------------------------------------

/// `foreign name from lib { .. }`, as a module: the library, a `type` for each
/// resource, a module for each struct, and for each function the binding
/// `std.ffi` makes of it together with the signature that says what it is on
/// this side. So one line of C signature is both halves of a binding, and
/// what the checker knows about `add! : Counter -> :long -> :long` is
/// `Counter -> :integer -> :integer`: a cursor where a counter is wanted is a
/// compile error in the program that passed it, and a runtime one only where
/// the checker could not see.
///
/// Purity is the name's, as it is everywhere: `add!` is bound with
/// `ffi.function` and `scale` with `ffi.pure_function`. Only the program can
/// know that a C function has no effects, and the name is where it says so.
///
/// A resource's tag is `name.Resource`, so two libraries that each declare a
/// `Db` do not accept each other's.
///
/// Everything here assumes the entries were checked by `foreign_problem`,
/// which the parser runs so that a C type that means nothing is reported where
/// it was written.
let foreign_decl name library entries span = {
    let at_ = span;
    let env = foreign_env name entries;
    let atom a = ast.atom_e a at_;
    let name_ n = ast.name_e n at_;
    let apply f args = ast.apply_e f args at_;
    let from_foreign member = ast.field_e (name_ "foreign") member at_;
    let imports = [ast.import_d ["std", "ffi"] () () at_, ast.import_d ["std", "foreign"] () () at_];
    let lib = ast.let_d "library" [] (match library { () => ast.unit_e at_, l => l }) false at_;
    let resources = list.concat (list.map (fn e -> match e {
        [:resource, r, _, _] => [ast.let_d r []
            (ast.list_e [atom "named", ast.str_e r at_,
                         apply (from_foreign "Handle") [ast.str_e (name + "." + r) at_]] at_) false at_],
        _ => [],
    }) entries);
    let structs = list.concat (list.map (fn e -> match e {
        [:c_struct, s, fields, sp] => [c_struct_module s fields sp],
        _ => [],
    }) entries);
    let functions = list.concat (list.map (fn e -> match e {
        [:c_function, f, t, symbol, sp] => match c_function env t {
            [:ok, args, result, dream] => {
                let bind = if str.ends_with "!" f { "function" } else { "pure_function" };
                [[ast.let_d f [] (apply (ast.field_e (name_ "ffi") bind at_)
                                        [name_ "library", ast.str_e symbol at_,
                                         ast.list_e args at_, result]) false at_,
                  ast.sig_d f dream sp]]
            },
            _ => [],
        },
        _ => [],
    }) entries);
    let lets = list.map (fn pair -> list.head pair) functions;
    let sigs = list.map (fn pair -> list.nth 1 pair) functions;
    let [generated, _] = fresh (imports + [lib] + resources + structs + lets)
                               (2147483648 + ast.span_start span * 128);
    [ast.mod_d name (generated + sigs) span]
};

/// A struct as a module over its layout, which `comp` settles while compiling:
/// `Point.new!` is a zeroed one, `read!` and `write!` go through a map of its
/// fields, and `layout` is there for `foreign.read_struct!` at an offset --
/// an array of them.
priv let c_struct_module s fields at_ = {
    let name_ n = ast.name_e n at_;
    let apply f args = ast.apply_e f args at_;
    let from_foreign member = ast.field_e (name_ "foreign") member at_;
    let buffer = from_foreign "Buffer";
    let described = ast.list_e (list.map (fn f ->
        ast.list_e [ast.atom_e (list.nth 0 f) (list.nth 1 f), list.nth 2 f] at_) fields) at_;
    let p n = ast.param n at_;
    ast.mod_d s [
        ast.import_d ["std", "foreign"] () () at_,
        ast.let_d "layout" [] (ast.comp_e false (apply (from_foreign "layout") [described]) at_) false at_,
        ast.let_d "size" [] (ast.get_e (name_ "layout") (ast.atom_e "size" at_) () at_) false at_,
        ast.let_d "new!" [p "u"] (apply (from_foreign "struct_buffer!") [name_ "layout"]) false at_,
        ast.let_d "read!" [p "b"]
            (apply (from_foreign "read_struct!") [name_ "b", ast.int_e 0 at_, name_ "layout"]) false at_,
        ast.let_d "write!" [p "b", p "values"]
            (apply (from_foreign "write_struct!") [name_ "b", ast.int_e 0 at_, name_ "layout", name_ "values"])
            false at_,
        ast.let_d "offset" [p "field"]
            (apply (from_foreign "offset_of") [name_ "layout", name_ "field"]) false at_,
        ast.sig_d "size" (ast.atom_e "integer" at_) at_,
        ast.sig_d "new!" (arrow (ast.atom_e "unit" at_) buffer) at_,
        ast.sig_d "read!" (arrow buffer (ast.atom_e "map" at_)) at_,
        ast.sig_d "write!" (arrow buffer (arrow (ast.atom_e "map" at_) (ast.atom_e "unit" at_))) at_,
        ast.sig_d "offset" (arrow (ast.atom_e "atom" at_) (ast.atom_e "integer" at_)) at_,
    ] at_
};

/// What every entry of one `foreign` block can see of the others.
priv let foreign_env lib entries = %{
    :lib => lib,
    :resources => list.fold (fn m e -> match e { [:resource, r, d, _] => m.[r => [d]], _ => m }) %{} entries,
    :structs => list.fold (fn m e -> match e { [:c_struct, s, _, _] => m.[s => true], _ => m }) %{} entries,
};

/// The first thing wrong with a `foreign` block's entries, as `[message,
/// span]`, or `()`. The parser asks, because only it can report one.
let foreign_problem lib entries = {
    let env = foreign_env lib entries;
    let problem r = match r { [:error, m, sp] => [m, sp], _ => () };
    list.fold (fn found e -> if found != () { found } else {
        match e {
            [:c_function, _, t, _, _] => problem (c_function env t),
            [:c_struct, _, fields, _] =>
                list.fold (fn f field -> if f != () { f } else { problem (c_type env :field (list.nth 2 field)) })
                          () fields,
            _ => (),
        }
    }) () entries
};

/// A function's C signature, `a -> b -> result`, as `[:ok, args, result,
/// dream]`: the argument and result expressions `std.ffi` reads, and the Dream
/// type of the function it makes. An `out` is not an argument on this side,
/// so it leaves the Dream arrow and joins the result: `[result, out, ..]`.
let c_function env t = {
    let sp = ast.span t;
    match arrow_parts t {
        [[], _] => [:error, "a C signature is an arrow, `args -> result`; a function of nothing is `:void -> result`", sp],
        [params, result] => {
            let taken = match params { [p] if is_void p => [], ps => ps };
            match c_types env :arg taken {
                [:error, m, s] => [:error, m, s],
                [:ok, args, dreams] => match c_type env :result result {
                    [:error, m, s] => [:error, m, s],
                    [:ok, r, rd] => {
                        let visible = list.filter (fn i -> not (is_out (list.nth i taken)))
                                                  (list.range 0 (list.length taken));
                        let outs = list.filter (fn i -> is_out (list.nth i taken))
                                               (list.range 0 (list.length taken));
                        let answer = if list.is_empty outs { rd }
                                     else { ast.list_e [ast.atom_e "tuple" sp,
                                                        ast.list_e (list_cons rd (list.map (fn i -> list.nth i dreams) outs)) sp] sp };
                        let dream_args = match visible { [] => [ast.atom_e "unit" sp], is => list.map (fn i -> list.nth i dreams) is };
                        [:ok, args, r, arrows dream_args answer]
                    },
                },
            }
        },
    }
};

priv let is_void t = match t { [:atom, "void", _] => true, [:unit, _] => true, _ => false };
priv let is_out t = match t { [:apply, [:name, "out", _], _, _] => true, _ => false };
priv let is_unit_type t = match t { [:atom, "unit", _] => true, [:unit, _] => true, _ => false };

/// `a -> b -> c` as `[[a, b], c]`; a type that is no arrow is `[[], t]`.
priv let rec arrow_parts t = match t {
    [:list, [[:atom, "fn", _], a, b], _] => {
        let [rest, result] = arrow_parts b;
        [list_cons a rest, result]
    },
    _ => [[], t],
};

priv let arrows ts result = list.fold (fn acc t -> arrow t acc) result (list.reverse ts);

priv let rec c_types env place ts = match ts {
    [] => [:ok, [], []],
    [t, ..rest] => match c_type env place t {
        [:error, m, s] => [:error, m, s],
        [:ok, f, d] => match c_types env place rest {
            [:error, m, s] => [:error, m, s],
            [:ok, fs, ds] => [:ok, list_cons f fs, list_cons d ds],
        },
    },
};

/// The C numbers, as `std.foreign` names them (`foreign.Scalar`) and the VM
/// reads them (`scalar_types` in dream/src/ffi.cpp). The compiler cannot
/// import the library it would be checking against, so the list is here too.
priv let c_scalars = ["bool", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64",
                      "char", "uchar", "short", "ushort", "int", "uint", "long", "ulong",
                      "longlong", "ulonglong", "size", "ssize", "intptr", "uintptr", "double"];

/// One C type, where it stands: `:arg`, `:result`, `:out` (what C writes
/// through a pointer), `:callback_arg`, `:callback_result` or `:field`. The
/// place matters because a word means different things in different places --
/// a resource is a handle passed in and an owned pointer handed back -- and
/// most mean nothing in some: a struct is only ever passed, by pointer.
///
/// Answers `[:ok, ffi, dream]`: the expression of what `std.ffi` reads, and
/// the Dream type of the value on this side.
let rec c_type env place t = {
    let sp = ast.span t;
    let atom a = ast.atom_e a sp;
    let fail m = [:error, m, sp];
    let lib = env.[:lib];
    match t {
        [:atom, a, _] => c_atom place a sp,
        [:unit, _] => c_atom place "void" sp,
        [:name, n, _] =>
            match [env.[:resources].[n else ()], map_has env.[:structs] n] {
                [[dtor], _] => match place {
                    :arg => [:ok, ast.list_e [atom "handle", ast.str_e (lib + "." + n) sp] sp, ast.name_e n sp],
                    :result => owned lib n dtor sp,
                    :out => owned lib n dtor sp,
                    _ => fail ("a resource is a handle, and only numbers cross a callback or sit in a struct"),
                },
                [_, true] =>
                    if place == :arg { [:ok, atom "buffer", ast.field_e (ast.name_e "foreign" sp) "Buffer" sp] }
                    else { fail ("a struct is passed by pointer, as a buffer, and nowhere else; `" + n + ".new!` makes one") },
                _ => fail ("`" + n + "` is not a resource or a struct of `" + lib + "`"),
            },
        [:apply, [:name, "out", _], [inner], _] =>
            if place != :arg { fail "`out` is a parameter C writes through, so it is only an argument" }
            else {
                match c_type env :out inner {
                    [:ok, f, d] => [:ok, ast.list_e [atom "out", f] sp, d],
                    other => other,
                }
            },
        [:apply, [:name, "borrow", _], [[:name, r, _]], _] =>
            if place != :result && place != :out { fail "`borrow` is a pointer C hands back and keeps" }
            else if not (map_has env.[:resources] r) { fail ("`" + r + "` is not a resource of `" + lib + "`") }
            else { [:ok, ast.list_e [atom "borrow", ast.str_e (lib + "." + r) sp] sp, ast.name_e r sp] },
        [:apply, [:name, "taken", _], [dtor], _] =>
            if place != :result && place != :out { fail "`taken` is a string C hands over, so it is only a result" }
            else {
                match dtor {
                    [:name, d, _] => [:ok, ast.list_e [atom "cstr", ast.str_e d sp] sp, atom "string"],
                    [:str, d, _] => [:ok, ast.list_e [atom "cstr", ast.str_e d sp] sp, atom "string"],
                    _ => fail "`taken` names the function that frees the string: `taken free`",
                }
            },
        [:list, [[:atom, "fn", _], _, _], _] =>
            if place != :arg { fail "a callback is only an argument: C cannot hand a function back" }
            else {
                let [params, result] = arrow_parts t;
                let taken = match params { [p] if is_void p => [], ps => ps };
                match c_types env :callback_arg taken {
                    [:error, m, s] => [:error, m, s],
                    [:ok, args, dreams] => match c_type env :callback_result result {
                        [:error, m, s] => [:error, m, s],
                        [:ok, r, rd] =>
                            [:ok, ast.list_e [atom "callback", ast.list_e args sp, r] sp,
                             arrows (if list.is_empty dreams { [atom "unit"] } else { dreams }) rd],
                    },
                }
            },
        // `t | ()`: a pointer that may be NULL, which is `()` on this side.
        [:list, [[:atom, "union", _], [:list, parts, _]], _] => {
            let others = list.filter (fn p -> not (is_unit_type p)) parts;
            match others {
                [one] if place == :result || place == :out => match c_type env place one {
                    [:ok, f, d] => [:ok, f, ast.list_e [atom "union", ast.list_e [d, atom "unit"] sp] sp],
                    other => other,
                },
                _ => fail "a C type is one type; `t | ()` is the one union, for a result that may be NULL",
            }
        },
        _ => fail "this is not a C type",
    }
};

priv let owned lib r dtor sp = match dtor {
    () => [:error, "`" + r + "` has no destructor, so C cannot hand one over; `borrow " + r
                   + "` is a pointer C keeps", sp],
    d => [:ok, ast.list_e [ast.atom_e "own" sp, ast.str_e (lib + "." + r) sp, ast.str_e d sp] sp,
          ast.name_e r sp],
};

priv let c_atom place a sp = {
    let atom x = ast.atom_e x sp;
    let fail m = [:error, m, sp];
    let is_ places = list.contains place places;
    if list.contains a c_scalars {
        [:ok, atom a, atom (match a { "f32" => "float", "f64" => "float", "double" => "float",
                                      "bool" => "bool", _ => "integer" })]
    }
    else {
        match a {
            "void" => if is_ [:result, :callback_result] { [:ok, atom "void", atom "unit"] }
                      else { fail "`:void` is only a result; a function of nothing is `:void -> result`" },
            "ptr" => [:ok, atom "ptr", atom "any"],
            "cstr" => if is_ [:arg, :result, :out, :callback_arg] { [:ok, atom "cstr", atom "string"] }
                      else { fail "a string cannot stand here: only numbers and `:ptr` can" },
            "bytes" => if place == :arg { [:ok, atom "bytes", atom "any"] }
                       else { fail "`:bytes` is only an argument" },
            "buffer" => if place == :arg { [:ok, atom "buffer", ast.field_e (ast.name_e "foreign" sp) "Buffer" sp] }
                        else { fail "`:buffer` is only an argument" },
            "float" => fail "there is no `:float` in C here, because in Dream that is a double: write `:f32` or `:double`",
            _ => fail ("`:" + a + "` is not a C type"),
        }
    }
};

// Validate returned data before any compiler pass assumes an AST shape. Spans
// are replaced, but requiring their usual shape catches accidental values.
let sequence check xs = type_of xs == :list && list.all check xs;
let pair check_a check_b p = match p { [a, b] => check_a a && check_b b, _ => false };
let string x = type_of x == :string;
let optional check x = x == () || check x;
let rec parameter p = match p {
    [n, sp] => (n == () || string n) && is_span sp,
    [n, sp, (), :strict] => string n && is_span sp,
    [(), sp, pat] => is_span sp && pattern pat,
    _ => false,
};
let rec pattern p = match p {
    [:wildcard, sp] => is_span sp,
    [:bind, n, sp] => string n && is_span sp,
    [:literal, e, sp] => expression e && is_span sp,
    [:list_p, xs, rest, sp] => sequence pattern xs && rest_pattern rest && is_span sp,
    [:array_p, xs, rest, sp] => sequence pattern xs && rest_pattern rest && is_span sp,
    [:map_p, xs, sp] => sequence (pair expression pattern) xs && is_span sp,
    [:as_p, p, n, ns, sp] => pattern p && string n && is_span ns && is_span sp,
    _ => false,
};
let rest_pattern p = match p {
    () => true, [()] => true, [n, sp] => string n && is_span sp, _ => false,
};
let rec statement e = match e {
    [:let, n, ps, b, rec_, sp] => string n && sequence parameter ps && expression b
                              && type_of rec_ == :bool && is_span sp,
    [:let_p, p, b, sp] => pattern p && expression b && is_span sp,
    [:sig, n, _, sp] => string n && is_span sp,
    _ => expression e,
};
let rec expression e = match e {
    [:int, v, sp] => type_of v == :integer && is_span sp,
    [:float, v, sp] => type_of v == :float && is_span sp,
    [:char, v, sp] => type_of v == :char && is_span sp,
    [:bool, v, sp] => type_of v == :bool && is_span sp,
    [:str, v, sp] => string v && is_span sp,
    [:atom, v, sp] => string v && is_span sp,
    [:unit, sp] => is_span sp,
    [:name, n, sp] => string n && is_span sp,
    [:field, obj, n, sp] => expression obj && string n && is_span sp,
    [:apply, f, args, sp] => expression f && sequence expression args && is_span sp,
    [:pipe, l, r, sp] => expression l && expression r && is_span sp,
    [:unary, op, x, sp] => list.contains op [:neg, :not] && expression x && is_span sp,
    [:binary, op, l, r, sp] => list.contains op [:add, :sub, :mul, :div, :mod,
        :eq, :ne, :lt, :le, :gt, :ge, :and, :or] && expression l && expression r && is_span sp,
    [:if, c, t, f, sp] => expression c && expression t && optional expression f && is_span sp,
    [:block, xs, sp] => sequence statement xs && is_span sp,
    [:thunk, x, sp] => expression x && is_span sp,
    [:try, b, n, h, sp] => expression b && string n && expression h && is_span sp,
    [:lambda, ps, b, sp] => sequence parameter ps && expression b && is_span sp,
    [:comp, impure, x, sp] => type_of impure == :bool && expression x && is_span sp,
    [:expand, x, sp] => expression x && is_span sp,
    [:list, xs, sp] => sequence expression xs && is_span sp,
    [:array, xs, sp] => sequence expression xs && is_span sp,
    [:map, xs, sp] => sequence (pair expression expression) xs && is_span sp,
    [:match, x, arms, sp] => expression x && sequence arm arms && is_span sp,
    [:get, x, k, f, sp] => expression x && expression k && optional expression f && is_span sp,
    [:set, x, k, v, sp] => expression x && expression k && expression v && is_span sp,
    _ => false,
};
let arm a = match a {
    [p, g, b, sp] => pattern p && optional expression g && expression b && is_span sp,
    _ => false,
};
