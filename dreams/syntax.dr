// Utilities shared by declaration sugar and macro expansion. Generated syntax
// needs distinct occurrence offsets: resolution keys names and binders by span.
import std.core;
import std.list;
import dreams.ast;

let is_span x = match x {
    [a, b] => type_of a == :integer && type_of b == :integer,
    _ => false,
};

/// Fresh offsets in a reserved part of the 32-bit source-offset space.
/// Returns [tree, next_offset]. A copied argument must be freshened too: a
/// macro may insert it twice, under two different lexical scopes.
let rec fresh tree next =
    if type_of tree != :list || list.is_empty tree { [tree, next] }
    else {
        let has_span = is_span (list.last tree);
        let parts = if has_span { list.take (list.length tree - 1) tree } else { tree };
        let [reversed, end] = list.fold (fn [acc, offset] part -> {
            let [child, after_child] = fresh part offset;
            [core.cons child acc, after_child]
        }) [[], next] parts;
        let items = list.reverse reversed;
        if has_span { [items + [[end, end + 1]], end + 2] }
        else { [items, end] }
    };

/// A value represented as an expression that constructs it, without evaluation.
let rec literal value span = match type_of value {
    :integer => ast.int_e value span,
    :float => ast.float_e value span,
    :bool => ast.bool_e value span,
    :char => ast.char_e value span,
    :string => ast.str_e value span,
    :atom => ast.atom_e (ast.atom_name value) span,
    :unit => ast.unit_e span,
    :list => ast.list_e (list.map (fn v -> literal v span) value) span,
    :array => ast.array_e (list.map (fn v -> literal v span) (core.array_to_list value)) span,
    :map => ast.map_e (list.map (fn kv -> list.map (fn v -> literal v span) kv)
                              (core.map_pairs value)) span,
    _ => ast.unit_e span,
};

/// Records are namespaces of ordinary functions over ordinary collections.
///
/// A field's default -- `mapping Config { retries = 3 }` -- is the fallback of
/// the read its accessor compiles to, and nothing else: `c.[k else d]` is one
/// opcode and already means "this, or that when it is not there". So a default
/// costs nothing where it is not used, is lazy where it is, and works the same
/// for a `group` and a `struct`, whose reads are by position.
///
/// It does *not* make `make`'s parameter optional, because arity is fixed in
/// this language and a constructor that sometimes took four arguments and
/// sometimes three would be a different function each time. `new` is that
/// other function, written out: it takes the fields that have no default, in
/// the order they were declared, and fills the rest in. So the two constructors
/// are the two honest readings of a defaulted field -- `make` says "I am giving
/// you all of it" and `new` says "give me the rest" -- and a record with no
/// defaults gets two names for the same thing, which is better than a name that
/// appears and disappears with the declaration.
///
/// Note that `new` puts the default *in the collection* rather than leaving the
/// slot empty for the accessor to fall back on. It has to for a `group` and a
/// `struct`, whose fields are positions and whose later positions would shift;
/// doing the same for a `mapping` is what makes `C.new a == C.make a 3` hold,
/// and equality is the thing a reader will assume.
///
/// A member -- `say_hi self = ..` -- is spliced in as the `let` it already is.
/// Everything generated is freshened first and the members are appended after,
/// which is not tidiness: `fresh` exists because resolution keys names and
/// binders by span, and the generated declarations need new spans because
/// several of them stand where one declaration was written and a default is
/// emitted twice. A member is written once, at a real place, so freshening it
/// would throw away the only spans a diagnostic inside it could point at.
/// Generated spans live above 2^31 and written ones below, so the two cannot
/// collide.
let record kind name fields members span = record_derived kind name fields members [] span;

let record_derived kind name fields members bases span = {
    let named f = ast.name_e (ast.field_name f) (ast.field_span f);
    let build of_field = match kind {
        :list => ast.list_e (list.map of_field fields) span,
        :array => ast.array_e (list.map of_field fields) span,
        :map => ast.map_e (list.map (fn f ->
            [ast.atom_e (ast.field_name f) (ast.field_span f), of_field f]) fields) span,
    };
    let constructor = ast.let_d "make"
        (if list.is_empty fields { [ast.param () span] }
         else { list.map (fn f -> ast.field_param f) fields })
        (build (fn f -> named f)) false span;
    // `new` names only the fields that have no default; the others are their
    // defaults, spliced where the value goes.
    let required = list.filter (fn f -> ast.field_default f == ()) fields;
    let from_default = ast.let_d "new"
        (if list.is_empty required { [ast.param () span] }
         else { list.map (fn f -> ast.field_param f) required })
        (build (fn f -> match ast.field_default f { () => named f, d => d })) false span;
    let helpers = list.concat (list.map (fn i -> {
        let f = list.nth i fields;
        let field = ast.field_name f;
        let obj = ast.name_e "record" span;
        let key = match kind { :map => ast.atom_e field span, _ => ast.int_e i span };
        [ast.let_d field [ast.param "record" span]
                   (ast.get_e obj key (ast.field_default f) span) false span,
         ast.let_d ("set_" + field) [ast.param "record" span, ast.param "value" span]
                   (ast.set_e obj key (ast.name_e "value" span) span) false span]
    }) (list.range 0 (list.length fields)));
    // Every record supplies a structural description, without changing its
    // constructors or forcing its fields. Unannotated fields accept anything.
    // Defaults are carried lazily, so membership agrees with accessor reads.
    let type_fields = list.map (fn i -> {
        let f = list.nth i fields;
        let key = if kind == :map { ast.atom_e (ast.field_name f) span }
                  else { ast.int_e i span };
        let description = match ast.field_type f { () => ast.atom_e "any" span, t => t };
        let defaults = match ast.field_default f { () => [], d => [d] };
        ast.list_e [key, description, ast.list_e defaults span] span
    }) (list.range 0 (list.length fields));
    let description = ast.let_d "type" []
        (ast.list_e [ast.atom_e "named" span, ast.str_e name span,
            ast.list_e [ast.atom_e "shape" span, literal kind span,
                        ast.list_e type_fields span] span] span) false span;
    let generated = list.head (fresh ([constructor, from_default] + helpers)
                                     (2147483648 + ast.span_start span * 128));
    let written = list.map (fn m -> ast.let_d (ast.member_name m) (ast.member_params m)
                                              (ast.member_body m) true (ast.member_span m))
                           members;
    // Each field type occurs once, so retain its written spans for diagnostics.
    ast.mod_d name (bases + generated + [description] + written) span
};

// Validate returned data before any compiler pass assumes an AST shape. Spans
// are replaced, but requiring their usual shape catches accidental values.
let sequence check xs = type_of xs == :list && list.all check xs;
let pair check_a check_b p = match p { [a, b] => check_a a && check_b b, _ => false };
let string x = type_of x == :string;
let optional check x = x == () || check x;
let rec parameter p = match p {
    [n, sp] => (n == () || string n) && is_span sp,
    [(), sp, pat] => is_span sp && pattern pat,
    _ => false,
};
let rec pattern p = match p {
    [:wildcard, sp] => is_span sp,
    [:bind, n, sp] => string n && is_span sp,
    [:literal, e, sp] => expression e && is_span sp,
    [:list_p, xs, rest, sp] => sequence pattern xs && rest_pattern rest && is_span sp,
    [:array_p, xs, rest, sp] => sequence pattern xs && rest_pattern rest && is_span sp,
    [:map_p, xs, sp] => sequence (pair expression pattern) xs && is_span sp,
    [:as_p, p, n, ns, sp] => pattern p && string n && is_span ns && is_span sp,
    _ => false,
};
let rest_pattern p = match p {
    () => true, [()] => true, [n, sp] => string n && is_span sp, _ => false,
};
let rec statement e = match e {
    [:let, n, ps, b, rec_, sp] => string n && sequence parameter ps && expression b
                              && type_of rec_ == :bool && is_span sp,
    [:let_p, p, b, sp] => pattern p && expression b && is_span sp,
    _ => expression e,
};
let rec expression e = match e {
    [:int, v, sp] => type_of v == :integer && is_span sp,
    [:float, v, sp] => type_of v == :float && is_span sp,
    [:char, v, sp] => type_of v == :char && is_span sp,
    [:bool, v, sp] => type_of v == :bool && is_span sp,
    [:str, v, sp] => string v && is_span sp,
    [:atom, v, sp] => string v && is_span sp,
    [:unit, sp] => is_span sp,
    [:name, n, sp] => string n && is_span sp,
    [:field, obj, n, sp] => expression obj && string n && is_span sp,
    [:apply, f, args, sp] => expression f && sequence expression args && is_span sp,
    [:pipe, l, r, sp] => expression l && expression r && is_span sp,
    [:unary, op, x, sp] => list.contains op [:neg, :not] && expression x && is_span sp,
    [:binary, op, l, r, sp] => list.contains op [:add, :sub, :mul, :div, :mod,
        :eq, :ne, :lt, :le, :gt, :ge, :and, :or] && expression l && expression r && is_span sp,
    [:if, c, t, f, sp] => expression c && expression t && optional expression f && is_span sp,
    [:block, xs, sp] => sequence statement xs && is_span sp,
    [:thunk, x, sp] => expression x && is_span sp,
    [:try, b, n, h, sp] => expression b && string n && expression h && is_span sp,
    [:lambda, ps, b, sp] => sequence parameter ps && expression b && is_span sp,
    [:comp, impure, x, sp] => type_of impure == :bool && expression x && is_span sp,
    [:expand, x, sp] => expression x && is_span sp,
    [:list, xs, sp] => sequence expression xs && is_span sp,
    [:array, xs, sp] => sequence expression xs && is_span sp,
    [:map, xs, sp] => sequence (pair expression expression) xs && is_span sp,
    [:match, x, arms, sp] => expression x && sequence arm arms && is_span sp,
    [:get, x, k, f, sp] => expression x && expression k && optional expression f && is_span sp,
    [:set, x, k, v, sp] => expression x && expression k && expression v && is_span sp,
    _ => false,
};
let arm a = match a {
    [p, g, b, sp] => pattern p && optional expression g && expression b && is_span sp,
    _ => false,
};
