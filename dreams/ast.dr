// The surface syntax tree.
//
// A node is a list whose head is an atom naming its form, and whose last
// element is always its span. That shape is chosen for `match`: a pass over
// the tree is a `match` on the head, and the arms read as the grammar does.
//
//     match e {
//         [:int, v, _]              => ..,
//         [:apply, callee, args, _] => ..,
//     }
//
// A span is `[start, end]` in **bytes**, which is what slices the source back
// out for a diagnostic. The lexer produces them; nothing here interprets them.
//
// Everything in this module is pure and total: these are constructors and
// accessors, and none of them can fail.

import std.core;
import std.list;

// --- spans ------------------------------------------------------------------

let span_of a b = [a, b];
let span_start s = list.nth 0 s;
let span_end s = list.nth 1 s;

/// The span covering both, for a node built out of two others.
let span_to a b = [span_start a, span_end b];

let no_span = [0, 0];

// --- expressions ------------------------------------------------------------
//
// The constructors exist so that the shape is written down once. A pass that
// reads the tree matches on it directly rather than going through accessors.

let int_e v span        = [:int, v, span];
let float_e v span      = [:float, v, span];
let char_e c span       = [:char, c, span];
let bool_e b span       = [:bool, b, span];
let str_e s span        = [:str, s, span];
let atom_e name span    = [:atom, name, span];
let unit_e span         = [:unit, span];

/// A bare name. A trailing `!` is part of `name` and is what marks it impure.
let name_e name span    = [:name, name, span];

/// `obj.field` -- module member access, and nothing else.
let field_e obj name span = [:field, obj, name, span];

/// Curried application: `f a b` is one node with two arguments.
let apply_e callee args span = [:apply, callee, args, span];

/// `lhs |> f a`. Kept as its own node rather than desugared here, because
/// lowering folds it into a *single* application -- which is what lets a
/// variadic native take everything at the call site.
let pipe_e lhs rhs span = [:pipe, lhs, rhs, span];

let unary_e op e span      = [:unary, op, e, span];
let binary_e op l r span   = [:binary, op, l, r, span];

/// `else` is optional; a missing one is `()`.
let if_e cond then_e else_e span = [:if, cond, then_e, else_e, span];

/// `{ stmt* }` -- the value is the last statement, or `()` when empty.
let block_e stmts span  = [:block, stmts, span];

/// `$( e )` -- suspended, and a value in its own right.
let thunk_e e span      = [:thunk, e, span];

let try_e body binder handler span = [:try, body, binder, handler, span];
let lambda_e params body span      = [:lambda, params, body, span];

/// `comp e` is evaluated by the compiler; `comp! e` by running it on a VM.
let comp_e impure e span = [:comp, impure, e, span];

let list_e items span   = [:list, items, span];
let array_e items span  = [:array, items, span];
let map_e pairs span    = [:map, pairs, span];

let match_e scrutinee arms span = [:match, scrutinee, arms, span];

// --- reading a node ---------------------------------------------------------

let kind e = core.head e;

/// Every node keeps its span last, however many fields it has.
let rec span e = {
    let rec last xs = if core.is_empty (core.tail xs) { core.head xs } else { last (core.tail xs) };
    last e
};

// --- operators --------------------------------------------------------------
//
// Named by atom rather than by number so that a dump of the tree reads.

let binops = [
    [:or_or, :or], [:and_and, :and],
    [:eq_eq, :eq], [:bang_eq, :ne], [:lt, :lt], [:le, :le], [:gt, :gt], [:ge, :ge],
    [:plus, :add], [:minus, :sub], [:star, :mul], [:slash, :div], [:percent, :mod],
];

/// Loosest to tightest, matching the table in the language reference. `|>` is
/// looser than all of these and is handled on its own, and application binds
/// tighter than any of them.
let precedence op =
    match op {
        :or  => 0,
        :and => 1,
        :eq  => 2, :ne => 2, :lt => 2, :le => 2, :gt => 2, :ge => 2,
        :add => 3, :sub => 3,
        :mul => 4, :div => 4, :mod => 4,
        _    => 0 - 1,
    };

/// The operator a token kind stands for, or `()` when it is not one.
///
/// A `match` rather than a walk of the table above. Every token the parser
/// meets in an infix position is asked this, and a list scan spends a dozen
/// cons cells and two calls per candidate to answer a question about one atom:
/// it was seven percent of everything the compiler did. The table stays as the
/// documentation of what an operator is; this is how it is looked up.
let infix_of token_kind =
    match token_kind {
        :or_or   => :or,  :and_and => :and,
        :eq_eq   => :eq,  :bang_eq => :ne,
        :lt      => :lt,  :le      => :le,
        :gt      => :gt,  :ge      => :ge,
        :plus    => :add, :minus   => :sub,
        :star    => :mul, :slash   => :div,
        :percent => :mod,
        _ => (),
    };

// --- declarations -----------------------------------------------------------

/// A parameter is a name, or `()` -- a slot that binds nothing, which is what
/// `let now! () = ..` uses.
let param name span = [name, span];
let param_name p = list.nth 0 p;

/// A parameter written as a pattern: `let f [a, b] = ..`. It is a slot like any
/// other -- the argument arrives in it -- and its name is `()`, because nothing
/// is bound to the argument whole; the body sees what the pattern binds.
let pattern_param pattern span = [(), span, pattern];

/// The pattern a parameter takes apart, or `()` for one that is a name.
let param_pattern p = match p { [_, _, pattern] => pattern, _ => () };

/// `let name params = body`. `rec` is recorded even though a top-level `let`
/// is always visible to itself, because it documents intent where it is used.
let let_d name params body is_rec span = [:let, name, params, body, is_rec, span];

/// `let [a, b] = pair` -- a `let` that binds what a pattern names. A node of
/// its own rather than a `let` whose name is a pattern, because everything
/// that reads a `let` reads its name as a string.
let let_pattern_d pattern body span = [:let_p, pattern, body, span];

let import_d path alias names span = [:import, path, alias, names, span];
let mod_d name items span          = [:mod, name, items, span];
let derive_d path span             = [:derive, path, span];
let virtual_d name params body span = [:virtual, name, params, body, span];
let when_d cond items span         = [:when, cond, items, span];

/// The root returned by the parser for one source file.
let module items = [:module, items];

// --- patterns ---------------------------------------------------------------
//
// A pattern forces exactly as much of the value as deciding takes, which is
// what keeps `match` usable on a lazy structure. That is lowering's business;
// here they are only recorded.

let wildcard_p span     = [:wildcard, span];
let bind_p name span    = [:bind, name, span];
let literal_p e span    = [:literal, e, span];
/// `rest` is `()` for a fixed-length pattern, `[name, name_span]` for
/// `[a, ..rest]`, and `[()]` for a `..` that matches the rest without naming it.
///
/// A named rest keeps the span of its name, and so does the alias of an `as`.
/// Every binder is found again by where it was written, and both of these used
/// to borrow the span of a larger pattern that starts at the same byte: in
/// `[x, ..rest] as whole` the list, its rest and the whole `as` all begin at
/// the `[`, so `rest` and `whole` were given one slot, and `whole` came out
/// holding the rest.
let list_p items rest span  = [:list_p, items, rest, span];
let array_p items rest span = [:array_p, items, rest, span];
let map_p pairs span        = [:map_p, pairs, span];
let as_p inner name name_span span = [:as_p, inner, name, name_span, span];

/// One `pattern => body`, with an optional guard checked after the pattern
/// matched, so it can use what the pattern bound.
let arm pattern guard body span = [pattern, guard, body, span];
let arm_pattern a = list.nth 0 a;
let arm_guard a   = list.nth 1 a;
let arm_body a    = list.nth 2 a;

// --- tests -------------------------------------------------------------------

when test {
    import std.test;

    let tests = [
        test.case "a span keeps its byte endpoints"
            $( test.eq! [2, 7] (span_of 2 7) ),
        test.case "span_to covers its two inputs"
            $( test.eq! [2, 13] (span_to [2, 7] [8, 13]) ),
        test.case "every expression keeps its kind and span"
            $( test.eq! [:int, [4, 6]]
                        [kind (int_e 42 [4, 6]), span (int_e 42 [4, 6])] ),
        test.case "an application holds all of its arguments"
            $( test.eq! [:apply, [:name, "f", [0, 1]],
                         [[:int, 1, [2, 3]], [:int, 2, [4, 5]]], [0, 5]]
                        (apply_e (name_e "f" [0, 1])
                                 [int_e 1 [2, 3], int_e 2 [4, 5]] [0, 5]) ),
        test.case "a pipe remains distinct until lowering"
            $( test.eq! [:pipe, [:name, "x", [0, 1]], [:name, "f", [5, 6]], [0, 6]]
                        (pipe_e (name_e "x" [0, 1]) (name_e "f" [5, 6]) [0, 6]) ),
        test.case "token kinds map to binary operators"
            $( test.eq! [:add, :eq, ()]
                        [infix_of :plus, infix_of :eq_eq, infix_of :ident] ),
        test.case "binary precedence follows the parser ladder"
            $( test.eq! [0, 1, 2, 3, 4, -1]
                        [precedence :or, precedence :and, precedence :eq,
                         precedence :add, precedence :mul, precedence :unknown] ),
        test.case "a declaration records recursion and parameters"
            $( test.eq! [:let, "go", [["n", [4, 5]]], [:name, "n", [8, 9]], true, [0, 9]]
                        (let_d "go" [param "n" [4, 5]] (name_e "n" [8, 9]) true [0, 9]) ),
        test.case "a pattern parameter is a slot that names no value"
            $( test.eq! [(), [:list_p, [], (), [4, 6]]]
                        [param_name (pattern_param (list_p [] () [4, 6]) [4, 6]),
                         param_pattern (pattern_param (list_p [] () [4, 6]) [4, 6])] ),
        test.case "a named parameter takes nothing apart"
            $( test.eq! () (param_pattern (param "x" [0, 1])) ),
        test.case "a literal pattern keeps the expression it will compare"
            $( test.eq! [:literal, [:atom, "ok", [0, 3]], [0, 3]]
                        (literal_p (atom_e "ok" [0, 3]) [0, 3]) ),
        test.case "pattern arms expose their pieces"
            $( test.eq! [[:bind, "x", [0, 1]], (), [:name, "x", [5, 6]]]
                        [arm_pattern (arm (bind_p "x" [0, 1]) () (name_e "x" [5, 6]) [0, 6]),
                         arm_guard (arm (bind_p "x" [0, 1]) () (name_e "x" [5, 6]) [0, 6]),
                         arm_body (arm (bind_p "x" [0, 1]) () (name_e "x" [5, 6]) [0, 6])] ),
    ];
}

// --- rendering --------------------------------------------------------------
//
// A node as text, without spans. This is what `--ast` prints, and what the
// parser's own tests compare against -- a tree written out in one line is far
// easier to read in a failure than a nest of lists with byte offsets in it.

import std.str;

/// A string as it would be written in source. `to_string` is the identity on
/// a plain string, which in a dump loses the very thing that tells a string
/// from a name -- `(str hi)` and `(name hi)` should not look alike.
let quote_str s =
    "\"" + str.join_str "" (list.map (fn ch ->
        if ch == '"' { "\\\"" }
        else if ch == '\\' { "\\\\" }
        else if ch == '\n' { "\\n" }
        else if ch == '\t' { "\\t" }
        else { str.of_chars [ch] }) (str.chars s)) + "\"";

/// An atom's name, without the leading `:`. Operators are atoms, and a tree
/// reads better with `(binary add ..)` than `(binary :add ..)`.
let atom_name a = { let s = to_string a; str.slice 1 (str.byte_length s - 1) s };

let rec show e =
    match e {
        [:int, v, _]        => "(int " + to_string v + ")",
        [:float, v, _]      => "(float " + to_string v + ")",
        [:char, ch, _]      => "(char '" + str.of_chars [ch] + "')",
        [:bool, b, _]       => "(bool " + to_string b + ")",
        [:str, s, _]        => "(str " + quote_str s + ")",
        [:atom, n, _]       => "(atom " + n + ")",
        [:unit, _]          => "(unit)",
        [:name, n, _]       => "(name " + n + ")",
        [:field, o, n, _]   => "(field " + show o + " " + n + ")",
        [:apply, f, args, _] => "(apply " + show f + " " + show_all args + ")",
        [:pipe, l, r, _]    => "(pipe " + show l + " " + show r + ")",
        [:unary, op, x, _]  => "(unary " + atom_name op + " " + show x + ")",
        [:binary, op, l, r, _] => "(binary " + atom_name op + " " + show l + " " + show r + ")",
        [:if, cond, t, el, _] =>
            "(if " + show cond + " " + show t + (if el == () { "" } else { " " + show el }) + ")",
        [:block, stmts, _]  => "(block" + (if list.is_empty stmts { "" } else { " " + show_all stmts }) + ")",
        [:thunk, x, _]      => "(thunk " + show x + ")",
        [:try, b, binder, h, _] => "(try " + show b + " " + binder + " " + show h + ")",
        [:lambda, ps, b, _] => "(fn " + show_params ps + " " + show b + ")",
        [:comp, impure, x, _] => "(" + (if impure { "comp!" } else { "comp" }) + " " + show x + ")",
        [:list, xs, _]      => "(list " + show_all xs + ")",
        [:array, xs, _]     => "(array " + show_all xs + ")",
        [:map, pairs, _]    => "(map " + show_pairs pairs + ")",
        [:match, s, arms, _] => "(match " + show s + " " + show_arms arms + ")",
        [:let, n, ps, b, is_rec, _] =>
            "(let " + (if is_rec { "rec " } else { "" }) + n
            + (if list.is_empty ps { "" } else { " " + show_params ps }) + " " + show b + ")",
        [:let_p, pattern, b, _] => "(let " + show_pattern pattern + " " + show b + ")",
        [:import, segments, alias, names, _] =>
            "(import " + str.join_str "." segments
            + (match names { () => "", ns => ".{" + show_import_names ns + "}" })
            + (match alias { () => "", a => " as " + a })
            + ")",
        [:derive, segments, _]  => "(derive " + str.join_str "." segments + ")",
        [:mod, n, items, _]     => "(mod " + n + " " + show_all items + ")",
        [:virtual, n, ps, body, _] =>
            "(virtual " + n + (if list.is_empty ps { "" } else { " " + show_params ps })
            + (match body { () => "", b => " " + show b }) + ")",
        [:when, cond, items, _] => "(when " + show_cfg cond + " " + show_all items + ")",
        other => "(?" + to_string (core.head other) + ")",
    }
;

let show_all xs = str.join_str " " (list.map (fn x -> show x) xs)
;

let show_params ps =
    str.join_str " " (list.map (fn p ->
        match param_pattern p {
            () => match param_name p { () => "()", n => n },
            pattern => show_pattern pattern,
        }) ps)
;

let show_pairs pairs =
    str.join_str " " (list.map (fn kv -> "[" + show (list.nth 0 kv) + " " + show (list.nth 1 kv) + "]") pairs)
;

let show_arms arms = str.join_str " " (list.map (fn a -> show_arm a) arms)
;

let show_arm a =
    "[" + show_pattern (arm_pattern a)
        + (match arm_guard a { () => "", g => " if " + show g })
        + " " + show (arm_body a) + "]"
;

let rec show_pattern p =
    match p {
        [:wildcard, _]      => "_",
        [:bind, n, _]       => n,
        [:literal, e, _]    => show e,
        [:list_p, items, rest, _]  => "[" + show_items items rest + "]",
        [:array_p, items, rest, _] => "#[" + show_items items rest + "]",
        [:map_p, pairs, _]  =>
            "%{" + str.join_str " " (list.map (fn kv -> show (list.nth 0 kv) + " => "
                                                        + show_pattern (list.nth 1 kv)) pairs) + "}",
        [:as_p, inner, n, _, _] => "(" + show_pattern inner + " as " + n + ")",
        other => "?" + to_string (core.head other),
    }
;

let show_items items rest = {
    let shown = str.join_str " " (list.map (fn i -> show_pattern i) items);
    let tail = match rest {
        ()     => "",
        [()]   => "..",
        [n, _] => ".." + n,
        _      => "",
    };
    if tail == "" { shown }
    else if str.is_empty shown { tail }
    else { shown + " " + tail }
};

/// `{ map, filter, sum as total }` -- the members an import binds directly.
let show_import_names ns =
    str.join_str " " (list.map (fn n ->
        match list.nth 1 n { () => list.nth 0 n, a => list.nth 0 n + " as " + a }) ns);

/// A `when` condition. The vocabulary is the language's own, so it renders
/// the same way the rest of the tree does.
let rec show_cfg c =
    match c {
        [:const, b]        => "(const " + to_string b + ")",
        [:flag, n]         => "(flag " + n + ")",
        [:equals, n, v]    => "(equals " + n + " " + quote_str v + ")",
        [:not, e]          => "(not " + show_cfg e + ")",
        [:and, l, r]       => "(and " + show_cfg l + " " + show_cfg r + ")",
        [:or, l, r]        => "(or " + show_cfg l + " " + show_cfg r + ")",
        other              => "(?cfg)",
    };
