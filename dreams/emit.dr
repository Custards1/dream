// The image writer: an arena of execution trees, as bytes.
//
// Layout:
//
//     Header      32 bytes
//     Section     16 bytes x section count   (kind, offset, byte length, count)
//     Sections    each 8-byte aligned, in table order
//
// Every section is a plain array of fixed-size little-endian records, and every
// cross-reference is an index rather than an offset. So a loader can map the
// file, slice the node and kid sections, and start forcing the execution tree
// without parsing anything and without a relocation pass. That requirement is
// what drove the whole design, and it is why nothing here is clever: the
// cleverness would have to be undone at load time.
//
// The bytes this produces are a pure function of the program. Nothing is
// written in hash order or in the order a map happened to iterate, because a
// compiler that compiles itself has to be able to compare the image it built
// against the one that built it -- and "the same program" has to mean the same
// bytes.
//
// Every piece here is a *string*, not a list of bytes, and that is a decision
// about cost rather than about taste. A megabyte image as a list is a million
// cons cells and a thunk behind most of them -- some four million objects for
// the collector to copy, to produce 920 kilobytes. As strings it is one short
// string per record, a few tens of thousands of them, joined once by
// `str.concat_all`, which copies each part exactly once. The arithmetic below
// still works a byte at a time, because that is what little-endian means; what
// changed is that the bytes become a string as soon as they are a record.

import std.list;
import std.str;

import dreams.ir;

/// `DAGNCAAF`, as the loader looks for it.
let magic = str_of_bytes [68, 65, 71, 78, 67, 65, 65, 70];

let version_major = 0;
let version_minor = 1;

let header_size = 32;
let section_entry_size = 16;

/// The span section is present.
let flag_debug = 1;

// --- numbers as bytes ------------------------------------------------------------
//
// Little-endian throughout, because every machine this runs on is, and a loader
// that has to swap bytes cannot map the file and use it where it lies.

let byte_at : :integer -> :integer -> :integer;
let byte_at v n = (v / n) % 256;

/// Each of these answers a *string* of the bytes. `str_le` is what makes
/// bytes rather than characters: a byte over 127 encoded as a character would
/// be two bytes of UTF-8, and an image is bytes or it is nothing.
///
/// These were `str_of_bytes` over a list literal, which is the obvious
/// way to say it and was the single largest allocator in the compiler -- a
/// cons cell and a thunk per byte, a frame for each `byte_at`, and a nested
/// force inside `str_of_bytes` to read them back, for 128 MB of garbage per
/// self-compile. `str_le` is the same field with no list in the middle.
let u8 : :integer -> :string;
let u8 v = str_le v 1;
let u16 : :integer -> :string;
let u16 v = str_le v 2;
let u32 : :integer -> :string;
let u32 v = str_le v 4;

/// A 64-bit signed integer. Two's complement, so a negative one is written as
/// what it would be if it were unsigned.
///
/// The negative case is worked out from `-v` in 32-bit halves rather than by
/// adding 2^64. The whole 64-bit range does not fit in a Dream integer, and a
/// literal that large is read as a *float* -- which turns every byte computed
/// from it into a float too, and an image is bytes or it is nothing. Nothing
/// here may leave the range where integers are exact.
let i64 : :integer -> :string;
let i64 v =
    if v < 0 {
        // -v, split into its low and high 32-bit halves.
        let a = 0 - v;
        let a_low = a % 4294967296;
        let a_high = (a / 4294967296) % 4294967296;
        // 2^64 - a, done as a subtraction with a borrow out of the low half.
        let low = (4294967296 - a_low) % 4294967296;
        let high = (4294967295 - a_high + (if a_low == 0 { 1 } else { 0 })) % 4294967296;
        u32 low + u32 high
    } else {
        u32 (v % 4294967296) + u32 ((v / 4294967296) % 4294967296)
    };

/// An unsigned 64-bit number, as eight bytes.
///
/// The same arithmetic as the positive half of `i64`, said separately because
/// what it writes is a *length* -- a payload's, or a datum's position inside
/// one -- and a length is never negative. Nothing a payload table holds comes
/// near the range where a Dream integer stops being exact.
let u64 : :integer -> :string;
let u64 v = u32 (v % 4294967296) + u32 ((v / 4294967296) % 4294967296);

/// A node index, or the all-ones word that means there is none.
let index i = if ir.is_node i { u32 i } else { u32 4294967295 };

/// A `float`, by its bit pattern, so that what comes back is exactly the value
/// that went in -- including a negative zero and every kind of NaN. The VM
/// hands the eight bytes over rather than the compiler picking a double apart,
/// because getting that wrong is silent.
/// The VM hands over the eight bytes as a string already, so there is nothing
/// left to do to them.
let f64 v = float_bytes v;

// --- sections ---------------------------------------------------------------------

/// A section, with its length worked out once. A section body is a string, so
/// its length is a field read rather than a walk -- and it is asked for three
/// times over, in the table, in the layout, and in the padding.
mapping Section {
    kind = 0
    body = ""
    count = 0
    len = 0
}

let section kind body count = Section.make kind body count (str.byte_length body);

let sec_kind s = Section.kind s;
let sec_body s = Section.body s;
let sec_count s = Section.count s;
let sec_len s = Section.len s;

/// A four-character tag, read as a little-endian word the way the loader reads
/// it. Written out as the characters so that a hex dump of an image says what
/// each section is.
let tag : :integer -> :integer -> :integer -> :integer -> :integer;
let tag a b c d = a + b * 256 + c * 65536 + d * 16777216;

let t_kint = tag 75 73 78 84;   // KINT
let t_kflt = tag 75 70 76 84;   // KFLT
let t_kstr = tag 75 83 84 82;   // KSTR
let t_sblb = tag 83 66 76 66;   // SBLB
let t_katm = tag 75 65 84 77;   // KATM
let t_node = tag 78 79 68 69;   // NODE
let t_kids = tag 75 73 68 83;   // KIDS
let t_func = tag 70 85 78 67;   // FUNC
let t_glbl = tag 71 76 66 76;   // GLBL
let t_impt = tag 73 77 80 84;   // IMPT
let t_span = tag 83 80 65 78;   // SPAN
let t_mods = tag 77 79 68 83;   // MODS
let t_ldat = tag 76 68 65 84;   // LDAT
let t_payl = tag 80 65 89 76;   // PAYL
let t_ityp = tag 73 84 89 80;   // ITYP
let t_type = tag 84 89 80 69;   // TYPE

// --- the records ---------------------------------------------------------------------

/// Every record of a section, joined once. The joining is what keeps this
/// linear: a fold of `+` over fifty thousand records would copy the section so
/// far on each one.
let concat_map f xs = str.concat_all (list.map f xs);

let node_bytes [op, flags, a, b, c] =
    str.concat_all [
        u8 (match ir.opcode op { () => 0, code => code }),
        u8 flags,
        u16 0,
        index a,
        index b,
        index c,
    ];

let func_bytes f =
    str.concat_all [
        u32 (f.[:name else 0]),
        index (f.[:body else ir.no_node]),
        u16 (f.[:arity else 0]),
        u16 (f.[:flags else 0]),
        u16 (f.[:slots else 0]),
        u16 (f.[:n_captures else 0]),
        u32 (f.[:captures_off else 0]),
        u32 (f.[:span_start else 0]),
        u32 (f.[:span_end else 0]),
        u32 0,   // reserved
    ];

let global_bytes g =
    str.concat_all [
        u32 (g.[:name else 0]),
        u32 (g.[:kind else 0]),
        index (g.[:target else ir.no_node]),
        u32 (g.[:flags else 0]),
    ];

let import_bytes i = u32 (i.[:path else 0]) + u32 (i.[:alias else 0]);

let module_bytes m =
    str.concat_all [
        u32 (m.[:name else 0]),
        u32 (m.[:source else 0]),
        u32 (m.[:globals_start else 0]),
        u32 (m.[:globals_count else 0]),
        u32 (m.[:flags else 0]),
        index (m.[:derives else ir.no_node]),
    ];

/// Strings are an offset-and-length table into one contiguous blob, so that a
/// loader can point at a string rather than copy it.
let string_table strs = {
    let offsets = list.reverse (list.nth 1 (list.fold_strict (fn acc s ->
        [list.head acc + str.byte_length s,
         list_cons [list.head acc, str.byte_length s] (list.nth 1 acc)])
        [0, []] strs));
    concat_map (fn e -> u32 (list.head e) + u32 (list.nth 1 e)) offsets
};

// --- the whole image ------------------------------------------------------------------

let align8 n = (n + 7) - ((n + 7) % 8);

/// `n` zero bytes. Sections are eight-byte aligned so a loader can point a
/// struct at one where it lies.
let zeros : :integer -> :string;
let zeros n = str.repeat n (str_of_bytes [0]);

// --- large data ---------------------------------------------------------------------
//
// A payload is the one thing in an image the compiler never holds. Every other
// section is built here as a string, and a Dream string counts its bytes in 32
// bits -- which is the very limit the payload exists to get past. So what the
// compiler lays out is the *table*: how long each datum is, and therefore where
// it starts. The bytes themselves are copied from their files straight into the
// output, by whoever is doing the writing, after everything here has been
// written. See `copy_payloads!` in main.dr.

/// The running offset of each datum, from the start of the payload bytes.
///
/// Consecutive and unpadded: a datum is found by the offset the table records
/// and nothing about the next one depends on where this one ended up, so there
/// is nothing for alignment to buy.
let data_offsets lens =
    list.reverse (list.nth 1 (list.fold_strict (fn acc n ->
        [list.head acc + n, list_cons (list.head acc) (list.nth 1 acc)])
        [0, []] lens));

/// `LDAT` and `PAYL`, or nothing at all.
///
/// Nothing at all is the important half. A build with no payload must write the
/// bytes it wrote before any of this existed -- that is what the bootstrap
/// compares, and an empty section pair would break the equality without
/// carrying anything.
let data_sections lens =
    if list.is_empty lens { [] }
    else {
        let offsets = data_offsets lens;
        let total = list.fold (fn n len -> n + len) 0 lens;
        // `PAYL`'s body is its eight-byte length header and no more. The bytes
        // follow it in the file but not in the section, because the section
        // table counts in 32 bits and the payload may not fit there. The real
        // size is the header, which is why it is written at all.
        [section t_ldat (concat_map (fn e -> u64 (list.head e) + u64 (list.nth 1 e))
                                    (list.zip offsets lens))
                 (list.length lens),
         section t_payl (u64 total) 0]
    };

/// `TYPE` or `ITYP`, or nothing: one 16-byte record per function whose signature
/// declares a parameter of the corresponding type -- the function, a reserved word, and a 64-bit
/// mask of which parameters. A program with no such signature writes the bytes
/// it wrote before the section existed, for the reason `data_sections` gives.
let type_sections kind hints =
    if list.is_empty hints { [] }
    else {
        [section kind (concat_map (fn e -> u32 (list.head e) + u32 0 + u64 (list.nth 1 e)) hints)
                 (list.length hints)]
    };

/// Every section, in the order a reader meets them.
let sections_of img = {
    let strs = img.[:strs else []];
    // The blob is the strings, one after another: nothing has to be done to a
    // string to turn it into its own bytes.
    let blob = str.concat_all strs;
    let base =
    [section t_kint (concat_map (fn v -> i64 v) (img.[:ints else []])) (list.length (img.[:ints else []])),
     section t_kflt (concat_map (fn v -> f64 v) (img.[:floats else []])) (list.length (img.[:floats else []])),
     section t_kstr (string_table strs) (list.length strs),
     section t_sblb blob (str.byte_length blob),
     section t_katm (concat_map (fn v -> u32 v) (img.[:atoms else []])) (list.length (img.[:atoms else []])),
     section t_node (concat_map (fn n -> node_bytes n) (img.[:nodes else []])) (list.length (img.[:nodes else []])),
     section t_kids (concat_map (fn k -> index k) (img.[:kids else []])) (list.length (img.[:kids else []])),
     section t_func (concat_map (fn f -> func_bytes f) (img.[:funcs else []])) (list.length (img.[:funcs else []])),
     section t_glbl (concat_map (fn g -> global_bytes g) (img.[:globals else []])) (list.length (img.[:globals else []])),
     section t_impt (concat_map (fn i -> import_bytes i) (img.[:imports else []])) (list.length (img.[:imports else []])),
     section t_mods (concat_map (fn m -> module_bytes m) (img.[:modules else []])) (list.length (img.[:modules else []]))];
    // The payload goes last, and must: its bytes are written after everything
    // the table describes, and they are the one part of the file whose size a
    // `u32` offset could not reach.
    list.concat [base, type_sections t_type (img.[:float_params else []]),
                 type_sections t_ityp (img.[:integer_params else []]),
                 data_sections (img.[:payloads else []])]
};

/// The image, as bytes.
///
/// Assembled by concatenating a list of pieces exactly once. The obvious way --
/// appending each section to what has been written so far -- copies everything
/// written so far every time, which for a megabyte of image is a hundred
/// megabytes of copying and was the difference between compiling this compiler
/// and running out of memory trying.
let emit : ir.Image -> :string;
let emit img = {
    let secs = sections_of img;
    let table_end = header_size + list.length secs * section_entry_size;

    // Offsets are absolute, so where each section lands is worked out before
    // the table that names them is written.
    let laid_out = list.fold (fn acc s -> {
        let at = align8 (list.head acc);
        [at + sec_len s, list.append (list.nth 1 acc) [at]]
    }) [align8 table_end, []] secs;
    let placed = list.nth 1 laid_out;
    let ends = align8 (list.head laid_out);

    let header = str.concat_all [
        magic,
        u16 version_major, u16 version_minor,
        u32 0,                                    // flags: no span section yet
        u32 (img.[:module_name else 0]),
        u32 (img.[:source_name else 0]),
        index (img.[:entry else ir.no_node]),
        u32 (list.length secs),
    ];

    let table = concat_map (fn pair -> {
        let s = list.head pair;
        str.concat_all [u32 (sec_kind s), u32 (list.nth 1 pair), u32 (sec_len s), u32 (sec_count s)]
    }) (list.zip secs placed);

    // Each section, preceded by the padding that puts it exactly where the
    // table said it would be. The pieces are collected and concatenated once,
    // at the end.
    let assembled = list.fold_strict (fn acc pair -> {
        let s = list.head pair;
        let at = list.nth 1 pair;
        [at + sec_len s,
         list_cons (sec_body s) (list_cons (zeros (at - list.head acc)) (list.nth 1 acc))]
    }) [str.byte_length header + str.byte_length table, []] (list.zip secs placed);

    let written = list.head assembled;
    // The pieces are collected front to back by consing, which puts them in
    // reverse; the whole image is one concatenation of them.
    let pieces = list.reverse (list.nth 1 assembled);
    str.concat_all (list.concat [[header, table], pieces, [zeros (ends - written)]])
};

/// The image as a string, which is what `io.write!` takes. It is one already:
/// every piece was built as bytes rather than as characters, which is the
/// difference between binary and UTF-8.
let to_binary : ir.Image -> :string;
let to_binary img = emit img;

/// Where the header keeps `entry`. Fixed by the format -- see the header
/// table in [docs/bytecode-format.md](../docs/bytecode-format.md) -- which is
/// what makes the next function possible at all.
let entry_offset = 24;

/// The same image, entered at a different function.
///
/// Every compile-time expression in a program is *that program* with one
/// other entry point: `settle_comp!` used to build the whole image again for
/// each one, and on a self-compile that was 30% of every reduction the
/// compiler made and a fifth of everything it allocated -- 121M reductions
/// and 1.2 GB, to write the same twenty-four thousand node records twenty
/// times over. Since the one field that differs sits at a fixed offset, the
/// answer is the bytes either side of it and a fresh four.
///
/// This is the same lesson `expand` learnt about macros, which is that a
/// compile-time evaluation should cost its *expression*, not its program.
let with_entry : :string -> :integer -> :string;
let with_entry bytes fi = str.concat_all [
    str.slice 0 entry_offset bytes,
    index fi,
    str.slice (entry_offset + 4) (str.byte_length bytes) bytes,
];
