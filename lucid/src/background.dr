// One persistent compiler worker owns its parse cache. Diagnostics and type
// hints may take seconds on a cold program; they must never stop the process
// reading editor requests. Only finished replies cross back, not compiler heaps.
import std.list;
import std.map;
import std.proc;

import analysis;
import rpc;

let snapshot : :string -> [:string] -> :map -> :integer -> :map;
let snapshot path roots docs revision =
    %{ :path => path, :roots => roots, :docs => docs, :revision => revision };

let analyse! : :map -> :map -> :any -> [:any];
let analyse! job parsed previous = match previous {
    [same, a, hints] if same == job && analysis.current! job.[:path] job.[:roots] job.[:docs] a => [a, hints],
    _ => [analysis.analyse_cached! job.[:path] job.[:roots] job.[:docs] parsed, ()],
};

/// A burst of edits names revisions that nobody will ever see. Take the latest
/// job for each file after a short quiet interval, leaving requests in the
/// mailbox so they are answered before the next diagnostic batch.
let latest! : :map -> :integer -> [:map];
let rec latest! jobs deadline = match proc.recv_until!
    (fn m -> match m { [:check, _] => true, _ => false }) deadline {
    Result.ok([:check, job]) => latest! (jobs.[job.[:path] => job]) deadline,
    _ => map.values jobs,
};

let requested : :map -> :map -> :any -> [:any];
let requested a m held = {
    let p = rpc.params m;
    let position = p.["position" else (%{})];
    let line = position.["line" else 0];
    let character = position.["character" else 0];
    match rpc.method m {
        "textDocument/inlayHint" => {
            let range = p.["range" else (%{})];
            let first = (range.["start" else (%{})]).["line" else 0];
            let last = (range.["end" else (%{})]).["line" else 1000000000];
            let hints = match held { () => analysis.inlay_hints a 0 1000000000, hs => hs };
            let shown = list.filter (fn h -> {
                let at = (h.["position"]).["line"];
                at >= first && at <= last
            }) hints;
            [Result.ok shown, hints]
        },
        "textDocument/prepareRename" => [analysis.prepare_rename_at a line character, held],
        "textDocument/rename" => [analysis.rename_at a line character (p.["newName" else ""]), held],
        _ => [Result.ok (), held],
    }
};

let checked! : :process -> :map -> :map -> :any -> [:any];
let checked! parent job parsed previous = {
    let [a, held] = analyse! job parsed previous;
    let groups = analysis.diagnostics_by_path a;
    strict! groups
    send! parent [:diagnostics, job, groups]
    [map.merge parsed (analysis.parses a), [job, a, held]]
};

let serve! : :process -> :map -> :any -> [:map] -> :any;
let rec serve! parent parsed previous pending = {
    // Interactive requests already queued beat the next background check.
    let incoming = match proc.recv_until!
        (fn m -> match m { [:request, _, _] => true, _ => false }) 0 {
        Result.ok(m) => m,
        _ => match pending { [] => recv! (), [job, .._] => [:check_now, job] },
    };
    match incoming {
        [:request, job, m] => {
            let [a, held] = analyse! job parsed previous;
            let [result, hints] = requested a m held;
            strict! result
            strict! hints
            send! parent [:background_reply, job, rpc.id m, result]
            serve! parent (map.merge parsed (analysis.parses a)) [job, a, hints] pending
        },
        [:check, job] => {
            let queued = list.fold_strict (fn acc j -> acc.[j.[:path] => j]) (%{}) pending;
            let jobs = latest! (queued.[job.[:path] => job]) (proc.deadline_in! 100);
            serve! parent parsed previous jobs
        },
        [:check_now, job] => {
            let queued = list.fold_strict (fn acc j -> acc.[j.[:path] => j]) (%{}) pending;
            let newer = latest! queued 0;
            let done = checked! parent (list.head newer) parsed previous;
            serve! parent (list.head done) (list.nth 1 done) (list.tail newer)
        },
        _ => serve! parent parsed previous pending,
    }
};

let start! : :process -> :process;
let start! !parent = spawn! $( serve! parent (%{}) () [] );
