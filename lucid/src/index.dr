// Interactive questions need this file's names and the declaration being
// pointed at. Loading every transitive dependency, resolving its bodies and
// checking its types belongs to diagnostics, not to the next mouse click.
// This index still uses the compiler's parser, module rewrites and resolver;
// it loads the requested imports and walks only bodies in the current file.
import std.file as files;
import std.lazy;
import std.list;
import std.map;
import std.path;
import std.str;

import dreams.ast;
import dreams.config;
import dreams.diag;
import dreams.expand as expansion;
import dreams.modules;
import dreams.package;
import dreams.parser;
import dreams.scope;
import dreams.typecheck;

import analysis;
import declarations;
import pos;

/// Include dependencies inside inline modules and conditional declarations,
/// including imports the record rewrite generates. Marking these visited lets
/// the ordinary loader register one file without following its import graph.
let dependencies : :any -> [:string];
let rec dependencies tree = match tree {
    [:import, segs, _, _, _] => [str.join_str "." segs],
    [:derive, segs, _] => [str.join_str "." segs],
    [:let, _, _, _, _, _] => [],
    [:sig, _, _, _] => [],
    [:macro, _, _, _, _] => [],
    xs if type_of xs == :list => flat_map dependencies xs,
    _ => [],
};

let parsed! : :string -> :map -> :map -> [:any];
let parsed! file docs cache = {
    let text = docs.[file else (match files.read! file { () => "", s => s })];
    let result = match cache.[file else ()] {
        [same, p] if same == text => p,
        _ => parser.parse_module text,
    };
    strict! result
    [text, result]
};

let items : :any -> [ast.Decl];
let items parsed = match parsed { [:ok, ds, _] => ds, _ => [] };

/// What import could lead to the cursor's chain. Selective and renamed
/// imports bind the names the compiler says they do; derives are always
/// needed because an inherited definition can be named without a prefix.
let wanted_imports : :any -> :any -> [:string];
let rec wanted_imports tree wanted = match tree {
    [:import, _, _, _, _] if type_of wanted == :map =>
        list.unique (flat_map (fn name -> wanted_imports tree name) (map.keys wanted)),
    [:import, segs, alias, selected, _] => {
        let dep = str.join_str "." segs;
        let first = list.head (str.split "." wanted);
        let bound = scope.default_alias segs alias;
        let selects = selected != () && list.any (fn pair ->
            match list.nth 1 pair { () => list.head pair, n => n } == first) selected;
        if wanted == "*" || selects { [dep] }
        else if first == bound {
            let suffix = str.slice (len first) (len wanted - len first) wanted;
            [dep + suffix]
        }
        else if wanted == dep || str.starts_with (dep + ".") wanted { [wanted] }
        else { [] }
    },
    [:derive, segs, _] => [str.join_str "." segs],
    [:let, _, _, _, _, _] => [],
    [:sig, _, _, _] => [],
    [:macro, _, _, _, _] => [],
    xs if type_of xs == :list => flat_map (fn x -> wanted_imports x wanted) xs,
    _ => [],
};

/// An import may end in an inline module or a selected member. The nearest
/// enclosing file owns its declaration. Package roots and source directories
/// come from compiler discovery for the importing file, even across packages.
let rec import_file! locator dotted = match modules.resolve_path! locator dotted {
    file if file != () => [file, dotted],
    _ => {
        let segs = str.split "." dotted;
        if list.length segs <= 1 { () }
        else { import_file! locator (str.join_str "." (list.take (list.length segs - 1) segs)) }
    },
};

let add_with! : modules.Loader -> :string -> [:string] -> :map -> :any -> :any -> [:string] -> modules.Loader;
let rec add_with! l file roots docs wanted full !visiting = {
    let absolute = path.absolute! file;
    if map.has absolute (modules.by_path l) || list.contains absolute visiting { l }
    else {
        let [text, parsed] = if full != () {
            let text = docs.[file else (match files.read! file { () => "", s => s })];
            let parsed = match (modules.parsed l).[file else ()] {
                [same, p] if same == text => p,
                _ => declarations.parse text,
            };
            [text, parsed]
        } else { parsed! file docs (modules.parsed l) };
        let kept = modules.with_parsed ((modules.parsed l).[file => [text, parsed]]) l;
        let locator = modules.loader (package.discover! file roots) (config.defaults! ())
                          (modules.default_search_paths! file roots) [];
        let requested = list.unique (wanted_imports (items parsed) wanted);
        let before = fold (fn acc dep -> {
            if modules.is_host acc dep { modules.record_native dep acc }
            else { match import_file! locator dep {
                () => acc,
                [target, spelling] => {
                    let loaded = add_with! acc target roots docs "" full (list.cons absolute visiting);
                    let mi = (modules.by_path loaded).[(path.absolute! target) else ()];
                    if mi == () { loaded }
                    else { modules.Loader.set_by_name ((modules.by_name loaded).[spelling => mi]) loaded }
                },
            } }
        }) kept requested;
        let name = modules.canonical_name! before file (path.stem file);
        let expanded = modules.expand_items name (modules.config_in before name) (items parsed);
        let skipped = fold (fn acc dep -> modules.mark_visited dep acc)
                          before (dependencies expanded);
        modules.load_text! skipped text file name file
    }
};

let add! : modules.Loader -> :string -> [:string] -> :map -> :string -> [:string] -> modules.Loader;
let add! l file roots docs wanted visiting = add_with! l file roots docs wanted () visiting;

let chain_at : :string -> :integer -> :integer -> :string;
let chain_at text line character = {
    let here = analysis.name_start text (pos.offset_of text line character);
    let start = analysis.chain_start text here;
    str.slice start (analysis.name_end text here - start) text
};

/// Build a small declaration environment, then resolve just the bodies whose
/// references the client can ask about. The definition table covers imported
/// declarations too, so cross-file locations keep the compiler's source spans.
let prepared_with! : :string -> [:string] -> :map -> :map -> :any -> :bool -> :any -> :map;
let prepared_with! file roots docs parsed wanted walk range = {
    let ps = package.discover! file roots;
    let initial = modules.loader ps (config.defaults! ()) (modules.default_search_paths! file roots) []
        |> modules.Loader.set_prefetch_enabled false
        |> modules.Loader.set_namespaces (package.names ps)
        |> modules.with_overlay docs
        |> modules.with_parsed parsed
        |> modules.with_package_roots!;
    let src = add_with! initial file roots docs wanted (match range { () => (), _ => file }) [];
    // Imported signatures do not require expanding their implementations.
    // Unexpanded unsigned calls stay unknown until their evidence is available.
    let active = match range {
        () => src,
        _ => {
            let root = analysis.module_index src file;
            let source_id = match root { () => (), mi => modules.module_source (modules.module_at src mi) };
            let own = filter (fn pair -> list.head pair == source_id) (map.pairs (modules.expanding src));
            modules.Loader.set_expanding (map.from_pairs own) src
        },
    };
    let l = expansion.expand! active;
    let mi = analysis.module_index l file;
    let declared = scope.declare! l;
    let base = scope.resolver (scope.envs declared)
        |> scope.Resolution.set_imports (scope.s_imports declared)
        |> scope.Resolution.set_module_recs (scope.s_module_recs declared)
        |> scope.Resolution.set_diags (scope.diags declared);
    let seeded = fold (fn r e -> scope.Resolution.set_refs
        ((scope.refs r).[(scope.ref_key (list.nth 0 e) (list.nth 1 e) (list.nth 2 e)) => list.nth 3 e]) r)
        base (modules.expansions l);
    let all = scope.walk_base l declared seeded 0;
    let source_id = match mi { () => (), i => modules.module_source (modules.module_at l i) };
    let mine = filter (fn p -> list.nth 1 p == source_id && match range {
        () => true,
        [first, last] => {
            let sp = scope.decl_span (list.nth 2 p);
            ast.span_start sp <= last && ast.span_end sp >= first
        },
    }) (scope.pending declared);
    let r = if walk { fold (fn acc p -> scope.check_body l p acc) all mine } else { all };
    let resolved = match range {
        () => r,
        _ => {
            let [signed, _] = typecheck.sig_table l r;
            let used = fold (fn acc ref -> match scope.target_global ref {
                () => acc,
                gi => acc.[gi => true],
            }) (%{}) (map.values (scope.refs r));
            let extra = filter (fn p -> {
                let d = list.nth 2 p;
                let gi = scope.global_index ((scope.envs declared).[list.nth 0 p else ()]) (scope.decl_name d);
                not (list.contains p mine) &&
                ((str.starts_with "type " (str.slice (ast.span_start (scope.decl_span d)) 5
                    (diag.source_text (modules.file_at l (list.nth 1 p))))) ||
                    (map.has gi used && not (map.has gi signed)))
            }) (scope.pending declared);
            fold (fn acc p -> scope.check_body l p acc) r extra
        },
    };
    analysis.analysis l (typecheck.select_overloads l resolved) mi src
};

let prepared! : :string -> [:string] -> :map -> :map -> :string -> :bool -> :map;
let prepared! file roots docs parsed wanted walk = prepared_with! file roots docs parsed wanted walk ();

/// Follow local declarations named by the visible bodies too. A local helper
/// can introduce an import absent from its caller; signed helpers need only
/// their signature. Names shadowed by locals may include extra declarations,
/// which costs work but never removes evidence the checker could need.
let reference_chain : :any -> :string;
let rec reference_chain tree = match tree {
    [:name, name, _] => name,
    [:field, obj, field, _] => {
        let head = reference_chain obj;
        if head == "" { "" } else { head + "." + field }
    },
    _ => "",
};

let referenced : :any -> [:string];
let rec referenced tree = match tree {
    [:name, name, _] => [name],
    [:field, obj, _, _] => list.cons (reference_chain tree) (referenced obj),
    xs if type_of xs == :list => flat_map referenced xs,
    _ => [],
};

let hint_declarations : [ast.Decl] -> [ast.Decl];
let rec hint_declarations items = flat_map (fn d -> match d {
    [:mod, _, ds, _] => hint_declarations ds,
    [:when, _, ds, _] => hint_declarations ds,
    [:priv, inner, _] => hint_declarations [inner],
    _ => [d],
}) items;

let hint_imports : [ast.Decl] -> :integer -> :integer -> :map;
let hint_imports items first last = {
    let declarations = hint_declarations items;
    let defs = fold (fn acc d -> match d {
        [:let, name, _, _, _, _] => acc.[name => d],
        [:macro, name, _, _, _] => acc.[name => d],
        _ => acc,
    }) (%{}) declarations;
    let sigs = fold (fn acc d -> match d {
        [:sig, name, _, _] => acc.[name => d],
        _ => acc,
    }) (%{}) declarations;
    let picked = filter (fn d -> {
        let sp = ast.span d;
        ast.span_start sp <= last && ast.span_end sp >= first
    }) declarations;
    let rec follow todo !seen = match todo {
        [] => seen,
        [name, ..rest] if map.has name seen => follow rest seen,
        [name, ..rest] => {
            let d = sigs.[name else (defs.[name else ()])];
            follow (match d { () => rest, tree => referenced tree + rest }) (seen.[name => true])
        },
    };
    follow (flat_map referenced picked) (%{})
};

let hints! : :string -> [:string] -> :map -> :map -> :integer -> :integer -> :map;
let hints! file roots docs parsed first last = {
    let text = docs.[file else (match files.read! file { () => "", s => s })];
    let full_key = file + "#hint-root";
    let full = match parsed.[full_key else ()] {
        [same, p] if same == text => p,
        _ => declarations.parse text,
    };
    let kept = parsed.[file => [text, full]].[full_key => [text, full]];
    let start = pos.line_start text first;
    let end = pos.line_start text (last + 1);
    let wanted = hint_imports (items full) start end;
    (prepared_with! file roots docs kept wanted true [start, end]).[:hint_wanted => wanted]
};

let analyse! : :string -> [:string] -> :map -> :map -> :string -> :map;
let analyse! file roots docs parsed wanted = prepared! file roots docs parsed wanted true;
let declared! : :string -> [:string] -> :map -> :map -> :string -> :map;
let declared! file roots docs parsed wanted = prepared! file roots docs parsed wanted false;

/// Source comparisons alone cannot notice that a previously missing import
/// has been created. Verify requested import lookups against the loaded files.
let current! : :string -> [:string] -> :map -> :any -> :map -> :bool;
let current! file roots docs wanted a = {
    let locator = modules.loader (package.discover! file roots) (config.defaults! ())
                      (modules.default_search_paths! file roots) [];
    let parsed = (modules.parsed (analysis.source a)).[file else ()];
    let raw = match parsed { [_, p] => items p, _ => [] };
    list.all (fn dep -> match import_file! locator dep {
        () => true,
        [target, _] => map.has (path.absolute! target) (modules.by_path (analysis.loader a)),
    }) (wanted_imports raw wanted)
};
