// lucid -- a language server for Dream.
//
// A lucid dream is one you know you are inside of. This is the compiler, aware
// of the program while you are still writing it.
//
// It is a separate tool rather than a mode of `dreams` or a command of `mind`,
// and that costs nothing: Dream compiles whole programs, so importing the
// compiler is importing a library. `lucid` links `dreams` in and calls its
// resolver directly -- no subprocess per keystroke, no parsing the compiler's
// own output back out of a pipe, and every table the compiler built is
// available as a value rather than as text.
//
// What it answers, it answers out of those tables: diagnostics from the front
// end, go-to-definition and hover from the resolution table, the outline from
// the list of what each module declares, and completion from what a module
// exports. Almost none of it is a second implementation of anything, which is
// the point -- an editor that disagrees with the compiler is worse than an
// editor that says nothing.
//
// There is one exception and it is worth naming here rather than leaving to be
// found. Completion has to offer the *locals* in scope, and that is the one
// thing the compiler does not record: the resolver knows it while it walks and
// forgets it when it returns, so `analysis.dr` reads the binders back off the
// syntax tree. Those scoping rules are therefore written twice. The section
// that does it says so at length, and says which parts of `scope.dr` each of
// its cases was transcribed from.
import std.cli;
import std.console;
import std.file;
import std.error;

import std.install;
import std.io;
import std.json;
import std.list;
import std.map;
import std.os;
import std.proc;
import std.path;
import std.str;

import dreams.fmt;
import dreams.diag;
import dreams.modules;
import dreams.package;

import analysis;
import background;
import hints;
import index as indexed;
import complete;
import pos;
import rpc;

let version = "0.1.0";

// --- what the server is holding ------------------------------------------------

/// The open documents, where to look for packages, and what has been parsed.
///
/// Parses survive edits; the latest analysis survives only while its sources
/// and package discovery still agree with the filesystem and open buffers.
let state docs roots = %{ :docs => docs, :roots => roots, :parsed => %{},
                           :revision => 0, :pending => %{} };

let docs s  = s.[:docs else (%{})];
let roots s = s.[:roots else []];
let parses s = s.[:parsed else (%{})];

let revision : :map -> :integer;
let revision s = s.[:revision else 0];
let invalidated : :map -> :map;
let invalidated s = (map.remove :analysis (map.remove :analyses s)).[:revision => (revision s + 1)];
let with_doc path text s = (invalidated s).[:docs => (((docs s)).[path => text])];
let without_doc path s = (invalidated s).[:docs => (map.remove path (docs s))];
let with_roots rs s = (invalidated s).[:roots => (list.unique rs)];
/// Add to what has been parsed. **Merged, never replaced**, and that is not a
/// detail: a buffer that does not parse names no imports, so the loader for it
/// never reaches the other modules and its parse map comes back holding only
/// the buffer. Assigning that map over the old one throws away every other
/// module, and the next request parses the whole program again -- which is the
/// state an editor is in for most of the time somebody is typing. Measured on
/// `dreams/src/lower.dr`: a completion against a buffer with a half-written member
/// access cost 815 ms that way and 244 ms merged.
///
/// A stale entry cannot do any harm. The loader keeps the text it parsed beside
/// the result and compares it to the text it is given, so an entry for a file
/// that has since changed is re-parsed rather than believed.
let with_parses ps s = s.[:parsed => (map.merge (parses s) ps)];

/// Interactive analysis is limited to this file and the import under the
/// cursor. A compiler worker separately owns whole-program analysis.
let analysed! : :map -> :string -> :string -> :map;
let analysed! s path wanted = {
    let key = list.head (str.split "." wanted);
    let cached = ((s.[:analyses else (%{})]).[path else (%{})]).[key else ()];
    match cached {
        a if a != () && analysis.current! path (roots s) (docs s) a
            && indexed.current! path (roots s) (docs s) wanted a => a,
        _ => indexed.analyse! path (roots s) (docs s) (parses s) wanted,
    }
};
let carrying : :map -> :string -> :string -> :map -> :map;
let carrying a path wanted s = {
    let all = s.[:analyses else (%{})];
    let own = all.[path else (%{})];
    let key = list.head (str.split "." wanted);
    let kept = if map.size own >= 16 && not (map.has key own) {
                   map.remove (list.head (map.keys own)) own
               } else { own };
    (with_parses (analysis.parses a) s).[:analyses => (all.[path => (kept.[key => a])])]
};

let snapshot : :map -> :string -> :map;
let snapshot s path = background.snapshot path (roots s) (docs s) (revision s);

// --- reading the parts of a request ---------------------------------------------

let text_document p = p.["textDocument" else (%{})];
let uri_of p = ((text_document p)).["uri" else ""];
let path_of p = analysis.uri_to_path (uri_of p);

let position_of p = p.["position" else (%{})];
let line_of p = ((position_of p)).["line" else 0];
let character_of p = ((position_of p)).["character" else 0];

// --- diagnostics ------------------------------------------------------------------

/// Publish what the front end said about every file it touched.
///
/// An empty list is published for the file being edited even when it has no
/// problems, because that is how a diagnostic is *withdrawn*: a server that
/// sends only what is broken leaves the last set of squiggles on screen after
/// the code is fixed.
let publish! out groups path = {
    let mentioned = list.map (fn g -> list.head g) groups;
    let send! p ds =
        rpc.write_message! out
            (rpc.notification "textDocument/publishDiagnostics"
                 %{ "uri" => analysis.path_to_uri p, "diagnostics" => ds });
    list.map (fn g -> send! (list.head g) (list.nth 1 g)) groups |> strict!
    if list.contains path mentioned { () } else { send! path [] }
};

/// Queue checks for the current buffers and return immediately. A change to
/// an open dependency changes its importers too. The worker coalesces queued
/// revisions; the owner publishes only results for the current snapshot.
let refresh! : :any -> :map -> :string -> :map;
let refresh! out s path = {
    if path == "" { () }
    else {
        list.map (fn p -> send! s.[:worker] [:check, snapshot s p]) (map.keys (docs s)) |> strict!
    }
    s
};

let requested! : :map -> :map -> :string -> :map;
let requested! s m path = {
    let job = snapshot s path;
    let worker = if rpc.method m == "textDocument/inlayHint" { s.[:hints_worker] } else { s.[:worker] };
    send! worker [:request, job, m]
    s.[:pending => ((s.[:pending else (%{})]).[rpc.id m => job])]
};

// --- the requests -----------------------------------------------------------------

/// What this server can do. Full document sync, because a language whose
/// compiler is this fast has no reason to reassemble incremental edits.
///
/// `.` is the one trigger character. A client asks for completions on its own
/// as a word is typed; a trigger character is how it is told to ask again at a
/// point where no word has been started, which after a dot is the whole
/// question -- and a dot is also the one place this server has a precise answer
/// rather than a list of everything in sight.
let capabilities =
    %{ "capabilities" => %{ "textDocumentSync" => 1,
                            "hoverProvider" => true,
                            "definitionProvider" => true,
                            "documentSymbolProvider" => true,
                            "documentFormattingProvider" => true,
                            "inlayHintProvider" => true,
                            "renameProvider" => %{ "prepareProvider" => true },
                            "completionProvider" =>
                                %{ "triggerCharacters" => ["."] } },
       "serverInfo" => %{ "name" => "lucid", "version" => version } };

/// The workspace root, as a package search path. An editor opens a directory,
/// and that directory is where this project's packages are.
let roots_from p = {
    let folders = p.["workspaceFolders" else ()];
    let from_folders =
        match folders {
            () => [],
            fs => list.map (fn f -> analysis.uri_to_path (f.["uri" else ""])) fs,
        };
    match p.["rootUri" else ()] {
        () => from_folders,
        u  => list.append from_folders [analysis.uri_to_path u],
    }
};

let answer! out id result = rpc.write_message! out (rpc.response id result);

/// `[:ok, result]` answered, `[:error, why]` refused: an LSP request failure,
/// whose message an editor shows.
let refusable! out id outcome = match outcome {
    Result.ok(result) => answer! out id result,
    Result.error(why) => rpc.write_message! out (rpc.error_response id (0 - 32803) why),
};

/// One request or notification. Answers `[:go, state]` or `[:exit, code]`.
let handle! out s m = {
    let p = rpc.params m;
    let path = path_of p;
    match rpc.method m {
        "initialize" => {
            answer! out (rpc.id m) capabilities
            [:go, with_roots (list.append (roots s) (roots_from p)) s]
        },
        "initialized" => [:go, s],
        "workspace/didChangeWatchedFiles" => {
            let next = refresh! out (invalidated s) "workspace";
            [:go, next]
        },
        "$/cancelRequest" => {
            let id = p.["id" else ()];
            let pending = s.[:pending else (%{})];
            if map.has id pending {
                rpc.write_message! out (rpc.error_response id (0 - 32800) "request cancelled")
            }
            [:go, s.[:pending => (map.remove id pending)]]
        },

        // The client asks to shut down, then tells us to go. Answering the
        // first and waiting for the second is what the protocol asks for.
        // Each of these needs its own line. Application is juxtaposition, so
        // `answer! out id ()  [:go, s]` on one line is a call with four
        // arguments rather than a call and then a result.
        "shutdown" => {
            answer! out (rpc.id m) ()
            [:go, s]
        },
        "exit" => [:exit, 0],

        "textDocument/didOpen" => {
            let text = ((text_document p)).["text" else ""];
            let s2 = refresh! out (with_doc path text s) path;
            [:go, s2]
        },
        "textDocument/didChange" => {
            // Full sync: the last change carries the whole document.
            let changes = p.["contentChanges" else []];
            let text = match list.reverse changes {
                           [] => ((docs s)).[path else ""],
                           [c, .._] => c.["text" else ""],
                       };
            let s2 = refresh! out (with_doc path text s) path;
            [:go, s2]
        },
        "textDocument/didSave" => {
            let s2 = refresh! out s path;
            [:go, s2]
        },
        "textDocument/didClose" => {
            let s2 = refresh! out (without_doc path s) path;
            // The file is back to whatever is on disk, and nothing here is
            // responsible for it any more.
            rpc.write_message! out
                (rpc.notification "textDocument/publishDiagnostics"
                     %{ "uri" => analysis.path_to_uri path, "diagnostics" => [] })
            [:go, s2]
        },

        // Resolve this file's bodies against only the requested declarations.
        // Whole-program checking continues independently in the worker.
        "textDocument/definition" => {
            let wanted = indexed.chain_at (((docs s)).[path else ""]) (line_of p) (character_of p);
            let a = analysed! s path wanted;
            answer! out (rpc.id m) (analysis.definition_at a (line_of p) (character_of p))
            [:go, carrying a path wanted s]
        },
        "textDocument/hover" => {
            let wanted = indexed.chain_at (((docs s)).[path else ""]) (line_of p) (character_of p);
            let a = analysed! s path wanted;
            answer! out (rpc.id m) (analysis.hover_at a (line_of p) (character_of p))
            [:go, carrying a path wanted s]
        },
        // Completion does not reuse `analysis.analyse!` the way its neighbours
        // do, because it does not analyse the document that is on screen: a
        // buffer is rarely a program at the moment somebody asks what can go
        // next, so `complete` repairs it first. See the head of that file.
        "textDocument/completion" => {
            let got = complete.completions! path (roots s) (docs s) (parses s)
                                            (line_of p) (character_of p);
            answer! out (rpc.id m) (list.head got)
            [:go, with_parses (list.nth 1 got) s]
        },

        "textDocument/documentSymbol" => {
            let a = analysed! s path "";
            answer! out (rpc.id m) (analysis.symbols a)
            [:go, carrying a path "" s]
        },

        // The types the checker gave the bindings nobody wrote one for, in
        // the lines on screen. See "inlay hints" in analysis.dr.
        "textDocument/inlayHint" => [:go, requested! s m path],
        "textDocument/prepareRename" => [:go, requested! s m path],
        "textDocument/rename" => [:go, requested! s m path],

        // The compiler's formatter, on the buffer as it is. One edit that
        // replaces the whole document, which is what a formatter that keeps
        // every line has to say anyway, and nothing at all when the buffer
        // is already laid out or does not parse -- the diagnostics already
        // say why, and an editor that formats on save must still save.
        "textDocument/formatting" => {
            let text = ((docs s)).[path else ""];
            let edits = match fmt.format text {
                Result.ok(out) => if out == text { [] }
                              else { [%{ "range" => pos.range text 0 (str.byte_length text), "newText" => out }] },
                _ => [],
            };
            answer! out (rpc.id m) edits
            [:go, s]
        },

        // A request must be answered even when it is not understood, or the
        // client waits for it forever. A notification must not be.
        _ => {
            if rpc.is_request m {
                rpc.write_message! out
                    (rpc.error_response (rpc.id m) (0 - 32601)
                         ("no handler for " + to_string (rpc.method m)))
            }
            [:go, s]
        },
    }
};

/// Only this process writes framed replies. Reading and compiler work have
/// their own persistent processes, so a cold check cannot hold up navigation.
/// Force the new state before waiting: a handler can return a suspended send
/// inside its state, and waiting first would defer that request indefinitely.
let events! : :any -> :map -> :integer;
let rec events! out !s = match recv! () {
    [:rpc, m] => match handle! out s m {
        [:exit, code] => code,
        [:go, next] => events! out next,
    },
    [:diagnostics, job, groups] => {
        if job.[:revision] == revision s && map.has job.[:path] (docs s) {
            publish! out groups job.[:path]
        }
        events! out s
    },
    [:background_reply, job, id, result] => {
        let pending = s.[:pending else (%{})];
        if map.has id pending {
            if job.[:revision] == revision s { refusable! out id result }
            else { rpc.write_message! out (rpc.error_response id (0 - 32801) "document changed during the request") }
        }
        events! out s.[:pending => (map.remove id pending)]
    },
    [:down, process, outcome] => {
        let why = match outcome { Result.error(e) => error.describe e, other => to_string other };
        rpc.write_message! out (rpc.notification "window/logMessage"
            %{ "type" => 1, "message" => "Lucid background worker stopped: " + why })
        list.map (fn id -> rpc.write_message! out
            (rpc.error_response id (0 - 32803) why)) (map.keys (s.[:pending else (%{})])) |> strict!
        let owner = self! ();
        strict! owner
        let worker = if process == s.[:hints_worker] { hints.start! owner } else { background.start! owner };
        strict! worker
        proc.monitor! worker
        let restarted = if process == s.[:hints_worker] { s.[:hints_worker => worker] } else { s.[:worker => worker] };
        let next = refresh! out restarted.[:pending => (%{})] "worker restart";
        events! out next
    },
    [:eof] => 0,
    _ => events! out s,
};

let serve! inh out s = {
    let owner = self! ();
    strict! owner
    let reader = rpc.start_reader! inh owner;
    let worker = background.start! owner;
    let hints_worker = hints.start! owner;
    strict! reader
    strict! worker
    strict! hints_worker
    proc.monitor! worker
    proc.monitor! hints_worker
    events! out s.[:worker => worker].[:hints_worker => hints_worker]
};

// --- the command line --------------------------------------------------------------

let opts = [
    cli.list_of "L" "package-path" "DIR" "a package, or a directory holding packages",
    // An LSP client names the transport it started us on. `vscode-languageclient`
    // appends `--stdio` to the command line by itself, and a server that rejects
    // it dies before it has read a byte. Stdio is the only transport here, so the
    // flag is accepted and means nothing.
    cli.flag "" "stdio" "speak LSP on stdin and stdout (the default, and the only one)",
    cli.flag "h" "help" "this message",
    cli.flag "" "version" "print the version",
];

let usage = cli.usage "lucid" "a language server for Dream"
                      "lucid [options]   (it speaks LSP on stdin and stdout)" opts;

/// The standard library, wherever this installation keeps it. An editor is not
/// going to pass `-L` for it, and a project that cannot see `std` reports every
/// import of it as an error.
///
/// Last of all it is the installation's own copy -- the first directory of
/// `$MINDV2_PATH`, or `~/.mindv2`, that holds `std` -- which is where
/// `just install` puts it, and where the VM running this server found it.
let stdlib_roots! () =
    match os.env! "MIND_STDLIB" {
        () => match os.env! "DREAM_PACKAGES" {
            () => match install.holding! "std" { () => [], d => [d] },
            p => [path.expand_home! p],
        },
        p => [path.expand_home! p],
    };

let main! =
    match cli.parse opts (os.args! ()) {
        Result.error(why) => {
            console.error! ("lucid: " + to_string why)
            os.exit! 2
        },
        Result.ok(c) =>
            if cli.flag_set c "help" { console.error! usage }
            else if cli.flag_set c "version" { console.print! ("lucid " + version) }
            else {
                let roots = list.append (stdlib_roots! ()) (cli.all c "package-path");
                os.exit! (serve! (io.stdin! ()) (io.stdout! ()) (state (%{}) roots))
            },
    };
