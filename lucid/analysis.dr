// The questions an editor asks, answered out of the compiler's own tables.
//
// Almost nothing here re-implements anything. `dreams` already resolves every
// name to what it means and records where each one was written, because that is
// what lowering reads; a language server wants the same table, asked a
// different way. So most of this module is a translation layer and not an
// analysis: from a position in a buffer to a byte offset, from a byte offset to
// a resolution, from a resolution back to a range.
//
// It adds two things. The first is the overlay: a build compiles what is on
// disk, and an editor asks about what is in its buffers, which is a different
// program and often one that has never been saved.
//
// The second is the exception to the paragraph above, and the section that does
// it -- "what is in scope here" -- says at length why it has to exist and what
// it costs. In short: the resolver knows what is in scope while it walks and
// forgets it when it returns, so the one question it cannot be asked is the one
// a cursor sitting on empty space needs answered.
import std.core;
import std.list;
import std.str;

import dreams.ast;
import dreams.builtins;
import dreams.config;
import dreams.diag;
import dreams.expand as expansion;
import dreams.modules;
import dreams.scope;
import dreams.typecheck;

import pos;

// --- documents ----------------------------------------------------------------
//
// A URI is what the protocol speaks and a path is what the compiler speaks.
// `file:///a/b.dr` is the only scheme that can be compiled, so it is the only
// one converted; anything else is left alone and will simply not be found.

let uri_to_path uri =
    if str.starts_with "file://" uri {
        let rest = str.slice 7 (str.byte_length uri - 7) uri;
        // `file://host/path` is not something to guess at, but `file:///path`
        // is the ordinary form and its third slash is the root.
        if str.starts_with "/" rest { rest } else { "/" + rest }
    } else { uri };

let path_to_uri path = if str.starts_with "/" path { "file://" + path } else { "file://" + path };

// --- one analysis --------------------------------------------------------------

/// Everything one question needs: the loaded program, what its names resolved
/// to, which module the file in question turned out to be -- and the same
/// program *before* macro expansion, which is the one the editor is showing.
///
/// Two trees, and the split between them is exact. A question about what a
/// name **means** is asked of the expanded program, because that program is
/// what runs and there is nothing else for a name to mean. A question about
/// what is **written** -- which locals a cursor can see, what parameters a
/// declaration was given, whether it was a `macro` -- is asked of the source,
/// because expansion replaces an `expand` with generated syntax carrying
/// generated offsets, and the text the cursor is in is then inside no node at
/// all. Reading the parameters of `let double n = expand twice n` off the
/// expanded tree loses `n`, which is the local the person typing most wants.
let analysis l r mi src = %{ :loader => l, :resolved => r, :module => mi, :source => src };

let loader a   = core.map_get a :loader ();
let resolved a = core.map_get a :resolved ();
let module_of a = core.map_get a :module ();

/// The program as written. Falls back to the expanded one, which is the same
/// program wherever nothing was expanded.
let source a = core.map_get a :source (loader a);

/// What a module's file says, as declarations -- `macro` still a `macro`, and
/// every `expand` still a call rather than the code it turned into.
let source_items a mi = modules.module_items (modules.module_at (source a) mi);

/// The index of the module loaded from this path, or `()`.
///
/// Compared as written rather than resolved: the overlay is keyed by the path
/// the editor gave, and the loader records the path it was asked for.
let module_index l path = {
    let hits = list.filter (fn i -> modules.module_path (modules.module_at l i) == path)
                           (list.range 0 (modules.module_count l));
    if list.is_empty hits { () } else { list.head hits }
};

/// Compile `path` as the root of a program, reading `open_docs` -- a map of
/// path to text -- instead of the disk wherever it has an entry, and reusing
/// `parsed` for every file whose text has not changed since it produced it.
///
/// The cache is most of what makes a server answering a running editor
/// affordable, and it is the loader's own -- see `load_overlaid_cached!`, which
/// exists for this. Measured on `dreams/lower.dr`, which pulls in the whole
/// compiler: loading it cold parses 23 modules and costs 793 ms, and loading it
/// again with one buffer edited costs 127 ms, because only the buffer is parsed
/// again. What a caller has to do is carry the map back -- `parses` below --
/// since a cache that is not handed forward is not a cache.
let analyse_cached! path roots open_docs parsed = {
    let src = modules.load_overlaid_cached! path roots (config.defaults! ()) false open_docs parsed;
    let l = expansion.expand! src;
    analysis l (scope.resolve! (l)) (module_index l path) src
};

let analyse! path roots open_docs = analyse_cached! path roots open_docs (core.map_new ());

/// The parse results this analysis produced, to hand to the next one.
let parses a = modules.parsed (loader a);

/// The same program, **declared but not checked**.
///
/// `scope.resolve!` is two passes. `declare!` settles what each module binds --
/// its globals, what its imports brought in, and which name in front of a dot
/// is which module -- and the pass after it walks every body in the program to
/// resolve every name written in one. On `dreams/lower.dr` the first is 110 ms
/// and the pair is 483, so three quarters of the cost is the walk.
///
/// Completion needs none of that walk: what a module exports and what an import
/// bound are both settled by the first pass. So this stops after it.
///
/// **What is missing is `refs`**, which is the table saying what the name at a
/// given offset means -- it is the walk's output and the walk has not run. Hover
/// and go-to-definition are precisely that question, so neither may be asked of
/// one of these; they use `analyse_cached!`. `defs` is empty too, so a caller
/// wanting the globals of a module reads `scope.exports` of its environment,
/// which is phase one's own answer to the same question.
let declared! path roots open_docs parsed = {
    let src = modules.load_overlaid_cached! path roots (config.defaults! ()) false open_docs parsed;
    let l = expansion.expand! src;
    analysis l (scope.resolver (scope.envs (scope.declare! l))) (module_index l path) src
};

/// The text of a module as the compiler saw it, which is the buffer when there
/// is one. Every offset below is into this, so it has to be the same string.
let module_text a mi = {
    let l = loader a;
    diag.source_text (modules.file_at l (modules.module_source (modules.module_at l mi)))
};

// --- diagnostics ----------------------------------------------------------------

/// LSP severities. Only two of the four are produced here.
let severity_error = 1;
let severity_warning = 2;

/// One diagnostic, as LSP wants it.
///
/// A diagnostic belongs to the file it was raised in, which is not always the
/// file being edited: a broken import is reported where the import is written,
/// but a broken *module* is reported inside that module. So each one carries
/// the source it came from and is published against that file.
let lsp_diagnostic a d = {
    let l = loader a;
    let si = diag.source_of d;
    let f = modules.file_at l si;
    let src = if f == () { "" } else { diag.source_text f };
    let sp = if f == () { diag.span d } else { diag.origin_span f (diag.span d) };
    %{ "range" => pos.range src (ast.span_start sp) (ast.span_end sp),
       "severity" => if diag.is_error d { severity_error } else { severity_warning },
       "source" => "dreams",
       "message" => match diag.note d {
                        () => diag.message d,
                        n  => diag.message d + "\n" + to_string n,
                    } }
};

/// Which file a diagnostic is about, as a path.
let diagnostic_path a d = {
    let l = loader a;
    match modules.file_at l (diag.source_of d) {
        () => "",
        f  => diag.source_path f,
    }
};

/// Everything the front end had to say, in one list: the loader, the
/// resolver, and -- for a program that resolved -- what its signatures say is
/// wrong with it, which is the same pass and the same messages `dreams` gives.
let all_diagnostics a = {
    let ds = list.append (modules.diags (loader a)) (scope.r_diags (resolved a));
    if diag.error_count ds > 0 { ds }
    else { list.append ds (typecheck.check_program (loader a) (resolved a)) }
};

/// Diagnostics grouped by the file they belong to: `[[path, [diagnostic, ..]], ..]`.
///
/// Grouped rather than filtered because a server must publish an *empty* list
/// for a file whose problems have gone away; sending only what is broken leaves
/// the last set of squiggles on screen forever.
let diagnostics_by_path a = {
    let ds = all_diagnostics a;
    let paths = list.unique (list.map (fn d -> diagnostic_path a d) ds);
    list.map (fn p -> [p, list.map (fn d -> lsp_diagnostic a d)
                                   (list.filter (fn d -> diagnostic_path a d == p) ds)])
             paths
};

// --- what is under the cursor -----------------------------------------------------

let is_name_byte b =
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57)
    || b == 95 || b == 33;

/// The start of the name containing `offset`. The resolution table is keyed by
/// where a name begins, and a cursor rests in the middle of one.
let name_start src offset = {
    let rec back i =
        if i <= 0 { 0 }
        else if is_name_byte (core.str_byte src (i - 1)) { back (i - 1) }
        else { i };
    back offset
};

let name_end src offset = {
    let n = str.byte_length src;
    let rec forward i = if i >= n { i } else if is_name_byte (core.str_byte src i) { forward (i + 1) } else { i };
    forward offset
};

let name_at src at = str.slice at (name_end src at - at) src;

/// The text a span covers, which is the honest way to show a piece of a
/// program back to the person who wrote it: a parameter that is a pattern comes
/// out exactly as it was typed rather than as this compiler would re-print it.
let span_text src span =
    str.slice (ast.span_start span) (ast.span_end span - ast.span_start span) src;

/// The head of the dotted chain a name is part of.
///
/// A member access is recorded at the start of the whole expression:
/// `helper.double` is keyed where `helper` begins. But a reader points at the
/// part they mean, and the part they mean is usually the field. So a name
/// preceded by a dot asks its question at the head of the chain instead.
let rec chain_start src at =
    if at > 0 && core.str_byte src (at - 1) == 46 { chain_start src (name_start src (at - 1)) }
    else { at };

/// What the name under this position resolves to: `[start, end, resolution]`,
/// or `()` when the cursor is not on a name that resolved.
///
/// The range answered is the name that was pointed at, not the chain it was
/// found through: highlighting `helper.double` when the cursor is on `double`
/// would be answering a question nobody asked.
let at_position a line character =
    match module_of a {
        () => (),
        mi => {
            let src = module_text a mi;
            let source = modules.module_source (modules.module_at (loader a) mi);
            let here = name_start src (pos.offset_of src line character);
            let span = [here, name_end src here];
            match scope.at (resolved a) mi source here {
                () =>
                    match chain_start src here {
                        // Already at the head: there is nowhere further back
                        // to look, and nothing resolved here.
                        head => if head == here { () }
                                else {
                                    match scope.at (resolved a) mi source head {
                                        () => (),
                                        found => [list.head span, list.nth 1 span, found],
                                    }
                                },
                    },
                found => [list.head span, list.nth 1 span, found],
            }
        },
    };

// --- what is in scope here -----------------------------------------------------
//
// This is the one question in this file that the compiler cannot be asked. The
// resolver knows what is in scope at every point of its walk -- that is what a
// frame stack *is* -- but it pushes and pops as it goes, and when `resolve!`
// returns there is nothing left saying what was visible at a given byte. `refs`
// answers "what does the name here mean", which is a different question and no
// help to a cursor sitting where no name has been written yet.
//
// So the binders are read back off the tree, and that means the scoping rules
// are written twice: once in `scope.dr`, where they decide what a program
// means, and once here, where they decide what to offer. The duplication is
// real and it is the reason this section is as literal as it is -- every case
// below is a transcription of the corresponding case of `check_expr`,
// `check_block` or `check_arm`, in the same order, so that the two can be read
// side by side when one of them changes. Where `scope.dr` exports the rule
// itself it is called rather than copied: `scope.pattern_bindings` is what says
// which names a pattern binds, here as there.
//
// A binder is `[name, span, params]`. The parameters are carried because the
// walk has them in hand and both callers want them -- completion to describe an
// entry, hover to show a local function's arguments -- and going back for them
// afterwards would mean finding the declaration a second time. The span is
// where the name was written, which is what identifies one binding among
// several of the same name; nothing reads it yet, and it is kept because a
// walk that found a binder and then threw away where it was would have to be
// run again by the first thing that wants to rename or highlight one.

let binder name span params = [name, span, params];
let binder_name b   = list.nth 0 b;
let binder_span b   = list.nth 1 b;
let binder_params b = list.nth 2 b;

/// Spans are closed at both ends here, because the position being asked about
/// is a cursor rather than a character: a cursor at the very end of a block is
/// still inside it.
let covers span offset = ast.span_start span <= offset && offset <= ast.span_end span;

/// Does this node contain the cursor?
///
/// This used to be `covers (extent e) offset`, where `extent` was a walk down
/// the last part of every construct that could end where its last part does --
/// a lambda at its body, an `if` at its `else`, an application at its final
/// argument. All of it existed for one node: a `match`'s span covered
/// `match subject {` and stopped there, so its arms lay outside the node that
/// owned them and a cursor in one looked as though it were in no `match` at
/// all. That was a parser bug rather than a fact about spans, and it is fixed
/// -- `match_arms` hands its closing brace back the way `comma_list` always
/// did -- so a span is now what it claims to be and the walk is gone. The
/// tests below that found the original (a cursor in the second arm of a
/// two-arm `match`) are what hold the fix.
let holds e offset = covers (ast.span e) offset;

/// The same question of a match arm, whose span is its pattern to the end of
/// its body.
let arm_holds a offset = covers (list.nth 3 a) offset;

/// The names a parameter list binds. A parameter is a name, `()` -- a slot that
/// binds nothing -- or a pattern, and only the last of those binds more than
/// one thing.
let param_binders ps =
    list.concat (list.map (fn p ->
        match ast.param_pattern p {
            () => match ast.param_name p {
                      () => [],
                      n => [binder n (list.nth 1 p) []],
                  },
            pattern => list.map (fn nb -> binder (list.head nb) (list.nth 1 nb) [])
                                (scope.pattern_bindings pattern),
        }) ps);

let pattern_binders pattern =
    list.map (fn nb -> binder (list.head nb) (list.nth 1 nb) []) (scope.pattern_bindings pattern);

/// Every local visible at `offset`, outermost first, threaded down through the
/// constructs that contain it. `acc` is what the enclosing constructs have
/// already put in scope, which is why this reads as a descent rather than as a
/// collection: only the child that contains the cursor can add anything, and a
/// child that does not contain it hands `acc` straight back.
let rec expr_binders e offset acc =
    if not (holds e offset) { acc }
    else {
        match e {
            [:lambda, ps, body, _] =>
                expr_binders body offset (list.append acc (param_binders ps)),
            [:block, stmts, _] => block_binders stmts offset acc,

            // The binder is in scope in the handler and nowhere else, and it is
            // bound at the `try`'s own span -- which is where `check_expr`
            // binds it, so hovering it finds it here.
            //
            // The body is asked about *first*, and it has to be: these two
            // spans are not disjoint. Both begin at the `try` keyword, so the
            // handler's span contains the body's entirely, and asking the
            // handler first puts the catch binder in scope inside the very
            // block it guards.
            [:try, body, name, handler, span] =>
                if holds body offset { expr_binders body offset acc }
                else if holds handler offset {
                    expr_binders handler offset (list.append acc [binder name span []])
                }
                else { acc },

            [:match, subject, arms, _] =>
                if holds subject offset { expr_binders subject offset acc }
                else { arm_binders arms offset acc },

            // A compile-time expression is walked with an empty frame stack:
            // it runs before the program does, so there is no local for it to
            // see. Dropping `acc` here is that rule, and it is the only place
            // in this walk where anything is dropped.
            [:comp, _, body, _] => expr_binders body offset [],

            [:field, obj, _, _] => expr_binders obj offset acc,
            [:apply, callee, args, _] =>
                list.fold (fn a x -> expr_binders x offset a) (expr_binders callee offset acc) args,
            [:pipe, l, r, _] => expr_binders r offset (expr_binders l offset acc),
            [:unary, _, x, _] => expr_binders x offset acc,
            [:binary, _, l, r, _] => expr_binders r offset (expr_binders l offset acc),
            [:if, cond, t, el, _] => {
                let seen = expr_binders t offset (expr_binders cond offset acc);
                match el { () => seen, x => expr_binders x offset seen }
            },
            [:thunk, x, _] => expr_binders x offset acc,
            [:list, xs, _]  => list.fold (fn a x -> expr_binders x offset a) acc xs,
            [:array, xs, _] => list.fold (fn a x -> expr_binders x offset a) acc xs,
            [:map, pairs, _] =>
                list.fold (fn a kv -> expr_binders (list.nth 1 kv) offset
                                          (expr_binders (list.nth 0 kv) offset a))
                          acc pairs,
            [:get, c, k, fallback, _] => {
                let seen = expr_binders k offset (expr_binders c offset acc);
                match fallback { () => seen, f => expr_binders f offset seen }
            },
            [:set, c, k, v, _] =>
                expr_binders v offset (expr_binders k offset (expr_binders c offset acc)),
            [:destructure, _, body, _] => expr_binders body offset acc,

            // What a macro is *handed* is source the author wrote, and a
            // cursor in it can see everything the enclosing code can: nothing
            // about being an argument narrows the scope. What the macro does
            // with it is another matter and not one this can know -- a copy
            // may end up under a binding of the macro's own -- so this is the
            // scope at the call, which is the only one that is written down.
            [:expand, call, _] => expr_binders call offset acc,
            _ => acc,
        }
    };

/// A block's statements, where the scope grows as the block is walked: a `let`
/// binds a name the statements *after* it can see, and not its own body unless
/// it is `rec`.
let rec block_binders stmts offset acc =
    match stmts {
        [] => acc,
        [st, ..rest] =>
            // Written below the cursor. Nothing from here down is in scope at
            // it, which is the half of this that a cursor sitting in the gap
            // *between* two statements gets wrong if the test is only whether
            // some statement contains it: none does, and every `let` in the
            // block -- including the ones underneath -- would be offered.
            if ast.span_start (ast.span st) > offset { acc }
            else if holds st offset { stmt_binders st offset acc }
            else { block_binders rest offset (list.append acc (bound_after st)) },
    };

/// What the cursor can see from inside one statement.
let stmt_binders st offset acc =
    match st {
        [:let, n, ps, body, is_rec, span] =>
            if holds body offset {
                expr_binders body offset
                    (list.append (list.append acc (if is_rec { [binder n span ps] } else { [] }))
                                 (param_binders ps))
            }
            else { acc },
        // A destructuring `let` does not put its own names in scope in its
        // value -- `let [a, b] = f a` is the outer `a`.
        [:let_p, _, body, _] => expr_binders body offset acc,
        [:sig, _, _, _] => acc,
        _ => expr_binders st offset acc,
    };

/// What one statement leaves in scope for the statements below it.
let bound_after st =
    match st {
        [:let, n, ps, _, _, span] => [binder n span ps],
        [:let_p, pattern, _, _] => pattern_binders pattern,
        _ => [],
    };

/// The arm containing the cursor, with its pattern's names in scope -- for the
/// guard as well as the body, because a guard exists to ask about what the
/// pattern bound.
let rec arm_binders arms offset acc =
    match arms {
        [] => acc,
        [a, ..rest] =>
            if arm_holds a offset {
                let bound = list.append acc (pattern_binders (ast.arm_pattern a));
                match ast.arm_guard a {
                    () => expr_binders (ast.arm_body a) offset bound,
                    g => if holds g offset { expr_binders g offset bound }
                         else { expr_binders (ast.arm_body a) offset bound },
                }
            }
            else { arm_binders rest offset acc },
    };

/// A module's declarations. Only a body can contain the cursor, and only a
/// parameter list puts anything in scope for one -- what a top-level `let`
/// binds is a global, which is a different question with a different answer.
let rec item_binders items offset acc =
    match items {
        [] => acc,
        [it, ..rest] =>
            if holds it offset { in_item it offset acc }
            else { item_binders rest offset acc },
    };

let in_item it offset acc =
    match it {
        [:let, _, ps, body, _, _] =>
            if holds body offset {
                expr_binders body offset (list.append acc (param_binders ps))
            }
            else { acc },
        // A macro is a `let` that runs earlier. Its parameters are in scope in
        // its body exactly as one's are, and this walk reads the file before
        // expansion has rewritten it, so the case has to be here.
        [:macro, _, ps, body, _] =>
            if holds body offset {
                expr_binders body offset (list.append acc (param_binders ps))
            }
            else { acc },
        [:let_p, _, body, _] => expr_binders body offset acc,
        [:virtual, _, ps, body, _] =>
            match body {
                () => acc,
                b => if holds b offset {
                         expr_binders b offset (list.append acc (param_binders ps))
                     }
                     else { acc },
            },
        [:mod, _, inner, _]  => item_binders inner offset acc,
        [:when, _, inner, _] => item_binders inner offset acc,
        _ => acc,
    };

/// Every local in scope at a byte offset, innermost first and shadowed names
/// dropped. The walk builds them outermost first, so reversing puts the
/// innermost binding of a name in front of the one it shadows, and keeping the
/// first of each name is then exactly the shadowing rule.
let locals_at a offset =
    match module_of a {
        () => [],
        mi => {
            let found = list.reverse (item_binders (source_items a mi) offset []);
            let names = list.unique (list.map (fn b -> binder_name b) found);
            list.map (fn n -> list.head (list.filter (fn b -> binder_name b == n) found)) names
        },
    };

// --- how a name was written -------------------------------------------------------
//
// Hover and completion both want to show a function the way it was declared --
// `map f xs` rather than `map` -- because the question a reader has about a
// name they do not recognise is almost always "what do I pass it?". The
// resolver keeps arity and not parameter names, so this reads the declaration.

/// The declaration of `name` among a module's items, or `()`.
///
/// `when` blocks are searched because what one declares is a global like any
/// other in a program compiled with them in, and `mod` blocks are not, because
/// what is inside one belongs to a module of its own.
let rec find_decl items name =
    match items {
        [] => (),
        [it, ..rest] =>
            match it {
                [:let, n, _, _, _, _]  => if n == name { it } else { find_decl rest name },
                [:macro, n, _, _, _]   => if n == name { it } else { find_decl rest name },
                [:virtual, n, _, _, _] => if n == name { it } else { find_decl rest name },
                [:when, _, inner, _] =>
                    match find_decl inner name { () => find_decl rest name, d => d },
                _ => find_decl rest name,
            },
    };

/// Preserve the source owner when a signature comes from a behavior, so
/// pattern parameters are read from the file where they were written.
let signature_decl a mi name =
    match find_decl (source_items a mi) name {
        () => list.first_or () (list.filter (fn oi ->
                  find_decl [list.nth 1 oi] name != ())
                  (list.reverse (list.head (scope.effective_items (source a) mi [])))),
        d => [mi, d],
    };

/// A global's parameters, including those of inherited behavior methods.
let params_of a mi name =
    match signature_decl a mi name {
        () => (),
        // `:let`, `:macro` and `:virtual` all keep their parameters third.
        [_, d] => list.nth 2 d,
    };

/// Is this global one its module keeps to itself?
///
/// `priv` does not survive as a declaration: the loader unwraps it, files the
/// inner `let` with every other one and remembers only the span
/// (`modules.loaded`), so by the time anything resolves there is no item left
/// to read. The environment is where the answer ends up, and asking it is the
/// only way to tell `priv let f x = ..` from `let f x = ..`.
let is_private_global a mi name =
    scope.is_private (scope.r_env_at (resolved a) mi) name;

/// Is the name still open where it was resolved -- declared `virtual` and not
/// answered by an ordinary `let`?
///
/// A behavior's requirement and its implementation are two different items
/// with the same name, and `signature_decl` already prefers the module's own
/// over an inherited one, so this reads "virtual" exactly where the name has
/// no implementation: in the base, and in a module that derived it without
/// answering.
let is_virtual_global a mi name =
    match signature_decl a mi name { [_, [:virtual, _, _, _, _]] => true, _ => false };

/// What the line declaring a global says about it, beyond its name: `priv`,
/// `virtual`, or nothing at all. Empty rather than a word like "global",
/// because this is what an outline shows beside an entry and most entries have
/// nothing to add.
let declaration_words a mi name =
    str.trim ((if is_private_global a mi name { "priv " } else { "" })
              + if is_virtual_global a mi name { "virtual" } else { "" });

/// The same two facts, as hover says them in a sentence.
let global_phrase a mi name =
    (if is_private_global a mi name { "a private " } else { "a " })
    + if is_virtual_global a mi name { "virtual" } else { "global" };

/// Where a body was written, when that is not the module the name resolved
/// against. `derive` is the only thing that pulls those apart, and which file
/// an inherited method came from is exactly what the reader cannot see.
let inherited_note a mi name =
    match signature_decl a mi name {
        [owner, _] =>
            if owner == mi { "" }
            else { ", inherited from `"
                   + modules.module_name (modules.module_at (loader a) owner) + "`" },
        _ => "",
    };

// --- records ----------------------------------------------------------------------
//
// `group Point { x, y }` is a module of generated functions by the time
// anything resolves it -- a constructor, an accessor and a setter per field --
// and those carry spans in a reserved part of the offset space, because
// several of them stand where one declaration was written. So the compiler's
// answer about `Point.x` is true and useless to a reader: a global called `x`
// in a module called `ws.app.Point`, written nowhere in this file.
//
// `modules.records` is what the rewrite knew, kept. Everything below turns it
// back into the declaration the author is looking at.

/// The record a module was generated from:
/// `[owner, kind, name, fields, members, span]`, or `()` for an ordinary
/// module.
let record_of a mi = {
    let l = loader a;
    let full = modules.module_name (modules.module_at l mi);
    list.first_or () (list.filter (fn r -> list.head r + "." + list.nth 2 r == full)
                                  (modules.records l))
};

let record_owner r   = list.head r;
let record_name r    = list.nth 2 r;
let record_fields r  = list.nth 3 r;
let record_members r = list.nth 4 r;
let record_span r    = list.nth 5 r;

/// The member of this name, or `()`. A member is written rather than
/// generated, so everything below answers about it from what the author typed
/// -- which is also why it is asked about before the generated names are: a
/// member could be called `set_thing` where no field `thing` exists, and the
/// `set_` stem search would otherwise get there first and find nothing.
let record_member r n =
    list.first_or () (list.filter (fn m -> ast.member_name m == n) (record_members r));

/// The keyword it was written with. `syntax.record` keeps the *representation*
/// -- which collection the fields go into -- because that is what it builds
/// from; a reader wants the word they typed.
let record_keyword r =
    match list.nth 1 r {
        :list  => "group",
        :array => "struct",
        :map   => "mapping",
        other  => to_string other,
    };

/// The field a generated member is about, or `()` for `make`.
///
/// Asked by exact name first and only then with `set_` taken off, because a
/// record may have a field genuinely called `set_thing` -- what it may not have
/// is that *and* a field called `thing`, which is the clash the compiler
/// already refuses as "conflicts with a generated helper".
let record_field r n =
    match list.filter (fn f -> ast.field_name f == n) (record_fields r) {
        [f, .._] => f,
        [] => if not (str.starts_with "set_" n) { () }
              else {
                  let stem = str.slice 4 (str.byte_length n - 4) n;
                  list.first_or ()
                      (list.filter (fn f -> ast.field_name f == stem) (record_fields r))
              },
    };

/// Where to send a reader who asked about one of a record's names: the member
/// as it was written, the field a generated helper is about, or the
/// declaration itself for a constructor.
let record_site r n =
    match record_member r n {
        () => match record_field r n { () => record_span r, f => ast.field_span f },
        m => ast.member_span m,
    };

/// What one of a record's names does, in the words of the declaration it came
/// from. A member is a function somebody wrote, so there is nothing to explain
/// about what it does -- only where it lives, which is what a reader who
/// reached it through `Point.` does not otherwise know.
let record_role r n =
    if n == "type" { "the optional structural type of the " + record_keyword r + " `" + record_name r + "`" }
    else { match record_member r n {
        () => match record_field r n {
            () => "builds the " + record_keyword r + " `" + record_name r + "`"
                  // The two constructors differ only in what they ask for, so
                  // which fields `new` is filling in is the whole of what
                  // there is to say about the difference.
                  + match [n, list.filter (fn f -> ast.field_default f != ()) (record_fields r)] {
                        ["new", [_, .._] as defaulted] =>
                            ", defaulting " + str.join_str ", "
                                (list.map (fn f -> "`" + ast.field_name f + "`") defaulted),
                        _ => "",
                    },
            f => (if str.starts_with "set_" n && ast.field_name f != n {
                      "replaces `" + ast.field_name f + "` in the "
                  } else {
                      "reads `" + ast.field_name f + "` of the "
                  }) + record_keyword r + " `" + record_name r + "`"
                 // A field with a default never fails to read, and what it
                 // answers instead is the most useful thing to say about it.
                 + match ast.field_default f {
                       () => "",
                       d => ", or `" + ast.show d + "` when it is not there",
                   },
        },
        _ => "a member of the " + record_keyword r + " `" + record_name r + "`",
    } };

/// Was this global declared with `macro`?
///
/// Read off the source tree, because expansion rewrites a `macro` into an
/// ordinary `let` and nothing in the resolved program remembers which it was.
/// What this is for is completion: only a macro may follow `expand`, so
/// offering anything else there is offering a mistake.
let is_macro a mi name =
    match find_decl (source_items a mi) name {
        [:macro, _, _, _, _] => true,
        _ => false,
    };

/// One parameter as it should be shown: its name, or -- for one that is a
/// pattern, which has no name -- the text it was written as.
///
/// Preferring the name matters for more than tidiness. A declaration the
/// compiler *generated* carries a span in a reserved part of the offset space
/// rather than one into this file, and slicing that gives an empty string. A
/// record's members are all generated, so `Point.make` read `make  ` and
/// `Point.x` read `x ` before this. Their parameter *names* were right all
/// along. A generated parameter with no name is the `()` an empty record's
/// constructor takes, and there is nothing to slice for it either.
let param_text src p =
    match ast.param_name p {
        () => match span_text src (list.nth 1 p) { "" => "()", written => written },
        n => n,
    };

/// `name` followed by the parameters of `ps`.
let signature src name ps =
    if list.is_empty ps { name }
    else { name + " " + str.join_str " " (list.map (fn p -> param_text src p) ps) };

/// How to show a global or a member: its signature when the declaration can be
/// found, and its bare name when it cannot.
let shown_signature a mi name =
    (match signature_decl a mi name {
        () => name,
        [owner, d] => signature (module_text a owner) name (list.nth 2 d),
    }) + match declared_type a mi name {
        () => "",
        t => " : " + typecheck.written t,
    };

/// The type a signature gave this global, as written, or `()`. Read from the
/// expanded items, because that is where a record's and a union's generated
/// signatures are; a module's own signature follows any it inherited.
let declared_type a mi name =
    list.fold (fn found oi -> match list.nth 1 oi {
        [:sig, n, t, _] if n == name => t,
        _ => found,
    }) () (list.head (scope.effective_items (loader a) mi []));

// --- go to definition -------------------------------------------------------------

/// An LSP `Location` for a span in a *file*, named by the index the loader
/// gave it.
///
/// The unit is the file and not the module, which repairs two things rather
/// than tidying one. A module written as `mod B { .. }` is recorded with its
/// dotted name where a path goes, so `modules.module_path` made a URI out of
/// `buf.B`. And a body inherited through `derive` is at an offset into the
/// file the *base* was written in, while the module owning it is the one that
/// derived it -- so the offset was resolved against the wrong text and landed
/// wherever it happened to fall, which in a file long enough is a position
/// that still exists and is silently wrong. `scope.definition` has carried
/// the source each body came from all along; nothing was reading it.
let location_in a source span = {
    let f = modules.file_at (loader a) source;
    %{ "uri" => path_to_uri (diag.source_path f),
       "range" => pos.range (diag.source_text f) (ast.span_start span) (ast.span_end span) }
};

/// The same, for a span known only by which module it belongs to -- which is
/// every span the deriving above cannot have moved.
let location a mi span =
    location_in a (modules.module_source (modules.module_at (loader a) mi)) span;

/// Where the thing under the cursor was written, or `()`.
///
/// A global is looked up in the table of what each module declares, which is
/// the same table the outline is built from. A local carries its binder's span
/// with it, so it needs no lookup at all -- which is the payoff of the resolver
/// recording where a name was bound rather than only that it was.
let rec located a found =
    match found {
        [:local, _, span] => match module_of a { () => (), mi => location a mi span },
        [:global, mi, name, _] =>
            match scope.definition (resolved a) mi name {
                () => (),
                d => location_in a (list.nth 1 d) (list.nth 2 d),
            },
        // A record's members are generated, so the declaration the resolver
        // found is at an offset into no file. The place to go is where the
        // field was written, which is in the module the record was written
        // *in* -- a record's own module has a dotted name where a path goes
        // and `location` would make a URI out of it.
        [:member, [:dream, target], field, _] =>
            match record_of a target {
                () => match scope.definition (resolved a) target field {
                          () => (),
                          d => location_in a (list.nth 1 d) (list.nth 2 d),
                      },
                r => match modules.find (loader a) (record_owner r) {
                         () => (),
                         owner => location a owner (record_site r field),
                     },
            },
        // The name an `expand` named. A macro is an ordinary global by the
        // time the program is resolved -- expansion rewrites the declaration
        // -- so the way to it is the way to any other global, and the wrapper
        // is only there to say what this occurrence was.
        [:macro, inner] => located a inner,
        // A builtin and a host module's member are not written in Dream, so
        // there is nowhere to go.
        _ => (),
    };

let definition_at a line character =
    match at_position a line character {
        () => (),
        [_, _, found] => located a found,
    };

// --- hover ------------------------------------------------------------------------

/// How a local was bound, shown with its parameters when it has any.
///
/// Found by *name* among what is in scope at the cursor, rather than by the
/// span the resolver recorded. Both would do for a local, but a capture is
/// recorded with no span at all -- `resolve_in_frames` has threaded it in from
/// an enclosing frame and the binder is somewhere else entirely -- and the name
/// is the one thing that is right in both cases. `locals_at` has already
/// applied the shadowing rule, so the first entry under a name is the binding
/// this occurrence means.
let describe_local a offset name =
    match list.filter (fn b -> binder_name b == name) (locals_at a offset) {
        [] => "a local",
        [b, .._] =>
            match module_of a {
                () => "a local",
                mi => "`" + signature (module_text a mi) (binder_name b) (binder_params b)
                      + "` -- a local"
                      + if list.is_empty (binder_params b) { "" } else { " function" },
            },
    };

let describe a offset name found =
    match found {
        [:local, _, _] => describe_local a offset name,
        [:capture, idx, _] =>
            describe_local a offset name
            + " (captured from an enclosing function, capture " + to_string idx + ")",
        [:global, mi, name, _] =>
            "`" + shown_signature a mi name + "` -- " + global_phrase a mi name
            + " of module `" + modules.module_name (modules.module_at (loader a) mi) + "`"
            + inherited_note a mi name,
        [:builtin, name] => "`" + builtins.signature name + "` -- a builtin",
        [:member, [:dream, target], field, _] =>
            match record_of a target {
                () => "`" + shown_signature a target field + "` of module `"
                      + modules.module_name (modules.module_at (loader a) target) + "`"
                      + inherited_note a target field,
                r => "`" + shown_signature a target field + "` -- " + record_role r field,
            },
        [:member, [:native, p, _], field, _] => "`" + field + "` of the host module `" + p + "`",
        // An `expand` site. The declaration is an ordinary global by now, so
        // the signature and the module come from the same place they would for
        // one; what is worth saying extra is that this runs at compile time.
        [:macro, [:global, mi, n, _]] =>
            "`" + shown_signature a mi n + "` -- a macro of module `"
            + modules.module_name (modules.module_at (loader a) mi) + "`",
        [:macro, [:member, [:dream, target], field, _]] =>
            "`" + shown_signature a target field + "` -- a macro of module `"
            + modules.module_name (modules.module_at (loader a) target) + "`",
        [:macro, inner] => describe a offset name inner,
        [:closure, _] => "a function",
        [:thunk, _] => "a thunk",
        [:match, _] => "the subject of a match",
        other => to_string other,
    };

/// What to show when the pointer rests on a name, or `()`.
let hover_at a line character =
    match at_position a line character {
        () => (),
        [from, until, found] =>
            match module_of a {
                () => (),
                mi => {
                    let src = module_text a mi;
                    %{ "contents" =>
                           %{ "kind" => "markdown",
                              "value" => describe a (pos.offset_of src line character)
                                                  (name_at src from) found },
                       "range" => pos.range src from until }
                },
            },
    };

// --- the outline -------------------------------------------------------------------

/// LSP `SymbolKind`. A Dream global is a function or a value and the resolver
/// does not separate them here, so everything is reported as a variable rather
/// than guessed at wrongly. A record is a `Struct` whatever keyword declared
/// it, and its fields are `Field`s underneath it.
let symbol_variable = 13;
let symbol_struct = 23;
let symbol_field = 8;
/// A member is a function the author wrote, which is exactly what `Method`
/// means here -- and showing it as one is what tells it from a field in the
/// outline without a word of explanation.
let symbol_method = 6;

/// LSP shows `detail` beside the name, and an empty one is an empty column
/// rather than nothing, so it is added only when there is something to say.
let detailed words sym = if words == "" { sym } else { sym.["detail" => words] };

/// A record's fields and members, as outline children in the order they were
/// written. `at` is the caller's span-to-range, which needs the file's text.
let child_symbols at r =
    list.map (fn c -> list.nth 1 c)
        (list.sort_by (fn x y -> list.head x < list.head y)
            (list.map (fn f -> [ast.span_start (ast.field_span f),
                                %{ "name" => ast.field_name f, "kind" => symbol_field,
                                   "range" => at (ast.field_span f),
                                   "selectionRange" => at (ast.field_span f) }])
                      (record_fields r)
             + list.map (fn m -> [ast.span_start (ast.member_span m),
                                  %{ "name" => ast.member_name m, "kind" => symbol_method,
                                     "range" => at (ast.member_span m),
                                     "selectionRange" => at (ast.member_span m) }])
                        (record_members r)));

/// What this file declares, for the outline and for the symbol search.
///
/// Two sources, because a record is not among a module's globals: `group Point
/// { x, y }` became a module of its own, so the resolver's table of what this
/// file declares has nothing called `Point` in it and the outline of a file
/// full of records was empty. They are merged and sorted by where they were
/// written, since an outline out of source order reads as a different file.
let symbols a =
    match module_of a {
        () => [],
        mi => {
            let src = module_text a mi;
            let at span = pos.range src (ast.span_start span) (ast.span_end span);
            // Three sources, not two, once a module can derive: a body
            // inherited through `derive` is a global of *this* module and is
            // written in another file, so its span is an offset into the
            // base's text and against this one it is a range over whatever
            // happens to lie there. An outline says what the file in front of
            // the reader declares, so an inherited name belongs to the base's
            // outline and is dropped from this one -- `defs` carries the
            // source each body came from, which is what makes the two
            // separable at all.
            let own = modules.module_source (modules.module_at (loader a) mi);
            let globals = list.map (fn d -> {
                let span = list.nth 3 d;
                let name = list.nth 2 d;
                [ast.span_start span,
                 detailed (declaration_words a mi name)
                     %{ "name" => name, "kind" => symbol_variable,
                        "range" => at span, "selectionRange" => at span }]
            }) (list.filter (fn d -> list.nth 1 d == own) (scope.module_defs (resolved a) mi));
            let mine = modules.module_name (modules.module_at (loader a) mi);
            let records = list.map (fn r -> {
                let span = record_span r;
                [ast.span_start span,
                 %{ "name" => record_name r,
                    "detail" => record_keyword r,
                    "kind" => symbol_struct,
                    "range" => at span,
                    "selectionRange" => at span,
                    // A field is written inside the declaration, so its range
                    // is inside the record's -- which is what LSP requires of
                    // a child, and the reason nothing here is invented.
                    //
                    // Fields and members are sorted back together because they
                    // were written interleaved: a record is read top to bottom
                    // like anything else, and an outline that listed every
                    // field and then every member would be describing a
                    // declaration nobody wrote.
                    "children" => child_symbols at r }]
            }) (list.filter (fn r -> record_owner r == mine) (modules.records (loader a)));
            list.map (fn s -> list.nth 1 s)
                     (list.sort_by (fn x y -> list.head x < list.head y)
                                   (list.append globals records))
        },
    };

// --- tests ---------------------------------------------------------------------------

when test {
    import std.test;

    /// An analysis of one buffer and nothing else. Nothing below imports
    /// anything, so nothing has to be found on a package path.
    let of! text = analyse! "/buf.dr" [] (core.map_put (core.map_new ()) "/buf.dr" text);

    /// The names in scope where the `|` is, innermost first.
    ///
    /// Writing the position into the source is what keeps these readable. The
    /// alternative is a byte offset counted by hand in every one of them, which
    /// is a thing to get wrong quietly: a test asking about the wrong position
    /// still passes or fails, it just stops being about anything.
    let scope_at! text = {
        let at = str.find "|" text;
        let src = str.slice 0 at text + str.slice (at + 1) (str.byte_length text - at - 1) text;
        list.map (fn b -> binder_name b) (locals_at (of! src) at)
    };

    /// Sorted, for the cases where what is in scope matters and the order it
    /// comes back in does not.
    let in_scope_at! text = list.sort (scope_at! text);

    /// A buffer whose declaration is written with `expand`, with the cursor in
    /// the argument. One line, because the lexer is indentation-sensitive and
    /// a test that wrapped it would be testing that instead.
    let macro_buffer = "macro twice e = [:binary, :add, e, e, [0, 0]];\nlet double counter = expand twice |counter;\n";

    /// A buffer with a record in it, and the three things an editor asks about
    /// one. Line 0 is the declaration -- `x` at column 14, `y` at 17 -- and on
    /// line 1 the three kinds of generated member are at columns 18, 28 and 41.
    let record_src = "group Point { x, y }\nlet main! = Point.x (Point.set_y (Point.make 1 2) 3);\n";

    /// The same, with a member written in it. One line again, and the member
    /// is last so that the fields keep the columns `record_src` uses.
    let member_src = "group Point { x, y, len self = x self + y self }\nlet main! = Point.len (Point.new 1 2);\n";

    let hover_value! text line ch =
        match hover_at (of! text) line ch {
            () => "",
            h => core.map_get (core.map_get h "contents" ()) "value" "",
        };
    /// `[line, character]` of where go-to-definition lands, or `()`.
    let definition_start! text line ch =
        match definition_at (of! text) line ch {
            () => (),
            d => match core.map_get (core.map_get d "range" ()) "start" () {
                     at => [core.map_get at "line" (), core.map_get at "character" ()],
                 },
        };
    let symbol_names! text = list.map (fn s -> core.map_get s "name" "") (symbols (of! text));
    /// The same, each name with whatever `detail` it was given -- `""` for an
    /// entry that has none, since the key is left off rather than set empty.
    let symbol_details! text =
        list.map (fn s -> [core.map_get s "name" "", core.map_get s "detail" ""])
                 (symbols (of! text));
    let child_names! text name =
        list.concat (list.map (fn s -> list.map (fn c -> core.map_get c "name" "")
                                                (core.map_get s "children" []))
                              (list.filter (fn s -> core.map_get s "name" "" == name)
                                           (symbols (of! text))));

    /// The same two questions asked of the buffer's own module.
    let is_macro! text name =
        match of! text { a => match module_of a { () => false, mi => is_macro a mi name } };
    let shown_signature_of! text name =
        match of! text { a => match module_of a { () => "", mi => shown_signature a mi name } };

    let tests = [
        test.case "a file URI becomes a path"
            $( test.eq! "/a/b.dr" (uri_to_path "file:///a/b.dr") ),
        test.case "a path becomes a file URI"
            $( test.eq! "file:///a/b.dr" (path_to_uri "/a/b.dr") ),
        test.case "a URI round-trips"
            $( test.eq! "file:///a/b.dr" (path_to_uri (uri_to_path "file:///a/b.dr")) ),
        test.case "something that is not a file URI is left alone"
            $( test.eq! "untitled:1" (uri_to_path "untitled:1") ),

        test.case "the start of a name is found from inside it"
            $( test.eq! 4 (name_start "let value = 1;" 6) ),
        test.case "a cursor already at the start stays there"
            $( test.eq! 4 (name_start "let value = 1;" 4) ),
        test.case "a name ends where it stops being one"
            $( test.eq! "value" (name_at "let value = 1;" 4) ),
        test.case "an impure name keeps its bang"
            $( test.eq! "go!" (name_at "let go! = 1;" 4) ),

        test.case "a field asks its question at the head of the chain"
            $( test.eq! 4 (chain_start "let helper.double = 1;" 11) ),
        test.case "a chain of three still reaches the head"
            $( test.eq! 0 (chain_start "a.b.c" 4) ),
        test.case "a name that is not a field is its own head"
            $( test.eq! 4 (chain_start "let value = 1;" 4) ),

        // --- the scope walk ---------------------------------------------------
        //
        // These are the tests for the one thing in this file that is a second
        // implementation, so they are written against the rules in `scope.dr`
        // rather than against what this walk happens to do.

        test.case "a parameter is in scope in the body it belongs to"
            $( test.eq! ["a", "b"] (in_scope_at! "let f a b = { | };") ),
        test.case "a parameter is not in scope outside its function"
            $( test.eq! [] (in_scope_at! "let f a b = a; let g = |;") ),

        test.case "a `let` in a block is in scope below it"
            $( test.eq! ["x", "y"] (in_scope_at! "let f x = { let y = 1; | };") ),
        test.case "a `let` is not in scope in its own value"
            $( test.eq! ["x"] (in_scope_at! "let f x = { let y = |x; 1 };") ),
        // A cursor in the gap between two statements is in neither of them.
        // What is above it is in scope; `z`, written below, is not.
        test.case "a `let` above the cursor is in scope and one below is not"
            $( test.eq! ["x", "y"] (in_scope_at! "let f x = { let y = 1; | let z = 2; z };") ),

        test.case "a lambda's parameter is in scope in its body"
            $( test.eq! ["p", "x"] (in_scope_at! "let f x = { let g = fn p -> |p; 1 };") ),
        test.case "a lambda still sees what encloses it"
            $( test.true! (list.contains "x" (scope_at! "let f x = { let g = fn p -> |p; 1 };")) ),

        // Expansion replaces an `expand` with generated syntax carrying
        // generated offsets, so a walk of the expanded tree finds the cursor
        // inside no node at all and offers nothing. These are the whole reason
        // the walk reads the program as written -- see `analysis` above.
        test.case "a macro's argument can see the enclosing parameters"
            $( test.eq! ["counter"] (in_scope_at! macro_buffer) ),
        test.case "a macro's own parameter is in scope in its body"
            $( test.true! (list.contains "e"
                        (scope_at! "macro twice e = [:list, [|e], [0, 0]];\n")) ),
        test.case "a macro is known to have been declared with `macro`"
            $( test.true! (is_macro! "macro twice e = e;\nlet f x = x;\n" "twice") ),
        test.case "an ordinary global is not"
            $( test.false! (is_macro! "macro twice e = e;\nlet f x = x;\n" "f") ),
        test.case "a macro is shown with the parameters it was declared with"
            $( test.eq! "twice e" (shown_signature_of! "macro twice e = e;\n" "twice") ),

        // --- records ----------------------------------------------------------
        //
        // A `group` is a module of generated functions by the time anything
        // resolves it, so every one of these was answered out of
        // `modules.records` rather than out of the program.
        test.case "a record's accessor says which field it reads"
            $( test.eq! "`x record` -- reads `x` of the group `Point`"
                        (hover_value! record_src 1 18) ),
        test.case "a record's setter says which field it replaces"
            $( test.eq! "`set_y record value` -- replaces `y` in the group `Point`"
                        (hover_value! record_src 1 28) ),
        test.case "a record's constructor is shown with its fields"
            $( test.eq! "`make x y` -- builds the group `Point`"
                        (hover_value! record_src 1 41) ),
        test.case "a generated parameter is named, not sliced out of the file"
            $( test.eq! "make x y" (param_text "" (ast.param "make" [0, 0])
                                    + " " + str.join_str " "
                                        (list.map (fn n -> param_text "" (ast.param n [99, 99]))
                                                  ["x", "y"])) ),
        test.case "going to a record's accessor goes to the field"
            $( test.eq! [0, 14] (definition_start! record_src 1 18) ),
        test.case "going to a record's setter goes to the field it replaces"
            $( test.eq! [0, 17] (definition_start! record_src 1 28) ),
        test.case "going to a record's constructor goes to the declaration"
            $( test.eq! [0, 0] (definition_start! record_src 1 41) ),
        test.case "a record is in the outline, in the order it was written"
            $( test.eq! ["Point", "main!"] (symbol_names! record_src) ),
        test.case "a record's fields are in the outline underneath it"
            $( test.eq! ["x", "y"] (child_names! record_src "Point") ),

        // A member is the one part of a record that is *not* generated: its
        // body and its parameters are in the file, at the offsets they were
        // written at, because `syntax.record` freshens only what it made up.
        // So every answer below comes from the source rather than from a
        // reconstruction, and `self` is shown because the author chose it.
        test.case "a member is shown with the parameters it was written with"
            $( test.eq! "`len self` -- a member of the group `Point`"
                        (hover_value! member_src 1 18) ),
        test.case "going to a member goes to where it was written"
            $( test.eq! [0, 20] (definition_start! member_src 1 18) ),
        test.case "a member is in the outline beside the fields, in source order"
            $( test.eq! ["x", "y", "len"] (child_names! member_src "Point") ),
        test.case "going to `new` goes to the declaration, as `make` does"
            $( test.eq! [0, 0] (definition_start! member_src 1 29) ),
        test.case "`new` says which fields it is filling in"
            $( test.eq! "`new host` -- builds the mapping `C`, defaulting `retries`"
                        (hover_value! "mapping C { host, retries = 3 }\nlet main! = C.new \"h\";\n"
                                      1 14) ),
        test.case "`new` with nothing to default reads as the constructor it is"
            $( test.eq! "`new x y` -- builds the group `Point`"
                        (hover_value! member_src 1 29) ),
        test.case "a record with no fields still shows its constructor"
            $( test.eq! "`make ()` -- builds the struct `Empty`"
                        (hover_value! "struct Empty {}\nlet main! = Empty.make ();\n" 1 18) ),
        test.case "the keyword a record was written with survives the rewrite"
            $( test.eq! ["group", "struct", "mapping"]
                        (list.map (fn r -> record_keyword r)
                                  [[".", :list, "a", [], [0, 0]],
                                   [".", :array, "a", [], [0, 0]],
                                   [".", :map, "a", [], [0, 0]]]) ),

        // --- `priv` and `virtual` ---------------------------------------------
        //
        // Neither survives as a declaration anything downstream can read. The
        // loader unwraps a `priv` and keeps only the span, so the environment
        // is the last thing that remembers; a `virtual` becomes an ordinary
        // `let` in whichever module answers it, so the item written in the
        // file is the only thing that still says it was a requirement. Both
        // are facts a reader can see and the resolver's answer cannot say, so
        // hover and the outline are where they have to be put back.
        // A signature is what the author said a name is, so hover says it
        // too -- as written, since it is the promise and not an inference.
        test.case "hover shows a signature"
            $( test.eq! "`add x y : :integer -> :integer -> :integer` -- a global of module `buf`"
                        (hover_value! "let add : :integer -> :integer -> :integer;\nlet add x y = x + y;\nlet main! = add 1 2;\n" 2 12) ),
        test.case "hover shows a union's constructor with its type"
            $( test.true! (str.contains_str "circle radius : :float -> Shape"
                              (hover_value! "union Shape { circle(radius : :float), empty }\nlet main! = Shape.circle 1.0;\n" 1 18)) ),
        test.case "hover says a global is private"
            $( test.eq! "`hidden x` -- a private global of module `buf`"
                        (hover_value! "priv let hidden x = x;\nlet main! = hidden 1;\n" 1 12) ),
        test.case "hover says a global is not"
            $( test.eq! "`shown x` -- a global of module `buf`"
                        (hover_value! "let shown x = x;\nlet main! = shown 1;\n" 1 12) ),
        test.case "hover says a name is still a virtual"
            $( test.eq! "`name self` -- a virtual of module `buf`"
                        (hover_value! "virtual let name self;\nlet label self = name self;\n"
                                      1 18) ),
        test.case "the outline marks a private declaration and leaves the rest alone"
            $( test.eq! [["hidden", "priv"], ["shown", ""], ["main!", ""]]
                        (symbol_details!
                             "priv let hidden x = x;\nlet shown y = hidden y;\nlet main! = shown 1;\n") ),
        test.case "the outline marks a virtual"
            $( test.eq! [["name", "virtual"], ["label", ""]]
                        (symbol_details! "virtual let name self;\nlet label self = name self;\n") ),

        test.case "a match arm's pattern binds in its body"
            $( test.eq! ["head", "rest", "xs"]
                        (in_scope_at! "let f xs = match xs { [head, ..rest] => |head, _ => 0 };") ),
        // This one is also what holds the parser's match span: the cursor is
        // in the second arm, which used to lie outside the `match`'s own span
        // -- and outside the declaration's too, since a declaration ends where
        // its body does.
        test.case "a match arm's names do not reach the arm beside it"
            $( test.eq! ["xs"]
                        (in_scope_at! "let f xs = match xs { [head, ..rest] => 1, _ => |0 };") ),
        test.case "a match arm's names reach its guard"
            $( test.true! (list.contains "head"
                   (scope_at! "let f xs = match xs { [head, ..rest] if |true => 1, _ => 0 };")) ),
        test.case "a match inside the last arm of a match is still reached"
            $( test.eq! ["a", "b", "xs"]
                   (in_scope_at!
                      "let f xs = match xs { [a] => match xs { [b] => |b, _ => 0 }, _ => 0 };") ),

        test.case "a catch binder is in scope in the handler"
            $( test.true! (list.contains "e"
                   (scope_at! "let f! x = { try! { x } catch e { | } };")) ),
        test.case "a catch binder is not in scope in the body it guards"
            $( test.false! (list.contains "e"
                   (scope_at! "let f! x = { try! { | } catch e { 0 } };")) ),

        // `comp` runs before the program does, so it is walked with an empty
        // frame stack -- there is no local for it to see. This is the one case
        // in the walk that drops what encloses it, and the easiest to lose.
        test.case "a compile-time expression sees no local"
            $( test.eq! [] (in_scope_at! "let f x = { let y = comp (|); 1 };") ),

        // Innermost first, which is what makes the first entry under a name the
        // binding an occurrence there would mean.
        test.case "an inner binding shadows an outer one of the same name"
            $( test.eq! ["n"] (scope_at! "let f n = { let n = 1; | };") ),
        test.case "the innermost binding comes first"
            $( test.eq! ["y", "x"] (scope_at! "let f x = { let y = 1; | };") ),
    ];
}
