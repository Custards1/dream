// Text, with `std.str`.
//
// The one thing to keep straight: `length` and everything std.str inherits
// from `std.seq` count CHARACTERS, while `byte_length`, `slice` and `find`
// work in BYTES. For ASCII the two agree; for anything else they do not, and
// the library keeps them apart by name rather than hoping you notice.
import std.console;
import std.str;
import std.list;

let greeting = "Hello, World";
let accented = "h\u{e9}llo";

let main! = {
    console.print! ("string:      " + to_string greeting)
    console.print! ("length:      " + to_string (str.length greeting))
    console.print! ("byte_length: " + to_string (str.byte_length greeting))
    console.print! ("is_empty:    " + to_string (str.is_empty "") + " " + to_string (str.is_empty "x"))

    // characters vs bytes
    console.print! ("accented:    " + to_string accented)
    console.print! ("  chars:     " + to_string (str.length accented))
    console.print! ("  bytes:     " + to_string (str.byte_length accented))
    console.print! ("  as chars:  " + to_string (str.chars accented))
    console.print! ("  roundtrip: " + to_string (str.of_chars (str.chars accented)))

    // searching, in byte offsets
    console.print! ("find:        " + to_string (str.find "World" greeting))
    console.print! ("find missing:" + to_string (str.find "zzz" greeting))
    console.print! ("contains:    " + to_string (str.contains_str "lo, " greeting))
    console.print! ("starts/ends: " + to_string (str.starts_with "Hello" greeting) + " " + to_string (str.ends_with "World" greeting))
    console.print! ("slice:       " + to_string (str.slice 7 5 greeting))
    console.print! ("slice clamps:" + to_string (str.slice 7 999 greeting))

    // building
    console.print! ("concat:      " + to_string (str.concat "a" "b"))
    console.print! ("repeat:      " + to_string (str.repeat 3 "ab"))
    console.print! ("split:       " + to_string (str.split ", " greeting))
    console.print! ("split words: " + to_string (str.split " " "the quick brown fox"))
    console.print! ("join_str:    " + to_string (str.join_str "-" ["a", "b", "c"]))
    console.print! ("round trip:  " + to_string (str.join_str ", " (str.split ", " greeting)))

    // transforming
    console.print! ("upper/lower: " + to_string (str.upper greeting) + " / " + to_string (str.lower greeting))
    console.print! ("reverse:     " + to_string (str.reverse greeting))
    console.print! ("filter:      " + to_string (str.filter (fn c -> c != 'l') greeting))
    console.print! ("map:         " + to_string (str.map str.upper_char "shout"))
    console.print! ("ASCII only:  " + to_string (str.upper accented))

    // trimming
    console.print! ("trim:        " + to_string ("[" + str.trim "  padded  \n" + "]"))
    console.print! ("trim_start:  " + to_string ("[" + str.trim_start "  padded  " + "]"))
    console.print! ("trim_end:    " + to_string ("[" + str.trim_end "  padded  " + "]"))

    // inherited from std.seq, over characters
    console.print! ("count 'l':   " + to_string (str.count (fn c -> c == 'l') greeting))
    console.print! ("any/all:     " + to_string (str.any (fn c -> c == 'W') greeting) + " " + to_string (str.all (fn c -> c != 'z') greeting))
    console.print! ("min/max:     " + to_string (str.minimum "cab") + " " + to_string (str.maximum "cab"))
    console.print! ("describe:    " + to_string (str.describe greeting))

    // a small pipeline: title-case each word
    let title s = {
        let cap w = if str.is_empty w { w }
                    else { str.upper (str.slice 0 1 w) + str.slice 1 (str.byte_length w) w };
        str.join_str " " (list.map cap (str.split " " s))
    };
    console.print! ("title case:  " + to_string (title "the quick brown fox"))
};
