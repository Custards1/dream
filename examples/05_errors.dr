// Errors are values: a kind (an atom) and a payload. `try!` catches them.
//
// Both `raise!` and `try!` are impure, so error handling is an effect and the
// purity rule keeps it out of pure functions.
import std.console;
import std.math;

import std.list;
import std.num;

let div a b = a / b;

// Pure code cannot raise -- raising is an effect -- so a step that can fail
// answers `ok v` or `err e`. `let?` takes one step of a chain: on
// `Result.ok(v)` it binds `v` and goes on; a failure becomes the block's
// answer, and nothing after it runs.
type Checked = Result :integer :any;

let number : :string -> Checked;
let number s = match num.parse_int s {
    Option.none => err ("not a number: " + s),
    Option.some(n) => ok n,
};

let positive : :integer -> Checked;
let positive n = if n > 0 { ok n } else { err :not_positive };

// Bad input is an answer, not a fault: validating it answers a Result, which
// the caller must look at, and keeps the function pure. `raise!` is for what
// is not an answer -- a broken invariant, a division the program never meant
// to make -- as in `main!` below.
let age : :string -> Checked;
let age s = {
    let? n = number s;
    if n < 0 { err :negative_age } else { ok n }
};

let ratio : :string -> :string -> Checked;
let ratio a b = {
    let? x = number a;
    let? y = number b;
    let? d = positive y;
    ok (x / d)
};

// A pattern binds out of the payload, as a destructuring `let` does.
let area : Result [:integer] :any -> Checked;
let area sides = {
    let? [w, h] = sides;
    ok (w * h)
};

// A total wrapper: turn a raised error into an ordinary value.
let attempt! thunk = try! { join! (spawn! thunk) } catch e { err e };

let main! = {
    // The kinds the runtime raises.
    console.print! ("divide:    " + to_string (try! { div 1 0 } catch e { e }))
    console.print! ("type:      " + to_string (try! { 1 + "x" } catch e { e }))
    console.print! ("not a fn:  " + to_string (try! { (1) 2 } catch e { e }))
    console.print! ("no member: " + to_string (try! { math.nope! 1 } catch e { e }))
    console.print! ("bounds:    " + to_string (try! { (#[1]).[9] } catch e { e }))

    // Raising a value of your own.
    console.print! ("custom:    " + to_string (try! { raise! :my_problem } catch e { e }))
    console.print! ("with text: " + to_string (try! { raise! "went wrong" } catch e { e }))

    // The handler supplies a fallback, so the program keeps going.
    console.print! ("fallback:  " + to_string (try! { div 12 0 } catch e { 0 }))

    // Nested: the inner handler catches, the outer never sees it.
    console.print! ("nested:    " + to_string (try! { try! { div 1 0 } catch e { :inner } } catch e { :outer }))

    // Reading the parts of an error.
    let err = try! { div 1 0 } catch e { e };
    console.print! ("type_of:   " + to_string (type_of err))

    // A `try!` whose body does not raise just yields the body.
    console.print! ("no raise:  " + to_string (try! { 6 * 7 } catch e { :unused }))

    // Validation that reports the first bad input, as a value: no `try!`.
    console.print! ("parse ok:  " + to_string (age "34"))
    console.print! ("parse bad: " + to_string (age "abc"))
    console.print! ("parse neg: " + to_string (age "-1"))

    // A failure inside a process arrives at `join!` as a value, so one bad
    // computation cannot take the rest down with it.
    console.print! ("in process:" + to_string (attempt! $( div 1 0 )))
    console.print! ("survived:  " + to_string (map (fn n -> try! { 100 / n } catch e { :skipped }) [5, 0, 2]))

    // Errors as values, chained with `let?`. The zero never reaches `/`.
    console.print! ("ratio ok:  " + to_string (ratio "84" "2"))
    console.print! ("ratio nan: " + to_string (ratio "x" "2"))
    console.print! ("ratio 0:   " + to_string (ratio "84" "0"))
    console.print! ("area:      " + to_string [area (ok [3, 4]), area (Result.error :no_sides)])
};
