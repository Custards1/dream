// The three container kinds, and what each is for.
//
//   list   [a, b, c]    lazy in head and tail; the default sequence
//   array  #[a, b, c]   flat, finite, constant-time indexing
//   map    %{ k => v }  keys forced to be hashed, values lazy
import std.console;
import std.core;
import std.list;
import std.array;

let nums = [5, 3, 8, 1, 9, 2];

let main! = {
    // --- lists ---
    console.print! ("list:       " + to_string nums)
    console.print! ("length:     " + to_string (list.length nums))
    console.print! ("head/tail:  " + to_string (list.head nums) + " " + to_string (list.tail nums))
    console.print! ("map:        " + to_string (list.map (fn x -> x * 2) nums))
    console.print! ("filter:     " + to_string (list.filter (fn x -> x > 4) nums))
    console.print! ("fold:       " + to_string (list.fold (fn a b -> a + b) 0 nums))
    console.print! ("sum/product:" + to_string (list.sum nums) + " " + to_string (list.product [1, 2, 3, 4]))
    console.print! ("sort:       " + to_string (list.sort nums))
    console.print! ("sort_by:    " + to_string (list.sort_by (fn a b -> a > b) nums))
    console.print! ("reverse:    " + to_string (list.reverse nums))
    console.print! ("append:     " + to_string (list.append [1, 2] [3, 4]))
    console.print! ("range:      " + to_string (list.range 0 5))
    console.print! ("take/drop:  " + to_string (list.take 2 nums) + " " + to_string (list.drop 4 nums))
    console.print! ("unique:     " + to_string (list.unique [1, 2, 1, 3, 2]))
    console.print! ("partition:  " + to_string (list.partition (fn x -> x % 2 == 0) nums))
    console.print! ("min/max:    " + to_string (list.minimum nums) + " " + to_string (list.maximum nums))
    console.print! ("any/all:    " + to_string (list.any (fn x -> x > 8) nums) + " " + to_string (list.all (fn x -> x > 0) nums))
    console.print! ("enumerate:  " + to_string (list.enumerate [:a, :b]))
    console.print! ("flat_map:   " + to_string (list.flat_map (fn x -> [x, x]) [1, 2]))

    // --- arrays ---
    let arr = #[5, 3, 8];
    console.print! ("array:      " + to_string arr)
    console.print! ("get:        " + to_string (array.get arr 1))
    console.print! ("get_or:     " + to_string (array.get_or 0 arr 99))
    console.print! ("set copies: " + to_string (array.set arr 0 100) + " original " + to_string arr)
    console.print! ("build:      " + to_string (array.build 5 (fn i -> i * i)))
    console.print! ("of_list:    " + to_string (array.of_list [1, 2, 3]))
    console.print! ("to_list:    " + to_string (array.to_list arr))
    console.print! ("sum/sort:   " + to_string (array.sum arr) + " " + to_string (array.sort arr))
    console.print! ("slice:      " + to_string (array.slice 1 3 #[1, 2, 3, 4]))
    console.print! ("join:       " + to_string (array.join " - " arr))

    // --- maps ---
    let ages = %{ "ana" => 34, "bo" => 27, "cy" => 41 };
    console.print! ("map:        " + to_string (len ages))
    console.print! ("get:        " + to_string (core.map_get ages "ana" 0))
    console.print! ("missing:    " + to_string (core.map_get ages "zz" :none))
    console.print! ("has:        " + to_string (core.map_has ages "bo"))
    console.print! ("put:        " + to_string (len (core.map_put ages "di" 30)))
    console.print! ("remove:     " + to_string (len (core.map_remove ages "bo")))
    console.print! ("pairs:      " + to_string (list.length (core.map_pairs ages)))

    // --- conversions and types ---
    console.print! ("types:      " + to_string (type_of nums) + " " + to_string (type_of arr) + " " + to_string (type_of ages))
    console.print! ("to_array:   " + to_string (list.to_array [1, 2, 3]))
};
