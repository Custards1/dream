// The three container kinds, and what each is for.
//
//   list   [a, b, c]    lazy in head and tail; the default sequence
//   array  #[a, b, c]   flat, finite, constant-time indexing
//   map    %{ k => v }  keys forced to be hashed, values lazy
import std.console;
import std.core;
import std.list;
import std.array;

let nums = [5, 3, 8, 1, 9, 2];

let main! = {
    // --- lists ---
    console.print! "list:       " nums
    console.print! "length:     " (list.length nums)
    console.print! "head/tail:  " (list.head nums) " " (list.tail nums)
    console.print! "map:        " (list.map (fn x -> x * 2) nums)
    console.print! "filter:     " (list.filter (fn x -> x > 4) nums)
    console.print! "fold:       " (list.fold (fn a b -> a + b) 0 nums)
    console.print! "sum/product:" (list.sum nums) " " (list.product [1, 2, 3, 4])
    console.print! "sort:       " (list.sort nums)
    console.print! "sort_by:    " (list.sort_by (fn a b -> a > b) nums)
    console.print! "reverse:    " (list.reverse nums)
    console.print! "append:     " (list.append [1, 2] [3, 4])
    console.print! "range:      " (list.range 0 5)
    console.print! "take/drop:  " (list.take 2 nums) " " (list.drop 4 nums)
    console.print! "unique:     " (list.unique [1, 2, 1, 3, 2])
    console.print! "partition:  " (list.partition (fn x -> x % 2 == 0) nums)
    console.print! "min/max:    " (list.minimum nums) " " (list.maximum nums)
    console.print! "any/all:    " (list.any (fn x -> x > 8) nums) " " (list.all (fn x -> x > 0) nums)
    console.print! "enumerate:  " (list.enumerate [:a, :b])
    console.print! "flat_map:   " (list.flat_map (fn x -> [x, x]) [1, 2])

    // --- arrays ---
    let arr = #[5, 3, 8];
    console.print! "array:      " arr
    console.print! "get:        " (array.get arr 1)
    console.print! "get_or:     " (array.get_or 0 arr 99)
    console.print! "set copies: " (array.set arr 0 100) " original " arr
    console.print! "build:      " (array.build 5 (fn i -> i * i))
    console.print! "of_list:    " (array.of_list [1, 2, 3])
    console.print! "to_list:    " (array.to_list arr)
    console.print! "sum/sort:   " (array.sum arr) " " (array.sort arr)
    console.print! "slice:      " (array.slice 1 3 #[1, 2, 3, 4])
    console.print! "join:       " (array.join " - " arr)

    // --- maps ---
    let ages = %{ "ana" => 34, "bo" => 27, "cy" => 41 };
    console.print! "map:        " (len ages)
    console.print! "get:        " (core.map_get ages "ana" 0)
    console.print! "missing:    " (core.map_get ages "zz" :none)
    console.print! "has:        " (core.map_has ages "bo")
    console.print! "put:        " (len (core.map_put ages "di" 30))
    console.print! "remove:     " (len (core.map_remove ages "bo"))
    console.print! "pairs:      " (list.length (core.map_pairs ages))

    // --- conversions and types ---
    console.print! "types:      " (type_of nums) " " (type_of arr) " " (type_of ages)
    console.print! "to_array:   " (list.to_array [1, 2, 3])
};
