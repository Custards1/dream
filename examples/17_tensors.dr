// Tensors: numbers packed with a shape, and arithmetic on whole arrays of them.
//
// A tensor is what `+ - * / %` and `@` work on at the speed of the machine:
// the operators are elementwise, `@` is the matrix product, and the work runs
// in vectorized C++ -- or on the GPU, once a tensor has been moved there with
// `tensor.gpu`. Nothing below needs a GPU; the last section uses one if this
// machine has it and says so if not.

import std.console;
import std.tensor;
import std.num;

/// One layer of a neural network: weights, a bias, and an activation. All of
/// it is whole-tensor arithmetic, so it runs wherever its arguments live.
let layer : :tensor -> :tensor -> :tensor -> :tensor;
let layer w b x = tensor.relu (w @ x + b);

/// The least-squares line through points, by the normal equations, for a
/// 2 x 2 system solved by hand.
let fit : :tensor -> :tensor -> :tensor;
let fit xs ys = {
    let n = num.to_float (len xs);
    let sx = tensor.sum xs;
    let sy = tensor.sum ys;
    let sxx = xs @ xs;
    let sxy = xs @ ys;
    let slope = (n * sxy - sx * sy) / (n * sxx - sx * sx);
    tensor.of_list [slope, (sy - slope * sx) / n]
};

let main! = {
    // --- making them ---
    let a = tensor.of_list [[1, 2], [3, 4]];
    let v = tensor.of_list [1, 0];
    console.print! ("a          = " + to_string a)
    console.print! ("shape      = " + to_string (tensor.shape a))

    // --- the operators are elementwise ---
    console.print! ("a + a      = " + to_string (a + a))
    console.print! ("a * a      = " + to_string (a * a))
    console.print! ("3 * a - 1  = " + to_string (3 * a - 1))
    console.print! ("a + [10, 20] repeats per row = " + to_string (a + tensor.of_list [10, 20]))

    // --- `@` is the product ---
    console.print! ("a @ a      = " + to_string (a @ a))
    console.print! ("a @ v      = " + to_string (a @ v))
    console.print! ("dot        = " + to_string ([1, 2, 3] @ [4, 5, 6]))

    // --- reductions and functions ---
    console.print! ("sum, mean  = " + to_string [tensor.sum a, tensor.mean a])
    console.print! ("transpose  = " + to_string (tensor.transpose a))
    console.print! ("layer      = " + to_string (layer a (tensor.of_list [-5, 0]) v))
    console.print! ("fit        = " + to_string (fit (tensor.of_list [0, 1, 2, 3]) (tensor.of_list [1, 3, 5, 7])))

    // --- the same code on a GPU ---
    //
    // `place` puts a tensor wherever this machine computes fastest. `layer`
    // is unchanged: it runs where its arguments are, and `tensor.host` brings
    // the answer back to print. On a machine with no GPU, both are the host.
    let place = if tensor.gpu_available () { tensor.gpu } else { tensor.host };
    let y = layer (place a) (place (tensor.of_list [-5, 0])) (place v);
    console.print! ("layer, placed = " + to_string (tensor.host y))
};
