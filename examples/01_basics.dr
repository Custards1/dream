// Values, operators, and the two rules that trip people up first:
// application binds tighter than every operator, and `|>` feeds the left side
// in as the *last* argument.
import std.console;

let pi      = 3.14159;
let flag    = true;
let letter  = 'x';
let name    = "dream";
let tag     = :ok;
let nothing = ();
let hexed   = 0xFF;
let binary  = 0b1010;
let octal   = 0o755;
let big     = 1_000_000;
let sci     = 2.5e-3;

let add a b = a + b;
let inc = add 1;                       // partial application

let rec fac n = if n <= 1 { 1 } else { n * fac (n - 1) };

let classify n =
    if n < 0 { :negative }
    else if n == 0 { :zero }
    else { :positive };

let main! = {
    console.print! "pi        = " pi
    console.print! "flag      = " flag
    console.print! "letter    = " letter
    console.print! "name      = " name
    console.print! "tag       = " tag
    console.print! "unit      = " nothing
    console.print! "bases     = " hexed " " binary " " octal " " big " " sci

    // Application binds tightest: `fac n - 1` would be `(fac n) - 1`.
    console.print! "fac 5     = " (fac 5)
    console.print! "inc 41    = " (inc 41)
    console.print! "classify  = " (classify (0 - 5)) " " (classify 0) " " (classify 7)

    // Precedence ladder: || < && < comparison < + - < * / %
    console.print! "1 + 2 * 3 = " (1 + 2 * 3)
    console.print! "(1+2) * 3 = " ((1 + 2) * 3)
    console.print! "chained   = " (1 < 2 && 3 >= 3 || false)
    console.print! "modulo    = " (17 % 5) " " (17 / 5) " " (17.0 / 5.0)

    // `+` is overloaded: numbers, strings, and lists.
    console.print! "concat    = " ("dr" + "eam") " " ([1, 2] + [3])

    // The pipe reads left to right.
    5 |> console.print! "piped     = "
};
