// Values, operators, and the two rules that trip people up first:
// application binds tighter than every operator, and `|>` feeds the left side
// in as the *last* argument.
import std.console;

let pi      = 3.14159;
let flag    = true;
let letter  = 'x';
let name    = "dream";
let tag     = :ok;
let nothing = ();
let hexed   = 0xFF;
let binary  = 0b1010;
let octal   = 0o755;
let big     = 1_000_000;
let sci     = 2.5e-3;

let add a b = a + b;
let inc = add 1;                       // partial application

let rec fac n = if n <= 1 { 1 } else { n * fac (n - 1) };

let classify n =
    if n < 0 { :negative }
    else if n == 0 { :zero }
    else { :positive };

let main! = {
    console.print! ("pi        = " + to_string pi)
    console.print! ("flag      = " + to_string flag)
    console.print! ("letter    = " + to_string letter)
    console.print! ("name      = " + to_string name)
    console.print! ("tag       = " + to_string tag)
    console.print! ("unit      = " + to_string nothing)
    console.print! ("bases     = " + to_string hexed + " " + to_string binary + " " + to_string octal + " " + to_string big + " " + to_string sci)

    // Application binds tightest: `fac n - 1` would be `(fac n) - 1`.
    console.print! ("fac 5     = " + to_string (fac 5))
    console.print! ("inc 41    = " + to_string (inc 41))
    console.print! ("classify  = " + to_string (classify (0 - 5)) + " " + to_string (classify 0) + " " + to_string (classify 7))

    // Precedence ladder: || < && < comparison < + - < * / %
    console.print! ("1 + 2 * 3 = " + to_string (1 + 2 * 3))
    console.print! ("(1+2) * 3 = " + to_string ((1 + 2) * 3))
    console.print! ("chained   = " + to_string (1 < 2 && 3 >= 3 || false))
    console.print! ("modulo    = " + to_string (17 % 5) + " " + to_string (17 / 5) + " " + to_string (17.0 / 5.0))

    // `+` is overloaded: numbers, strings, and lists.
    console.print! ("concat    = " + to_string ("dr" + "eam") + " " + to_string ([1, 2] + [3]))

    // The pipe reads left to right.
    console.print! ("piped     = " + to_string (5))
};
