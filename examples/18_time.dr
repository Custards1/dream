// Time: instants and durations are integers, and the calendar is a view.
//
// `std.time` keeps time as nanoseconds -- an `Instant` since 1970 UTC, a
// `Duration` between two -- so the arithmetic is the language's own. What a
// clock and calendar *read* somewhere is a `DateTime`, which always carries
// its offset, so it always names exactly one instant. Zones come from the
// operating system's database (`time.zone!`), or, as here, from a POSIX rule,
// so this example prints the same thing on every machine.
import std.console;
import std.list;
import std.result;
import std.time;

let main! = {
    // A fixed instant, so the output is the same every run.
    let launch = time.to_instant (time.datetime 2026 3 28 23 30 0);
    console.print! (time.rfc3339 launch)

    // Durations add to instants, and print the way Go prints them.
    let later = launch + 90 * time.minute + time.seconds 1.5;
    console.print! (time.rfc3339 later)
    console.print! (time.format_duration (later - launch))
    console.print! (time.parse_duration "2h45m" |> result.map time.to_hours)

    // Central Europe, from its rule. The clocks go forward at 02:00 on the
    // last Sunday of March -- which, in 2026, falls between those two instants.
    let berlin = result.or_else time.utc (time.posix_zone "CET-1CEST,M3.5.0,M10.5.0/3");
    console.print! (time.format "%a %d %b %Y %H:%M %Z" (time.in_zone berlin launch))
    console.print! (time.format "%a %d %b %Y %H:%M %Z" (time.in_zone berlin later))

    // Calendar arithmetic works on what the clock reads. "The same time
    // tomorrow" crosses the change and is still 09:00; `localize` gives it
    // the offset Berlin has then.
    let breakfast = time.datetime_in berlin 2026 3 28 9 0 0;
    console.print! (time.datetime_text breakfast)
    console.print! (time.datetime_text (time.localize berlin (time.add_days 1 breakfast)))
    console.print! (time.format_duration (time.between breakfast (time.localize berlin (time.add_days 1 breakfast))))

    // A month after January 31st is the last day of February.
    console.print! (list.map (fn n -> time.date_text (time.add_months n (time.date 2028 1 31))) [1, 2, 3])

    // Reading times back: RFC 3339, HTTP's format, and a pattern of your own.
    console.print! (time.parse_rfc3339 "2026-03-29T01:00:00+01:00" |> result.map time.rfc3339)
    console.print! (time.http_date launch)
    console.print! (time.parse "%d/%m/%Y %H:%M" "28/03/2026 23:30" |> result.map time.datetime_text)
    console.print! (time.parse "%d/%m/%Y" "31/02/2026")

    // For people.
    console.print! (time.relative launch (launch - 3 * time.hour))
    console.print! (time.relative launch (launch + 10 * time.day))
};
